# @title  : es-search-index: Search and extract specific fields from Elasticsearch index by timestamp range
# @license: Apache License 2.0
# @since  : 2024-06-18
# @desc   : support macOS 11.2.3, Ubuntu 18.04 or higher, CentOS 7 or higher
# =======================================

FILENAME=$(basename "$0")

help(){
    echo "Usage: $FILENAME --host <host> [--port <port>] --index <index> --gte <timestamp> --lt <timestamp> [--props <field-list>] [--size <count>] [--help]"
    echo
    echo "Elasticsearch 인덱스에서 타임스탬프 범위 기반으로 검색하고 특정 필드 데이터를 추출합니다."
    echo
    echo "Options:"
    echo "  --host <host>          Elasticsearch 서버 호스트 또는 IP (필수)"
    echo "  --port <port>          Elasticsearch HTTP 포트 (기본값: 9200)"
    echo "  --index <index>        검색할 Elasticsearch 인덱스명 (필수)"
    echo "  --gte <timestamp>      시작 타임스탬프 (밀리초 단위, 필수)"
    echo "  --lt <timestamp>       종료 타임스탬프 (밀리초 단위, 필수)"
    echo "  --props <fields>       추출할 필드 목록 (공백 구분, 기본값: timestamp vip rootServer count avgCount totalCount)"
    echo "  --size <count>         조회할 최대 문서 수 (기본값: 10)"
    echo "  --help                 도움말 출력"
    echo
    exit 1
}

HOST=""
PORT="9200"
INDEX=""
PROPS="timestamp vip rootServer count avgCount totalCount"
GTE=""
LT=""
SIZE=10

while [[ $# -gt 0 ]]; do
    case "$1" in
        --host)
            HOST="$2"
            shift 2
            ;;
        --port)
            PORT="$2"
            shift 2
            ;;
        --index)
            INDEX="$2"
            shift 2
            ;;
        --gte)
            GTE="$2"
            shift 2
            ;;
        --lt)
            LT="$2"
            shift 2
            ;;
        --props)
            PROPS="$2"
            shift 2
            ;;
        --size)
            SIZE="$2"
            shift 2
            ;;
        --help)
            help
            ;;
        *)
            echo "알 수 없는 옵션: $1"
            help
            ;;
    esac
done

if [[ -z "$HOST" || -z "$INDEX" || -z "$GTE" || -z "$LT" ]]; then
    echo "오류: --host, --index, --gte, --lt 옵션은 필수입니다."
    help
fi

# @param $1 {string} json data
elapsed(){
	echo "$1" | jq ".took" 2>/dev/null
}

# @param $1 {string} json data
count(){
	echo "$1" | jq ".hits.total.value" 2>/dev/null
}

# @param $1 {string} json data
# @param $2 {string} properties (빈칸으로 구분)
read-data(){
	local _props=( $2 )
	local _jqprops=""
	for _p in "${_props[@]}"; do
		_jqprops="${_jqprops},\\(._source.${_p})"		
	done

	while read -r _d; do
		echo "${_d:1:-1}"
	done < <(jq ".hits.hits[] | \"${_jqprops:1}\" " 2>/dev/null <<< "$1")
}

data=$(curl --silent -X GET "http://${HOST}:${PORT}/${INDEX}/_search" \
    -H 'Content-Type: application/json' \
    -d "{\"query\": {\"range\": {\"timestamp\": {\"gte\": ${GTE}, \"lt\": ${LT}}}}, \"size\": ${SIZE}}" )

total_count=$(count "$data")

if [[ -z "$total_count" || "$total_count" -lt 1 ]]; then
	echo "조회된 데이터가 없습니다."
	exit 0
fi 

read-data "$data" "$PROPS"

exit 0
