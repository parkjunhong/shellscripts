#!/usr/bin/env bash

# =======================================
# @author   : parkjunhong77@gmail.com
# @title    : Bash completion for 'es-index-usage'
# @license  : Apache License 2.0
# @since    : 2023-10-25
# =======================================

# Bash Completion Parameter Description
# 1. COMP_WORDS: an array, contains all arguments
# 2. COMP_CWORD: an index of a cursor
# 3. COMP_LINE: all command string
# 4. COMPREPLY: an array, contains suggested words. words are sorted and unique.

_es_index_usage_complete() {
  local cur opts
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  
  opts="--ip --port --indices --index-prefix --help"

  if [[ ${cur} == -* ]] ; then
    COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
    return 0
  fi
  
  COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
}

complete -F _es_index_usage_complete es-index-usage
