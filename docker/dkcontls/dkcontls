set -Eeuo pipefail

if (( BASH_VERSINFO[0] < 4 )); then
  printf '❌ [ERROR] Bash 4 이상이 필요합니다.\n' >&2
  exit 1
fi

readonly FILENAME="$(basename "$0")"

DOCKER_CMD=()

# --format에서 선택 가능한 컬럼 목록
readonly -a SUPPORTED_FORMAT_FIELDS=(
  "ID"
  "Image"
  "Command"
  "CreatedAT"
  "RunningFor"
  "Ports"
  "State"
  "Status"
  "Names"
  "Size"
)

# --filter에서 사용 가능한 속성(Key) 목록
readonly -a SUPPORTED_FILTER_KEYS=(
  "id"
  "name"
  "label"
  "exited"
  "status"
  "ancestor"
  "before"
  "since"
  "isolation"
  "volume"
  "network"
  "publish"
  "expose"
  "health"
  "is-task"
)

##
# 오류 원인 및 콜스택 진단 정보를 표준 에러(stderr)로 출력합니다.
#
# @param $1 {string} 오류 원인 메시지
# @param $2 {number} 오류 발생 행 번호
#
# @return 없음
##
print_error_box() {
  local cause="${1:-}"
  local line="${2:-unknown}"
  [[ -n "$cause" ]] || return 0

  local indent=10
  local formatl=" - %-${indent}s: %s\n"
  local formatr=" - %${indent}s: %s\n"
  echo >&2
  echo "================================================================================" >&2
  printf "$formatl" "filename" "$FILENAME" >&2
  printf "$formatl" "line" "$line" >&2
  printf "$formatl" "callstack" "" >&2
  local idx=1
  local func
  for func in "${FUNCNAME[@]:2}"; do
    printf "$formatr" "[${idx}]" "$func" >&2
    ((idx++)) || true
  done
  printf "$formatl" "cause" "$cause" >&2
  echo "================================================================================" >&2
}

##
# 도움말 및 사용법을 출력합니다.
#
# @param $1 {string} 오류 원인 메시지 (선택)
# @param $2 {number} 오류 발생 라인 번호 (선택)
#
# @return 없음
##
help() {
  local cause="${1:-}"
  local line="${2:-unknown}"

  if [[ -n "$cause" ]]; then
    print_error_box "$cause" "$line"
  fi

  cat <<EOF

🐳 사용법 (Usage):
  $FILENAME [OPTIONS]
  $FILENAME --help

📝 설명 (Description):
  'docker container ls' 명령을 래핑하여 컨테이너 목록을 조회합니다.
  - 단축 옵션(Short Option: -a, -f, -n, -l, -q, -s 등)은 지원하지 않으며, 전체 옵션명(Long Option)만 지원합니다.
  - '--format' 옵션에 콤마(,)로 구분된 컬럼명을 지정하면 자동으로 Docker 테이블 Go 템플릿으로 변환하여 출력합니다.
  - 본 도구는 외부에서 'sudo'로 직접 실행할 수 없으며, Docker 소켓 접근에 권한이 필요한 시점에 내부적으로 sudo를 요청합니다.

⚙️  옵션 (Options):
  --all                     모든 컨테이너 표시 (기본값: 실행 중인 컨테이너만 표시)
  --filter <key=value>      지정된 조건으로 컨테이너 필터링 (여러 번 지정 가능)
                            * 지원 속성: id, name, label, exited, status, ancestor, before,
                                        since, isolation, volume, network, publish, expose, health, is-task
  --format < columns|fmt >  출력 포맷 지정
                            * 콤마(,)로 구분된 컬럼 선택 지원:
                              [ID|Image|Command|CreatedAT|RunningFor|Ports|State|Status|Names|Size]
                              (예: --format ID,Names,Status,Ports)
                            * 기본 키워드 및 커스텀 Go 템플릿 지원: 'table', 'json', 'table {{.ID}}...'
  --last <int>              마지막에 생성된 n개의 컨테이너 표시 (모든 상태 포함, 기본값: -1)
  --latest                  가장 최근에 생성된 컨테이너 1개 표시 (모든 상태 포함)
  --no-trunc                출력 내용을 생략(truncate)하지 않고 전체 표시
  --quiet                   컨테이너 ID만 출력
  --size                    컨테이너 총 파일 크기 표시
  --help                    이 도움말을 출력하고 종료

💡 예시 (Examples):
  # 1) 실행 중인 컨테이너의 ID, 이름, 상태, 포트만 테이블로 조회
  $FILENAME --format ID,Names,Status,Ports

  # 2) 모든 컨테이너 중 상태가 exited인 컨테이너 조회
  $FILENAME --all --filter status=exited

  # 3) 특정 네트워크에 연결된 컨테이너를 JSON 형식으로 조회
  $FILENAME --filter network=bridge --format json
EOF
}

##
# 외부에서 sudo(또는 root)로 스크립트 자체를 권한 승격하여 실행했는지 검사합니다.
#
# @return 강제 승격 실행 감지 시 에러 출력 후 exit 1
##
reject_external_sudo() {
  if [[ "${EUID:-$(id -u)}" -eq 0 || -n "${SUDO_USER:-}" || -n "${SUDO_UID:-}" ]]; then
    help "🚫 보안 정책 위반: '$FILENAME' 스크립트 자체를 sudo 또는 root 권한으로 직접 실행할 수 없습니다. 필요한 시점에 내부적으로 sudo 권한을 요청합니다." "${BASH_LINENO[0]:-$LINENO}"
    exit 1
  fi
}

##
# 사용자가 입력한 --format 인자를 검증하고, 콤마 구분 컬럼 목록인 경우
# Docker Go 템플릿('table {{.Field1}}\t{{.Field2}}...')으로 변환합니다.
#
# @param $1 {string} 사용자 입력 --format 문자열
#
# @return 변환된 Docker --format 문자열 표준 출력 (오류 시 exit 1)
##
build_format_argument() {
  local raw_format="$1"

  # 1. 표준 키워드('table', 'json') 또는 이미 Go 템플릿('{{...}}')이 포함된 경우 그대로 전달
  if [[ "$raw_format" == "table" || "$raw_format" == "json" || "$raw_format" == *"{{."* || "$raw_format" == "table "* ]]; then
    printf '%s\n' "$raw_format"
    return 0
  fi

  # 2. 콤마(,)로 구분된 컬럼명 목록 파싱 및 검증
  if [[ "$raw_format" == ,* || "$raw_format" == *, || "$raw_format" == *,,* ]]; then
    help "❌ '--format' 컬럼 목록('${raw_format}')에 빈 항목이 포함되어 있습니다." "${BASH_LINENO[0]:-$LINENO}"
    exit 1
  fi

  local -a fields=()
  local -a template_parts=()
  local -a seen_fields=()
  IFS=',' read -r -a fields <<< "$raw_format"

  local field mapped_field seen
  for field in "${fields[@]}"; do
    case "$field" in
      ID|Image|Command|RunningFor|Ports|State|Status|Names|Size)
        mapped_field="$field"
        ;;
      CreatedAT|CreatedAt)
        # Docker Go 템플릿의 실제 필드명은 '.CreatedAt'임
        mapped_field="CreatedAt"
        ;;
      *)
        help "❌ 지원하지 않는 '--format' 컬럼명입니다: '${field}' (지원 목록: ${SUPPORTED_FORMAT_FIELDS[*]})" "${BASH_LINENO[0]:-$LINENO}"
        exit 1
        ;;
    esac

    for seen in "${seen_fields[@]}"; do
      if [[ "$seen" == "$mapped_field" ]]; then
        help "❌ '--format' 옵션에 동일한 컬럼('${field}')이 중복 지정되었습니다." "${BASH_LINENO[0]:-$LINENO}"
        exit 1
      fi
    done
    seen_fields+=("$mapped_field")
    template_parts+=("{{.${mapped_field}}}")
  done

  local IFS=$'\t'
  printf 'table %s\n' "${template_parts[*]}"
}

##
# 사용자가 입력한 --filter 인자(key=value)의 속성(Key) 및 값 유효성을 검증합니다.
#
# @param $1 {string} 사용자 입력 --filter 문자열
#
# @return 유효 시 0, 무효 시 help 출력 후 exit 1
##
validate_filter_argument() {
  local raw_filter="$1"

  if [[ "$raw_filter" != *=* ]]; then
    help "❌ '--filter' 옵션은 '<속성>=<값>' 형식이어야 합니다 (입력값: '${raw_filter}', 지원 속성: ${SUPPORTED_FILTER_KEYS[*]})." "${BASH_LINENO[0]:-$LINENO}"
    exit 1
  fi

  local key="${raw_filter%%=*}"
  local val="${raw_filter#*=}"

  if [[ -z "$key" || -z "$val" ]]; then
    help "❌ '--filter' 옵션의 속성 또는 값이 비어 있습니다: '${raw_filter}'" "${BASH_LINENO[0]:-$LINENO}"
    exit 1
  fi

  local supported is_valid_key=false
  for supported in "${SUPPORTED_FILTER_KEYS[@]}"; do
    if [[ "$key" == "$supported" ]]; then
      is_valid_key=true
      break
    fi
  done

  if [[ "$is_valid_key" == false ]]; then
    help "❌ 지원하지 않는 '--filter' 속성입니다: '${key}' (지원 속성: ${SUPPORTED_FILTER_KEYS[*]})" "${BASH_LINENO[0]:-$LINENO}"
    exit 1
  fi

  # 주요 열거형 필터 값 사전 검증
  case "$key" in
    status)
      case "$val" in
        created|restarting|running|removing|paused|exited|dead) ;;
        *)
          help "❌ '--filter status=${val}' 값이 유효하지 않습니다. (허용값: created, restarting, running, removing, paused, exited, dead)" "${BASH_LINENO[0]:-$LINENO}"
          exit 1
          ;;
      esac
      ;;
    health)
      case "$val" in
        starting|healthy|unhealthy|none) ;;
        *)
          help "❌ '--filter health=${val}' 값이 유효하지 않습니다. (허용값: starting, healthy, unhealthy, none)" "${BASH_LINENO[0]:-$LINENO}"
          exit 1
          ;;
      esac
      ;;
    is-task)
      case "$val" in
        true|false) ;;
        *)
          help "❌ '--filter is-task=${val}' 값이 유효하지 않습니다. (허용값: true, false)" "${BASH_LINENO[0]:-$LINENO}"
          exit 1
          ;;
      esac
      ;;
    isolation)
      case "$val" in
        default|process|hyperv) ;;
        *)
          help "❌ '--filter isolation=${val}' 값이 유효하지 않습니다. (허용값: default, process, hyperv)" "${BASH_LINENO[0]:-$LINENO}"
          exit 1
          ;;
      esac
      ;;
    exited)
      if [[ ! "$val" =~ ^-?[0-9]+$ ]]; then
        help "❌ '--filter exited=${val}' 값은 정수(종료 코드)여야 합니다." "${BASH_LINENO[0]:-$LINENO}"
        exit 1
      fi
      ;;
  esac

  return 0
}

##
# Docker 명령어 존재 여부 및 소켓 접근 권한을 확인하고, 필요한 시점에 sudo 권한을 요청합니다.
#
# @return DOCKER_CMD 전역 배열 설정
##
ensure_docker_ready() {
  if ! command -v docker >/dev/null 2>&1; then
    help "❌ 시스템에 'docker' 명령어가 설치되어 있지 않습니다." "${BASH_LINENO[0]:-$LINENO}"
    exit 1
  fi

  # 일반 사용자 권한으로 Docker 소켓 접근이 가능한지 먼저 확인
  if docker info >/dev/null 2>&1; then
    DOCKER_CMD=(docker)
    return 0
  fi

  # 소켓 권한이 없는 경우 sudo 권한 요청
  if ! command -v sudo >/dev/null 2>&1; then
    help "❌ Docker 데몬 접근을 위해 'sudo'가 필요하나 시스템에 설치되어 있지 않습니다." "${BASH_LINENO[0]:-$LINENO}"
    exit 1
  fi

  if ! sudo -n true 2>/dev/null; then
    echo "🔐 [AUTH] Docker 컨테이너 목록 조회를 위해 sudo 권한 확인이 필요합니다." >&2
    if ! sudo -v; then
      help "❌ sudo 권한 획득에 실패하여 작업을 진행할 수 없습니다." "${BASH_LINENO[0]:-$LINENO}"
      exit 1
    fi
  fi

  DOCKER_CMD=(sudo docker)

  if ! "${DOCKER_CMD[@]}" info >/dev/null 2>&1; then
    help "❌ Docker 데몬이 실행 중이지 않거나 소켓에 접근할 수 없습니다." "${BASH_LINENO[0]:-$LINENO}"
    exit 1
  fi
}

##
# 메인 실행 함수
#
# @param $@ {array} CLI 인자
#
# @return 0 on success
##
main() {
  reject_external_sudo

  local opt_all=false
  local -a opt_filters=()
  local opt_format=""
  local opt_last=""
  local opt_latest=false
  local opt_no_trunc=false
  local opt_quiet=false
  local opt_size=false

  local has_all=false
  local has_format=false
  local has_last=false
  local has_latest=false
  local has_no_trunc=false
  local has_quiet=false
  local has_size=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)
        if [[ "$has_all" == true ]]; then
          help "❌ '--all' 옵션이 중복 지정되었습니다." "$LINENO"
          exit 1
        fi
        has_all=true
        opt_all=true
        shift
        ;;
      --filter|--filter=*)
        local f_val=""
        if [[ "$1" == *=* ]]; then
          f_val="${1#*=}"
          shift
        else
          if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == -* ]]; then
            help "❌ '--filter' 옵션 뒤에 '<속성>=<값>'을 지정해야 합니다." "$LINENO"
            exit 1
          fi
          f_val="$2"
          shift 2
        fi
        validate_filter_argument "$f_val"
        opt_filters+=("$f_val")
        ;;
      --format|--format=*)
        if [[ "$has_format" == true ]]; then
          help "❌ '--format' 옵션이 중복 지정되었습니다." "$LINENO"
          exit 1
        fi
        has_format=true
        local fmt_val=""
        if [[ "$1" == *=* ]]; then
          fmt_val="${1#*=}"
          shift
        else
          if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == -* ]]; then
            help "❌ '--format' 옵션 뒤에 컬럼 목록 또는 포맷 문자열을 지정해야 합니다." "$LINENO"
            exit 1
          fi
          fmt_val="$2"
          shift 2
        fi
        opt_format="$(build_format_argument "$fmt_val")"
        ;;
      --last|--last=*)
        if [[ "$has_last" == true ]]; then
          help "❌ '--last' 옵션이 중복 지정되었습니다." "$LINENO"
          exit 1
        fi
        has_last=true
        local last_val=""
        if [[ "$1" == *=* ]]; then
          last_val="${1#*=}"
          shift
        else
          if [[ $# -lt 2 || -z "${2:-}" ]]; then
            help "❌ '--last' 옵션 뒤에 정수 값을 지정해야 합니다." "$LINENO"
            exit 1
          fi
          last_val="$2"
          shift 2
        fi
        if [[ ! "$last_val" =~ ^-?[0-9]+$ ]]; then
          help "❌ '--last' 옵션 값은 정수여야 합니다 (입력값: '${last_val}')." "$LINENO"
          exit 1
        fi
        opt_last="$last_val"
        ;;
      --latest)
        if [[ "$has_latest" == true ]]; then
          help "❌ '--latest' 옵션이 중복 지정되었습니다." "$LINENO"
          exit 1
        fi
        has_latest=true
        opt_latest=true
        shift
        ;;
      --no-trunc)
        if [[ "$has_no_trunc" == true ]]; then
          help "❌ '--no-trunc' 옵션이 중복 지정되었습니다." "$LINENO"
          exit 1
        fi
        has_no_trunc=true
        opt_no_trunc=true
        shift
        ;;
      --quiet)
        if [[ "$has_quiet" == true ]]; then
          help "❌ '--quiet' 옵션이 중복 지정되었습니다." "$LINENO"
          exit 1
        fi
        has_quiet=true
        opt_quiet=true
        shift
        ;;
      --size)
        if [[ "$has_size" == true ]]; then
          help "❌ '--size' 옵션이 중복 지정되었습니다." "$LINENO"
          exit 1
        fi
        has_size=true
        opt_size=true
        shift
        ;;
      --help)
        help ""
        exit 0
        ;;
      -*)
        help "❌ 단축 옵션(Short Option)은 지원하지 않거나 알 수 없는 옵션입니다: '$1'" "$LINENO"
        exit 1
        ;;
      *)
        help "❌ 알 수 없는 인자입니다: '$1'" "$LINENO"
        exit 1
        ;;
    esac
  done

  # Docker 실행 권한 및 데몬 준비
  ensure_docker_ready

  # docker container ls 인자 배열 조립 (단어 분리 방지)
  local -a cmd_args=(container ls)

  [[ "$opt_all" == true ]] && cmd_args+=(--all)

  local f
  for f in "${opt_filters[@]}"; do
    cmd_args+=(--filter "$f")
  done

  [[ -n "$opt_format" ]] && cmd_args+=(--format "$opt_format")
  [[ -n "$opt_last" ]] && cmd_args+=(--last "$opt_last")
  [[ "$opt_latest" == true ]] && cmd_args+=(--latest)
  [[ "$opt_no_trunc" == true ]] && cmd_args+=(--no-trunc)
  [[ "$opt_quiet" == true ]] && cmd_args+=(--quiet)
  [[ "$opt_size" == true ]] && cmd_args+=(--size)

  "${DOCKER_CMD[@]}" "${cmd_args[@]}"
}

main "$@"
exit 0
