set -Eeuo pipefail

if (( BASH_VERSINFO[0] < 4 )); then
  printf '❌ [ERROR] Bash 4 이상이 필요합니다.\n' >&2
  exit 1
fi

readonly FILENAME="$(basename "$0")"
readonly SCRIPT_FILE_VERSION="2026.11.25.1"

# Docker 기본 출력에서 컬럼별 최대 표시 너비 (미지정 컬럼은 제한 없음)
readonly DEFAULT_TRUNC_ID_LEN=12
readonly DEFAULT_TRUNC_COMMAND_LEN=20

DOCKER_CMD=()
PARSED_FIELDS=()

# --format에서 선택 가능한 컬럼 목록
readonly -a SUPPORTED_FORMAT_FIELDS=(
  "ID"
  "Image"
  "Command"
  "CreatedAT"
  "RunningFor"
  "Ports"
  "State"
  "Status"
  "Names"
  "Size"
)

# --filter에서 사용 가능한 속성(Key) 목록
readonly -a SUPPORTED_FILTER_KEYS=(
  "id"
  "name"
  "label"
  "exited"
  "status"
  "ancestor"
  "before"
  "since"
  "isolation"
  "volume"
  "network"
  "publish"
  "expose"
  "health"
  "is-task"
)

##
# 오류 원인 및 콜스택 진단 정보를 표준 에러(stderr)로 출력합니다.
#
# @param $1 {string} 오류 원인 메시지
# @param $2 {number} 오류 발생 행 번호
#
# @return 없음
##
print_error_box() {
  local cause="${1:-}"
  local line="${2:-unknown}"
  [[ -n "$cause" ]] || return 0

  local indent=10
  local formatl=" - %-${indent}s: %s\n"
  local formatr=" - %${indent}s: %s\n"
  echo >&2
  echo "================================================================================" >&2
  printf "$formatl" "filename" "$FILENAME" >&2
  printf "$formatl" "line" "$line" >&2
  printf "$formatl" "callstack" "" >&2
  local idx=1
  local func
  for func in "${FUNCNAME[@]:2}"; do
    printf "$formatr" "[${idx}]" "$func" >&2
    ((idx++)) || true
  done
  printf "$formatl" "cause" "$cause" >&2
  echo "================================================================================" >&2
}

##
# 도움말 및 사용법을 출력합니다.
#
# @param $1 {string} 오류 원인 메시지 (선택)
# @param $2 {number} 오류 발생 라인 번호 (선택)
#
# @return 없음
##
help() {
  local cause="${1:-}"
  local line="${2:-unknown}"

  if [[ -n "$cause" ]]; then
    print_error_box "$cause" "$line"
  fi

  cat <<EOF

🐳 사용법 (Usage):
  $FILENAME [OPTIONS]
  $FILENAME --help

📝 설명 (Description):
  'docker container ls' 명령을 래핑하여 컨테이너 목록을 조회합니다.
  - 단축 옵션(Short Option: -a, -f, -n, -l, -q, -s 등)은 지원하지 않으며, 전체 옵션명(Long Option)만 지원합니다.
  - '--format' 옵션에 콤마(,)로 구분된 컬럼명을 지정하면 자동으로 Docker 테이블 Go 템플릿으로 변환하여 출력합니다.
  - '--format'으로 컬럼을 지정할 때 맨 마지막에 위치한 컬럼은 내용 생략(truncate) 없이 전체 내용이 출력됩니다.
  - 본 도구는 외부에서 'sudo'로 직접 실행할 수 없으며, Docker 소켓 접근에 권한이 필요한 시점에 내부적으로 sudo를 요청합니다.

⚙️  옵션 (Options):
  --all                     모든 컨테이너 표시 (기본값: 실행 중인 컨테이너만 표시)
  --filter <key=value>      지정된 조건으로 컨테이너 필터링 (여러 번 지정 가능)
                            * 지원 속성: id, name, label, exited, status, ancestor, before,
                                        since, isolation, volume, network, publish, expose, health, is-task
  --format < columns|fmt >  출력 포맷 지정
                            * 콤마(,)로 구분된 컬럼 선택 지원 (맨 마지막 컬럼은 항상 전체 출력):
                              [ID|Image|Command|CreatedAT|RunningFor|Ports|State|Status|Names|Size]
                              (예: --format ID,Names,Status,Ports)
                            * 기본 키워드 및 커스텀 Go 템플릿 지원: 'table', 'json', 'table {{.ID}}...'
  --last <int>              마지막에 생성된 n개의 컨테이너 표시 (모든 상태 포함, 기본값: -1)
  --latest                  가장 최근에 생성된 컨테이너 1개 표시 (모든 상태 포함)
  --no-trunc [columns]      출력 내용을 생략(truncate)하지 않고 전체 표시
                            * 인자 없이 사용 시: 모든 컬럼 전체 출력
                            * 컬럼 지정 시(예: --no-trunc ID,Command): 지정된 컬럼만 전체 출력하고 나머지는 기본 제한 적용
  --quiet                   컨테이너 ID만 출력
  --size                    컨테이너 총 파일 크기 표시
  --help                    이 도움말을 출력하고 종료

💡 예시 (Examples):
  # 1) 실행 중인 컨테이너의 ID, 이름, 상태, 포트만 테이블로 조회
  $FILENAME --format ID,Names,Status,Ports

  # 2) Command를 맨 끝에 배치하여 잘림 없이 전체 명령어 조회
  $FILENAME --format Names,Ports,Status,CreatedAT,Command

  # 3) 중간에 위치한 ID와 Command 컬럼만 잘림 없이 전체 출력
  $FILENAME --format ID,Command,Ports,Status --no-trunc ID,Command

  # 4) 모든 컨테이너 중 상태가 exited인 컨테이너 조회
  $FILENAME --all --filter status=exited

  # 5) 특정 네트워크에 연결된 컨테이너를 JSON 형식으로 조회
  $FILENAME --filter network=bridge --format json
EOF
}

##
# 외부에서 sudo(또는 root)로 스크립트 자체를 권한 승격하여 실행했는지 검사합니다.
#
# @return 강제 승격 실행 감지 시 에러 출력 후 exit 1
##
reject_external_sudo() {
  if [[ "${EUID:-$(id -u)}" -eq 0 || -n "${SUDO_USER:-}" || -n "${SUDO_UID:-}" ]]; then
    help "🚫 보안 정책 위반: '$FILENAME' 스크립트 자체를 sudo 또는 root 권한으로 직접 실행할 수 없습니다. 필요한 시점에 내부적으로 sudo 권한을 요청합니다." "${BASH_LINENO[0]:-$LINENO}"
    exit 1
  fi
}

##
# 입력된 '--format' 문자열이 Docker 기본 키워드('table', 'json') 또는
# 커스텀 Go 템플릿인지 여부를 판별합니다.
#
# @param $1 {string} 사용자 입력 --format 문자열
#
# @return 0: 기본 키워드/커스텀 템플릿, 1: 콤마 구분 컬럼 목록
##
is_raw_docker_format() {
  local raw_format="$1"
  [[ "$raw_format" == "table" || "$raw_format" == "json" || "$raw_format" == *"{{."* || "$raw_format" == "table "* ]]
}

##
# 콤마(,)로 구분된 컬럼명 목록을 검증하고 Docker Go 템플릿용 정규화 필드명 목록을
# 전역 배열 PARSED_FIELDS에 저장합니다.
#
# @param $1 {string} 옵션명 ('--format' 또는 '--no-trunc')
# @param $2 {string} 콤마로 구분된 컬럼명 문자열
#
# @return 성공 시 0 (PARSED_FIELDS 설정), 오류 시 help 출력 후 exit 1
##
parse_comma_fields() {
  local opt_name="$1"
  local raw_csv="$2"
  PARSED_FIELDS=()

  if [[ -z "$raw_csv" || "$raw_csv" == ,* || "$raw_csv" == *, || "$raw_csv" == *,,* ]]; then
    help "❌ '${opt_name}' 컬럼 목록('${raw_csv}')이 비어 있거나 빈 항목이 포함되어 있습니다." "${BASH_LINENO[0]:-$LINENO}"
    exit 1
  fi

  local -a fields=()
  local -a seen_fields=()
  IFS=',' read -r -a fields <<< "$raw_csv"

  local field mapped_field seen
  for field in "${fields[@]}"; do
    case "$field" in
      ID|Image|Command|RunningFor|Ports|State|Status|Names|Size)
        mapped_field="$field"
        ;;
      CreatedAT|CreatedAt)
        # Docker Go 템플릿의 실제 필드명은 '.CreatedAt'임
        mapped_field="CreatedAt"
        ;;
      *)
        help "❌ '${opt_name}'에서 지원하지 않는 컬럼명입니다: '${field}' (지원 목록: ${SUPPORTED_FORMAT_FIELDS[*]})" "${BASH_LINENO[0]:-$LINENO}"
        exit 1
        ;;
    esac

    for seen in "${seen_fields[@]}"; do
      if [[ "$seen" == "$mapped_field" ]]; then
        help "❌ '${opt_name}' 옵션에 동일한 컬럼('${field}')이 중복 지정되었습니다." "${BASH_LINENO[0]:-$LINENO}"
        exit 1
      fi
    done
    seen_fields+=("$mapped_field")
    PARSED_FIELDS+=("$mapped_field")
  done
}

##
# 정규화된 컬럼 목록과 '--no-trunc' 설정을 바탕으로 Docker Go 테이블 템플릿을 생성합니다.
# 맨 마지막 컬럼과 '--no-trunc' 대상 컬럼은 너비 제한 없이 전체를 출력하고,
# 그 외 앞쪽 컬럼은 기본 너비 제한(ID=12, Command=20)을 적용합니다.
#
# @param $1 {string} 전체 --no-trunc 활성화 여부 ('true' 또는 'false')
# @param $2 {string} --no-trunc 대상 정규화 컬럼의 콤마 구분 문자열 (없으면 '')
# @param $@ {array}  출력할 정규화된 컬럼명 목록
#
# @return 생성된 Docker 'table ...' 포맷 문자열 표준 출력
##
build_table_template() {
  local no_trunc_all="$1"
  local no_trunc_csv="$2"
  shift 2

  local -a fields=("$@")
  local -a template_parts=()
  local total="${#fields[@]}"
  local i field is_last is_no_trunc

  for (( i = 0; i < total; i++ )); do
    field="${fields[$i]}"
    is_last=false
    is_no_trunc=false

    (( i == total - 1 )) && is_last=true
    if [[ "$no_trunc_all" == true || "$is_last" == true ]]; then
      is_no_trunc=true
    elif [[ -n "$no_trunc_csv" && ",${no_trunc_csv}," == *",${field},"* ]]; then
      is_no_trunc=true
    fi

    if [[ "$is_no_trunc" == true ]]; then
      template_parts+=("{{.${field}}}")
    else
      case "$field" in
        ID)
          template_parts+=("{{truncate .ID ${DEFAULT_TRUNC_ID_LEN}}}")
          ;;
        Command)
          template_parts+=("{{truncate .Command ${DEFAULT_TRUNC_COMMAND_LEN}}}")
          ;;
        *)
          template_parts+=("{{.${field}}}")
          ;;
      esac
    fi
  done

  local IFS=$'\t'
  printf 'table %s\n' "${template_parts[*]}"
}

##
# 사용자가 입력한 --filter 인자(key=value)의 속성(Key) 및 값 유효성을 검증합니다.
#
# @param $1 {string} 사용자 입력 --filter 문자열
#
# @return 유효 시 0, 무효 시 help 출력 후 exit 1
##
validate_filter_argument() {
  local raw_filter="$1"

  if [[ "$raw_filter" != *=* ]]; then
    help "❌ '--filter' 옵션은 '<속성>=<값>' 형식이어야 합니다 (입력값: '${raw_filter}', 지원 속성: ${SUPPORTED_FILTER_KEYS[*]})." "${BASH_LINENO[0]:-$LINENO}"
    exit 1
  fi

  local key="${raw_filter%%=*}"
  local val="${raw_filter#*=}"

  if [[ -z "$key" || -z "$val" ]]; then
    help "❌ '--filter' 옵션의 속성 또는 값이 비어 있습니다: '${raw_filter}'" "${BASH_LINENO[0]:-$LINENO}"
    exit 1
  fi

  local supported is_valid_key=false
  for supported in "${SUPPORTED_FILTER_KEYS[@]}"; do
    if [[ "$key" == "$supported" ]]; then
      is_valid_key=true
      break
    fi
  done

  if [[ "$is_valid_key" == false ]]; then
    help "❌ 지원하지 않는 '--filter' 속성입니다: '${key}' (지원 속성: ${SUPPORTED_FILTER_KEYS[*]})" "${BASH_LINENO[0]:-$LINENO}"
    exit 1
  fi

  # 주요 열거형 필터 값 사전 검증
  case "$key" in
    status)
      case "$val" in
        created|restarting|running|removing|paused|exited|dead) ;;
        *)
          help "❌ '--filter status=${val}' 값이 유효하지 않습니다. (허용값: created, restarting, running, removing, paused, exited, dead)" "${BASH_LINENO[0]:-$LINENO}"
          exit 1
          ;;
      esac
      ;;
    health)
      case "$val" in
        starting|healthy|unhealthy|none) ;;
        *)
          help "❌ '--filter health=${val}' 값이 유효하지 않습니다. (허용값: starting, healthy, unhealthy, none)" "${BASH_LINENO[0]:-$LINENO}"
          exit 1
          ;;
      esac
      ;;
    is-task)
      case "$val" in
        true|false) ;;
        *)
          help "❌ '--filter is-task=${val}' 값이 유효하지 않습니다. (허용값: true, false)" "${BASH_LINENO[0]:-$LINENO}"
          exit 1
          ;;
      esac
      ;;
    isolation)
      case "$val" in
        default|process|hyperv) ;;
        *)
          help "❌ '--filter isolation=${val}' 값이 유효하지 않습니다. (허용값: default, process, hyperv)" "${BASH_LINENO[0]:-$LINENO}"
          exit 1
          ;;
      esac
      ;;
    exited)
      if [[ ! "$val" =~ ^-?[0-9]+$ ]]; then
        help "❌ '--filter exited=${val}' 값은 정수(종료 코드)여야 합니다." "${BASH_LINENO[0]:-$LINENO}"
        exit 1
      fi
      ;;
  esac

  return 0
}

##
# Docker 명령어 존재 여부 및 소켓 접근 권한을 확인하고, 필요한 시점에 sudo 권한을 요청합니다.
#
# @return DOCKER_CMD 전역 배열 설정
##
ensure_docker_ready() {
  if ! command -v docker >/dev/null 2>&1; then
    help "❌ 시스템에 'docker' 명령어가 설치되어 있지 않습니다." "${BASH_LINENO[0]:-$LINENO}"
    exit 1
  fi

  # 일반 사용자 권한으로 Docker 소켓 접근이 가능한지 먼저 확인
  if docker info >/dev/null 2>&1; then
    DOCKER_CMD=(docker)
    return 0
  fi

  # 소켓 권한이 없는 경우 sudo 권한 요청
  if ! command -v sudo >/dev/null 2>&1; then
    help "❌ Docker 데몬 접근을 위해 'sudo'가 필요하나 시스템에 설치되어 있지 않습니다." "${BASH_LINENO[0]:-$LINENO}"
    exit 1
  fi

  if ! sudo -n true 2>/dev/null; then
    echo "🔐 [AUTH] Docker 컨테이너 목록 조회를 위해 sudo 권한 확인이 필요합니다." >&2
    if ! sudo -v; then
      help "❌ sudo 권한 획득에 실패하여 작업을 진행할 수 없습니다." "${BASH_LINENO[0]:-$LINENO}"
      exit 1
    fi
  fi

  DOCKER_CMD=(sudo docker)

  if ! "${DOCKER_CMD[@]}" info >/dev/null 2>&1; then
    help "❌ Docker 데몬이 실행 중이지 않거나 소켓에 접근할 수 없습니다." "${BASH_LINENO[0]:-$LINENO}"
    exit 1
  fi
}

##
# 메인 실행 함수
#
# @param $@ {array} CLI 인자
#
# @return 0 on success
##
main() {
  reject_external_sudo

  local opt_all=false
  local -a opt_filters=()
  local opt_format_raw=""
  local -a opt_format_fields=()
  local opt_last=""
  local opt_latest=false
  local opt_no_trunc_all=false
  local opt_no_trunc_csv=""
  local opt_quiet=false
  local opt_size=false

  local has_all=false
  local has_format=false
  local has_last=false
  local has_latest=false
  local has_no_trunc=false
  local has_quiet=false
  local has_size=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)
        if [[ "$has_all" == true ]]; then
          help "❌ '--all' 옵션이 중복 지정되었습니다." "$LINENO"
          exit 1
        fi
        has_all=true
        opt_all=true
        shift
        ;;
      --filter|--filter=*)
        local f_val=""
        if [[ "$1" == *=* ]]; then
          f_val="${1#*=}"
          shift
        else
          if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == -* ]]; then
            help "❌ '--filter' 옵션 뒤에 '<속성>=<값>'을 지정해야 합니다." "$LINENO"
            exit 1
          fi
          f_val="$2"
          shift 2
        fi
        validate_filter_argument "$f_val"
        opt_filters+=("$f_val")
        ;;
      --format|--format=*)
        if [[ "$has_format" == true ]]; then
          help "❌ '--format' 옵션이 중복 지정되었습니다." "$LINENO"
          exit 1
        fi
        has_format=true
        local fmt_val=""
        if [[ "$1" == *=* ]]; then
          fmt_val="${1#*=}"
          shift
        else
          if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == -* ]]; then
            help "❌ '--format' 옵션 뒤에 컬럼 목록 또는 포맷 문자열을 지정해야 합니다." "$LINENO"
            exit 1
          fi
          fmt_val="$2"
          shift 2
        fi
        if is_raw_docker_format "$fmt_val"; then
          opt_format_raw="$fmt_val"
        else
          parse_comma_fields "--format" "$fmt_val"
          opt_format_fields=("${PARSED_FIELDS[@]}")
        fi
        ;;
      --last|--last=*)
        if [[ "$has_last" == true ]]; then
          help "❌ '--last' 옵션이 중복 지정되었습니다." "$LINENO"
          exit 1
        fi
        has_last=true
        local last_val=""
        if [[ "$1" == *=* ]]; then
          last_val="${1#*=}"
          shift
        else
          if [[ $# -lt 2 || -z "${2:-}" ]]; then
            help "❌ '--last' 옵션 뒤에 정수 값을 지정해야 합니다." "$LINENO"
            exit 1
          fi
          last_val="$2"
          shift 2
        fi
        if [[ ! "$last_val" =~ ^-?[0-9]+$ ]]; then
          help "❌ '--last' 옵션 값은 정수여야 합니다 (입력값: '${last_val}')." "$LINENO"
          exit 1
        fi
        opt_last="$last_val"
        ;;
      --latest)
        if [[ "$has_latest" == true ]]; then
          help "❌ '--latest' 옵션이 중복 지정되었습니다." "$LINENO"
          exit 1
        fi
        has_latest=true
        opt_latest=true
        shift
        ;;
      --no-trunc|--no-trunc=*)
        if [[ "$has_no_trunc" == true ]]; then
          help "❌ '--no-trunc' 옵션이 중복 지정되었습니다." "$LINENO"
          exit 1
        fi
        has_no_trunc=true
        if [[ "$1" == *=* ]]; then
          local nt_val="${1#*=}"
          shift
          if [[ -z "$nt_val" ]]; then
            help "❌ '--no-trunc=' 뒤에 콤마로 구분된 컬럼 목록을 지정해야 합니다." "$LINENO"
            exit 1
          fi
          parse_comma_fields "--no-trunc" "$nt_val"
          local IFS=','
          opt_no_trunc_csv="${PARSED_FIELDS[*]}"
        elif [[ $# -ge 2 && "${2:-}" != -* ]]; then
          local nt_val="${2:-}"
          shift 2
          if [[ -z "$nt_val" ]]; then
            help "❌ '--no-trunc' 뒤에 지정한 컬럼 목록이 비어 있습니다." "$LINENO"
            exit 1
          fi
          parse_comma_fields "--no-trunc" "$nt_val"
          local IFS=','
          opt_no_trunc_csv="${PARSED_FIELDS[*]}"
        else
          opt_no_trunc_all=true
          shift
        fi
        ;;
      --quiet)
        if [[ "$has_quiet" == true ]]; then
          help "❌ '--quiet' 옵션이 중복 지정되었습니다." "$LINENO"
          exit 1
        fi
        has_quiet=true
        opt_quiet=true
        shift
        ;;
      --size)
        if [[ "$has_size" == true ]]; then
          help "❌ '--size' 옵션이 중복 지정되었습니다." "$LINENO"
          exit 1
        fi
        has_size=true
        opt_size=true
        shift
        ;;
      --help)
        help ""
        exit 0
        ;;
      -*)
        help "❌ 단축 옵션(Short Option)은 지원하지 않거나 알 수 없는 옵션입니다: '$1'" "$LINENO"
        exit 1
        ;;
      *)
        help "❌ 알 수 없는 인자입니다: '$1'" "$LINENO"
        exit 1
        ;;
    esac
  done

  # --no-trunc <columns>와 --quiet 또는 커스텀 --format 조합 검증
  if [[ -n "$opt_no_trunc_csv" && "$opt_quiet" == true ]]; then
    help "❌ '--quiet' 옵션은 컨테이너 ID만 출력하므로 '--no-trunc'에 컬럼 목록을 함께 지정할 수 없습니다." "$LINENO"
    exit 1
  fi
  if [[ -n "$opt_no_trunc_csv" && -n "$opt_format_raw" ]]; then
    help "❌ '--format'에 키워드('table', 'json') 또는 커스텀 Go 템플릿을 지정한 경우 '--no-trunc <columns>'를 함께 사용할 수 없습니다." "$LINENO"
    exit 1
  fi

  # Docker 실행 권한 및 데몬 준비
  ensure_docker_ready

  # docker container ls 인자 배열 조립 (단어 분리 방지)
  local -a cmd_args=(container ls)

  [[ "$opt_all" == true ]] && cmd_args+=(--all)

  local f
  for f in "${opt_filters[@]}"; do
    cmd_args+=(--filter "$f")
  done

  if (( ${#opt_format_fields[@]} > 0 )); then
    local built_format
    built_format="$(build_table_template "$opt_no_trunc_all" "$opt_no_trunc_csv" "${opt_format_fields[@]}")"
    cmd_args+=(--format "$built_format" --no-trunc)
  elif [[ -n "$opt_no_trunc_csv" ]]; then
    local -a default_fields=(ID Image Command RunningFor Status Ports Names)
    [[ "$opt_size" == true ]] && default_fields+=(Size)
    local built_format
    built_format="$(build_table_template "false" "$opt_no_trunc_csv" "${default_fields[@]}")"
    cmd_args+=(--format "$built_format" --no-trunc)
  else
    [[ -n "$opt_format_raw" ]] && cmd_args+=(--format "$opt_format_raw")
    [[ "$opt_no_trunc_all" == true ]] && cmd_args+=(--no-trunc)
  fi

  [[ -n "$opt_last" ]] && cmd_args+=(--last "$opt_last")
  [[ "$opt_latest" == true ]] && cmd_args+=(--latest)
  [[ "$opt_quiet" == true ]] && cmd_args+=(--quiet)
  [[ "$opt_size" == true ]] && cmd_args+=(--size)

  "${DOCKER_CMD[@]}" "${cmd_args[@]}"
}

main "$@"
exit 0
