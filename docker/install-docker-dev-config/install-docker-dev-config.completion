# =======================================
# @author   : parkjunhong77@gmail.com
# @title    : install-docker-dev-config bash completion.
# @license  : Apache License 2.0
# @since    : 2026-07-23
# @desc     : support RHEL, Oracle Linux, Ubuntu, RockyOS, CentOS
# @installation :
#   1. insert 'source <path>/install-docker-dev-config.completion' into ~/.bashrc or ~/.bash_profile for a personal usage.
#   2. copy the completion file to /usr/share/bash-completion/completions/install-docker-dev-config (1st) or /etc/bash_completion.d/install-docker-dev-config.completion (2nd) for all users.
# =======================================

# =======================================
# [Bash Completion Parameter Description]
# 1. COMP_WORDS: an array containing all individual words in the current command line
#    (현재 커맨드 라인에 입력된 단어들의 배열)
# 2. COMP_CWORD: an index of the word containing the current cursor position
#    (현재 커서가 위치한 단어의 인덱스)
# 3. COMP_LINE: the current command line string
#    (현재까지 커맨드 라인에 입력된 전체 문자열)
# 4. COMPREPLY: an array variable from which Bash reads the possible completions
#    (bash completion이 제안할 단어들의 배열)
#
# Arguments of completion function:
# - $1: name of the command whose arguments are being completed (명령의 이름)
# - $2: word being completed (현재 커서에서 완성하려고 하는 단어)
# - $3: word preceding the word being completed (현재 완성하려는 단어의 바로 이전 단어)
# =======================================

##
# install-docker-dev-config 명령어에 대한 Bash 자동 완성 함수
#
# @param $1 {string} 명령어 이름
# @param $2 {string} 현재 완성 중인 단어
# @param $3 {string} 직전 단어
#
# @return COMPREPLY 배열 설정
##
_install_docker_dev_config_completion() {
  local cur prev
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]:-}"
  prev="${COMP_WORDS[COMP_CWORD-1]:-}"

  local -a opts=("--resources" "--help")
  local -a resource_items=("all" "docker" "docker-compose" "os_version" "deploy.sh")

  case "$cur" in
    --resources=*)
      local val_part="${cur#--resources=}"
      local prefix="--resources="
      if [[ "$val_part" == *,* ]]; then
        prefix="--resources=${val_part%,*},"
        val_part="${val_part##*,}"
      fi
      local cand
      while IFS= read -r cand; do
        [[ -n "$cand" ]] && COMPREPLY+=("${prefix}${cand}")
      done < <(compgen -W "${resource_items[*]}" -- "$val_part")
      return 0
      ;;
  esac

  case "$prev" in
    --resources)
      if [[ "$cur" == *,* ]]; then
        local prefix="${cur%,*},"
        local last_part="${cur##*,}"
        local cand
        while IFS= read -r cand; do
          [[ -n "$cand" ]] && COMPREPLY+=("${prefix}${cand}")
        done < <(compgen -W "${resource_items[*]}" -- "$last_part")
      else
        COMPREPLY=( $(compgen -W "${resource_items[*]}" -- "$cur") )
      fi
      return 0
      ;;
  esac

  COMPREPLY=( $(compgen -W "${opts[*]}" -- "$cur") )
  return 0
}

complete -F _install_docker_dev_config_completion install-docker-dev-config ./install-docker-dev-config
