# =======================================
# @author : parkjunhong77@gmail.com
# @title : install docker.
# @license : Apache License 2.0
# @since : 2026-08-20
# @desc : support Ubuntu 24.04 or higher
# @installation : 
# 1. insert 'source <path>/<파일명>" into ~/bin/.bashrc or ~/bin/.bash_profile for a personal usage.
# 2. copy the above file to /etc/bash_completion.d/ or insert 'source <path>/<파일명>' into /etc/bashrc for all users.
# =======================================
#
# =======================================
# Global Reserved Variables
# 1. COMP_WORDS: an array, contains all arguments
# 2. COMP_CWORD: a index of a cursor
# 3. COMP_LINE: all command string
# 4. COMPREPLY: an array, contains suggested words. words are sorted and unique.
#
# Arguments of a function
# 1. $1: command
# 2. $2: current
# 3. $3: previous
#
# e.g.: mycmd arg1 arg2 arg3 arg4[tab]
# - $1: mycmd
# - $2: arg4
# - $3: arg3
# =======================================

_docker_installer_completion() {
  local cur prev opts remaining_opts found
  
  cur="${2:-}"
  prev="${3:-}"
  opts="-u --user -h --help"
  
  # --user 옵션이 이전 파라미터일 경우, 시스템 계정을 추천 (Suggest system users)
  if [[ "$prev" == "-u" || "$prev" == "--user" ]]; then
    COMPREPLY=( $(compgen -u -- "$cur") )
    return 0
  fi

  # 이미 입력한 옵션을 추천에서 제외하기 위한 필터링 (Filter already typed options)
  remaining_opts=""
  for opt in $opts; do
    found=0
    for word in "${COMP_WORDS[@]}"; do
      if [[ "$opt" == "$word" ]]; then
        found=1
        break
      fi
    done
    if [[ $found -eq 0 ]]; then
      remaining_opts="$remaining_opts $opt "
    fi
  done

  # 파라미터가 파일/경로인 경우 tab 키를 이용해서 추천 (Suggest files and directories)
  if [[ "$cur" == /* || "$cur" == ./* || "$cur" == ../* ]]; then
    COMPREPLY=( $(compgen -f -- "$cur") )
    return 0
  fi

  # '-' 기호 입력 없이 tab 만 눌러도 남은 옵션을 추천하도록 구성 (Auto suggest without '-')
  COMPREPLY=( $(compgen -W "$remaining_opts" -- "$cur") )
  return 0
}

complete -o default -F _docker_installer_completion docker-installer.sh
