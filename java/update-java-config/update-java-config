#!/usr/bin/env bash

# =======================================
# @author : parkjunhong77@gmail.com
# @title  : update-java-config: Interactive Java version switcher and ~/.java_env generator for Linux
# @license: Apache License 2.0
# @since  : 2026-03-11
# @desc   : support RHEL, Oracle Linux, Ubuntu, RockyOS
# =======================================

help(){
    echo "Usage: $(basename "$0") [--help]"
    echo ""
    echo "Linux 환경에서 update-alternatives를 통해 Java 버전을 선택하고"
    echo "선택된 JDK 경로를 추적하여 ~/.java_env 파일에 JAVA_HOME을 갱신합니다."
    echo ""
    echo "Options:"
    echo "  --help    도움말 출력"
    echo ""
    exit 0
}

if [[ "$1" == "--help" ]]; then
    help
fi

# 1. OS의 Java 버전 선택 인터페이스 호출 (사용자 인터랙트 대기)
sudo update-alternatives --config java

# 2. update-alternatives로 선택된 java의 실제 물리적 경로 추적
SELECTED_JAVA=$(dirname "$(dirname "$(readlink -f "$(which java)")")")
ENV_FILE="$HOME/.java_env"

# 3. 부모 쉘이 읽어들일 수 있도록 환경 변수 파일 생성
cat <<EOF > "$ENV_FILE"
# Auto-generated by update-java-config
export JAVA_HOME="$SELECTED_JAVA"
EOF

echo "[System] Java 설정이 갱신되었습니다: $SELECTED_JAVA" >&2

exit 0
