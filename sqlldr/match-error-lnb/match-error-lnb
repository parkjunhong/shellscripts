#!/usr/bin/env bash

# =======================================
# @author : parkjunhong77@gmail.com
# @title  : match-error-lnb: Map Oracle SQL*Loader rejected record positions to badfile line numbers
# @license: Apache License 2.0
# @since  : 2021-04-19
# @desc   : support macOS 11.2.3, Ubuntu 18.04 or higher, CentOS 7 or higher
# =======================================

FILENAME=$(basename "$0")

help(){
    echo "Usage: $FILENAME [--file] <input-log-file> [--output <output-file>] [--help]"
    echo ""
    echo "Oracle SQL*Loader 실행 로그를 분석하여 거부된 레코드(Rejected Error)의"
    echo "원본 데이터 위치와 badfile 데이터 위치를 매핑하는 파일을 생성합니다."
    echo ""
    echo "Options:"
    echo "  --file <filepath>    분석할 SQL*Loader 로그 파일 경로 (필수)"
    echo "  --output <filepath>  매핑 결과를 저장할 출력 파일 경로 (기본값: match-badfile-<filename>.txt)"
    echo "  --help               도움말 출력"
    echo ""
    exit 1
}

INPUT_FILE=""
OUTPUT_FILE=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --file)
            INPUT_FILE="$2"
            shift 2
            ;;
        --output)
            OUTPUT_FILE="$2"
            shift 2
            ;;
        --help)
            help
            ;;
        *)
            if [[ -z "$INPUT_FILE" ]]; then
                INPUT_FILE="$1"
                shift
            else
                echo "알 수 없는 옵션: $1"
                help
            fi
            ;;
    esac
done

if [[ -z "$INPUT_FILE" ]]; then
    echo "오류: 분석할 입력 파일 경로가 필요합니다."
    help
fi

if [[ ! -f "$INPUT_FILE" ]]; then
    echo "오류: 입력 파일을 찾을 수 없습니다: $INPUT_FILE"
    exit 1
fi

if [[ -z "$OUTPUT_FILE" ]]; then
    OUTPUT_FILE="match-badfile-$(basename "$INPUT_FILE").txt"
fi

# 진행률 시각화 관련 함수
PROG_MOD=30
dotprogress(){
    local idx=0
    local prog=""
    while [ "${idx}" -lt "${PROG_MOD}" ]; do
        prog="${prog}."
        echo "${prog}"
        ((idx++))
    done
}

##
# convert timestamp to {hours}h {minutes}m {seconds}h.
# @param $1 {number} timestamp
# @return 
timestamp-to-hms(){
    local _sec_r=$(($1%60))
    local _min_r=$(($1/60%60))
    local _hour_q=$(($1/60/60))

    printf "%'dh %sm %ss" $_hour_q $_min_r $_sec_r
}

_progress=($(dotprogress))

#
# @param $1 {number} 원본 데이터 위치
# @param $2 {string} 컬럼 이름
# @param $3 {number} badfile 데이터 위치
# @param $4 {string} 파일 경로
write-match(){
    printf "%10s : %-20s => %10s\n" "$1" "$2" "$3" >> "$4"
}

_fmt_label="%-15s"
_fmt_input=" * * * $_fmt_label:"
_fmt_info=" + + + $_fmt_label:"
_fmt_result=" - - - $_fmt_label:"

# 입력 정보
printf "$_fmt_input %s\n" "Input File" "$INPUT_FILE"
printf "$_fmt_input %s\n" "Output File" "$OUTPUT_FILE"

# 기존 결과 파일 초기화
> "$OUTPUT_FILE"

_begin_date=$(date +"%Y/%m/%d %H:%M:%S")
_begin_ts=$(date +"%s")

echo 
_err_count=0

# 에러 메시지 매칭 정규식
REGEX="^Record [0-9]+: Rejected - Error on table [a-zA-Z0-9_]+, column [a-zA-Z0-9_]+\.$"
# sqlldr badfile 데이터 위치
_badfile_line=0
# 줄 번호
_ln=1

while read -r line; do
	if [[ "$line" =~ $REGEX ]]; then
		((_badfile_line++))
		arr=( $line )
		data_pos="${arr[1]}"
		column_name="${arr[9]}"
		write-match "${data_pos//:/}" "${column_name//./}" "$_badfile_line" "$OUTPUT_FILE"
		
		((_err_count++))
	fi

	printf "\r\033[K + + + %-12s: %'d | %s" "Line.Reading" "$_ln" "${_progress[((${_ln}%${PROG_MOD}))]}"
	((_ln++))
done < "$INPUT_FILE"

printf "\r\033[K$_fmt_info: %'d\n" "Completed" "$_ln"
printf "$_fmt_info: %'d\n" "Error" "$_err_count"

_end_date=$(date +"%Y/%m/%d %H:%M:%S")
_end_ts=$(date +"%s") 

echo
printf "$_fmt_result %s\n" "Read.begin" "$_begin_date"
printf "$_fmt_result %s\n" "Read.elapsed" "$(timestamp-to-hms $(($_end_ts-$_begin_ts)))"
printf "$_fmt_result %s\n" "Read.end" "$_end_date"
printf "$_fmt_result %s\n" "Output" "$OUTPUT_FILE"

exit 0
