#!/usr/bin/env bash

# =======================================
# @author : parkjunhong77@gmail.com
# @title  : tar-dirs: Compress individual subdirectories into separate tar.gz archives
# @license: Apache License 2.0
# @since  : 2021-04-19
# @desc   : support macOS 11.2.3, Ubuntu 18.04 or higher, CentOS 7 or higher
# =======================================

help(){
	echo "[Usage]"
	echo "tar-dirs --target <target-dir> [--output <output-dir>] [--suffix <tarfile-suffix>] [--include <include-pattern>] [--exclude <exclude-pattern>] [--dry-run] [--quiet] [--help]"
	echo
	echo "[Options]"
	echo " --target : target directory to find subdirectories (required)"
	echo " --output : (optional) output directory. Default is equal to target."
	echo " --suffix : (optional) a suffix of archived file."
	echo " --include: (optional) directory name patterns for inclusion, separated by comma(,)."
	echo " --exclude: (optional) directory name patterns for exclusion, separated by comma(,)."
	echo " --dry-run: (optional) DO NOT archive, only show processing logs."
	echo " --quiet  : (optional) DO NOT show processing logs."
	echo " --help   : show help messages"
	echo
}

# 파라미터가 전혀 없는 경우 종료
if [ $# -lt 1 ]; then
	echo "Please, input arguments."
	help
	exit 2
fi

TARGET=""
OUTPUT=""
SUFFIX=""
DRY_RUN="false"
VERBOSE="true"
INCLUDE=""
EXCLUDE=""

## 파라미터 읽기 (Long Option 전용)
while [ "$1" != "" ]; do
	case "$1" in
		--target)
			shift
			TARGET="$1"
			;;
		--output)
			shift
			OUTPUT="$1"
			;;
		--suffix)
			shift
			SUFFIX="$1"
			;;
		--include)
			shift
			INCLUDE="$1"
			;;
		--exclude)
			shift
			EXCLUDE="$1"
			;;
		--dry-run)
			DRY_RUN="true"
			;;
		--quiet)
			VERBOSE="false"
			;;
		--help)
			help
			exit 0
			;;
		*)
			echo "Unknown option: $1"
			help
			exit 2
			;;
	esac
	shift
done

# 대상 디렉토리 필수 검사
if [ -z "$TARGET" ]; then
	echo "Error: --target directory is required."
	help
	exit 2
fi

# if $DRY_RUN is set, fix $VERBOSE to true.
if [ "$DRY_RUN" == "true" ]; then
	VERBOSE="true"
fi

# show logs according to $VERBOSE
print(){
	local _logs=""
	if [ "$VERBOSE" == "true" ]; then
		local args=("$@")
		for i in "${args[@]}"; do
			_logs="${_logs} ${i}"
		done
	fi
	
	if [ -n "$_logs" ]; then
		echo "$_logs"
	fi
}

# @param $1 directory
# @param $2 if $1 does not exist and is not a file, create a new directory.
validateDir(){
	if [ ! -d "$1" ]; then
		if [ -f "$1" ]; then
			print "Oops!!! '$1' is a file."
		fi

		if [ "$2" == "true" ]; then
			print "Create an output directory. directory=$1"
			mkdir -p "$1"
		elif [ "$DRY_RUN" != "true" ]; then
			print "Oops!!! '$1' is not a directory."
			help
			exit 2
		fi
	fi
}

# 절대경로인지 확인
# @param $1 directory
# @return true or false
isAbsolutePath(){
	if [[ "$1" == /* ]]; then
		echo "true"
	else
		echo "false"
	fi
}

# if the directory's last char is /, omit.
# @param $1 directory
# @return directory 
omitFinalSlash(){
	local _dir="$1"
	if [[ "$_dir" == */ ]]; then
		echo "${_dir:0:-1}"
	else
		echo "$_dir"
	fi
}

# @param $1 directory to be validated
# @param $2 if $1 is empty, return this
isEmptyThenDefault(){
	if [ -z "$1" ]; then
		echo "$2"
	else
		echo "$1"
	fi
}

# @param directory
# @param file
# @return a filepath
makePath(){
	local _path=""
	local args=("$@")
	for i in "${args[@]}"; do
		if [ -n "$i" ]; then
			if [ -z "$_path" ]; then
				_path="$i"
			else
				_path="${_path}/${i}"
			fi
		fi
	done

	echo "$_path"
}

# validate a target directory
validateDir "$TARGET"

OUTPUT=$(isEmptyThenDefault "$OUTPUT" "$TARGET")

# validate an output directory
if [ "$DRY_RUN" == "true" ]; then
	validateDir "$OUTPUT"
else
	validateDir "$OUTPUT" true
fi

TARGET=$(omitFinalSlash "$TARGET")
OUTPUT=$(omitFinalSlash "$OUTPUT")

# current directory
CURRENT_PWD=$(pwd)

# 압축파일 생성 디렉토리가 상대경로인 경우
if [ "$TARGET" == "$OUTPUT" ]; then
	OUTPUT=""
elif [[ "$OUTPUT" != /* ]]; then
	OUTPUT="${CURRENT_PWD}/${OUTPUT}"
fi
	
cd "$TARGET" || exit 1

CMD="ls -l | grep -E ^d"

# 압축 대상 지정 디렉토리 확인
if [ -n "$INCLUDE" ]; then
	CMD="${CMD} | grep -E \"${INCLUDE/,/|}\""
fi

# 압축 제외 디렉토리 확인
if [ -n "$EXCLUDE" ]; then
	CMD="${CMD} | grep -Ev \"${EXCLUDE/,/|}\""
fi

# 디렉토리명만 확보 
CMD="${CMD} | awk '{print \$9}'"

# 디렉토리 조회
DIRS=$(eval "$CMD")

for DIR in $DIRS; do
	FILE=$(makePath "$OUTPUT" "$DIR")
	if [ -n "$SUFFIX" ]; then
		FILE="${FILE}-${SUFFIX}"
	fi
	print "============================================================"
	print "$DIR is archiving..."
	print "tar -zcf ${FILE}.tar.gz $DIR"
	if [ "$DRY_RUN" != "true" ]; then
		tar -zcf "${FILE}.tar.gz" "$DIR"
	fi
	print "$DIR is archived!!!"
done

print "============================================================"

exit 0
