# =======================================
# @author   : parkjunhong77@gmail.com
# @title    : sciectl bash completion.
# @license  : Apache License 2.0
# @since    : 2026-05-12
# @desc     : support Ubuntu 24+, Rocky Linux 9+, RHEL 9+, CentOS Stream 9+, macOS (Homebrew Bash)
# @installation :
#   1. insert 'source <path>/sciectl.completion' into ~/.bashrc or ~/.bash_profile for a personal usage.
#   2. copy the completion file to /usr/share/bash-completion/completions/sciectl (1st) or /etc/bash_completion.d/sciectl.completion (2nd) for all users.
# =======================================

# =======================================
# [Bash Completion Parameter Description]
# 1. COMP_WORDS: an array containing all individual words in the current command line
#    (현재 커맨드 라인에 입력된 단어들의 배열)
# 2. COMP_CWORD: an index of the word containing the current cursor position
#    (현재 커서가 위치한 단어의 인덱스)
# 3. COMP_LINE: the current command line string
#    (현재까지 커맨드 라인에 입력된 전체 문자열)
# 4. COMPREPLY: an array variable from which Bash reads the possible completions
#    (bash completion이 제안할 단어들의 배열)
#
# Arguments of completion function:
# - $1: name of the command whose arguments are being completed (명령의 이름)
# - $2: word being completed (현재 커서에서 완성하려고 하는 단어)
# - $3: word preceding the word being completed (현재 완성하려는 단어의 바로 이전 단어)
# =======================================

# 원격 GitHub 저장소 Raw 기본 URL
readonly SCIECTL_REPO_RAW_URL_DEFAULT="https://raw.githubusercontent.com/parkjunhong/shellscripts/main"

##
# 캐시 디렉토리 경로를 반환합니다.
# 1순위: ${XDG_CACHE_HOME:-$HOME/.cache}/sciectl
# 2순위: /tmp/.sciectl_cache_${EUID:-0}
#
# @return 캐시 디렉토리 경로
##
_sciectl_get_cache_dir() {
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/sciectl"
  if mkdir -p "$dir" 2>/dev/null; then
    printf '%s\n' "$dir"
    return 0
  fi
  dir="/tmp/.sciectl_cache_${EUID:-$(id -u 2>/dev/null || echo 0)}"
  mkdir -p "$dir" 2>/dev/null || true
  printf '%s\n' "$dir"
}

##
# 파일의 경과 시간(초 단위)을 계산합니다.
# Linux(stat -c %Y) 및 macOS(stat -f %m)를 모두 지원합니다.
#
# @param $1 {string} 파일 경로
#
# @return 경과 시간(초)
##
_sciectl_get_file_age() {
  local file="$1"
  local now file_mtime
  now="$(date +%s)"
  file_mtime="$(stat -c %Y "$file" 2>/dev/null || stat -f %m "$file" 2>/dev/null || echo 0)"
  echo $(( now - file_mtime ))
}

##
# 원격 GitHub에서 catalogs.ini 파일을 다운로드하여 TTL(기본 60초) 캐시를 관리하고
# 로컬 캐시 파일 경로를 반환합니다.
#
# @return catalogs.ini 캐시 파일 경로
##
_sciectl_fetch_remote_catalogs_cached() {
  local cache_dir
  cache_dir="$(_sciectl_get_cache_dir)"
  local cache_file="${cache_dir}/catalogs.ini"
  local ttl="${SCIECTL_CACHE_TTL:-60}" # 기본값: 60초 (1분)
  local raw_base="${SCIECTL_REPO_RAW_URL:-$SCIECTL_REPO_RAW_URL_DEFAULT}"

  local need_refresh=1
  if [[ -f "$cache_file" && -s "$cache_file" ]]; then
    local age
    age="$(_sciectl_get_file_age "$cache_file")"
    if (( age < ttl )); then
      need_refresh=0
    fi
  fi

  if (( need_refresh == 1 )); then
    local tmp_fetch="${cache_file}.tmp.$$"
    if curl -sf --connect-timeout 2 --max-time 4 "${raw_base}/env/catalogs/catalogs.ini" -o "$tmp_fetch" 2>/dev/null && [[ -s "$tmp_fetch" ]]; then
      mv -f "$tmp_fetch" "$cache_file" 2>/dev/null || true
    else
      rm -f "$tmp_fetch" 2>/dev/null || true
      [[ -f "$cache_file" ]] && touch "$cache_file" 2>/dev/null || true
    fi
  fi

  if [[ -f "$cache_file" && -s "$cache_file" ]]; then
    printf '%s\n' "$cache_file"
    return 0
  fi
  return 1
}

##
# 원격 GitHub에서 개별 *.catalog 파일을 다운로드하여 TTL(기본 60초) 캐시를 관리하고
# 로컬 캐시 파일 경로를 반환합니다.
#
# @param $1 {string} 카탈로그 파일명 (예: setup-env.catalog) 또는 카탈로그 ID
#
# @return 캐시 파일 경로
##
_sciectl_fetch_remote_catalog_file_cached() {
  local target="$1"
  local cat_file="${target%.catalog}.catalog"
  local cache_dir
  cache_dir="$(_sciectl_get_cache_dir)"
  local local_path="${cache_dir}/${cat_file}"
  local ttl="${SCIECTL_CACHE_TTL:-60}" # 기본값: 60초 (1분)
  local raw_base="${SCIECTL_REPO_RAW_URL:-$SCIECTL_REPO_RAW_URL_DEFAULT}"

  local need_refresh=1
  if [[ -f "$local_path" && -s "$local_path" ]]; then
    local age
    age="$(_sciectl_get_file_age "$local_path")"
    if (( age < ttl )); then
      need_refresh=0
    fi
  fi

  if (( need_refresh == 1 )); then
    local tmp_fetch="${local_path}.tmp.$$"
    if curl -sf --connect-timeout 2 --max-time 4 "${raw_base}/env/catalogs/${cat_file}" -o "$tmp_fetch" 2>/dev/null && [[ -s "$tmp_fetch" ]]; then
      mv -f "$tmp_fetch" "$local_path" 2>/dev/null || true
    else
      rm -f "$tmp_fetch" 2>/dev/null || true
      [[ -f "$local_path" ]] && touch "$local_path" 2>/dev/null || true
    fi
  fi

  if [[ -f "$local_path" && -s "$local_path" ]]; then
    printf '%s\n' "$local_path"
    return 0
  fi
  return 1
}

##
# 카탈로그 파일(*.catalog)들로부터 특정 필드 키(TOOLS, INSTALLERS, COMMANDS, SSH_KEYS)의
# 값들을 파싱하여 중복 없이 정렬된 목록으로 추출합니다 (멀티라인 \ 지원).
#
# @param $1 {string} 필드 키 이름 (예: TOOLS)
# @param $@ {array} 카탈로그 파일 경로 목록
#
# @return 추출된 고유 항목 목록 (공백 구분)
##
_sciectl_parse_catalog_field() {
  local field_key="$1"
  shift
  local -a files=("$@")
  (( ${#files[@]} > 0 )) || return 0

  awk -v fkey="$field_key" '
    $0 ~ ("^" fkey "=") {
      val = substr($0, length(fkey) + 2)
      while (val ~ /\\$/) {
        sub(/\\$/, "", val)
        if ((getline next_line) > 0) {
          val = val " " next_line
        }
      }
      split(val, arr, ",")
      for (i in arr) {
        gsub(/^[ \t]+|[ \t]+$/, "", arr[i])
        if (arr[i] != "") print arr[i]
      }
    }
  ' "${files[@]}" 2>/dev/null | sort -u | tr '\n' ' '
}

##
# 카탈로그, 도구, 인스톨러, 명령어, 키 등의 자동완성 후보군을 원격 카탈로그 정의 기준으로 로드합니다.
# 작업 디렉토리 조회는 전면 금지되며, 오직 원격 GitHub의 catalogs.ini 및 *.catalog 파일의
# 정의 내용만 TTL(60초) 캐시를 통해 수집합니다.
##
_sciectl_load_candidates() {
  # 1. Fallback 기본값 (네트워크 단절 및 최초 실행 비상용, 정식 등록된 12개 카탈로그 및 82개 도구)
  catalog_candidates="setup-env default-server default-devops network docker install-lets-encrypt-certificate git gitlab ai-agent installer security all-scripts"
  tool_candidates="ai-agent/asr-cli build/clean-project build/deploy-profile build/remove-deploy db/h2-db-migrate db/mariadb-backup db/mariadb-restore docker/dkcontls docker/dknetcli docker/install-docker docker/install-docker-dev-config docker/pull-gitlab-images docker/setup-compose-service docker/setup-docker-compose env/sciectl es/es-index-usage es/es-search-index fail2ban/fail2ban-unbanip git/git-branch-cmd git/git-commit git/git-config git/git-ff-sync git/git-getpr git/git-init git/git-log-abbr git/git-log-all git/git-merge git/git-modify git/git-mrq git/git-pull-all git/git-push-after-sync git/git-push-all git/git-status-all git/git-tags gitlab/clone-gitlab-projects gitlab/gitlab-clone installer/install-albert-with-socket installer/install-antigravity-ide installer/install-antigravity-x64 java/mac-clean-java-config java/mac-update-java-config java/update-java-config maven/build-deploy-all maven/build-mvn-package maven/mvn-deploy maven/update-mvn-config maven/upload-mvn-dependencies net/add-vlan-routes net/fwc-cli net/fwc-docker-policy net/mtr-netstat-conns net/ps-port net/scp-dir net/ssh-proxy net/sshctl redis/redis-search security/authelia-crypto-hash security/ssl-del security/ssl-inst sudo/sudoers-cli sys/cat-cli sys/copy-suffix sys/disk-size sys/remove-service sys/ren-files sys/sys-info sys/vim-cli utils/autotail utils/canonical-status utils/check-number-inline utils/csv-count-checker utils/diff-file utils/grep-files utils/gz-ext-latest utils/modify-enc-str utils/replace-codeblock utils/replace-files utils/scp-con-gen utils/scriptctl utils/sna-files utils/ssh-con-gen utils/uuid-list"
  installer_candidates="docker/install-docker install-htop install-maven-3.9.15 install-temurin-25-jdk install-update-java-config install-update-mvn-config"
  command_candidates="firewall-cmd-set-priority"
  key_candidates="letsencrypt ymtech-internal"
  step_candidates="sudoers remove-packages install-packages default-opts installers tools commands ssh-key"

  # 2. 원격 GitHub catalogs.ini 다운로드 및 TTL(60초) 캐시 조회
  local ini_file
  ini_file="$(_sciectl_fetch_remote_catalogs_cached)" || return 0

  # 카탈로그 후보 (catalogs.ini 섹션 목록)
  local dynamic_cats
  dynamic_cats="$(grep -E '^\[[a-zA-Z0-9_-]+\]' "$ini_file" 2>/dev/null | tr -d '[]' | tr '\n' ' ')"
  [[ -n "$dynamic_cats" ]] && catalog_candidates="$dynamic_cats"

  # catalogs.ini에 명시된 catalog_file 파일명 목록 추출
  local -a cat_files=()
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^catalog_file[[:space:]]*=[[:space:]]*(.*) ]]; then
      local cf="${BASH_REMATCH[1]}"
      cf="$(echo "$cf" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
      [[ -n "$cf" ]] && cat_files+=("$cf")
    fi
  done < "$ini_file"

  if (( ${#cat_files[@]} == 0 )); then
    local cid
    for cid in $dynamic_cats; do
      cat_files+=("${cid}.catalog")
    done
  fi

  # 각 *.catalog 파일 캐시 확보
  local -a cached_cat_paths=()
  local f cached_f
  for f in "${cat_files[@]}"; do
    cached_f="$(_sciectl_fetch_remote_catalog_file_cached "$f")"
    [[ -n "$cached_f" && -f "$cached_f" ]] && cached_cat_paths+=("$cached_f")
  done

  (( ${#cached_cat_paths[@]} > 0 )) || return 0

  # *.catalog 파일들의 각 필드(TOOLS, INSTALLERS, COMMANDS, SSH_KEYS) 파싱
  local parsed_tools
  parsed_tools="$(_sciectl_parse_catalog_field "TOOLS" "${cached_cat_paths[@]}")"
  [[ -n "$parsed_tools" ]] && tool_candidates="$parsed_tools"

  local parsed_insts
  parsed_insts="$(_sciectl_parse_catalog_field "INSTALLERS" "${cached_cat_paths[@]}")"
  [[ -n "$parsed_insts" ]] && installer_candidates="$parsed_insts"

  local parsed_cmds
  parsed_cmds="$(_sciectl_parse_catalog_field "COMMANDS" "${cached_cat_paths[@]}")"
  [[ -n "$parsed_cmds" ]] && command_candidates="$parsed_cmds"

  local parsed_keys
  parsed_keys="$(_sciectl_parse_catalog_field "SSH_KEYS" "${cached_cat_paths[@]}")"
  [[ -n "$parsed_keys" ]] && key_candidates="$parsed_keys"
}

##
# 지정된 카탈로그 목록(INCLUDES 상속 포함)으로부터 컴포넌트 후보군을 스코핑하여 로드합니다.
# (원격 GitHub에서 캐시된 *.catalog 파일 사용)
#
# @param $1 {string} 카탈로그 ID 목록 (줄바꿈 또는 공백 구분)
##
_sciectl_load_catalog_scoped_candidates() {
  local specified_cats="$1"

  [[ -n "$specified_cats" ]] || return 0

  local -A visited_cats=()
  local -a cat_queue=( $specified_cats )

  local -A scoped_tools_map=()
  local -A scoped_insts_map=()
  local -A scoped_cmds_map=()
  local -A scoped_keys_map=()

  while (( ${#cat_queue[@]} > 0 )); do
    local cid="${cat_queue[0]}"
    cat_queue=("${cat_queue[@]:1}")

    [[ -n "$cid" ]] || continue
    [[ -z "${visited_cats[$cid]:-}" ]] || continue
    visited_cats["$cid"]=1

    local cat_file
    cat_file="$(_sciectl_fetch_remote_catalog_file_cached "$cid")"
    [[ -n "$cat_file" && -f "$cat_file" ]] || continue

    # 1. INCLUDES 상속 처리 (재귀 큐 삽입)
    local inc_line
    inc_line="$(grep -E '^INCLUDES=' "$cat_file" 2>/dev/null | sed 's/^INCLUDES=//' || true)"
    if [[ -n "$inc_line" ]]; then
      local -a inc_arr=()
      IFS=',' read -ra inc_arr <<< "$inc_line"
      local inc
      for inc in "${inc_arr[@]}"; do
        inc="$(echo "$inc" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        if [[ -n "$inc" && -z "${visited_cats[$inc]:-}" ]]; then
          cat_queue+=("$inc")
        fi
      done
    fi

    # 2. TOOLS
    local c_tools
    c_tools="$(_sciectl_parse_catalog_field "TOOLS" "$cat_file")"
    local t
    for t in $c_tools; do
      scoped_tools_map["$t"]=1
    done

    # 3. INSTALLERS
    local c_insts
    c_insts="$(_sciectl_parse_catalog_field "INSTALLERS" "$cat_file")"
    local i
    for i in $c_insts; do
      scoped_insts_map["$i"]=1
    done

    # 4. COMMANDS
    local c_cmds
    c_cmds="$(_sciectl_parse_catalog_field "COMMANDS" "$cat_file")"
    local c
    for c in $c_cmds; do
      scoped_cmds_map["$c"]=1
    done

    # 5. SSH_KEYS
    local c_keys
    c_keys="$(_sciectl_parse_catalog_field "SSH_KEYS" "$cat_file")"
    local k
    for k in $c_keys; do
      scoped_keys_map["$k"]=1
    done
  done

  # 후보군을 스코핑된 목록으로 교체 (항목이 없으면 정확히 빈 문자열)
  tool_candidates=""
  (( ${#scoped_tools_map[@]} > 0 )) && tool_candidates="$(printf '%s\n' "${!scoped_tools_map[@]}" | sort | tr '\n' ' ')"
  installer_candidates=""
  (( ${#scoped_insts_map[@]} > 0 )) && installer_candidates="$(printf '%s\n' "${!scoped_insts_map[@]}" | sort | tr '\n' ' ')"
  command_candidates=""
  (( ${#scoped_cmds_map[@]} > 0 )) && command_candidates="$(printf '%s\n' "${!scoped_cmds_map[@]}" | sort | tr '\n' ' ')"
  key_candidates=""
  (( ${#scoped_keys_map[@]} > 0 )) && key_candidates="$(printf '%s\n' "${!scoped_keys_map[@]}" | sort | tr '\n' ' ')"
}

##
# 특정 옵션에 대해 커맨드 라인 전체(COMP_WORDS) 및 현재 토큰에서 이미 사용된 값들을 수집합니다.
#
# @param $1 {string} 옵션명 (예: '--catalog', '--tool', '--installer', '--command', '--ssh-key', '--only', '--skip')
# @param $2 {string} 현재 완성 중인 토큰 ($cur)
#
# @return 사용된 값 목록 (한 줄에 하나씩 출력)
##
_sciectl_get_used_values() {
  local target_opt="$1"
  local cur_token="${2:-}"
  local -a used=()

  # 1. COMP_WORDS 탐색 (현재 커서 단어 이전까지)
  local i
  for (( i=0; i < COMP_CWORD; i++ )); do
    local w="${COMP_WORDS[i]}"
    # --opt val 형태
    if [[ "$w" == "$target_opt" ]]; then
      local next_idx=$((i + 1))
      if (( next_idx < COMP_CWORD )); then
        local next_val="${COMP_WORDS[next_idx]}"
        if [[ "$next_val" != --* ]]; then
          local -a parts=()
          IFS=',' read -ra parts <<< "$next_val"
          local p
          for p in "${parts[@]}"; do
            p="$(echo "$p" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
            [[ -n "$p" ]] && used+=("$p")
          done
        fi
      fi
    # --opt=val 형태
    elif [[ "$w" == "${target_opt}="* ]]; then
      local val="${w#${target_opt}=}"
      local -a parts=()
      IFS=',' read -ra parts <<< "$val"
      local p
      for p in "${parts[@]}"; do
        p="$(echo "$p" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [[ -n "$p" ]] && used+=("$p")
      done
    fi
  done

  # 2. 현재 토큰 내의 콤마 앞부분 (이미 입력 확정된 값들)
  local cur_val="$cur_token"
  [[ "$cur_val" == "${target_opt}="* ]] && cur_val="${cur_val#${target_opt}=}"
  if [[ "$cur_val" == *,* ]]; then
    local leading="${cur_val%,*}"
    local -a parts=()
    IFS=',' read -ra parts <<< "$leading"
    local p
    for p in "${parts[@]}"; do
      p="$(echo "$p" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
      [[ -n "$p" ]] && used+=("$p")
    done
  fi

  printf '%s\n' "${used[@]}" | sort -u
}

##
# 전체 후보 목록에서 이미 사용된 값들을 제외한 남은 후보군을 반환합니다.
#
# @param $1 {string} 전체 후보 단어 목록 (공백 구분)
# @param $2 {string} 옵션명 (예: '--catalog')
# @param $3 {string} 현재 완성 중인 토큰 ($cur)
#
# @return 사용되지 않은 후보 단어 목록 (공백 구분 문자열)
##
_sciectl_filter_candidates() {
  local all_candidates="$1"
  local target_opt="$2"
  local cur_token="${3:-}"

  local used_str
  used_str="$(_sciectl_get_used_values "$target_opt" "$cur_token")"
  if [[ -z "$used_str" ]]; then
    printf '%s\n' "$all_candidates"
    return 0
  fi

  local -A used_map=()
  local u
  while IFS= read -r u; do
    [[ -n "$u" ]] && used_map["$u"]=1
  done <<< "$used_str"

  local -a filtered=()
  local c
  for c in $all_candidates; do
    if [[ -z "${used_map[$c]:-}" ]]; then
      filtered+=("$c")
    fi
  done

  printf '%s\n' "${filtered[*]}"
}

##
# 콤마(,)로 구분된 다중 값 입력 시 마지막 토큰 기준으로 자동 완성을 수행합니다.
# 이미 입력된 값은 후보에서 자동으로 제외(중복 제안 금지)합니다.
#
# @param $1 {string} 후보 단어 목록 (공백 구분)
# @param $2 {string} 현재 입력 중인 값 부분
# @param $3 {string} 옵션 접두사 (예: '--catalog=' 또는 '')
# @param $4 {string} 옵션 식별자 (예: '--catalog', 중복 제외 필터링용)
#
# @return COMPREPLY 배열 설정
##
_sciectl_complete_csv_values() {
  local candidates="$1"
  local val_cur="$2"
  local opt_prefix="${3:-}"
  local opt_name="${4:-}"

  # 콤마로 연결 가능한 다중 값 옵션이므로 완성 후 자동 공백 추가 방지
  compopt -o nospace 2>/dev/null || true

  local active_candidates="$candidates"
  if [[ -n "$opt_name" ]]; then
    active_candidates="$(_sciectl_filter_candidates "$candidates" "$opt_name" "$val_cur")"
  fi

  local prefix="$opt_prefix"
  local target_part="$val_cur"
  if [[ "$val_cur" == *,* ]]; then
    prefix="${opt_prefix}${val_cur%,*},"
    target_part="${val_cur##*,}"
  fi

  local item
  while IFS= read -r item; do
    [[ -n "$item" ]] && COMPREPLY+=("${prefix}${item}")
  done < <(compgen -W "$active_candidates" -- "$target_part")
}

##
# sciectl 명령어에 대한 Bash 자동 완성 처리 함수
#
# @param $1 {string} 명령어 이름 (Command name)
# @param $2 {string} 현재 커서에서 완성 중인 단어 (Current word)
# @param $3 {string} 직전 단어 (Previous word)
#
# @return COMPREPLY 배열 설정
##
_sciectl_completion() {
  local cur prev
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]:-}"
  prev="${COMP_WORDS[COMP_CWORD-1]:-}"

  # 기본적으로는 공백 추가 활성화 (옵션, 서브커맨드 등 일반 단어 완성 시)
  compopt +o nospace 2>/dev/null || true

  local -a subcommands=("install" "list" "info" "--help")
  local catalog_candidates=""
  local installer_candidates=""
  local command_candidates=""
  local key_candidates=""
  local step_candidates=""
  local tool_candidates=""

  _sciectl_load_candidates

  # 첫 번째 인자 완성
  if (( COMP_CWORD == 1 )); then
    if [[ "$cur" == --* ]]; then
      local -a top_opts=(
        "--catalog" "--tool" "--installer" "--command" "--ssh-key"
        "--only" "--skip" "--user" "--target" "--local" "--remote"
        "--yes" "--force" "--dry-run" "--all" "--no-default-opts" "--help"
      )
      COMPREPLY=( $(compgen -W "${top_opts[*]}" -- "$cur") )
    else
      COMPREPLY=( $(compgen -W "${subcommands[*]}" -- "$cur") )
    fi
    return 0
  fi

  local subcmd="${COMP_WORDS[1]:-}"
  if [[ "$subcmd" == --* ]]; then
    subcmd="install"
  fi

  case "$subcmd" in
    install)
      # [방안 A] 선행 --catalog 옵션이 지정된 경우, 해당 카탈로그(및 INCLUDES 상속) 컴포넌트로 후보군 스코핑
      local specified_catalogs
      specified_catalogs="$(_sciectl_get_used_values "--catalog" "")"
      if [[ -n "$specified_catalogs" ]]; then
        _sciectl_load_catalog_scoped_candidates "$specified_catalogs"
      fi

      # 옵션 플래그 동적 구성: --catalog 지정 시 실제 정의된 컴포넌트 옵션만 선별 제안
      local -a install_opts=("--catalog")
      if [[ -n "$specified_catalogs" ]]; then
        [[ -n "${tool_candidates//[[:space:]]/}" ]] && install_opts+=("--tool")
        [[ -n "${installer_candidates//[[:space:]]/}" ]] && install_opts+=("--installer")
        [[ -n "${command_candidates//[[:space:]]/}" ]] && install_opts+=("--command")
        [[ -n "${key_candidates//[[:space:]]/}" ]] && install_opts+=("--ssh-key")
      else
        install_opts+=("--tool" "--installer" "--command" "--ssh-key")
      fi

      install_opts+=(
        "--only" "--skip" "--user" "--target" "--local" "--remote"
        "--yes" "--force" "--dry-run" "--all" "--no-default-opts" "--help"
      )

      case "$cur" in
        --catalog=*)
          _sciectl_complete_csv_values "$catalog_candidates" "${cur#--catalog=}" "--catalog=" "--catalog"
          return 0
          ;;
        --tool=*)
          _sciectl_complete_csv_values "$tool_candidates" "${cur#--tool=}" "--tool=" "--tool"
          return 0
          ;;
        --installer=*)
          _sciectl_complete_csv_values "$installer_candidates" "${cur#--installer=}" "--installer=" "--installer"
          return 0
          ;;
        --command=*)
          _sciectl_complete_csv_values "$command_candidates" "${cur#--command=}" "--command=" "--command"
          return 0
          ;;
        --ssh-key=*)
          _sciectl_complete_csv_values "$key_candidates" "${cur#--ssh-key=}" "--ssh-key=" "--ssh-key"
          return 0
          ;;
        --only=*)
          _sciectl_complete_csv_values "$step_candidates" "${cur#--only=}" "--only=" "--only"
          return 0
          ;;
        --skip=*)
          _sciectl_complete_csv_values "$step_candidates" "${cur#--skip=}" "--skip=" "--skip"
          return 0
          ;;
        --target=*)
          _sciectl_complete_csv_values "local global" "${cur#--target=}" "--target="
          return 0
          ;;
      esac

      case "$prev" in
        --catalog)
          _sciectl_complete_csv_values "$catalog_candidates" "$cur" "" "--catalog"
          return 0
          ;;
        --tool)
          _sciectl_complete_csv_values "$tool_candidates" "$cur" "" "--tool"
          return 0
          ;;
        --installer)
          _sciectl_complete_csv_values "$installer_candidates" "$cur" "" "--installer"
          return 0
          ;;
        --command)
          _sciectl_complete_csv_values "$command_candidates" "$cur" "" "--command"
          return 0
          ;;
        --ssh-key)
          _sciectl_complete_csv_values "$key_candidates" "$cur" "" "--ssh-key"
          return 0
          ;;
        --only)
          _sciectl_complete_csv_values "$step_candidates" "$cur" "" "--only"
          return 0
          ;;
        --skip)
          _sciectl_complete_csv_values "$step_candidates" "$cur" "" "--skip"
          return 0
          ;;
        --target)
          COMPREPLY=( $(compgen -W "local global" -- "$cur") )
          return 0
          ;;
        --user)
          COMPREPLY=( $(compgen -u -- "$cur") )
          return 0
          ;;
      esac

      COMPREPLY=( $(compgen -W "${install_opts[*]}" -- "$cur") )
      return 0
      ;;

    list)
      local -a list_opts=("--type" "--local" "--remote" "--help")
      case "$cur" in
        --type=*)
          COMPREPLY=( $(compgen -W "all catalogs tools installers commands keys" -- "${cur#--type=}") )
          return 0
          ;;
      esac
      case "$prev" in
        --type)
          COMPREPLY=( $(compgen -W "all catalogs tools installers commands keys" -- "$cur") )
          return 0
          ;;
      esac
      COMPREPLY=( $(compgen -W "${list_opts[*]}" -- "$cur") )
      return 0
      ;;

    info)
      # 선행 --catalog 옵션이 지정된 경우, 해당 카탈로그 컴포넌트로 후보군 스코핑
      local specified_catalogs
      specified_catalogs="$(_sciectl_get_used_values "--catalog" "")"
      if [[ -n "$specified_catalogs" ]]; then
        _sciectl_load_catalog_scoped_candidates "$specified_catalogs"
      fi

      local -a info_opts=("--catalog")
      if [[ -n "$specified_catalogs" ]]; then
        [[ -n "${tool_candidates//[[:space:]]/}" ]] && info_opts+=("--tool")
        [[ -n "${installer_candidates//[[:space:]]/}" ]] && info_opts+=("--installer")
        [[ -n "${command_candidates//[[:space:]]/}" ]] && info_opts+=("--command")
        [[ -n "${key_candidates//[[:space:]]/}" ]] && info_opts+=("--ssh-key")
      else
        info_opts+=("--tool" "--installer" "--command" "--ssh-key")
      fi
      info_opts+=("--local" "--remote" "--help")

      case "$cur" in
        --catalog=*)
          _sciectl_complete_csv_values "$catalog_candidates" "${cur#--catalog=}" "--catalog=" "--catalog"
          return 0
          ;;
        --tool=*)
          _sciectl_complete_csv_values "$tool_candidates" "${cur#--tool=}" "--tool=" "--tool"
          return 0
          ;;
        --installer=*)
          _sciectl_complete_csv_values "$installer_candidates" "${cur#--installer=}" "--installer=" "--installer"
          return 0
          ;;
        --command=*)
          _sciectl_complete_csv_values "$command_candidates" "${cur#--command=}" "--command=" "--command"
          return 0
          ;;
        --ssh-key=*)
          _sciectl_complete_csv_values "$key_candidates" "${cur#--ssh-key=}" "--ssh-key=" "--ssh-key"
          return 0
          ;;
      esac
      case "$prev" in
        --catalog)
          _sciectl_complete_csv_values "$catalog_candidates" "$cur" "" "--catalog"
          return 0
          ;;
        --tool)
          _sciectl_complete_csv_values "$tool_candidates" "$cur" "" "--tool"
          return 0
          ;;
        --installer)
          _sciectl_complete_csv_values "$installer_candidates" "$cur" "" "--installer"
          return 0
          ;;
        --command)
          _sciectl_complete_csv_values "$command_candidates" "$cur" "" "--command"
          return 0
          ;;
        --ssh-key)
          _sciectl_complete_csv_values "$key_candidates" "$cur" "" "--ssh-key"
          return 0
          ;;
      esac
      COMPREPLY=( $(compgen -W "${info_opts[*]}" -- "$cur") )
      return 0
      ;;
  esac
}

complete -F _sciectl_completion sciectl ./sciectl
