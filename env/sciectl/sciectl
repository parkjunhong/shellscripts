def main(argv: Sequence[str]) -> int:
    _init_notice_file()
    ctx = AppContext()
    check_and_self_update(ctx, argv)

    normalized = [a for a in argv if a not in ("--no-update", "--force-update")]
    if not normalized:
        cmd_install(ctx, [])
        return 0

    first = normalized[0]
    rest = normalized[1:]
    if first == "install":
        cmd_install(ctx, rest)
    elif first == "update":
        cmd_update(ctx, rest)
    elif first == "remove":
        cmd_remove(ctx, rest)
    elif first == "list":
        cmd_list(ctx, rest)
    elif first == "info":
        cmd_info(ctx, rest)
    elif first == "refresh":
        cmd_refresh(ctx, rest)
    elif first == "--help":
        print_help()
    elif first == "--version":
        print(f"{FILENAME} version {SCRIPT_FILE_VERSION}")
    elif first.startswith("--"):
        cmd_install(ctx, normalized)
    else:
        error_exit(f"알 수 없는 명령어 또는 옵션입니다: '{first}'")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
