readonly FILENAME="$(basename "$0")"
readonly REPO_BASE_URL="${SCIECTL_REPO_URL:-https://raw.githubusercontent.com/parkjunhong/shellscripts/refs/heads/main}"

# ==========================================
# 터미널 출력 색상 정의
# ==========================================
if [[ -t 1 ]]; then
  COLOR_ERROR='\033[1;31m'
  COLOR_WARN='\033[1;33m'
  COLOR_INFO='\033[1;32m'
  COLOR_CYAN='\033[1;36m'
  COLOR_BOLD='\033[1m'
  COLOR_NC='\033[0m'
else
  COLOR_ERROR=''
  COLOR_WARN=''
  COLOR_INFO=''
  COLOR_CYAN=''
  COLOR_BOLD=''
  COLOR_NC=''
fi

##
# 오류 메시지를 빨간색으로 출력합니다.
#
# @param $* {string} 출력할 메시지
#
# @return 표준 출력
##
echo_e() {
  printf "${COLOR_ERROR}%s${COLOR_NC}\n" "$*"
}

##
# 경고 메시지를 노란색으로 출력합니다.
#
# @param $* {string} 출력할 메시지
#
# @return 표준 출력
##
echo_w() {
  printf "${COLOR_WARN}%s${COLOR_NC}\n" "$*"
}

##
# 안내 메시지를 녹색으로 출력합니다.
#
# @param $* {string} 출력할 메시지
#
# @return 표준 출력
##
echo_i() {
  printf "${COLOR_INFO}%s${COLOR_NC}\n" "$*"
}

# ==========================================
# 공지사항(Notice) 공유 파이프라인 (부모-자식 공유)
# ==========================================
export NOTICE_MESSAGES_TEMP_FILE="/tmp/sciectl_notice_messages_$$.tmp"
rm -f -- "$NOTICE_MESSAGES_TEMP_FILE"
touch "$NOTICE_MESSAGES_TEMP_FILE"

##
# 작업 완료 후 사용자에게 전달할 공지 메시지를 임시 파일에 누적 저장합니다.
#
# @param $1 {string} 저장할 메시지
# @param $2 {string} 중복 허용 여부 (기본값: true / false 지정 시 중복 라인 무시)
#
# @return 0
##
_add_notice() {
  local msg="${1:-}"
  local forced="${2:-true}"

  if [[ -z "$msg" ]]; then
    return 0
  fi

  if [[ "$forced" == "false" ]]; then
    if grep -Fxq "$msg" "$NOTICE_MESSAGES_TEMP_FILE" 2>/dev/null; then
      return 0
    fi
  fi

  echo "$msg" >> "$NOTICE_MESSAGES_TEMP_FILE"
}

##
# 저장된 모든 공지 메시지를 출력하고 임시 파일을 정리합니다.
#
# @param 없음
#
# @return 저장된 메시지 목록 (표준 출력)
##
_announce_notices() {
  if [[ ! -s "$NOTICE_MESSAGES_TEMP_FILE" ]]; then
    rm -f -- "$NOTICE_MESSAGES_TEMP_FILE"
    return 0
  fi

  echo
  echo "================================================================================"
  echo "[공지] 작업 완료 후 확인이 필요한 메시지"
  echo "================================================================================"

  local idx=1
  local msg=""
  while IFS= read -r msg || [[ -n "$msg" ]]; do
    echo_w " [$(printf "%-3d" "$idx")] $msg"
    ((idx++))
  done < "$NOTICE_MESSAGES_TEMP_FILE"

  echo "================================================================================"
  rm -f -- "$NOTICE_MESSAGES_TEMP_FILE"
}

##
# 오류 진단 콜스택 박스를 표준 에러(stderr)로 출력합니다.
#
# @param $1 {string} 오류 원인 메시지
# @param $2 {string} 오류 발생 라인 번호
#
# @return 없음
##
print_error_box() {
  local cause="${1:-}"
  local line="${2:-unknown}"
  [[ -n "$cause" ]] || return 0

  local indent=10
  local formatl=" - %-${indent}s: %s\n"
  local formatr=" - %${indent}s: %s\n"
  echo >&2
  echo "================================================================================" >&2
  printf "$formatl" "filename" "$FILENAME" >&2
  printf "$formatl" "line" "$line" >&2
  printf "$formatl" "callstack" "" >&2
  local idx=1
  local func
  for func in "${FUNCNAME[@]:2}"; do
    printf "$formatr" "[${idx}]" "$func" >&2
    ((idx++))
  done
  printf "$formatl" "cause" "$cause" >&2
  echo "================================================================================" >&2
}

##
# 전체 사용법 또는 서브커맨드별 도움말을 출력합니다.
#
# @param $1 {string} 오류 원인 메시지 (선택)
# @param $2 {string} 오류 발생 라인 번호 (선택)
# @param $3 {string} 서브커맨드 이름 (install | list | info | empty)
#
# @return 도움말 출력
##
help() {
  local cause="${1:-}"
  local line="${2:-unknown}"
