            print()
        for t in tool_list:
            _print_component_info(ctx, "tool", t)
        for inst in inst_list:
            _print_component_info(ctx, "installer", inst)
        for c in cmd_list_vals:
            _print_component_info(ctx, "command", c)
        for k in key_list:
            _print_component_info(ctx, "ssh-key", k)
        print()


def _interactive_select_installed_items(ctx: AppContext, mode: str, scope_filter: str) -> List[InstalledRecord]:
    raw_records = manifest_list_installed(ctx, scope_filter)
    if not raw_records:
        echo_w(" - [💡] 현재 sciectl로 설치된 도구 또는 등록된 SSH 공개키가 없습니다.", file=sys.stderr)
        return []

    sorted_records = sort_installed_records("id", raw_records)
    selectable: List[InstalledRecord] = []
    display_rows: List[Tuple[str, str, str, str, str, str, str]] = []

    if mode == "update":
        ok, status_map = check_records_update_status(ctx, sorted_records)
        if not ok:
            echo_e(" - [❌] 원격 저장소에 연결할 수 없어 업데이트 여부를 확인할 수 없습니다.", file=sys.stderr)
            if ctx.detect_local_repo(abort_on_missing=False) is not None or (Path.cwd() / "env" / "catalogs").is_dir():
                echo_w("   💡 로컬 저장소를 사용하려면 '--local' 옵션을 함께 지정하세요.", file=sys.stderr)
            return []

        up_to_date_rows: List[Tuple[str, str, str, str, str, str, str]] = []
        unknown_rows: List[Tuple[str, str, str, str, str, str, str]] = []
        idx_upd = 1
        for rec in sorted_records:
            res = status_map.get(rec.meta_file, UpdateCheckResult(status="unknown"))
            if res.status == "updatable":
                rem_ver = res.remote_ver or "latest"
                display_rows.append((f"{idx_upd:3d})", rec.rec_type, rec.rec_id, rec.scope, f"{rec.version} -> {rem_ver}", rec.updated_at, rec.primary_path))
                selectable.append(rec)
                idx_upd += 1
            elif res.status == "up-to-date":
                up_to_date_rows.append(("  - ", rec.rec_type, rec.rec_id, rec.scope, rec.version, rec.updated_at, rec.primary_path))
            else:
                fail_disp = f"{rec.version} ({res.fail_reason})" if res.fail_reason else rec.version
                unknown_rows.append(("  ? ", rec.rec_type, rec.rec_id, rec.scope, fail_disp, rec.updated_at, rec.primary_path))

        if up_to_date_rows:
            print_dynamic_installed_table(f"✅ 최신 버전 ({len(up_to_date_rows)}개)", up_to_date_rows, stream=sys.stderr)
        if unknown_rows:
            print_dynamic_installed_table(f"⚠️  버전 확인 실패 ({len(unknown_rows)}개 - 네트워크/원격 응답 오류)", unknown_rows, stream=sys.stderr)
        if not display_rows:
            if unknown_rows:
                echo_w(f" - [⚠️] 업데이트 가능한 항목이 없습니다 (버전 확인 실패 {len(unknown_rows)}건 포함).", file=sys.stderr)
            else:
                echo_i(f" - [💡] 모든 설치 항목({len(sorted_records)}개)이 이미 최신 버전입니다.", file=sys.stderr)
            return []
    else:
        for idx, rec in enumerate(sorted_records, start=1):
            selectable.append(rec)
            display_rows.append((f"{idx:3d})", rec.rec_type, rec.rec_id, rec.scope, rec.version, rec.updated_at, rec.primary_path))

    total = len(selectable)
    action_label = "업데이트" if mode == "update" else "제거"
    table_title = (
        f"🔄 업데이트 가능 목록 ({total}개) - [업데이트 대상 선택]"
        if mode == "update"
        else f"📦 현재 설치된 관리 대상 목록 ({total}개) - [제거 대상 선택]"
    )

    while True:
        print_dynamic_installed_table(table_title, display_rows, stream=sys.stderr)
        try:
            sys.stderr.write(f"> 🛠️  {action_label}할 번호를 입력하세요 (예: 1 3, 1-4, 전체: *) [취소: Enter 또는 q]: ")
            sys.stderr.flush()
            choice_line = input().strip()
        except (EOFError, KeyboardInterrupt):
            print(file=sys.stderr)
            return []

        if not choice_line or choice_line.lower() == "q":
            echo_w(f" - [🛑] {action_label} 선택을 취소했습니다.", file=sys.stderr)
            return []
        if choice_line in ("*", "all", "ALL"):
            return selectable

        tokens = choice_line.replace(",", " ").split()
        picked_indices: List[int] = []
        seen_idx: Set[int] = set()
        valid = True
        for tok in tokens:
            m = re.match(r"^(\d+)-(\d+)$", tok)
            if m:
                s, e = int(m.group(1)), int(m.group(2))
                if s < 1 or e > total or s > e:
                    echo_w(f"⚠️  - 잘못된 범위입니다 ({tok}). 1에서 {total} 사이의 범위를 입력하세요.", file=sys.stderr)
                    valid = False
                    break
                for n in range(s, e + 1):
                    if n not in seen_idx:
                        seen_idx.add(n)
                        picked_indices.append(n)
            elif tok.isdigit():
                n = int(tok)
                if n < 1 or n > total:
                    echo_w(f"⚠️  - 잘못된 번호입니다 ({tok}). 1에서 {total} 사이의 숫자를 입력하세요.", file=sys.stderr)
                    valid = False
                    break
                if n not in seen_idx:
                    seen_idx.add(n)
                    picked_indices.append(n)
            else:
                echo_w(f"⚠️  - 잘못된 입력입니다: '{tok}' (숫자, 범위 예: 1-3, 또는 * 만 입력 가능)", file=sys.stderr)
                valid = False
                break
        if valid and picked_indices:
            return [selectable[i - 1] for i in picked_indices]


def _resolve_manage_targets(
    ctx: AppContext,
    raw_catalogs: List[str],
    raw_tools: List[str],
    raw_keys: List[str],
    target_scope: str,
) -> List[InstalledRecord]:
    plan = TransactionPlan()
    cat_ids = _split_csv_list(raw_catalogs)
    if cat_ids:
        catalogs = load_catalogs_index(ctx)
        for cid in cat_ids:
            resolve_catalog(ctx, catalogs, plan, cid)
    add_tx_items(plan, "tool", ",".join(_split_csv_list(raw_tools)))
    add_tx_items(plan, "ssh_key", ",".join(_split_csv_list(raw_keys)))

    installed_all = manifest_list_installed(ctx, target_scope)
    if not installed_all:
        echo_w(" - [💡] 현재 설치된 도구 또는 등록된 SSH 공개키가 없습니다.")
        return []

    selected: List[InstalledRecord] = []
    matched_metas: Set[str] = set()

    for req_tool in plan.tools:
        req_cmd = Path(req_tool).name
        found = False
        for r in installed_all:
            if r.rec_type == "tool" and (r.rec_id == req_tool or r.name == req_cmd):
                if r.meta_file not in matched_metas:
                    matched_metas.add(r.meta_file)
                    selected.append(r)
                found = True
        if not found:
            echo_w(f" - [⚠️] 설치되지 않은 도구이므로 건너뜁니다: {req_tool}")

    for req_key in plan.ssh_keys:
        found = False
        for r in installed_all:
            if r.rec_type == "ssh-key" and r.rec_id == req_key:
                if r.meta_file not in matched_metas:
                    matched_metas.add(r.meta_file)
                    selected.append(r)
                found = True
        if not found:
            echo_w(f" - [⚠️] 등록되지 않은 SSH 공개키이므로 건너뜁니다: {req_key}")

    if not selected:
        echo_w(" - [💡] 조건에 해당하는 설치된 관리 대상이 없습니다.")
    return selected


def _update_ssh_key(ctx: AppContext, key_id: str, meta_file: str, is_dry_run: bool) -> None:
    print()
    print(f"############### _update_ssh_key - {key_id} ###############")
    new_pub = resolve_ssh_key_content(ctx, key_id)
    if not new_pub:
        echo_e(f" - [❌] SSH 공개키('{key_id}')를 저장소에서 불러올 수 없어 생략합니다.")
        _add_notice(f" - [_update_ssh_key] [❌] SSH 공개키('{key_id}') 로드 실패")
        return

    parts = new_pub.split()
    new_body = parts[1] if len(parts) >= 2 else ""
    new_comment = " ".join(parts[2:]) if len(parts) >= 3 else ""
    fields = parse_manifest_file(Path(meta_file))
    old_body = fields.get("KEY_BODY", "")
    auth_file = Path(fields.get("AUTH_FILE", "") or str(Path.home() / ".ssh" / "authorized_keys"))

    auth_text = auth_file.read_text(encoding="utf-8", errors="replace") if auth_file.is_file() else ""
    if old_body and old_body == new_body and new_body in auth_text:
        echo_w(f" - '{key_id}' SSH 공개키가 이미 최신입니다.")
        return
    if is_dry_run:
        echo_i(f" - [DRY-RUN] '{key_id}' SSH 공개키를 최신 내용으로 교체 예정 ({auth_file})")
        return

    auth_file.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(auth_file.parent, 0o700)
    lines = [ln for ln in auth_text.splitlines() if not (old_body and old_body in ln)]
    if new_body and all(new_body not in ln for ln in lines):
        lines.append(new_pub)
    auth_file.write_text("\n".join(lines) + ("\n" if lines else ""), encoding="utf-8")
    os.chmod(auth_file, 0o600)
    manifest_save_key(key_id, new_body, new_comment, auth_file)
    echo_i(f" - '{key_id}' SSH 공개키를 최신 버전으로 교체 업데이트했습니다. ({auth_file})")


def _remove_ssh_key(key_id: str, meta_file: str, is_dry_run: bool) -> None:
    print()
    print(f"############### _remove_ssh_key - {key_id} ###############")
    fields = parse_manifest_file(Path(meta_file))
    key_body = fields.get("KEY_BODY", "")
    auth_file = Path(fields.get("AUTH_FILE", "") or str(Path.home() / ".ssh" / "authorized_keys"))

    if is_dry_run:
        echo_i(f" - [DRY-RUN] '{key_id}' SSH 공개키 제거 예정 ({auth_file})")
        echo_i(f" - [DRY-RUN] 매니페스트 삭제 예정 ({meta_file})")
        return

    if auth_file.is_file() and key_body:
        lines = auth_file.read_text(encoding="utf-8", errors="replace").splitlines()
        new_lines = [ln for ln in lines if key_body not in ln]
        if len(new_lines) != len(lines):
            auth_file.write_text("\n".join(new_lines) + ("\n" if new_lines else ""), encoding="utf-8")
            os.chmod(auth_file, 0o600)
            echo_i(f" - '{key_id}' SSH 공개키를 제거했습니다. ({auth_file})")
        else:
            echo_w(f" - '{key_id}' SSH 공개키가 '{auth_file}'에 존재하지 않습니다.")
    else:
        echo_w(f" - '{key_id}' SSH 공개키가 '{auth_file}'에 존재하지 않습니다.")
    manifest_delete_key(key_id)


def _remove_tool_by_meta(meta_file: str, is_dry_run: bool) -> None:
    fields = parse_manifest_file(Path(meta_file))
    cmd_name = fields.get("CMD_NAME", "")
    target_scope = fields.get("TARGET_SCOPE", "local")
    bin_path = fields.get("BIN_PATH", "")
    comp_path = fields.get("COMPLETION_PATH", "")
    man_paths = fields.get("MAN_PATHS", "")

    print()
    print(f"############### _remove_tool - {cmd_name} ({target_scope}) ###############")
    remove_targets: List[Path] = []
    for p_str in (bin_path, comp_path):
        if p_str and Path(p_str).is_file():
            remove_targets.append(Path(p_str))

    any_man = False
    for mp in man_paths.split(":"):
        if mp and Path(mp).is_file():
            remove_targets.append(Path(mp))
            any_man = True

    if is_dry_run:
        for rt in remove_targets:
            echo_i(f" - [DRY-RUN] 삭제 예정: {rt}")
        echo_i(f" - [DRY-RUN] 매니페스트 삭제 예정: {meta_file}")
        return

    for rt in remove_targets:
        if os.access(rt, os.W_OK) and os.access(rt.parent, os.W_OK):
            rt.unlink(missing_ok=True)
        else:
            run_cmd(["sudo", "rm", "-f", "--", str(rt)])
        echo_i(f" - 파일을 삭제했습니다: {rt}")

    if any_man and shutil.which("mandb"):
        if target_scope == "global":
            run_cmd(["sudo", "mandb", "-q"], timeout=15)
        else:
            xdg_man = str(Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share")) / "man")
            run_cmd(["mandb", "-q", xdg_man], timeout=15)

    manifest_delete_tool(cmd_name, target_scope)
    echo_i(f" - '{cmd_name}' 도구 및 매니페스트 제거가 완료되었습니다.")


def _parse_manage_subcmd(ctx: AppContext, subcmd: str, args: Sequence[str]) -> argparse.Namespace:
    def _cfg(p: argparse.ArgumentParser) -> None:
        p.add_argument("--catalog", action="append", default=[])
        p.add_argument("--tool", action="append", default=[])
        p.add_argument("--ssh-key", dest="ssh_key", action="append", default=[])
        p.add_argument("--installer", action="append", default=[])
        p.add_argument("--command", action="append", default=[])
        p.add_argument("--target", default="all")
        p.add_argument("--yes", action="store_true")
        p.add_argument("--force", action="store_true")
        p.add_argument("--dry-run", dest="dry_run", action="store_true")

    ns = _parse_with_long_options(args, subcmd, _cfg)
    _apply_source_mode(ctx, ns)
    if ns.installer or ns.command:
        error_exit(f"'{subcmd}' 명령에서는 '--installer' 및 '--command' 옵션을 지원하지 않습니다 (도구 및 SSH 키만 관리 가능).", subcmd=subcmd)
    if ns.target not in ("all", "local", "global"):
        error_exit(f"'--target' 옵션 값은 'local' 또는 'global'만 허용됩니다: '{ns.target}'", subcmd=subcmd)
    return ns


def cmd_update(ctx: AppContext, args: Sequence[str]) -> None:
    ns = _parse_manage_subcmd(ctx, "update", args)
    if ns.catalog or ns.tool or ns.ssh_key:
        selected = _resolve_manage_targets(ctx, ns.catalog, ns.tool, ns.ssh_key, ns.target)
    else:
        selected = _interactive_select_installed_items(ctx, "update", ns.target)
    if not selected:
        return

    print()
    print("=" * 80)
    print(f"{COLOR_BOLD}🔄 Update Transaction Summary ({len(selected)}개 대상){COLOR_NC}")
    print("=" * 80)
    for r in selected:
        print(f"  - [{r.rec_type:<7s}] {r.rec_id:<28s} (scope: {r.scope:<6s}, current: {r.version})")
    print("=" * 80)

    if not ns.dry_run and not ns.yes and sys.stdin.isatty():
        if not _prompt_yes_no("> 위 대상에 대해 업데이트를 진행하시겠습니까? (y/Enter: 취소): "):
            echo_w(" - [🛑] 사용자가 업데이트를 취소했습니다.")
            return

    for r in selected:
        if r.rec_type == "tool":
            if ns.dry_run:
                echo_i(f" - [DRY-RUN] '{r.rec_id}' ({r.scope}) 업데이트 확인 예정 ({r.primary_path})")
            else:
                install_tool(ctx, r.rec_id, target_scope=r.scope, force_overwrite=ns.force, auto_yes=True)
        elif r.rec_type == "ssh-key":
            _update_ssh_key(ctx, r.rec_id, r.meta_file, ns.dry_run)

    _announce_notices()
    print()
    if ns.dry_run:
        echo_i("🔍 [--dry-run] 시뮬레이션 모드이므로 실제 업데이트를 수행하지 않고 종료합니다.")
    else:
        echo_i("✅ 모든 업데이트 작업이 완료되었습니다.")


def cmd_remove(ctx: AppContext, args: Sequence[str]) -> None:
