##
# 오류 메시지를 출력하고 도움말을 호출한 뒤 스크립트를 종료합니다.
#
# @param $1 {string} 발생한 오류 원인 메시지
# @param $2 {string} 오류가 발생한 라인 번호
# @param $3 {string} 서브커맨드 이름 (선택)
#
# @return 없음 (exit 1)
##
error_exit() {
  help "${1:-알 수 없는 오류}" "${2:-$LINENO}" "${3:-}"
  rm -f -- "$NOTICE_MESSAGES_TEMP_FILE"
  exit 1
}

# ==========================================
# 전역 상태 및 환경 감지
# ==========================================
PKG_MANAGER=""
PKG_UPDATE_CMD=""
PKG_INSTALL_CMD=""
PKG_REMOVE_CMD=""

##
# OS 패키지 매니저(apt, dnf, pacman 또는 Homebrew)를 감지하여 전역 변수를 설정합니다.
#
# @param 없음
#
# @return 성공 시 0, 미지원 OS 시 exit 1
##
_detect_pkg_manager() {
  if [[ -n "$PKG_MANAGER" ]]; then
    return 0
  fi

  if [[ "$TARGET_OS" == "darwin" ]]; then
    if ! command -v brew &>/dev/null; then
      echo_e "[❌] macOS 환경에서는 Homebrew('brew')가 필요합니다."
      echo_w "💡 아래 명령어로 Homebrew를 먼저 설치해 주세요:"
      echo_w '   /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
      exit 1
    fi
    PKG_MANAGER="brew"
    PKG_UPDATE_CMD="brew update"
    PKG_INSTALL_CMD="brew install -q"
    PKG_REMOVE_CMD="brew uninstall -q"
    return 0
  fi

  if command -v apt &>/dev/null; then
    PKG_MANAGER="apt"
    PKG_UPDATE_CMD="sudo apt update"
    PKG_INSTALL_CMD="sudo apt install -y"
    PKG_REMOVE_CMD="sudo apt purge -y"
  elif command -v dnf &>/dev/null; then
    PKG_MANAGER="dnf"
    PKG_UPDATE_CMD="sudo dnf makecache"
    PKG_INSTALL_CMD="sudo dnf install -y"
    PKG_REMOVE_CMD="sudo dnf remove -y"
  elif command -v pacman &>/dev/null; then
    PKG_MANAGER="pacman"
    PKG_UPDATE_CMD="sudo pacman -Sy"
    PKG_INSTALL_CMD="sudo pacman -S --noconfirm --needed"
    PKG_REMOVE_CMD="sudo pacman -Rns --noconfirm"
  else
    echo_e "[❌] 지원하지 않는 운영체제입니다. (apt, dnf 또는 pacman이 필요합니다.)"
    exit 1
  fi
}

##
# OS별 패키지 매니저를 통해 실제 패키지가 설치되어 있는지 확인합니다.
#
# @param $1 {string} 패키지 이름
#
# @return 0(설치됨) 또는 1(미설치)
##
_is_package_installed() {
  local pkg_name="$1"
  _detect_pkg_manager
  if [[ "$PKG_MANAGER" == "apt" ]]; then
    dpkg -s "$pkg_name" 2>/dev/null | grep -q "Status: install ok installed"
  elif [[ "$PKG_MANAGER" == "dnf" ]]; then
    rpm -q "$pkg_name" &>/dev/null
  elif [[ "$PKG_MANAGER" == "pacman" ]]; then
    pacman -Q "$pkg_name" &>/dev/null
  elif [[ "$PKG_MANAGER" == "brew" ]]; then
    brew list "$pkg_name" &>/dev/null
  else
    return 1
  fi
}

##
# curl 명령어가 설치되어 있는지 확인하고 없으면 자동으로 설치합니다.
#
# @param 없음
#
# @return 0
##
_ensure_curl() {
  if ! command -v curl &>/dev/null; then
    _detect_pkg_manager
    $PKG_UPDATE_CMD >/dev/null 2>&1 || true
    $PKG_INSTALL_CMD curl >/dev/null 2>&1 || true
  fi
}

# ==========================================
# 로컬 저장소 vs 원격 저장소 소스 리졸버 (기본값: 원격 GitHub)
# ==========================================
SOURCE_MODE="remote" # remote (기본값) | local
LOCAL_REPO_ROOT=""

##
# 현재 스크립트 위치 기준 로컬 shellscripts 저장소 루트를 탐색합니다.
# '--local' 옵션이 지정된 경우에만 활성화됩니다.
#
# @param 없음
#
# @return 0 (발견 시 LOCAL_REPO_ROOT 설정), 1 (미발견)
##
_detect_local_repo() {
  if [[ "$SOURCE_MODE" != "local" ]]; then
    LOCAL_REPO_ROOT=""
    return 1
  fi

  local script_dir=""
  if [[ -f "${BASH_SOURCE[0]}" ]]; then
    script_dir="$(cd -P -- "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P || true)"
  fi

  local cand=""
  for cand in "${script_dir}/../.." "${script_dir}/.." "$(pwd -P)"; do
    if [[ -d "$cand" ]]; then
      local abs_cand
      abs_cand="$(cd -P -- "$cand" >/dev/null 2>&1 && pwd -P || true)"
      if [[ -f "${abs_cand}/env/catalogs/catalogs.ini" ]]; then
        LOCAL_REPO_ROOT="$abs_cand"
        return 0
      fi
    fi
  done

  error_exit "'--local' 옵션이 지정되었으나 로컬 저장소(env/catalogs/catalogs.ini)를 찾을 수 없습니다." "$LINENO"
}

##
# 저장소 내 상대 경로 파일을 지정된 목적지 파일로 가져옵니다 (로컬 복사 또는 원격 curl 다운로드).
#
# @param $1 {string} 저장소 내 상대 경로 또는 전체 URL
# @param $2 {string} 저장할 로컬 목적지 파일 경로
# @param $3 {string} 다운로드 진행/결과 로그 출력 여부 (true | false, 기본값: false)
#
# @return 성공 시 0, 실패 시 1
##
_fetch_resource() {
  local rel_or_url="$1"
  local dest_file="$2"
  local show_progress="${3:-false}"

  local target_url=""
  if [[ "$rel_or_url" == https://* || "$rel_or_url" == http://* ]]; then
    target_url="$rel_or_url"
  elif _detect_local_repo && [[ -f "${LOCAL_REPO_ROOT}/${rel_or_url}" ]]; then
    cp "${LOCAL_REPO_ROOT}/${rel_or_url}" "$dest_file"
    local rc=$?
    if (( rc == 0 )) && [[ "$show_progress" == "true" ]]; then
      local fsize
      fsize="$(wc -c < "$dest_file" 2>/dev/null || echo 0)"
      echo " - [⬇️ ] 로컬 복사 완료: ${rel_or_url} (${fsize} bytes)"
    fi
    return $rc
  else
    if [[ "$SOURCE_MODE" == "local" ]]; then
      return 1
    fi
    target_url="${REPO_BASE_URL}/${rel_or_url}"
  fi

  _ensure_curl
  local bust_sep="?"
  [[ "$target_url" == *\?* ]] && bust_sep="&"
  local fetch_url="${target_url}${bust_sep}t=$(date +%s)"

  if [[ "$show_progress" == "true" ]]; then
    echo " - [⬇️ ] 다운로드 중: ${target_url}"
    local stats
    if stats="$(curl -sfLo "$dest_file" --connect-timeout 3 --max-time 8 \
      -H "Cache-Control: no-cache" -H "Pragma: no-cache" \
      -w '%{size_download}|%{time_total}' "$fetch_url" 2>/dev/null)"; then
      local dl_bytes dl_time
      IFS='|' read -r dl_bytes dl_time <<< "$stats"
      echo_i " - [⬇️ ] 다운로드 완료: ${rel_or_url} (${dl_bytes:-0} bytes, ${dl_time:-0}s)"
      return 0
    fi
    return 1
  else
    curl -sfLo "$dest_file" --connect-timeout 3 --max-time 8 \
      -H "Cache-Control: no-cache" -H "Pragma: no-cache" \
      "$fetch_url"
    return $?
  fi
}

##
# 현재 소스 모드(--local / --remote)에서 저장소 리소스에 접근 가능한지 사전 확인합니다.
#
# @param 없음
#
# @return 0: 접근 가능, 1: 원격 저장소 연결 불가
##
_check_remote_reachable() {
  if [[ "$SOURCE_MODE" == "local" ]] && _detect_local_repo 2>/dev/null; then
    return 0
  fi
  if _detect_local_repo 2>/dev/null; then
    return 0
  fi
  if [[ "$SOURCE_MODE" == "local" ]]; then
    return 1
  fi

  _ensure_curl
  curl -sfI --connect-timeout 3 --max-time 5 \
    -H "Cache-Control: no-cache" -H "Pragma: no-cache" \
    "${REPO_BASE_URL}/env/catalogs/catalogs.ini?t=$(date +%s)" >/dev/null 2>&1
}

##
# 두 버전 문자열의 선후 관계를 비교합니다 (Semantic / Date-based Versioning).
#
# @param $1 {string} 로컬 버전 (예: 2026.11.23.1)
# @param $2 {string} 원격 버전 (예: 2026.11.23.2)
#
# @return 0: 원격 버전이 더 최신 (local < remote), 1: 로컬이 최신이거나 동일 (local >= remote)
##
_is_newer_version() {
  local v1="$1" # local
  local v2="$2" # remote

  [[ -n "$v1" && -n "$v2" ]] || return 1
  [[ "$v1" == "$v2" ]] && return 1

  # 1. sort -V 지원 시 우선 활용
  if printf '1\n2\n' | sort -V &>/dev/null; then
    local highest
    highest="$(printf '%s\n%s\n' "$v1" "$v2" | sort -V | tail -n 1)"
    if [[ "$highest" == "$v2" && "$v1" != "$v2" ]]; then
      return 0
    fi
    return 1
  fi

  # 2. 순수 Bash Fallback (. 구분자 10진수 배열 비교)
  local -a a1=()
  local -a a2=()
  IFS='.' read -ra a1 <<< "$v1"
  IFS='.' read -ra a2 <<< "$v2"

  local len=${#a1[@]}
  (( ${#a2[@]} > len )) && len=${#a2[@]}

  local i
  for (( i=0; i<len; i++ )); do
    local num1="${a1[i]:-0}"
    local num2="${a2[i]:-0}"
    if (( 10#$num2 > 10#$num1 )); then
      return 0
    elif (( 10#$num2 < 10#$num1 )); then
      return 1
    fi
  done

  return 1
}

##
# 스크립트 파일에서 선언된 버전 문자열(SCRIPT_FILE_VERSION 또는 SCIECTL_VERSION)을 추출합니다.
#
# @param $1 {string} 스크립트 파일 경로
#
# @return 추출된 버전 문자열 (stdout), 미선언 시 빈 문자열
##
_extract_script_version() {
  local file_path="$1"
  [[ -f "$file_path" ]] || return 0

  local line=""
  line="$(grep -m 1 -E '^[[:space:]]*(readonly[[:space:]]+)?(SCRIPT_FILE_VERSION|SCIECTL_VERSION)=' "$file_path" 2>/dev/null || true)"
  if [[ -z "$line" ]]; then
    return 0
  fi

  local ver="${line#*=}"
  ver="${ver%%#*}"
  ver="${ver#"${ver%%[![:space:]]*}"}"
  ver="${ver%"${ver##*[![:space:]]}"}"
  ver="${ver#\"}"
  ver="${ver%\"}"
  ver="${ver#\'}"
  ver="${ver%\'}"
  printf '%s\n' "$ver"
}

##
# 현재 스크립트 파일이 Git 저장소의 작업 디렉토리(로컬 소스 코드) 내에 위치하는지 검사합니다.
# 로컬 개발 중인 소스 코드가 원격 코드로 덮어쓰여 유실되는 것을 방지합니다.
#
# @param $1 {string} 스크립트 파일의 절대 경로
#
# @return 0: Git 로컬 저장소 내부, 1: 독립 배포 경로
##
_is_local_git_repo() {
  local target_file="${1:-}"
  [[ -n "$target_file" && -f "$target_file" ]] || return 1

  local target_dir
  target_dir="$(dirname "$target_file")"

  if command -v git &>/dev/null && git -C "$target_dir" rev-parse --is-inside-work-tree &>/dev/null; then
    return 0
  fi

  return 1
}

##
# 실행 중인 sciectl 스크립트 및 completion 파일을 원격 GitHub 최신 코드와 비교하여
# 다른 경우 원자적으로 다운로드·검증 후 프로세스를 재실행(Re-exec)합니다.
#
# @param $@ {array} 실행 시 전달받은 전체 명령행 인자
#
# @return 0 (업데이트 없거나 건너뛴 경우), 성공 시 프로세스 치환(exec)으로 미반환
##
_check_and_self_update() {
  # 1. 재실행(Re-exec) 루프 방지: 방금 업데이트되어 재실행된 프로세스인 경우 통과
  if [[ "${_SCIECTL_SELF_UPDATED:-0}" == "1" ]]; then
    unset _SCIECTL_SELF_UPDATED
    return 0
  fi

  # 2. 전역 환경변수 비활성화 설정 확인
  if [[ "${SCIECTL_AUTO_UPDATE:-true}" == "false" || "${SCIECTL_NO_UPDATE:-false}" == "true" ]]; then
    return 0
  fi

  # 3. CLI 인자 사전 스캔 (--no-update, --force-update, --local 확인)
  local arg
  local force_update="false"
  for arg in "$@"; do
    case "$arg" in
      --no-update)
        return 0
        ;;
      --local)
        return 0
        ;;
      --force-update)
        force_update="true"
        ;;
    esac
  done

  # 4. 현재 실행 스크립트의 절대 경로 해석
  local current_script=""
  if command -v readlink &>/dev/null; then
    current_script="$(readlink -f "${BASH_SOURCE[0]:-$0}" 2>/dev/null || true)"
  fi
  if [[ -z "$current_script" ]] && command -v realpath &>/dev/null; then
    current_script="$(realpath "${BASH_SOURCE[0]:-$0}" 2>/dev/null || true)"
  fi
  if [[ -z "$current_script" ]]; then
    current_script="${BASH_SOURCE[0]:-$0}"
  fi

  if [[ ! -f "$current_script" ]]; then
    return 0
  fi

  local script_dir
  script_dir="$(dirname "$current_script")"

  # 5. 로컬 Git 개발 저장소 보호 (로컬 작업 복사본인 경우 덮어쓰기 방지)
  if _is_local_git_repo "$current_script"; then
    if [[ "$force_update" != "true" ]]; then
      # 로컬 개발 복사본이므로 안전하게 건너뜀
      return 0
    else
      echo_w "⚠️ [sciectl] 로컬 Git 작업 트리 내에서 실행 중이지만, '--force-update' 옵션에 의해 원격 동기화를 시도합니다."
    fi
  fi

  # 6. 대상 파일 및 디렉토리 쓰기 권한 확인
  if [[ ! -w "$current_script" || ! -w "$script_dir" ]]; then
    if [[ "$force_update" == "true" ]]; then
      echo_w "⚠️ [sciectl] 현재 스크립트 파일('$current_script') 또는 디렉토리에 쓰기 권한이 없어 업데이트를 건너뜁니다."
    fi
    return 0
  fi

  # 7. curl 유틸리티 확인
  if ! command -v curl &>/dev/null; then
    return 0
  fi

  # 8. 원격 파일 다운로드 및 무결성 검증용 임시 디렉토리 생성
  local tmp_dir=""
  tmp_dir="$(mktemp -d /tmp/sciectl_update.XXXXXX 2>/dev/null || mktemp -d -t 'sciectl_update')"
  if [[ ! -d "$tmp_dir" ]]; then
    return 0
  fi

  local remote_script_url="${REPO_BASE_URL}/env/sciectl/sciectl"
  local tmp_script="${tmp_dir}/sciectl"

  # 타임아웃(연결 2초, 전송 최대 5초)으로 원격 최신 스크립트 다운로드
  if ! curl -sfLo "$tmp_script" --connect-timeout 2 --max-time 5 "$remote_script_url" 2>/dev/null; then
    rm -rf -- "$tmp_dir"
    return 0
  fi

  # 내용 변경 여부 검사 (동일하면 정리 후 정상 진행)
  if cmp -s "$current_script" "$tmp_script" 2>/dev/null; then
    rm -rf -- "$tmp_dir"
    return 0
  fi

  # 다운로드된 원격 스크립트의 구문 무결성(Syntax check) 검증
  if ! bash -n "$tmp_script" &>/dev/null; then
    echo_w "⚠️ [sciectl] 원격 최신 코드의 구문 검증(bash -n)에 실패하여 업데이트를 건너뜁니다." >&2
    rm -rf -- "$tmp_dir"
    return 0
  fi

  # 원격 버전 정보 추출 및 선후 비교 (강제 업데이트가 아닌 경우)
  local remote_version=""
  remote_version="$(_extract_script_version "$tmp_script")"

  if [[ "$force_update" != "true" ]]; then
    # 1. 로컬에 버전이 명시되어 있으나 원격에는 버전이 없는 경우 (원격이 레거시 구버전)
    if [[ -n "${SCRIPT_FILE_VERSION:-}" && -z "$remote_version" ]]; then
      rm -rf -- "$tmp_dir"
      return 0
    fi

    # 2. 로컬과 원격 모두 버전이 있는 경우: 원격 버전이 엄격하게 높을 때만 진행
    if [[ -n "$remote_version" && -n "${SCRIPT_FILE_VERSION:-}" ]]; then
      if ! _is_newer_version "$SCRIPT_FILE_VERSION" "$remote_version"; then
        # 원격 버전이 로컬 버전보다 높지 않음 (로컬이 최신이거나 동일한 개발 버전)
        rm -rf -- "$tmp_dir"
        return 0
      fi
    fi
  fi

  if [[ -n "$remote_version" && -n "${SCRIPT_FILE_VERSION:-}" ]]; then
    echo_i "🔄 [sciectl] 원격 저장소에 최신 버전(v${remote_version})이 감지되었습니다 (현재: v${SCRIPT_FILE_VERSION}). 자가 업데이트(Self-Update)를 진행합니다..."
  else
    echo_i "🔄 [sciectl] 원격 저장소에 새로운 버전이 감지되었습니다. 자가 업데이트(Self-Update)를 진행합니다..."
  fi

  # 동반 파일: sciectl.completion 동기화 시도
  local current_completion="${script_dir}/sciectl.completion"
  local tmp_completion="${tmp_dir}/sciectl.completion"
  local remote_completion_url="${REPO_BASE_URL}/env/sciectl/sciectl.completion"

  if [[ -f "$current_completion" && -w "$current_completion" ]]; then
    if curl -sfLo "$tmp_completion" --connect-timeout 2 --max-time 5 "$remote_completion_url" 2>/dev/null; then
      if bash -n "$tmp_completion" &>/dev/null; then
        chmod 644 "$tmp_completion" 2>/dev/null || true
        mv -f "$tmp_completion" "$current_completion" 2>/dev/null || true
      fi
    fi
  fi

  # 원자적 실행 스크립트 교체 (Atomic replacement via mv)
  chmod +x "$tmp_script" 2>/dev/null || true
  if ! mv -f "$tmp_script" "$current_script" 2>/dev/null; then
    echo_w "⚠️ [sciectl] 스크립트 파일 갱신(mv)에 실패했습니다. 기존 버전으로 계속 실행합니다." >&2
    rm -rf -- "$tmp_dir"
    return 0
  fi

  rm -rf -- "$tmp_dir"
  echo_i "✅ [sciectl] 최신 버전으로 갱신 완료되었습니다. 프로세스를 재시작합니다."
  echo

  # 9. 원자적 재실행 (Re-exec)
  export _SCIECTL_SELF_UPDATED=1
  exec "$current_script" "$@"
}

##
# 논리적 도구 식별자(<category>/<name>)를 저장소 상대 경로(<category>/<name>/<name>)로 변환합니다.
#
# @param $1 {string} 도구 식별자 (예: git/git-commit)
#
# @return 변환된 상대 경로 또는 URL 출력
##
_resolve_tool_path() {
  local item="$1"
  if [[ "$item" == https://* || "$item" == http://* ]]; then
    printf '%s\n' "$item"
    return 0
  fi
  # 슬래시가 1개인 경우 (<category>/<name>) -> <category>/<name>/<name>
  local slash_count="${item//[^\/]/}"
  if [[ "${#slash_count}" -eq 1 ]]; then
    local tool_name="${item#*/}"
    printf '%s/%s\n' "$item" "$tool_name"
  else
    printf '%s\n' "$item"
  fi
}

##
# 논리적 인스톨러 식별자(예: install-temurin-25-jdk 또는 docker/install-docker)를 상대 경로로 변환합니다.
# Canonical 경로(env/installers/<canonical dir>/<installer script file>)를 1:1로 직접 매핑합니다.
#
# @param $1 {string} 인스톨러 식별자
#
# @return 변환된 상대 경로 또는 URL 출력
##
_resolve_installer_path() {
  local item="$1"
  if [[ "$item" == https://* || "$item" == http://* ]]; then
    printf '%s\n' "$item"
    return 0
  fi
  if [[ "$item" == *"/"* ]]; then
    _resolve_tool_path "$item"
    return 0
  fi
  local base="${item%.sh}"

  # 1. 로컬 저장소 탐지 시 실제 파일 존재 여부 검사 (1:1 직접 매핑 우선)
  if _detect_local_repo; then
    # 1-1) 1:1 직접 매핑: env/installers/<base>/<base>
    if [[ -f "${LOCAL_REPO_ROOT}/env/installers/${base}/${base}" ]]; then
      printf 'env/installers/%s/%s\n' "$base" "$base"
      return 0
    # 1-2) 'install-' 접두사 누락 시 보정: env/installers/install-<base>/install-<base>
    elif [[ -f "${LOCAL_REPO_ROOT}/env/installers/install-${base}/install-${base}" ]]; then
      printf 'env/installers/install-%s/install-%s\n' "$base" "$base"
      return 0
    # 1-3) 레거시 플랫 파일 fallback
    elif [[ -f "${LOCAL_REPO_ROOT}/env/installers/install-${base#install-}.sh" ]]; then
      printf 'env/installers/install-%s.sh\n' "${base#install-}"
      return 0
    fi
  fi

  # 2. 기본 Canonical 표준 경로 반환
  if [[ "$base" == install-* ]]; then
    printf 'env/installers/%s/%s\n' "$base" "$base"
  else
    printf 'env/installers/install-%s/install-%s\n' "$base" "$base"
  fi
}

##
# 논리적 사후 명령어 식별자(예: firewall-cmd-set-priority)를 상대 경로로 변환합니다.
# Canonical 경로(env/commands/<name>/<name>)를 우선 반환합니다.
#
# @param $1 {string} 명령어 식별자
#
# @return 변환된 상대 경로 또는 URL 출력
##
_resolve_command_path() {
  local item="$1"
  if [[ "$item" == https://* || "$item" == http://* ]]; then
    printf '%s\n' "$item"
    return 0
  fi
  if [[ "$item" == *"/"* ]]; then
    _resolve_tool_path "$item"
    return 0
  fi
  local base="${item%.sh}"

  # 1. 로컬 저장소 탐지 시 실제 파일 존재 여부 우선 검사 (Canonical 우선, 레거시 Fallback)
  if _detect_local_repo; then
    if [[ -f "${LOCAL_REPO_ROOT}/env/commands/${base}/${base}" ]]; then
      printf 'env/commands/%s/%s\n' "$base" "$base"
      return 0
    elif [[ -f "${LOCAL_REPO_ROOT}/env/commands/${base}.sh" ]]; then
      printf 'env/commands/%s.sh\n' "$base"
      return 0
    fi
  fi

  # 2. 기본 Canonical 표준 경로 반환
  printf 'env/commands/%s/%s\n' "$base" "$base"
}

##
# 논리적 SSH 공개키 식별자(예: ymtech-internal) 또는 공개키 문자열을 실제 공개키 문자열로 변환합니다.
# Canonical 경로(env/keys/<name>/<name>.pub)를 우선 탐색합니다.
#
# @param $1 {string} SSH 키 식별자 또는 공개키 원문
#
# @return 공개키 문자열 출력 (실패 시 반환코드 1)
##
_resolve_ssh_key_content() {
  local item="$1"
  if [[ "$item" == ssh-* || "$item" == ecdsa-* ]]; then
    printf '%s\n' "$item"
    return 0
  fi
  local base="${item%.pub}"
  local canonical_rel_path="env/keys/${base}/${base}.pub"
  local legacy_rel_path="env/keys/${base}.pub"
  local tmp_key
  tmp_key="$(mktemp /tmp/sciectl_key.XXXXXX)"

  # 1. 신규 Canonical 경로 우선 로드 시도
  if _fetch_resource "$canonical_rel_path" "$tmp_key" 2>/dev/null; then
    local content
    content="$(grep -v '^[[:space:]]*#' "$tmp_key" | sed '/^[[:space:]]*$/d' | head -n 1)"
    rm -f -- "$tmp_key"
    if [[ -n "$content" ]]; then
      printf '%s\n' "$content"
      return 0
    fi
  fi

  # 2. 구형 플랫 경로 Fallback 로드 시도
  if _fetch_resource "$legacy_rel_path" "$tmp_key" 2>/dev/null; then
    local content
    content="$(grep -v '^[[:space:]]*#' "$tmp_key" | sed '/^[[:space:]]*$/d' | head -n 1)"
    rm -f -- "$tmp_key"
    if [[ -n "$content" ]]; then
      printf '%s\n' "$content"
      return 0
    fi
  fi

  rm -f -- "$tmp_key"
  return 1
}

# ==============================================================================
# 한글/영문 혼용 문자열의 터미널 출력 너비 계산 및 동적 테이블 유틸리티
# ==============================================================================

##
# 문자열의 터미널 출력 너비를 계산합니다 (한글=2, ASCII=1).
#
# @param $1 {string} 대상 문자열
#
# @return 계산된 너비 숫자 출력
##
_get_display_width() {
  local str="$1"
  local width=0
  local i char

  for (( i=0; i<${#str}; i++ )); do
    char="${str:$i:1}"
    if [[ "$char" == [a-zA-Z0-9\ \!\@\#\$%\^\&\*\(\)\_\+\-\=\[\]\{\}\;\:\'\"\,\.\<\>\/\?\`\~\|\\] ]]; then
      ((width++))
    else
      ((width+=2))
    fi
  done
  echo "$width"
}

##
# 지정된 너비만큼 우측에 공백을 채워 문자열을 출력합니다 (좌측 정렬).
#
# @param $1 {string} 대상 문자열
# @param $2 {number} 목표 너비
#
# @return 패딩된 문자열 출력
##
_pad_string() {
  local str="$1"
  local target_width="$2"
  local current_width
  current_width="$(_get_display_width "$str")"
  local spaces=$(( target_width - current_width ))

  echo -n "$str"
  local i
  for (( i=0; i<spaces; i++ )); do
    echo -n " "
  done
}

# ==============================================================================
# 카탈로그 인덱스(catalogs.ini) 및 매니페스트(*.catalog) 파서
# ==============================================================================
declare -a CATALOG_SECTIONS=()
declare -A CATALOG_TITLE=()
declare -A CATALOG_DESC=()
declare -A CATALOG_FILE=()

MAX_ID_WIDTH=10
MAX_TITLE_WIDTH=4
MAX_DESC_WIDTH=4

##
# catalogs.ini 인덱스 파일을 로드하고 파싱합니다.
#
# @param 없음
#
# @return 성공 시 0, 실패 시 exit 1
##
load_catalogs_index() {
  CATALOG_SECTIONS=()
  CATALOG_TITLE=()
  CATALOG_DESC=()
  CATALOG_FILE=()
  MAX_ID_WIDTH=10
  MAX_TITLE_WIDTH=4
  MAX_DESC_WIDTH=4

  local tmp_ini
  tmp_ini="$(mktemp /tmp/sciectl_catalogs_ini.XXXXXX)"
  if ! _fetch_resource "env/catalogs/catalogs.ini" "$tmp_ini"; then
    rm -f -- "$tmp_ini"
    error_exit "카탈로그 인덱스 파일(env/catalogs/catalogs.ini)을 불러올 수 없습니다." "$LINENO"
  fi

  local cur_sec=""
  local line=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [[ -z "$line" || "$line" =~ ^# || "$line" =~ ^\; ]] && continue

    if [[ "$line" =~ ^\[(.*)\]$ ]]; then
      cur_sec="${BASH_REMATCH[1]}"
      CATALOG_SECTIONS+=("$cur_sec")
      local id_w
      id_w="$(_get_display_width "$cur_sec")"
      (( id_w > MAX_ID_WIDTH )) && MAX_ID_WIDTH=$id_w
      continue
    fi

    if [[ "$line" =~ ^([^=]+)=(.*)$ ]]; then
      local key="${BASH_REMATCH[1]}"
      local val="${BASH_REMATCH[2]}"
      local val_w
      val_w="$(_get_display_width "$val")"

      case "$key" in
        title)
          CATALOG_TITLE["$cur_sec"]="$val"
          (( val_w > MAX_TITLE_WIDTH )) && MAX_TITLE_WIDTH=$val_w
          ;;
        description)
          CATALOG_DESC["$cur_sec"]="$val"
          (( val_w > MAX_DESC_WIDTH )) && MAX_DESC_WIDTH=$val_w
          ;;
        catalog_file)
          CATALOG_FILE["$cur_sec"]="$val"
          ;;
        catalog_url)
          CATALOG_FILE["$cur_sec"]="$val"
          ;;
      esac
    fi
  done < "$tmp_ini"

  rm -f -- "$tmp_ini"
}

##
# 카탈로그 목록 테이블의 가로 구분선을 출력합니다.
#
# @param 없음
#
# @return 구분선 출력
##
_print_catalog_border() {
  local total_len=$(( 16 + MAX_ID_WIDTH + MAX_TITLE_WIDTH + MAX_DESC_WIDTH ))
  local i
  for (( i=0; i<total_len; i++ )); do echo -n "-"; done
  echo
}

##
# 카탈로그 목록을 동적 ASCII 테이블로 출력합니다.
#
# @param 없음
#
# @return 테이블 표준 출력
##
show_catalog_table() {
  echo
  _print_catalog_border
  echo -n "|  #  | "
  _pad_string "카탈로그 ID" "$MAX_ID_WIDTH"
  echo -n " | "
  _pad_string "제목" "$MAX_TITLE_WIDTH"
  echo -n " | "
  _pad_string "설명" "$MAX_DESC_WIDTH"
  echo " |"
  _print_catalog_border

  local idx=1
  local sec
  for sec in "${CATALOG_SECTIONS[@]}"; do
    printf "| %3d | " "$idx"
    _pad_string "$sec" "$MAX_ID_WIDTH"
    echo -n " | "
    _pad_string "${CATALOG_TITLE[$sec]:-}" "$MAX_TITLE_WIDTH"
    echo -n " | "
    _pad_string "${CATALOG_DESC[$sec]:-}" "$MAX_DESC_WIDTH"
    echo " |"
    ((idx++))
  done
  _print_catalog_border
  echo
}

# ==============================================================================
# 트랜잭션 누적 컨테이너 (Merged & Deduplicated Items)
# ==============================================================================
declare -a TX_CATALOGS=()
declare -A TX_SEEN_CATALOG=()

declare -a TX_SUDOERS_CMDS=()
declare -A TX_SEEN_SUDOERS=()

declare -a TX_REMOVE_PKGS=()
declare -A TX_SEEN_REMOVE_PKG=()

declare -a TX_INSTALL_PKGS=()
declare -A TX_SEEN_INSTALL_PKG=()

declare -a TX_TOOLS=()
declare -A TX_SEEN_TOOL=()

declare -a TX_INSTALLERS=()
declare -A TX_SEEN_INSTALLER=()

declare -a TX_COMMANDS=()
declare -A TX_SEEN_COMMAND=()

declare -a TX_SSH_KEYS=()
declare -A TX_SEEN_SSH_KEY=()

##
# 콤마(,)로 구분된 문자열을 파싱하여 지정된 트랜잭션 배열에 중복 없이 추가합니다.
#
# @param $1 {string} 대상 항목 유형 (sudoers | remove_pkg | install_pkg | tool | installer | command | ssh_key)
# @param $2 {string} 콤마로 구분된 값 문자열
#
# @return 0
##
_add_tx_items() {
  local item_type="$1"
  local raw_csv="${2:-}"
  [[ -n "$raw_csv" ]] || return 0

  local -a parts=()
  IFS=',' read -ra parts <<< "$raw_csv"
  local part trimmed
  for part in "${parts[@]}"; do
    trimmed="$(echo "$part" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [[ -n "$trimmed" ]] || continue

    case "$item_type" in
      sudoers)
        if [[ -z "${TX_SEEN_SUDOERS[$trimmed]:-}" ]]; then
          TX_SUDOERS_CMDS+=("$trimmed")
          TX_SEEN_SUDOERS["$trimmed"]=1
        fi
        ;;
      remove_pkg)
        if [[ -z "${TX_SEEN_REMOVE_PKG[$trimmed]:-}" ]]; then
          TX_REMOVE_PKGS+=("$trimmed")
          TX_SEEN_REMOVE_PKG["$trimmed"]=1
        fi
        ;;
      install_pkg)
        if [[ -z "${TX_SEEN_INSTALL_PKG[$trimmed]:-}" ]]; then
          TX_INSTALL_PKGS+=("$trimmed")
          TX_SEEN_INSTALL_PKG["$trimmed"]=1
        fi
        ;;
      tool)
        if [[ -z "${TX_SEEN_TOOL[$trimmed]:-}" ]]; then
          TX_TOOLS+=("$trimmed")
          TX_SEEN_TOOL["$trimmed"]=1
        fi
        ;;
      installer)
        if [[ -z "${TX_SEEN_INSTALLER[$trimmed]:-}" ]]; then
          TX_INSTALLERS+=("$trimmed")
          TX_SEEN_INSTALLER["$trimmed"]=1
        fi
        ;;
      command)
        if [[ -z "${TX_SEEN_COMMAND[$trimmed]:-}" ]]; then
          TX_COMMANDS+=("$trimmed")
          TX_SEEN_COMMAND["$trimmed"]=1
        fi
        ;;
      ssh_key)
        if [[ -z "${TX_SEEN_SSH_KEY[$trimmed]:-}" ]]; then
          TX_SSH_KEYS+=("$trimmed")
          TX_SEEN_SSH_KEY["$trimmed"]=1
        fi
        ;;
    esac
  done
}

##
# 단일 카탈로그 매니페스트(*.catalog)를 로드하고 INCLUDES 상속을 재귀적으로 병합합니다.
#
# @param $1 {string} 카탈로그 ID
#
# @return 성공 시 0, 실패 시 exit 1
##
resolve_catalog() {
  local cat_id="$1"
  [[ -n "$cat_id" ]] || return 0

  # 순환 참조 및 중복 로드 방지
  if [[ -n "${TX_SEEN_CATALOG[$cat_id]:-}" ]]; then
    return 0
  fi
  TX_SEEN_CATALOG["$cat_id"]=1

  local rel_file="env/catalogs/${cat_id}.catalog"
  if [[ -n "${CATALOG_FILE[$cat_id]:-}" ]]; then
    if [[ "${CATALOG_FILE[$cat_id]}" == https://* ]]; then
      rel_file="${CATALOG_FILE[$cat_id]}"
    else
      rel_file="env/catalogs/${CATALOG_FILE[$cat_id]}"
    fi
  fi

  local tmp_cat
  tmp_cat="$(mktemp /tmp/sciectl_cat.XXXXXX)"
  if ! _fetch_resource "$rel_file" "$tmp_cat"; then
    rm -f -- "$tmp_cat"
    error_exit "존재하지 않는 카탈로그이거나 매니페스트를 불러올 수 없습니다: '$cat_id' ($rel_file)" "$LINENO"
  fi

  local includes_val=""
  local sudoers_val=""
  local remove_val=""
  local install_val=""
  local tools_val=""
  local installers_val=""
  local commands_val=""
  local ssh_keys_val=""

  local line=""
  local accumulated=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    # 주석 및 빈 줄 제거
    local stripped
    stripped="$(echo "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [[ -z "$stripped" || "$stripped" =~ ^# ]] && continue

    # 백슬래시(\) 줄 바꿈 연결 지원
    if [[ "$stripped" == *\\ ]]; then
      accumulated+="${stripped%\\} "
      continue
    else
      accumulated+="$stripped"
    fi

    local full_line="$accumulated"
    accumulated=""

    if [[ "$full_line" =~ ^([^=]+)=(.*)$ ]]; then
      local key
      key="$(echo "${BASH_REMATCH[1]}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
      local val
      val="$(printf '%s' "${BASH_REMATCH[2]}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

      case "$key" in
        INCLUDES)              includes_val+=",$val" ;;
        NO_PASSWORD_COMMANDS)  sudoers_val+=",$val" ;;
        REMOVE_PACKAGES)       remove_val+=",$val" ;;
        INSTALL_PACKAGES)      install_val+=",$val" ;;
        TOOLS)
          tools_val+=",$val"
          ;;
        INSTALLERS)
          installers_val+=",$val"
          ;;
        COMMANDS|COMMADNS)
          commands_val+=",$val"
          ;;
        SSH_KEYS)
          ssh_keys_val+=",$val"
          ;;
      esac
    fi
  done < "$tmp_cat"

  rm -f -- "$tmp_cat"

  # 1. 상위 카탈로그(INCLUDES)부터 먼저 재귀 병합 (부모가 먼저 설치되도록 순서 보장)
  if [[ -n "$includes_val" ]]; then
    local -a inc_arr=()
    IFS=',' read -ra inc_arr <<< "$includes_val"
    local inc_id
    for inc_id in "${inc_arr[@]}"; do
      inc_id="$(echo "$inc_id" | xargs)"
      [[ -n "$inc_id" ]] && resolve_catalog "$inc_id"
    done
  fi

  # 2. 현재 카탈로그 항목 병합
  TX_CATALOGS+=("$cat_id")
  _add_tx_items "sudoers"     "$sudoers_val"
  _add_tx_items "remove_pkg"  "$remove_val"
  _add_tx_items "install_pkg" "$install_val"
  _add_tx_items "tool"        "$tools_val"
  _add_tx_items "installer"   "$installers_val"
  _add_tx_items "command"     "$commands_val"
  _add_tx_items "ssh_key"     "$ssh_keys_val"
}

# ==============================================================================
# 대화형(Interactive) 카탈로그 다중 선택 및 단계 선택 UI
# ==============================================================================

##
# 대화형으로 1개 이상의 카탈로그를 선택받아 resolve_catalog를 수행합니다.
#
# @param 없음
#
# @return 선택 완료 시 0, 취소 시 1
##
interactive_select_catalogs() {
  load_catalogs_index
  local total_items="${#CATALOG_SECTIONS[@]}"
  local interrupted=0

  while true; do
    show_catalog_table

    interrupted=0
    trap 'interrupted=1' SIGINT

    local choice_line=""
    echo -n "> 🛠️  설치할 카탈로그 번호(또는 ID)를 입력하세요 (복수 선택은 띄어쓰기/콤마 구분, 예: 1 4) [취소: Enter 또는 q]: " >&2
    read -r choice_line

    trap - SIGINT

    local trimmed_choice
    trimmed_choice="$(echo "$choice_line" | xargs)"
    if (( interrupted == 1 )) || [[ -z "$trimmed_choice" || "$choice_line" == "q" || "$choice_line" == "Q" ]]; then
      echo_w " - [🛑] 카탈로그 선택을 취소했습니다." >&2
      return 1
    fi

    choice_line="${choice_line//,/ }"
    local -a tokens=()
    read -ra tokens <<< "$choice_line"

    local -a picked_ids=()
    local valid=true
    local tok
    for tok in "${tokens[@]}"; do
      if [[ "$tok" =~ ^[0-9]+$ ]]; then
        if (( tok < 1 || tok > total_items )); then
          echo_w "⚠️  - 잘못된 번호입니다 ($tok). 1에서 $total_items 사이의 숫자를 입력해주세요." >&2
          valid=false
          break
        fi
        picked_ids+=("${CATALOG_SECTIONS[$((tok - 1))]}")
      else
        local found=false
        local sec
        for sec in "${CATALOG_SECTIONS[@]}"; do
          if [[ "$sec" == "$tok" ]]; then
            found=true
            picked_ids+=("$sec")
            break
          fi
        done
        if [[ "$found" == false ]]; then
          echo_w "⚠️  - 알 수 없는 카탈로그 식별자입니다: '$tok'" >&2
          valid=false
          break
        fi
      fi
    done

    [[ "$valid" == true ]] || continue

    echo >&2
    echo "================================================================================" >&2
    echo -e "▶ 선택하신 카탈로그 (${#picked_ids[@]}개):" >&2
    local pid
    for pid in "${picked_ids[@]}"; do
      echo -e "  - ${COLOR_CYAN}${pid}${COLOR_NC} : ${CATALOG_TITLE[$pid]:-} (${CATALOG_DESC[$pid]:-})" >&2
    done
    echo "================================================================================" >&2

    for pid in "${picked_ids[@]}"; do
      resolve_catalog "$pid"
    done
    return 0
  done
}

# ==============================================================================
# 핵심 설치 작업 함수 (7대 메커니즘 + 기본 환경 3종)
# ==============================================================================
declare -A EXECUTED_JOB_FLAGS=()

##
# 사용자의 홈 디렉토리에 bin 디렉토리를 생성하고 PATH 환경변수에 등록합니다.
#
# @param 없음
#
# @return 진행 상황 메시지 출력
##
_setup_home_bin() {
  local func_name="${FUNCNAME[0]}"
  [[ "${EXECUTED_JOB_FLAGS[$func_name]:-0}" -eq 1 ]] && return 0

  echo
  echo "############### $func_name ###############"
  echo "[✨] $HOME/bin 디렉토리 설정 중..."
  local bin_dir="$HOME/bin"
  if [[ ! -d "$bin_dir" ]]; then
    mkdir -p "$bin_dir" || error_exit "~/bin 디렉토리 생성 실패" "$LINENO"
    echo_i " - ~/bin 디렉토리를 생성했습니다."
  fi

  [[ -f "$BASH_ENV_FILE" ]] || touch "$BASH_ENV_FILE"

  if ! grep -q "PATH=.*$bin_dir" "$BASH_ENV_FILE"; then
    echo "export PATH=\"\$PATH:$bin_dir\"" >> "$BASH_ENV_FILE" || error_exit "$BASH_ENV_FILE 파일 수정 실패" "$LINENO"
    export PATH="$PATH:$bin_dir"
    echo_i " - $BASH_ENV_FILE 파일에 PATH 설정('$HOME/bin')을 추가했습니다."
    _add_notice "### $HOME/bin -> \$PATH 추가 작업 ###" false
    _add_notice " - 현재 터미널에 즉시 반영하려면 다음 명령을 실행하세요: source $BASH_ENV_FILE" false
  else
    echo_w " - $BASH_ENV_FILE 파일에 이미 PATH 설정이 존재합니다."
  fi

  local local_man_dir="${XDG_DATA_HOME:-$HOME/.local/share}/man"
  local user_share_man="$HOME/share/man"
  if [[ -d "$local_man_dir" ]]; then
    if [[ ! -e "$user_share_man" && ! -L "$user_share_man" ]]; then
      mkdir -p "$HOME/share" 2>/dev/null || true
      ln -s "$local_man_dir" "$user_share_man" 2>/dev/null || true
    elif [[ -L "$user_share_man" ]]; then
      ln -sfn "$local_man_dir" "$user_share_man" 2>/dev/null || true
    fi
  fi

  EXECUTED_JOB_FLAGS["$func_name"]=1
}

##
# .bashrc 또는 .bash_profile 파일에 현재 위치의 git branch를 표시하는 프롬프트(PS1) 설정을 추가합니다.
#
# @param 없음
#
# @return 진행 상황 메시지 출력
##
_setup_git_prompt() {
  local func_name="${FUNCNAME[0]}"
  [[ "${EXECUTED_JOB_FLAGS[$func_name]:-0}" -eq 1 ]] && return 0

  echo
  echo "############### $func_name ###############"
  echo "[✨] git branch 프롬프트 설정 중..."

  [[ -f "$BASH_ENV_FILE" ]] || touch "$BASH_ENV_FILE"

  if ! grep -q "parse_git_branch()" "$BASH_ENV_FILE"; then
    cat << 'EOF' >> "$BASH_ENV_FILE" || error_exit "$BASH_ENV_FILE 파일 수정 실패" "$LINENO"

parse_git_branch() {
  git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1) /'
}

PS1='[directory] \[\033[01;31m\]$(parse_git_branch)\[\033[00m\]\[\033[01;34m\]\w\[\033[00m\]\n[\t ] \[\033[01;32m\]\u@\h\[\033[00m\]:$ '
EOF
    echo_i " - $BASH_ENV_FILE 에 git 프롬프트 설정을 추가했습니다."
  else
    echo_w " - $BASH_ENV_FILE 파일에 이미 git 프롬프트 설정이 존재합니다."
  fi

  EXECUTED_JOB_FLAGS["$func_name"]=1
}

##
# /etc/vim/vimrc (macOS의 경우 $HOME/.vimrc) 파일에 커스텀 기본 옵션들을 활성화합니다.
# (반드시 install_packages 이후에 실행되어 vim 미설치 상태의 파일 누락 문제를 방지합니다.)
#
# @param 없음
#
# @return 진행 상황 메시지 출력
##
_install_vim_options() {
  local func_name="${FUNCNAME[0]}"
  [[ "${EXECUTED_JOB_FLAGS[$func_name]:-0}" -eq 1 ]] && return 0

  echo
  echo "############### $func_name ###############"
  echo "[✨] vim 환경 설정 중..."

  local vimrc_file="/etc/vim/vimrc"
  local is_user_vimrc=false

  if [[ "$TARGET_OS" == "darwin" ]]; then
    # macOS는 SIP로 인해 시스템 디렉토리 쓰기가 차단되므로 개인 ~/.vimrc 타겟
    vimrc_file="$HOME/.vimrc"
    is_user_vimrc=true
  elif [[ ! -f "$vimrc_file" && -f "/etc/vimrc" ]]; then
    vimrc_file="/etc/vimrc"
  fi

  if [[ "$is_user_vimrc" == true ]]; then
    [[ -f "$vimrc_file" ]] || touch "$vimrc_file"
    if ! grep -q "\" Custom Settings by setup-env" "$vimrc_file"; then
      cat << 'EOF' >> "$vimrc_file"

" Custom Settings by setup-env (sciectl)
set showcmd   " Show (partial) command in status line.
set ts=2
set shiftwidth=2
set paste
set hlsearch
set nu
set expandtab
EOF
      echo_i " - [💡] $vimrc_file 파일에 커스텀 설정을 추가했습니다."
    else
      echo_w " - $vimrc_file 파일에 이미 커스텀 설정이 존재합니다."
    fi
  elif [[ -f "$vimrc_file" ]]; then
    if ! grep -q "\" Custom Settings by setup-env" "$vimrc_file"; then
      cat << 'EOF' | sudo tee -a "$vimrc_file" > /dev/null

" Custom Settings by setup-env (sciectl)
set showcmd   " Show (partial) command in status line.
set ts=2
set shiftwidth=2
set paste
set hlsearch
set nu
set expandtab
EOF
      echo_i " - [💡] $vimrc_file 파일에 커스텀 설정을 추가했습니다."
    else
      echo_w " - $vimrc_file 파일에 이미 커스텀 설정이 존재합니다."
    fi
  else
    echo_w " - [⚠️] vimrc 파일을 찾지 못해 vim 커스텀 설정을 건너뜁니다."
  fi

  EXECUTED_JOB_FLAGS["$func_name"]=1
}

##
# 패키지 삭제/설치가 실제로 필요할 때만 단 1회 OS 패키지 매니저 인덱스를 업데이트합니다.
#
# @param 없음
#
# @return 성공 시 0, 실패 시 1
##
_try_pkg_update() {
  local func_name="${FUNCNAME[0]}"
  [[ "${EXECUTED_JOB_FLAGS[$func_name]:-0}" -eq 1 ]] && return 0

  _detect_pkg_manager
  echo
  echo "############### $func_name ###############"
  echo "[✨] 패키지 인덱스 업데이트 중 ($PKG_MANAGER)..."

  if $PKG_UPDATE_CMD; then
    EXECUTED_JOB_FLAGS["$func_name"]=1
    return 0
  else
    echo_w "⚠️  패키지 인덱스 업데이트에 실패했습니다."
    return 1
  fi
}

##
# 사용하지 않는 OS 패키지를 일괄 또는 개별 제거합니다.
#
# @param 없음
#
# @return 0
##
remove_packages() {
  if (( ${#TX_REMOVE_PKGS[@]} == 0 )); then
    return 0
  fi

  local func_name="${FUNCNAME[0]}"
  [[ "${EXECUTED_JOB_FLAGS[$func_name]:-0}" -eq 1 ]] && return 0

  _detect_pkg_manager
  echo
  echo "############### $func_name ###############"

  local -a installed_targets=()
  local pkg
  for pkg in "${TX_REMOVE_PKGS[@]}"; do
    if _is_package_installed "$pkg"; then
      installed_targets+=("$pkg")
    else
      echo_w " - '$pkg' 패키지가 시스템에 존재하지 않아 제거를 건너뜁니다."
    fi
  done

  if (( ${#installed_targets[@]} > 0 )); then
    echo "[✨] 불필요 패키지 제거 중: ${installed_targets[*]}"
    if ! $PKG_REMOVE_CMD "${installed_targets[@]}"; then
      for pkg in "${installed_targets[@]}"; do
        $PKG_REMOVE_CMD "$pkg" || _add_notice " - [$func_name] [ERROR] '$pkg' 패키지 제거 실패"
      done
    else
      echo_i " - 패키지 제거 완료: ${installed_targets[*]}"
    fi
  fi

  EXECUTED_JOB_FLAGS["$func_name"]=1
}

##
# 필요한 OS 패키지를 확인하여 미설치 패키지를 일괄 설치합니다 (실패 시 개별 폴백).
#
# @param 없음
#
# @return 0
##
install_packages() {
  if (( ${#TX_INSTALL_PKGS[@]} == 0 )); then
    return 0
  fi

  local func_name="${FUNCNAME[0]}"
  [[ "${EXECUTED_JOB_FLAGS[$func_name]:-0}" -eq 1 ]] && return 0

  _detect_pkg_manager
  echo
  echo "############### $func_name ###############"

  local -a missing_pkgs=()
  local pkg
  for pkg in "${TX_INSTALL_PKGS[@]}"; do
    if [[ "$PKG_MANAGER" == "brew" ]]; then
      # macOS / Homebrew 미지원 Linux 전용 시스템 패키지는 사전에 필터링
      if [[ "$pkg" == "firewalld" || "$pkg" == "net-tools" || "$pkg" == "ufw" ]]; then
        echo_w " - '$pkg' 패키지는 macOS 환경에서 지원하지 않아 설치를 건너뜁니다."
        continue
      fi
    fi

    if _is_package_installed "$pkg"; then
      echo_w " - '$pkg' 패키지가 이미 설치되어 있습니다."
    else
      missing_pkgs+=("$pkg")
    fi
  done

  if (( ${#missing_pkgs[@]} > 0 )); then
    _try_pkg_update || true
    echo "[✨] 미설치 패키지 일괄 설치 중 (${#missing_pkgs[@]}개): ${missing_pkgs[*]}"
    if $PKG_INSTALL_CMD "${missing_pkgs[@]}"; then
      echo_i " - 패키지 일괄 설치가 완료되었습니다: ${missing_pkgs[*]}"
    else
      echo_w " - 일괄 설치 중 일부 오류가 발생하여 개별 설치로 재시도합니다..."
      for pkg in "${missing_pkgs[@]}"; do
        if ! _is_package_installed "$pkg"; then
          if $PKG_INSTALL_CMD "$pkg"; then
            echo_i " - '$pkg' 설치 완료"
          else
            echo_e " - [ERROR] '$pkg' 패키지 설치 실패"
            _add_notice " - [$func_name] [ERROR] '$pkg' 패키지 설치 실패 (수동 확인 필요)"
          fi
        fi
      done
    fi
  fi

  EXECUTED_JOB_FLAGS["$func_name"]=1
}

##
# 사용자를 sudoers에 등록하고 NOPASSWD 명령어 목록을 기존 파일과 안전하게 병합/정렬 및 visudo 검증합니다.
#
# @param $1 {string} 대상 사용자 계정명
#
# @return 성공 시 0, 실패 시 1
##
setup_sudoers() {
  local target_user="${1:-${USER:-$(whoami)}}"
  if (( ${#TX_SUDOERS_CMDS[@]} == 0 )); then
    return 0
  fi

  local func_name="${FUNCNAME[0]}"
  [[ "${EXECUTED_JOB_FLAGS[$func_name]:-0}" -eq 1 ]] && return 0

  if [[ "$TARGET_OS" == "darwin" ]]; then
    echo
    echo "############### $func_name ($target_user) ###############"
    echo_w " - [💡] macOS 환경에서는 sudoers NOPASSWD 자동 등록을 건너뜁니다."
    EXECUTED_JOB_FLAGS["$func_name"]=1
    return 0
  fi

  _detect_pkg_manager
  echo
  echo "############### $func_name ($target_user) ###############"
  echo "[✨] 사용자 '$target_user' sudoers 설정 병합 중..."

  local sudoers_file="/etc/sudoers.d/user-${target_user}"
  local -a all_cmds=()

  if [[ "$PKG_MANAGER" == "apt" ]]; then
    all_cmds+=("/usr/bin/apt" "/usr/bin/apt-get")
  elif [[ "$PKG_MANAGER" == "dnf" ]]; then
    all_cmds+=("/usr/bin/dnf")
  elif [[ "$PKG_MANAGER" == "pacman" ]]; then
    all_cmds+=("/usr/bin/pacman")
  fi

  if sudo test -f "$sudoers_file"; then
    local existing_cmds_str
    existing_cmds_str="$(sudo grep "NOPASSWD:" "$sudoers_file" 2>/dev/null | sed 's/.*NOPASSWD:[[:space:]]*//' || true)"
    local -a existing_arr=()
    IFS=',' read -ra existing_arr <<< "$existing_cmds_str"
    local cmd
    for cmd in "${existing_arr[@]}"; do
      cmd="$(echo "$cmd" | xargs)"
      [[ -n "$cmd" ]] && all_cmds+=("$cmd")
    done
  fi

  local new_cmd
  for new_cmd in "${TX_SUDOERS_CMDS[@]}"; do
    [[ -n "$new_cmd" ]] && all_cmds+=("$new_cmd")
  done

  declare -a unique_cmds=()
  declare -A seen_cmds=()
  local c
  for c in "${all_cmds[@]}"; do
    if [[ -z "${seen_cmds[$c]:-}" ]]; then
      unique_cmds+=("$c")
      seen_cmds["$c"]=1
    fi
  done

  local -a sorted_cmds=()
  while IFS= read -r c; do
    [[ -n "$c" ]] && sorted_cmds+=("$c")
  done < <(printf '%s\n' "${unique_cmds[@]}" | sort)

  local final_cmds_str=""
  for c in "${sorted_cmds[@]}"; do
    if [[ -z "$final_cmds_str" ]]; then
      final_cmds_str="$c"
    else
      final_cmds_str="${final_cmds_str}, ${c}"
    fi
  done

  local tmp_sudoers
  tmp_sudoers="$(mktemp /tmp/sudoers.XXXXXX)"
  echo "${target_user} ALL=(ALL) ALL" > "$tmp_sudoers"
  if [[ -n "$final_cmds_str" ]]; then
    echo "${target_user} ALL=(ALL) NOPASSWD: ${final_cmds_str}" >> "$tmp_sudoers"
  fi

  if sudo visudo -c -f "$tmp_sudoers" &>/dev/null; then
    sudo tee "$sudoers_file" < "$tmp_sudoers" >/dev/null
    sudo chmod 440 "$sudoers_file"
    rm -f -- "$tmp_sudoers"
    echo_i " - [🛠️] '${target_user}' sudoers 설정이 안전하게 병합 및 적용되었습니다. ($sudoers_file)"
    EXECUTED_JOB_FLAGS["$func_name"]=1
    return 0
  else
    rm -f -- "$tmp_sudoers"
    echo_e " - [❌] 'sudoers' 문법 검증(visudo)에 실패하여 설정을 취소합니다."
    _add_notice " - [$func_name] [❌] 'sudoers' 문법 검증 실패로 설정 취소"
    return 1
  fi
}

##
# 확장자가 없는 신규 스크립트 설치 시, 동일한 이름에 '.sh'가 붙은 구버전 스크립트 및
# bash completion 파일이 존재하면 자동으로 정리합니다.
#
# @param $1 {string} 삭제 확인할 구버전 명령어 이름 (예: my-tool.sh)
# @param $2 {string} 스크립트 설치 디렉토리 (예: $HOME/bin)
#
# @return 0
##
_remove_legacy_sh_tool() {
  local legacy_cmd="$1"
  local bin_dir="$2"
  [[ -n "$legacy_cmd" && -n "$bin_dir" ]] || return 0

  local legacy_script="${bin_dir}/${legacy_cmd}"
  local has_legacy_script=0
  if [[ -f "$legacy_script" || -L "$legacy_script" ]]; then
    has_legacy_script=1
  fi

  local -a comp_dirs=()
  if [[ "$TARGET_OS" == "darwin" ]]; then
    local brew_prefix=""
    if command -v brew &>/dev/null; then
      brew_prefix="$(brew --prefix 2>/dev/null || true)"
    fi
    [[ -n "$brew_prefix" && -d "${brew_prefix}/etc/bash_completion.d" ]] && comp_dirs+=("${brew_prefix}/etc/bash_completion.d")
    [[ -n "$brew_prefix" && -d "${brew_prefix}/share/bash-completion/completions" ]] && comp_dirs+=("${brew_prefix}/share/bash-completion/completions")
    [[ -d "$HOME/.bash_completion.d" ]] && comp_dirs+=("$HOME/.bash_completion.d")
  fi
  if [[ -d "/usr/share/bash-completion/completions" ]]; then
    comp_dirs+=("/usr/share/bash-completion/completions")
  fi
  if [[ -d "/etc/bash_completion.d" ]]; then
    comp_dirs+=("/etc/bash_completion.d")
  fi

  local -a legacy_comp_files=()
  local dir cand
  for dir in "${comp_dirs[@]}"; do
    for cand in "${dir}/${legacy_cmd}" "${dir}/${legacy_cmd}.completion"; do
      if [[ -f "$cand" || -L "$cand" ]]; then
        legacy_comp_files+=("$cand")
      fi
    done
  done

  if (( has_legacy_script == 0 && ${#legacy_comp_files[@]} == 0 )); then
    return 0
  fi

  if (( has_legacy_script == 1 )); then
    if rm -f -- "$legacy_script" 2>/dev/null || sudo rm -f -- "$legacy_script"; then
      echo_i " - [🗑️] '${legacy_cmd}' 구버전 실행 파일을 정리했습니다. ($legacy_script)"
    fi
  fi

  local comp_file
  for comp_file in "${legacy_comp_files[@]}"; do
    if sudo rm -f -- "$comp_file"; then
      echo_i " - [🗑️] '${legacy_cmd}' 구버전 자동완성 파일을 정리했습니다. ($comp_file)"
    fi
  done
}

# ==============================================================================
# 설치 상태 매니페스트 관리 (Manifest Registry)
# ==============================================================================
LAST_INSTALLED_COMP_PATH=""
LAST_INSTALLED_MAN_PATHS=""
MANIFEST_SYNCED=0

##
# 도구 매니페스트 디렉토리 경로를 반환합니다.
#
# @param $1 {string} 설치 범위 (local | global)
#
# @return 디렉토리 경로 출력
##
_manifest_tools_dir() {
  local scope="${1:-local}"
  if [[ "$scope" == "global" ]]; then
    printf '%s\n' "/var/lib/sciectl/installed/tools"
  else
    printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/sciectl/installed/tools"
  fi
}

##
# SSH 공개키 매니페스트 디렉토리 경로를 반환합니다.
#
# @param 없음
#
# @return 디렉토리 경로 출력
##
_manifest_keys_dir() {
  printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/sciectl/installed/keys"
}

##
# 현재 시각을 ISO-8601 유사 문자열로 반환합니다.
#
# @param 없음
#
# @return 타임스탬프 문자열 출력
##
_manifest_now_iso() {
  date +"%Y-%m-%dT%H:%M:%S%z" 2>/dev/null || date +"%Y-%m-%dT%H:%M:%S"
}

##
# KEY=VALUE 포맷의 매니페스트 파일에서 특정 키 값을 안전하게 조회합니다.
#
# @param $1 {string} 매니페스트 파일 경로
# @param $2 {string} 조회할 키 이름
#
# @return 해당 키 값 출력
##
_manifest_get_field() {
  local meta_file="$1"
  local key="$2"
  [[ -f "$meta_file" ]] || return 1

  local k v
  while IFS='=' read -r k v || [[ -n "$k" ]]; do
    [[ -z "$k" || "$k" == \#* ]] && continue
    if [[ "$k" == "$key" ]]; then
      printf '%s\n' "$v"
      return 0
    fi
  done < "$meta_file"
  return 1
}

##
# 매니페스트 파일을 원자적으로 기록합니다.
#
# @param $1 {string} 대상 파일 경로
# @param $2 {string} 기록할 전체 내용
# @param $3 {string} sudo 사용 여부 (true | false)
#
# @return 0: 성공, 1: 실패
##
_manifest_write_file() {
  local dest_file="$1"
  local content="$2"
  local use_sudo="${3:-false}"
  local dest_dir
  dest_dir="$(dirname "$dest_file")"

  local tmp_f
  tmp_f="$(mktemp "/tmp/sciectl_meta.XXXXXX")" || return 1
  printf '%s\n' "$content" > "$tmp_f"

  if [[ "$use_sudo" == "true" ]]; then
    sudo mkdir -p "$dest_dir" && sudo mv "$tmp_f" "$dest_file" && sudo chmod 644 "$dest_file"
  else
    mkdir -p "$dest_dir" && mv "$tmp_f" "$dest_file" && chmod 644 "$dest_file"
  fi
}

##
# 설치/업데이트된 CLI 도구의 메타데이터를 매니페스트에 저장합니다.
#
# @param $1 {string} 도구 식별자 (예: git/git-commit)
# @param $2 {string} 실행 명령어 이름 (예: git-commit)
# @param $3 {string} 설치 범위 (local | global)
# @param $4 {string} 설치된 버전
# @param $5 {string} 실행 파일 절대 경로
# @param $6 {string} 자동완성 파일 절대 경로 (선택)
# @param $7 {string} man 페이지 파일 절대 경로 목록 (콜론 구분, 선택)
#
# @return 0
##
_manifest_save_tool() {
  local tool_id="$1"
  local cmd_name="$2"
  local target_scope="${3:-local}"
  local version="${4:-}"
  local bin_path="$5"
  local comp_path="${6:-}"
  local man_paths="${7:-}"

  local meta_dir
  meta_dir="$(_manifest_tools_dir "$target_scope")"
  local meta_file="${meta_dir}/${cmd_name}.meta"
  local use_sudo="false"
  [[ "$target_scope" == "global" ]] && use_sudo="true"

  local now
  now="$(_manifest_now_iso)"
  local installed_at="$now"
  if [[ -f "$meta_file" ]]; then
    local prev_installed
    prev_installed="$(_manifest_get_field "$meta_file" "INSTALLED_AT" || true)"
    [[ -n "$prev_installed" ]] && installed_at="$prev_installed"
  fi

  local content
  content=$(cat <<EOF
TOOL_ID=${tool_id}
CMD_NAME=${cmd_name}
TARGET_SCOPE=${target_scope}
VERSION=${version}
BIN_PATH=${bin_path}
COMPLETION_PATH=${comp_path}
MAN_PATHS=${man_paths}
INSTALLED_AT=${installed_at}
UPDATED_AT=${now}
EOF
)
  _manifest_write_file "$meta_file" "$content" "$use_sudo" 2>/dev/null || true
}

##
# CLI 도구의 매니페스트 파일을 삭제합니다.
#
# @param $1 {string} 실행 명령어 이름
# @param $2 {string} 설치 범위 (local | global)
#
# @return 0
##
_manifest_delete_tool() {
  local cmd_name="$1"
  local target_scope="${2:-local}"
  local meta_file
  meta_file="$(_manifest_tools_dir "$target_scope")/${cmd_name}.meta"
  [[ -f "$meta_file" ]] || return 0

  if [[ "$target_scope" == "global" && ! -w "$meta_file" ]]; then
    sudo rm -f -- "$meta_file"
  else
    rm -f -- "$meta_file"
  fi
}

##
# 등록된 SSH 공개키의 메타데이터를 매니페스트에 저장합니다.
#
# @param $1 {string} SSH 키 식별자 (예: ymtech-internal)
# @param $2 {string} 공개키 본문 (Base64)
# @param $3 {string} 공개키 주석
# @param $4 {string} authorized_keys 파일 경로
#
# @return 0
##
_manifest_save_key() {
  local key_id="$1"
  local key_body="$2"
  local key_comment="${3:-}"
  local auth_file="${4:-${HOME}/.ssh/authorized_keys}"

  local meta_dir
  meta_dir="$(_manifest_keys_dir)"
  local meta_file="${meta_dir}/${key_id}.meta"

  local now
  now="$(_manifest_now_iso)"
  local installed_at="$now"
  if [[ -f "$meta_file" ]]; then
    local prev_installed
    prev_installed="$(_manifest_get_field "$meta_file" "INSTALLED_AT" || true)"
    [[ -n "$prev_installed" ]] && installed_at="$prev_installed"
  fi

  local content
  content=$(cat <<EOF
KEY_ID=${key_id}
KEY_BODY=${key_body}
KEY_COMMENT=${key_comment}
AUTH_FILE=${auth_file}
INSTALLED_AT=${installed_at}
UPDATED_AT=${now}
EOF
)
  _manifest_write_file "$meta_file" "$content" "false" 2>/dev/null || true
}

##
# SSH 공개키의 매니페스트 파일을 삭제합니다.
#
# @param $1 {string} SSH 키 식별자
#
# @return 0
##
_manifest_delete_key() {
  local key_id="$1"
  local meta_file
  meta_file="$(_manifest_keys_dir)/${key_id}.meta"
  [[ -f "$meta_file" ]] && rm -f -- "$meta_file"
  return 0
}

##
# 저장소(로컬 또는 all-scripts.catalog)에서 알려진 모든 도구 식별자(<category>/<name>)를 수집합니다.
#
# @param 없음
#
# @return 줄바꿈 구분 도구 식별자 목록 출력
##
_manifest_collect_known_tools() {
  declare -A seen_tools=()
  local tid=""

  if _detect_local_repo 2>/dev/null; then
    local c_dir t_dir cat_name tool_name
    for c_dir in "${LOCAL_REPO_ROOT}"/*; do
      [[ -d "$c_dir" ]] || continue
      cat_name="$(basename "$c_dir")"
      [[ "$cat_name" == .* || "$cat_name" == "tmp" || "$cat_name" == "docs" ]] && continue
      for t_dir in "$c_dir"/*; do
        [[ -d "$t_dir" ]] || continue
        tool_name="$(basename "$t_dir")"
        if [[ "$cat_name" == "env" && ("$tool_name" == "installers" || "$tool_name" == "commands" || "$tool_name" == "keys" || "$tool_name" == "catalogs") ]]; then
          continue
        fi
        if [[ -f "$t_dir/$tool_name" || -f "$t_dir/${tool_name}.sh" ]]; then
          tid="${cat_name}/${tool_name}"
          if [[ -z "${seen_tools[$tid]:-}" ]]; then
            seen_tools["$tid"]=1
            printf '%s\n' "$tid"
          fi
        fi
      done
    done
    return 0
  fi

  local tmp_all
  tmp_all="$(mktemp "/tmp/sciectl_all_tools.XXXXXX")"
  if _fetch_resource "env/catalogs/all-scripts.catalog" "$tmp_all" 2>/dev/null; then
    local TOOLS=""
    local raw_line="" val="" in_cont=0
    while IFS= read -r raw_line || [[ -n "$raw_line" ]]; do
      raw_line="${raw_line%$'\r'}"
      if (( in_cont == 1 )); then
        if [[ "$raw_line" == *\\ ]]; then
          TOOLS+="${raw_line%\\}"
        else
          TOOLS+="$raw_line"
          in_cont=0
        fi
        continue
      fi
      [[ -z "${raw_line//[[:space:]]/}" || "$raw_line" == \#* ]] && continue
      if [[ "$raw_line" == TOOLS=* ]]; then
        val="${raw_line#TOOLS=}"
        if [[ "$val" == *\\ ]]; then
          TOOLS="${val%\\}"
          in_cont=1
        else
          TOOLS="$val"
        fi
      fi
    done < "$tmp_all"

    local -a t_arr=()
    IFS=',' read -ra t_arr <<< "$TOOLS"
    local item
    for item in "${t_arr[@]}"; do
      item="$(echo "$item" | xargs)"
      if [[ -n "$item" && -z "${seen_tools[$item]:-}" ]]; then
        seen_tools["$item"]=1
        printf '%s\n' "$item"
      fi
    done
  fi
  rm -f -- "$tmp_all"

  if [[ -z "${seen_tools[env/sciectl]:-}" ]]; then
    printf '%s\n' "env/sciectl"
  fi
}

##
# 저장소(로컬 또는 카탈로그)에서 알려진 SSH 공개키 식별자 목록을 수집합니다.
#
# @param 없음
#
# @return 줄바꿈 구분 SSH 키 식별자 목록 출력
##
_manifest_collect_known_keys() {
  if _detect_local_repo 2>/dev/null && [[ -d "${LOCAL_REPO_ROOT}/env/keys" ]]; then
    local d bname
    for d in "${LOCAL_REPO_ROOT}/env/keys"/*; do
      [[ -d "$d" ]] || continue
      bname="$(basename "$d")"
      if [[ -f "$d/${bname}.pub" ]]; then
        printf '%s\n' "$bname"
      fi
    done
    return 0
  fi

  local k
  for k in "ymtech-internal" "letsencrypt"; do
    printf '%s\n' "$k"
  done
}

##
# 시스템에 이미 설치된 도구의 자동완성 및 man 페이지 경로를 탐색합니다.
#
# @param $1 {string} 실행 명령어 이름
# @param $2 {string} 설치 범위 (local | global)
#
# @return 전역 변수 FOUND_COMP_PATH, FOUND_MAN_PATHS 설정
##
_manifest_discover_companions() {
  local cmd_name="$1"
  local target_scope="${2:-local}"
  FOUND_COMP_PATH=""
  FOUND_MAN_PATHS=""

  local -a comp_candidates=(
    "/usr/share/bash-completion/completions/${cmd_name}"
    "/etc/bash_completion.d/${cmd_name}.completion"
    "${HOME}/.bash_completion.d/${cmd_name}.completion"
  )
  if [[ "$TARGET_OS" == "darwin" ]] && command -v brew &>/dev/null; then
    local bp
    bp="$(brew --prefix 2>/dev/null || true)"
    if [[ -n "$bp" ]]; then
      comp_candidates=(
        "${bp}/etc/bash_completion.d/${cmd_name}.completion"
        "${bp}/share/bash-completion/completions/${cmd_name}"
        "${comp_candidates[@]}"
      )
    fi
  fi

  local c
  for c in "${comp_candidates[@]}"; do
    if [[ -f "$c" ]]; then
      FOUND_COMP_PATH="$c"
      break
    fi
  done

  local man_base_dir="${XDG_DATA_HOME:-$HOME/.local/share}/man"
  if [[ "$target_scope" == "global" ]]; then
    man_base_dir="/usr/local/share/man"
    if [[ "$TARGET_OS" == "darwin" ]] && command -v brew &>/dev/null; then
      local bp
      bp="$(brew --prefix 2>/dev/null || true)"
      [[ -n "$bp" && -d "${bp}/share/man" ]] && man_base_dir="${bp}/share/man"
    fi
  fi

  local -a found_mans=()
  local -a man_names=("man1/${cmd_name}.1")
  if [[ "$cmd_name" == "sshctl" ]]; then
    man_names+=("man5/sshctl.conf.5" "man7/sshctl-security.7")
  elif [[ "$cmd_name" == "sciectl" ]]; then
    man_names+=("man5/sciectl-catalog.5")
  fi

  local mn
  for mn in "${man_names[@]}"; do
    if [[ -f "${man_base_dir}/${mn}" ]]; then
      found_mans+=("${man_base_dir}/${mn}")
    fi
  done

  if (( ${#found_mans[@]} > 0 )); then
    local IFS=':'
    FOUND_MAN_PATHS="${found_mans[*]}"
  fi
}

##
# 매니페스트 도입 이전에 설치된 기존 도구 및 SSH 공개키를 스캔하여 자동으로 매니페스트를 복구합니다.
#
# @param 없음
#
# @return 0
##
_manifest_sync_legacy() {
  (( MANIFEST_SYNCED == 1 )) && return 0
  MANIFEST_SYNCED=1

  declare -A cmd_to_tid=()
  local tid bname
  while IFS= read -r tid; do
    [[ -n "$tid" ]] || continue
    bname="$(basename "$tid")"
    cmd_to_tid["$bname"]="$tid"
  done < <(_manifest_collect_known_tools)

  local scope bin_dir
  for scope in "local" "global"; do
    bin_dir="${HOME}/bin"
    [[ "$scope" == "global" ]] && bin_dir="/usr/local/bin"
    [[ -d "$bin_dir" ]] || continue

    local meta_dir
    meta_dir="$(_manifest_tools_dir "$scope")"

    local f cmd_name
    for f in "${bin_dir}"/*; do
      [[ -f "$f" ]] || continue
      cmd_name="$(basename "$f")"
      [[ -f "${meta_dir}/${cmd_name}.meta" ]] && continue
      [[ -n "${cmd_to_tid[$cmd_name]:-}" ]] || continue

      if head -n 40 "$f" 2>/dev/null | grep -qE '(@author[[:space:]]*:.*parkjunhong77@gmail\.com|SCRIPT_FILE_VERSION=)'; then
        local ver=""
        ver="$(_extract_script_version "$f")"
        _manifest_discover_companions "$cmd_name" "$scope"
        _manifest_save_tool "${cmd_to_tid[$cmd_name]}" "$cmd_name" "$scope" "$ver" "$f" "$FOUND_COMP_PATH" "$FOUND_MAN_PATHS"
      fi
    done
  done

  local auth_file="${HOME}/.ssh/authorized_keys"
  if [[ -f "$auth_file" ]]; then
    local keys_dir
    keys_dir="$(_manifest_keys_dir)"
    local key_id pub_content key_body key_comment
    while IFS= read -r key_id; do
      [[ -n "$key_id" ]] || continue
      [[ -f "${keys_dir}/${key_id}.meta" ]] && continue
      if pub_content="$(_resolve_ssh_key_content "$key_id" 2>/dev/null)"; then
        key_body="$(echo "$pub_content" | awk '{print $2}')"
        key_comment="$(echo "$pub_content" | cut -d' ' -f3-)"
        if [[ -n "$key_body" ]] && grep -qF "$key_body" "$auth_file" 2>/dev/null; then
          _manifest_save_key "$key_id" "$key_body" "$key_comment" "$auth_file"
        fi
      fi
    done < <(_manifest_collect_known_keys)
  fi
}

##
# 현재 시스템에 설치된 도구 및 SSH 키 목록을 매니페스트에서 조회하여 파이프(|) 구분 레코드로 출력합니다.
# 레코드 형식: <type>|<id>|<name>|<scope>|<version>|<primary_path>|<meta_file>
#
# @param $1 {string} 범위 필터 (all | local | global, 기본값: all)
#
# @return 파이프 구분 레코드 목록 출력
##
_manifest_list_installed() {
  local filter_scope="${1:-all}"
  _manifest_sync_legacy

  local scope meta_dir mf
  for scope in "local" "global"; do
    [[ "$filter_scope" == "all" || "$filter_scope" == "$scope" ]] || continue
    meta_dir="$(_manifest_tools_dir "$scope")"
    [[ -d "$meta_dir" ]] || continue
    for mf in "${meta_dir}"/*.meta; do
      [[ -f "$mf" ]] || continue
      local tid cmd ver bpath
      tid="$(_manifest_get_field "$mf" "TOOL_ID" || true)"
      cmd="$(_manifest_get_field "$mf" "CMD_NAME" || true)"
      ver="$(_manifest_get_field "$mf" "VERSION" || true)"
      bpath="$(_manifest_get_field "$mf" "BIN_PATH" || true)"
      [[ -n "$bpath" && -f "$bpath" ]] || continue
      printf 'tool|%s|%s|%s|%s|%s|%s\n' "$tid" "$cmd" "$scope" "${ver:-unknown}" "$bpath" "$mf"
    done
  done

  if [[ "$filter_scope" == "all" || "$filter_scope" == "local" ]]; then
    local keys_dir kf
    keys_dir="$(_manifest_keys_dir)"
    if [[ -d "$keys_dir" ]]; then
      for kf in "${keys_dir}"/*.meta; do
        [[ -f "$kf" ]] || continue
        local kid kbody kcomment afile
        kid="$(_manifest_get_field "$kf" "KEY_ID" || true)"
        kbody="$(_manifest_get_field "$kf" "KEY_BODY" || true)"
        kcomment="$(_manifest_get_field "$kf" "KEY_COMMENT" || true)"
        afile="$(_manifest_get_field "$kf" "AUTH_FILE" || echo "${HOME}/.ssh/authorized_keys")"
        [[ -f "$afile" && -n "$kbody" ]] || continue
        grep -qF "$kbody" "$afile" 2>/dev/null || continue
        printf 'ssh-key|%s|%s|user|%s|%s|%s\n' "$kid" "$kid" "${kcomment:-ssh-rsa}" "$afile" "$kf"
      done
    fi
  fi
}

##
# Bash Completion 파일을 시스템 표준 경로에 설치합니다.
#
# @param $1 {string} completion 상대 경로 또는 URL
# @param $2 {string} 대상 명령어 이름
# @param $3 {string} 강제 덮어쓰기 여부 (true | false)
#
# @return 0
##
_install_completion() {
  local comp_ref="$1"
  local target_cmd="$2"
  local force_overwrite="${3:-false}"
  LAST_INSTALLED_COMP_PATH=""

  local comp_dir=""
  if [[ "$TARGET_OS" == "darwin" ]]; then
    local brew_prefix=""
    if command -v brew &>/dev/null; then
      brew_prefix="$(brew --prefix 2>/dev/null || true)"
    fi
    if [[ -n "$brew_prefix" && -d "${brew_prefix}/etc/bash_completion.d" ]]; then
      comp_dir="${brew_prefix}/etc/bash_completion.d"
    elif [[ -n "$brew_prefix" && -d "${brew_prefix}/share/bash-completion/completions" ]]; then
      comp_dir="${brew_prefix}/share/bash-completion/completions"
    elif [[ -d "$HOME/.bash_completion.d" ]]; then
      comp_dir="$HOME/.bash_completion.d"
    else
      comp_dir="$HOME/.bash_completion.d"
      mkdir -p "$comp_dir"
    fi
  else
    if command -v pkg-config &>/dev/null; then
      comp_dir="$(pkg-config --variable=completionsdir bash-completion 2>/dev/null || true)"
    fi
    if [[ -z "$comp_dir" && -d "/usr/share/bash-completion/completions" ]]; then
      comp_dir="/usr/share/bash-completion/completions"
    fi
    if [[ -z "$comp_dir" && -d "/etc/bash_completion.d" ]]; then
      comp_dir="/etc/bash_completion.d"
    fi
    if [[ -z "$comp_dir" ]]; then
      comp_dir="/etc/bash_completion.d"
      sudo mkdir -p "$comp_dir"
    fi
  fi

  local temp_comp
  temp_comp="$(mktemp "/tmp/${target_cmd}.completion.XXXXXX")"

  if ! _fetch_resource "$comp_ref" "$temp_comp"; then
    rm -f -- "$temp_comp"
    return 0
  fi

  local target_comp_file="${comp_dir}/${target_cmd}"
  if [[ "$comp_dir" == *"/etc/bash_completion.d"* || "$comp_dir" == *"$HOME/.bash_completion.d"* ]]; then
    target_comp_file="${comp_dir}/${target_cmd}.completion"
  fi

  local move_cmd="sudo mv"
  local chmod_cmd="sudo chmod 644"
  if [[ -w "$comp_dir" ]] || [[ ! -e "$target_comp_file" && -w "$(dirname "$target_comp_file")" ]]; then
    move_cmd="mv"
    chmod_cmd="chmod 644"
  fi

  local installed=0
  if [[ -f "$target_comp_file" ]]; then
    if ! cmp -s "$temp_comp" "$target_comp_file"; then
      local ch="y"
      if [[ "$force_overwrite" != "true" && -t 0 ]]; then
        read -r -p "> '${target_cmd} completion' 내용이 다릅니다. 업데이트하시겠습니까? (y/Enter: 취소): " ch
      fi
      if [[ "$ch" =~ ^[Yy]$ ]]; then
        $move_cmd "$temp_comp" "$target_comp_file" && $chmod_cmd "$target_comp_file"
        echo_i " - '${target_cmd} completion' 파일이 업데이트되었습니다. ($target_comp_file)"
        installed=1
      else
        echo_w " - '${target_cmd} completion' 기존 파일을 유지합니다 (업데이트 취소)."
        rm -f -- "$temp_comp"
      fi
    else
      echo_w " - '${target_cmd} completion' 파일이 이미 최신입니다."
      rm -f -- "$temp_comp"
    fi
  else
    $move_cmd "$temp_comp" "$target_comp_file" && $chmod_cmd "$target_comp_file"
    echo_i " - '${target_cmd} completion' 파일을 설치했습니다. ($target_comp_file)"
    installed=1
  fi

  if (( installed == 1 )) && [[ -f "$target_comp_file" ]]; then
    if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
      # shellcheck disable=SC1090
      source "$target_comp_file" 2>/dev/null || true
    fi
  fi

  if [[ -f "$target_comp_file" ]]; then
    LAST_INSTALLED_COMP_PATH="$target_comp_file"
  fi
}

##
# 도구의 연관 man 페이지 파일들을 시스템 표준 man 경로에 설치합니다.
#
# @param $1 {string} 도구 상대 경로 (예: utils/scriptctl/scriptctl)
# @param $2 {string} 대상 명령어 이름 (예: scriptctl)
# @param $3 {string} 설치 범위 (local | global)
# @param $4 {string} 강제 덮어쓰기 여부 (true | false)
#
# @return 0
##
_install_manpages() {
  local resolved_ref="$1"
  local target_cmd="$2"
  local target_scope="${3:-local}"
  local force_overwrite="${4:-false}"
  LAST_INSTALLED_MAN_PATHS=""

  [[ "$resolved_ref" == https://* || "$resolved_ref" == http://* ]] && return 0

  local tool_dir
  tool_dir="$(dirname "$resolved_ref")"
  [[ -n "$tool_dir" && "$tool_dir" != "." ]] || return 0

  local man_base_dir=""
  if [[ "$target_scope" == "local" ]]; then
    man_base_dir="${XDG_DATA_HOME:-$HOME/.local/share}/man"
  else
    if [[ "$TARGET_OS" == "darwin" ]] && command -v brew &>/dev/null; then
      local brew_prefix
      brew_prefix="$(brew --prefix 2>/dev/null || true)"
      if [[ -n "$brew_prefix" && -d "${brew_prefix}/share/man" ]]; then
        man_base_dir="${brew_prefix}/share/man"
      fi
    fi
    [[ -z "$man_base_dir" ]] && man_base_dir="/usr/local/share/man"
  fi

  local -a man_rel_list=()
  if _detect_local_repo && [[ -d "${LOCAL_REPO_ROOT}/${tool_dir}/man" ]]; then
    local f
    while IFS= read -r f; do
      [[ -n "$f" ]] && man_rel_list+=("${f#${LOCAL_REPO_ROOT}/}")
    done < <(find "${LOCAL_REPO_ROOT}/${tool_dir}/man" -maxdepth 2 -type f -name "*.[1-8]" 2>/dev/null | sort -u)
  else
    man_rel_list+=("${tool_dir}/man/man1/${target_cmd}.1")
    if [[ "$target_cmd" == "sshctl" ]]; then
      man_rel_list+=("${tool_dir}/man/man5/sshctl.conf.5" "${tool_dir}/man/man7/sshctl-security.7")
    elif [[ "$target_cmd" == "sciectl" ]]; then
      man_rel_list+=("${tool_dir}/man/man5/sciectl-catalog.5")
    fi
  fi

  (( ${#man_rel_list[@]} > 0 )) || return 0

  local man_rel man_bname man_sec man_sec_dir target_man_file temp_man
  local any_installed=0
  local need_sudo_man=false
  local -a recorded_man_files=()

  for man_rel in "${man_rel_list[@]}"; do
    man_bname="$(basename "$man_rel")"
    man_sec="${man_bname##*.}"
    man_sec_dir="${man_base_dir}/man${man_sec}"
    target_man_file="${man_sec_dir}/${man_bname}"

    temp_man="$(mktemp "/tmp/${man_bname}.XXXXXX")"
    if ! _fetch_resource "$man_rel" "$temp_man" 2>/dev/null; then
      rm -f -- "$temp_man"
      continue
    fi

    local check_dir="$man_sec_dir"
    while [[ ! -e "$check_dir" && "$check_dir" != "/" && "$check_dir" != "." ]]; do
      check_dir="$(dirname "$check_dir")"
    done

    local move_cmd="sudo mv"
    local chmod_cmd="sudo chmod 644"
    local mkdir_cmd="sudo mkdir -p"
    if [[ -w "$check_dir" ]] && [[ ! -e "$target_man_file" || -w "$target_man_file" ]]; then
      move_cmd="mv"
      chmod_cmd="chmod 644"
      mkdir_cmd="mkdir -p"
    else
      need_sudo_man=true
    fi

    [[ -d "$man_sec_dir" ]] || $mkdir_cmd "$man_sec_dir"

    if [[ -f "$target_man_file" ]]; then
      if ! cmp -s "$temp_man" "$target_man_file"; then
        local ch="y"
        if [[ "$force_overwrite" != "true" && -t 0 ]]; then
          read -r -p "> '${man_bname} man page' 내용이 다릅니다. 업데이트하시겠습니까? (y/Enter: 취소): " ch
        fi
        if [[ "$ch" =~ ^[Yy]$ ]]; then
          $move_cmd "$temp_man" "$target_man_file" && $chmod_cmd "$target_man_file"
          echo_i " - '${man_bname} man page' 파일이 업데이트되었습니다. ($target_man_file)"
          any_installed=1
        else
          echo_w " - '${man_bname} man page' 기존 파일을 유지합니다 (업데이트 취소)."
          rm -f -- "$temp_man"
        fi
      else
        echo_w " - '${man_bname} man page' 파일이 이미 최신입니다."
        rm -f -- "$temp_man"
      fi
    else
      $move_cmd "$temp_man" "$target_man_file" && $chmod_cmd "$target_man_file"
      echo_i " - '${man_bname} man page' 파일을 설치했습니다. ($target_man_file)"
      any_installed=1
    fi

    if [[ -f "$target_man_file" ]]; then
      recorded_man_files+=("$target_man_file")
    fi
  done

  if (( ${#recorded_man_files[@]} > 0 )); then
    local IFS=':'
    LAST_INSTALLED_MAN_PATHS="${recorded_man_files[*]}"
  fi

  # local 설치 시 macOS 등 $HOME/bin 기반 환경에서 man 명령어가 매뉴얼을 탐색할 수 있도록
  # $HOME/share/man -> $man_base_dir 심볼릭 링크 브리지를 구성합니다.
  if [[ "$target_scope" == "local" && -d "$man_base_dir" ]]; then
    local user_share_man="$HOME/share/man"
    if [[ ! -e "$user_share_man" && ! -L "$user_share_man" ]]; then
      mkdir -p "$HOME/share" 2>/dev/null || true
      if ln -s "$man_base_dir" "$user_share_man" 2>/dev/null; then
        echo_i " - Man Page 호환 경로 링크를 생성했습니다. ($user_share_man -> $man_base_dir)"
      fi
    elif [[ -L "$user_share_man" ]]; then
      ln -sfn "$man_base_dir" "$user_share_man" 2>/dev/null || true
    fi
  fi

  if (( any_installed == 1 )) && command -v mandb &>/dev/null; then
    if [[ "$need_sudo_man" == true ]]; then
      sudo mandb -q >/dev/null 2>&1 || true
    else
      mandb -q "$man_base_dir" >/dev/null 2>&1 || true
    fi
  fi
}

##
# 단일 커스텀 도구 및 연관 .completion, man 페이지 파일을 설치합니다.
#
# @param $1 {string} 커스텀 도구 식별자 또는 URL
# @param $2 {string} 설치 범위 (local | global)
# @param $3 {string} 강제 덮어쓰기 여부 (true | false)
# @param $4 {string} 무인 자동 승인 여부 (true | false)
#
# @return 0
##
_install_tool() {
  local func_name="${FUNCNAME[0]}"
  local raw_id="$1"
  local target_scope="${2:-local}"
  local force_overwrite="${3:-false}"
  local auto_yes="${4:-false}"

  local resolved_ref
  resolved_ref="$(_resolve_tool_path "$raw_id")"
  local target_cmd
  target_cmd="$(basename "$resolved_ref")"

  echo
  echo "############### $func_name - $target_cmd ###############"
  echo "[✨] '$target_cmd' 설치 중... ($resolved_ref)"

  local bin_dir="${HOME}/bin"
  local use_sudo=false
  if [[ "$target_scope" == "global" ]]; then
    bin_dir="/usr/local/bin"
    use_sudo=true
  fi

  local temp_bin
  temp_bin="$(mktemp "/tmp/${target_cmd}.XXXXXX")"

  if ! _fetch_resource "$resolved_ref" "$temp_bin" "true"; then
    echo_e " - [❌] '${target_cmd}' 도구 파일을 가져올 수 없어 설치를 생략합니다. ($resolved_ref)"
    rm -f -- "$temp_bin"
    _add_notice " - [$func_name] [❌] '${target_cmd}' 다운로드 실패 ($resolved_ref)"
    return 0
  fi

  if [[ "$use_sudo" == true ]]; then
    sudo mkdir -p "$bin_dir"
  else
    mkdir -p "$bin_dir"
  fi

  local dest_bin="${bin_dir}/${target_cmd}"
  local sync_companions=true

  if [[ -f "$dest_bin" ]]; then
    if ! cmp -s "$temp_bin" "$dest_bin"; then
      local local_ver=""
      local remote_ver=""
      local_ver="$(_extract_script_version "$dest_bin")"
      remote_ver="$(_extract_script_version "$temp_bin")"

      local should_update=false
      local ask_confirm=false
      local prompt_msg="> '$target_cmd' 실행 파일 내용이 다릅니다. 업데이트하시겠습니까? (y/Enter: 취소): "

      if [[ "$force_overwrite" == "true" ]]; then
        should_update=true
      elif [[ -n "$local_ver" && -n "$remote_ver" ]]; then
        if _is_newer_version "$local_ver" "$remote_ver"; then
          should_update=true
          prompt_msg="> '$target_cmd' 새 버전이 있습니다 (v${local_ver} -> v${remote_ver}). 업데이트하시겠습니까? (y/Enter: 취소): "
        elif [[ "$local_ver" == "$remote_ver" ]]; then
          if [[ "$auto_yes" != "true" && -t 0 ]]; then
            should_update=true
            ask_confirm=true
            prompt_msg="> '$target_cmd' 버전은 동일(v${local_ver})하지만 파일 내용이 다릅니다. 업데이트하시겠습니까? (y/Enter: 취소): "
          else
            echo_w " - '$target_cmd' 동일 버전(v${local_ver})이나 파일 내용이 다릅니다. '--force' 미지정으로 기존 파일을 유지합니다."
            sync_companions=false
            rm -f -- "$temp_bin"
          fi
        else
          echo_w " - '$target_cmd' 로컬 버전(v${local_ver})이 설치 대상(v${remote_ver})보다 최신이므로 유지합니다."
          sync_companions=false
          rm -f -- "$temp_bin"
        fi
      elif [[ -z "$local_ver" && -n "$remote_ver" ]]; then
        should_update=true
        prompt_msg="> '$target_cmd' 버전 정보가 포함된 최신 버전(v${remote_ver})으로 업데이트하시겠습니까? (y/Enter: 취소): "
      elif [[ -n "$local_ver" && -z "$remote_ver" ]]; then
        echo_w " - '$target_cmd' 로컬 버전(v${local_ver})을 유지합니다 (설치 대상에 버전 정보 없음)."
        sync_companions=false
        rm -f -- "$temp_bin"
      else
        should_update=true
      fi

      if [[ "$should_update" == true ]]; then
        local ch="y"
        if [[ "$force_overwrite" != "true" ]] && [[ "$ask_confirm" == true || ( "$auto_yes" != "true" && -t 0 ) ]]; then
          read -r -p "$prompt_msg" ch
        fi
        if [[ "$ch" =~ ^[Yy]$ ]]; then
          if [[ "$use_sudo" == true ]]; then
            sudo mv "$temp_bin" "$dest_bin" && sudo chmod 755 "$dest_bin"
          else
            mv "$temp_bin" "$dest_bin" && chmod 755 "$dest_bin"
          fi
          if [[ -n "$local_ver" && -n "$remote_ver" ]]; then
            echo_i " - '$target_cmd' 실행 파일이 업데이트되었습니다 (v${local_ver} -> v${remote_ver}). ($dest_bin)"
          elif [[ -n "$remote_ver" ]]; then
            echo_i " - '$target_cmd' 실행 파일이 업데이트되었습니다 (v${remote_ver}). ($dest_bin)"
          else
            echo_i " - '$target_cmd' 실행 파일이 업데이트되었습니다. ($dest_bin)"
          fi
        else
          echo_w " - '$target_cmd' 기존 실행 파일을 유지합니다 (업데이트 취소)."
          sync_companions=false
          rm -f -- "$temp_bin"
        fi
      fi
    else
      echo_w " - '$target_cmd' 실행 파일이 이미 최신입니다."
      rm -f -- "$temp_bin"
    fi
  else
    if [[ "$use_sudo" == true ]]; then
      sudo mv "$temp_bin" "$dest_bin" && sudo chmod 755 "$dest_bin"
    else
      mv "$temp_bin" "$dest_bin" && chmod 755 "$dest_bin"
    fi
    echo_i " - '$target_cmd' 실행 파일을 설치했습니다. ($dest_bin)"
  fi

  if [[ "$sync_companions" == true ]]; then
    local companion_force="$force_overwrite"
    [[ "$auto_yes" == "true" ]] && companion_force="true"
    _install_completion "${resolved_ref}.completion" "$target_cmd" "$companion_force"
    _install_manpages "$resolved_ref" "$target_cmd" "$target_scope" "$companion_force"
  fi

  if [[ "$target_cmd" != *.sh ]]; then
    _remove_legacy_sh_tool "${target_cmd}.sh" "$bin_dir"
  fi

  if [[ -f "$dest_bin" ]]; then
    local installed_ver=""
    installed_ver="$(_extract_script_version "$dest_bin")"
    if [[ "$sync_companions" != true ]]; then
      _manifest_discover_companions "$target_cmd" "$target_scope"
      LAST_INSTALLED_COMP_PATH="$FOUND_COMP_PATH"
      LAST_INSTALLED_MAN_PATHS="$FOUND_MAN_PATHS"
    fi
    local meta_tool_id="$raw_id"
    if [[ "$resolved_ref" != https://* && "$resolved_ref" != http://* ]]; then
      meta_tool_id="$(dirname "$resolved_ref")"
    fi
    _manifest_save_tool "$meta_tool_id" "$target_cmd" "$target_scope" "$installed_ver" "$dest_bin" "$LAST_INSTALLED_COMP_PATH" "$LAST_INSTALLED_MAN_PATHS"
  fi
}

##
# 트랜잭션에 등록된 모든 도구(Tools)를 순차 설치합니다.
#
# @param $1 {string} 설치 범위 (local | global)
# @param $2 {string} 강제 덮어쓰기 여부 (true | false)
# @param $3 {string} 무인 자동 승인 여부 (true | false)
#
# @return 0
##
setup_tools() {
  local target_scope="${1:-local}"
  local force_overwrite="${2:-false}"
  local auto_yes="${3:-false}"

  if (( ${#TX_TOOLS[@]} == 0 )); then
    return 0
  fi

  local func_name="${FUNCNAME[0]}"
  [[ "${EXECUTED_JOB_FLAGS[$func_name]:-0}" -eq 1 ]] && return 0

  local tool_id
  for tool_id in "${TX_TOOLS[@]}"; do
    [[ -n "$tool_id" ]] && _install_tool "$tool_id" "$target_scope" "$force_overwrite" "$auto_yes"
  done

  EXECUTED_JOB_FLAGS["$func_name"]=1
}

##
# 인스톨러 또는 사후 명령어 스크립트를 가져와 무결성/보안 검증 후 서브쉘에서 실행합니다.
#
# @param $1 {string} 스크립트 상대 경로 또는 HTTPS URL
#
# @return 성공 시 0, 실패 시 1
##
_execute_script() {
  local func_name="${FUNCNAME[0]}"
  local script_ref="$1"
  local target_cmd
  target_cmd="$(basename "$script_ref")"

  local ref_hash
  ref_hash="$(printf '%s' "$script_ref" | md5sum | cut -d' ' -f1)"
  local job_flag="${func_name}-${ref_hash}"
  [[ "${EXECUTED_JOB_FLAGS[$job_flag]:-0}" -eq 1 ]] && return 0

  echo
  echo "############### $func_name - $target_cmd ###############"
  echo "[✨] '$target_cmd' 실행 준비 중... ($script_ref)"

  if [[ "$script_ref" == http://* ]]; then
    echo_e " - [❌] 평문 HTTP URL은 허용되지 않습니다 (HTTPS만 허용): $script_ref"
    _add_notice " - [$func_name] [❌] 보안 정책 위반 (HTTP URL 차단): $script_ref"
    return 1
  fi

  local temp_script="/tmp/sciectl_exec_${ref_hash}.sh"
  rm -f -- "$temp_script"

  if ! _fetch_resource "$script_ref" "$temp_script"; then
    echo_e " - [❌] '${target_cmd}' 스크립트를 가져올 수 없어 실행을 생략합니다. ($script_ref)"
    rm -f -- "$temp_script"
    _add_notice " - [$func_name] [❌] '${target_cmd}' 스크립트 로드 실패 ($script_ref)"
    return 0
  fi

  if [[ ! -s "$temp_script" ]]; then
    echo_e " - [❌] 로드된 스크립트 파일이 비어 있습니다: $target_cmd"
    rm -f -- "$temp_script"
    return 1
  fi

  if [[ -L "$temp_script" ]]; then
    echo_e " - [❌] 심볼릭 링크 공격이 감지되어 실행을 중단합니다: $temp_script"
    rm -f -- "$temp_script"
    return 1
  fi

  if command -v file &>/dev/null; then
    local file_type
    file_type="$(file -b "$temp_script")"
    if [[ "$file_type" != *"shell script"* && "$file_type" != *"text"* ]]; then
      echo_e " - [❌] 파일이 유효한 쉘 스크립트가 아닙니다 ($file_type): $target_cmd"
      rm -f -- "$temp_script"
      return 1
    fi
  fi

  chmod 700 "$temp_script"
  echo_i " - '$target_cmd' 실행 중..."

  export -f _add_notice
  export -f error_exit
  export -f echo_e echo_w echo_i

  if ! /bin/bash "$temp_script"; then
    local exit_code=$?
    echo_e " - [❌] '$target_cmd' 실행 실패 (exit code: $exit_code)"
    rm -f -- "$temp_script"
    _add_notice " - [$func_name] [❌] '$target_cmd' 실행 실패 (exit code: $exit_code)"
    return 1
  fi

  rm -f -- "$temp_script"
  echo_i " - [🛠️] '$target_cmd' 실행이 완료되었습니다."
  EXECUTED_JOB_FLAGS["$job_flag"]=1
  return 0
}

