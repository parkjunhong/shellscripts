def _interactive_select_catalogs(ctx: AppContext, plan: TransactionPlan) -> bool:
    catalogs = load_catalogs_index(ctx)
    cat_ids = list(catalogs.keys())
    total = len(cat_ids)
    while True:
        show_catalog_table(catalogs)
        try:
            sys.stderr.write("> 🛠️  설치할 카탈로그 번호(또는 ID)를 입력하세요 (복수 선택은 띄어쓰기/콤마 구분, 예: 1 4) [취소: Enter 또는 q]: ")
            sys.stderr.flush()
            choice_line = input().strip()
        except (EOFError, KeyboardInterrupt):
            print(file=sys.stderr)
            echo_w(" - [🛑] 카탈로그 선택을 취소했습니다.", file=sys.stderr)
            return False

        if not choice_line or choice_line.lower() == "q":
            echo_w(" - [🛑] 카탈로그 선택을 취소했습니다.", file=sys.stderr)
            return False

        picked_ids: List[str] = []
        valid = True
        for tok in choice_line.replace(",", " ").split():
            if tok.isdigit():
                n = int(tok)
                if n < 1 or n > total:
                    echo_w(f"⚠️  - 잘못된 번호입니다 ({tok}). 1에서 {total} 사이의 숫자를 입력해주세요.", file=sys.stderr)
                    valid = False
                    break
                picked_ids.append(cat_ids[n - 1])
            elif tok in catalogs:
                picked_ids.append(tok)
            else:
                echo_w(f"⚠️  - 알 수 없는 카탈로그 식별자입니다: '{tok}'", file=sys.stderr)
                valid = False
                break
        if not valid or not picked_ids:
            continue

        print(file=sys.stderr)
        print("=" * 80, file=sys.stderr)
        print(f"▶ 선택하신 카탈로그 ({len(picked_ids)}개):", file=sys.stderr)
        for pid in picked_ids:
            meta = catalogs[pid]
            print(f"  - {COLOR_CYAN}{pid}{COLOR_NC} : {meta.title} ({meta.description})", file=sys.stderr)
        print("=" * 80, file=sys.stderr)
        for pid in picked_ids:
            resolve_catalog(ctx, catalogs, plan, pid)
        return True


