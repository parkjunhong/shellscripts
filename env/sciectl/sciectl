##
# [list 서브커맨드] 카탈로그, 인스톨러, 커맨드, SSH 공개키 목록을 출력합니다.
#
# @param $@ {array} list 서브커맨드 인자
#
# @return 0
##
cmd_list() {
  local list_type="catalogs"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --type|--type=*)
        if [[ "$1" == *=* ]]; then
          list_type="${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--type' 옵션 뒤에 조회 유형(all|catalogs|installers|commands|keys)을 지정하세요." "$LINENO" "list"
          list_type="$2"
          shift 2
        fi
        ;;
      --local)
        SOURCE_MODE="local"
        shift
        ;;
      --remote)
        SOURCE_MODE="remote"
        shift
        ;;
      --help)
        help "" "" "list"
        exit 0
        ;;
      *)
        error_exit "지원하지 않는 옵션입니다: $1" "$LINENO" "list"
        ;;
    esac
  done

  case "$list_type" in
    catalogs|all)
      load_catalogs_index
      echo_i "📦 [카탈로그(Catalog) 목록]"
      show_catalog_table
      ;;
  esac

  if [[ "$list_type" == "installers" || "$list_type" == "all" ]]; then
    echo_i "🛠️  [커스텀 인스톨러(Installers) 목록]"
    if _detect_local_repo && [[ -d "${LOCAL_REPO_ROOT}/env/installers" ]]; then
      local f bname
      for f in "${LOCAL_REPO_ROOT}/env/installers"/install-*.sh; do
        [[ -f "$f" ]] || continue
        bname="$(basename "$f")"
        bname="${bname#install-}"
        bname="${bname%.sh}"
        printf "  - %-24s (env/installers/%s)\n" "$bname" "$(basename "$f")"
      done
      printf "  - %-24s (docker/install-docker/install-docker)\n" "docker/install-docker"
    else
      echo "  - temurin-25-jdk           (env/installers/install-temurin-25-jdk.sh)"
      echo "  - update-java-config       (env/installers/install-update-java-config.sh)"
      echo "  - maven-3.9.15             (env/installers/install-maven-3.9.15.sh)"
      echo "  - update-mvn-config        (env/installers/install-update-mvn-config.sh)"
      echo "  - htop                     (env/installers/install-htop.sh)"
      echo "  - docker/install-docker    (docker/install-docker/install-docker)"
    fi
    echo
  fi

  if [[ "$list_type" == "commands" || "$list_type" == "all" ]]; then
    echo_i "⚡ [사후 실행 명령어(Commands) 목록]"
    if _detect_local_repo && [[ -d "${LOCAL_REPO_ROOT}/env/commands" ]]; then
      local f bname
      for f in "${LOCAL_REPO_ROOT}/env/commands"/*.sh; do
        [[ -f "$f" ]] || continue
        bname="$(basename "$f" .sh)"
        printf "  - %-28s (env/commands/%s)\n" "$bname" "$(basename "$f")"
      done
    else
      echo "  - firewall-cmd-set-priority    (env/commands/firewall-cmd-set-priority.sh)"
    fi
    echo
  fi

  if [[ "$list_type" == "keys" || "$list_type" == "all" ]]; then
    echo_i "🔑 [SSH RSA 공개키(Keys) 목록]"
    if _detect_local_repo && [[ -d "${LOCAL_REPO_ROOT}/env/keys" ]]; then
      local f bname
      for f in "${LOCAL_REPO_ROOT}/env/keys"/*.pub; do
        [[ -f "$f" ]] || continue
        bname="$(basename "$f" .pub)"
        printf "  - %-24s (env/keys/%s)\n" "$bname" "$(basename "$f")"
      done
    else
      echo "  - ymtech-internal          (env/keys/ymtech-internal.pub)"
      echo "  - letsencrypt              (env/keys/letsencrypt.pub)"
    fi
    echo
  fi

  if [[ "$list_type" != "catalogs" && "$list_type" != "installers" && "$list_type" != "commands" && "$list_type" != "keys" && "$list_type" != "all" ]]; then
    error_exit "알 수 없는 '--type' 값입니다: '$list_type' (허용값: all, catalogs, installers, commands, keys)" "$LINENO" "list"
  fi
}

##
# [info 서브커맨드] 특정 카탈로그(또는 복수 카탈로그)의 병합된 상세 구성 정보를 출력합니다.
#
# @param $@ {array} info 서브커맨드 인자
#
# @return 0
##
cmd_info() {
  local target_catalogs=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --catalog|--catalog=*)
        if [[ "$1" == *=* ]]; then
          target_catalogs+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--catalog' 옵션 뒤에 카탈로그 ID를 지정하세요." "$LINENO" "info"
          target_catalogs+=",${2}"
          shift 2
        fi
        ;;
      --local)
        SOURCE_MODE="local"
        shift
        ;;
      --remote)
        SOURCE_MODE="remote"
        shift
        ;;
      --help)
        help "" "" "info"
        exit 0
        ;;
      *)
        error_exit "지원하지 않는 옵션입니다: $1" "$LINENO" "info"
        ;;
    esac
  done

  if [[ -z "$target_catalogs" ]]; then
    error_exit "필수 파라미터 '--catalog <CATALOG_ID>'가 누락되었습니다." "$LINENO" "info"
  fi

  load_catalogs_index

  local -a cat_arr=()
  IFS=',' read -ra cat_arr <<< "$target_catalogs"
  local cid
  for cid in "${cat_arr[@]}"; do
    cid="$(echo "$cid" | xargs)"
    [[ -n "$cid" ]] && resolve_catalog "$cid"
  done

  echo
  echo "================================================================================"
  printf "📦 카탈로그 상세 정보 (적용 순서: %s)\n" "${TX_CATALOGS[*]}"
  for cid in "${TX_CATALOGS[@]}"; do
    if [[ -n "${CATALOG_TITLE[$cid]:-}" ]]; then
      printf "   - %-34s : %s\n" "$cid" "${CATALOG_DESC[$cid]:-}"
    fi
  done
  echo "================================================================================"
  printf " 🗑️  [삭제할 OS 패키지 (%d)]      : %s\n" "${#TX_REMOVE_PKGS[@]}" "${TX_REMOVE_PKGS[*]:-없음}"
  printf " 📥 [설치할 OS 패키지 (%d)]      : %s\n" "${#TX_INSTALL_PKGS[@]}" "${TX_INSTALL_PKGS[*]:-없음}"
  printf " 🔐 [Sudoers NOPASSWD (%d)]     : %s\n" "${#TX_SUDOERS_CMDS[@]}" "${TX_SUDOERS_CMDS[*]:-없음}"
  printf " 🚀 [커스텀 인스톨러 (%d)]       : %s\n" "${#TX_CUSTOM_INSTALLERS[@]}" "${TX_CUSTOM_INSTALLERS[*]:-없음}"
  printf " 🛠️  [커스텀 CLI 도구 (%d)]       :\n" "${#TX_CUSTOM_TOOLS[@]}"
  if (( ${#TX_CUSTOM_TOOLS[@]} == 0 )); then
    echo "      - 없음"
  else
    local t
    for t in "${TX_CUSTOM_TOOLS[@]}"; do
      printf "      - %-32s (-> %s)\n" "$t" "$(_resolve_tool_path "$t")"
    done
  fi
  printf " ⚡ [사후 실행 명령어 (%d)]      : %s\n" "${#TX_CUSTOM_COMMANDS[@]}" "${TX_CUSTOM_COMMANDS[*]:-없음}"
  printf " 🔑 [SSH RSA 공개키 (%d)]        : %s\n" "${#TX_SSH_KEYS[@]}" "${TX_SSH_KEYS[*]:-없음}"
  echo "================================================================================"
  echo
}

##
# 트랜잭션 실행 계획(Transaction Summary)을 화면에 출력합니다.
#
# @param $1 {string} 설치 범위 (local | global)
# @param $2 {string} sudoers 대상 계정
# @param $3 {number} 기본 환경 3종 활성화 여부 (1 | 0)
# @param $4 {string} 활성화된 단계 목록 문자열
#
# @return 요약표 출력
##
_print_transaction_summary() {
  local target_scope="$1"
  local sudo_user="$2"
  local run_default="$3"
  local active_steps=" $4 "

  echo
  echo "================================================================================"
  echo -e " 📋 ${COLOR_BOLD}[sciectl 트랜잭션 실행 계획 요약 (Transaction Summary)]${COLOR_NC}"
  echo "================================================================================"
  if (( ${#TX_CATALOGS[@]} > 0 )); then
    printf " 📦 적용 카탈로그       : %s\n" "${TX_CATALOGS[*]}"
  else
    printf " 📦 적용 카탈로그       : (개별 컴포넌트 직접 지정)\n"
  fi
  printf " 🎯 도구 설치 범위      : %s (%s)\n" "$target_scope" "$([[ "$target_scope" == "global" ]] && echo "/usr/local/bin" || echo "$HOME/bin")"
  echo "--------------------------------------------------------------------------------"

  if [[ "$active_steps" == *" sudoers "* ]] && (( ${#TX_SUDOERS_CMDS[@]} > 0 )); then
    printf " [Step 1] 🔐 Sudoers 등록 (%s) : %d개 명령어 병합\n" "$sudo_user" "${#TX_SUDOERS_CMDS[@]}"
  else
    printf " [Step 1] 🔐 Sudoers 등록        : 해당 없음 (건너뜀)\n"
  fi

  if [[ "$active_steps" == *" remove-packages "* ]] && (( ${#TX_REMOVE_PKGS[@]} > 0 )); then
    printf " [Step 2] 🗑️  OS 패키지 삭제      : %s\n" "${TX_REMOVE_PKGS[*]}"
  else
    printf " [Step 2] 🗑️  OS 패키지 삭제      : 해당 없음 (건너뜀)\n"
  fi

  if [[ "$active_steps" == *" install-packages "* ]] && (( ${#TX_INSTALL_PKGS[@]} > 0 )); then
    printf " [Step 3] 📥 OS 패키지 설치      : %s\n" "${TX_INSTALL_PKGS[*]}"
  else
    printf " [Step 3] 📥 OS 패키지 설치      : 해당 없음 (건너뜀)\n"
  fi

  if (( run_default == 1 )) && [[ "$active_steps" == *" default-opts "* ]]; then
    printf " [Step 4] ⚙️  기본 환경 3종 설정  : ~/bin PATH, git branch 프롬프트, vimrc 옵션\n"
  else
    printf " [Step 4] ⚙️  기본 환경 3종 설정  : 생략 (--no-default-opts)\n"
  fi

  if [[ "$active_steps" == *" custom-installers "* ]] && (( ${#TX_CUSTOM_INSTALLERS[@]} > 0 )); then
    printf " [Step 5] 🚀 커스텀 인스톨러 (%d) : %s\n" "${#TX_CUSTOM_INSTALLERS[@]}" "${TX_CUSTOM_INSTALLERS[*]}"
  else
    printf " [Step 5] 🚀 커스텀 인스톨러     : 해당 없음 (건너뜀)\n"
  fi

  if [[ "$active_steps" == *" custom-tools "* ]] && (( ${#TX_CUSTOM_TOOLS[@]} > 0 )); then
    printf " [Step 6] 🛠️  커스텀 CLI 도구 (%d): %s\n" "${#TX_CUSTOM_TOOLS[@]}" "${TX_CUSTOM_TOOLS[*]}"
  else
    printf " [Step 6] 🛠️  커스텀 CLI 도구    : 해당 없음 (건너뜀)\n"
  fi

  if [[ "$active_steps" == *" custom-commands "* ]] && (( ${#TX_CUSTOM_COMMANDS[@]} > 0 )); then
    printf " [Step 7] ⚡ 사후 실행 명령어 (%d): %s\n" "${#TX_CUSTOM_COMMANDS[@]}" "${TX_CUSTOM_COMMANDS[*]}"
  else
    printf " [Step 7] ⚡ 사후 실행 명령어    : 해당 없음 (건너뜀)\n"
  fi

  if [[ "$active_steps" == *" ssh-key "* ]] && (( ${#TX_SSH_KEYS[@]} > 0 )); then
    printf " [Step 8] 🔑 SSH 공개키 등록 (%d) : %s\n" "${#TX_SSH_KEYS[@]}" "${TX_SSH_KEYS[*]}"
  else
    printf " [Step 8] 🔑 SSH 공개키 등록     : 해당 없음 (건너뜀)\n"
  fi
  echo "================================================================================"
}

##
# [install 서브커맨드] 카탈로그 및 개별 컴포넌트를 트랜잭션 파이프라인으로 설치합니다.
#
# @param $@ {array} install 서브커맨드 인자
#
# @return 0
##
cmd_install() {
  local raw_catalogs=""
  local raw_tools=""
  local raw_installers=""
  local raw_commands=""
  local raw_ssh_keys=""
  local only_steps=""
  local skip_steps=""
  local target_user=""
  local target_scope="local"
  local auto_yes="false"
  local force_overwrite="false"
  local is_dry_run="false"
  local no_default_opts="false"
  local legacy_step_selected="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --catalog|--catalog=*)
        if [[ "$1" == *=* ]]; then
          raw_catalogs+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--catalog' 옵션 뒤에 카탈로그 ID를 지정하세요." "$LINENO" "install"
          raw_catalogs+=",${2}"
          shift 2
        fi
        ;;
      --tool|--tool=*)
        if [[ "$1" == *=* ]]; then
          raw_tools+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--tool' 옵션 뒤에 도구 식별자(예: git/git-commit)를 지정하세요." "$LINENO" "install"
          raw_tools+=",${2}"
          shift 2
        fi
        ;;
      --installer|--installer=*)
        if [[ "$1" == *=* ]]; then
          raw_installers+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--installer' 옵션 뒤에 인스톨러 식별자(예: temurin-25-jdk)를 지정하세요." "$LINENO" "install"
          raw_installers+=",${2}"
          shift 2
        fi
        ;;
      --command|--command=*)
        if [[ "$1" == *=* ]]; then
          raw_commands+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--command' 옵션 뒤에 명령어 식별자를 지정하세요." "$LINENO" "install"
          raw_commands+=",${2}"
          shift 2
        fi
        ;;
      --ssh-key|--ssh-key=*)
        if [[ "$1" == *=* ]]; then
          raw_ssh_keys+=",${1#*=}"
          shift
        else
          if [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]]; then
            raw_ssh_keys+=",${2}"
            shift 2
          else
            # 레거시 단독 플래그 호환 (--ssh-key)
            only_steps+=",ssh-key"
            legacy_step_selected="true"
            no_default_opts="true"
            shift
          fi
        fi
        ;;
      --only|--only=*)
        if [[ "$1" == *=* ]]; then
          only_steps+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--only' 옵션 뒤에 실행할 단계 목록을 지정하세요." "$LINENO" "install"
          only_steps+=",${2}"
          shift 2
        fi
        ;;
      --skip|--skip=*)
        if [[ "$1" == *=* ]]; then
          skip_steps+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--skip' 옵션 뒤에 제외할 단계 목록을 지정하세요." "$LINENO" "install"
          skip_steps+=",${2}"
          shift 2
        fi
        ;;
      --user|--user=*)
        if [[ "$1" == *=* ]]; then
          target_user="${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--user' 옵션 뒤에 사용자 계정명을 지정하세요." "$LINENO" "install"
          target_user="$2"
          shift 2
        fi
        ;;
      --target|--target=*)
        if [[ "$1" == *=* ]]; then
          target_scope="${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--target' 옵션 뒤에 local 또는 global을 지정하세요." "$LINENO" "install"
          target_scope="$2"
          shift 2
        fi
        ;;
      --local)
        SOURCE_MODE="local"
        shift
        ;;
      --remote)
        SOURCE_MODE="remote"
        shift
        ;;
      --yes)
        auto_yes="true"
        shift
        ;;
      --force)
        force_overwrite="true"
        shift
        ;;
      --dry-run)
        is_dry_run="true"
        shift
        ;;
      --all)
        only_steps=""
        no_default_opts="false"
        shift
        ;;
      --add-sudoers)
        only_steps+=",sudoers"
        legacy_step_selected="true"
        no_default_opts="true"
        shift
        ;;
      --remove-packages)
        only_steps+=",remove-packages"
        legacy_step_selected="true"
        no_default_opts="true"
        shift
        ;;
      --install-packages)
        only_steps+=",install-packages"
        legacy_step_selected="true"
        no_default_opts="true"
        shift
        ;;
      --custom-tools)
        only_steps+=",custom-tools"
        legacy_step_selected="true"
        no_default_opts="true"
        shift
        ;;
      --custom-installers)
        only_steps+=",custom-installers"
        legacy_step_selected="true"
        no_default_opts="true"
        shift
        ;;
      --custom-commands)
        only_steps+=",custom-commands"
        legacy_step_selected="true"
        no_default_opts="true"
        shift
        ;;
      --no-default-opts)
        no_default_opts="true"
        shift
        ;;
      --help)
        help "" "" "install"
        exit 0
        ;;
      *)
        error_exit "지원하지 않는 옵션입니다: $1" "$LINENO" "install"
        ;;
    esac
  done

  if [[ "$target_scope" != "local" && "$target_scope" != "global" ]]; then
    error_exit "'--target' 옵션 값은 'local' 또는 'global'만 허용됩니다: '$target_scope'" "$LINENO" "install"
  fi

  local has_direct_component="false"
  if [[ -n "$raw_tools" || -n "$raw_installers" || -n "$raw_commands" || -n "$raw_ssh_keys" ]]; then
    has_direct_component="true"
  fi

  # 1. 카탈로그 해석 (미지정 및 직접 컴포넌트도 없으면 대화형 카탈로그 선택)
  if [[ -n "$raw_catalogs" ]]; then
    load_catalogs_index
    local -a cat_list=()
    IFS=',' read -ra cat_list <<< "$raw_catalogs"
    local cid
    for cid in "${cat_list[@]}"; do
      cid="$(echo "$cid" | xargs)"
      [[ -n "$cid" ]] && resolve_catalog "$cid"
    done
  elif [[ "$has_direct_component" == "false" ]]; then
    if ! interactive_select_catalogs; then
      exit 0
    fi
  else
    no_default_opts="true"
  fi

  # 2. 직접 지정된 컴포넌트 병합
  _add_tx_items "tool"      "$raw_tools"
  _add_tx_items "installer" "$raw_installers"
  _add_tx_items "command"   "$raw_commands"
  _add_tx_items "ssh_key"   "$raw_ssh_keys"

  # 3. 대화형 모드에서 단계 필터(--only)가 지정되지 않았고 --yes도 아니면 단계 선택 메뉴 제공
  if [[ -z "$raw_catalogs" && "$has_direct_component" == "false" && -z "$only_steps" && "$auto_yes" == "false" ]]; then
    local -a avail_opts=()
    declare -A opt_desc=()
    if (( ${#TX_REMOVE_PKGS[@]} > 0 )); then
      avail_opts+=("remove-packages")
      opt_desc["remove-packages"]="사용하지 않을 OS 패키지를 삭제합니다. (${TX_REMOVE_PKGS[*]})"
    fi
    if (( ${#TX_SUDOERS_CMDS[@]} > 0 )); then
      avail_opts+=("sudoers")
      opt_desc["sudoers"]="특정 사용자를 'sudoers'에 추가합니다. (${#TX_SUDOERS_CMDS[@]}개 명령어)"
    fi
    if (( ${#TX_INSTALL_PKGS[@]} > 0 )); then
      avail_opts+=("install-packages")
      opt_desc["install-packages"]="기본 OS 패키지를 설치합니다. (${TX_INSTALL_PKGS[*]})"
    fi
    if (( ${#TX_CUSTOM_INSTALLERS[@]} > 0 )); then
      avail_opts+=("custom-installers")
      opt_desc["custom-installers"]="커스텀 설치 스크립트를 실행합니다. (${TX_CUSTOM_INSTALLERS[*]})"
    fi
    if (( ${#TX_CUSTOM_TOOLS[@]} > 0 )); then
      avail_opts+=("custom-tools")
      opt_desc["custom-tools"]="커스텀 CLI 도구 및 자동완성을 설치합니다. (${#TX_CUSTOM_TOOLS[@]}개 도구)"
    fi
    if (( ${#TX_CUSTOM_COMMANDS[@]} > 0 )); then
      avail_opts+=("custom-commands")
      opt_desc["custom-commands"]="사후 구성 명령어를 실행합니다. (${TX_CUSTOM_COMMANDS[*]})"
    fi
    if (( ${#TX_SSH_KEYS[@]} > 0 )); then
      avail_opts+=("ssh-key")
      opt_desc["ssh-key"]="SSH 접속용 RSA 공개키를 등록합니다. (${TX_SSH_KEYS[*]})"
    fi

    if (( ${#avail_opts[@]} == 0 )); then
      echo_w " - [💡] 선택한 카탈로그에 적용할 설치 항목이 없습니다."
      exit 0
    fi

    echo
    echo "================================================================================"
    echo_i "선택한 카탈로그에서 실행 가능한 단계는 다음과 같습니다."
    echo
    printf "  [ 0] %-20s : %s\n" "--all" "모든 단계 및 기본 환경 설정(~/bin, git 프롬프트, vimrc)을 일괄 적용합니다."
    local idx=1
    local st
    for st in "${avail_opts[@]}"; do
      printf "  [%2d] %-20s : %s\n" "$idx" "--${st}" "${opt_desc[$st]}"
      ((idx++))
    done
    echo "================================================================================"
    local step_input=""
    read -r -p "> 적용할 옵션 번호를 입력하세요 (기본값: 0 [전체], 복수 선택 시 띄어쓰기 구분): " step_input
    step_input="${step_input:-0}"

    local -a s_nums=()
    read -ra s_nums <<< "${step_input//,/ }"
    local n
    for n in "${s_nums[@]}"; do
      if [[ "$n" == "0" ]]; then
        only_steps=""
        no_default_opts="false"
        break
      elif [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#avail_opts[@]} )); then
        only_steps+=",${avail_opts[$((n - 1))]}"
        no_default_opts="true"
      fi
    done
  fi

  # 4. 활성화 단계 계산
  local -a all_step_names=("sudoers" "remove-packages" "install-packages" "default-opts" "custom-installers" "custom-tools" "custom-commands" "ssh-key")
  local active_steps_str=""

  if [[ -n "$only_steps" ]]; then
    no_default_opts="true"
    local -a o_arr=()
    IFS=',' read -ra o_arr <<< "$only_steps"
    local o
    for o in "${o_arr[@]}"; do
      o="$(echo "$o" | xargs)"
      [[ "$o" == "add-sudoers" ]] && o="sudoers"
      [[ "$o" == "default-opts" ]] && no_default_opts="false"
      active_steps_str+=" $o "
    done
  else
    active_steps_str=" ${all_step_names[*]} "
  fi

  if [[ -n "$skip_steps" ]]; then
    local -a sk_arr=()
    IFS=',' read -ra sk_arr <<< "$skip_steps"
    local sk
    for sk in "${sk_arr[@]}"; do
      sk="$(echo "$sk" | xargs)"
      [[ "$sk" == "add-sudoers" ]] && sk="sudoers"
      active_steps_str="${active_steps_str// $sk / }"
    done
  fi

  local run_default=1
  if [[ "$no_default_opts" == "true" || "$active_steps_str" != *" default-opts "* ]]; then
    run_default=0
  fi

  # 5. Sudoers 실행 대상인 경우 실행 전에 사용자 계정 사전 확정 (중간 멈춤 방지!)
  if [[ "$active_steps_str" == *" sudoers "* ]] && (( ${#TX_SUDOERS_CMDS[@]} > 0 )); then
    local current_user="${USER:-$(whoami)}"
    if [[ -z "$target_user" ]]; then
      if [[ "$auto_yes" == "true" || "$is_dry_run" == "true" || ! -t 0 ]]; then
        target_user="$current_user"
      else
        while true; do
          read -r -p "> [⌨️] sudoers에 등록할 사용자 계정을 입력하세요 (기본값: $current_user): " target_user
          target_user="${target_user:-$current_user}"
          if id "$target_user" &>/dev/null; then
            break
          else
            echo_w " - '$target_user' 사용자가 시스템에 존재하지 않습니다. 다시 입력해 주세요."
            target_user=""
          fi
        done
      fi
    else
      if ! id "$target_user" &>/dev/null && [[ "$is_dry_run" != "true" ]]; then
        error_exit "지정한 sudoers 대상 사용자('$target_user')가 시스템에 존재하지 않습니다." "$LINENO" "install"
      fi
    fi
  fi

  # 6. 트랜잭션 요약 출력 및 최종 1회 확인 (dnf/apt 스타일)
  _print_transaction_summary "$target_scope" "${target_user:-${USER:-$(whoami)}}" "$run_default" "$active_steps_str"

  if [[ "$is_dry_run" == "true" ]]; then
    echo_i "🔍 [--dry-run] 시뮬레이션 모드이므로 실제 설치를 수행하지 않고 종료합니다."
    rm -f -- "$NOTICE_MESSAGES_TEMP_FILE"
    exit 0
  fi

  if [[ "$auto_yes" != "true" && -t 0 ]]; then
    local confirm=""
    read -r -p "> 위 트랜잭션 계획대로 설치를 진행하시겠습니까? (y/n): " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
      echo_w " - [🛑] 사용자가 설치를 취소했습니다."
      rm -f -- "$NOTICE_MESSAGES_TEMP_FILE"
      exit 0
    fi
  fi

  local effective_force="$force_overwrite"
  if [[ "$auto_yes" == "true" ]]; then
    effective_force="true"
  fi

  # ==============================================================================
  # 7. 트랜잭션 일괄 실행 (엄격한 의존성 순서 보장)
  #    Step 1: sudoers
  #    Step 2: remove-packages
  #    Step 3: install-packages (vim 등 필수 OS 패키지 먼저 확보!)
  #    Step 4: default-opts (~/bin, git-prompt, vim 설치 후 vimrc 설정!)
  #    Step 5: custom-installers (JDK, Maven, Docker 등)
  #    Step 6: custom-tools (scriptctl 및 CLI 도구 + completion)
  #    Step 7: custom-commands (방화벽 정책 등 사후 구성)
  #    Step 8: ssh-key (authorized_keys 등록)
  # ==============================================================================
  if [[ "$active_steps_str" == *" sudoers "* ]]; then
    setup_sudoers "$target_user"
  fi

  if [[ "$active_steps_str" == *" remove-packages "* ]]; then
    remove_packages
  fi

  if [[ "$active_steps_str" == *" install-packages "* ]]; then
    install_packages
  fi

  if (( run_default == 1 )); then
    _setup_home_bin
    _setup_git_prompt
    _install_vim_options
  fi

  if [[ "$active_steps_str" == *" custom-installers "* ]]; then
    setup_custom_installers
  fi

  if [[ "$active_steps_str" == *" custom-tools "* ]]; then
    setup_custom_tools "$target_scope" "$effective_force"
  fi

  if [[ "$active_steps_str" == *" custom-commands "* ]]; then
    setup_custom_commands
  fi

  if [[ "$active_steps_str" == *" ssh-key "* ]]; then
    setup_ssh_key
  fi

  _announce_notices
  echo
  echo_i "✅ 모든 트랜잭션 작업이 완료되었습니다."
}

# ==============================================================================
# 메인 엔트리포인트 (Main Dispatcher)
# ==============================================================================
main() {
  if [[ $# -eq 0 ]]; then
    cmd_install
    exit 0
  fi

  case "$1" in
    install)
      shift
      cmd_install "$@"
      ;;
    list)
      shift
      cmd_list "$@"
      ;;
    info)
      shift
      cmd_info "$@"
      ;;
    --help)
      help "" "" ""
      exit 0
      ;;
    --*)
      # 서브커맨드 생략 후 바로 옵션(--catalog 등)을 입력한 경우 install로 위임
      cmd_install "$@"
      ;;
    *)
      error_exit "알 수 없는 명령어 또는 옵션입니다: '$1'" "$LINENO" ""
      ;;
  esac
}

main "$@"
exit 0
