def _split_csv_list(items: Optional[List[str]]) -> List[str]:
    result: List[str] = []
    if not items:
        return result
    for chunk in items:
        for part in chunk.split(","):
            s = part.strip()
            if s:
                result.append(s)
    return result


def _parse_with_long_options(
    args: Sequence[str],
    subcmd: str,
    configure_fn,
) -> argparse.Namespace:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--local", action="store_true")
    parser.add_argument("--remote", action="store_true")
    parser.add_argument("--no-update", action="store_true")
    parser.add_argument("--force-update", action="store_true")
    parser.add_argument("--version", action="store_true")
    parser.add_argument("--help", action="store_true")
    configure_fn(parser)

    try:
        ns, unknown = parser.parse_known_args(list(args))
    except SystemExit:
        error_exit("옵션 구문 오류가 발생했습니다.", subcmd=subcmd)
        raise

    if unknown:
        error_exit(f"지원하지 않는 옵션입니다: {' '.join(unknown)}", subcmd=subcmd)
    if getattr(ns, "version", False):
        print(f"{FILENAME} version {SCRIPT_FILE_VERSION}")
        sys.exit(0)
    if getattr(ns, "help", False):
        print_help(subcmd=subcmd)
        sys.exit(0)
    return ns


def _apply_source_mode(ctx: AppContext, ns: argparse.Namespace) -> None:
    if getattr(ns, "local", False):
        ctx.source_mode = "local"
    elif getattr(ns, "remote", False):
        ctx.source_mode = "remote"


def cmd_list(ctx: AppContext, args: Sequence[str]) -> None:
    def _cfg(p: argparse.ArgumentParser) -> None:
        p.add_argument("--type", dest="list_type", default="")
        p.add_argument("--installed", action="store_true")
        p.add_argument("--tool", action="append", default=[])
        p.add_argument("--ssh-key", dest="ssh_key", action="append", default=[])
        p.add_argument("--target", default="all")
        p.add_argument("--orderby", default="")

    ns = _parse_with_long_options(args, "list", _cfg)
    _apply_source_mode(ctx, ns)

    if ns.target not in ("all", "local", "global"):
        error_exit(f"'--target' 옵션 값은 'local' 또는 'global'만 허용됩니다: '{ns.target}'", subcmd="list")
    if ns.orderby and not ns.installed:
        error_exit("'--orderby' 옵션은 '--installed'와 함께만 사용할 수 있습니다.", subcmd="list")
    if (ns.tool or ns.ssh_key) and not ns.installed:
        error_exit("'--tool' 및 '--ssh-key' 필터는 '--installed'와 함께만 사용할 수 있습니다.", subcmd="list")

    if ns.installed:
        list_type = ns.list_type or "all"
        orderby = ns.orderby or "id"
        if list_type not in ("all", "tools", "tool", "keys", "key"):
            error_exit(f"'--installed'와 함께 사용할 수 없는 '--type' 값입니다: '{list_type}' (허용값: all, tools, keys)", subcmd="list")

        req_tools = _split_csv_list(ns.tool)
        req_keys = _split_csv_list(ns.ssh_key)
        has_filter = bool(req_tools or req_keys)

        matched: List[InstalledRecord] = []
        for rec in manifest_list_installed(ctx, ns.target):
            if list_type in ("tools", "tool") and rec.rec_type != "tool":
                continue
            if list_type in ("keys", "key") and rec.rec_type != "ssh-key":
                continue
            if has_filter:
                if rec.rec_type == "tool":
                    if not any(rec.rec_id == rt or rec.name == Path(rt).name for rt in req_tools):
                        continue
                elif rec.rec_type == "ssh-key":
                    if not any(rec.rec_id == rk for rk in req_keys):
                        continue
            matched.append(rec)

        if not matched:
            echo_w(" - [💡] 조건에 해당하는 설치된 도구 또는 등록된 SSH 공개키가 없습니다.")
            return

        sorted_recs = sort_installed_records(orderby, matched)
        rows = [
            (f"{idx:3d})", r.rec_type, r.rec_id, r.scope, r.version, r.updated_at, r.primary_path)
            for idx, r in enumerate(sorted_recs, start=1)
        ]
        print_dynamic_installed_table(f"📦 [설치된 관리 대상 현황 (총 {len(rows)}개)]", rows, stream=sys.stdout)
        return

    list_type = ns.list_type or "catalogs"
    valid_types = ("all", "catalogs", "tools", "tool", "installers", "commands", "keys")
    if list_type not in valid_types:
        error_exit(f"알 수 없는 '--type' 값입니다: '{list_type}' (허용값: all, catalogs, tools, installers, commands, keys)", subcmd="list")

    if list_type in ("catalogs", "all"):
        catalogs = load_catalogs_index(ctx)
        echo_i("📦 [카탈로그(Catalog) 목록]")
        show_catalog_table(catalogs)

    local_root = ctx.detect_local_repo(abort_on_missing=False)
    if list_type in ("tools", "tool", "all"):
        echo_i("🛠️  [커스텀 CLI 도구(Tools) 목록]")
        if local_root is not None:
            for tid in manifest_collect_known_tools(ctx):
                cat_name, tool_name = tid.split("/", 1)
                t_dir = local_root / cat_name / tool_name
                exec_name = tool_name if (t_dir / tool_name).is_file() else f"{tool_name}.sh"
                print(f"  - {tid:<32s} ({cat_name}/{tool_name}/{exec_name})")
        else:
            for tid, path_str in (
                ("utils/scriptctl", "utils/scriptctl/scriptctl"),
                ("sys/vim-cli", "sys/vim-cli/vim-cli"),
                ("sudo/sudoers-cli", "sudo/sudoers-cli/sudoers-cli"),
                ("git/git-commit", "git/git-commit/git-commit"),
                ("maven/build-mvn-package", "maven/build-mvn-package/build-mvn-package"),
                ("env/sciectl", "env/sciectl/sciectl"),
            ):
                print(f"  - {tid:<32s} ({path_str})")
        print()

    if list_type in ("installers", "all"):
        echo_i("🛠️  [소프트웨어 인스톨러(Installers) 목록]")
        if local_root is not None and (local_root / "env" / "installers").is_dir():
            for d in sorted((local_root / "env" / "installers").iterdir()):
                if not d.is_dir():
                    continue
                bname = d.name
                exec_name = bname if (d / bname).is_file() else (f"{bname}.sh" if (d / f"{bname}.sh").is_file() else "")
                if exec_name:
                    print(f"  - {bname:<28s} (env/installers/{bname}/{exec_name})")
            print(f"  - {'docker/install-docker':<28s} (docker/install-docker/install-docker)")
        else:
            for name, p in (
                ("install-temurin-25-jdk", "env/installers/install-temurin-25-jdk/install-temurin-25-jdk"),
                ("install-update-java-config", "env/installers/install-update-java-config/install-update-java-config"),
                ("install-maven-3.9.15", "env/installers/install-maven-3.9.15/install-maven-3.9.15"),
                ("install-update-mvn-config", "env/installers/install-update-mvn-config/install-update-mvn-config"),
                ("install-htop", "env/installers/install-htop/install-htop"),
                ("docker/install-docker", "docker/install-docker/install-docker"),
            ):
                print(f"  - {name:<28s} ({p})")
        print()

    if list_type in ("commands", "all"):
        echo_i("⚡ [사후 실행 명령어(Commands) 목록]")
        if local_root is not None and (local_root / "env" / "commands").is_dir():
            for d in sorted((local_root / "env" / "commands").iterdir()):
                if not d.is_dir():
                    continue
                bname = d.name
                exec_name = bname if (d / bname).is_file() else (f"{bname}.sh" if (d / f"{bname}.sh").is_file() else "")
                if exec_name:
                    print(f"  - {bname:<28s} (env/commands/{bname}/{exec_name})")
        else:
            print("  - firewall-cmd-set-priority    (env/commands/firewall-cmd-set-priority/firewall-cmd-set-priority)")
        print()

    if list_type in ("keys", "all"):
        echo_i("🔑 [SSH RSA 공개키(Keys) 목록]")
        for k in manifest_collect_known_keys(ctx):
            print(f"  - {k:<24s} (env/keys/{k}/{k}.pub)")
        print()


def _resolve_component_readme_rel(ctx: AppContext, comp_type: str, item: str) -> str:
    if comp_type == "tool":
        if "/" in item:
            return f"{item}/README.md"
        if item == "sciectl":
            return "env/sciectl/README.md"
        local_root = ctx.detect_local_repo(abort_on_missing=False)
        if local_root is not None:
            for c_dir in local_root.iterdir():
                if c_dir.is_dir() and (c_dir / item).is_dir():
                    return f"{c_dir.name}/{item}/README.md"
        return f"{item}/README.md"
    if comp_type == "installer":
        return f"{Path(resolve_installer_path(ctx, item)).parent}/README.md"
    if comp_type == "command":
        return f"{Path(resolve_command_path(ctx, item)).parent}/README.md"
    if comp_type == "ssh-key":
        base = item[:-4] if item.endswith(".pub") else item
        return f"env/keys/{base}/README.md"
    return ""


def _extract_readme_summary(ctx: AppContext, readme_rel: str) -> str:
    data, _ = ctx.fetch_bytes(readme_rel)
    if data is None:
        return "설명이 제공되지 않습니다."
    in_body = False
    parts: List[str] = []
    for raw_line in data.decode("utf-8", errors="replace").splitlines():
        if raw_line.startswith("#"):
            continue
        if not raw_line.strip():
            if in_body:
                break
            continue
        if raw_line.startswith("---"):
            break
        in_body = True
        parts.append(raw_line)
    return " ".join(parts) if parts else "설명이 제공되지 않습니다."


def _print_component_info(ctx: AppContext, comp_type: str, item: str) -> None:
    if comp_type == "tool":
        emoji = "🚀"
        disp_name = Path(item).name
    elif comp_type == "installer":
        emoji = "🚀"
        disp_name = Path(resolve_installer_path(ctx, item)).parent.name
    elif comp_type == "command":
        emoji = "⚡"
        disp_name = Path(resolve_command_path(ctx, item)).parent.name
    elif comp_type == "ssh-key":
        emoji = "🔑"
        disp_name = item[:-4] if item.endswith(".pub") else item
    else:
        return

    readme_rel = _resolve_component_readme_rel(ctx, comp_type, item)
    readme_url = f"{REPO_WEB_BASE_URL}/{readme_rel}"
    summary = _extract_readme_summary(ctx, readme_rel)
    print(f"- [{emoji} {disp_name}]")
    print(f"  - 설명 : {summary}")
    print(f"  - 문서 : {readme_url}")

    if comp_type in ("tool", "ssh-key"):
        matches: List[str] = []
        for rec in manifest_list_installed(ctx, "all"):
            if comp_type == "tool" and rec.rec_type == "tool":
                if rec.rec_id == item or rec.name == disp_name:
                    matches.append(f"{rec.scope}, v{rec.version or 'unknown'}, {rec.primary_path}")
            elif comp_type == "ssh-key" and rec.rec_type == "ssh-key":
                if rec.rec_id == disp_name:
                    matches.append(f"{rec.scope}, {rec.primary_path}")
        if matches:
            for m in matches:
                print(f"  - 설치 : ✅ 설치됨 ({m})")
        else:
            print("  - 설치 : ❌ 미설치")


def cmd_info(ctx: AppContext, args: Sequence[str]) -> None:
    def _cfg(p: argparse.ArgumentParser) -> None:
        p.add_argument("--catalog", action="append", default=[])
        p.add_argument("--tool", action="append", default=[])
        p.add_argument("--installer", action="append", default=[])
        p.add_argument("--command", action="append", default=[])
        p.add_argument("--ssh-key", dest="ssh_key", action="append", default=[])

    ns = _parse_with_long_options(args, "info", _cfg)
    _apply_source_mode(ctx, ns)

    cat_list = _split_csv_list(ns.catalog)
    tool_list = _split_csv_list(ns.tool)
    inst_list = _split_csv_list(ns.installer)
    cmd_list_vals = _split_csv_list(ns.command)
