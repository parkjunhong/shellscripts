def check_records_update_status(
    ctx: AppContext,
    records: List[InstalledRecord],
) -> Tuple[bool, Dict[str, UpdateCheckResult]]:
    """ThreadPoolExecutor + Keep-Alive 커넥션으로 설치 레코드의 원격 최신 버전을 병렬 확인합니다."""
    results: Dict[str, UpdateCheckResult] = {}
    if not records:
        return True, results

    if not ctx.check_remote_reachable():
        for rec in records:
            results[rec.meta_file] = UpdateCheckResult(status="unknown", fail_reason="Offline")
        return False, results

    if ctx.source_mode != "local" and ctx.detect_local_repo(abort_on_missing=False) is None:
        ctx.resolve_remote_cache_token()

    total_cnt = len(records)
    start_ts = time.monotonic()
    if not sys.stderr.isatty():
        print(f" - [🔍] 원격 저장소 최신 버전 확인 중... (총 {total_cnt}개)", file=sys.stderr)
    else:
        ACTIVE_SPINNER.start(f"원격 저장소 최신 버전 확인 중 (총 {total_cnt}개)")

    completed = 0
    progress_lock = threading.Lock()

    def _check_one(rec: InstalledRecord) -> Tuple[str, UpdateCheckResult]:
        nonlocal completed
        try:
            if rec.rec_type == "tool":
                resolved_ref = resolve_tool_path(rec.rec_id)
                data, err = ctx.fetch_bytes(resolved_ref)
                if data is None:
                    return rec.meta_file, UpdateCheckResult(status="unknown", fail_reason=err or "Fetch Error")
                local_ver = "" if rec.version == "unknown" else rec.version
                remote_ver = extract_script_version_from_text(data.decode("utf-8", errors="replace"))
                try:
                    same_bytes = Path(rec.primary_path).read_bytes() == data
                except OSError:
                    same_bytes = False

                if not local_ver:
                    status = "updatable" if (remote_ver or not same_bytes) else "up-to-date"
                elif remote_ver:
                    if is_newer_version(local_ver, remote_ver):
                        status = "updatable"
                    elif local_ver == remote_ver and not same_bytes:
                        status = "updatable"
                    else:
                        status = "up-to-date"
                else:
                    status = "up-to-date"
                return rec.meta_file, UpdateCheckResult(status=status, remote_ver=remote_ver)

            if rec.rec_type == "ssh-key":
                new_pub = resolve_ssh_key_content(ctx, rec.rec_id)
                if not new_pub:
                    return rec.meta_file, UpdateCheckResult(status="unknown", fail_reason="Key Fetch Error")
                parts = new_pub.split()
                new_body = parts[1] if len(parts) >= 2 else ""
                new_comment = " ".join(parts[2:]) if len(parts) >= 3 else ""
                status = "updatable" if (new_body and rec.key_body != new_body) else "up-to-date"
                return rec.meta_file, UpdateCheckResult(status=status, remote_ver=new_comment or "ssh-rsa")

            return rec.meta_file, UpdateCheckResult(status="up-to-date")
        finally:
            with progress_lock:
                completed += 1
                pct = int(completed * 100 / total_cnt)
                ACTIVE_SPINNER.update_progress(f"{completed}/{total_cnt}, {pct}%")

    max_workers = min(8, max(1, total_cnt))
    with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as executor:
        futures = [executor.submit(_check_one, rec) for rec in records]
        for fut in concurrent.futures.as_completed(futures):
            meta_key, chk_res = fut.result()
            results[meta_key] = chk_res

    elapsed = int(time.monotonic() - start_ts)
    ACTIVE_SPINNER.stop_line(clear_only=True)
    echo_i(f" - [✅] 총 {total_cnt}개 항목 최신 버전 확인 완료 ({elapsed}s)", file=sys.stderr)
    return True, results


def sort_installed_records(orderby: str, records: List[InstalledRecord]) -> List[InstalledRecord]:
    if orderby in ("id", "id/asc"):
        return sorted(records, key=lambda r: (r.rec_type, r.rec_id))
    if orderby == "id/desc":
        return sorted(records, key=lambda r: (r.rec_type, r.rec_id), reverse=False) if False else sorted(
            sorted(records, key=lambda r: r.rec_id, reverse=True),
            key=lambda r: r.rec_type,
        )
    if orderby in ("time", "time/asc"):
        return sorted(records, key=lambda r: (r.rec_type, r.updated_at, r.rec_id))
    if orderby == "time/desc":
        return sorted(
            sorted(records, key=lambda r: (r.updated_at, r.rec_id), reverse=True),
            key=lambda r: r.rec_type,
        )
    error_exit(f"지원하지 않는 '--orderby' 값입니다: '{orderby}' (허용값: id, id/asc, id/desc, time, time/asc, time/desc)", subcmd="list")
    return records


def print_dynamic_installed_table(
    title: str,
    rows: List[Tuple[str, str, str, str, str, str, str]],
    stream=None,
) -> None:
    out = stream if stream is not None else sys.stdout
    w_no = max([4] + [get_display_width(r[0]) for r in rows])
    w_type = max([4] + [get_display_width(r[1]) for r in rows])
    w_id = max([10] + [get_display_width(r[2]) for r in rows])
    w_scope = max([5] + [get_display_width(r[3]) for r in rows])
    w_ver = max([15] + [get_display_width(r[4]) for r in rows])
    w_time = max([19] + [get_display_width(r[5]) for r in rows])
    w_path = max([4] + [get_display_width(r[6]) for r in rows])

    total_w = max(80, 2 + w_no + 3 + w_type + 3 + w_id + 3 + w_scope + 3 + w_ver + 3 + w_time + 3 + w_path + 2)
    eq_line = "=" * total_w
    dash_line = "-" * total_w
    is_tty = out.isatty() if hasattr(out, "isatty") else False
    c_info = "\033[1;32m" if is_tty else ""
    c_nc = "\033[0m" if is_tty else ""

    print(file=out)
    print(eq_line, file=out)
    print(f"{c_info}{title}{c_nc}", file=out)
    print(dash_line, file=out)
    print(
        f"  {pad_string('No.', w_no)} | {pad_string('Type', w_type)} | {pad_string('Identifier', w_id)} | "
        f"{pad_string('Scope', w_scope)} | {pad_string('Version/Comment', w_ver)} | {pad_string('Updated At', w_time)} | Path",
        file=out,
    )
    print(dash_line, file=out)
    for r in rows:
        print(
            f"  {pad_string(r[0], w_no)} | {pad_string(r[1], w_type)} | {pad_string(r[2], w_id)} | "
            f"{pad_string(r[3], w_scope)} | {pad_string(r[4], w_ver)} | {pad_string(r[5], w_time)} | {r[6]}",
            file=out,
        )
    print(eq_line, file=out)


