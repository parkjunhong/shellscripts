def remove_packages(ctx: AppContext, plan: TransactionPlan) -> None:
    if not plan.remove_pkgs:
        return
    func_name = "remove_packages"
    if func_name in ctx.executed_job_flags:
        return
    pm = ctx.detect_pkg_manager()
    print()
    print(f"############### {func_name} ###############")

    installed_targets: List[str] = []
    for pkg in plan.remove_pkgs:
        if ctx.is_package_installed(pkg):
            installed_targets.append(pkg)
        else:
            echo_w(f" - '{pkg}' 패키지가 시스템에 존재하지 않아 제거를 건너뜁니다.")

    if installed_targets:
        print(f"[✨] 불필요 패키지 제거 중: {' '.join(installed_targets)}")
        if subprocess.run([*pm.remove_cmd, *installed_targets], shell=False, check=False).returncode != 0:
            for pkg in installed_targets:
                if subprocess.run([*pm.remove_cmd, pkg], shell=False, check=False).returncode != 0:
                    _add_notice(f" - [{func_name}] [ERROR] '{pkg}' 패키지 제거 실패")
        else:
            echo_i(f" - 패키지 제거 완료: {' '.join(installed_targets)}")
    ctx.executed_job_flags.add(func_name)


def install_packages(ctx: AppContext, plan: TransactionPlan) -> None:
    if not plan.install_pkgs:
        return
    func_name = "install_packages"
    if func_name in ctx.executed_job_flags:
        return
    pm = ctx.detect_pkg_manager()
    print()
    print(f"############### {func_name} ###############")

    missing_pkgs: List[str] = []
    for pkg in plan.install_pkgs:
        if pm.name == "brew" and pkg in ("firewalld", "net-tools", "ufw"):
            echo_w(f" - '{pkg}' 패키지는 macOS 환경에서 지원하지 않아 설치를 건너뜁니다.")
            continue
        if ctx.is_package_installed(pkg):
            echo_w(f" - '{pkg}' 패키지가 이미 설치되어 있습니다.")
        else:
            missing_pkgs.append(pkg)

    if missing_pkgs:
        _try_pkg_update(ctx)
        print(f"[✨] 미설치 패키지 일괄 설치 중 ({len(missing_pkgs)}개): {' '.join(missing_pkgs)}")
        if subprocess.run([*pm.install_cmd, *missing_pkgs], shell=False, check=False).returncode == 0:
            echo_i(f" - 패키지 일괄 설치가 완료되었습니다: {' '.join(missing_pkgs)}")
        else:
            echo_w(" - 일괄 설치 중 일부 오류가 발생하여 개별 설치로 재시도합니다...")
            for pkg in missing_pkgs:
                if not ctx.is_package_installed(pkg):
                    if subprocess.run([*pm.install_cmd, pkg], shell=False, check=False).returncode == 0:
                        echo_i(f" - '{pkg}' 설치 완료")
                    else:
                        echo_e(f" - [ERROR] '{pkg}' 패키지 설치 실패")
                        _add_notice(f" - [{func_name}] [ERROR] '{pkg}' 패키지 설치 실패 (수동 확인 필요)")
    ctx.executed_job_flags.add(func_name)


def setup_sudoers(ctx: AppContext, plan: TransactionPlan, target_user: str) -> int:
    if not plan.sudoers_cmds:
        return 0
    func_name = "setup_sudoers"
    if func_name in ctx.executed_job_flags:
        return 0

    if TARGET_OS == "darwin":
        print()
        print(f"############### {func_name} ({target_user}) ###############")
        echo_w(" - [💡] macOS 환경에서는 sudoers NOPASSWD 자동 등록을 건너뜁니다.")
        ctx.executed_job_flags.add(func_name)
        return 0

    pm = ctx.detect_pkg_manager()
    print()
    print(f"############### {func_name} ({target_user}) ###############")
    print(f"[✨] 사용자 '{target_user}' sudoers 설정 병합 중...")

    sudoers_file = Path(f"/etc/sudoers.d/user-{target_user}")
    all_cmds: List[str] = []
    if pm.name == "apt":
        all_cmds.extend(["/usr/bin/apt", "/usr/bin/apt-get"])
    elif pm.name == "dnf":
        all_cmds.append("/usr/bin/dnf")
    elif pm.name == "pacman":
        all_cmds.append("/usr/bin/pacman")

    if run_cmd(["sudo", "test", "-f", str(sudoers_file)]).returncode == 0:
        grep_res = run_cmd(["sudo", "grep", "NOPASSWD:", str(sudoers_file)])
        if grep_res.returncode == 0 and grep_res.stdout:
            for ln in grep_res.stdout.splitlines():
                if "NOPASSWD:" in ln:
                    cmds_part = ln.split("NOPASSWD:", 1)[1]
                    for c in cmds_part.split(","):
                        if c.strip():
                            all_cmds.append(c.strip())

    for nc in plan.sudoers_cmds:
        if nc.strip():
            all_cmds.append(nc.strip())

    sorted_cmds = sorted(set(all_cmds))
    lines = [f"{target_user} ALL=(ALL) ALL"]
    if sorted_cmds:
        lines.append(f"{target_user} ALL=(ALL) NOPASSWD: {', '.join(sorted_cmds)}")
    content = "\n".join(lines) + "\n"

    with tempfile.NamedTemporaryFile("w", encoding="utf-8", prefix="sudoers.", delete=False) as tf:
        tf.write(content)
        tmp_sudoers = Path(tf.name)

    if run_cmd(["sudo", "visudo", "-c", "-f", str(tmp_sudoers)]).returncode == 0:
        subprocess.run(["sudo", "tee", str(sudoers_file)], input=content, text=True, stdout=subprocess.DEVNULL, check=False)
        run_cmd(["sudo", "chmod", "440", str(sudoers_file)])
        tmp_sudoers.unlink(missing_ok=True)
        echo_i(f" - [🛠️] '{target_user}' sudoers 설정이 안전하게 병합 및 적용되었습니다. ({sudoers_file})")
        ctx.executed_job_flags.add(func_name)
        return 0

    tmp_sudoers.unlink(missing_ok=True)
    echo_e(" - [❌] 'sudoers' 문법 검증(visudo)에 실패하여 설정을 취소합니다.")
    _add_notice(f" - [{func_name}] [❌] 'sudoers' 문법 검증 실패로 설정 취소")
    return 1


def _remove_legacy_sh_tool(legacy_cmd: str, bin_dir: Path) -> None:
    if not legacy_cmd:
        return
    legacy_script = bin_dir / legacy_cmd
    has_legacy_script = legacy_script.is_file() or legacy_script.is_symlink()

    comp_dirs: List[Path] = []
    if TARGET_OS == "darwin" and shutil.which("brew"):
        bp = (run_cmd(["brew", "--prefix"], timeout=5).stdout or "").strip()
        if bp:
            for sub in ("etc/bash_completion.d", "share/bash-completion/completions"):
                if (Path(bp) / sub).is_dir():
                    comp_dirs.append(Path(bp) / sub)
        if (Path.home() / ".bash_completion.d").is_dir():
            comp_dirs.append(Path.home() / ".bash_completion.d")
    for p in (Path("/usr/share/bash-completion/completions"), Path("/etc/bash_completion.d")):
        if p.is_dir():
            comp_dirs.append(p)

    legacy_comp_files: List[Path] = []
    for d in comp_dirs:
        for cand in (d / legacy_cmd, d / f"{legacy_cmd}.completion"):
            if cand.is_file() or cand.is_symlink():
                legacy_comp_files.append(cand)

    if not has_legacy_script and not legacy_comp_files:
        return

    if has_legacy_script:
        try:
            legacy_script.unlink()
            echo_i(f" - [🗑️] '{legacy_cmd}' 구버전 실행 파일을 정리했습니다. ({legacy_script})")
        except OSError:
            if run_cmd(["sudo", "rm", "-f", "--", str(legacy_script)]).returncode == 0:
                echo_i(f" - [🗑️] '{legacy_cmd}' 구버전 실행 파일을 정리했습니다. ({legacy_script})")

    for cf in legacy_comp_files:
        if run_cmd(["sudo", "rm", "-f", "--", str(cf)]).returncode == 0:
            echo_i(f" - [🗑️] '{legacy_cmd}' 구버전 자동완성 파일을 정리했습니다. ({cf})")


def install_completion(
    ctx: AppContext,
    comp_ref: str,
    target_cmd: str,
    force_overwrite: bool = False,
    quiet: bool = False,
) -> str:
    """Bash Completion 파일을 시스템 표준 경로에 설치합니다."""
    if TARGET_OS == "darwin":
        comp_dir: Optional[Path] = None
        if shutil.which("brew"):
            bp = (run_cmd(["brew", "--prefix"], timeout=5).stdout or "").strip()
            if bp:
                if (Path(bp) / "etc" / "bash_completion.d").is_dir():
                    comp_dir = Path(bp) / "etc" / "bash_completion.d"
                elif (Path(bp) / "share" / "bash-completion" / "completions").is_dir():
                    comp_dir = Path(bp) / "share" / "bash-completion" / "completions"
        if comp_dir is None:
            comp_dir = Path.home() / ".bash_completion.d"
            comp_dir.mkdir(parents=True, exist_ok=True)
    else:
        comp_dir_str = ""
        if shutil.which("pkg-config"):
            comp_dir_str = (run_cmd(["pkg-config", "--variable=completionsdir", "bash-completion"], timeout=3).stdout or "").strip()
        if not comp_dir_str and Path("/usr/share/bash-completion/completions").is_dir():
            comp_dir_str = "/usr/share/bash-completion/completions"
        elif not comp_dir_str and Path("/etc/bash_completion.d").is_dir():
            comp_dir_str = "/etc/bash_completion.d"
        if not comp_dir_str:
            comp_dir_str = "/etc/bash_completion.d"
            run_cmd(["sudo", "mkdir", "-p", comp_dir_str])
        comp_dir = Path(comp_dir_str)

    data, _ = ctx.fetch_bytes(comp_ref)
    if data is None:
        return ""

    if "/etc/bash_completion.d" in str(comp_dir) or str(Path.home() / ".bash_completion.d") in str(comp_dir):
        target_comp_file = comp_dir / f"{target_cmd}.completion"
    else:
        target_comp_file = comp_dir / target_cmd

    use_sudo = not os.access(comp_dir, os.W_OK)
    with tempfile.NamedTemporaryFile("wb", prefix=f"{target_cmd}.comp.", delete=False) as tf:
        tf.write(data)
        temp_comp = Path(tf.name)

    if target_comp_file.is_file():
        try:
            same = target_comp_file.read_bytes() == data
        except OSError:
            same = False
        if not same:
            do_update = force_overwrite or not sys.stdin.isatty()
            if not do_update:
                do_update = _prompt_yes_no(f"> '{target_cmd} completion' 내용이 다릅니다. 업데이트하시겠습니까? (y/Enter: 취소): ")
            if do_update:
                _atomic_move_file(temp_comp, target_comp_file, use_sudo=use_sudo, mode="644")
                if not quiet:
                    echo_i(f" - '{target_cmd} completion' 파일이 업데이트되었습니다. ({target_comp_file})")
            else:
                if not quiet:
                    echo_w(f" - '{target_cmd} completion' 기존 파일을 유지합니다 (업데이트 취소).")
                temp_comp.unlink(missing_ok=True)
        else:
            if not quiet:
                echo_w(f" - '{target_cmd} completion' 파일이 이미 최신입니다.")
            temp_comp.unlink(missing_ok=True)
    else:
        _atomic_move_file(temp_comp, target_comp_file, use_sudo=use_sudo, mode="644")
        if not quiet:
            echo_i(f" - '{target_cmd} completion' 파일을 설치했습니다. ({target_comp_file})")

    return str(target_comp_file) if target_comp_file.is_file() else ""


def install_manpages(
    ctx: AppContext,
    resolved_ref: str,
    target_cmd: str,
    scope: str = "local",
    force_overwrite: bool = False,
    quiet: bool = False,
) -> str:
    """도구의 연관 man 페이지 파일들을 시스템 표준 man 경로에 설치합니다."""
    if resolved_ref.startswith(("https://", "http://")):
        return ""
    tool_dir = str(Path(resolved_ref).parent)
    if not tool_dir or tool_dir == ".":
        return ""

    if scope == "local":
        man_base_dir = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share")) / "man"
    else:
        man_base_dir = Path("/usr/local/share/man")
        if TARGET_OS == "darwin" and shutil.which("brew"):
            bp = (run_cmd(["brew", "--prefix"], timeout=5).stdout or "").strip()
            if bp and (Path(bp) / "share" / "man").is_dir():
                man_base_dir = Path(bp) / "share" / "man"

    man_rel_list: List[str] = []
    local_root = ctx.detect_local_repo(abort_on_missing=False)
    if local_root is not None and (local_root / tool_dir / "man").is_dir():
        for p in sorted((local_root / tool_dir / "man").rglob("*")):
            if p.is_file() and re.search(r"\.[1-8]$", p.name):
                man_rel_list.append(str(p.relative_to(local_root)))
    else:
        man_rel_list.append(f"{tool_dir}/man/man1/{target_cmd}.1")
        if target_cmd == "sshctl":
            man_rel_list.extend([f"{tool_dir}/man/man5/sshctl.conf.5", f"{tool_dir}/man/man7/sshctl-security.7"])
        elif target_cmd == "sciectl":
            man_rel_list.append(f"{tool_dir}/man/man5/sciectl-catalog.5")

    any_installed = False
    need_sudo_man = False
    recorded: List[str] = []

    for man_rel in man_rel_list:
        data, _ = ctx.fetch_bytes(man_rel)
        if data is None:
            continue
        man_bname = Path(man_rel).name
        man_sec = man_bname.rsplit(".", 1)[-1]
        man_sec_dir = man_base_dir / f"man{man_sec}"
        target_man_file = man_sec_dir / man_bname

        check_dir = man_sec_dir
        while not check_dir.exists() and check_dir != check_dir.parent:
            check_dir = check_dir.parent
        writable = os.access(check_dir, os.W_OK) and (not target_man_file.exists() or os.access(target_man_file, os.W_OK))
        use_sudo = not writable
        if use_sudo:
            need_sudo_man = True

        with tempfile.NamedTemporaryFile("wb", prefix=f"{man_bname}.", delete=False) as tf:
            tf.write(data)
            temp_man = Path(tf.name)

        if target_man_file.is_file():
            try:
                same = target_man_file.read_bytes() == data
            except OSError:
                same = False
            if not same:
                do_update = force_overwrite or not sys.stdin.isatty()
                if not do_update:
                    do_update = _prompt_yes_no(f"> '{man_bname} man page' 내용이 다릅니다. 업데이트하시겠습니까? (y/Enter: 취소): ")
                if do_update:
                    _atomic_move_file(temp_man, target_man_file, use_sudo=use_sudo, mode="644")
                    if not quiet:
                        echo_i(f" - '{man_bname} man page' 파일이 업데이트되었습니다. ({target_man_file})")
                    any_installed = True
                else:
                    if not quiet:
                        echo_w(f" - '{man_bname} man page' 기존 파일을 유지합니다 (업데이트 취소).")
                    temp_man.unlink(missing_ok=True)
            else:
                if not quiet:
                    echo_w(f" - '{man_bname} man page' 파일이 이미 최신입니다.")
                temp_man.unlink(missing_ok=True)
        else:
            _atomic_move_file(temp_man, target_man_file, use_sudo=use_sudo, mode="644")
            if not quiet:
                echo_i(f" - '{man_bname} man page' 파일을 설치했습니다. ({target_man_file})")
            any_installed = True

        if target_man_file.is_file():
            recorded.append(str(target_man_file))

    if scope == "local" and man_base_dir.is_dir():
        user_share_man = Path.home() / "share" / "man"
        try:
            if not user_share_man.exists() and not user_share_man.is_symlink():
                (Path.home() / "share").mkdir(parents=True, exist_ok=True)
                user_share_man.symlink_to(man_base_dir)
                if not quiet:
                    echo_i(f" - Man Page 호환 경로 링크를 생성했습니다. ({user_share_man} -> {man_base_dir})")
            elif user_share_man.is_symlink():
                user_share_man.unlink()
                user_share_man.symlink_to(man_base_dir)
        except OSError:
            pass

    if any_installed and shutil.which("mandb"):
        if need_sudo_man:
            run_cmd(["sudo", "mandb", "-q"], timeout=15)
        else:
            run_cmd(["mandb", "-q", str(man_base_dir)], timeout=15)

    return ":".join(recorded)


def install_tool(
    ctx: AppContext,
    raw_id: str,
    target_scope: str = "local",
    force_overwrite: bool = False,
    auto_yes: bool = False,
) -> None:
    """단일 커스텀 도구 및 연관 .completion, man 페이지 파일을 설치합니다."""
    func_name = "_install_tool"
    resolved_ref = resolve_tool_path(raw_id)
    target_cmd = Path(resolved_ref).name

    print()
    print(f"############### {func_name} - {target_cmd} ###############")
    print(f"[✨] '{target_cmd}' 설치 중... ({resolved_ref})")

    use_sudo = target_scope == "global"
    bin_dir = Path("/usr/local/bin") if use_sudo else (Path.home() / "bin")

    data, _ = ctx.fetch_bytes(resolved_ref, show_progress=True)
    if data is None:
        echo_e(f" - [❌] '{target_cmd}' 도구 파일을 가져올 수 없어 설치를 생략합니다. ({resolved_ref})")
        _add_notice(f" - [{func_name}] [❌] '{target_cmd}' 다운로드 실패 ({resolved_ref})")
        return

    with tempfile.NamedTemporaryFile("wb", prefix=f"{target_cmd}.", delete=False) as tf:
        tf.write(data)
        temp_bin = Path(tf.name)

    if use_sudo:
        run_cmd(["sudo", "mkdir", "-p", str(bin_dir)])
    else:
        bin_dir.mkdir(parents=True, exist_ok=True)

    dest_bin = bin_dir / target_cmd
    sync_companions = True

    if dest_bin.is_file():
        try:
            same = dest_bin.read_bytes() == data
        except OSError:
            same = False
        if not same:
            local_ver = extract_script_version(dest_bin)
            remote_ver = extract_script_version_from_text(data.decode("utf-8", errors="replace"))
            should_update = False
            ask_confirm = False
            prompt_msg = f"> '{target_cmd}' 실행 파일 내용이 다릅니다. 업데이트하시겠습니까? (y/Enter: 취소): "

            if force_overwrite:
                should_update = True
            elif local_ver and remote_ver:
                if is_newer_version(local_ver, remote_ver):
                    should_update = True
                    prompt_msg = f"> '{target_cmd}' 새 버전이 있습니다 (v{local_ver} -> v{remote_ver}). 업데이트하시겠습니까? (y/Enter: 취소): "
                elif local_ver == remote_ver:
                    if not auto_yes and sys.stdin.isatty():
                        should_update = True
                        ask_confirm = True
                        prompt_msg = f"> '{target_cmd}' 버전은 동일(v{local_ver})하지만 파일 내용이 다릅니다. 업데이트하시겠습니까? (y/Enter: 취소): "
                    else:
                        echo_w(f" - '{target_cmd}' 동일 버전(v{local_ver})이나 파일 내용이 다릅니다. '--force' 미지정으로 기존 파일을 유지합니다.")
                        sync_companions = False
                        temp_bin.unlink(missing_ok=True)
                else:
                    echo_w(f" - '{target_cmd}' 로컬 버전(v{local_ver})이 설치 대상(v{remote_ver})보다 최신이므로 유지합니다.")
                    sync_companions = False
                    temp_bin.unlink(missing_ok=True)
            elif not local_ver and remote_ver:
                should_update = True
                prompt_msg = f"> '{target_cmd}' 버전 정보가 포함된 최신 버전(v{remote_ver})으로 업데이트하시겠습니까? (y/Enter: 취소): "
            elif local_ver and not remote_ver:
                echo_w(f" - '{target_cmd}' 로컬 버전(v{local_ver})을 유지합니다 (설치 대상에 버전 정보 없음).")
                sync_companions = False
                temp_bin.unlink(missing_ok=True)
            else:
                should_update = True

            if should_update:
                confirmed = True
                if not force_overwrite and (ask_confirm or (not auto_yes and sys.stdin.isatty())):
                    confirmed = _prompt_yes_no(prompt_msg)
                if confirmed:
                    _atomic_move_file(temp_bin, dest_bin, use_sudo=use_sudo, mode="755")
                    if local_ver and remote_ver:
                        echo_i(f" - '{target_cmd}' 실행 파일이 업데이트되었습니다 (v{local_ver} -> v{remote_ver}). ({dest_bin})")
                    elif remote_ver:
                        echo_i(f" - '{target_cmd}' 실행 파일이 업데이트되었습니다 (v{remote_ver}). ({dest_bin})")
                    else:
                        echo_i(f" - '{target_cmd}' 실행 파일이 업데이트되었습니다. ({dest_bin})")
                else:
                    echo_w(f" - '{target_cmd}' 기존 실행 파일을 유지합니다 (업데이트 취소).")
                    sync_companions = False
                    temp_bin.unlink(missing_ok=True)
        else:
            echo_w(f" - '{target_cmd}' 실행 파일이 이미 최신입니다.")
            temp_bin.unlink(missing_ok=True)
    else:
        _atomic_move_file(temp_bin, dest_bin, use_sudo=use_sudo, mode="755")
        echo_i(f" - '{target_cmd}' 실행 파일을 설치했습니다. ({dest_bin})")

    comp_path = ""
    man_paths = ""
    if sync_companions:
        comp_force = force_overwrite or auto_yes
        comp_path = install_completion(ctx, f"{resolved_ref}.completion", target_cmd, force_overwrite=comp_force)
        man_paths = install_manpages(ctx, resolved_ref, target_cmd, scope=target_scope, force_overwrite=comp_force)

    if not target_cmd.endswith(".sh"):
        _remove_legacy_sh_tool(f"{target_cmd}.sh", bin_dir)

    if dest_bin.is_file():
        installed_ver = extract_script_version(dest_bin)
        if not sync_companions:
            comp_path, man_paths = manifest_discover_companions(target_cmd, target_scope)
        meta_tool_id = raw_id
        if not resolved_ref.startswith(("https://", "http://")):
            meta_tool_id = str(Path(resolved_ref).parent)
        manifest_save_tool(meta_tool_id, target_cmd, target_scope, installed_ver, str(dest_bin), comp_path, man_paths)


def setup_tools(ctx: AppContext, plan: TransactionPlan, target_scope: str, force_overwrite: bool, auto_yes: bool) -> None:
    if not plan.tools:
        return
    if "setup_tools" in ctx.executed_job_flags:
        return
    for t in plan.tools:
        if t:
            install_tool(ctx, t, target_scope=target_scope, force_overwrite=force_overwrite, auto_yes=auto_yes)
    ctx.executed_job_flags.add("setup_tools")


def _build_bash_env_helper() -> str:
    """하위 Bash 인스톨러/커맨드 스크립트용 export -f 호환 BASH_ENV 헬퍼 스크립트를 반환합니다."""
    return """
if [[ -t 1 ]]; then
  COLOR_ERROR='\\033[1;31m'
  COLOR_WARN='\\033[1;33m'
  COLOR_INFO='\\033[1;32m'
  COLOR_NC='\\033[0m'
else
  COLOR_ERROR=''
  COLOR_WARN=''
  COLOR_INFO=''
  COLOR_NC=''
fi
echo_e() { printf "${COLOR_ERROR}%s${COLOR_NC}\\n" "$*"; }
echo_w() { printf "${COLOR_WARN}%s${COLOR_NC}\\n" "$*"; }
echo_i() { printf "${COLOR_INFO}%s${COLOR_NC}\\n" "$*"; }
_add_notice() {
  local msg="${1:-}"
  local forced="${2:-true}"
  [[ -n "$msg" && -n "${NOTICE_MESSAGES_TEMP_FILE:-}" ]] || return 0
  if [[ "$forced" == "false" ]] && grep -Fxq "$msg" "$NOTICE_MESSAGES_TEMP_FILE" 2>/dev/null; then
    return 0
  fi
  echo "$msg" >> "$NOTICE_MESSAGES_TEMP_FILE"
}
error_exit() {
  echo_e "[ERROR] ${1:-알 수 없는 오류} (line: ${2:-unknown})" >&2
  exit 1
}
"""


def execute_script(ctx: AppContext, script_ref: str) -> int:
    """원격 또는 로컬 인스톨러/커맨드 Bash 스크립트를 BASH_ENV 브리지와 함께 안전하게 실행합니다."""
    func_name = "_execute_script"
    target_cmd = Path(script_ref).name
    ref_hash = hashlib.md5(script_ref.encode("utf-8")).hexdigest()
    job_flag = f"{func_name}-{ref_hash}"
    if job_flag in ctx.executed_job_flags:
        return 0

    print()
    print(f"############### {func_name} - {target_cmd} ###############")
    print(f"[✨] '{target_cmd}' 실행 준비 중... ({script_ref})")

    if script_ref.startswith("http://"):
        echo_e(f" - [❌] 평문 HTTP URL은 허용되지 않습니다 (HTTPS만 허용): {script_ref}")
        _add_notice(f" - [{func_name}] [❌] 보안 정책 위반 (HTTP URL 차단): {script_ref}")
        return 1

    data, _ = ctx.fetch_bytes(script_ref)
    if data is None:
        echo_e(f" - [❌] '{target_cmd}' 스크립트를 가져올 수 없어 실행을 생략합니다. ({script_ref})")
        _add_notice(f" - [{func_name}] [❌] '{target_cmd}' 스크립트 로드 실패 ({script_ref})")
        return 0

    if not data:
        echo_e(f" - [❌] 로드된 스크립트 파일이 비어 있습니다: {target_cmd}")
        return 1

    temp_script = Path(f"/tmp/sciectl_exec_{ref_hash}.sh")
    temp_helper = Path(f"/tmp/sciectl_helper_{os.getpid()}.sh")
    try:
        temp_script.unlink(missing_ok=True)
        temp_script.write_bytes(data)
        if temp_script.is_symlink():
            echo_e(f" - [❌] 심볼릭 링크 공격이 감지되어 실행을 중단합니다: {temp_script}")
            temp_script.unlink(missing_ok=True)
            return 1

        if shutil.which("file"):
            ftype = (run_cmd(["file", "-b", str(temp_script)], timeout=5).stdout or "").lower()
            if "shell script" not in ftype and "text" not in ftype:
                echo_e(f" - [❌] 파일이 유효한 쉘 스크립트가 아닙니다 ({ftype.strip()}): {target_cmd}")
                temp_script.unlink(missing_ok=True)
                return 1

        os.chmod(temp_script, 0o700)
        temp_helper.write_text(_build_bash_env_helper(), encoding="utf-8")
        os.chmod(temp_helper, 0o600)

        echo_i(f" - '{target_cmd}' 실행 중...")
        sub_env = os.environ.copy()
        sub_env["BASH_ENV"] = str(temp_helper)
        sub_env["NOTICE_MESSAGES_TEMP_FILE"] = str(NOTICE_MESSAGES_TEMP_FILE)
        res = subprocess.run(["/bin/bash", str(temp_script)], shell=False, env=sub_env, check=False)
        if res.returncode != 0:
            echo_e(f" - [❌] '{target_cmd}' 실행 실패 (exit code: {res.returncode})")
            _add_notice(f" - [{func_name}] [❌] '{target_cmd}' 실행 실패 (exit code: {res.returncode})")
            return 1

        echo_i(f" - [🛠️] '{target_cmd}' 실행이 완료되었습니다.")
        ctx.executed_job_flags.add(job_flag)
        return 0
    finally:
        temp_script.unlink(missing_ok=True)
        temp_helper.unlink(missing_ok=True)


def setup_installers(ctx: AppContext, plan: TransactionPlan) -> None:
    if not plan.installers or "setup_installers" in ctx.executed_job_flags:
        return
    for inst_id in plan.installers:
        if inst_id:
            execute_script(ctx, resolve_installer_path(ctx, inst_id))
    ctx.executed_job_flags.add("setup_installers")


def setup_commands(ctx: AppContext, plan: TransactionPlan) -> None:
    if not plan.commands or "setup_commands" in ctx.executed_job_flags:
        return
    for cmd_id in plan.commands:
        if cmd_id:
            execute_script(ctx, resolve_command_path(ctx, cmd_id))
    ctx.executed_job_flags.add("setup_commands")


def setup_ssh_key(ctx: AppContext, plan: TransactionPlan) -> None:
    if not plan.ssh_keys or "setup_ssh_key" in ctx.executed_job_flags:
        return
    print()
    print("############### setup_ssh_key ###############")
    print("[✨] SSH RSA 공개키 등록 중...")
    ssh_dir = Path.home() / ".ssh"
    auth_file = ssh_dir / "authorized_keys"
    ssh_dir.mkdir(parents=True, exist_ok=True)
    os.chmod(ssh_dir, 0o700)
    auth_file.touch(exist_ok=True)
    os.chmod(auth_file, 0o600)

    auth_text = auth_file.read_text(encoding="utf-8", errors="replace")
    for key_id in plan.ssh_keys:
        public_key = resolve_ssh_key_content(ctx, key_id)
        if not public_key:
            echo_e(f" - [❌] SSH 공개키('{key_id}')를 불러올 수 없어 생략합니다.")
            _add_notice(f" - [setup_ssh_key] [❌] SSH 공개키('{key_id}') 로드 실패")
            continue
        parts = public_key.split()
        key_body = parts[1] if len(parts) >= 2 else ""
        key_comment = " ".join(parts[2:]) if len(parts) >= 3 else ""
        disp = key_comment or f"{public_key[:30]}..."
        if key_body and key_body not in auth_text:
            with auth_file.open("a", encoding="utf-8") as fp:
                fp.write(public_key + "\n")
            auth_text += public_key + "\n"
            echo_i(f" - [💡] 공개키를 등록했습니다: {key_id} ({disp})")
        else:
            echo_w(f" - [⚠️] 이미 등록된 공개키입니다: {key_id} ({disp})")
        if key_body:
            manifest_save_key(key_id, key_body, key_comment, auth_file)
    os.chmod(auth_file, 0o600)
    ctx.executed_job_flags.add("setup_ssh_key")


