def _normalize_step_name(step: str) -> str:
    aliases = {
        "add-sudoers": "sudoers",
        "custom-tools": "tools",
        "custom-installers": "installers",
        "custom-commands": "commands",
    }
    return aliases.get(step, step)


def cmd_install(ctx: AppContext, args: Sequence[str]) -> None:
    def _cfg(p: argparse.ArgumentParser) -> None:
        p.add_argument("--catalog", action="append", default=[])
        p.add_argument("--tool", action="append", default=[])
        p.add_argument("--installer", action="append", default=[])
        p.add_argument("--command", action="append", default=[])
        p.add_argument("--ssh-key", dest="ssh_key", nargs="?", const="__LEGACY_SSH_FLAG__", action="append", default=[])
        p.add_argument("--only", action="append", default=[])
        p.add_argument("--skip", action="append", default=[])
        p.add_argument("--user", default="")
        p.add_argument("--target", default="local")
        p.add_argument("--yes", action="store_true")
        p.add_argument("--force", action="store_true")
        p.add_argument("--dry-run", dest="dry_run", action="store_true")
        p.add_argument("--all", dest="select_all", action="store_true")
        p.add_argument("--no-default-opts", dest="no_default_opts", action="store_true")
        p.add_argument("--add-sudoers", action="store_true")
        p.add_argument("--remove-packages", action="store_true")
        p.add_argument("--install-packages", action="store_true")
        p.add_argument("--custom-tools", action="store_true")
        p.add_argument("--custom-installers", action="store_true")
        p.add_argument("--custom-commands", action="store_true")

    ns = _parse_with_long_options(args, "install", _cfg)
    _apply_source_mode(ctx, ns)

    if ns.target not in ("local", "global"):
        error_exit(f"'--target' 옵션 값은 'local' 또는 'global'만 허용됩니다: '{ns.target}'", subcmd="install")

    ssh_key_vals: List[str] = []
    only_steps_list = _split_csv_list(ns.only)
    no_default_opts = ns.no_default_opts

    for sk_item in ns.ssh_key:
        if sk_item == "__LEGACY_SSH_FLAG__":
            only_steps_list.append("ssh-key")
            no_default_opts = True
        else:
            ssh_key_vals.append(sk_item)

    for flag, step_name in (
        (ns.add_sudoers, "sudoers"),
        (ns.remove_packages, "remove-packages"),
        (ns.install_packages, "install-packages"),
        (ns.custom_tools, "tools"),
        (ns.custom_installers, "installers"),
        (ns.custom_commands, "commands"),
    ):
        if flag:
            only_steps_list.append(step_name)
            no_default_opts = True

    if ns.select_all:
        only_steps_list = []
        no_default_opts = False

    cat_ids = _split_csv_list(ns.catalog)
    tool_vals = _split_csv_list(ns.tool)
    inst_vals = _split_csv_list(ns.installer)
    cmd_vals = _split_csv_list(ns.command)
    key_vals = _split_csv_list(ssh_key_vals)
    has_direct = bool(tool_vals or inst_vals or cmd_vals or key_vals)

    plan = TransactionPlan()
    if cat_ids:
        catalogs = load_catalogs_index(ctx)
        for cid in cat_ids:
            resolve_catalog(ctx, catalogs, plan, cid)
    elif not has_direct:
        if not _interactive_select_catalogs(ctx, plan):
            return
    else:
        no_default_opts = True

    add_tx_items(plan, "tool", ",".join(tool_vals))
    add_tx_items(plan, "installer", ",".join(inst_vals))
    add_tx_items(plan, "command", ",".join(cmd_vals))
    add_tx_items(plan, "ssh_key", ",".join(key_vals))

    if not cat_ids and not has_direct and not only_steps_list and not ns.yes:
        avail_opts: List[Tuple[str, str]] = []
        if plan.remove_pkgs:
            avail_opts.append(("remove-packages", f"사용하지 않을 OS 패키지를 삭제합니다. ({' '.join(plan.remove_pkgs)})"))
        if plan.sudoers_cmds:
            avail_opts.append(("sudoers", f"특정 사용자를 'sudoers'에 추가합니다. ({len(plan.sudoers_cmds)}개 명령어)"))
        if plan.install_pkgs:
            avail_opts.append(("install-packages", f"기본 OS 패키지를 설치합니다. ({' '.join(plan.install_pkgs)})"))
        if plan.installers:
            avail_opts.append(("installers", f"소프트웨어 인스톨러 스크립트를 실행합니다. ({' '.join(plan.installers)})"))
        if plan.tools:
            avail_opts.append(("tools", f"CLI 도구 및 자동완성을 설치합니다. ({len(plan.tools)}개 도구)"))
        if plan.commands:
            avail_opts.append(("commands", f"사후 구성 명령어를 실행합니다. ({' '.join(plan.commands)})"))
        if plan.ssh_keys:
            avail_opts.append(("ssh-key", f"SSH 접속용 RSA 공개키를 등록합니다. ({' '.join(plan.ssh_keys)})"))

        if not avail_opts:
            echo_w(" - [💡] 선택한 카탈로그에 적용할 설치 항목이 없습니다.")
            return

        print()
        print("=" * 80)
        echo_i("선택한 카탈로그에서 실행 가능한 단계는 다음과 같습니다.")
        print()
        print(f"  [ 0] {'--all':<20s} : 모든 단계 및 기본 환경 설정(~/bin, git 프롬프트, vimrc)을 일괄 적용합니다.")
        for idx, (sname, sdesc) in enumerate(avail_opts, start=1):
            print(f"  [{idx:2d}] {('--' + sname):<20s} : {sdesc}")
        print("=" * 80)
        try:
            step_input = input("> 적용할 옵션 번호를 입력하세요 (기본값: 0 [전체], 복수 선택 시 띄어쓰기 구분): ").strip() or "0"
        except (EOFError, KeyboardInterrupt):
            print()
            return
        for tok in step_input.replace(",", " ").split():
            if tok == "0":
                only_steps_list = []
                no_default_opts = False
                break
            if tok.isdigit() and 1 <= int(tok) <= len(avail_opts):
                only_steps_list.append(avail_opts[int(tok) - 1][0])
                no_default_opts = True

    all_steps = ["sudoers", "remove-packages", "install-packages", "default-opts", "installers", "tools", "commands", "ssh-key"]
    if only_steps_list:
        no_default_opts = True
        active_steps: Set[str] = set()
        for o in only_steps_list:
            norm = _normalize_step_name(o)
            if norm == "default-opts":
                no_default_opts = False
            active_steps.add(norm)
    else:
        active_steps = set(all_steps)

    for sk in _split_csv_list(ns.skip):
        active_steps.discard(_normalize_step_name(sk))

    run_default = (not no_default_opts) and ("default-opts" in active_steps)
    current_user = os.environ.get("USER") or pwd.getpwuid(os.getuid()).pw_name
    target_user = ns.user

    if TARGET_OS != "darwin" and "sudoers" in active_steps and plan.sudoers_cmds:
        if not target_user:
            if ns.yes or ns.dry_run or not sys.stdin.isatty():
                target_user = current_user
            else:
                while True:
                    try:
                        entered = input(f"> [⌨️] sudoers에 등록할 사용자 계정을 입력하세요 (기본값: {current_user}): ").strip()
                    except (EOFError, KeyboardInterrupt):
                        print()
                        return
                    cand = entered or current_user
                    try:
                        pwd.getpwnam(cand)
                        target_user = cand
                        break
                    except KeyError:
                        echo_w(f" - '{cand}' 사용자가 시스템에 존재하지 않습니다. 다시 입력해 주세요.")
        else:
            if not ns.dry_run:
                try:
                    pwd.getpwnam(target_user)
                except KeyError:
                    error_exit(f"지정한 sudoers 대상 사용자('{target_user}')가 시스템에 존재하지 않습니다.", subcmd="install")

    _print_transaction_summary(ctx, plan, ns.target, target_user or current_user, run_default, active_steps)
    if ns.dry_run:
        echo_i("🔍 [--dry-run] 시뮬레이션 모드이므로 실제 설치를 수행하지 않고 종료합니다.")
        return

    if not ns.yes and sys.stdin.isatty():
        if not _prompt_yes_no("> 위 트랜잭션 계획대로 설치를 진행하시겠습니까? (y/Enter: 취소): "):
            echo_w(" - [🛑] 사용자가 설치를 취소했습니다.")
            return

    if "sudoers" in active_steps:
        setup_sudoers(ctx, plan, target_user or current_user)
    if "remove-packages" in active_steps:
        remove_packages(ctx, plan)
    if "install-packages" in active_steps:
        install_packages(ctx, plan)
    if run_default:
        _setup_home_bin(ctx)
        _setup_git_prompt(ctx)
        _install_vim_options(ctx)
    if "installers" in active_steps:
        setup_installers(ctx, plan)
    if "tools" in active_steps:
        setup_tools(ctx, plan, ns.target, ns.force, ns.yes)
    if "commands" in active_steps:
        setup_commands(ctx, plan)
    if "ssh-key" in active_steps:
        setup_ssh_key(ctx, plan)

    _announce_notices()
    print()
    echo_i("✅ 모든 트랜잭션 작업이 완료되었습니다.")


def _get_completion_cache_dir() -> Path:
    cache_dir = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "sciectl"
    try:
        cache_dir.mkdir(parents=True, exist_ok=True)
        return cache_dir
    except OSError:
        fallback = Path(f"/tmp/.sciectl_cache_{os.geteuid()}")
        fallback.mkdir(parents=True, exist_ok=True)
        return fallback


def cmd_refresh(ctx: AppContext, args: Sequence[str]) -> None:
    ns = _parse_with_long_options(args, "refresh", lambda _p: None)
    _apply_source_mode(ctx, ns)

    cache_dir = _get_completion_cache_dir()
    (cache_dir / ".refresh.lock").unlink(missing_ok=True)

    if ctx.source_mode != "local" and ctx.detect_local_repo(abort_on_missing=False) is None:
        if not ctx.check_remote_reachable():
            error_exit(f"원격 저장소에 연결할 수 없어 캐시를 최신화할 수 없습니다 ({ctx.last_fetch_error or 'Connection Error'}).", subcmd="refresh")
        ctx.resolve_remote_cache_token()

    print(f"🔄 [sciectl] 자동완성 캐시 최신화 중... ({cache_dir})")
    ini_data, ini_err = ctx.fetch_bytes("env/catalogs/catalogs.ini")
    if ini_data is None:
        error_exit(f"catalogs.ini를 가져오지 못했습니다 ({ini_err or 'Error'}).", subcmd="refresh")
        return

    ini_tmp = cache_dir / f"catalogs.ini.tmp.{os.getpid()}"
    ini_file = cache_dir / "catalogs.ini"
    ini_tmp.write_bytes(ini_data)
    os.replace(ini_tmp, ini_file)

    cat_files: List[str] = []
    cat_ids: List[str] = []
    for raw_line in ini_data.decode("utf-8", errors="replace").splitlines():
        line = raw_line.strip()
        m_sec = re.match(r"^\[([a-zA-Z0-9_-]+)\]", line)
        if m_sec:
            cat_ids.append(m_sec.group(1))
        elif line.startswith("catalog_file") and "=" in line:
            cf = line.split("=", 1)[1].strip()
            if cf:
                cat_files.append(cf)
    if not cat_files:
        cat_files = [f"{cid}.catalog" for cid in cat_ids]

    total = len(cat_files)
    ACTIVE_SPINNER.start(f"자동완성 카탈로그 캐시 갱신 중 (총 {total}개)")
    fail_cnt = 0

    def _fetch_cat(cf: str) -> bool:
        data, _ = ctx.fetch_bytes(f"env/catalogs/{cf}")
        if data is None or not data:
            return False
        tmp_cf = cache_dir / f"{cf}.tmp.{os.getpid()}"
        tmp_cf.write_bytes(data)
        os.replace(tmp_cf, cache_dir / cf)
        return True

    with concurrent.futures.ThreadPoolExecutor(max_workers=min(8, max(1, total))) as executor:
        for ok in executor.map(_fetch_cat, cat_files):
            if not ok:
                fail_cnt += 1

    ACTIVE_SPINNER.stop_line(clear_only=True)
    ok_cnt = total - fail_cnt
    if fail_cnt > 0:
        echo_w(f"⚠️  [sciectl] 자동완성 캐시 갱신 완료 (성공: {ok_cnt}/{total}개, 실패: {fail_cnt}개) - 경로: {cache_dir}")
    else:
        echo_i(f"✅ [sciectl] 자동완성 캐시 최신화 완료 (총 {ok_cnt}개 카탈로그) - 경로: {cache_dir}")


