##
# README.md 파일에서 첫 번째 본문 문단(개요 설명)을 추출합니다.
#
# @param $1 {string} 저장소 기준 README 상대 경로
#
# @return 개요 설명 문자열 (없을 시 안내문 반환)
##
_extract_readme_summary() {
  local readme_rel="$1"
  local tmp_file
  tmp_file="$(mktemp /tmp/sciectl_readme.XXXXXX)"

  if _fetch_resource "$readme_rel" "$tmp_file" 2>/dev/null; then
    local summary
    summary="$(awk '
      BEGIN { in_body = 0 }
      /^#/ { next }
      /^[[:space:]]*$/ {
        if (in_body) exit
        next
      }
      /^---/ { exit }
      {
        in_body = 1
        if (body != "") body = body " " $0
        else body = $0
      }
      END { print body }
    ' "$tmp_file")"
    rm -f -- "$tmp_file"
    if [[ -n "$summary" ]]; then
      printf '%s\n' "$summary"
      return 0
    fi
  fi
  rm -f -- "$tmp_file"
  printf '%s\n' "설명이 제공되지 않습니다."
}

##
# 특정 컴포넌트(도구, 인스톨러, 명령어, SSH 공개키)의 상대 README.md 파일 경로를 반환합니다.
#
# @param $1 {string} 컴포넌트 종류 (tool | installer | command | ssh-key)
# @param $2 {string} 컴포넌트 식별자
#
# @return 상대 경로 (예: env/installers/install-htop/README.md)
##
_resolve_component_readme_rel() {
  local comp_type="$1"
  local item="$2"

  case "$comp_type" in
    tool)
      if [[ "$item" == *"/"* ]]; then
        printf '%s/README.md\n' "$item"
      elif [[ "$item" == "sciectl" ]]; then
        printf '%s\n' "env/sciectl/README.md"
      else
        local found_dir=""
        if _detect_local_repo; then
          local cand
          cand="$(find "${LOCAL_REPO_ROOT}" -mindepth 2 -maxdepth 2 -type d -name "$item" 2>/dev/null | head -n 1)"
          if [[ -n "$cand" ]]; then
            found_dir="${cand#${LOCAL_REPO_ROOT}/}"
          fi
        fi
        if [[ -n "$found_dir" ]]; then
          printf '%s/README.md\n' "$found_dir"
        else
          printf '%s/README.md\n' "$item"
        fi
      fi
      ;;
    installer)
      local file_loc
      file_loc="$(_resolve_installer_path "$item")"
      printf '%s/README.md\n' "$(dirname "$file_loc")"
      ;;
    command)
      local file_loc
      file_loc="$(_resolve_command_path "$item")"
      printf '%s/README.md\n' "$(dirname "$file_loc")"
      ;;
    ssh-key)
      local base="${item%.pub}"
      printf 'env/keys/%s/README.md\n' "$base"
      ;;
    *)
      return 1
      ;;
  esac
}

##
# 특정 컴포넌트의 GitHub README.md 웹 URL을 반환합니다.
#
# @param $1 {string} 컴포넌트 종류 (tool | installer | command | ssh-key)
# @param $2 {string} 컴포넌트 식별자
#
# @return README.md URL 출력
##
_resolve_component_readme_url() {
  local comp_type="$1"
  local item="$2"
  local readme_rel
  readme_rel="$(_resolve_component_readme_rel "$comp_type" "$item")" || return 1
  printf '%s/%s\n' "$REPO_WEB_BASE_URL" "$readme_rel"
}

##
# 특정 컴포넌트(도구, 인스톨러, 명령어, SSH 공개키)의 상세 정보를 출력합니다.
#
# @param $1 {string} 컴포넌트 종류 (tool | installer | command | ssh-key)
# @param $2 {string} 컴포넌트 식별자
#
# @return 0
##
_print_component_info() {
  local comp_type="$1"
  local item="$2"
  local emoji=""
  local disp_name=""

  case "$comp_type" in
    tool)
      emoji="🚀"
      disp_name="$(basename "$item")"
      ;;
    installer)
      emoji="🚀"
      local file_loc="$(_resolve_installer_path "$item")"
      disp_name="$(basename "$(dirname "$file_loc")")"
      ;;
    command)
      emoji="⚡"
      local file_loc="$(_resolve_command_path "$item")"
      disp_name="$(basename "$(dirname "$file_loc")")"
      ;;
    ssh-key)
      emoji="🔑"
      disp_name="${item%.pub}"
      ;;
    *)
      return 1
      ;;
  esac

  local readme_rel
  readme_rel="$(_resolve_component_readme_rel "$comp_type" "$item")"
  local readme_url
  readme_url="$(_resolve_component_readme_url "$comp_type" "$item")"

  local summary
  summary="$(_extract_readme_summary "$readme_rel")"

  echo "- [${emoji} ${disp_name}]"
  echo "  - 설명 : ${summary}"
  echo "  - 문서 : ${readme_url}"

  if [[ "$comp_type" == "tool" || "$comp_type" == "ssh-key" ]]; then
    local -a inst_matches=()
    local irec itype iid iname iscope iver ipath imeta
    while IFS= read -r irec; do
      [[ -n "$irec" ]] || continue
      IFS='|' read -r itype iid iname iscope iver ipath imeta <<< "$irec"
      if [[ "$comp_type" == "tool" && "$itype" == "tool" ]]; then
        if [[ "$iid" == "$item" || "$iname" == "$disp_name" ]]; then
          inst_matches+=("${iscope}, v${iver:-unknown}, ${ipath}")
        fi
      elif [[ "$comp_type" == "ssh-key" && "$itype" == "ssh-key" ]]; then
        if [[ "$iid" == "$disp_name" ]]; then
          inst_matches+=("${iscope}, ${ipath}")
        fi
      fi
    done < <(_manifest_list_installed "all")

    if (( ${#inst_matches[@]} > 0 )); then
      local m
      for m in "${inst_matches[@]}"; do
        echo "  - 설치 : ✅ 설치됨 (${m})"
      done
    else
      echo "  - 설치 : ❌ 미설치"
    fi
  fi
}

##
# [list 서브커맨드] 카탈로그, 도구, 인스톨러, 커맨드, SSH 공개키 목록을 출력합니다.
#
# @param $@ {array} list 서브커맨드 인자
#
# @return 0
##
##
# 현재 시스템에 설치된 도구 및 등록된 SSH 공개키 목록을 테이블로 출력합니다.
#
# @param $1 {string} 조회 대상 유형 (all | tools | keys)
# @param $2 {string} 범위 필터 (all | local | global)
#
# @return 0
##
declare -A REC_UPDATE_STATUS=()
declare -A REC_REMOTE_VER=()
REMOTE_AVAILABLE=1

##
# 설치된 레코드 배열의 각 항목에 대해 저장소 최신 버전과 비교하여 업데이트 가능 여부를 판별합니다.
# (네트워크 단절 시 REMOTE_AVAILABLE=0으로 설정하고 즉시 오프라인 폴백합니다.)
#
# @param $@ {array} 파이프 구분 레코드 목록
#
# @return 전역 변수 REMOTE_AVAILABLE, REC_UPDATE_STATUS, REC_REMOTE_VER 설정
##
_check_records_update_status() {
  REC_UPDATE_STATUS=()
  REC_REMOTE_VER=()
  REMOTE_AVAILABLE=1

  local -a recs=("$@")
  (( ${#recs[@]} > 0 )) || return 0

  if ! _check_remote_reachable; then
    REMOTE_AVAILABLE=0
    local r r_type r_id r_name r_scope r_ver r_path r_meta
    for r in "${recs[@]}"; do
      IFS='|' read -r r_type r_id r_name r_scope r_ver r_path r_meta <<< "$r"
      REC_UPDATE_STATUS["$r_meta"]="unknown"
      REC_REMOTE_VER["$r_meta"]=""
    done
    return 1
  fi

  local tmp_dir
  tmp_dir="$(mktemp -d "/tmp/sciectl_chk.XXXXXX")"

  local total_cnt="${#recs[@]}"
  local start_ts
  start_ts="$(date +%s)"

  if [[ ! -t 2 ]]; then
    echo " - [🔍] 원격 저장소 최신 버전 확인 중... (총 ${total_cnt}개)" >&2
  fi

  # 병렬 리소스 조회 (최대 8개 동시 실행 + 실시간 진행률 표시)
  local idx=0
  local max_jobs=8
  local r r_type r_id r_name r_scope r_ver r_path r_meta
  for r in "${recs[@]}"; do
    IFS='|' read -r r_type r_id r_name r_scope r_ver r_path r_meta <<< "$r"
    if [[ "$r_type" == "tool" ]]; then
      local resolved_ref
      resolved_ref="$(_resolve_tool_path "$r_id")"
      (
        _fetch_resource "$resolved_ref" "${tmp_dir}/${idx}.res" 2>/dev/null || rm -f -- "${tmp_dir}/${idx}.res"
        touch "${tmp_dir}/${idx}.done"
      ) &
    elif [[ "$r_type" == "ssh-key" ]]; then
      (
        _resolve_ssh_key_content "$r_id" > "${tmp_dir}/${idx}.key" 2>/dev/null || rm -f -- "${tmp_dir}/${idx}.key"
        touch "${tmp_dir}/${idx}.done"
      ) &
    else
      touch "${tmp_dir}/${idx}.done"
    fi
    ((idx++))

    # 동시 실행 수 제한 및 진행률 갱신
    while (( $(jobs -pr | wc -l) >= max_jobs )); do
      if [[ -t 2 ]]; then
        local done_cnt
        done_cnt="$(find "$tmp_dir" -maxdepth 1 -name '*.done' 2>/dev/null | wc -l)"
        local pct=$(( done_cnt * 100 / total_cnt ))
        printf '\r - [🔍] 원격 저장소 최신 버전 확인 중... (%d/%d, %d%%)' "$done_cnt" "$total_cnt" "$pct" >&2
      fi
      sleep 0.1
    done
  done

  while (( $(jobs -pr | wc -l) > 0 )); do
    if [[ -t 2 ]]; then
      local done_cnt
      done_cnt="$(find "$tmp_dir" -maxdepth 1 -name '*.done' 2>/dev/null | wc -l)"
      local pct=$(( done_cnt * 100 / total_cnt ))
      printf '\r - [🔍] 원격 저장소 최신 버전 확인 중... (%d/%d, %d%%)' "$done_cnt" "$total_cnt" "$pct" >&2
    fi
    sleep 0.1
  done
  wait

  local end_ts elapsed
  end_ts="$(date +%s)"
  elapsed=$(( end_ts - start_ts ))
  if [[ -t 2 ]]; then
    printf '\r\033[K' >&2
  fi
  echo_i " - [✅] 총 ${total_cnt}개 항목 최신 버전 확인 완료 (${elapsed}s)" >&2

  idx=0
  for r in "${recs[@]}"; do
    IFS='|' read -r r_type r_id r_name r_scope r_ver r_path r_meta <<< "$r"
    if [[ "$r_type" == "tool" ]]; then
      local res_file="${tmp_dir}/${idx}.res"
      if [[ ! -s "$res_file" ]]; then
        REC_UPDATE_STATUS["$r_meta"]="unknown"
        REC_REMOTE_VER["$r_meta"]=""
      else
        local local_ver="$r_ver"
        [[ "$local_ver" == "unknown" ]] && local_ver=""
        local remote_ver
        remote_ver="$(_extract_script_version "$res_file")"
        REC_REMOTE_VER["$r_meta"]="$remote_ver"

        if [[ -z "$local_ver" ]]; then
          # 버전 확인이 안 되는 legacy 설치 도구는 동일 파일이 아닌 이상 업데이트 가능으로 분류
          if [[ -n "$remote_ver" ]] || ! cmp -s "$res_file" "$r_path" 2>/dev/null; then
            REC_UPDATE_STATUS["$r_meta"]="updatable"
          else
            REC_UPDATE_STATUS["$r_meta"]="up-to-date"
          fi
        elif [[ -n "$remote_ver" ]]; then
          if _is_newer_version "$local_ver" "$remote_ver"; then
            REC_UPDATE_STATUS["$r_meta"]="updatable"
          elif [[ "$local_ver" == "$remote_ver" ]] && ! cmp -s "$res_file" "$r_path" 2>/dev/null; then
            REC_UPDATE_STATUS["$r_meta"]="updatable"
          else
            REC_UPDATE_STATUS["$r_meta"]="up-to-date"
          fi
        else
          REC_UPDATE_STATUS["$r_meta"]="up-to-date"
        fi
      fi
    elif [[ "$r_type" == "ssh-key" ]]; then
      local key_file="${tmp_dir}/${idx}.key"
      if [[ ! -s "$key_file" ]]; then
        REC_UPDATE_STATUS["$r_meta"]="unknown"
        REC_REMOTE_VER["$r_meta"]=""
      else
        local new_pub new_body new_comment old_body
        new_pub="$(cat "$key_file")"
        new_body="$(echo "$new_pub" | awk '{print $2}')"
        new_comment="$(echo "$new_pub" | cut -d' ' -f3-)"
        old_body="$(_manifest_get_field "$r_meta" "KEY_BODY" || true)"
        REC_REMOTE_VER["$r_meta"]="${new_comment:-ssh-rsa}"
        if [[ -n "$new_body" && "$old_body" != "$new_body" ]]; then
          REC_UPDATE_STATUS["$r_meta"]="updatable"
        else
          REC_UPDATE_STATUS["$r_meta"]="up-to-date"
        fi
      fi
    fi
    ((idx++))
  done

  rm -rf -- "$tmp_dir"
  return 0
}

##
# 설치 레코드 배열을 지정한 정렬 기준(--orderby)으로 정렬하여 표준 출력합니다.
# 각 출력 라인은 기존 7개 필드 뒤에 '|updated_at'이 추가된 8개 필드입니다.
#
# @param $1 {string} 정렬 기준 (id | id/asc | id/desc | time | time/asc | time/desc)
# @param $@ {array} 파이프 구분 레코드 목록
#
# @return 정렬된 8필드 레코드 출력
##
_sort_installed_records() {
  local orderby="${1:-id}"
  shift
  local -a recs=("$@")
  (( ${#recs[@]} > 0 )) || return 0

  local sort_opts=""
  case "$orderby" in
    id|id/asc)
      sort_opts="-t| -k1,1 -k2,2"
      ;;
    id/desc)
      sort_opts="-t| -k1,1 -k2,2r"
      ;;
    time|time/asc)
      sort_opts="-t| -k1,1 -k8,8 -k2,2"
      ;;
    time/desc)
      sort_opts="-t| -k1,1 -k8,8r -k2,2"
      ;;
    *)
      error_exit "지원하지 않는 '--orderby' 값입니다: '$orderby' (허용값: id, id/asc, id/desc, time, time/asc, time/desc)" "$LINENO" "list"
      ;;
  esac

  local r r_type r_id r_name r_scope r_ver r_path r_meta updated_at
  {
    for r in "${recs[@]}"; do
      IFS='|' read -r r_type r_id r_name r_scope r_ver r_path r_meta <<< "$r"
      updated_at="$(_manifest_get_field "$r_meta" "UPDATED_AT" || true)"
      updated_at="${updated_at:0:19}"
      printf '%s|%s\n' "$r" "${updated_at:-0000-00-00T00:00:00}"
    done
  } | LC_ALL=C sort $sort_opts
}

##
# 동적 컬럼 너비를 계산하여 잘림 없이 설치 대상 테이블을 출력합니다.
# 행 데이터 형식: <no_label>|<type>|<id>|<scope>|<ver_disp>|<updated_at>|<path>
#
# @param $1 {string} 테이블 제목
# @param $2 {string} 출력 대상 스트림 (stdout | stderr)
# @param $@ {array} 행 데이터 목록
#
# @return 테이블 출력
##
_print_dynamic_installed_table() {
  local title="$1"
  local stream="${2:-stdout}"
  shift 2
  local -a rows=("$@")

  local w_no=4 w_type=4 w_id=10 w_scope=5 w_ver=15 w_time=19 w_path=4
  local row c_no c_type c_id c_scope c_ver c_time c_path cw
  for row in "${rows[@]}"; do
    IFS='|' read -r c_no c_type c_id c_scope c_ver c_time c_path <<< "$row"
    cw="$(_get_display_width "$c_no")";    (( cw > w_no )) && w_no="$cw"
    cw="$(_get_display_width "$c_type")";  (( cw > w_type )) && w_type="$cw"
    cw="$(_get_display_width "$c_id")";    (( cw > w_id )) && w_id="$cw"
    cw="$(_get_display_width "$c_scope")"; (( cw > w_scope )) && w_scope="$cw"
    cw="$(_get_display_width "$c_ver")";   (( cw > w_ver )) && w_ver="$cw"
    cw="$(_get_display_width "$c_time")";  (( cw > w_time )) && w_time="$cw"
    cw="$(_get_display_width "$c_path")";  (( cw > w_path )) && w_path="$cw"
  done

  local total_w=$(( 2 + w_no + 3 + w_type + 3 + w_id + 3 + w_scope + 3 + w_ver + 3 + w_time + 3 + w_path + 2 ))
  (( total_w < 80 )) && total_w=80
  local eq_line dash_line
  eq_line="$(printf '%*s' "$total_w" '' | tr ' ' '=')"
  dash_line="$(printf '%*s' "$total_w" '' | tr ' ' '-')"

  _emit_line() {
    if [[ "$stream" == "stderr" ]]; then
      printf '%b\n' "$1" >&2
    else
      printf '%b\n' "$1"
    fi
  }

  _emit_line ""
  _emit_line "$eq_line"
  _emit_line "${COLOR_INFO}${title}${COLOR_NC}"
  _emit_line "$dash_line"
  _emit_line "  $(_pad_string 'No.' "$w_no") | $(_pad_string 'Type' "$w_type") | $(_pad_string 'Identifier' "$w_id") | $(_pad_string 'Scope' "$w_scope") | $(_pad_string 'Version/Comment' "$w_ver") | $(_pad_string 'Updated At' "$w_time") | Path"
  _emit_line "$dash_line"

  for row in "${rows[@]}"; do
    IFS='|' read -r c_no c_type c_id c_scope c_ver c_time c_path <<< "$row"
    _emit_line "  $(_pad_string "$c_no" "$w_no") | $(_pad_string "$c_type" "$w_type") | $(_pad_string "$c_id" "$w_id") | $(_pad_string "$c_scope" "$w_scope") | $(_pad_string "$c_ver" "$w_ver") | $(_pad_string "$c_time" "$w_time") | ${c_path}"
  done
  _emit_line "$eq_line"
}

##
# 현재 시스템에 설치된 도구 및 등록된 SSH 공개키 목록을 정렬 후 원격 비교 없이 즉시 테이블로 출력합니다.
#
# @param $1 {string} 조회 대상 유형 (all | tools | keys)
# @param $2 {string} 범위 필터 (all | local | global)
# @param $3 {string} 정렬 기준 (id | id/asc | id/desc | time | time/asc | time/desc)
# @param $4 {string} 특정 도구 필터 (콤마 구분, 선택)
# @param $5 {string} 특정 SSH 키 필터 (콤마 구분, 선택)
#
# @return 0
##
_list_installed_items() {
  local filter_type="${1:-all}"
  local filter_scope="${2:-all}"
  local orderby="${3:-id}"
  local filter_tools="${4:-}"
  local filter_keys="${5:-}"

  local -a req_tools=()
  local -a req_keys=()
  if [[ -n "$filter_tools" ]]; then
    local -a t_raw=()
    IFS=',' read -ra t_raw <<< "$filter_tools"
    local t
    for t in "${t_raw[@]}"; do
      t="$(echo "$t" | xargs)"
      [[ -n "$t" ]] && req_tools+=("$t")
    done
  fi
  if [[ -n "$filter_keys" ]]; then
    local -a k_raw=()
    IFS=',' read -ra k_raw <<< "$filter_keys"
    local k
    for k in "${k_raw[@]}"; do
      k="$(echo "$k" | xargs)"
      [[ -n "$k" ]] && req_keys+=("$k")
    done
  fi

  local has_item_filter="false"
  (( ${#req_tools[@]} > 0 || ${#req_keys[@]} > 0 )) && has_item_filter="true"

  local -a matched=()
  local rec r_type r_id r_name r_scope r_ver r_path r_meta
  while IFS= read -r rec; do
    [[ -n "$rec" ]] || continue
    IFS='|' read -r r_type r_id r_name r_scope r_ver r_path r_meta <<< "$rec"
    case "$filter_type" in
      tools|tool)
        [[ "$r_type" == "tool" ]] || continue
        ;;
      keys|key)
        [[ "$r_type" == "ssh-key" ]] || continue
        ;;
      all)
        ;;
      *)
        error_exit "'--installed'와 함께 사용할 수 없는 '--type' 값입니다: '$filter_type' (허용값: all, tools, keys)" "$LINENO" "list"
        ;;
    esac

    if [[ "$has_item_filter" == "true" ]]; then
      local keep=0
      if [[ "$r_type" == "tool" && ${#req_tools[@]} -gt 0 ]]; then
        local rt
        for rt in "${req_tools[@]}"; do
          if [[ "$r_id" == "$rt" || "$r_name" == "$(basename "$rt")" ]]; then
            keep=1
            break
          fi
        done
      elif [[ "$r_type" == "ssh-key" && ${#req_keys[@]} -gt 0 ]]; then
        local rk
        for rk in "${req_keys[@]}"; do
          if [[ "$r_id" == "$rk" ]]; then
            keep=1
            break
          fi
        done
      fi
      (( keep == 1 )) || continue
    fi

    matched+=("$rec")
  done < <(_manifest_list_installed "$filter_scope")

  if (( ${#matched[@]} == 0 )); then
    echo_w " - [💡] 조건에 해당하는 설치된 도구 또는 등록된 SSH 공개키가 없습니다."
    return 0
  fi

  local -a sorted_recs=()
  local srec updated_at
  while IFS= read -r srec; do
    [[ -n "$srec" ]] && sorted_recs+=("$srec")
  done < <(_sort_installed_records "$orderby" "${matched[@]}")

  local -a table_rows=()
  local i=1
  for srec in "${sorted_recs[@]}"; do
    IFS='|' read -r r_type r_id r_name r_scope r_ver r_path r_meta updated_at <<< "$srec"
    table_rows+=("$(printf '%3d)' "$i")|${r_type}|${r_id}|${r_scope}|${r_ver}|${updated_at}|${r_path}")
    ((i++))
  done

  _print_dynamic_installed_table "📦 [설치된 관리 대상 현황 (총 ${#table_rows[@]}개)]" "stdout" "${table_rows[@]}"
}

cmd_list() {
  local list_type=""
  local installed_only="false"
  local target_scope="all"
  local orderby=""
  local raw_tools=""
  local raw_keys=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --type|--type=*)
        if [[ "$1" == *=* ]]; then
          list_type="${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--type' 옵션 뒤에 조회 유형(all|catalogs|tools|installers|commands|keys)을 지정하세요." "$LINENO" "list"
          list_type="$2"
          shift 2
        fi
        ;;
      --installed)
        installed_only="true"
        shift
        ;;
      --tool|--tool=*)
        if [[ "$1" == *=* ]]; then
          raw_tools+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--tool' 옵션 뒤에 도구 식별자 또는 이름을 지정하세요." "$LINENO" "list"
          raw_tools+=",${2}"
          shift 2
        fi
        ;;
      --ssh-key|--ssh-key=*)
        if [[ "$1" == *=* ]]; then
          raw_keys+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--ssh-key' 옵션 뒤에 SSH 공개키 식별자를 지정하세요." "$LINENO" "list"
          raw_keys+=",${2}"
          shift 2
        fi
        ;;
      --target|--target=*)
        if [[ "$1" == *=* ]]; then
          target_scope="${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--target' 옵션 뒤에 local 또는 global을 지정하세요." "$LINENO" "list"
          target_scope="$2"
          shift 2
        fi
        ;;
      --orderby|--orderby=*)
        if [[ "$1" == *=* ]]; then
          orderby="${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--orderby' 옵션 뒤에 정렬 기준(id|id/asc|id/desc|time|time/asc|time/desc)을 지정하세요." "$LINENO" "list"
          orderby="$2"
          shift 2
        fi
        ;;
      --local)
        SOURCE_MODE="local"
        shift
        ;;
      --remote)
        SOURCE_MODE="remote"
        shift
        ;;
      --no-update)
        shift
        ;;
      --force-update)
        shift
        ;;
      --version)
        printf '%s version %s\n' "$FILENAME" "$SCRIPT_FILE_VERSION"
        exit 0
        ;;
      --help)
        help "" "" "list"
        exit 0
        ;;
      *)
        error_exit "지원하지 않는 옵션입니다: $1" "$LINENO" "list"
        ;;
    esac
  done

  if [[ "$target_scope" != "all" && "$target_scope" != "local" && "$target_scope" != "global" ]]; then
    error_exit "'--target' 옵션 값은 'local' 또는 'global'만 허용됩니다: '$target_scope'" "$LINENO" "list"
  fi

  if [[ -n "$orderby" && "$installed_only" != "true" ]]; then
    error_exit "'--orderby' 옵션은 '--installed'와 함께만 사용할 수 있습니다." "$LINENO" "list"
  fi

  if [[ (-n "$raw_tools" || -n "$raw_keys") && "$installed_only" != "true" ]]; then
    error_exit "'--tool' 및 '--ssh-key' 필터는 '--installed'와 함께만 사용할 수 있습니다." "$LINENO" "list"
  fi

  if [[ "$installed_only" == "true" ]]; then
    [[ -z "$list_type" ]] && list_type="all"
    [[ -z "$orderby" ]] && orderby="id"
    _list_installed_items "$list_type" "$target_scope" "$orderby" "$raw_tools" "$raw_keys"
    return 0
  fi

  [[ -z "$list_type" ]] && list_type="catalogs"

  case "$list_type" in
    catalogs|all)
      load_catalogs_index
      echo_i "📦 [카탈로그(Catalog) 목록]"
      show_catalog_table
      ;;
  esac

  if [[ "$list_type" == "tools" || "$list_type" == "tool" || "$list_type" == "all" ]]; then
    echo_i "🛠️  [커스텀 CLI 도구(Tools) 목록]"
    if _detect_local_repo; then
      local c_dir t_dir cat_name tool_name exec_f
      for c_dir in "${LOCAL_REPO_ROOT}"/*; do
        [[ -d "$c_dir" ]] || continue
        cat_name="$(basename "$c_dir")"
        [[ "$cat_name" == .* || "$cat_name" == "tmp" || "$cat_name" == "docs" ]] && continue
        for t_dir in "$c_dir"/*; do
          [[ -d "$t_dir" ]] || continue
          tool_name="$(basename "$t_dir")"
          if [[ "$cat_name" == "env" && ("$tool_name" == "installers" || "$tool_name" == "commands" || "$tool_name" == "keys" || "$tool_name" == "catalogs") ]]; then
            continue
          fi
          if [[ -f "$t_dir/$tool_name" ]]; then
            exec_f="$t_dir/$tool_name"
          elif [[ -f "$t_dir/${tool_name}.sh" ]]; then
            exec_f="$t_dir/${tool_name}.sh"
          else
            continue
          fi
          printf "  - %-32s (%s/%s/%s)\n" "${cat_name}/${tool_name}" "$cat_name" "$tool_name" "$(basename "$exec_f")"
        done
      done
    else
      echo "  - utils/scriptctl                (utils/scriptctl/scriptctl)"
      echo "  - sys/vim-cli                    (sys/vim-cli/vim-cli)"
      echo "  - sudo/sudoers-cli               (sudo/sudoers-cli/sudoers-cli)"
      echo "  - git/git-commit                 (git/git-commit/git-commit)"
      echo "  - maven/build-mvn-package        (maven/build-mvn-package/build-mvn-package)"
      echo "  - env/sciectl                    (env/sciectl/sciectl)"
    fi
    echo
  fi

  if [[ "$list_type" == "installers" || "$list_type" == "all" ]]; then
    echo_i "🛠️  [소프트웨어 인스톨러(Installers) 목록]"
    if _detect_local_repo && [[ -d "${LOCAL_REPO_ROOT}/env/installers" ]]; then
      local d bname exec_f
      for d in "${LOCAL_REPO_ROOT}/env/installers"/*; do
        [[ -d "$d" ]] || continue
        bname="$(basename "$d")"
        if [[ -f "$d/$bname" ]]; then
          exec_f="$d/$bname"
        elif [[ -f "$d/${bname}.sh" ]]; then
          exec_f="$d/${bname}.sh"
        else
          continue
        fi
        local disp_id="$bname"
        printf "  - %-28s (env/installers/%s/%s)\n" "$disp_id" "$bname" "$(basename "$exec_f")"
      done
      printf "  - %-28s (docker/install-docker/install-docker)\n" "docker/install-docker"
    else
      echo "  - install-temurin-25-jdk       (env/installers/install-temurin-25-jdk/install-temurin-25-jdk)"
      echo "  - install-update-java-config   (env/installers/install-update-java-config/install-update-java-config)"
      echo "  - install-maven-3.9.15         (env/installers/install-maven-3.9.15/install-maven-3.9.15)"
      echo "  - install-update-mvn-config    (env/installers/install-update-mvn-config/install-update-mvn-config)"
      echo "  - install-htop                 (env/installers/install-htop/install-htop)"
      echo "  - docker/install-docker        (docker/install-docker/install-docker)"
    fi
    echo
  fi

  if [[ "$list_type" == "commands" || "$list_type" == "all" ]]; then
    echo_i "⚡ [사후 실행 명령어(Commands) 목록]"
    if _detect_local_repo && [[ -d "${LOCAL_REPO_ROOT}/env/commands" ]]; then
      local d bname exec_f
      for d in "${LOCAL_REPO_ROOT}/env/commands"/*; do
        [[ -d "$d" ]] || continue
        bname="$(basename "$d")"
        if [[ -f "$d/$bname" ]]; then
          exec_f="$d/$bname"
        elif [[ -f "$d/${bname}.sh" ]]; then
          exec_f="$d/${bname}.sh"
        else
          continue
        fi
        printf "  - %-28s (env/commands/%s/%s)\n" "$bname" "$bname" "$(basename "$exec_f")"
      done
    else
      echo "  - firewall-cmd-set-priority    (env/commands/firewall-cmd-set-priority/firewall-cmd-set-priority)"
    fi
    echo
  fi

  if [[ "$list_type" == "keys" || "$list_type" == "all" ]]; then
    echo_i "🔑 [SSH RSA 공개키(Keys) 목록]"
    if _detect_local_repo && [[ -d "${LOCAL_REPO_ROOT}/env/keys" ]]; then
      local d bname pub_f
      for d in "${LOCAL_REPO_ROOT}/env/keys"/*; do
        [[ -d "$d" ]] || continue
        bname="$(basename "$d")"
        pub_f="$d/${bname}.pub"
        [[ -f "$pub_f" ]] || continue
        printf "  - %-24s (env/keys/%s/%s.pub)\n" "$bname" "$bname" "$bname"
      done
    else
      echo "  - ymtech-internal          (env/keys/ymtech-internal/ymtech-internal.pub)"
      echo "  - letsencrypt              (env/keys/letsencrypt/letsencrypt.pub)"
    fi
    echo
  fi

  if [[ "$list_type" != "catalogs" && "$list_type" != "tools" && "$list_type" != "tool" && "$list_type" != "installers" && "$list_type" != "commands" && "$list_type" != "keys" && "$list_type" != "all" ]]; then
    error_exit "알 수 없는 '--type' 값입니다: '$list_type' (허용값: all, catalogs, tools, installers, commands, keys)" "$LINENO" "list"
  fi
}

##
# [info 서브커맨드] 특정 카탈로그 또는 개별 컴포넌트(도구, 인스톨러, 명령어, SSH키)의 상세 구성 정보를 출력합니다.
#
# @param $@ {array} info 서브커맨드 인자
#
# @return 0
##
cmd_info() {
  local target_catalogs=""
  local target_tools=""
  local target_installers=""
  local target_commands=""
  local target_ssh_keys=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --catalog|--catalog=*)
        if [[ "$1" == *=* ]]; then
          target_catalogs+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--catalog' 옵션 뒤에 카탈로그 ID를 지정하세요." "$LINENO" "info"
          target_catalogs+=",${2}"
          shift 2
        fi
        ;;
      --tool|--tool=*)
        if [[ "$1" == *=* ]]; then
          target_tools+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--tool' 옵션 뒤에 도구 식별자를 지정하세요." "$LINENO" "info"
          target_tools+=",${2}"
          shift 2
        fi
        ;;
      --installer|--installer=*)
        if [[ "$1" == *=* ]]; then
          target_installers+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--installer' 옵션 뒤에 인스톨러 식별자를 지정하세요." "$LINENO" "info"
          target_installers+=",${2}"
          shift 2
        fi
        ;;
      --command|--command=*)
        if [[ "$1" == *=* ]]; then
          target_commands+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--command' 옵션 뒤에 명령어 식별자를 지정하세요." "$LINENO" "info"
          target_commands+=",${2}"
          shift 2
        fi
        ;;
      --ssh-key|--ssh-key=*)
        if [[ "$1" == *=* ]]; then
          target_ssh_keys+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--ssh-key' 옵션 뒤에 SSH 키 식별자를 지정하세요." "$LINENO" "info"
          target_ssh_keys+=",${2}"
          shift 2
        fi
        ;;
      --local)
        SOURCE_MODE="local"
        shift
        ;;
      --remote)
        SOURCE_MODE="remote"
        shift
        ;;
      --no-update)
        shift
        ;;
      --force-update)
        shift
        ;;
      --version)
        printf '%s version %s\n' "$FILENAME" "$SCRIPT_FILE_VERSION"
        exit 0
        ;;
      --help)
        help "" "" "info"
        exit 0
        ;;
      *)
        error_exit "지원하지 않는 옵션입니다: $1" "$LINENO" "info"
        ;;
    esac
  done

  if [[ -z "$target_catalogs" && -z "$target_tools" && -z "$target_installers" && -z "$target_commands" && -z "$target_ssh_keys" ]]; then
    error_exit "조회할 대상이 지정되지 않았습니다. ('--catalog', '--tool', '--installer', '--command', '--ssh-key' 중 하나 이상 필요)" "$LINENO" "info"
  fi

  # 1. 카탈로그 상세 정보 출력
  if [[ -n "$target_catalogs" ]]; then
    load_catalogs_index

    local -a cat_arr=()
    IFS=',' read -ra cat_arr <<< "$target_catalogs"
    local cid
    for cid in "${cat_arr[@]}"; do
      cid="$(echo "$cid" | xargs)"
      [[ -n "$cid" ]] && resolve_catalog "$cid"
    done

    echo
    echo "================================================================================"
    printf "📦 카탈로그 상세 정보 (적용 순서: %s)\n" "${TX_CATALOGS[*]}"
    for cid in "${TX_CATALOGS[@]}"; do
      if [[ -n "${CATALOG_TITLE[$cid]:-}" ]]; then
        printf "   - %-34s : %s\n" "$cid" "${CATALOG_DESC[$cid]:-}"
      fi
    done
    echo "================================================================================"
    printf " 🗑️  [삭제할 OS 패키지 (%d)]      : %s\n" "${#TX_REMOVE_PKGS[@]}" "${TX_REMOVE_PKGS[*]:-없음}"
    printf " 📥 [설치할 OS 패키지 (%d)]      : %s\n" "${#TX_INSTALL_PKGS[@]}" "${TX_INSTALL_PKGS[*]:-없음}"
    printf " 🔐 [Sudoers NOPASSWD (%d)]     : %s\n" "${#TX_SUDOERS_CMDS[@]}" "${TX_SUDOERS_CMDS[*]:-없음}"
    printf " 🚀 [소프트웨어 인스톨러 (%d)]   :\n" "${#TX_INSTALLERS[@]}"
    if (( ${#TX_INSTALLERS[@]} == 0 )); then
      echo "      - 없음"
    else
      local inst
      for inst in "${TX_INSTALLERS[@]}"; do
        printf "      - %-32s (-> %s)\n" "$inst" "$(_resolve_component_readme_url "installer" "$inst")"
      done
    fi
    printf " 🛠️  [CLI 도구 (%d)]             :\n" "${#TX_TOOLS[@]}"
    if (( ${#TX_TOOLS[@]} == 0 )); then
      echo "      - 없음"
    else
      local t
      for t in "${TX_TOOLS[@]}"; do
        printf "      - %-32s (-> %s)\n" "$t" "$(_resolve_component_readme_url "tool" "$t")"
      done
    fi
    printf " ⚡ [사후 구성 명령어 (%d)]      :\n" "${#TX_COMMANDS[@]}"
    if (( ${#TX_COMMANDS[@]} == 0 )); then
      echo "      - 없음"
    else
      local c
      for c in "${TX_COMMANDS[@]}"; do
        printf "      - %-32s (-> %s)\n" "$c" "$(_resolve_component_readme_url "command" "$c")"
      done
    fi
    printf " 🔑 [SSH RSA 공개키 (%d)]        :\n" "${#TX_SSH_KEYS[@]}"
    if (( ${#TX_SSH_KEYS[@]} == 0 )); then
      echo "      - 없음"
    else
      local k base
      for k in "${TX_SSH_KEYS[@]}"; do
        base="${k%.pub}"
        printf "      - %-32s (-> %s)\n" "$base" "$(_resolve_component_readme_url "ssh-key" "$base")"
      done
    fi
    echo "================================================================================"
    echo
  fi

  # 2. 개별 컴포넌트 상세 정보 출력
  local has_comp=0
  if [[ -n "$target_tools" || -n "$target_installers" || -n "$target_commands" || -n "$target_ssh_keys" ]]; then
    has_comp=1
  fi

  if (( has_comp == 1 )); then
    if [[ -z "$target_catalogs" ]]; then
      echo
    fi

    if [[ -n "$target_tools" ]]; then
      local -a tool_arr=()
      IFS=',' read -ra tool_arr <<< "$target_tools"
      local t
      for t in "${tool_arr[@]}"; do
        t="$(echo "$t" | xargs)"
        [[ -n "$t" ]] && _print_component_info "tool" "$t"
      done
    fi

    if [[ -n "$target_installers" ]]; then
      local -a inst_arr=()
      IFS=',' read -ra inst_arr <<< "$target_installers"
      local inst
      for inst in "${inst_arr[@]}"; do
        inst="$(echo "$inst" | xargs)"
        [[ -n "$inst" ]] && _print_component_info "installer" "$inst"
      done
    fi

    if [[ -n "$target_commands" ]]; then
      local -a cmd_arr=()
      IFS=',' read -ra cmd_arr <<< "$target_commands"
      local c
      for c in "${cmd_arr[@]}"; do
        c="$(echo "$c" | xargs)"
        [[ -n "$c" ]] && _print_component_info "command" "$c"
      done
    fi

    if [[ -n "$target_ssh_keys" ]]; then
      local -a key_arr=()
      IFS=',' read -ra key_arr <<< "$target_ssh_keys"
      local k
      for k in "${key_arr[@]}"; do
        k="$(echo "$k" | xargs)"
        [[ -n "$k" ]] && _print_component_info "ssh-key" "$k"
      done
    fi

    echo
  fi
}

##
# 트랜잭션 실행 계획(Transaction Summary)을 화면에 출력합니다.
#
# @param $1 {string} 설치 범위 (local | global)
# @param $2 {string} sudoers 대상 계정
# @param $3 {number} 기본 환경 3종 활성화 여부 (1 | 0)
# @param $4 {string} 활성화된 단계 목록 문자열
#
# @return 요약표 출력
##
_print_transaction_summary() {
  local target_scope="$1"
  local sudo_user="$2"
  local run_default="$3"
  local active_steps=" $4 "

  echo
  echo "================================================================================"
  echo -e " 📋 ${COLOR_BOLD}[sciectl 트랜잭션 실행 계획 요약 (Transaction Summary)]${COLOR_NC}"
  echo "================================================================================"
  if (( ${#TX_CATALOGS[@]} > 0 )); then
    printf " 📦 적용 카탈로그       : %s\n" "${TX_CATALOGS[*]}"
  else
    printf " 📦 적용 카탈로그       : (개별 컴포넌트 직접 지정)\n"
  fi
  printf " 🌐 리소스 출처        : %s\n" "$([[ "$SOURCE_MODE" == "local" ]] && echo "로컬 저장소 ($LOCAL_REPO_ROOT)" || echo "원격 GitHub ($REPO_BASE_URL)")"
  printf " 🎯 도구 설치 범위      : %s (%s)\n" "$target_scope" "$([[ "$target_scope" == "global" ]] && echo "/usr/local/bin" || echo "$HOME/bin")"
  echo "--------------------------------------------------------------------------------"

  if [[ "$TARGET_OS" == "darwin" ]]; then
    printf " [Step 1] 🔐 Sudoers 등록        : 해당 없음 (macOS 환경으로 자동 건너뜁니다)\n"
  elif [[ "$active_steps" == *" sudoers "* ]] && (( ${#TX_SUDOERS_CMDS[@]} > 0 )); then
    printf " [Step 1] 🔐 Sudoers 등록 (%s) : %d개 명령어 병합\n" "$sudo_user" "${#TX_SUDOERS_CMDS[@]}"
  else
    printf " [Step 1] 🔐 Sudoers 등록        : 해당 없음 (건너뜀)\n"
  fi

  if [[ "$active_steps" == *" remove-packages "* ]] && (( ${#TX_REMOVE_PKGS[@]} > 0 )); then
    printf " [Step 2] 🗑️  OS 패키지 삭제      : %s\n" "${TX_REMOVE_PKGS[*]}"
  else
    printf " [Step 2] 🗑️  OS 패키지 삭제      : 해당 없음 (건너뜀)\n"
  fi

  if [[ "$active_steps" == *" install-packages "* ]] && (( ${#TX_INSTALL_PKGS[@]} > 0 )); then
    printf " [Step 3] 📥 OS 패키지 설치      : %s\n" "${TX_INSTALL_PKGS[*]}"
  else
    printf " [Step 3] 📥 OS 패키지 설치      : 해당 없음 (건너뜀)\n"
  fi

  if (( run_default == 1 )) && [[ "$active_steps" == *" default-opts "* ]]; then
    printf " [Step 4] ⚙️  기본 환경 3종 설정  : ~/bin PATH, git branch 프롬프트 (%s), vimrc 옵션\n" "$(basename "$BASH_ENV_FILE")"
  else
    printf " [Step 4] ⚙️  기본 환경 3종 설정  : 생략 (--no-default-opts)\n"
  fi

  if [[ "$active_steps" == *" installers "* ]] && (( ${#TX_INSTALLERS[@]} > 0 )); then
    printf " [Step 5] 🚀 소프트웨어 인스톨러 (%d): %s\n" "${#TX_INSTALLERS[@]}" "${TX_INSTALLERS[*]}"
  else
    printf " [Step 5] 🚀 소프트웨어 인스톨러    : 해당 없음 (건너뜀)\n"
  fi

  if [[ "$active_steps" == *" tools "* ]] && (( ${#TX_TOOLS[@]} > 0 )); then
    printf " [Step 6] 🛠️  CLI 도구 (%d)       : %s\n" "${#TX_TOOLS[@]}" "${TX_TOOLS[*]}"
  else
    printf " [Step 6] 🛠️  CLI 도구            : 해당 없음 (건너뜀)\n"
  fi

  if [[ "$active_steps" == *" commands "* ]] && (( ${#TX_COMMANDS[@]} > 0 )); then
    printf " [Step 7] ⚡ 사후 구성 명령어 (%d)  : %s\n" "${#TX_COMMANDS[@]}" "${TX_COMMANDS[*]}"
  else
    printf " [Step 7] ⚡ 사후 구성 명령어     : 해당 없음 (건너뜀)\n"
  fi

  if [[ "$active_steps" == *" ssh-key "* ]] && (( ${#TX_SSH_KEYS[@]} > 0 )); then
    printf " [Step 8] 🔑 SSH 공개키 등록 (%d) : %s\n" "${#TX_SSH_KEYS[@]}" "${TX_SSH_KEYS[*]}"
  else
    printf " [Step 8] 🔑 SSH 공개키 등록     : 해당 없음 (건너뜀)\n"
  fi
  echo "================================================================================"
}

