def run_cmd(
    cmd: Sequence[str],
    timeout: Optional[int] = None,
    capture: bool = True,
    env: Optional[Dict[str, str]] = None,
) -> subprocess.CompletedProcess:
    """외부 명령어를 shell=False로 안전하게 실행합니다."""
    kwargs: Dict[str, object] = {
        "shell": False,
        "text": True,
        "check": False,
    }
    if timeout is not None:
        kwargs["timeout"] = timeout
    if capture:
        kwargs["stdout"] = subprocess.PIPE
        kwargs["stderr"] = subprocess.PIPE
    if env is not None:
        kwargs["env"] = env
    return subprocess.run(list(cmd), **kwargs)  # type: ignore[arg-type]


class AppContext:
    """실행 컨텍스트, 소스 모드, HTTP 커넥션 풀 및 실행 상태 관리."""

    def __init__(self) -> None:
        self.source_mode: str = "remote"
        self.local_repo_root: Optional[Path] = None
        self.remote_cache_token: str = ""
        self.last_fetch_error: str = ""
        self.pkg_manager: Optional[PackageManagerConfig] = None
        self.executed_job_flags: Set[str] = set()
        self.manifest_synced: bool = False
        self._thread_local = threading.local()
        self._ssl_ctx = ssl.create_default_context()

    def detect_pkg_manager(self) -> PackageManagerConfig:
        """OS 패키지 매니저(apt, dnf, pacman, brew)를 감지합니다."""
        if self.pkg_manager is not None:
            return self.pkg_manager

        if TARGET_OS == "darwin":
            if shutil.which("brew") is None:
                echo_e("[❌] macOS 환경에서는 Homebrew('brew')가 필요합니다.")
                echo_w("💡 아래 명령어로 Homebrew를 먼저 설치해 주세요:")
                echo_w('   /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"')
                sys.exit(1)
            self.pkg_manager = PackageManagerConfig(
                name="brew",
                update_cmd=["brew", "update"],
                install_cmd=["brew", "install", "-q"],
                remove_cmd=["brew", "uninstall", "-q"],
            )
            return self.pkg_manager

        if shutil.which("apt") is not None:
            self.pkg_manager = PackageManagerConfig(
                name="apt",
                update_cmd=["sudo", "apt", "update"],
                install_cmd=["sudo", "apt", "install", "-y"],
                remove_cmd=["sudo", "apt", "purge", "-y"],
            )
        elif shutil.which("dnf") is not None:
            self.pkg_manager = PackageManagerConfig(
                name="dnf",
                update_cmd=["sudo", "dnf", "makecache"],
                install_cmd=["sudo", "dnf", "install", "-y"],
                remove_cmd=["sudo", "dnf", "remove", "-y"],
            )
        elif shutil.which("pacman") is not None:
            self.pkg_manager = PackageManagerConfig(
                name="pacman",
                update_cmd=["sudo", "pacman", "-Sy"],
                install_cmd=["sudo", "pacman", "-S", "--noconfirm", "--needed"],
                remove_cmd=["sudo", "pacman", "-Rns", "--noconfirm"],
            )
        else:
            echo_e("[❌] 지원하지 않는 운영체제입니다. (apt, dnf 또는 pacman이 필요합니다.)")
            sys.exit(1)
        return self.pkg_manager

    def is_package_installed(self, pkg_name: str) -> bool:
        """OS 패키지 매니저를 통해 패키지 설치 여부를 확인합니다."""
        pm = self.detect_pkg_manager()
        try:
            if pm.name == "apt":
                res = run_cmd(["dpkg", "-s", pkg_name], timeout=15)
                return res.returncode == 0 and "Status: install ok installed" in (res.stdout or "")
            if pm.name == "dnf":
                return run_cmd(["rpm", "-q", pkg_name], timeout=15).returncode == 0
            if pm.name == "pacman":
                return run_cmd(["pacman", "-Q", pkg_name], timeout=15).returncode == 0
            if pm.name == "brew":
                return run_cmd(["brew", "list", pkg_name], timeout=15).returncode == 0
        except (OSError, subprocess.SubprocessError):
            return False
        return False

    def detect_local_repo(self, abort_on_missing: bool = True) -> Optional[Path]:
        """'--local' 옵션 지정 시 로컬 shellscripts 저장소 루트를 탐색합니다."""
        if self.source_mode != "local":
            self.local_repo_root = None
            return None
        if self.local_repo_root is not None:
            return self.local_repo_root

        candidates: List[Path] = []
        try:
            script_dir = Path(__file__).resolve().parent
            candidates.extend([script_dir.parent.parent, script_dir.parent])
        except OSError:
            pass
        candidates.append(Path.cwd().resolve())

        for cand in candidates:
            try:
                resolved = cand.resolve()
            except OSError:
                continue
            if (resolved / "env" / "catalogs" / "catalogs.ini").is_file():
                self.local_repo_root = resolved
                return resolved

        if abort_on_missing:
            error_exit("'--local' 옵션이 지정되었으나 로컬 저장소(env/catalogs/catalogs.ini)를 찾을 수 없습니다.")
        return None

    def resolve_remote_cache_token(self) -> str:
        """원격 저장소 main 브랜치 최신 커밋 SHA(12자리)를 조회해 캐시 버스팅 토큰으로 설정합니다."""
        self.remote_cache_token = ""
        if shutil.which("git") is not None:
            git_url = REPO_WEB_BASE_URL.split("/blob/", 1)[0] + ".git"
            try:
                res = run_cmd(["git", "ls-remote", git_url, "refs/heads/main"], timeout=3)
                if res.returncode == 0 and res.stdout:
                    sha = res.stdout.strip().split()[0][:12]
                    if sha:
                        self.remote_cache_token = sha
                        return sha
            except (OSError, subprocess.SubprocessError, IndexError):
                pass
        self.remote_cache_token = str(int(time.time()))
        return self.remote_cache_token

    def _get_connection(self, scheme: str, netloc: str, timeout: float) -> http.client.HTTPConnection:
        conns: Dict[Tuple[str, str], http.client.HTTPConnection] = getattr(self._thread_local, "conns", None)
        if conns is None:
            conns = {}
            self._thread_local.conns = conns
        key = (scheme, netloc)
        conn = conns.get(key)
        if conn is not None:
            return conn
        if scheme == "https":
            conn = http.client.HTTPSConnection(netloc, timeout=timeout, context=self._ssl_ctx)
        else:
            conn = http.client.HTTPConnection(netloc, timeout=timeout)
        conns[key] = conn
        return conn

    def _drop_connection(self, scheme: str, netloc: str) -> None:
        conns: Optional[Dict[Tuple[str, str], http.client.HTTPConnection]] = getattr(self._thread_local, "conns", None)
        if not conns:
            return
        conn = conns.pop((scheme, netloc), None)
        if conn is not None:
            try:
                conn.close()
            except Exception:
                pass

    def _http_request(
        self,
        url: str,
        method: str = "GET",
        timeout: float = 8.0,
        max_redirects: int = 5,
    ) -> Tuple[int, bytes, float, str]:
        """Thread-local HTTP Keep-Alive 커넥션으로 요청을 수행합니다."""
        t0 = time.monotonic()
        current_url = url
        headers = {
            "User-Agent": f"sciectl/{SCRIPT_FILE_VERSION}",
            "Cache-Control": "no-cache",
            "Pragma": "no-cache",
            "Connection": "keep-alive",
        }
        for _ in range(max_redirects + 1):
            parsed = urllib.parse.urlparse(current_url)
            scheme = parsed.scheme.lower()
            netloc = parsed.netloc
            path = parsed.path or "/"
            if parsed.query:
                path = f"{path}?{parsed.query}"

            conn = self._get_connection(scheme, netloc, timeout)
            try:
                conn.timeout = timeout
                conn.request(method, path, headers=headers)
                resp = conn.getresponse()
                body = resp.read()
                status = resp.status
                location = resp.getheader("Location")
            except (http.client.HTTPException, OSError, ssl.SSLError) as exc:
                self._drop_connection(scheme, netloc)
                raise exc

            if status in (301, 302, 303, 307, 308) and location:
                current_url = urllib.parse.urljoin(current_url, location)
                continue
            elapsed = time.monotonic() - t0
            return status, body, elapsed, ""
        return 0, b"", time.monotonic() - t0, "Too Many Redirects"

    def _format_exception(self, exc: Exception) -> str:
        if isinstance(exc, ssl.SSLError):
            return "SSL Error"
        if isinstance(exc, TimeoutError) or "timed out" in str(exc).lower():
            return "Timeout"
        if isinstance(exc, OSError):
            msg = str(exc)
            if "name or service not known" in msg.lower() or "nodename" in msg.lower() or "gaierror" in repr(exc).lower():
                return "DNS Error"
            return "Connect Error"
        return f"HTTP Error ({type(exc).__name__})"

    def fetch_bytes(
        self,
        rel_or_url: str,
        show_progress: bool = False,
        timeout: float = 8.0,
        max_retries: int = 3,
    ) -> Tuple[Optional[bytes], str]:
        """저장소 상대 경로 또는 URL 리소스를 바이트로 가져옵니다 (로컬 복사 또는 HTTP 3회 재시도)."""
        if rel_or_url.startswith(("https://", "http://")):
            target_url = rel_or_url
        else:
            local_root = self.detect_local_repo(abort_on_missing=(self.source_mode == "local"))
            if local_root is not None:
                local_path = local_root / rel_or_url
                if local_path.is_file():
                    try:
                        data = local_path.read_bytes()
                        if show_progress:
                            print(f" - [⬇️ ] 로컬 복사 완료: {rel_or_url} ({len(data)} bytes)")
                        self.last_fetch_error = ""
                        return data, ""
                    except OSError as exc:
                        err = f"Local Read Error: {exc}"
                        self.last_fetch_error = err
                        return None, err
            if self.source_mode == "local":
                self.last_fetch_error = "Local Not Found"
                return None, "Local Not Found"
            target_url = f"{REPO_BASE_URL}/{rel_or_url.lstrip('/')}"

        sep = "&" if "?" in target_url else "?"
        token = self.remote_cache_token or str(int(time.time()))
        fetch_url = f"{target_url}{sep}v={token}"
        if show_progress:
            print(f" - [⬇️ ] 다운로드 중: {target_url}")

        last_err = ""
        for attempt in range(max_retries + 1):
            try:
                status, body, elapsed, redir_err = self._http_request(fetch_url, method="GET", timeout=timeout)
                if redir_err:
                    last_err = redir_err
                elif 200 <= status < 300 and len(body) > 0:
                    if show_progress:
                        echo_i(f" - [⬇️ ] 다운로드 완료: {rel_or_url} ({len(body)} bytes, {elapsed:.2f}s)")
                    self.last_fetch_error = ""
                    return body, ""
                elif status >= 400:
                    last_err = f"HTTP {status}"
                else:
                    last_err = "Empty Response"
            except Exception as exc:
                last_err = self._format_exception(exc)

            if attempt < max_retries:
                time.sleep(0.3)

        self.last_fetch_error = last_err or "Fetch Error"
        return None, self.last_fetch_error

    def fetch_to_file(self, rel_or_url: str, dest_file: Path, show_progress: bool = False) -> bool:
        """리소스를 가져와 지정된 파일 경로에 저장합니다."""
        data, _ = self.fetch_bytes(rel_or_url, show_progress=show_progress)
        if data is None:
            return False
        try:
            dest_file.write_bytes(data)
            return True
        except OSError as exc:
            self.last_fetch_error = f"Write Error: {exc}"
            return False

    def check_remote_reachable(self) -> bool:
        """현재 소스 모드에서 저장소 리소스 접근 가능 여부를 사전 확인합니다."""
        if self.detect_local_repo(abort_on_missing=False) is not None:
            return True
        if self.source_mode == "local":
            return False

        check_url = f"{REPO_BASE_URL}/env/catalogs/catalogs.ini"
        for attempt in range(4):
            try:
                status, _, _, _ = self._http_request(check_url, method="HEAD", timeout=5.0)
                if 200 <= status < 300:
                    self.last_fetch_error = ""
                    return True
                self.last_fetch_error = f"HTTP {status}"
            except Exception as exc:
                self.last_fetch_error = self._format_exception(exc)
            if attempt < 3:
                time.sleep(0.3)
        return False


# ==============================================================================
# 버전 비교, 경로 리졸버, 문자열 폭 및 테이블 유틸리티
# ==============================================================================
def extract_script_version_from_text(text: str) -> str:
    """스크립트 본문에서 SCRIPT_FILE_VERSION 또는 SCIECTL_VERSION을 추출합니다."""
    m = VERSION_LINE_RE.search(text)
    if not m:
        return ""
    val = m.group(1).split("#", 1)[0].strip()
    if len(val) >= 2 and ((val[0] == '"' and val[-1] == '"') or (val[0] == "'" and val[-1] == "'")):
        val = val[1:-1]
    return val.strip()


def extract_script_version(file_path: Path) -> str:
    """파일에서 SCRIPT_FILE_VERSION 또는 SCIECTL_VERSION을 추출합니다."""
    if not file_path.is_file():
        return ""
    try:
        return extract_script_version_from_text(file_path.read_text(encoding="utf-8", errors="replace"))
    except OSError:
        return ""


def _parse_version_tuple(ver: str) -> Tuple[Tuple[int, object], ...]:
    parts: List[Tuple[int, object]] = []
    for seg in ver.strip().split("."):
        if seg.isdigit():
            parts.append((0, int(seg)))
        else:
            parts.append((1, seg))
    return tuple(parts)


def is_newer_version(local_ver: str, remote_ver: str) -> bool:
    """원격 버전이 로컬 버전보다 엄격히 높은지 비교합니다."""
    if not local_ver or not remote_ver or local_ver == remote_ver:
        return False
    return _parse_version_tuple(remote_ver) > _parse_version_tuple(local_ver)


def get_display_width(text: str) -> int:
    """문자열의 터미널 출력 너비를 계산합니다 (동아시아 전각/한글/이모지=2, ASCII=1)."""
    width = 0
    for ch in text:
        if unicodedata.east_asian_width(ch) in ("W", "F"):
            width += 2
        elif ord(ch) > 0x2600:
            width += 2
        else:
            width += 1
    return width


def pad_string(text: str, target_width: int) -> str:
    """지정된 출력 너비만큼 우측 공백 패딩을 추가합니다."""
    pad = max(0, target_width - get_display_width(text))
    return text + (" " * pad)


def resolve_tool_path(item: str) -> str:
    """논리적 도구 식별자(<category>/<name>)를 저장소 상대 경로로 변환합니다."""
    if item.startswith(("https://", "http://")):
        return item
    if item.count("/") == 1:
        tool_name = item.split("/", 1)[1]
        return f"{item}/{tool_name}"
    return item


def resolve_installer_path(ctx: AppContext, item: str) -> str:
    """논리적 인스톨러 식별자를 저장소 상대 경로로 변환합니다."""
    if item.startswith(("https://", "http://")):
        return item
    if "/" in item:
        return resolve_tool_path(item)
    base = item[:-3] if item.endswith(".sh") else item
    local_root = ctx.detect_local_repo(abort_on_missing=False)
    if local_root is not None:
        if (local_root / "env" / "installers" / base / base).is_file():
            return f"env/installers/{base}/{base}"
        if (local_root / "env" / "installers" / f"install-{base}" / f"install-{base}").is_file():
            return f"env/installers/install-{base}/install-{base}"
        legacy_name = base[len("install-"):] if base.startswith("install-") else base
        if (local_root / "env" / "installers" / f"install-{legacy_name}.sh").is_file():
            return f"env/installers/install-{legacy_name}.sh"
    if base.startswith("install-"):
        return f"env/installers/{base}/{base}"
    return f"env/installers/install-{base}/install-{base}"


def resolve_command_path(ctx: AppContext, item: str) -> str:
    """논리적 사후 명령어 식별자를 저장소 상대 경로로 변환합니다."""
    if item.startswith(("https://", "http://")):
        return item
    if "/" in item:
        return resolve_tool_path(item)
    base = item[:-3] if item.endswith(".sh") else item
    local_root = ctx.detect_local_repo(abort_on_missing=False)
    if local_root is not None:
        if (local_root / "env" / "commands" / base / base).is_file():
            return f"env/commands/{base}/{base}"
        if (local_root / "env" / "commands" / f"{base}.sh").is_file():
            return f"env/commands/{base}.sh"
    return f"env/commands/{base}/{base}"


def resolve_ssh_key_content(ctx: AppContext, item: str) -> Optional[str]:
    """논리적 SSH 공개키 식별자 또는 원문을 공개키 한 줄 문자열로 반환합니다."""
    if item.startswith(("ssh-", "ecdsa-")):
        return item.strip()
    base = item[:-4] if item.endswith(".pub") else item
    for rel_path in (f"env/keys/{base}/{base}.pub", f"env/keys/{base}.pub"):
        data, _ = ctx.fetch_bytes(rel_path)
        if data is not None:
            for ln in data.decode("utf-8", errors="replace").splitlines():
                stripped = ln.strip()
                if stripped and not stripped.startswith("#"):
                    return stripped
    return None


