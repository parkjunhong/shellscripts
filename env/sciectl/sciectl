    if cat_list:
        catalogs = load_catalogs_index(ctx)
        plan = TransactionPlan()
        for cid in cat_list:
            resolve_catalog(ctx, catalogs, plan, cid)
        print()
        print("=" * 80)
        print(f"📦 카탈로그 상세 정보 (적용 순서: {' '.join(plan.catalogs)})")
        for cid in plan.catalogs:
            if cid in catalogs and catalogs[cid].title:
                print(f"   - {cid:<34s} : {catalogs[cid].description}")
        print("=" * 80)
        print(f" 🗑️  [삭제할 OS 패키지 ({len(plan.remove_pkgs)})]      : {' '.join(plan.remove_pkgs) if plan.remove_pkgs else '없음'}")
        print(f" 📥 [설치할 OS 패키지 ({len(plan.install_pkgs)})]      : {' '.join(plan.install_pkgs) if plan.install_pkgs else '없음'}")
        print(f" 🔐 [Sudoers NOPASSWD ({len(plan.sudoers_cmds)})]     : {' '.join(plan.sudoers_cmds) if plan.sudoers_cmds else '없음'}")
        print(f" 🚀 [소프트웨어 인스톨러 ({len(plan.installers)})]   :")
        if not plan.installers:
            print("      - 없음")
        else:
            for inst in plan.installers:
                print(f"      - {inst:<32s} (-> {REPO_WEB_BASE_URL}/{_resolve_component_readme_rel(ctx, 'installer', inst)})")
        print(f" 🛠️  [CLI 도구 ({len(plan.tools)})]             :")
        if not plan.tools:
            print("      - 없음")
        else:
            for t in plan.tools:
                print(f"      - {t:<32s} (-> {REPO_WEB_BASE_URL}/{_resolve_component_readme_rel(ctx, 'tool', t)})")
        print(f" ⚡ [사후 구성 명령어 ({len(plan.commands)})]      :")
        if not plan.commands:
            print("      - 없음")
        else:
            for c in plan.commands:
                print(f"      - {c:<32s} (-> {REPO_WEB_BASE_URL}/{_resolve_component_readme_rel(ctx, 'command', c)})")
        print(f" 🔑 [SSH RSA 공개키 ({len(plan.ssh_keys)})]        :")
        if not plan.ssh_keys:
            print("      - 없음")
        else:
            for k in plan.ssh_keys:
                base = k[:-4] if k.endswith(".pub") else k
                print(f"      - {base:<32s} (-> {REPO_WEB_BASE_URL}/{_resolve_component_readme_rel(ctx, 'ssh-key', base)})")
        print("=" * 80)
