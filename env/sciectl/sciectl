def _prompt_yes_no(prompt_msg: str) -> bool:
    if not sys.stdin.isatty():
        return False
    try:
        ans = input(prompt_msg).strip()
        return ans.lower() == "y"
    except (EOFError, KeyboardInterrupt):
        print()
        return False


def _setup_home_bin(ctx: AppContext) -> None:
    func_name = "_setup_home_bin"
    if func_name in ctx.executed_job_flags:
        return

    print()
    print(f"############### {func_name} ###############")
    bin_dir = Path.home() / "bin"
    print(f"[✨] {bin_dir} 디렉토리 설정 중...")
    if not bin_dir.is_dir():
        try:
            bin_dir.mkdir(parents=True, exist_ok=True)
            echo_i(" - ~/bin 디렉토리를 생성했습니다.")
        except OSError as exc:
            error_exit(f"~/bin 디렉토리 생성 실패: {exc}")

    BASH_ENV_FILE.touch(exist_ok=True)
    content = BASH_ENV_FILE.read_text(encoding="utf-8", errors="replace")
    if not re.search(rf"PATH=.*{re.escape(str(bin_dir))}", content):
        try:
            with BASH_ENV_FILE.open("a", encoding="utf-8") as fp:
                fp.write(f'export PATH="$PATH:{bin_dir}"\n')
            os.environ["PATH"] = f"{os.environ.get('PATH', '')}:{bin_dir}"
            echo_i(f" - {BASH_ENV_FILE} 파일에 PATH 설정('{bin_dir}')을 추가했습니다.")
            _add_notice(f"### {bin_dir} -> $PATH 추가 작업 ###", forced=False)
            _add_notice(f" - 현재 터미널에 즉시 반영하려면 다음 명령을 실행하세요: source {BASH_ENV_FILE}", forced=False)
        except OSError as exc:
            error_exit(f"{BASH_ENV_FILE} 파일 수정 실패: {exc}")
    else:
        echo_w(f" - {BASH_ENV_FILE} 파일에 이미 PATH 설정이 존재합니다.")

    local_man_dir = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share")) / "man"
    user_share_man = Path.home() / "share" / "man"
    if local_man_dir.is_dir():
        try:
            if not user_share_man.exists() and not user_share_man.is_symlink():
                (Path.home() / "share").mkdir(parents=True, exist_ok=True)
                user_share_man.symlink_to(local_man_dir)
            elif user_share_man.is_symlink():
                user_share_man.unlink()
                user_share_man.symlink_to(local_man_dir)
        except OSError:
            pass

    ctx.executed_job_flags.add(func_name)


