##
# 등록된 SSH 공개키를 저장소 최신 내용으로 비교·교체 업데이트합니다.
#
# @param $1 {string} SSH 공개키 식별자
# @param $2 {string} 매니페스트 파일 경로
# @param $3 {string} 드라이런 여부 (true | false)
#
# @return 0
##
_update_ssh_key() {
  local key_id="$1"
  local meta_file="$2"
  local is_dry_run="${3:-false}"

  echo
  echo "############### _update_ssh_key - $key_id ###############"

  local new_pub
  if ! new_pub="$(_resolve_ssh_key_content "$key_id")"; then
    echo_e " - [❌] SSH 공개키('$key_id')를 저장소에서 불러올 수 없어 생략합니다."
    _add_notice " - [_update_ssh_key] [❌] SSH 공개키('$key_id') 로드 실패"
    return 0
  fi

  local new_body new_comment old_body auth_file
  new_body="$(echo "$new_pub" | awk '{print $2}')"
  new_comment="$(echo "$new_pub" | cut -d' ' -f3-)"
  old_body="$(_manifest_get_field "$meta_file" "KEY_BODY" || true)"
  auth_file="$(_manifest_get_field "$meta_file" "AUTH_FILE" || echo "${HOME}/.ssh/authorized_keys")"

  if [[ -n "$old_body" && "$old_body" == "$new_body" ]] && [[ -f "$auth_file" ]] && grep -qF "$new_body" "$auth_file" 2>/dev/null; then
    echo_w " - '$key_id' SSH 공개키가 이미 최신입니다."
    return 0
  fi

  if [[ "$is_dry_run" == "true" ]]; then
    echo_i " - [DRY-RUN] '$key_id' SSH 공개키를 최신 내용으로 교체 예정 ($auth_file)"
    return 0
  fi

  local ssh_dir
  ssh_dir="$(dirname "$auth_file")"
  [[ -d "$ssh_dir" ]] || { mkdir -p "$ssh_dir" && chmod 700 "$ssh_dir"; }
  [[ -f "$auth_file" ]] || { touch "$auth_file" && chmod 600 "$auth_file"; }

  if [[ -n "$old_body" ]] && grep -qF "$old_body" "$auth_file" 2>/dev/null; then
    local tmp_auth
    tmp_auth="$(mktemp "/tmp/sciectl_auth.XXXXXX")"
    grep -vF "$old_body" "$auth_file" > "$tmp_auth" || true
    mv "$tmp_auth" "$auth_file"
    chmod 600 "$auth_file"
  fi

  if ! grep -qF "$new_body" "$auth_file" 2>/dev/null; then
    echo "$new_pub" >> "$auth_file"
  fi
  chmod 600 "$auth_file"

  _manifest_save_key "$key_id" "$new_body" "$new_comment" "$auth_file"
  echo_i " - '$key_id' SSH 공개키를 최신 버전으로 교체 업데이트했습니다. ($auth_file)"
}

##
# 매니페스트에 기록된 SSH 공개키를 authorized_keys 및 매니페스트에서 제거합니다.
#
# @param $1 {string} SSH 공개키 식별자
# @param $2 {string} 매니페스트 파일 경로
# @param $3 {string} 드라이런 여부 (true | false)
#
# @return 0
##
_remove_ssh_key() {
  local key_id="$1"
  local meta_file="$2"
  local is_dry_run="${3:-false}"

  echo
  echo "############### _remove_ssh_key - $key_id ###############"

  local key_body auth_file
  key_body="$(_manifest_get_field "$meta_file" "KEY_BODY" || true)"
  auth_file="$(_manifest_get_field "$meta_file" "AUTH_FILE" || echo "${HOME}/.ssh/authorized_keys")"

  if [[ "$is_dry_run" == "true" ]]; then
    echo_i " - [DRY-RUN] '$key_id' SSH 공개키 제거 예정 ($auth_file)"
    echo_i " - [DRY-RUN] 매니페스트 삭제 예정 ($meta_file)"
    return 0
  fi

  if [[ -f "$auth_file" && -n "$key_body" ]] && grep -qF "$key_body" "$auth_file" 2>/dev/null; then
    local tmp_auth
    tmp_auth="$(mktemp "/tmp/sciectl_auth.XXXXXX")"
    grep -vF "$key_body" "$auth_file" > "$tmp_auth" || true
    mv "$tmp_auth" "$auth_file"
    chmod 600 "$auth_file"
    echo_i " - '$key_id' SSH 공개키를 제거했습니다. ($auth_file)"
  else
    echo_w " - '$key_id' SSH 공개키가 '$auth_file'에 존재하지 않습니다."
  fi

  _manifest_delete_key "$key_id"
}

##
# 매니페스트에 기록된 CLI 도구 및 연관 파일(.completion, man 페이지)을 제거합니다.
#
# @param $1 {string} 매니페스트 파일 경로
# @param $2 {string} 드라이런 여부 (true | false)
#
# @return 0
##
_remove_tool_by_meta() {
  local meta_file="$1"
  local is_dry_run="${2:-false}"

  local cmd_name target_scope bin_path comp_path man_paths
  cmd_name="$(_manifest_get_field "$meta_file" "CMD_NAME" || true)"
  target_scope="$(_manifest_get_field "$meta_file" "TARGET_SCOPE" || echo "local")"
  bin_path="$(_manifest_get_field "$meta_file" "BIN_PATH" || true)"
  comp_path="$(_manifest_get_field "$meta_file" "COMPLETION_PATH" || true)"
  man_paths="$(_manifest_get_field "$meta_file" "MAN_PATHS" || true)"

  echo
  echo "############### _remove_tool - $cmd_name ($target_scope) ###############"

  local -a remove_targets=()
  [[ -n "$bin_path" && -f "$bin_path" ]] && remove_targets+=("$bin_path")
  [[ -n "$comp_path" && -f "$comp_path" ]] && remove_targets+=("$comp_path")

  local any_man=0
  if [[ -n "$man_paths" ]]; then
    local -a m_arr=()
    IFS=':' read -ra m_arr <<< "$man_paths"
    local mp
    for mp in "${m_arr[@]}"; do
      if [[ -n "$mp" && -f "$mp" ]]; then
        remove_targets+=("$mp")
        any_man=1
      fi
    done
  fi

  if [[ "$is_dry_run" == "true" ]]; then
    local rt
    for rt in "${remove_targets[@]}"; do
      echo_i " - [DRY-RUN] 삭제 예정: $rt"
    done
    echo_i " - [DRY-RUN] 매니페스트 삭제 예정: $meta_file"
    return 0
  fi

  local rt
  for rt in "${remove_targets[@]}"; do
    if [[ -w "$rt" && -w "$(dirname "$rt")" ]]; then
      rm -f -- "$rt"
    else
      sudo rm -f -- "$rt"
    fi
    echo_i " - 파일을 삭제했습니다: $rt"
  done

  if (( any_man == 1 )) && command -v mandb &>/dev/null; then
    if [[ "$target_scope" == "global" ]]; then
      sudo mandb -q >/dev/null 2>&1 || true
    else
      mandb -q "${XDG_DATA_HOME:-$HOME/.local/share}/man" >/dev/null 2>&1 || true
    fi
  fi

  _manifest_delete_tool "$cmd_name" "$target_scope"
  echo_i " - '$cmd_name' 도구 및 매니페스트 제거가 완료되었습니다."
}

##
# 현재 설치된 도구 및 SSH 키 목록을 테이블로 출력하고 번호 또는 '*'로 선택받습니다.
#
# @param $1 {string} 작업 모드 (update | remove)
# @param $2 {string} 범위 필터 (all | local | global)
#
# @return 선택된 레코드들을 전역 배열 SELECTED_MANAGE_RECORDS에 저장 (취소/없음 시 return 1)
##
SELECTED_MANAGE_RECORDS=()
_interactive_select_installed_items() {
  local mode="$1"
  local scope_filter="${2:-all}"
  SELECTED_MANAGE_RECORDS=()

  local -a raw_records=()
  local rec
  while IFS= read -r rec; do
    [[ -n "$rec" ]] && raw_records+=("$rec")
  done < <(_manifest_list_installed "$scope_filter")

  if (( ${#raw_records[@]} == 0 )); then
    echo_w " - [💡] 현재 sciectl로 설치된 도구 또는 등록된 SSH 공개키가 없습니다." >&2
    return 1
  fi

  # 기본 정렬: Identifier 오름차순
  local -a sorted_records=()
  local srec r_type r_id r_name r_scope r_ver r_path r_meta updated_at
  while IFS= read -r srec; do
    [[ -n "$srec" ]] && sorted_records+=("$srec")
  done < <(_sort_installed_records "id" "${raw_records[@]}")

  local -a selectable_records=()
  local -a up_to_date_rows=()
  local -a unknown_rows=()
  local -a updatable_rows=()

  if [[ "$mode" == "update" ]]; then
    local -a raw_for_check=()
    for srec in "${sorted_records[@]}"; do
      IFS='|' read -r r_type r_id r_name r_scope r_ver r_path r_meta updated_at <<< "$srec"
      raw_for_check+=("${r_type}|${r_id}|${r_name}|${r_scope}|${r_ver}|${r_path}|${r_meta}")
    done

    if ! _check_records_update_status "${raw_for_check[@]}"; then
      echo_e " - [❌] 원격 저장소에 연결할 수 없어 업데이트 여부를 확인할 수 없습니다." >&2
      if _detect_local_repo 2>/dev/null || [[ -d "${PWD}/env/catalogs" ]]; then
        echo_w "   💡 로컬 저장소를 사용하려면 '--local' 옵션을 함께 지정하세요." >&2
      fi
      return 1
    fi

    local idx_upd=1
    for srec in "${sorted_records[@]}"; do
      IFS='|' read -r r_type r_id r_name r_scope r_ver r_path r_meta updated_at <<< "$srec"
      local base_rec="${r_type}|${r_id}|${r_name}|${r_scope}|${r_ver}|${r_path}|${r_meta}"
      local st="${REC_UPDATE_STATUS[$r_meta]:-unknown}"
      if [[ "$st" == "updatable" ]]; then
        local rem_ver="${REC_REMOTE_VER[$r_meta]:-latest}"
        local ver_disp="${r_ver} -> ${rem_ver}"
        updatable_rows+=("$(printf '%3d)' "$idx_upd")|${r_type}|${r_id}|${r_scope}|${ver_disp}|${updated_at}|${r_path}")
        selectable_records+=("$base_rec")
        ((idx_upd++))
      elif [[ "$st" == "up-to-date" ]]; then
        up_to_date_rows+=("  - |${r_type}|${r_id}|${r_scope}|${r_ver}|${updated_at}|${r_path}")
      else
        unknown_rows+=("  ? |${r_type}|${r_id}|${r_scope}|${r_ver}|${updated_at}|${r_path}")
      fi
    done

    if (( ${#up_to_date_rows[@]} > 0 )); then
      _print_dynamic_installed_table "✅ 최신 버전 (${#up_to_date_rows[@]}개)" "stderr" "${up_to_date_rows[@]}"
    fi

    if (( ${#unknown_rows[@]} > 0 )); then
      _print_dynamic_installed_table "⚠️  버전 확인 실패 (${#unknown_rows[@]}개 - 네트워크/원격 응답 오류)" "stderr" "${unknown_rows[@]}"
    fi

    if (( ${#updatable_rows[@]} == 0 )); then
      if (( ${#unknown_rows[@]} > 0 )); then
        echo_w " - [⚠️] 업데이트 가능한 항목이 없습니다 (버전 확인 실패 ${#unknown_rows[@]}건 포함)." >&2
      else
        echo_i " - [💡] 모든 설치 항목(${#sorted_records[@]}개)이 이미 최신 버전입니다." >&2
      fi
      return 1
    fi
  else
    local idx_rem=1
    for srec in "${sorted_records[@]}"; do
      IFS='|' read -r r_type r_id r_name r_scope r_ver r_path r_meta updated_at <<< "$srec"
      selectable_records+=("${r_type}|${r_id}|${r_name}|${r_scope}|${r_ver}|${r_path}|${r_meta}")
      updatable_rows+=("$(printf '%3d)' "$idx_rem")|${r_type}|${r_id}|${r_scope}|${r_ver}|${updated_at}|${r_path}")
      ((idx_rem++))
    done
  fi

  local total="${#selectable_records[@]}"
  local action_label="업데이트"
  local table_title="🔄 업데이트 가능 목록 (${total}개) - [업데이트 대상 선택]"
  if [[ "$mode" == "remove" ]]; then
    action_label="제거"
    table_title="📦 현재 설치된 관리 대상 목록 (${total}개) - [제거 대상 선택]"
  fi

  while true; do
    _print_dynamic_installed_table "$table_title" "stderr" "${updatable_rows[@]}"

    local choice_line=""
    echo -n "> 🛠️  ${action_label}할 번호를 입력하세요 (예: 1 3, 1-4, 전체: *) [취소: Enter 또는 q]: " >&2
    read -r choice_line

    local trimmed
    trimmed="$(echo "$choice_line" | xargs)"
    if [[ -z "$trimmed" || "$trimmed" == "q" || "$trimmed" == "Q" ]]; then
      echo_w " - [🛑] ${action_label} 선택을 취소했습니다." >&2
      return 1
    fi

    if [[ "$trimmed" == "*" || "$trimmed" == "all" || "$trimmed" == "ALL" ]]; then
      SELECTED_MANAGE_RECORDS=("${selectable_records[@]}")
      return 0
    fi

    choice_line="${choice_line//,/ }"
    local -a tokens=()
    read -ra tokens <<< "$choice_line"

    declare -A seen_idx=()
    local -a picked_indices=()
    local valid=true
    local tok
    for tok in "${tokens[@]}"; do
      if [[ "$tok" =~ ^([0-9]+)-([0-9]+)$ ]]; then
        local s="${BASH_REMATCH[1]}"
        local e="${BASH_REMATCH[2]}"
        if (( s < 1 || e > total || s > e )); then
          echo_w "⚠️  - 잘못된 범위입니다 ($tok). 1에서 $total 사이의 범위를 입력하세요." >&2
          valid=false
          break
        fi
        local n
        for (( n=s; n<=e; n++ )); do
          if [[ -z "${seen_idx[$n]:-}" ]]; then
            seen_idx["$n"]=1
            picked_indices+=("$n")
          fi
        done
      elif [[ "$tok" =~ ^[0-9]+$ ]]; then
        if (( tok < 1 || tok > total )); then
          echo_w "⚠️  - 잘못된 번호입니다 ($tok). 1에서 $total 사이의 숫자를 입력하세요." >&2
          valid=false
          break
        fi
        if [[ -z "${seen_idx[$tok]:-}" ]]; then
          seen_idx["$tok"]=1
          picked_indices+=("$tok")
        fi
      else
        echo_w "⚠️  - 잘못된 입력입니다: '$tok' (숫자, 범위 예: 1-3, 또는 * 만 입력 가능)" >&2
        valid=false
        break
      fi
    done

    [[ "$valid" == true ]] || continue
    (( ${#picked_indices[@]} > 0 )) || continue

    local idx
    for idx in "${picked_indices[@]}"; do
      SELECTED_MANAGE_RECORDS+=("${selectable_records[$((idx - 1))]}")
    done
    return 0
  done
}

##
# update 및 remove 서브커맨드의 공통 CLI 옵션을 파싱하여 전역 변수에 설정합니다.
#
# @param $1 {string} 서브커맨드 이름 (update | remove)
# @param $@ {array} 나머지 인자
#
# @return 0
##
_parse_manage_options() {
  local subcmd="$1"
  shift

  M_RAW_CATALOGS=""
  M_RAW_TOOLS=""
  M_RAW_SSH_KEYS=""
  M_TARGET_SCOPE="all"
  M_AUTO_YES="false"
  M_FORCE_OVERWRITE="false"
  M_IS_DRY_RUN="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --catalog|--catalog=*)
        if [[ "$1" == *=* ]]; then
          M_RAW_CATALOGS+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--catalog' 옵션 뒤에 카탈로그 ID를 지정하세요." "$LINENO" "$subcmd"
          M_RAW_CATALOGS+=",${2}"
          shift 2
        fi
        ;;
      --tool|--tool=*)
        if [[ "$1" == *=* ]]; then
          M_RAW_TOOLS+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--tool' 옵션 뒤에 도구 식별자를 지정하세요." "$LINENO" "$subcmd"
          M_RAW_TOOLS+=",${2}"
          shift 2
        fi
        ;;
      --ssh-key|--ssh-key=*)
        if [[ "$1" == *=* ]]; then
          M_RAW_SSH_KEYS+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--ssh-key' 옵션 뒤에 SSH 공개키 식별자를 지정하세요." "$LINENO" "$subcmd"
          M_RAW_SSH_KEYS+=",${2}"
          shift 2
        fi
        ;;
      --installer|--installer=*|--command|--command=*)
        error_exit "'$subcmd' 명령에서는 '--installer' 및 '--command' 옵션을 지원하지 않습니다 (도구 및 SSH 키만 관리 가능)." "$LINENO" "$subcmd"
        ;;
      --target|--target=*)
        if [[ "$1" == *=* ]]; then
          M_TARGET_SCOPE="${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--target' 옵션 뒤에 local 또는 global을 지정하세요." "$LINENO" "$subcmd"
          M_TARGET_SCOPE="$2"
          shift 2
        fi
        ;;
      --local)
        SOURCE_MODE="local"
        shift
        ;;
      --remote)
        SOURCE_MODE="remote"
        shift
        ;;
      --no-update|--force-update)
        shift
        ;;
      --version)
        printf '%s version %s\n' "$FILENAME" "$SCRIPT_FILE_VERSION"
        exit 0
        ;;
      --yes)
        M_AUTO_YES="true"
        shift
        ;;
      --force)
        M_FORCE_OVERWRITE="true"
        shift
        ;;
      --dry-run)
        M_IS_DRY_RUN="true"
        shift
        ;;
      --help)
        help "" "" "$subcmd"
        exit 0
        ;;
      *)
        error_exit "지원하지 않는 옵션입니다: $1" "$LINENO" "$subcmd"
        ;;
    esac
  done

  if [[ "$M_TARGET_SCOPE" != "all" && "$M_TARGET_SCOPE" != "local" && "$M_TARGET_SCOPE" != "global" ]]; then
    error_exit "'--target' 옵션 값은 'local' 또는 'global'만 허용됩니다: '$M_TARGET_SCOPE'" "$LINENO" "$subcmd"
  fi
}

##
# 지정된 --catalog, --tool, --ssh-key 옵션을 현재 설치된 매니페스트 레코드와 매칭하여 필터링합니다.
#
# @param 없음 (M_RAW_*, M_TARGET_SCOPE 전역 변수 사용)
#
# @return 매칭된 레코드를 SELECTED_MANAGE_RECORDS에 저장 (없으면 return 1)
##
_resolve_manage_targets() {
  SELECTED_MANAGE_RECORDS=()

  if [[ -n "$M_RAW_CATALOGS" ]]; then
    load_catalogs_index
    local -a cat_list=()
    IFS=',' read -ra cat_list <<< "$M_RAW_CATALOGS"
    local cid
    for cid in "${cat_list[@]}"; do
      cid="$(echo "$cid" | xargs)"
      [[ -n "$cid" ]] && resolve_catalog "$cid"
    done
  fi

  _add_tx_items "tool" "$M_RAW_TOOLS"
  _add_tx_items "ssh_key" "$M_RAW_SSH_KEYS"

  local -a installed_all=()
  local rec
  while IFS= read -r rec; do
    [[ -n "$rec" ]] && installed_all+=("$rec")
  done < <(_manifest_list_installed "$M_TARGET_SCOPE")

  if (( ${#installed_all[@]} == 0 )); then
    echo_w " - [💡] 현재 설치된 도구 또는 등록된 SSH 공개키가 없습니다."
    return 1
  fi

  declare -A matched_keys=()
  local req_tool r r_type r_id r_name r_scope r_ver r_path r_meta
  for req_tool in "${TX_TOOLS[@]}"; do
    [[ -n "$req_tool" ]] || continue
    local req_cmd
    req_cmd="$(basename "$req_tool")"
    local found_t=0
    for r in "${installed_all[@]}"; do
      IFS='|' read -r r_type r_id r_name r_scope r_ver r_path r_meta <<< "$r"
      [[ "$r_type" == "tool" ]] || continue
      if [[ "$r_id" == "$req_tool" || "$r_name" == "$req_cmd" ]]; then
        if [[ -z "${matched_keys[$r_meta]:-}" ]]; then
          matched_keys["$r_meta"]=1
          SELECTED_MANAGE_RECORDS+=("$r")
        fi
        found_t=1
      fi
    done
    if (( found_t == 0 )); then
      echo_w " - [⚠️] 설치되지 않은 도구이므로 건너뜁니다: $req_tool"
    fi
  done

  local req_key
  for req_key in "${TX_SSH_KEYS[@]}"; do
    [[ -n "$req_key" ]] || continue
    local found_k=0
    for r in "${installed_all[@]}"; do
      IFS='|' read -r r_type r_id r_name r_scope r_ver r_path r_meta <<< "$r"
      [[ "$r_type" == "ssh-key" ]] || continue
      if [[ "$r_id" == "$req_key" ]]; then
        if [[ -z "${matched_keys[$r_meta]:-}" ]]; then
          matched_keys["$r_meta"]=1
          SELECTED_MANAGE_RECORDS+=("$r")
        fi
        found_k=1
      fi
    done
    if (( found_k == 0 )); then
      echo_w " - [⚠️] 등록되지 않은 SSH 공개키이므로 건너뜁니다: $req_key"
    fi
  done

  if (( ${#SELECTED_MANAGE_RECORDS[@]} == 0 )); then
    echo_w " - [💡] 조건에 해당하는 설치된 관리 대상이 없습니다."
    return 1
  fi
  return 0
}

##
# [update 서브커맨드] 설치된 CLI 도구 및 등록된 SSH 공개키를 최신 버전으로 업데이트합니다.
#
# @param $@ {array} update 서브커맨드 인자
#
# @return 0
##
cmd_update() {
  _parse_manage_options "update" "$@"

  if [[ -n "$M_RAW_CATALOGS" || -n "$M_RAW_TOOLS" || -n "$M_RAW_SSH_KEYS" ]]; then
    _resolve_manage_targets || exit 0
  else
    _interactive_select_installed_items "update" "$M_TARGET_SCOPE" || exit 0
  fi

  echo
  echo "================================================================================"
  echo -e "${COLOR_BOLD}🔄 Update Transaction Summary (${#SELECTED_MANAGE_RECORDS[@]}개 대상)${COLOR_NC}"
  echo "================================================================================"
  local r r_type r_id r_name r_scope r_ver r_path r_meta
  for r in "${SELECTED_MANAGE_RECORDS[@]}"; do
    IFS='|' read -r r_type r_id r_name r_scope r_ver r_path r_meta <<< "$r"
    printf "  - [%-7s] %-28s (scope: %-6s, current: %s)\n" "$r_type" "$r_id" "$r_scope" "$r_ver"
  done
  echo "================================================================================"

  if [[ "$M_IS_DRY_RUN" != "true" && "$M_AUTO_YES" != "true" && -t 0 ]]; then
    local confirm=""
    read -r -p "> 위 대상에 대해 업데이트를 진행하시겠습니까? (y/Enter: 취소): " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
      echo_w " - [🛑] 사용자가 업데이트를 취소했습니다."
      rm -f -- "$NOTICE_MESSAGES_TEMP_FILE"
      exit 0
    fi
  fi

  for r in "${SELECTED_MANAGE_RECORDS[@]}"; do
    IFS='|' read -r r_type r_id r_name r_scope r_ver r_path r_meta <<< "$r"
    if [[ "$r_type" == "tool" ]]; then
      if [[ "$M_IS_DRY_RUN" == "true" ]]; then
        echo_i " - [DRY-RUN] '$r_id' ($r_scope) 업데이트 확인 예정 ($r_path)"
      else
        # 사용자가 이미 대상 선택 및 트랜잭션 최종 승인을 완료했으므로 개별 도구/companion 확인 생략
        _install_tool "$r_id" "$r_scope" "$M_FORCE_OVERWRITE" "true"
      fi
    elif [[ "$r_type" == "ssh-key" ]]; then
      _update_ssh_key "$r_id" "$r_meta" "$M_IS_DRY_RUN"
    fi
  done

  _announce_notices
  echo
  if [[ "$M_IS_DRY_RUN" == "true" ]]; then
    echo_i "🔍 [--dry-run] 시뮬레이션 모드이므로 실제 업데이트를 수행하지 않고 종료합니다."
  else
    echo_i "✅ 모든 업데이트 작업이 완료되었습니다."
  fi
}

##
# [remove 서브커맨드] 설치된 CLI 도구(연관 파일 포함) 및 등록된 SSH 공개키를 제거합니다.
#
# @param $@ {array} remove 서브커맨드 인자
#
# @return 0
##
cmd_remove() {
  _parse_manage_options "remove" "$@"

  if [[ -n "$M_RAW_CATALOGS" || -n "$M_RAW_TOOLS" || -n "$M_RAW_SSH_KEYS" ]]; then
    _resolve_manage_targets || exit 0
  else
    _interactive_select_installed_items "remove" "$M_TARGET_SCOPE" || exit 0
  fi

  echo
  echo "================================================================================"
  echo -e "${COLOR_BOLD}🗑️  Remove Transaction Summary (${#SELECTED_MANAGE_RECORDS[@]}개 대상)${COLOR_NC}"
  echo "================================================================================"
  local r r_type r_id r_name r_scope r_ver r_path r_meta
  for r in "${SELECTED_MANAGE_RECORDS[@]}"; do
    IFS='|' read -r r_type r_id r_name r_scope r_ver r_path r_meta <<< "$r"
    printf "  - [%-7s] %-28s (scope: %-6s, path: %s)\n" "$r_type" "$r_id" "$r_scope" "$r_path"
  done
  echo "================================================================================"

  if [[ "$M_IS_DRY_RUN" != "true" && "$M_AUTO_YES" != "true" && -t 0 ]]; then
    local confirm=""
    read -r -p "> 위 대상을 시스템에서 정말 제거하시겠습니까? (y/Enter: 취소): " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
      echo_w " - [🛑] 사용자가 제거를 취소했습니다."
      rm -f -- "$NOTICE_MESSAGES_TEMP_FILE"
      exit 0
    fi
  fi

  for r in "${SELECTED_MANAGE_RECORDS[@]}"; do
    IFS='|' read -r r_type r_id r_name r_scope r_ver r_path r_meta <<< "$r"
    if [[ "$r_type" == "tool" ]]; then
      _remove_tool_by_meta "$r_meta" "$M_IS_DRY_RUN"
    elif [[ "$r_type" == "ssh-key" ]]; then
      _remove_ssh_key "$r_id" "$r_meta" "$M_IS_DRY_RUN"
    fi
  done

  _announce_notices
  echo
  if [[ "$M_IS_DRY_RUN" == "true" ]]; then
    echo_i "🔍 [--dry-run] 시뮬레이션 모드이므로 실제 삭제를 수행하지 않고 종료합니다."
  else
    echo_i "✅ 모든 제거 작업이 완료되었습니다."
  fi
}

##
# [install 서브커맨드] 카탈로그 및 개별 컴포넌트를 트랜잭션 파이프라인으로 설치합니다.
#
# @param $@ {array} install 서브커맨드 인자
#
# @return 0
##
cmd_install() {
  local raw_catalogs=""
  local raw_tools=""
  local raw_installers=""
  local raw_commands=""
  local raw_ssh_keys=""
  local only_steps=""
  local skip_steps=""
  local target_user=""
  local target_scope="local"
  local auto_yes="false"
  local force_overwrite="false"
  local is_dry_run="false"
  local no_default_opts="false"
  local legacy_step_selected="false"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --catalog|--catalog=*)
        if [[ "$1" == *=* ]]; then
          raw_catalogs+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--catalog' 옵션 뒤에 카탈로그 ID를 지정하세요." "$LINENO" "install"
          raw_catalogs+=",${2}"
          shift 2
        fi
        ;;
      --tool|--tool=*)
        if [[ "$1" == *=* ]]; then
          raw_tools+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--tool' 옵션 뒤에 도구 식별자(예: git/git-commit)를 지정하세요." "$LINENO" "install"
          raw_tools+=",${2}"
          shift 2
        fi
        ;;
      --installer|--installer=*)
        if [[ "$1" == *=* ]]; then
          raw_installers+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--installer' 옵션 뒤에 인스톨러 식별자(예: install-temurin-25-jdk)를 지정하세요." "$LINENO" "install"
          raw_installers+=",${2}"
          shift 2
        fi
        ;;
      --command|--command=*)
        if [[ "$1" == *=* ]]; then
          raw_commands+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--command' 옵션 뒤에 명령어 식별자를 지정하세요." "$LINENO" "install"
          raw_commands+=",${2}"
          shift 2
        fi
        ;;
      --ssh-key|--ssh-key=*)
        if [[ "$1" == *=* ]]; then
          raw_ssh_keys+=",${1#*=}"
          shift
        else
          if [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]]; then
            raw_ssh_keys+=",${2}"
            shift 2
          else
            # 레거시 단독 플래그 호환 (--ssh-key)
            only_steps+=",ssh-key"
            legacy_step_selected="true"
            no_default_opts="true"
            shift
          fi
        fi
        ;;
      --only|--only=*)
        if [[ "$1" == *=* ]]; then
          only_steps+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--only' 옵션 뒤에 실행할 단계 목록을 지정하세요." "$LINENO" "install"
          only_steps+=",${2}"
          shift 2
        fi
        ;;
      --skip|--skip=*)
        if [[ "$1" == *=* ]]; then
          skip_steps+=",${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--skip' 옵션 뒤에 제외할 단계 목록을 지정하세요." "$LINENO" "install"
          skip_steps+=",${2}"
          shift 2
        fi
        ;;
      --user|--user=*)
        if [[ "$1" == *=* ]]; then
          target_user="${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--user' 옵션 뒤에 사용자 계정명을 지정하세요." "$LINENO" "install"
          target_user="$2"
          shift 2
        fi
        ;;
      --target|--target=*)
        if [[ "$1" == *=* ]]; then
          target_scope="${1#*=}"
          shift
        else
          [[ $# -ge 2 && -n "${2:-}" && "${2:-}" != -* ]] || error_exit "'--target' 옵션 뒤에 local 또는 global을 지정하세요." "$LINENO" "install"
          target_scope="$2"
          shift 2
        fi
        ;;
      --local)
        SOURCE_MODE="local"
        shift
        ;;
      --remote)
        SOURCE_MODE="remote"
        shift
        ;;
      --no-update)
        shift
        ;;
      --force-update)
        shift
        ;;
      --version)
        printf '%s version %s\n' "$FILENAME" "$SCRIPT_FILE_VERSION"
        exit 0
        ;;
      --yes)
        auto_yes="true"
        shift
        ;;
      --force)
        force_overwrite="true"
        shift
        ;;
      --dry-run)
        is_dry_run="true"
        shift
        ;;
      --all)
        only_steps=""
        no_default_opts="false"
        shift
        ;;
      --add-sudoers)
        only_steps+=",sudoers"
        legacy_step_selected="true"
        no_default_opts="true"
        shift
        ;;
      --remove-packages)
        only_steps+=",remove-packages"
        legacy_step_selected="true"
        no_default_opts="true"
        shift
        ;;
      --install-packages)
        only_steps+=",install-packages"
        legacy_step_selected="true"
        no_default_opts="true"
        shift
        ;;
      --custom-tools)
        only_steps+=",tools"
        legacy_step_selected="true"
        no_default_opts="true"
        shift
        ;;
      --custom-installers)
        only_steps+=",installers"
        legacy_step_selected="true"
        no_default_opts="true"
        shift
        ;;
      --custom-commands)
        only_steps+=",commands"
        legacy_step_selected="true"
        no_default_opts="true"
        shift
        ;;
      --no-default-opts)
        no_default_opts="true"
        shift
        ;;
      --help)
        help "" "" "install"
        exit 0
        ;;
      *)
        error_exit "지원하지 않는 옵션입니다: $1" "$LINENO" "install"
        ;;
    esac
  done

  if [[ "$target_scope" != "local" && "$target_scope" != "global" ]]; then
    error_exit "'--target' 옵션 값은 'local' 또는 'global'만 허용됩니다: '$target_scope'" "$LINENO" "install"
  fi

  local has_direct_component="false"
  if [[ -n "$raw_tools" || -n "$raw_installers" || -n "$raw_commands" || -n "$raw_ssh_keys" ]]; then
    has_direct_component="true"
  fi

  # 1. 카탈로그 해석 (미지정 및 직접 컴포넌트도 없으면 대화형 카탈로그 선택)
  if [[ -n "$raw_catalogs" ]]; then
    load_catalogs_index
    local -a cat_list=()
    IFS=',' read -ra cat_list <<< "$raw_catalogs"
    local cid
    for cid in "${cat_list[@]}"; do
      cid="$(echo "$cid" | xargs)"
      [[ -n "$cid" ]] && resolve_catalog "$cid"
    done
  elif [[ "$has_direct_component" == "false" ]]; then
    if ! interactive_select_catalogs; then
      exit 0
    fi
  else
    no_default_opts="true"
  fi

  # 2. 직접 지정된 컴포넌트 병합
  _add_tx_items "tool"      "$raw_tools"
  _add_tx_items "installer" "$raw_installers"
  _add_tx_items "command"   "$raw_commands"
  _add_tx_items "ssh_key"   "$raw_ssh_keys"

  # 3. 대화형 모드에서 단계 필터(--only)가 지정되지 않았고 --yes도 아니면 단계 선택 메뉴 제공
  if [[ -z "$raw_catalogs" && "$has_direct_component" == "false" && -z "$only_steps" && "$auto_yes" == "false" ]]; then
    local -a avail_opts=()
    declare -A opt_desc=()
    if (( ${#TX_REMOVE_PKGS[@]} > 0 )); then
      avail_opts+=("remove-packages")
      opt_desc["remove-packages"]="사용하지 않을 OS 패키지를 삭제합니다. (${TX_REMOVE_PKGS[*]})"
    fi
    if (( ${#TX_SUDOERS_CMDS[@]} > 0 )); then
      avail_opts+=("sudoers")
      opt_desc["sudoers"]="특정 사용자를 'sudoers'에 추가합니다. (${#TX_SUDOERS_CMDS[@]}개 명령어)"
    fi
    if (( ${#TX_INSTALL_PKGS[@]} > 0 )); then
      avail_opts+=("install-packages")
      opt_desc["install-packages"]="기본 OS 패키지를 설치합니다. (${TX_INSTALL_PKGS[*]})"
    fi
    if (( ${#TX_INSTALLERS[@]} > 0 )); then
      avail_opts+=("installers")
      opt_desc["installers"]="소프트웨어 인스톨러 스크립트를 실행합니다. (${TX_INSTALLERS[*]})"
    fi
    if (( ${#TX_TOOLS[@]} > 0 )); then
      avail_opts+=("tools")
      opt_desc["tools"]="CLI 도구 및 자동완성을 설치합니다. (${#TX_TOOLS[@]}개 도구)"
    fi
    if (( ${#TX_COMMANDS[@]} > 0 )); then
      avail_opts+=("commands")
      opt_desc["commands"]="사후 구성 명령어를 실행합니다. (${TX_COMMANDS[*]})"
    fi
    if (( ${#TX_SSH_KEYS[@]} > 0 )); then
      avail_opts+=("ssh-key")
      opt_desc["ssh-key"]="SSH 접속용 RSA 공개키를 등록합니다. (${TX_SSH_KEYS[*]})"
    fi

    if (( ${#avail_opts[@]} == 0 )); then
      echo_w " - [💡] 선택한 카탈로그에 적용할 설치 항목이 없습니다."
      exit 0
    fi

    echo
    echo "================================================================================"
    echo_i "선택한 카탈로그에서 실행 가능한 단계는 다음과 같습니다."
    echo
    printf "  [ 0] %-20s : %s\n" "--all" "모든 단계 및 기본 환경 설정(~/bin, git 프롬프트, vimrc)을 일괄 적용합니다."
    local idx=1
    local st
    for st in "${avail_opts[@]}"; do
      printf "  [%2d] %-20s : %s\n" "$idx" "--${st}" "${opt_desc[$st]}"
      ((idx++))
    done
    echo "================================================================================"
    local step_input=""
    read -r -p "> 적용할 옵션 번호를 입력하세요 (기본값: 0 [전체], 복수 선택 시 띄어쓰기 구분): " step_input
    step_input="${step_input:-0}"

    local -a s_nums=()
    read -ra s_nums <<< "${step_input//,/ }"
    local n
    for n in "${s_nums[@]}"; do
      if [[ "$n" == "0" ]]; then
        only_steps=""
        no_default_opts="false"
        break
      elif [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#avail_opts[@]} )); then
        only_steps+=",${avail_opts[$((n - 1))]}"
        no_default_opts="true"
      fi
    done
  fi

  # 4. 활성화 단계 계산
  local -a all_step_names=("sudoers" "remove-packages" "install-packages" "default-opts" "installers" "tools" "commands" "ssh-key")
  local active_steps_str=""

  if [[ -n "$only_steps" ]]; then
    no_default_opts="true"
    local -a o_arr=()
    IFS=',' read -ra o_arr <<< "$only_steps"
    local o
    for o in "${o_arr[@]}"; do
      o="$(echo "$o" | xargs)"
      [[ "$o" == "add-sudoers" ]] && o="sudoers"
      [[ "$o" == "custom-tools" ]] && o="tools"
      [[ "$o" == "custom-installers" ]] && o="installers"
      [[ "$o" == "custom-commands" ]] && o="commands"
      [[ "$o" == "default-opts" ]] && no_default_opts="false"
      active_steps_str+=" $o "
    done
  else
    active_steps_str=" ${all_step_names[*]} "
  fi

  if [[ -n "$skip_steps" ]]; then
    local -a sk_arr=()
    IFS=',' read -ra sk_arr <<< "$skip_steps"
    local sk
    for sk in "${sk_arr[@]}"; do
      sk="$(echo "$sk" | xargs)"
      [[ "$sk" == "add-sudoers" ]] && sk="sudoers"
      [[ "$sk" == "custom-tools" ]] && sk="tools"
      [[ "$sk" == "custom-installers" ]] && sk="installers"
      [[ "$sk" == "custom-commands" ]] && sk="commands"
      active_steps_str="${active_steps_str// $sk / }"
    done
  fi

  local run_default=1
  if [[ "$no_default_opts" == "true" || "$active_steps_str" != *" default-opts "* ]]; then
    run_default=0
  fi

  # 5. Sudoers 실행 대상인 경우 실행 전에 사용자 계정 사전 확정 (중간 멈춤 방지!)
  if [[ "$TARGET_OS" != "darwin" && "$active_steps_str" == *" sudoers "* ]] && (( ${#TX_SUDOERS_CMDS[@]} > 0 )); then
    local current_user="${USER:-$(whoami)}"
    if [[ -z "$target_user" ]]; then
      if [[ "$auto_yes" == "true" || "$is_dry_run" == "true" || ! -t 0 ]]; then
        target_user="$current_user"
      else
        while true; do
          read -r -p "> [⌨️] sudoers에 등록할 사용자 계정을 입력하세요 (기본값: $current_user): " target_user
          target_user="${target_user:-$current_user}"
          if id "$target_user" &>/dev/null; then
            break
          else
            echo_w " - '$target_user' 사용자가 시스템에 존재하지 않습니다. 다시 입력해 주세요."
            target_user=""
          fi
        done
      fi
    else
      if ! id "$target_user" &>/dev/null && [[ "$is_dry_run" != "true" ]]; then
        error_exit "지정한 sudoers 대상 사용자('$target_user')가 시스템에 존재하지 않습니다." "$LINENO" "install"
      fi
    fi
  fi

  # 6. 트랜잭션 요약 출력 및 최종 1회 확인 (dnf/apt/pacman 스타일)
  _print_transaction_summary "$target_scope" "${target_user:-${USER:-$(whoami)}}" "$run_default" "$active_steps_str"

  if [[ "$is_dry_run" == "true" ]]; then
    echo_i "🔍 [--dry-run] 시뮬레이션 모드이므로 실제 설치를 수행하지 않고 종료합니다."
    rm -f -- "$NOTICE_MESSAGES_TEMP_FILE"
    exit 0
  fi

  if [[ "$auto_yes" != "true" && -t 0 ]]; then
    local confirm=""
    read -r -p "> 위 트랜잭션 계획대로 설치를 진행하시겠습니까? (y/Enter: 취소): " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
      echo_w " - [🛑] 사용자가 설치를 취소했습니다."
      rm -f -- "$NOTICE_MESSAGES_TEMP_FILE"
      exit 0
    fi
  fi

  # ==============================================================================
  # 7. 트랜잭션 일괄 실행 (엄격한 의존성 순서 보장)
  #    Step 1: sudoers
  #    Step 2: remove-packages
  #    Step 3: install-packages (vim 등 필수 OS 패키지 먼저 확보!)
  #    Step 4: default-opts (~/bin, git-prompt, vim 설치 후 vimrc 설정!)
  #    Step 5: installers (JDK, Maven, Docker 등)
  #    Step 6: tools (CLI 도구 + completion)
  #    Step 7: commands (방화벽 정책 등 사후 구성)
  #    Step 8: ssh-key (authorized_keys 등록)
  # ==============================================================================
  if [[ "$active_steps_str" == *" sudoers "* ]]; then
    setup_sudoers "$target_user"
  fi

  if [[ "$active_steps_str" == *" remove-packages "* ]]; then
    remove_packages
  fi

  if [[ "$active_steps_str" == *" install-packages "* ]]; then
    install_packages
  fi

  if (( run_default == 1 )); then
    _setup_home_bin
    _setup_git_prompt
    _install_vim_options
  fi

  if [[ "$active_steps_str" == *" installers "* ]]; then
    setup_installers
  fi

  if [[ "$active_steps_str" == *" tools "* ]]; then
    setup_tools "$target_scope" "$force_overwrite" "$auto_yes"
  fi

  if [[ "$active_steps_str" == *" commands "* ]]; then
    setup_commands
  fi

  if [[ "$active_steps_str" == *" ssh-key "* ]]; then
    setup_ssh_key
  fi

  _announce_notices
  echo
  echo_i "✅ 모든 트랜잭션 작업이 완료되었습니다."
}

# ==============================================================================
# 메인 엔트리포인트 (Main Dispatcher)
# ==============================================================================
main() {
  _check_and_self_update "$@"

  # 공통 플래그(--no-update, --force-update)를 추출하여 서브커맨드 디스패치에 영향이 없도록 정규화
  local -a normalized_args=()
  local arg
  for arg in "$@"; do
    case "$arg" in
      --no-update|--force-update)
        # 이미 _check_and_self_update에서 처리되었으므로 디스패치 인자에서 제외
        ;;
      *)
        normalized_args+=("$arg")
        ;;
    esac
  done

  set -- "${normalized_args[@]}"

  if [[ $# -eq 0 ]]; then
    cmd_install
    exit 0
  fi

  case "$1" in
    install)
      shift
      cmd_install "$@"
      ;;
    update)
      shift
      cmd_update "$@"
      ;;
    remove)
      shift
      cmd_remove "$@"
      ;;
    list)
      shift
      cmd_list "$@"
      ;;
    info)
      shift
      cmd_info "$@"
      ;;
    --help)
      help "" "" ""
      exit 0
      ;;
    --version)
      printf '%s version %s\n' "$FILENAME" "$SCRIPT_FILE_VERSION"
      exit 0
      ;;
    --*)
      # 서브커맨드 생략 후 바로 옵션(--catalog 등)을 입력한 경우 install로 위임
      cmd_install "$@"
      ;;
    *)
      error_exit "알 수 없는 명령어 또는 옵션입니다: '$1'" "$LINENO" ""
      ;;
  esac
}

main "$@"
exit 0
