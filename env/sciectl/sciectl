# ==============================================================================
# 스레드 기반 진행 시각화 (StepSpinner) 및 시그널 안전 종료
# ==============================================================================
class StepSpinner:
    """장시간 작업 및 원격 통신 시 stderr TTY에 회전 스피너와 경과 시간을 표시합니다."""

    FRAMES = ("⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏")

    def __init__(self, enabled: bool = True) -> None:
        self.enabled = enabled and sys.stderr.isatty()
        self._stop_event = threading.Event()
        self._lock = threading.Lock()
        self._thread: Optional[threading.Thread] = None
        self._label = ""
        self._start_ts = 0.0
        self._progress_text = ""

    def start(self, label: str) -> None:
        """지정된 레이블로 스피너 스레드를 시작합니다."""
        self.stop_line(clear_only=True)
        with self._lock:
            self._label = label
            self._progress_text = "진행 중..."
            self._start_ts = time.monotonic()
        if not self.enabled:
            return
        self._stop_event.clear()
        self._thread = threading.Thread(target=self._spin, daemon=True)
        self._thread.start()

    def update_progress(self, progress_text: str) -> None:
        """스피너 실행 중 동적 진행 텍스트(예: 3/10, 30%)를 갱신합니다."""
        with self._lock:
            self._progress_text = progress_text

    def _spin(self) -> None:
        idx = 0
        while not self._stop_event.is_set():
            with self._lock:
                label = self._label
                prog = self._progress_text
                elapsed = int(time.monotonic() - self._start_ts)
            frame = self.FRAMES[idx % len(self.FRAMES)]
            sys.stderr.write(f"\r\033[K  \033[36m{frame}\033[0m {label}: \033[2m{prog} ({elapsed}s)\033[0m")
            sys.stderr.flush()
            idx += 1
            self._stop_event.wait(0.15)

    def stop(self, result_text: str = "완료", ok: bool = True) -> None:
        """스피너를 중지하고 최종 상태 줄을 출력합니다."""
        self.stop_line(clear_only=False, result_text=result_text, ok=ok)

    def stop_line(self, clear_only: bool = False, result_text: str = "완료", ok: bool = True) -> None:
        """스피너 스레드를 안전하게 종료하고 현재 줄을 정리합니다."""
        if self._thread is not None:
            self._stop_event.set()
            self._thread.join(timeout=1.0)
            self._thread = None
        if not self.enabled:
            return
        if clear_only:
            sys.stderr.write("\r\033[K")
            sys.stderr.flush()
            return
        elapsed = int(time.monotonic() - self._start_ts)
        mark, color = ("✓", "\033[1;32m") if ok else ("✗", "\033[1;33m")
        sys.stderr.write(f"\r\033[K  {color}{mark}\033[0m {self._label}: {color}{result_text}\033[0m ({elapsed}s)\n")
        sys.stderr.flush()


ACTIVE_SPINNER = StepSpinner()
SHUTDOWN_REQUESTED = threading.Event()


# ==============================================================================
# 공지사항(Notice) 공유 파이프라인 (부모-자식 공유)
# ==============================================================================
NOTICE_LOCK = threading.Lock()
NOTICE_MESSAGES_TEMP_FILE = Path(f"/tmp/sciectl_notice_messages_{os.getpid()}.tmp")


def _init_notice_file() -> None:
    try:
        NOTICE_MESSAGES_TEMP_FILE.unlink(missing_ok=True)
    except OSError:
        pass
    try:
        NOTICE_MESSAGES_TEMP_FILE.touch()
    except OSError:
        pass


def _cleanup_temp_artifacts() -> None:
    ACTIVE_SPINNER.stop_line(clear_only=True)
    try:
        NOTICE_MESSAGES_TEMP_FILE.unlink(missing_ok=True)
    except OSError:
        pass


atexit.register(_cleanup_temp_artifacts)


def _handle_signal(signum: int, _frame) -> None:
    SHUTDOWN_REQUESTED.set()
    ACTIVE_SPINNER.stop_line(clear_only=True)
    sys.stderr.write("\n")
    sys.stderr.flush()
    sys.exit(128 + signum)


signal.signal(signal.SIGINT, _handle_signal)
signal.signal(signal.SIGTERM, _handle_signal)


def _add_notice(msg: str, forced: bool = True) -> None:
    """작업 완료 후 사용자에게 전달할 공지 메시지를 임시 파일에 누적 저장합니다."""
    if not msg:
        return
    with NOTICE_LOCK:
        try:
            if not forced and NOTICE_MESSAGES_TEMP_FILE.exists():
                existing = NOTICE_MESSAGES_TEMP_FILE.read_text(encoding="utf-8", errors="replace").splitlines()
                if msg in existing:
                    return
            with NOTICE_MESSAGES_TEMP_FILE.open("a", encoding="utf-8") as fp:
                fp.write(msg + "\n")
        except OSError:
            pass


def _announce_notices() -> None:
    """저장된 모든 공지 메시지를 출력하고 임시 파일을 정리합니다."""
    if not NOTICE_MESSAGES_TEMP_FILE.exists():
        return
    try:
        lines = [ln for ln in NOTICE_MESSAGES_TEMP_FILE.read_text(encoding="utf-8", errors="replace").splitlines() if ln]
    except OSError:
        lines = []
    try:
        NOTICE_MESSAGES_TEMP_FILE.unlink(missing_ok=True)
    except OSError:
        pass
    if not lines:
        return

    print()
    print("=" * 80)
    print("[공지] 작업 완료 후 확인이 필요한 메시지")
    print("=" * 80)
    for idx, msg in enumerate(lines, start=1):
        echo_w(f" [{idx:<3d}] {msg}")
    print("=" * 80)


def print_error_box(cause: str, line: str = "unknown") -> None:
    """오류 진단 정보를 표준 에러(stderr)로 출력합니다."""
    if not cause:
        return
    print(file=sys.stderr)
    print("=" * 80, file=sys.stderr)
    print(f" - {'filename':<10s}: {FILENAME}", file=sys.stderr)
    print(f" - {'line':<10s}: {line}", file=sys.stderr)
    print(f" - {'cause':<10s}: {cause}", file=sys.stderr)
    print("=" * 80, file=sys.stderr)


