def echo_e(msg: str, file=None) -> None:
    """오류 메시지를 빨간색으로 출력합니다."""
    out = file if file is not None else sys.stdout
    is_tty = out.isatty() if hasattr(out, "isatty") else False
    c_err = "\033[1;31m" if is_tty else ""
    c_nc = "\033[0m" if is_tty else ""
    print(f"{c_err}{msg}{c_nc}", file=out)


def echo_w(msg: str, file=None) -> None:
