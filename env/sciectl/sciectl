def load_catalogs_index(ctx: AppContext) -> Dict[str, CatalogMeta]:
    """catalogs.ini 인덱스 파일을 로드하고 파싱합니다 (섹션 순서 보존)."""
    data, err = ctx.fetch_bytes("env/catalogs/catalogs.ini")
    if data is None:
        error_exit(f"카탈로그 인덱스 파일(env/catalogs/catalogs.ini)을 불러올 수 없습니다 ({err}).")
        return {}

    catalogs: Dict[str, CatalogMeta] = {}
    cur_sec = ""
    for raw_line in data.decode("utf-8", errors="replace").splitlines():
        line = raw_line.strip()
        if not line or line.startswith(("#", ";")):
            continue
        if line.startswith("[") and line.endswith("]"):
            cur_sec = line[1:-1].strip()
            if cur_sec not in catalogs:
                catalogs[cur_sec] = CatalogMeta(catalog_id=cur_sec)
            continue
        if "=" in line and cur_sec:
            key, val = line.split("=", 1)
            key = key.strip()
            val = val.strip()
            meta = catalogs[cur_sec]
            if key == "title":
                meta.title = val
            elif key == "description":
                meta.description = val
            elif key in ("catalog_file", "catalog_url"):
                meta.catalog_file = val
    return catalogs


def show_catalog_table(catalogs: Dict[str, CatalogMeta]) -> None:
    """카탈로그 목록을 동적 ASCII 테이블로 출력합니다."""
    max_id_w = max([10] + [get_display_width(cid) for cid in catalogs.keys()])
    max_title_w = max([4] + [get_display_width(m.title) for m in catalogs.values()])
    max_desc_w = max([4] + [get_display_width(m.description) for m in catalogs.values()])
    border = "-" * (16 + max_id_w + max_title_w + max_desc_w)

    print()
    print(border)
    print(f"|  #  | {pad_string('카탈로그 ID', max_id_w)} | {pad_string('제목', max_title_w)} | {pad_string('설명', max_desc_w)} |")
    print(border)
    for idx, (cid, meta) in enumerate(catalogs.items(), start=1):
        print(f"| {idx:3d} | {pad_string(cid, max_id_w)} | {pad_string(meta.title, max_title_w)} | {pad_string(meta.description, max_desc_w)} |")
    print(border)
    print()


def add_tx_items(plan: TransactionPlan, item_type: str, raw_csv: str) -> None:
    """콤마(,)로 구분된 문자열을 파싱하여 트랜잭션 컨테이너에 중복 없이 추가합니다."""
    if not raw_csv:
        return
    mapping = {
        "sudoers": (plan.sudoers_cmds, plan._seen_sudoers),
        "remove_pkg": (plan.remove_pkgs, plan._seen_remove_pkgs),
        "install_pkg": (plan.install_pkgs, plan._seen_install_pkgs),
        "tool": (plan.tools, plan._seen_tools),
        "installer": (plan.installers, plan._seen_installers),
        "command": (plan.commands, plan._seen_commands),
        "ssh_key": (plan.ssh_keys, plan._seen_ssh_keys),
    }
    target_list, seen_set = mapping[item_type]
    for part in raw_csv.split(","):
        trimmed = part.strip()
        if trimmed and trimmed not in seen_set:
            seen_set.add(trimmed)
            target_list.append(trimmed)


def resolve_catalog(
    ctx: AppContext,
    catalogs: Dict[str, CatalogMeta],
    plan: TransactionPlan,
    cat_id: str,
) -> None:
    """단일 카탈로그 매니페스트(*.catalog)를 로드하고 INCLUDES 상속을 재귀적으로 병합합니다."""
    if not cat_id or cat_id in plan._seen_catalogs:
        return
    plan._seen_catalogs.add(cat_id)

    rel_file = f"env/catalogs/{cat_id}.catalog"
    meta = catalogs.get(cat_id)
    if meta and meta.catalog_file:
        if meta.catalog_file.startswith("https://"):
            rel_file = meta.catalog_file
        else:
            rel_file = f"env/catalogs/{meta.catalog_file}"

    data, err = ctx.fetch_bytes(rel_file)
    if data is None:
        error_exit(f"존재하지 않는 카탈로그이거나 매니페스트를 불러올 수 없습니다: '{cat_id}' ({rel_file}, {err})")
        return

    fields: Dict[str, List[str]] = {
        "INCLUDES": [],
        "NO_PASSWORD_COMMANDS": [],
        "REMOVE_PACKAGES": [],
        "INSTALL_PACKAGES": [],
        "TOOLS": [],
        "INSTALLERS": [],
        "COMMANDS": [],
        "SSH_KEYS": [],
    }
    accumulated = ""
    for raw_line in data.decode("utf-8", errors="replace").splitlines():
        stripped = raw_line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if stripped.endswith("\\"):
            accumulated += stripped[:-1] + " "
            continue
        full_line = accumulated + stripped
        accumulated = ""
        if "=" in full_line:
            k, v = full_line.split("=", 1)
            k = k.strip()
            v = v.strip()
            if k == "COMMADNS":
                k = "COMMANDS"
            if k in fields:
                fields[k].append(v)

    for inc_csv in fields["INCLUDES"]:
        for inc_id in inc_csv.split(","):
            inc_clean = inc_id.strip()
            if inc_clean:
                resolve_catalog(ctx, catalogs, plan, inc_clean)

    plan.catalogs.append(cat_id)
    add_tx_items(plan, "sudoers", ",".join(fields["NO_PASSWORD_COMMANDS"]))
    add_tx_items(plan, "remove_pkg", ",".join(fields["REMOVE_PACKAGES"]))
    add_tx_items(plan, "install_pkg", ",".join(fields["INSTALL_PACKAGES"]))
    add_tx_items(plan, "tool", ",".join(fields["TOOLS"]))
    add_tx_items(plan, "installer", ",".join(fields["INSTALLERS"]))
    add_tx_items(plan, "command", ",".join(fields["COMMANDS"]))
    add_tx_items(plan, "ssh_key", ",".join(fields["SSH_KEYS"]))


# ==============================================================================
# 설치 상태 매니페스트 관리 (Manifest Registry)
# ==============================================================================
def manifest_tools_dir(scope: str = "local") -> Path:
    if scope == "global":
        return Path("/var/lib/sciectl/installed/tools")
    xdg_state = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))
    return xdg_state / "sciectl" / "installed" / "tools"


def manifest_keys_dir() -> Path:
    xdg_state = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state"))
    return xdg_state / "sciectl" / "installed" / "keys"


def manifest_now_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def parse_manifest_file(meta_path: Path) -> Dict[str, str]:
    result: Dict[str, str] = {}
    if not meta_path.is_file():
        return result
    try:
        for line in meta_path.read_text(encoding="utf-8", errors="replace").splitlines():
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            result[k] = v
    except OSError:
        pass
    return result


def _atomic_move_file(src: Path, dest: Path, use_sudo: bool, mode: str = "644") -> bool:
    try:
        if use_sudo:
            r1 = run_cmd(["sudo", "mkdir", "-p", str(dest.parent)])
            r2 = run_cmd(["sudo", "mv", "-f", str(src), str(dest)])
            r3 = run_cmd(["sudo", "chmod", mode, str(dest)])
            return r1.returncode == 0 and r2.returncode == 0 and r3.returncode == 0
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(src), str(dest))
        os.chmod(dest, int(mode, 8))
        return True
    except OSError:
        return False


def manifest_save_tool(
    tool_id: str,
    cmd_name: str,
    target_scope: str,
    version: str,
    bin_path: str,
    comp_path: str = "",
    man_paths: str = "",
) -> None:
    meta_dir = manifest_tools_dir(target_scope)
    meta_file = meta_dir / f"{cmd_name}.meta"
    use_sudo = target_scope == "global"
    now = manifest_now_iso()
    installed_at = parse_manifest_file(meta_file).get("INSTALLED_AT") or now

    content = "\n".join([
        f"TOOL_ID={tool_id}",
        f"CMD_NAME={cmd_name}",
        f"TARGET_SCOPE={target_scope}",
        f"VERSION={version}",
        f"BIN_PATH={bin_path}",
        f"COMPLETION_PATH={comp_path}",
        f"MAN_PATHS={man_paths}",
        f"INSTALLED_AT={installed_at}",
        f"UPDATED_AT={now}",
        "",
    ])
    try:
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", prefix="sciectl_meta.", delete=False) as tf:
            tf.write(content)
            tmp_path = Path(tf.name)
        _atomic_move_file(tmp_path, meta_file, use_sudo=use_sudo, mode="644")
    except OSError:
        pass


def manifest_delete_tool(cmd_name: str, target_scope: str = "local") -> None:
    meta_file = manifest_tools_dir(target_scope) / f"{cmd_name}.meta"
    if not meta_file.is_file():
        return
    if target_scope == "global" and not os.access(meta_file, os.W_OK):
        run_cmd(["sudo", "rm", "-f", "--", str(meta_file)])
    else:
        meta_file.unlink(missing_ok=True)


def manifest_save_key(
    key_id: str,
    key_body: str,
    key_comment: str = "",
    auth_file: Optional[Path] = None,
) -> None:
    target_auth = str(auth_file or (Path.home() / ".ssh" / "authorized_keys"))
    meta_file = manifest_keys_dir() / f"{key_id}.meta"
    now = manifest_now_iso()
    installed_at = parse_manifest_file(meta_file).get("INSTALLED_AT") or now

    content = "\n".join([
        f"KEY_ID={key_id}",
        f"KEY_BODY={key_body}",
        f"KEY_COMMENT={key_comment}",
        f"AUTH_FILE={target_auth}",
        f"INSTALLED_AT={installed_at}",
        f"UPDATED_AT={now}",
        "",
    ])
    try:
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", prefix="sciectl_meta.", delete=False) as tf:
            tf.write(content)
            tmp_path = Path(tf.name)
        _atomic_move_file(tmp_path, meta_file, use_sudo=False, mode="644")
    except OSError:
        pass


def manifest_delete_key(key_id: str) -> None:
    meta_file = manifest_keys_dir() / f"{key_id}.meta"
    try:
        meta_file.unlink(missing_ok=True)
    except OSError:
        pass


def manifest_collect_known_tools(ctx: AppContext) -> List[str]:
    seen: Set[str] = set()
    result: List[str] = []
    local_root = ctx.detect_local_repo(abort_on_missing=False)
    if local_root is not None:
        for c_dir in sorted(local_root.iterdir()):
            if not c_dir.is_dir():
                continue
            cat_name = c_dir.name
            if cat_name.startswith(".") or cat_name in ("tmp", "docs"):
                continue
            for t_dir in sorted(c_dir.iterdir()):
                if not t_dir.is_dir():
                    continue
                tool_name = t_dir.name
                if cat_name == "env" and tool_name in ("installers", "commands", "keys", "catalogs"):
                    continue
                if (t_dir / tool_name).is_file() or (t_dir / f"{tool_name}.sh").is_file():
                    tid = f"{cat_name}/{tool_name}"
                    if tid not in seen:
                        seen.add(tid)
                        result.append(tid)
        return result

    data, _ = ctx.fetch_bytes("env/catalogs/all-scripts.catalog")
    if data is not None:
        tools_csv = ""
        in_cont = False
        for raw_line in data.decode("utf-8", errors="replace").splitlines():
            line = raw_line.rstrip("\r")
            if in_cont:
                if line.endswith("\\"):
                    tools_csv += line[:-1]
                else:
                    tools_csv += line
                    in_cont = False
                continue
            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                continue
            if stripped.startswith("TOOLS="):
                val = stripped[len("TOOLS="):]
                if val.endswith("\\"):
                    tools_csv = val[:-1]
                    in_cont = True
                else:
                    tools_csv = val
        for item in tools_csv.split(","):
            t = item.strip()
            if t and t not in seen:
                seen.add(t)
                result.append(t)
    if "env/sciectl" not in seen:
        result.append("env/sciectl")
    return result


def manifest_collect_known_keys(ctx: AppContext) -> List[str]:
    local_root = ctx.detect_local_repo(abort_on_missing=False)
    if local_root is not None and (local_root / "env" / "keys").is_dir():
        keys: List[str] = []
        for d in sorted((local_root / "env" / "keys").iterdir()):
            if d.is_dir() and (d / f"{d.name}.pub").is_file():
                keys.append(d.name)
        return keys
    return ["ymtech-internal", "letsencrypt"]


def manifest_discover_companions(cmd_name: str, target_scope: str = "local") -> Tuple[str, str]:
    comp_candidates = [
        Path(f"/usr/share/bash-completion/completions/{cmd_name}"),
        Path(f"/etc/bash_completion.d/{cmd_name}.completion"),
        Path.home() / ".bash_completion.d" / f"{cmd_name}.completion",
    ]
    if TARGET_OS == "darwin" and shutil.which("brew"):
        res = run_cmd(["brew", "--prefix"], timeout=5)
        bp = (res.stdout or "").strip()
        if bp:
            comp_candidates = [
                Path(bp) / "etc" / "bash_completion.d" / f"{cmd_name}.completion",
                Path(bp) / "share" / "bash-completion" / "completions" / cmd_name,
            ] + comp_candidates

    found_comp = ""
    for cand in comp_candidates:
        if cand.is_file():
            found_comp = str(cand)
            break

    xdg_data = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share"))
    man_base = xdg_data / "man"
    if target_scope == "global":
        man_base = Path("/usr/local/share/man")
        if TARGET_OS == "darwin" and shutil.which("brew"):
            res = run_cmd(["brew", "--prefix"], timeout=5)
            bp = (res.stdout or "").strip()
            if bp and (Path(bp) / "share" / "man").is_dir():
                man_base = Path(bp) / "share" / "man"

    man_names = [f"man1/{cmd_name}.1"]
    if cmd_name == "sshctl":
        man_names.extend(["man5/sshctl.conf.5", "man7/sshctl-security.7"])
    elif cmd_name == "sciectl":
        man_names.append("man5/sciectl-catalog.5")

    found_mans = [str(man_base / mn) for mn in man_names if (man_base / mn).is_file()]
    return found_comp, ":".join(found_mans)


def manifest_sync_legacy(ctx: AppContext) -> None:
    if ctx.manifest_synced:
        return
    ctx.manifest_synced = True

    cmd_to_tid = {Path(tid).name: tid for tid in manifest_collect_known_tools(ctx)}
    for scope in ("local", "global"):
        bin_dir = Path("/usr/local/bin") if scope == "global" else (Path.home() / "bin")
        if not bin_dir.is_dir():
            continue
        meta_dir = manifest_tools_dir(scope)
        for f in bin_dir.iterdir():
            if not f.is_file():
                continue
            cmd_name = f.name
            if (meta_dir / f"{cmd_name}.meta").is_file() or cmd_name not in cmd_to_tid:
                continue
            try:
                head_text = "\n".join(f.read_text(encoding="utf-8", errors="replace").splitlines()[:40])
            except OSError:
                continue
            if META_HEADER_RE.search(head_text):
                ver = extract_script_version(f)
                comp_path, man_paths = manifest_discover_companions(cmd_name, scope)
                manifest_save_tool(cmd_to_tid[cmd_name], cmd_name, scope, ver, str(f), comp_path, man_paths)

    auth_file = Path.home() / ".ssh" / "authorized_keys"
    if auth_file.is_file():
        try:
            auth_text = auth_file.read_text(encoding="utf-8", errors="replace")
        except OSError:
            auth_text = ""
        keys_dir = manifest_keys_dir()
        for key_id in manifest_collect_known_keys(ctx):
            if (keys_dir / f"{key_id}.meta").is_file():
                continue
            pub_content = resolve_ssh_key_content(ctx, key_id)
            if pub_content:
                parts = pub_content.split()
                key_body = parts[1] if len(parts) >= 2 else ""
                key_comment = " ".join(parts[2:]) if len(parts) >= 3 else ""
                if key_body and key_body in auth_text:
                    manifest_save_key(key_id, key_body, key_comment, auth_file)


def manifest_list_installed(ctx: AppContext, filter_scope: str = "all") -> List[InstalledRecord]:
    manifest_sync_legacy(ctx)
    records: List[InstalledRecord] = []

    for scope in ("local", "global"):
        if filter_scope not in ("all", scope):
            continue
        meta_dir = manifest_tools_dir(scope)
        if not meta_dir.is_dir():
            continue
        for mf in sorted(meta_dir.glob("*.meta")):
            if not mf.is_file():
                continue
            fields = parse_manifest_file(mf)
            bpath = fields.get("BIN_PATH", "")
            if not bpath or not Path(bpath).is_file():
                continue
            records.append(
                InstalledRecord(
                    rec_type="tool",
                    rec_id=fields.get("TOOL_ID", ""),
                    name=fields.get("CMD_NAME", ""),
                    scope=scope,
                    version=fields.get("VERSION", "") or "unknown",
                    primary_path=bpath,
                    meta_file=str(mf),
                    updated_at=fields.get("UPDATED_AT", "")[:19] or "0000-00-00T00:00:00",
                )
            )

    if filter_scope in ("all", "local"):
        keys_dir = manifest_keys_dir()
        if keys_dir.is_dir():
            for kf in sorted(keys_dir.glob("*.meta")):
                if not kf.is_file():
                    continue
                fields = parse_manifest_file(kf)
                kid = fields.get("KEY_ID", "")
                kbody = fields.get("KEY_BODY", "")
                kcomment = fields.get("KEY_COMMENT", "")
                afile = fields.get("AUTH_FILE", "") or str(Path.home() / ".ssh" / "authorized_keys")
                auth_path = Path(afile)
                if not auth_path.is_file() or not kbody:
                    continue
                try:
                    if kbody not in auth_path.read_text(encoding="utf-8", errors="replace"):
                        continue
                except OSError:
                    continue
                records.append(
                    InstalledRecord(
                        rec_type="ssh-key",
                        rec_id=kid,
                        name=kid,
                        scope="user",
                        version=kcomment or "ssh-rsa",
                        primary_path=afile,
                        meta_file=str(kf),
                        updated_at=fields.get("UPDATED_AT", "")[:19] or "0000-00-00T00:00:00",
                        key_body=kbody,
                    )
                )
    return records


