def _is_local_git_repo(target_file: Path) -> bool:
    if not target_file.is_file() or shutil.which("git") is None:
        return False
    res = run_cmd(["git", "-C", str(target_file.parent), "rev-parse", "--is-inside-work-tree"], timeout=3)
    return res.returncode == 0


def _self_sync_companions(ctx: AppContext, current_script: Path) -> None:
    script_dir = current_script.parent
    scope = "local" if str(current_script).startswith(str(Path.home()) + os.sep) else "global"

    local_comp = script_dir / "sciectl.completion"
    if local_comp.is_file() and os.access(local_comp, os.W_OK):
        data, _ = ctx.fetch_bytes("env/sciectl/sciectl.completion", timeout=5.0, max_retries=1)
        if data is not None:
            with tempfile.NamedTemporaryFile("wb", prefix="sciectl_lc.", delete=False) as tf:
                tf.write(data)
                tmp_lc = Path(tf.name)
            if run_cmd(["bash", "-n", str(tmp_lc)], timeout=5).returncode == 0:
                _atomic_move_file(tmp_lc, local_comp, use_sudo=False, mode="644")
            else:
                tmp_lc.unlink(missing_ok=True)

    can_sync_comp = True
    if TARGET_OS != "darwin":
        std_comp_dir = ""
        if shutil.which("pkg-config"):
            r = run_cmd(["pkg-config", "--variable=completionsdir", "bash-completion"], timeout=3)
            std_comp_dir = (r.stdout or "").strip()
        if not std_comp_dir and Path("/usr/share/bash-completion/completions").is_dir():
            std_comp_dir = "/usr/share/bash-completion/completions"
        elif not std_comp_dir and Path("/etc/bash_completion.d").is_dir():
            std_comp_dir = "/etc/bash_completion.d"
        if std_comp_dir and not os.access(std_comp_dir, os.W_OK):
            if not sys.stdin.isatty() and run_cmd(["sudo", "-n", "true"], timeout=3).returncode != 0:
                can_sync_comp = False
                echo_w(f"   ⚠️ 비대화형 환경에서 시스템 전역 completion('{std_comp_dir}/sciectl') 갱신은 관리자 권한이 필요합니다.")
            elif sys.stdin.isatty():
                echo_i(f"   🔐 시스템 전역 completion('{std_comp_dir}/sciectl') 갱신을 위해 관리자 권한(sudo)을 확인합니다.")

    comp_path = ""
    if can_sync_comp:
        comp_path = install_completion(ctx, "env/sciectl/sciectl.completion", "sciectl", force_overwrite=True, quiet=True)

    can_sync_man = True
    if scope == "global" and not os.access("/usr/local/share/man", os.W_OK):
        if not sys.stdin.isatty() and run_cmd(["sudo", "-n", "true"], timeout=3).returncode != 0:
            can_sync_man = False
            echo_w("   ⚠️ 비대화형 환경에서 시스템 전역 man 페이지 갱신은 관리자 권한이 필요합니다.")

    man_paths = ""
    if can_sync_man:
        man_paths = install_manpages(ctx, "env/sciectl/sciectl", "sciectl", scope=scope, force_overwrite=True, quiet=True)

    manifest_save_tool("env/sciectl", "sciectl", scope, SCRIPT_FILE_VERSION, str(current_script), comp_path, man_paths)
    echo_i("   📦 동반 자원(completion, man 페이지, 매니페스트) 동기화 완료.")


def check_and_self_update(ctx: AppContext, argv: Sequence[str]) -> None:
    """실행 중인 sciectl을 원격 최신 코드와 비교하여 Python 구문 검증 후 원자적 교체·재실행합니다."""
    if os.environ.get("_SCIECTL_SELF_UPDATED") == "1":
        os.environ.pop("_SCIECTL_SELF_UPDATED", None)
        reexec_raw = os.environ.pop("_SCIECTL_SELF_UPDATED_PATH", "") or sys.argv[0]
        reexec_path = Path(reexec_raw)
        if reexec_path.is_file():
            _self_sync_companions(ctx, reexec_path)
        return

    if os.environ.get("SCIECTL_AUTO_UPDATE", "true") == "false" or os.environ.get("SCIECTL_NO_UPDATE", "false") == "true":
        return

    force_update = False
    for arg in argv:
        if arg in ("--no-update", "--local"):
            return
        if arg == "--force-update":
            force_update = True

    try:
        current_script = Path(__file__).resolve()
    except OSError:
        current_script = Path(sys.argv[0])

    if not current_script.is_file():
        return

    if _is_local_git_repo(current_script):
        if not force_update:
            return
        echo_w("⚠️ [sciectl] 로컬 Git 작업 트리 내에서 실행 중이지만, '--force-update' 옵션에 의해 원격 동기화를 시도합니다.")

    if not os.access(current_script, os.W_OK) or not os.access(current_script.parent, os.W_OK):
        if force_update:
            echo_w(f"⚠️ [sciectl] 현재 스크립트 파일('{current_script}') 또는 디렉토리에 쓰기 권한이 없어 업데이트를 건너뜁니다.")
        return

    remote_url = f"{REPO_BASE_URL}/env/sciectl/sciectl?t={int(time.time())}"
    data, _ = ctx.fetch_bytes(remote_url, timeout=5.0, max_retries=0)
    if data is None:
        return

    try:
        if data == current_script.read_bytes():
            return
    except OSError:
        pass

    remote_text = data.decode("utf-8", errors="replace")
    try:
        compile(remote_text, str(current_script), "exec")
    except SyntaxError:
        echo_w("⚠️ [sciectl] 원격 최신 코드의 구문 검증(Python compile)에 실패하여 업데이트를 건너뜁니다.", file=sys.stderr)
        return

    remote_version = extract_script_version_from_text(remote_text)
    if not force_update:
        if SCRIPT_FILE_VERSION and not remote_version:
            return
        if remote_version and SCRIPT_FILE_VERSION and not is_newer_version(SCRIPT_FILE_VERSION, remote_version):
            return

    if remote_version and SCRIPT_FILE_VERSION:
        echo_i(f"🔄 [sciectl] 원격 저장소에 최신 버전(v{remote_version})이 감지되었습니다 (현재: v{SCRIPT_FILE_VERSION}). 자가 업데이트(Self-Update)를 진행합니다...")
    else:
        echo_i("🔄 [sciectl] 원격 저장소에 새로운 버전이 감지되었습니다. 자가 업데이트(Self-Update)를 진행합니다...")

    current_comp = current_script.parent / "sciectl.completion"
    if current_comp.is_file() and os.access(current_comp, os.W_OK):
        comp_data, _ = ctx.fetch_bytes("env/sciectl/sciectl.completion", timeout=5.0, max_retries=0)
        if comp_data is not None:
            with tempfile.NamedTemporaryFile("wb", prefix="sciectl_comp.", delete=False) as tf:
                tf.write(comp_data)
                tmp_comp = Path(tf.name)
            if run_cmd(["bash", "-n", str(tmp_comp)], timeout=5).returncode == 0:
                _atomic_move_file(tmp_comp, current_comp, use_sudo=False, mode="644")
            else:
                tmp_comp.unlink(missing_ok=True)

    try:
        with tempfile.NamedTemporaryFile("wb", dir=str(current_script.parent), prefix=".sciectl_upd.", delete=False) as tf:
            tf.write(data)
            tmp_script = Path(tf.name)
        os.chmod(tmp_script, 0o755)
        os.replace(tmp_script, current_script)
    except OSError:
        echo_w("⚠️ [sciectl] 스크립트 파일 갱신(replace)에 실패했습니다. 기존 버전으로 계속 실행합니다.", file=sys.stderr)
        return

    echo_i("✅ [sciectl] 최신 버전으로 갱신 완료되었습니다. 프로세스를 재시작합니다.")
    print()
    os.environ["_SCIECTL_SELF_UPDATED"] = "1"
    os.environ["_SCIECTL_SELF_UPDATED_PATH"] = str(current_script)
    os.execv(sys.executable, [sys.executable, str(current_script), *argv])


