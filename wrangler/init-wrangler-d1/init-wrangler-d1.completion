#!/usr/bin/env bash

# =======================================
# @author : parkjunhong77@gmail.com
# @title  : Bash completion for 'init-wrangler-d1'
# @license: Apache License 2.0
# @since  : 2026-01-05
# @desc   : support macOS 11.2.3, Ubuntu 18.04 or higher, CentOS 7 or higher
# =======================================

# Bash Completion Parameter Description
# 1. COMP_WORDS: an array, contains all arguments
# 2. COMP_CWORD: an index of a cursor
# 3. COMP_LINE: all command string
# 4. COMPREPLY: an array, contains suggested words. words are sorted and unique.

_init_wrangler_d1_completion() {
    local cur prev opts i
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    
    # 전체 지원 옵션 목록 (Long Option 전용)
    local all_opts="--run-dir --d1-location --d1-schema --d1-file --help"
    
    # 이미 입력한 옵션은 추천 목록에서 제외
    opts="$all_opts"
    for i in "${COMP_WORDS[@]}"; do
        if [[ "$i" == "$cur" ]]; then
            continue
        fi
        opts=${opts//$i/}
    done

    # 값 입력 컨텍스트 처리
    case "${prev}" in
        --run-dir)
            # 디렉토리만 추천
            COMPREPLY=( $(compgen -d -- "${cur}") )
            return 0
            ;;
        --d1-location)
            # local, remote, all, migration 추천
            COMPREPLY=( $(compgen -W "local remote all migration" -- "${cur}") )
            return 0
            ;;
        --d1-file)
            # 파일만 추천
            COMPREPLY=( $(compgen -f -- "${cur}") )
            return 0
            ;;
        --d1-schema)
            # DB 이름은 사용자 입력이 필요하므로 자동완성 없음
            return 0
            ;;
    esac

    COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
    return 0
}

complete -F _init_wrangler_d1_completion init-wrangler-d1
