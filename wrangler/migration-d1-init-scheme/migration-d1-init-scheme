#!/usr/bin/env bash

# =======================================
# @author : parkjunhong77@gmail.com
# @title  : migration-d1-init-scheme: Preprocess SQL schema files by adding DROP TABLE IF EXISTS for D1
# @license: Apache License 2.0
# @since  : 2026-01-05
# @desc   : support macOS 11.2.3, Ubuntu 18.04 or higher, CentOS 7 or higher
# =======================================

# ------------------------------------------------------------------------------
# 1. Variables & Constants
# ------------------------------------------------------------------------------
SRC_SQL=""
INIT_SQL=""
FORCE_OVERWRITE=false

readonly FILENAME=$(basename "$0")

# 텍스트 컬러 (출력 가독성을 위해)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# ------------------------------------------------------------------------------
# 2. Helper Functions
# ------------------------------------------------------------------------------

usage() {
    echo -e "${BLUE}Usage:${NC} $FILENAME [OPTIONS]"
    echo ""
    echo -e "${YELLOW}Options:${NC}"
    echo -e "      --src-sql <file>         Input SQL file path (Required)"
    echo -e "      --init-sql <file>        Output SQL file path (Required)"
    echo -e "      --force-overwrite        Overwrite output file without prompting if it exists"
    echo -e "      --help                   Show this help message"
    echo ""
    echo -e "${YELLOW}Example:${NC}"
    echo -e "  $FILENAME --src-sql original.sql --init-sql migration.sql --force-overwrite"
}

error_exit() {
    echo -e "${RED}Error: $1${NC}" >&2
    exit 1
}

# ------------------------------------------------------------------------------
# 3. Parse Arguments (Long Option Only)
# ------------------------------------------------------------------------------

while [[ "$#" -gt 0 ]]; do
    case $1 in
        --src-sql)
            [[ $# -ge 2 ]] || error_exit "--src-sql 옵션에 값이 입력되지 않았습니다."
            SRC_SQL="$2"
            shift 2
            ;;
        --init-sql)
            [[ $# -ge 2 ]] || error_exit "--init-sql 옵션에 값이 입력되지 않았습니다."
            INIT_SQL="$2"
            shift 2
            ;;
        --force-overwrite)
            FORCE_OVERWRITE=true
            shift
            ;;
        --help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown parameter passed: $1" >&2
            usage
            exit 1
            ;;
    esac
done

# ------------------------------------------------------------------------------
# 4. Validation
# ------------------------------------------------------------------------------

# 1) 입력 파일 파라미터 확인
if [[ -z "$SRC_SQL" ]]; then
    error_exit "입력 SQL 파일 지정이 필요합니다. (--src-sql)"
fi

# 2) 입력 파일 존재 여부 확인
if [[ ! -f "$SRC_SQL" ]]; then
    error_exit "소스 파일 '$SRC_SQL' 이(가) 존재하지 않습니다."
fi

# 3) 출력 파일 파라미터 확인
if [[ -z "$INIT_SQL" ]]; then
    error_exit "출력 SQL 파일 지정이 필요합니다. (--init-sql)"
fi

# 4) 출력 파일 덮어쓰기 확인
if [[ -f "$INIT_SQL" ]]; then
    if [[ "$FORCE_OVERWRITE" == "true" ]]; then
        echo -e "${YELLOW}File '$INIT_SQL' exists. Overwriting due to --force-overwrite flag.${NC}"
    else
        echo -e -n "${YELLOW}File '$INIT_SQL' already exists. Overwrite? [Y/n] (default: Y): ${NC}"
        read -r response
        response=${response,,} # tolower
        
        if [[ "$response" =~ ^(no|n)$ ]]; then
            echo "Operation cancelled by user."
            exit 0
        fi
        echo "Overwriting file..."
    fi
fi

# ------------------------------------------------------------------------------
# 5. Execution (Processing File)
# ------------------------------------------------------------------------------

echo -e "${GREEN}Processing SQL file...${NC}"

# AWK를 사용하여 패턴 매칭 및 DROP 구문 삽입
# 로직: 
# 1. 라인이 "CREATE TABLE"로 시작하는지 확인
# 2. 맞다면 3번째 필드(테이블명)를 가져옴
# 3. 테이블명 뒤에 붙을 수 있는 '(' 문자를 제거
# 4. DROP 구문을 먼저 출력하고, 원래 라인을 출력

awk '{
    if ($0 ~ /^CREATE TABLE/) {
        tableName = $3
        gsub(/\(/, "", tableName)  # 테이블명 뒤의 ( 제거
        print "DROP TABLE IF EXISTS " tableName ";"
    }
    print $0
}' "$SRC_SQL" > "$INIT_SQL"

# ------------------------------------------------------------------------------
# 6. Finalize
# ------------------------------------------------------------------------------

if [[ $? -eq 0 ]]; then
    echo -e "${GREEN}Success! Migration SQL saved to: $INIT_SQL${NC}"
else
    error_exit "Failed to process the SQL file."
fi

