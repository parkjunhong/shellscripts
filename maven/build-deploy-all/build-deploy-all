#!/usr/bin/env bash

# =======================================
# @author       : parkjunhong77@gmail.com
# @title        : build and deploy all maven projects in subdirectories.
# @license      : Apache License 2.0
# @since        : 2026-01-22
# @desc         : support RHEL 8/9, Oracle Linux 8/9, Ubuntu 20.04/22.04/24.04, RockyOS 8/9
# @installation :
#   1. Copy this script to ~/bin or /usr/local/bin and grant execute permission:
#      chmod +x build-deploy-all
#   2. Or install via scriptctl:
#      scriptctl install maven/build-deploy-all
# =======================================

help(){
	if [ $# -gt 0 ];
	then
		echo
		echo "['${FUNCNAME[1]}' says] " "$1"
	fi
	echo
	echo "[Usage]"
	echo "build-deploy-all -p <profile> [-d] [-t] [-u] [-h|--help] [DIR]"
	echo
	echo "[Parameters]"
	echo " -p, --profile <profile> : Maven profile (Required)"
	echo " -d                      : (Optional) deploy after build"
	echo " -t, --test              : (Optional) run Unit Tests"
	echo " -u                      : (Optional) update codes using 'git pull'"
	echo " -h, --help              : (Optional) show this help message"
	echo " DIR                     : (Optional) target directory containing sub-projects (default: \$PWD)"
	echo
}
PROFILE=""
DEPLOY=0
TEST="true"
GIT_PULL="false"
DIR="$PWD"
while [ ! -z "$1" ];
do
	case "$1" in
		-p | --profile)
			shift
			PROFILE=$1
			;;
		-d)
			DEPLOY=1
			;;
		-u)
			GIT_PULL="true"
			;;
		-t | --test)
			TEST="false"
			;;
		-h | --help)
			help
			exit 0
			;;
		*)
			DIR="$1"
			;;
	esac
	shift
done

if [ ! -d "$DIR" ];
then
	help "Invalid a directory. dir=$DIR"
	exit 1
fi

if [ -z $PROFILE ];
then
	help "Require PROFILE"
	exit 1
fi

# 절대경로/상대경로 확인
if [[ "$DIR" != /* ]] ;
then
	# handle relative path
	DIR=$PWD"/"$DIR
fi

PARAMS="-p $PROFILE"
# deploy
if [ "$DEPLOY" == "1" ];
then
	PARAMS="$PARAMS -d"
fi
# git pull
if [ "$GIT_PULL" == "true" ];
then
	PARAMS="$PARAMS -u"
fi
# test
if [ "$TEST" == "false" ];
then
	PARAMS="$PARAMS -t"
fi

# save a current directory
pushd . > /dev/null

# Go to a working directory
cd "$DIR"

ls -l "$DIR" | grep '^d' | awk '{print $9}' | while read subdir;
do
    echo
    echo "-------------------------------------------------------------"
    echo "- * * * * * Project: $subdir"
    echo "-------------------------------------------------------------"
    # Go to a target directory
    cd "$subdir"

	if [ $(ls | tr [:upper:] [:lower:] | grep pom.xml | wc -l) -lt 1 ];
	then
		echo
		echo "Here is not a MAVEN project"
		continue;
	fi
		
	echo
	build-mvn-package $PARAMS
	# Go to a parent directory
	cd ..
	echo " <<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<"
done

# restore a current directory
popd > /dev/null

exit 0
