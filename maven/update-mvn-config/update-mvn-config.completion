#!/usr/bin/env bash
# =======================================
# @author       : parkjunhong77@gmail.com
# @title        : completion for update-mvn-config.
# @license      : Apache License 2.0
# @since        : 2026-03-11
# @desc         : support RHEL, Oracle Linux, Ubuntu, RockyOS
# @installation :
#   1. insert 'source <path>/update-mvn-config.completion' into ~/.bashrc or ~/.bash_profile for personal usage.
#   2. copy the file to /etc/bash_completion.d/ or insert 'source <path>/update-mvn-config.completion' into /etc/bashrc for all users.
# =======================================

# =======================================
# Bash Completion Parameter Description
#
# Global Reserved Variables
# 1. COMP_WORDS: an array, contains all arguments
# 2. COMP_CWORD: an index of a cursor
# 3. COMP_LINE: all command string
# 4. COMPREPLY: an array, contains suggested words. words are sorted and unique.
#
# Arguments of a function
# 1. $1: command
# 2. $2: current word
# 3. $3: previous word
# =======================================

_update_mvn_config_completion() {
  local cur prev opts
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  opts="-h --help"

  if [[ "$cur" == -* ]]; then
    COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
    return 0
  fi

  return 0
}

complete -F _update_mvn_config_completion update-mvn-config
complete -F _update_mvn_config_completion ./update-mvn-config
