#!/usr/bin/env bash

# =======================================
# @author : parkjunhong77@gmail.com
# @title  : mariadb-restore: Safe database restoration tool with pre-restore backup for MariaDB
# @license: Apache License 2.0
# @since  : 2025-03-10
# @desc   : support macOS 11.2.3, Ubuntu 18.04 or higher, CentOS 7 or higher
# =======================================

set -e

# 설정 기본값
DB_USER=""
DB_PASSWORD=""
DB_HOST="localhost"
BACKUP_DIR=""
BACKUP_FILE_PATTERN="mariadb_backup_*.sql.gz"
SPECIFIED_FILE=""

##
# 도움말 출력
##
help() {
  echo "Usage: $(basename "$0") [OPTIONS]"
  echo ""
  echo "MariaDB 데이터베이스 복원 도구 (사전 백업 및 대화형/직접 지정 복원)"
  echo ""
  echo "Options:"
  echo "  --user <username>          MariaDB 사용자 이름 (필수)"
  echo "  --password <password>      MariaDB 사용자 비밀번호 (환경 변수 또는 옵션)"
  echo "  --host <hostname>          MariaDB 서버 주소 (기본값: localhost)"
  echo "  --dir <directory>          백업 파일이 저장된 디렉토리 (필수)"
  echo "  --file <filepath>          복원할 특정 백업 파일 경로 (생략 시 대화형 선택)"
  echo "  --file-pattern <pattern>   복구할 백업 파일 이름 패턴 (기본값: mariadb_backup_*.sql.gz)"
  echo "  --help                     도움말 출력"
  echo ""
  exit 1
}

##
# 파라미터 처리 (Long Option 전용)
##
parse_options() {
  if [[ $# -eq 0 ]]; then
    help
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --user)
      DB_USER="$2"
      shift 2
      ;;
    --password)
      DB_PASSWORD="$2"
      shift 2
      ;;
    --host)
      DB_HOST="$2"
      shift 2
      ;;
    --dir)
      BACKUP_DIR="$2"
      shift 2
      ;;
    --file)
      SPECIFIED_FILE="$2"
      shift 2
      ;;
    --file-pattern)
      BACKUP_FILE_PATTERN="$2"
      shift 2
      ;;
    --help)
      help
      ;;
    *)
      echo "알 수 없는 옵션: $1"
      help
      ;;
    esac
  done

  # 필수 파라미터 확인
  if [[ -z "$DB_USER" || -z "$BACKUP_DIR" ]]; then
    echo "오류: --user 및 --dir 파라미터는 필수입니다."
    help
  fi

  if [[ ! -d "$BACKUP_DIR" ]]; then
    echo "오류: 백업 디렉토리가 존재하지 않습니다: $BACKUP_DIR"
    exit 1
  fi
}

##
# 백업 파일 선택
##
select_backup_file() {
  if [[ -n "$SPECIFIED_FILE" ]]; then
    if [[ ! -f "$SPECIFIED_FILE" ]]; then
      echo "오류: 지정된 백업 파일이 존재하지 않습니다: $SPECIFIED_FILE"
      exit 1
    fi
    SELECTED_FILE="$SPECIFIED_FILE"
    echo "선택한 백업 파일: $(basename "$SELECTED_FILE")"
    return 0
  fi

  mapfile -t BACKUP_FILES < <(find "${BACKUP_DIR}" -name "${BACKUP_FILE_PATTERN}" | sort)

  if [[ ${#BACKUP_FILES[@]} -eq 0 ]]; then
    echo "오류: 디렉토리(${BACKUP_DIR}) 내에서 백업 파일을 찾을 수 없습니다."
    exit 1
  fi

  echo "사용 가능한 백업 파일 목록:"
  for i in "${!BACKUP_FILES[@]}"; do
    printf " [%d] %s\n" "$((i+1))" "$(basename "${BACKUP_FILES[i]}")"
  done

  read -r -p "복원할 백업 파일 번호를 입력하세요 (1~${#BACKUP_FILES[@]}): " CHOICE
  if ! [[ "$CHOICE" =~ ^[0-9]+$ ]] || (( CHOICE < 1 || CHOICE > ${#BACKUP_FILES[@]} )); then
    echo "오류: 잘못된 번호 선택입니다."
    exit 1
  fi

  SELECTED_FILE="${BACKUP_FILES[$((CHOICE-1))]}"
  echo "선택한 백업 파일: $(basename "$SELECTED_FILE")"
}

##
# 복원 실행
##
restore_mariadb() {
  select_backup_file

  local PWD_OPT=""
  if [[ -n "$DB_PASSWORD" ]]; then
    PWD_OPT="--password=${DB_PASSWORD}"
  fi

  local PRE_BACKUP="${BACKUP_DIR}/pre_restore_backup_$(date +'%Y%m%d_%H%M%S').sql"
  echo "안전을 위해 복원 전 현재 데이터베이스를 백업합니다: $PRE_BACKUP"
  mysqldump -h "${DB_HOST}" -u "${DB_USER}" ${PWD_OPT} --all-databases > "${PRE_BACKUP}" || {
    echo "경고: 복원 전 사전 백업 실패. 계속 진행하시겠습니까? (y/n)"
    read -r -p "> " CONT
    if [[ ! "$CONT" =~ ^[Yy]$ ]]; then
      echo "복원 작업을 취소했습니다."
      exit 1
    fi
  }

  echo "MariaDB 데이터 복원 중..."
  gunzip < "${SELECTED_FILE}" | mysql -h "${DB_HOST}" -u "${DB_USER}" ${PWD_OPT}

  echo "MariaDB 복원 완료: $(basename "${SELECTED_FILE}")"
}

# 파라미터 처리
parse_options "$@"

# 복원 실행
restore_mariadb

exit 0
