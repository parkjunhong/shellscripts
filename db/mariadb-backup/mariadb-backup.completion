#!/usr/bin/env bash

# =======================================
# @author   : parkjunhong77@gmail.com
# @title    : Bash completion for 'mariadb-backup'
# @license  : Apache License 2.0
# @since    : 2025-03-10
# @desc     : support macOS 11.2.3, Ubuntu 18.04 or higher, CentOS 7 or higher
# =======================================

# Bash Completion Parameter Description
# 1. COMP_WORDS: an array, contains all arguments
# 2. COMP_CWORD: an index of a cursor
# 3. COMP_LINE: all command string
# 4. COMPREPLY: an array, contains suggested words. words are sorted and unique.

_mariadb_backup_complete() {
  local cur prev opts
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  
  opts="--user --password --host --dir --file-pattern --retention --help"

  case "${prev}" in
    --dir)
      COMPREPLY=( $(compgen -d -- "${cur}") )
      return 0
      ;;
    --user|--password|--host|--file-pattern|--retention)
      return 0
      ;;
  esac

  COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
}

complete -F _mariadb_backup_complete mariadb-backup
