readonly SCRIPT_FILE_VERSION="2026.11.25.1"

set -Eeuo pipefail

# 구분줄 표준 길이 (86자 지정 규격 준수)
SEPARATOR_LINE="======================================================================================"

# ANSI 컬러 정의 (터미널 TTY 연결 시에만 활성화)
if [[ -t 1 ]]; then
  CLR_RESET="\033[0m"
  CLR_BOLD="\033[1m"
  CLR_GREEN="\033[32m"
  CLR_YELLOW="\033[33m"
  CLR_RED="\033[31m"
  CLR_CYAN="\033[36m"
  CLR_GRAY="\033[90m"
else
  CLR_RESET=""
  CLR_BOLD=""
  CLR_GREEN=""
  CLR_YELLOW=""
  CLR_RED=""
  CLR_CYAN=""
  CLR_GRAY=""
fi

# 기본 설정값
OPT_CONF_DIR="/etc/nginx/conf.d"
OPT_DRY_RUN=false
OPT_BACKUP=true
OPT_NGINX_VERSION=""

SUBCOMMAND=""
ACTION=""
TARGET_TLS_VERSION=""
RAW_TLS_VERSION=""

##
# 보안 정책 검증: 스크립트 자체의 sudo 또는 root 직접 실행 차단
##
reject_external_sudo() {
  if [[ "${EUID:-$(id -u)}" -eq 0 || -n "${SUDO_USER:-}" || -n "${SUDO_UID:-}" ]]; then
    echo -e "${CLR_RED}🚫 보안 정책 위반: 'ngxconf-ctl' 스크립트 자체를 sudo 또는 root 권한으로 직접 실행할 수 없습니다.${CLR_RESET}" >&2
    echo -e "${CLR_RED}   보안 원칙에 따라 대상 설정 파일 수정 시점에 내부적으로 필요한 최소 권한(sudo)을 요청합니다.${CLR_RESET}" >&2
    exit 1
  fi
}

##
# 대상 파일 또는 부모 디렉토리에 sudo 권한이 필요한지 판별
#
# @param $1 {string} 파일 경로
# @return 0 (sudo 필요), 1 (일반 권한으로 가능)
##
is_sudo_required_for_file() {
  local target_file="$1"
  local parent_dir
  parent_dir="$(dirname "$target_file")"

  if [[ ! -w "$parent_dir" || ( -e "$target_file" && ! -w "$target_file" ) ]]; then
    return 0
  fi
  return 1
}

##
# 파일 수정 시점에 필요에 따라 선택적 sudo로 명령 실행
#
# @param $1 {string} 대상 파일 경로
# @param $@ {string} 실행할 명령어 및 인자들
##
run_priv_cmd() {
  local target_file="$1"
  shift

  if is_sudo_required_for_file "$target_file"; then
    sudo "$@"
  else
    "$@"
  fi
}

##
# 도움말 출력 (단축 옵션 없이 정규 Long Option만 안내)
##
show_help() {
  cat << EOF
사용법:
  ngxconf-ctl [전역 옵션...] <서브커맨드> <액션> [옵션...]
  ngxconf-ctl http2 <enable|disable|status> [--conf-dir <경로>] [--dry-run]
  ngxconf-ctl ssl_protocols status [--conf-dir <경로>]
  ngxconf-ctl ssl_protocols <tls버전> <enable|disable> [--conf-dir <경로>] [--dry-run]
  ngxconf-ctl --help

설명:
  서버에 설치된 Nginx 버전을 자동 감지하여 Nginx 가상호스트 설정 파일(*.conf)의
  옵션을 안전하게 조회(status), 활성화(enable) 또는 비활성화(disable)합니다.
  - HTTP/2 (1.25.1 이상) : 최신 표준 독립 지시어 ('http2 on;') 방식으로 제어
  - HTTP/2 (1.25.1 미만) : 레거시 'listen ... http2;' 파라미터 방식으로 호환 제어
  - ssl_protocols        : TLS 프로토콜 버전(tls1.2, tls1.3, 향후 tls1.4 등) 단위 제어
  - 보안 원칙            : 스크립트 자체는 일반 사용자로 실행되며, 파일 수정 시점에만 필요한 최소 sudo 권한을 요청합니다.

서브커맨드:
  http2                  HTTP/2 프로토콜 상태 조회 및 활성화/비활성화 제어
    - status             현재 HTTP/2 설정 상태 조회 (파일 수정 없음)
    - enable             HTTP/2 설정 활성화
                         (주석 '# http2 on;' 해제, 없을 시 'listen' 아래에 신규 추가)
    - disable            HTTP/2 설정 비활성화
                         ('http2 on;' 주석 처리, 없을 시 '설정 없음' 안내)

  ssl_protocols          SSL/TLS 프로토콜 버전별 상태 조회 및 활성화/비활성화 제어
    - status             현재 ssl_protocols 설정 상태 조회 (파일 수정 없음)
    - <버전> enable      지정한 TLS 버전 활성화 (예: tls1.2, tls1.3, tls1.4 등)
                         (기존 ssl_protocols 에 추가, 없을 시 SSL 설정 아래 신규 추가)
    - <버전> disable     지정한 TLS 버전 비활성화 (예: tls1.2, tls1.3, tls1.4 등)
                         (기존 ssl_protocols 에서 제거, 마지막 버전 제거 시 주석 처리)

옵션 상세:
  --conf-dir <경로>      작업 대상 (*.conf) 디렉토리 경로 (기본값: /etc/nginx/conf.d)
                         여러 경로 지정 시 콤마(,)로 구분 (예: /etc/nginx/conf.d,/etc/nginx/sites-available)
  --dry-run              실제 파일을 수정하지 않고 변경 예정 내역(diff) 및 실행 과정 시뮬레이션
  --no-backup            파일 변경 시 백업본(.bak) 생성을 생략
  --nginx-version <버전> Nginx 버전을 수동 지정 (미지정 시 'nginx -v' 자동 감지)
  --help                 도움말 출력

사용 예시:
  # 1) 기본 설정 디렉토리(/etc/nginx/conf.d)의 HTTP/2 및 ssl_protocols 현재 상태 조회
  ngxconf-ctl http2 status
  ngxconf-ctl ssl_protocols status

  # 2) 기본 설정 디렉토리의 모든 *.conf 에 대해 HTTP/2 활성화
  ngxconf-ctl http2 enable

  # 3) 특정 디렉토리 지정 및 TLSv1.3 활성화 사전 시뮬레이션 (--dry-run)
  ngxconf-ctl ssl_protocols tls1.3 enable --conf-dir /etc/nginx/sites-available --dry-run

  # 4) TLSv1.2 비활성화 및 신규 TLS 버전(예: tls1.4) 활성화
  ngxconf-ctl ssl_protocols tls1.2 disable
  ngxconf-ctl ssl_protocols tls1.4 enable

EOF
}

##
# 버전 비교 함수 (v1 >= v2 검사)
#
# @param $1 {string} 버전 1 (예: 1.26.2)
# @param $2 {string} 버전 2 (예: 1.25.1)
#
# @return 0 참 (v1 >= v2), 1 거짓 (v1 < v2)
##
version_ge() {
  local v1="$1"
  local v2="$2"
  printf '%s\n%s\n' "$v2" "$v1" | sort -V -C
}

##
# Nginx 버전 감지 및 구문 모드 결정
##
detect_nginx_info() {
  DETECTED_VERSION=""
  NGINX_MODE="directive" # 기본값: directive (1.25.1+)

  if [[ -n "$OPT_NGINX_VERSION" ]]; then
    DETECTED_VERSION="$OPT_NGINX_VERSION"
  elif command -v nginx >/dev/null 2>&1; then
    local raw_v
    raw_v=$(nginx -v 2>&1 || true)
    local ver_regex='nginx/([0-9]+\.[0-9]+(\.[0-9]+)?)'
    if [[ "$raw_v" =~ $ver_regex ]]; then
      DETECTED_VERSION="${BASH_REMATCH[1]}"
    fi
  fi

  if [[ -n "$DETECTED_VERSION" ]]; then
    if version_ge "$DETECTED_VERSION" "1.25.1"; then
      NGINX_MODE="directive"
    else
      NGINX_MODE="listen"
    fi
  else
    DETECTED_VERSION="미감지 (최신 1.25.1+ 표준 문법 적용)"
    NGINX_MODE="directive"
  fi
}

##
# TLS 버전 문자열을 Nginx ssl_protocols 표준 표기(예: TLSv1.2, TLSv1.3, TLSv1.4)로 정규화
#
# @param $1 {string} 입력 TLS 버전 (예: tls1.2, tls1.3, tls1.4, TLSv1.2, 1.3)
#
# @return 0 성공 (stdout으로 정규화된 문자열 출력), 1 유효하지 않은 형식
##
normalize_tls_version() {
  local raw="$1"
  local lower="${raw,,}"
  local ver=""

  if [[ "$lower" =~ ^(tls)?v?([1-9][0-9]*(\.[0-9]+)*)$ ]]; then
    ver="${BASH_REMATCH[2]}"
    if [[ "$ver" == "1" || "$ver" == "1.0" ]]; then
      echo "TLSv1"
    else
      echo "TLSv${ver}"
    fi
    return 0
  fi

  return 1
}

##
# 커맨드라인 인자 파싱 (단축 옵션 금지, Long Option 전용)
##
parse_arguments() {
  if (( $# == 0 )); then
    show_help
    exit 1
  fi

  while (( $# > 0 )); do
    case "$1" in
      http2)
        SUBCOMMAND="http2"
        if (( $# < 2 )) || [[ "$2" =~ ^- ]]; then
          echo -e "${CLR_RED}오류: 'http2' 서브커맨드 뒤에 'enable', 'disable' 또는 'status' 액션을 지정해야 합니다.${CLR_RESET}" >&2
          echo "예시: ngxconf-ctl http2 status" >&2
          exit 1
        fi
        case "$2" in
          enable|disable|status)
            ACTION="$2"
            shift 2
            ;;
          *)
            echo -e "${CLR_RED}오류: 지원하지 않는 액션입니다: '$2' (enable, disable 또는 status 지정 필요)${CLR_RESET}" >&2
            exit 1
            ;;
        esac
        ;;
      ssl_protocols)
        SUBCOMMAND="ssl_protocols"
        if (( $# < 2 )) || [[ "$2" =~ ^- ]]; then
          echo -e "${CLR_RED}오류: 'ssl_protocols' 서브커맨드 뒤에 'status' 또는 '<tls버전> <enable|disable>'을 지정해야 합니다.${CLR_RESET}" >&2
          echo "예시: ngxconf-ctl ssl_protocols status" >&2
          echo "예시: ngxconf-ctl ssl_protocols tls1.3 enable" >&2
          exit 1
        fi
        if [[ "$2" == "status" ]]; then
          ACTION="status"
          shift 2
        else
          local normalized_ver=""
          if ! normalized_ver="$(normalize_tls_version "$2")"; then
            echo -e "${CLR_RED}오류: 유효하지 않은 TLS 버전 또는 액션입니다: '$2'${CLR_RESET}" >&2
            echo "예시: ngxconf-ctl ssl_protocols status" >&2
            echo "예시: ngxconf-ctl ssl_protocols tls1.2 enable" >&2
            exit 1
          fi
          RAW_TLS_VERSION="$2"
          TARGET_TLS_VERSION="$normalized_ver"

          if (( $# < 3 )) || [[ "$3" =~ ^- ]]; then
            echo -e "${CLR_RED}오류: '${2}' 뒤에 'enable' 또는 'disable' 액션을 지정해야 합니다.${CLR_RESET}" >&2
            echo "예시: ngxconf-ctl ssl_protocols ${2} enable" >&2
            exit 1
          fi
          case "$3" in
            enable|disable)
              ACTION="$3"
              shift 3
              ;;
            *)
              echo -e "${CLR_RED}오류: 지원하지 않는 액션입니다: '$3' (enable 또는 disable 지정 필요)${CLR_RESET}" >&2
              exit 1
              ;;
          esac
        fi
        ;;
      --conf-dir)
        if (( $# < 2 )) || [[ "$2" =~ ^- ]]; then
          echo -e "${CLR_RED}오류: '--conf-dir' 옵션에 유효한 디렉토리 경로를 지정해야 합니다.${CLR_RESET}" >&2
          exit 1
        fi
        OPT_CONF_DIR="$2"
        shift 2
        ;;
      --dry-run)
        OPT_DRY_RUN=true
        shift 1
        ;;
      --no-backup)
        OPT_BACKUP=false
        shift 1
        ;;
      --nginx-version)
        if (( $# < 2 )) || [[ "$2" =~ ^- ]]; then
          echo -e "${CLR_RED}오류: '--nginx-version' 옵션에 버전 번호를 입력해야 합니다.${CLR_RESET}" >&2
          exit 1
        fi
        OPT_NGINX_VERSION="$2"
        shift 2
        ;;
      --help)
        show_help
        exit 0
        ;;
      *)
        echo -e "${CLR_RED}오류: 알 수 없는 옵션 또는 인자입니다: '$1'${CLR_RESET}" >&2
        show_help
        exit 1
        ;;
    esac
  done

  if [[ -z "$SUBCOMMAND" ]]; then
    echo -e "${CLR_RED}오류: 실행할 서브커맨드를 지정해야 합니다. (지원: 'http2', 'ssl_protocols')${CLR_RESET}" >&2
    show_help
    exit 1
  fi
}

##
# 단일 conf 파일 내에서 directive 모드 (Nginx 1.25.1+) http2 활성화
##
enable_http2_directive() {
  local file="$1"

  # 1. 주석 형태의 '# http2 on;' 이 존재하는지 검사
  local comment_regex='^[[:space:]]*#[[:space:]]*http2[[:space:]]+on[[:space:]]*;'
  if grep -qE "$comment_regex" "$file"; then
    echo -e "   ${CLR_CYAN}ℹ️  [주석 감지] 주석 처리된 'http2 on;' 설정을 주석 해제(활성화)합니다.${CLR_RESET}"
    if [[ "$OPT_DRY_RUN" == "true" ]]; then
      grep -nE "$comment_regex" "$file" | sed 's/^/   [현재] /'
      echo -e "   ${CLR_GREEN}[변경] 주석(#) 기호 해제 -> http2 on;${CLR_RESET}"
      return 0
    fi

    run_priv_cmd "$file" sed -i -E 's/^([[:space:]]*)#[[:space:]]*http2[[:space:]]+on[[:space:]]*;/\1http2 on;/' "$file"
    echo -e "   ${CLR_GREEN}✅ [성공] 주석 해제 완료!${CLR_RESET}"
    return 0
  fi

  # 2. 이미 활성화된 'http2 on;' 이 존재하는지 검사
  local active_regex='^[[:space:]]*http2[[:space:]]+on[[:space:]]*;'
  if grep -qE "$active_regex" "$file"; then
    echo -e "   ${CLR_YELLOW}ℹ️  [이미 설정됨] 'http2 on;' 설정이 이미 활성화되어 있습니다. (변경 없음)${CLR_RESET}"
    return 2
  fi

  # 3. 주석도 없고 활성화도 안 된 경우 -> listen 지시어 아래에 추가
  local listen_regex='^[[:space:]]*listen[[:space:]]+'
  if grep -qE "$listen_regex" "$file"; then
    echo -e "   ${CLR_CYAN}ℹ️  [신규 추가] 'listen' 지시어 아래에 'http2 on;' 설정을 추가합니다.${CLR_RESET}"

    # SSL이 포함된 listen 라인이 있으면 우선 선택, 없으면 첫 번째 listen 라인 선택
    local target_line_no=""
    target_line_no=$(grep -nE '^[[:space:]]*listen[[:space:]]+[^;]*ssl' "$file" | head -n 1 | cut -d: -f1 || true)
    if [[ -z "$target_line_no" ]]; then
      target_line_no=$(grep -nE '^[[:space:]]*listen[[:space:]]+' "$file" | head -n 1 | cut -d: -f1 || true)
    fi

    if [[ -z "$target_line_no" ]]; then
      echo -e "   ${CLR_YELLOW}⚠️  [경고] 유효한 'listen' 지시어 라인을 찾지 못했습니다.${CLR_RESET}" >&2
      return 1
    fi

    # 대상 listen 라인의 들여쓰기 추출
    local target_line
    target_line=$(sed -n "${target_line_no}p" "$file")
    local indent=""
    local indent_regex='^([[:space:]]+)'
    if [[ "$target_line" =~ $indent_regex ]]; then
      indent="${BASH_REMATCH[1]}"
    fi

    if [[ "$OPT_DRY_RUN" == "true" ]]; then
      echo "   [현재 라인 ${target_line_no}] $target_line"
      echo -e "   ${CLR_GREEN}[추가 라인 ${target_line_no}+1] ${indent}http2 on;${CLR_RESET}"
      return 0
    fi

    # 안전한 임시 파일 생성 후 치환 (부모 디렉토리 권한 제약 대응)
    local tmp_file
    tmp_file=$(mktemp /tmp/ngxconf_ctl_XXXXXX.tmp)
    awk -v target="$target_line_no" -v newline="${indent}http2 on;" '
      NR == target { print $0; print newline; next }
      { print $0 }
    ' "$file" > "$tmp_file"

    run_priv_cmd "$file" cp "$tmp_file" "$file"
    rm -f "$tmp_file"

    echo -e "   ${CLR_GREEN}✅ [성공] 'listen' 설정 아래에 'http2 on;' 추가 완료!${CLR_RESET}"
    return 0
  else
    echo -e "   ${CLR_YELLOW}⚠️  [건너뜀] 파일 내에 'listen' 지시어가 존재하지 않아 http2를 추가할 수 없습니다.${CLR_RESET}"
    return 1
  fi
}

##
# 단일 conf 파일 내에서 directive 모드 (Nginx 1.25.1+) http2 비활성화
##
disable_http2_directive() {
  local file="$1"

  # 1. 활성화된 'http2 on;' 지시어가 존재하는지 검사
  local active_regex='^[[:space:]]*http2[[:space:]]+on[[:space:]]*;'
  if grep -qE "$active_regex" "$file"; then
    echo -e "   ${CLR_CYAN}ℹ️  [설정 감지] 활성화된 'http2 on;' 설정을 주석 처리합니다.${CLR_RESET}"

    if [[ "$OPT_DRY_RUN" == "true" ]]; then
      grep -nE "$active_regex" "$file" | sed 's/^/   [현재] /'
      echo -e "   ${CLR_YELLOW}[변경] 주석(#) 처리 -> # http2 on;${CLR_RESET}"
      return 0
    fi

    run_priv_cmd "$file" sed -i -E 's/^([[:space:]]*)http2[[:space:]]+on[[:space:]]*;/\1# http2 on;/' "$file"
    echo -e "   ${CLR_GREEN}✅ [성공] 주석 처리 완료!${CLR_RESET}"
    return 0
  fi

  # 2. 이미 주석 처리되어 있거나 설정이 없는 경우
  local comment_regex='^[[:space:]]*#[[:space:]]*http2[[:space:]]+on[[:space:]]*;'
  if grep -qE "$comment_regex" "$file"; then
    echo -e "   ${CLR_GRAY}ℹ️  [설정 없음] 이미 '# http2 on;'으로 주석 처리되어 있습니다. (변경 없음)${CLR_RESET}"
    return 2
  fi

  echo -e "   ${CLR_YELLOW}ℹ️  [설정 없음] 파일 내에 'http2 on' 설정이 없습니다.${CLR_RESET}"
  return 2
}

##
# 단일 conf 파일 내에서 listen 모드 (Nginx 1.25.1 미만) http2 활성화
##
enable_http2_listen() {
  local file="$1"

  # 1. 이미 listen 뒤에 http2 파라미터가 있는지 검사
  local listen_h2_regex='^[[:space:]]*listen[[:space:]]+[^;]*http2'
  if grep -qE "$listen_h2_regex" "$file"; then
    echo -e "   ${CLR_YELLOW}ℹ️  [이미 설정됨] 'listen' 지시어에 이미 'http2' 파라미터가 활성화되어 있습니다.${CLR_RESET}"
    return 2
  fi

  # 2. ssl listen 지시어 탐색
  local listen_ssl_regex='^[[:space:]]*listen[[:space:]]+[^;]*ssl'
  if grep -qE "$listen_ssl_regex" "$file"; then
    echo -e "   ${CLR_CYAN}ℹ️  [구버전 호환] 'listen ... ssl' 라인에 'http2' 파라미터를 추가합니다.${CLR_RESET}"

    if [[ "$OPT_DRY_RUN" == "true" ]]; then
      grep -nE "$listen_ssl_regex" "$file" | sed 's/^/   [현재] /'
      echo -e "   ${CLR_GREEN}[변경] listen ... ssl -> listen ... ssl http2;${CLR_RESET}"
      return 0
    fi

    run_priv_cmd "$file" sed -i -E 's/(listen[[:space:]]+[^;]*ssl[^;]*);/\1 http2;/' "$file"
    echo -e "   ${CLR_GREEN}✅ [성공] 'listen ... ssl http2;' 추가 완료!${CLR_RESET}"
    return 0
  else
    echo -e "   ${CLR_YELLOW}⚠️  [건너뜀] 'listen ... ssl' 라인을 찾을 수 없어 http2 파라미터를 추가할 수 없습니다.${CLR_RESET}"
    return 1
  fi
}

##
# 단일 conf 파일 내에서 listen 모드 (Nginx 1.25.1 미만) http2 비활성화
##
disable_http2_listen() {
  local file="$1"

  # 1. listen 뒤에 http2 파라미터가 있는지 검사
  local listen_h2_regex='^[[:space:]]*listen[[:space:]]+[^;]*http2'
  if grep -qE "$listen_h2_regex" "$file"; then
    echo -e "   ${CLR_CYAN}ℹ️  [구버전 호환] 'listen' 지시어에서 'http2' 파라미터를 제거합니다.${CLR_RESET}"

    if [[ "$OPT_DRY_RUN" == "true" ]]; then
      grep -nE "$listen_h2_regex" "$file" | sed 's/^/   [현재] /'
      echo -e "   ${CLR_YELLOW}[변경] http2 파라미터 제거${CLR_RESET}"
      return 0
    fi

    run_priv_cmd "$file" sed -i -E 's/(listen[[:space:]]+[^;]*)http2[[:space:]]*/\1/' "$file"
    run_priv_cmd "$file" sed -i -E 's/[[:space:]]+;/;/' "$file"
    echo -e "   ${CLR_GREEN}✅ [성공] 'http2' 파라미터 제거 완료!${CLR_RESET}"
    return 0
  fi

  echo -e "   ${CLR_YELLOW}ℹ️  [설정 없음] 'listen' 지시어에 'http2' 파라미터 설정이 없습니다.${CLR_RESET}"
  return 2
}

##
# 단일 conf 파일 내에서 HTTP/2 설정 상태 조회
#
# @param $1 {string} 대상 conf 파일 경로
# @return 0 조회 완료
##
status_http2() {
  local file="$1"
  local found=false

  local active_dir_regex='^[[:space:]]*http2[[:space:]]+on[[:space:]]*;'
  local off_dir_regex='^[[:space:]]*http2[[:space:]]+off[[:space:]]*;'
  local comment_dir_regex='^[[:space:]]*#[[:space:]]*http2[[:space:]]+(on|off)[[:space:]]*;'
  local active_listen_regex='^[[:space:]]*listen[[:space:]]+[^;]*http2([[:space:]]|;)'
  local comment_listen_regex='^[[:space:]]*#[[:space:]]*listen[[:space:]]+[^;]*http2([[:space:]]|;)'

  if grep -qE "$active_dir_regex" "$file"; then
    found=true
    while IFS= read -r line; do
      echo -e "   ${CLR_GREEN}✅ [활성화 - 독립 지시어]${CLR_RESET} ${line}"
    done < <(grep -nE "$active_dir_regex" "$file")
  fi

  if grep -qE "$off_dir_regex" "$file"; then
    found=true
    while IFS= read -r line; do
      echo -e "   ${CLR_YELLOW}⏸️  [비활성화 - 명시적 off]${CLR_RESET} ${line}"
    done < <(grep -nE "$off_dir_regex" "$file")
  fi

  if grep -qE "$comment_dir_regex" "$file"; then
    found=true
    while IFS= read -r line; do
      echo -e "   ${CLR_GRAY}💤 [비활성화 - 주석 처리]${CLR_RESET} ${line}"
    done < <(grep -nE "$comment_dir_regex" "$file")
  fi

  if grep -qE "$active_listen_regex" "$file"; then
    found=true
    while IFS= read -r line; do
      echo -e "   ${CLR_GREEN}✅ [활성화 - 레거시 listen]${CLR_RESET} ${line}"
    done < <(grep -nE "$active_listen_regex" "$file")
  fi

  if grep -qE "$comment_listen_regex" "$file"; then
    found=true
    while IFS= read -r line; do
      echo -e "   ${CLR_GRAY}💤 [비활성화 - 주석 listen]${CLR_RESET} ${line}"
    done < <(grep -nE "$comment_listen_regex" "$file")
  fi

  if [[ "$found" == "false" ]]; then
    echo -e "   ${CLR_YELLOW}ℹ️  [미설정] HTTP/2 관련 설정이 없습니다.${CLR_RESET}"
  fi

  return 0
}

##
# 단일 conf 파일 내에서 ssl_protocols 설정 상태 조회
#
# @param $1 {string} 대상 conf 파일 경로
# @return 0 조회 완료
##
status_ssl_protocols() {
  local file="$1"
  local found=false

  local active_regex='^[[:space:]]*ssl_protocols[[:space:]]+[^;]*;'
  local comment_regex='^[[:space:]]*#[[:space:]]*ssl_protocols[[:space:]]+[^;]*;'

  if grep -qE "$active_regex" "$file"; then
    found=true
    while IFS= read -r line; do
      local lineno="${line%%:*}"
      local content="${line#*:}"
      local protos
      protos=$(echo "$content" | sed -E 's/^[[:space:]]*ssl_protocols[[:space:]]+//; s/;.*$//' | xargs)
      echo -e "   ${CLR_GREEN}✅ [활성화]${CLR_RESET} 라인 ${lineno}: ${CLR_CYAN}${protos}${CLR_RESET}  (${content#"${content%%[![:space:]]*}"})"
    done < <(grep -nE "$active_regex" "$file")
  fi

  if grep -qE "$comment_regex" "$file"; then
    found=true
    while IFS= read -r line; do
      echo -e "   ${CLR_GRAY}💤 [비활성화 - 주석 처리]${CLR_RESET} ${line}"
    done < <(grep -nE "$comment_regex" "$file")
  fi

  if [[ "$found" == "false" ]]; then
    echo -e "   ${CLR_YELLOW}ℹ️  [미설정] ssl_protocols 설정이 없습니다. (Nginx 기본값 사용)${CLR_RESET}"
  fi

  return 0
}

##
# 단일 conf 파일 내에서 특정 TLS 프로토콜 버전 활성화
#
# @param $1 {string} 대상 conf 파일 경로
# @param $2 {string} 정규화된 TLS 버전 (예: TLSv1.2, TLSv1.3, TLSv1.4)
# @return 0 변경 완료(예정), 2 변경 없음(스킵), 1 오류
##
enable_ssl_protocols() {
  local file="$1"
  local target_proto="$2"

  local active_regex='^[[:space:]]*ssl_protocols[[:space:]]+[^;]*;'
  local comment_regex='^[[:space:]]*#[[:space:]]*ssl_protocols[[:space:]]+[^;]*;'

  # 1. 활성화된 ssl_protocols 지시어가 존재하는 경우
  if grep -qE "$active_regex" "$file"; then
    local needs_update=false
    while IFS= read -r line; do
      local protos
      protos=$(echo "$line" | sed -E 's/^[[:space:]]*ssl_protocols[[:space:]]+//; s/;.*$//')
      local has_proto=false
      for p in $protos; do
        if [[ "$p" == "$target_proto" ]]; then
          has_proto=true
          break
        fi
      done
      if [[ "$has_proto" == "false" ]]; then
        needs_update=true
        break
      fi
    done < <(grep -E "$active_regex" "$file")

    if [[ "$needs_update" == "false" ]]; then
      echo -e "   ${CLR_YELLOW}ℹ️  [이미 설정됨] '${target_proto}' 프로토콜이 이미 활성화되어 있습니다. (변경 없음)${CLR_RESET}"
      return 2
    fi

    echo -e "   ${CLR_CYAN}ℹ️  [프로토콜 추가] 기존 'ssl_protocols' 지시어에 '${target_proto}'를 추가합니다.${CLR_RESET}"

    local tmp_file
    tmp_file=$(mktemp /tmp/ngxconf_ctl_XXXXXX.tmp)
    awk -v target="$target_proto" '
      /^[[:space:]]*ssl_protocols[[:space:]]+[^;]*;/ {
        line = $0
        semi_pos = index(line, ";")
        before = substr(line, 1, semi_pos - 1)
        after = substr(line, semi_pos)
        sub(/[[:space:]]+$/, "", before)
        n = split(before, tokens, /[[:space:]]+/)
        found = 0
        for (i = 2; i <= n; i++) {
          if (tokens[i] == target) { found = 1; break }
        }
        if (!found) {
          print before " " target after
          next
        }
      }
      { print $0 }
    ' "$file" > "$tmp_file"

    if [[ "$OPT_DRY_RUN" == "true" ]]; then
      diff -u "$file" "$tmp_file" | grep -E '^[-+][^-+]' | sed 's/^/   /' || true
      rm -f "$tmp_file"
      return 0
    fi

    run_priv_cmd "$file" cp "$tmp_file" "$file"
    rm -f "$tmp_file"
    echo -e "   ${CLR_GREEN}✅ [성공] '${target_proto}' 활성화 완료!${CLR_RESET}"
    return 0
  fi

  # 2. 주석 처리된 '# ssl_protocols ...;' 만 존재하는 경우
  if grep -qE "$comment_regex" "$file"; then
    echo -e "   ${CLR_CYAN}ℹ️  [주석 감지] 주석 처리된 'ssl_protocols' 설정을 해제하고 '${target_proto}'를 활성화합니다.${CLR_RESET}"

    local tmp_file
    tmp_file=$(mktemp /tmp/ngxconf_ctl_XXXXXX.tmp)
    awk -v target="$target_proto" '
      /^[[:space:]]*#[[:space:]]*ssl_protocols[[:space:]]+[^;]*;/ {
        line = $0
        match(line, /^[[:space:]]*/)
        indent = substr(line, 1, RLENGTH)
        rest = substr(line, RLENGTH + 1)
        sub(/^#[[:space:]]*/, "", rest)
        semi_pos = index(rest, ";")
        before = substr(rest, 1, semi_pos - 1)
        after = substr(rest, semi_pos)
        sub(/[[:space:]]+$/, "", before)
        n = split(before, tokens, /[[:space:]]+/)
        found = 0
        for (i = 2; i <= n; i++) {
          if (tokens[i] == target) { found = 1; break }
        }
        if (!found) {
          print indent before " " target after
        } else {
          print indent before after
        }
        next
      }
      { print $0 }
    ' "$file" > "$tmp_file"

    if [[ "$OPT_DRY_RUN" == "true" ]]; then
      diff -u "$file" "$tmp_file" | grep -E '^[-+][^-+]' | sed 's/^/   /' || true
      rm -f "$tmp_file"
      return 0
    fi

    run_priv_cmd "$file" cp "$tmp_file" "$file"
    rm -f "$tmp_file"
    echo -e "   ${CLR_GREEN}✅ [성공] 주석 해제 및 '${target_proto}' 활성화 완료!${CLR_RESET}"
    return 0
  fi

  # 3. ssl_protocols 지시어가 없는 경우 -> SSL 설정이 있는 파일인지 확인 후 신규 추가
  local target_line_no=""
  target_line_no=$(grep -nE '^[[:space:]]*listen[[:space:]]+[^;]*ssl' "$file" | head -n 1 | cut -d: -f1 || true)
  if [[ -z "$target_line_no" ]]; then
    target_line_no=$(grep -nE '^[[:space:]]*ssl_certificate[[:space:]]+' "$file" | head -n 1 | cut -d: -f1 || true)
  fi

  if [[ -z "$target_line_no" ]]; then
    echo -e "   ${CLR_GRAY}ℹ️  [건너뜀] SSL 설정('listen ... ssl' 또는 'ssl_certificate')이 없어 ssl_protocols를 추가하지 않습니다.${CLR_RESET}"
    return 2
  fi

  local target_line
  target_line=$(sed -n "${target_line_no}p" "$file")
  local indent=""
  local indent_regex='^([[:space:]]+)'
  if [[ "$target_line" =~ $indent_regex ]]; then
    indent="${BASH_REMATCH[1]}"
  fi

  echo -e "   ${CLR_CYAN}ℹ️  [신규 추가] SSL 설정 아래에 'ssl_protocols ${target_proto};' 설정을 추가합니다.${CLR_RESET}"

  if [[ "$OPT_DRY_RUN" == "true" ]]; then
    echo "   [현재 라인 ${target_line_no}] $target_line"
    echo -e "   ${CLR_GREEN}[추가 라인 ${target_line_no}+1] ${indent}ssl_protocols ${target_proto};${CLR_RESET}"
    return 0
  fi

  local tmp_file
  tmp_file=$(mktemp /tmp/ngxconf_ctl_XXXXXX.tmp)
  awk -v target="$target_line_no" -v newline="${indent}ssl_protocols ${target_proto};" '
    NR == target { print $0; print newline; next }
    { print $0 }
  ' "$file" > "$tmp_file"

  run_priv_cmd "$file" cp "$tmp_file" "$file"
  rm -f "$tmp_file"

  echo -e "   ${CLR_GREEN}✅ [성공] 'ssl_protocols ${target_proto};' 추가 완료!${CLR_RESET}"
  return 0
}

##
# 단일 conf 파일 내에서 특정 TLS 프로토콜 버전 비활성화
#
# @param $1 {string} 대상 conf 파일 경로
# @param $2 {string} 정규화된 TLS 버전 (예: TLSv1.2, TLSv1.3, TLSv1.4)
# @return 0 변경 완료(예정), 2 변경 없음(스킵), 1 오류
##
disable_ssl_protocols() {
  local file="$1"
  local target_proto="$2"

  local active_regex='^[[:space:]]*ssl_protocols[[:space:]]+[^;]*;'

  if ! grep -qE "$active_regex" "$file"; then
    echo -e "   ${CLR_YELLOW}ℹ️  [설정 없음] 활성화된 'ssl_protocols' 설정이 없습니다. (변경 없음)${CLR_RESET}"
    return 2
  fi

  # 대상 프로토콜이 실제로 포함되어 있는지 확인
  local has_target=false
  while IFS= read -r line; do
    local protos
    protos=$(echo "$line" | sed -E 's/^[[:space:]]*ssl_protocols[[:space:]]+//; s/;.*$//')
    for p in $protos; do
      if [[ "$p" == "$target_proto" ]]; then
        has_target=true
        break 2
      fi
    done
  done < <(grep -E "$active_regex" "$file")

  if [[ "$has_target" == "false" ]]; then
    echo -e "   ${CLR_YELLOW}ℹ️  [설정 없음] '${target_proto}' 프로토콜이 설정되어 있지 않습니다. (변경 없음)${CLR_RESET}"
    return 2
  fi

  echo -e "   ${CLR_CYAN}ℹ️  [프로토콜 제거] 'ssl_protocols' 설정에서 '${target_proto}'를 비활성화합니다.${CLR_RESET}"

  local tmp_file
  tmp_file=$(mktemp /tmp/ngxconf_ctl_XXXXXX.tmp)
  awk -v target="$target_proto" '
    /^[[:space:]]*ssl_protocols[[:space:]]+[^;]*;/ {
      line = $0
      match(line, /^[[:space:]]*/)
      indent = substr(line, 1, RLENGTH)
      semi_pos = index(line, ";")
      before = substr(line, 1, semi_pos - 1)
      after = substr(line, semi_pos)
      sub(/^[[:space:]]*ssl_protocols[[:space:]]+/, "", before)
      n = split(before, tokens, /[[:space:]]+/)
      kept = ""
      kept_count = 0
      removed = 0
      for (i = 1; i <= n; i++) {
        if (tokens[i] == "") continue
        if (tokens[i] == target) {
          removed = 1
        } else {
          kept = (kept_count == 0) ? tokens[i] : kept " " tokens[i]
          kept_count++
        }
      }
      if (removed) {
        if (kept_count > 0) {
          print indent "ssl_protocols " kept after
        } else {
          # 마지막 프로토콜 제거 시 빈 ssl_protocols 문법 오류 방지를 위해 주석 처리
          print indent "# ssl_protocols " target after
        }
        next
      }
    }
    { print $0 }
  ' "$file" > "$tmp_file"

  if [[ "$OPT_DRY_RUN" == "true" ]]; then
    diff -u "$file" "$tmp_file" | grep -E '^[-+][^-+]' | sed 's/^/   /' || true
    rm -f "$tmp_file"
    return 0
  fi

  run_priv_cmd "$file" cp "$tmp_file" "$file"
  rm -f "$tmp_file"
  echo -e "   ${CLR_GREEN}✅ [성공] '${target_proto}' 비활성화 완료!${CLR_RESET}"
  return 0
}

##
# 메인 제어 루틴
##
main() {
  # 1. 보안 정책 검증: 외부 sudo 실행 차단
  reject_external_sudo

  # 2. 인자 파싱 및 Nginx 정보 감지
  parse_arguments "$@"
  detect_nginx_info

  # 3. 대상 디렉토리 배열화
  local -a target_dirs=()
  local raw_dirs="$OPT_CONF_DIR"
  IFS=',' read -r -a target_dirs <<< "$raw_dirs"

  echo "$SEPARATOR_LINE"
  echo -e "${CLR_BOLD}🚀 [ngxconf-ctl] Nginx 설정 파일 옵션 제어 도구${CLR_RESET}"
  echo "$SEPARATOR_LINE"
  if [[ "$SUBCOMMAND" == "ssl_protocols" && -n "$TARGET_TLS_VERSION" ]]; then
    echo -e "  - 제어 대상 기능   : ${CLR_CYAN}${SUBCOMMAND^^}${CLR_RESET} (${TARGET_TLS_VERSION} / ${ACTION})"
  else
    echo -e "  - 제어 대상 기능   : ${CLR_CYAN}${SUBCOMMAND^^}${CLR_RESET} (${ACTION})"
  fi
  echo -e "  - 감지된 Nginx 버전: ${CLR_BOLD}${DETECTED_VERSION}${CLR_RESET}"
  if [[ "$SUBCOMMAND" == "http2" ]]; then
    if [[ "$NGINX_MODE" == "directive" ]]; then
      echo -e "  - 적용 문법 모드   : ${CLR_GREEN}최신 독립 지시어 모드 ('http2 on;' Nginx 1.25.1+)${CLR_RESET}"
    else
      echo -e "  - 적용 문법 모드   : ${CLR_YELLOW}레거시 Listen 파라미터 모드 ('listen ... http2;' Nginx < 1.25.1)${CLR_RESET}"
    fi
  fi
  if [[ "$ACTION" == "status" ]]; then
    echo -e "  - 실행 모드        : ${CLR_CYAN}상태 조회 (Read-Only: 파일 수정 안 함)${CLR_RESET}"
  else
    echo -e "  - 시뮬레이션 모드  : $([[ "$OPT_DRY_RUN" == "true" ]] && echo -e "${CLR_YELLOW}활성화 (Dry-Run: 실제 파일 수정 안 함)${CLR_RESET}" || echo "비활성화 (실제 파일 수정)")"
  fi
  echo "--------------------------------------------------------------------------------------"

  # 4. 실제 수정 작업 시 root 권한 필요 여부 사전 검사 및 1회 인증 캐싱
  if [[ "$OPT_DRY_RUN" != "true" && "$ACTION" != "status" ]]; then
    local need_sudo=false
    for d in "${target_dirs[@]}"; do
      d=$(echo "$d" | xargs)
      [[ -d "$d" ]] || continue
      while IFS= read -r -d '' cf; do
        if is_sudo_required_for_file "$cf"; then
          need_sudo=true
          break 2
        fi
      done < <(find "$d" -maxdepth 1 -name "*.conf" -type f -print0 2>/dev/null || true)
    done

    if [[ "$need_sudo" == "true" ]]; then
      echo -e "${CLR_CYAN}🔐 관리자(root) 권한이 필요한 설정 파일이 포함되어 있습니다. sudo 인증을 확인합니다...${CLR_RESET}"
      if ! sudo -v; then
        echo -e "${CLR_RED}❌ [오류] sudo 인증에 실패하였거나 권한이 없어 작업을 중단합니다.${CLR_RESET}" >&2
        exit 1
      fi
      echo -e "${CLR_GREEN}✅ sudo 권한 확인 완료.${CLR_RESET}\n"
    fi
  fi

  local total_files=0
  local modified_files=0
  local skipped_files=0
  local error_files=0

  for dir in "${target_dirs[@]}"; do
    dir=$(echo "$dir" | xargs)
    echo -e "📂 [디렉토리 검사]: ${CLR_BOLD}${dir}${CLR_RESET}"

    if [[ ! -d "$dir" ]]; then
      echo -e "   ${CLR_RED}⚠️  존재하지 않는 디렉토리입니다: '${dir}'${CLR_RESET}"
      error_files=$((error_files + 1))
      continue
    fi

    local -a conf_files=()
    while IFS= read -r -d '' f; do
      conf_files+=("$f")
    done < <(find "$dir" -maxdepth 1 -name "*.conf" -type f -print0 | sort -z)

    if (( ${#conf_files[@]} == 0 )); then
      echo -e "   ${CLR_GRAY}ℹ️  디렉토리 내에 '*.conf' 파일이 없습니다.${CLR_RESET}"
      continue
    fi

    for conf in "${conf_files[@]}"; do
      total_files=$((total_files + 1))
      echo -e "\n📄 [파일 검사]: ${CLR_BOLD}${conf}${CLR_RESET}"

      if [[ "$OPT_DRY_RUN" != "true" && "$ACTION" != "status" ]] && is_sudo_required_for_file "$conf"; then
        echo -e "   ${CLR_CYAN}🔐 [권한 상승] 대상 파일 수정 시 root(sudo) 권한을 적용합니다.${CLR_RESET}"
      fi

      if [[ "$OPT_DRY_RUN" != "true" && "$ACTION" != "status" && "$OPT_BACKUP" == "true" ]]; then
        run_priv_cmd "$conf" cp -a "$conf" "${conf}.bak"
      fi

      local ret=0
      if [[ "$SUBCOMMAND" == "http2" ]]; then
        if [[ "$ACTION" == "status" ]]; then
          status_http2 "$conf" || ret=$?
        elif [[ "$ACTION" == "enable" ]]; then
          if [[ "$NGINX_MODE" == "directive" ]]; then
            enable_http2_directive "$conf" || ret=$?
          else
            enable_http2_listen "$conf" || ret=$?
          fi
        elif [[ "$ACTION" == "disable" ]]; then
          if [[ "$NGINX_MODE" == "directive" ]]; then
            disable_http2_directive "$conf" || ret=$?
          else
            disable_http2_listen "$conf" || ret=$?
          fi
        fi
      elif [[ "$SUBCOMMAND" == "ssl_protocols" ]]; then
        if [[ "$ACTION" == "status" ]]; then
          status_ssl_protocols "$conf" || ret=$?
        elif [[ "$ACTION" == "enable" ]]; then
          enable_ssl_protocols "$conf" "$TARGET_TLS_VERSION" || ret=$?
        elif [[ "$ACTION" == "disable" ]]; then
          disable_ssl_protocols "$conf" "$TARGET_TLS_VERSION" || ret=$?
        fi
      fi

      case "$ret" in
        0)
          modified_files=$((modified_files + 1))
          ;;
        2)
          skipped_files=$((skipped_files + 1))
          ;;
        *)
          error_files=$((error_files + 1))
          ;;
      esac
    done
    echo
  done

  echo "$SEPARATOR_LINE"
  if [[ "$ACTION" == "status" ]]; then
    echo -e "${CLR_BOLD}📊 [상태 조회 요약 보고]${CLR_RESET}"
    echo "$SEPARATOR_LINE"
    echo -e "  - 총 조회 대상 파일 수  : ${total_files}개"
    if (( error_files > 0 )); then
      echo -e "  - 오류/경고 파일 수     : ${CLR_RED}${error_files}개${CLR_RESET}"
    fi
  else
    echo -e "${CLR_BOLD}📊 [작업 요약 보고]${CLR_RESET}"
    echo "$SEPARATOR_LINE"
    echo -e "  - 총 점검 대상 파일 수  : ${total_files}개"
    echo -e "  - 변경 완료(예정) 파일 수: ${CLR_GREEN}${modified_files}개${CLR_RESET}"
    echo -e "  - 변경 없음(스킵) 파일 수: ${CLR_GRAY}${skipped_files}개${CLR_RESET}"
    if (( error_files > 0 )); then
      echo -e "  - 오류/경고 파일 수     : ${CLR_RED}${error_files}개${CLR_RESET}"
    fi
  fi
  echo "$SEPARATOR_LINE"

  # Nginx 문법 검사 (Dry-run, status가 아니고 수정된 파일이 있으며 nginx 명령어가 있을 때)
  if [[ "$OPT_DRY_RUN" != "true" && "$ACTION" != "status" && $modified_files -gt 0 ]] && command -v nginx >/dev/null 2>&1; then
    echo -e "🔍 [Nginx 문법 검사]: 'nginx -t' 실행 중..."
    local nginx_test_ok=false
    if nginx -t >/dev/null 2>&1; then
      nginx_test_ok=true
    elif sudo -n nginx -t >/dev/null 2>&1; then
      nginx_test_ok=true
    fi

    if [[ "$nginx_test_ok" == "true" ]]; then
      echo -e "${CLR_GREEN}✅ Nginx 설정 파일 문법 검사 통과 (Syntax OK)${CLR_RESET}"
      echo -e "💡 Nginx 서비스 재적용 명령: ${CLR_CYAN}sudo systemctl reload nginx${CLR_RESET} 또는 ${CLR_CYAN}sudo nginx -s reload${CLR_RESET}"
    else
      echo -e "${CLR_YELLOW}ℹ️  [안내] Nginx 문법 검사는 시스템 권한 필요 시 'sudo nginx -t'로 확인하실 수 있습니다.${CLR_RESET}"
      if [[ "$OPT_BACKUP" == "true" ]]; then
        echo -e "   백업 파일(*.bak)을 통해 언제든지 설정을 복원할 수 있습니다."
      fi
    fi
    echo "$SEPARATOR_LINE"
  fi
}

main "$@"
