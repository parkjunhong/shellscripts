# @license  : Apache License 2.0
# @since    : 2026-10-26
# @desc     : Print abbreviated git commit log with branch decoration (Linux/macOS)
# @installation :
#   1. insert 'source <path>/git-log-abbr' into ~/.bashrc or ~/.bash_profile for personal usage.
#   2. copy to /usr/local/bin/ or use scriptctl for system-wide installation.
# =======================================

readonly SCRIPT_FILE_VERSION="2026.11.26.1"

set -Eeuo pipefail

FILENAME="$(basename "$0")"

##
# 스크립트의 사용법 및 오류 진단 정보를 출력합니다.
#
# @param $1 {string} 실패 원인 메시지 (선택)
# @param $2 {number} 오류 발생 라인 번호 (선택)
#
# @return 0: 도움말 출력 완료
##
help() {
  if [[ -n "${1:-}" ]]; then
    local indent=10
    local formatl=" - %-${indent}s: %s\n"
    local formatr=" - %${indent}s: %s\n"
    echo >&2
    echo "================================================================================" >&2
    printf "$formatl" "filename" "$FILENAME" >&2
    printf "$formatl" "line" "${2:-$LINENO}" >&2
    printf "$formatl" "callstack" "" >&2
    local idx=1
    local func
    for func in "${FUNCNAME[@]:1}"; do
      printf "$formatr" "[$idx]" "$func" >&2
      idx=$((idx + 1))
    done
    printf "$formatl" "cause" "$1" >&2
    echo "================================================================================" >&2
  fi

  echo
  echo "사용법:"
  echo "  $FILENAME"
  echo "  $FILENAME --help"
  echo
  echo "설명:"
  echo "  현재 Git 저장소의 커밋 히스토리를 축약 해시, 한 줄 요약 및 브랜치/태그 데코레이션(--decorate)과 함께 출력합니다."
  echo "  watch 하위에서 실행되는 경우 자동으로 감지하여 --color=always를 적용합니다."
  echo "  (참고: watch에서 색상을 표시하려면 'watch --color $FILENAME' 또는 'alias watch=\"watch --color\"' 설정이 필요합니다.)"
  echo
  echo "옵션 상세:"
  echo "  --help     도움말 출력"
  echo
}

##
# 커맨드라인 인자를 파싱하고 유효성을 검증합니다.
#
# @param $@ {array} 커맨드라인 파라미터 배열
#
# @return 0: 성공, 1: 알 수 없는 옵션
##
parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help)
        help
        exit 0
        ;;
      *)
        help "알 수 없는 옵션입니다: $1" "$LINENO"
        return 1
        ;;
    esac
  done
  return 0
}

##
# 현재 스크립트가 watch 명령어 하위에서 실행 중인지 조상 프로세스를 탐색하여 판별합니다.
#
# @param 없음
#
# @return 0: watch 하위 실행, 1: 일반 실행
##
is_under_watch() {
  local pid="$PPID"
  local depth=0
  local proc_info=""
  local ppid=""
  local comm=""

  while [[ -n "$pid" && "$pid" -gt 1 && "$depth" -lt 10 ]]; do
    proc_info="$(ps -o ppid=,comm= -p "$pid" 2>/dev/null || true)"
    [[ -z "$proc_info" ]] && break

    read -r ppid comm <<< "$proc_info"
    if [[ "$comm" == "watch" || "${comm##*/}" == "watch" ]]; then
      return 0
    fi

    [[ -z "$ppid" || "$ppid" == "$pid" ]] && break
    pid="$ppid"
    depth=$((depth + 1))
  done

  return 1
}

##
# git log 명령어를 구성하여 커밋 로그를 출력합니다.
#
# @param 없음
#
# @return 0: 성공, 1: git log 실행 실패
##
main() {
  local -a git_cmd=(git log --abbrev-commit --pretty=oneline --decorate)

  if is_under_watch; then
    git_cmd+=(--color=always)
  fi

  "${git_cmd[@]}"
}

parse_args "$@" || exit 1
main

exit 0
