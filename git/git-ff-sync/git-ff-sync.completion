# =======================================
# @author   : parkjunhong77@gmail.com
# @title    : git-ff-sync completion
# @license  : Apache License 2.0
# @since    : 2026-11-11
# @desc     : Bash completion for git-ff-sync
# @installation : 
#   1. insert 'source <path>/git-ff-sync.completion' into ~/.bashrc or ~/.bash_profile for personal usage.
#   2. copy to /etc/bash_completion.d/ for all users.
# =======================================

_git_ff_sync_completion() {
  local cur prev opts remotes branches
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  # 1. Git 저장소 유효성 검사 (Git 저장소 내부가 아닌 경우)
  if ! command -v git >/dev/null 2>&1 || ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    # Git 저장소가 아니면 git 동기화 관련 옵션 및 브랜치 추천을 차단하고 --help만 지원
    COMPREPLY=( $(compgen -W "--help" -- "${cur}") )
    return 0
  fi

  # 2. Git 저장소 내부인 경우 사용 가능한 옵션 정의
  opts="--remote --source --target --dry-run --help"

  case "${prev}" in
    --remote)
      remotes=$(git remote 2>/dev/null || true)
      [[ -z "$remotes" ]] && remotes="origin"
      COMPREPLY=( $(compgen -W "${remotes}" -- "${cur}") )
      return 0
      ;;
    --source|--target)
      branches=$(git branch --format='%(refname:short)' 2>/dev/null || true)
      local r_branches
      r_branches=$(git branch -r --format='%(refname:short)' 2>/dev/null | sed -e 's|^[^/]*/||' || true)
      local all_b
      all_b=$(echo -e "${branches}\n${r_branches}" | sort -u | grep -v '^HEAD$')
      COMPREPLY=( $(compgen -W "${all_b}" -- "${cur}") )
      return 0
      ;;
    *)
      ;;
  esac

  local available_opts=""
  for opt in $opts; do
    local is_used=0
    for word in "${COMP_WORDS[@]}"; do
      if [[ "$word" == "$opt" ]]; then
        is_used=1
        break
      fi
    done
    if (( is_used == 0 )); then
      available_opts+="$opt "
    fi
  done

  COMPREPLY=( $(compgen -W "${available_opts}" -- "${cur}") )
  return 0
}

complete -F _git_ff_sync_completion git-ff-sync
