# =======================================
# @author : parkjunhong77@gmail.com
# @title : search files.
# @license : Apache License 2.0
# @since : 2026-08-04
# @desc : support Ubuntu 20.04+, RHEL 8+, Oracle Linux 8+, RockyOS 8, CentOS 7
# @installation : 
# 1. insert 'source <path>/git-init.sh.completion" into ~/bin/.bashrc or ~/bin/.bash_profile for a personal usage.
# 2. copy the above file to /etc/bash_completion.d/ or insert 'source <path>/git-init.sh.completion' into /etc/bashrc for all users.
# =======================================
# Global Reserved Variables
# 1. COMP_WORDS: an array, contains all arguments
# 2. COMP_CWORD: a index of a cursor
# 3. COMP_LINE: all command string
# 4. COMPREPLY: an array, contains suggested words. words are sorted and unique.
#
# Arguments of a function
# 1. $1: command
# 2. $2: current
# 3. $3: previous
#
# e.g.: mycmd arg1 arg2 arg3 arg4[tab]
# - $1: mycmd
# - $2: arg4
# - $3: arg3
# =======================================

_git_init_completion() {
  local cur prev opts available_opts
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  # 명령어 옵션 목록 설정 / Set command options list
  opts="-b --branch -r --repository -h --help"

  case "${prev}" in
    -b|--branch)
      local branches
      # 로컬 브랜치 목록 제안 / Suggest local branch list
      branches=$(git branch 2>/dev/null | sed -e 's/*//' | tr -d ' ' || true)
      COMPREPLY=( $(compgen -W "${branches}" -- "${cur}") )
      return 0
      ;;
    -r|--repository)
      # 파라미터가 경로일 경우 파일/디렉토리 추천 / Recommend files/directories if parameter is a path
      COMPREPLY=( $(compgen -f -d -- "${cur}") )
      return 0
      ;;
    *)
      ;;
  esac

  # 이미 입력된 옵션을 필터링 / Filter out already entered options
  available_opts=""
  for opt in $opts; do
    local is_used=0
    for word in "${COMP_WORDS[@]}"; do
      if [ "$word" == "$opt" ]; then
        is_used=1
        break
      fi
    done
    if [ "$is_used" -eq 0 ]; then
      available_opts="$available_opts $opt"
    fi
  done

  # 대시(-) 없이 TAB만 입력해도 파라미터 제안 / Suggest parameters even if only <TAB> is pressed without a dash (-)
  COMPREPLY=( $(compgen -W "${available_opts}" -- "${cur}") )
}

complete -F _git_init_completion git-init.sh
