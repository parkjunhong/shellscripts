#!/usr/bin/env bash
# =======================================
# @author   : parkjunhong77@gmail.com
# @title    : git-pull
# @license  : Apache License 2.0
# @since    : 2026-11-11
# @desc     : Pull current or specified branch with automatic return to origin branch
# @installation : 
#   1. insert 'source <path>/git-pull' into ~/.bashrc or ~/.bash_profile for personal usage.
#   2. copy to /etc/bash_completion.d/ or insert into /etc/bashrc for all users.
# =======================================

set -Eeuo pipefail

FILENAME=$(basename "$0")

ORIGIN_BRANCH=""
TARGET_BRANCH=""

##
# 스크립트의 사용법 및 진단 정보를 표준 출력으로 안내합니다.
#
# @param $1 {string} 실패 원인 메시지 (선택)
# @param $2 {number} 오류 발생 라인 번호 (선택)
#
# @return 사용법 화면 출력
##
help() {
  if [ -n "${1:-}" ]; then
    local indent=10
    local formatl=" - %-"$indent"s: %s\n"
    local formatr=" - %"$indent"s: %s\n"
    echo
    echo "================================================================================"
    printf "$formatl" "filename" "$FILENAME"
    printf "$formatl" "line" "${2:-$LINENO}"
    printf "$formatl" "callstack"
    local idx=1
    for func in "${FUNCNAME[@]:1}"; do
      printf "$formatr" "[$idx]" "$func"
      ((idx++))
    done
    printf "$formatl" "cause" "$1"
    echo "================================================================================"
  fi
  echo
  echo "사용법:"
  echo "  $FILENAME [<branch>]"
  echo "  $FILENAME --help"
  echo
  echo "설명:"
  echo "  현재 작업 중인 브랜치 또는 지정한 브랜치의 최신 변경사항을 원격으로부터 가져옵니다(git pull)."
  echo "  다른 브랜치명을 인자로 전달한 경우, 대상 브랜치로 전환(switch)하여 pull을 수행한 뒤"
  echo "  원래 머물던 작업 브랜치로 안전하게 자동 복귀합니다."
  echo "  (주의: 'git-pull'은 Git 저장소 내에서만 동작할 수 있습니다)"
  echo
  echo "파라미터 상세:"
  echo "  <branch>                  pull을 수행할 대상 브랜치 이름 (선택, 기본값: 현재 작업 브랜치)"
  echo "  --help                    도움말 출력"
  echo
}

##
# 종료 시 실행 전 원래 머물던 브랜치로 안전하게 복귀합니다.
#
# @param 없음
#
# @return 원래 브랜치 체크아웃
##
cleanup() {
  local exit_code=$?
  if [[ -n "${ORIGIN_BRANCH:-}" ]]; then
    local cur_b
    cur_b=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
    if [[ -n "$cur_b" && "$cur_b" != "$ORIGIN_BRANCH" ]]; then
      echo
      echo "↩️  [복귀] 원래 작업 브랜치('${ORIGIN_BRANCH}')로 복귀 중..."
      git switch "$ORIGIN_BRANCH" >/dev/null 2>&1 || git checkout "$ORIGIN_BRANCH" >/dev/null 2>&1 || true
    fi
  fi
  exit "$exit_code"
}

trap cleanup EXIT

##
# 커맨드라인 인자를 파싱하고 유효성을 검증합니다.
#
# @param $@ {array} 커맨드라인 파라미터 배열
#
# @return 전역 변수 설정
##
parse_arguments() {
  while (( $# > 0 )); do
    case "$1" in
      --help)
        help "" "$LINENO"
        exit 0
        ;;
      -*)
        help "단축 옵션('$1')은 지원하지 않습니다. 정규 롱 옵션(Full Option)을 사용하십시오." "$LINENO"
        exit 1
        ;;
      *)
        if [[ -z "$TARGET_BRANCH" ]]; then
          TARGET_BRANCH="$1"
          shift 1
        else
          help "알 수 없거나 중복된 인자입니다: '$1'" "$LINENO"
          exit 1
        fi
        ;;
    esac
  done
}

##
# 현재 작업 디렉토리의 Git 저장소 유효성 및 브랜치 상태를 사전 점검합니다.
#
# @param 없음
#
# @return 0 성공, 실패 시 help() 호출 후 종료
##
preflight_check() {
  # 0. Git 저장소 여부 확인 (Git 저장소가 아닌 디렉토리에서는 실행 불가)
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    help "현재 디렉토리(또는 상위 디렉토리)가 유효한 Git 저장소가 아닙니다. 'git-pull'은 Git 저장소 내에서만 동작할 수 있습니다." "$LINENO"
    exit 1
  fi

  # 1. 현재 체크아웃 브랜치 확인
  ORIGIN_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || git branch --show-current 2>/dev/null || echo "")
  if [[ -z "$ORIGIN_BRANCH" ]]; then
    help "현재 저장소의 HEAD 브랜치 정보를 확인할 수 없습니다 (Detached HEAD 상태이거나 비어있는 저장소)." "$LINENO"
    exit 1
  fi

  # 2. 파라미터가 없으면 현재 디렉토리 브랜치를 TARGET_BRANCH로 설정
  if [[ -z "$TARGET_BRANCH" ]]; then
    TARGET_BRANCH="$ORIGIN_BRANCH"
  fi

  # 3. 대상 브랜치가 현재 브랜치와 다른 경우: 미커밋 변경사항 확인 및 브랜치 존재성 검사
  if [[ "$ORIGIN_BRANCH" != "$TARGET_BRANCH" ]]; then
    if ! git diff-index --quiet HEAD -- 2>/dev/null || [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
      help "커밋되지 않은 로컬 변경사항(수정/추가된 파일)이 존재합니다. 브랜치 전환 시 충돌 및 작업 손실을 방지하기 위해 'git stash' 또는 커밋 후 다시 실행하십시오." "$LINENO"
      exit 1
    fi

    # 로컬 브랜치 또는 원격 브랜치 존재 여부 확인
    local branch_exists=0
    if git rev-parse --verify "refs/heads/${TARGET_BRANCH}" >/dev/null 2>&1; then
      branch_exists=1
    elif git rev-parse --verify "refs/remotes/origin/${TARGET_BRANCH}" >/dev/null 2>&1 || git branch -r 2>/dev/null | grep -Eq "^[[:space:]]*[^/]+/${TARGET_BRANCH}$"; then
      branch_exists=1
    fi

    if (( branch_exists == 0 )); then
      help "지정한 브랜치('${TARGET_BRANCH}')가 로컬 및 원격 저장소에 존재하지 않습니다." "$LINENO"
      exit 1
    fi
  fi
}

##
# 브랜치 pull 작업을 실행합니다.
#
# @param 없음
#
# @return 0 성공
##
execute_pull() {
  echo "================================================================================"
  if [[ "$ORIGIN_BRANCH" == "$TARGET_BRANCH" ]]; then
    echo "🔄 [Git Pull] 현재 브랜치('${ORIGIN_BRANCH}')의 최신 변경사항을 가져옵니다..."
    echo "================================================================================"
    git pull
  else
    echo "🔄 [Git Pull] 대상 브랜치('${TARGET_BRANCH}') 동기화 및 복귀 파이프라인 시작"
    echo "   - 원래 작업 브랜치 : ${ORIGIN_BRANCH}"
    echo "   - 동기화 대상 브랜치: ${TARGET_BRANCH}"
    echo "================================================================================"

    # 1. 대상 브랜치로 전환
    echo "🔀 [1/3] 대상 브랜치('${TARGET_BRANCH}')(으)로 전환 중 (git switch ${TARGET_BRANCH})..."
    git switch "${TARGET_BRANCH}"

    # 2. git pull 수행
    echo "📥 [2/3] '${TARGET_BRANCH}' 브랜치 최신화 중 (git pull)..."
    git pull

    # 3. 원래 브랜치로 복귀
    echo "↩️  [3/3] 원래 작업 브랜치('${ORIGIN_BRANCH}')로 복귀 중 (git switch ${ORIGIN_BRANCH})..."
    git switch "${ORIGIN_BRANCH}"
  fi

  echo "================================================================================"
  echo "🎉 [완료] '${TARGET_BRANCH}' 브랜치의 git pull 작업이 성공적으로 완료되었습니다."
  echo "================================================================================"
}

main() {
  parse_arguments "$@"
  preflight_check
  execute_pull
}

main "$@"
