# @since    : 2026-07-28
# @desc     : support RHEL 8+, Oracle Linux 9+, Ubuntu 20.04+, RockyOS 9+, CentOS 7+
# @installation : 
#   1. insert 'source <path>/git-branch-migration.sh.completion" into ~/bin/.bashrc or ~/bin/.bash_profile for a personal usage.
#   2. copy the above file to /etc/bash_completion.d/ or insert 'source <path>/git-branch-migration.sh.completion' into /etc/bashrc for all users.
# =======================================
# Global Reserved Variables
# 1. COMP_WORDS: an array, contains all arguments
# 2. COMP_CWORD: a index of a cursor
# 3. COMP_LINE: all command string
# 4. COMPREPLY: an array, contains suggested words. words are sorted and unique.
#
# Arguments of a function
# 1. $1: command
# 2. $2: current
# 3. $3: previous
#
# e.g.: mycmd arg1 arg2 arg3 arg4[tab]
# - $1: mycmd
# - $2: arg4
# - $3: arg3
# =======================================

##
# git-branch-migration.sh 스크립트의 자동완성(Auto-completion)을 지원하는 함수입니다.
# Auto-completion function for git-branch-migration.sh script.
##
_git_branch_migration_completion() {
  local cur prev opts
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  # 스크립트 기본 지원 옵션들 (Default options)
  opts="-h --help -s --source-branch -n --new-branch --delete-source --delete-branch --dry-run"

  # 이미 입력한 옵션은 다시 제안하지 않음 (반복 불가능 옵션 제외 처리)
  # Remove already typed non-repeatable options
  for word in "${COMP_WORDS[@]}"; do
    opts=$(echo "$opts" | sed "s/\b$word\b//g")
  done

  # '-' 또는 '--'를 입력하지 않고 <TAB> 만 입력해도 파라미터가 추천되도록 처리
  # Recommend options and directories even if <TAB> is pressed without '-' or '--'
  if [[ ${cur} == * ]] ; then
    COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
    # 작업 디렉토리를 탐색하므로 bash 내장 디렉토리 자동완성 폴백(Fallback) 추가
    # Add built-in directory completion fallback
    COMPREPLY+=($(compgen -d -- "${cur}"))
    return 0
  fi
}

# 스크립트 파일명과 자동완성 함수 연결
complete -F _git_branch_migration_completion git-branch-migration.sh
