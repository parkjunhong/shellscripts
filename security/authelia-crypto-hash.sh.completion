# @license : Apache License 2.0
# @since : 2026-09-03
# @desc : support Ubuntu 18.04 or higher, RHEL 7 or higher, Oracle Linux 7 or higher, RockyOS 8 or higher, CentOS 7 or higher
# @installation : 
# 1. insert 'source <path>/authelia-crypto-hash.sh.completion" into ~/bin/.bashrc or ~/bin/.bash_profile for a personal usage.
# 2. copy the above file to /etc/bash_completion.d/ or insert 'source <path>/authelia-crypto-hash.sh.completion' into /etc/bashrc for all users.
# =======================================
# Global Reserved Variables
# 1. COMP_WORDS: an array, contains all arguments
# 2. COMP_CWORD: a index of a cursor
# 3. COMP_LINE: all command string
# 4. COMPREPLY: an array, contains suggested words. words are sorted and unique.
#
# Arguments of a function
# 1. $1: command
# 2. $2: current
# 3. $3: previous
#
# e.g.: mycmd arg1 arg2 arg3 arg4[tab]
# - $1: mycmd
# - $2: arg4
# - $3: arg3
# =======================================

##
# authelia-crypto-hash.sh 스크립트의 자동완성(Auto-completion)을 지원하는 함수입니다.
# Auto-completion function for authelia-crypto-hash.sh script.
##
_authelia_crypto_hash_completion() {
  local cur prev opts available_opts opt is_used word
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  # 스크립트 지원 Long 옵션 목록 (단축 옵션 및 비밀번호 옵션 제외)
  # Command long options list (short options and password options excluded)
  opts="--image --algorithm --help"

  # 이전 파라미터 컨텍스트에 따른 동적 자동완성 제어
  # Dynamic completion based on previous parameter context
  case "${prev}" in
    --algorithm)
      # 지원 알고리즘 목록 제안 / Suggest supported hash algorithms
      local algos="argon2 bcrypt pbkdf2 scrypt sha2crypt"
      COMPREPLY=( $(compgen -W "${algos}" -- "${cur}") )
      return 0
      ;;
    --image)
      # 로컬 Docker 이미지 목록 제안 / Suggest local Docker images
      if command -v docker >/dev/null 2>&1; then
        local img_list=""
        img_list=$(docker images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -v '<none>' || true)
        if [ -n "$img_list" ]; then
          COMPREPLY=( $(compgen -W "${img_list}" -- "${cur}") )
          return 0
        fi
      fi
      COMPREPLY=( $(compgen -W "authelia/authelia:latest" -- "${cur}") )
      return 0
      ;;
    *)
      ;;
  esac

  # 이미 입력된 옵션을 필터링하여 중복 추천 방지
  # Filter out already entered options to prevent duplicates
  available_opts=""
  for opt in $opts; do
    is_used=0
    for word in "${COMP_WORDS[@]}"; do
      if [[ "$word" == "$opt" ]]; then
        is_used=1
        break
      fi
    done
    if [[ $is_used -eq 0 ]]; then
      available_opts="$available_opts $opt"
    fi
  done

  # 커서에 '-' 또는 '--' 입력 여부와 무관하게 TAB 입력 시 옵션 즉시 추천
  # Suggest available options immediately on TAB even if '-' or '--' is not yet typed
  COMPREPLY=( $(compgen -W "${available_opts}" -- "${cur}") )
}

# 스크립트 파일명과 자동완성 함수 연결 / Bind completion function to the script
complete -F _authelia_crypto_hash_completion authelia-crypto-hash.sh
