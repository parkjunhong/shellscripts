  [[ "$VERBOSE" == "true" ]] && echo "DEBUG [pdns_recursor]: $raw_out" >&2

  local regex1='PowerDNS[[:space:]]+Recursor[[:space:]]+([0-9]+\.[0-9]+[^[:space:],\)]*)'
  local regex2='pdns_recursor[[:space:]]+([0-9]+\.[0-9]+[^[:space:],\)]*)'

  if [[ "$raw_out" =~ $regex1 ]]; then
    echo "${BASH_REMATCH[1]}"
  elif [[ "$raw_out" =~ $regex2 ]]; then
    echo "${BASH_REMATCH[1]}"
  else
    local first_line
    first_line=$(echo "$raw_out" | grep -i "PowerDNS" | head -n 1 || echo "")
    if [[ -n "$first_line" ]]; then
      echo "$first_line"
