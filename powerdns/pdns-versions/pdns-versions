##
# PowerDNS-Admin 버전 추출
##
get_admin_version() {
  local c_name="$1"
  local c_image="$2"

  # 1. 컨테이너 내부 환경변수 확인
  local env_ver
  env_ver=$(docker exec "$c_name" env 2>/dev/null | grep -iE '^(PDA_VERSION|POWERDNS_ADMIN_VERSION|VERSION)=' | head -n 1 | cut -d= -f2- || true)
  if [[ -n "$env_ver" ]]; then
    echo "$env_ver"
    return 0
  fi

  # 2. 컨테이너 내부 파일에서 버전 문자열 검색 (안전한 변수 기반 정규식 매칭)
  local file_ver
  file_ver=$(docker exec "$c_name" sh -c 'grep -rnE "__version__|VERSION" /app/powerdnsadmin/ 2>/dev/null | head -n 1' 2>/dev/null || true)
  local ver_regex='([vV]?[0-9]+\.[0-9]+[0-9a-zA-Z._-]*)'
  if [[ -n "$file_ver" && "$file_ver" =~ $ver_regex ]]; then
    echo "${BASH_REMATCH[1]}"
    return 0
  fi

  # 3. 이미지 태그 파싱 (예: powerdnsadmin/pda-legacy:v2026.08.1 -> v2026.08.1)
  local tag_regex=':([^:]+)$'
  if [[ "$c_image" =~ $tag_regex ]]; then
    local tag="${BASH_REMATCH[1]}"
    if [[ "$tag" != "latest" ]]; then
      echo "$tag (Image Tag)"
      return 0
    fi
  fi

  echo "버전 정보 없음 (latest)"
}

##
# MariaDB 버전 추출
##
get_mariadb_version() {
  local c_name="$1"
  local raw_out=""

  # mariadbd -> mariadb -> mysqld 순차 시도
  if docker exec "$c_name" command -v mariadbd >/dev/null 2>&1; then
    raw_out=$(docker exec "$c_name" mariadbd --version 2>&1 || true)
  elif docker exec "$c_name" command -v mariadb >/dev/null 2>&1; then
    raw_out=$(docker exec "$c_name" mariadb --version 2>&1 || true)
  elif docker exec "$c_name" command -v mysqld >/dev/null 2>&1; then
    raw_out=$(docker exec "$c_name" mysqld --version 2>&1 || true)
  fi
  [[ "$VERBOSE" == "true" ]] && echo "DEBUG [mariadb]: $raw_out" >&2

  local regex1='(mariadbd|mariadb|mysqld)[[:space:]]+Ver[[:space:]]+([0-9]+\.[0-9]+[^[:space:],]*)'
  local regex2='Distrib[[:space:]]+([0-9]+\.[0-9]+[^[:space:],]*)'

  if [[ "$raw_out" =~ $regex1 ]]; then
    echo "${BASH_REMATCH[2]}"
  elif [[ "$raw_out" =~ $regex2 ]]; then
    echo "${BASH_REMATCH[1]}"
  else
    local first_line
    first_line=$(echo "$raw_out" | head -n 1 || echo "")
    if [[ -n "$first_line" ]]; then
      echo "$first_line"
    else
      echo "확인 불가 (실행 오류)"
    fi
  fi
}

main() {
  parse_arguments "$@"
  check_docker

  # 검사 대상 구성요소 정의: 컴포넌트 표시명 | 기본 컨테이너명 | 이미지 키워드 | 버전 추출 함수
  local -a targets=(
    "PowerDNS Auth|${CONTAINER_AUTH}|pdns-auth|get_auth_version"
    "PowerDNS Recursor|${CONTAINER_RECURSOR}|pdns-recursor|get_recursor_version"
    "PowerDNS dnsdist|${CONTAINER_DNSDIST}|dnsdist|get_dnsdist_version"
    "PowerDNS-Admin|${CONTAINER_ADMIN}|pda-legacy|get_admin_version"
    "MariaDB|${CONTAINER_MARIADB}|mariadb|get_mariadb_version"
  )

  local -a res_components=()
  local -a res_statuses=()
  local -a res_cnames=()
  local -a res_versions=()
  local -a res_images=()

  for item in "${targets[@]}"; do
    IFS='|' read -r comp_name def_name img_keyword ver_func <<< "$item"

    local c_info
    c_info=$(inspect_container "$def_name" "$img_keyword")
    IFS='|' read -r status c_name c_image <<< "$c_info"

    local ver_str="-"
    local status_display=""

    case "$status" in
      RUNNING)
        status_display="실행 중"
        if [[ "$ver_func" == "get_admin_version" ]]; then
          ver_str=$($ver_func "$c_name" "$c_image")
        else
          ver_str=$($ver_func "$c_name")
        fi
        ;;
      STOPPED)
        status_display="정지 중"
        ver_str="(컨테이너 정지 - 버전 확인 불가)"
        ;;
      NOT_INSTALLED)
        status_display="미설치"
        c_name="-"
        c_image="-"
        ver_str="컨테이너를 찾을 수 없음 (미설치)"
        ;;
      *)
        status_display="상태 불명"
        ver_str="확인 불가"
        ;;
    esac

    res_components+=("$comp_name")
    res_statuses+=("$status_display")
    res_cnames+=("$c_name")
    res_versions+=("$ver_str")
    res_images+=("$c_image")
  done

  # JSON 출력 모드 (-j, --json)
  if [[ "$OUTPUT_JSON" == "true" ]]; then
    echo "{"
    echo "  \"timestamp\": \"$(date -Iseconds)\","
    echo '  "components": ['
    local count=${#res_components[@]}
    for (( i=0; i<count; i++ )); do
      local comma=","
      (( i == count - 1 )) && comma=""
      echo "    {"
      echo "      \"name\": \"${res_components[i]}\","
      echo "      \"status\": \"${res_statuses[i]}\","
      echo "      \"container\": \"${res_cnames[i]}\","
      echo "      \"version\": \"${res_versions[i]}\","
      echo "      \"image\": \"${res_images[i]}\""
      echo "    }${comma}"
    done
    echo "  ]"
    echo "}"
    return 0
  fi

  # 일반 터미널 테이블 출력 모드 (column -t 활용)
  echo "$SEPARATOR_LINE"
  echo -e "${CLR_BOLD}🚀 PowerDNS 스택 컴포넌트 버전 점검 결과${CLR_RESET}"
  echo "$SEPARATOR_LINE"

  (
    echo "컴포넌트|상태|컨테이너명|실행 버전|이미지 정보"
    local count=${#res_components[@]}
    for (( i=0; i<count; i++ )); do
      local comp="${res_components[i]}"
      local st="${res_statuses[i]}"
      local cname="${res_cnames[i]}"
      local ver="${res_versions[i]}"
      local img="${res_images[i]}"

      # 이모지와 텍스트 사이에 명확한 빈칸(공백 2칸) 추가 및 상태별 어울리는 이모지 적용
      local st_tag="[${st}]"
      case "$st" in
        "실행 중")
          st_tag="[🟢  실행 중]"
          ;;
        "정지 중")
          st_tag="[🔴  정지 중]"
          ;;
        "미설치")
          st_tag="[❌  미설치]"
          ;;
      esac

      echo "${comp}|${st_tag}|${cname}|${ver}|${img}"
    done
  ) | column -t -s "|"

  echo "$SEPARATOR_LINE"

  # 미설치 또는 정지된 컴포넌트가 있을 경우 경고/안내 출력
  local has_warning=false
  for (( i=0; i<${#res_statuses[@]}; i++ )); do
    if [[ "${res_statuses[i]}" != "실행 중" ]]; then
      has_warning=true
      break
    fi
  done

  if [[ "$has_warning" == "true" ]]; then
    echo -e "${CLR_YELLOW}💡 [상태 알림]:${CLR_RESET}"
    for (( i=0; i<${#res_statuses[@]}; i++ )); do
      if [[ "${res_statuses[i]}" == "정지 중" ]]; then
        echo -e "   - ${CLR_YELLOW}[🔴  정지 중]${CLR_RESET} '${res_components[i]}' 컨테이너가 정지 상태입니다. (시작 명령: ${CLR_CYAN}docker start ${res_cnames[i]}${CLR_RESET})"
      elif [[ "${res_statuses[i]}" == "미설치" ]]; then
        echo -e "   - ${CLR_RED}[❌  미설치]${CLR_RESET} '${res_components[i]}' 관련 컨테이너를 찾을 수 없습니다. (배포 필요 또는 컨테이너 이름 확인 필요)"
      fi
    done
    echo "$SEPARATOR_LINE"
  fi
}

main "$@"
