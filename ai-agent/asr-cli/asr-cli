  else
    # skill -> rule 순서로 출력
    print_list_by_kind "skill" "$agent_home" "$agent" "" ""
    print_list_by_kind "rule" "$agent_home" "$agent" "" ""
  fi
}

##
# 등록된 스킬(Skill) 및 규칙(Rule) 목록을 tree 스타일로 조회합니다.
# - '--agent'가 지정되지 않은 경우: 존재하는 모든 에이전트(antigravity, claude, codex)의 정보를 출력합니다.
# - '--agent'가 지정된 경우: 해당 에이전트의 정보만 출력합니다.
#
# @param $1 {string} 상위에서 전달된 에이전트 이름 (선택, 빈 값이면 전체 에이전트 조회)
# @param ${@:2} {array} list 서브커맨드 인자 목록
#
# @return 0 (성공 시)
##
cmd_list() {
  local agent="${1:-}"
  shift || true

  local target="all"
  local target_set="false"
  local category=""
  local name=""
  local cli_home=""

  while (( $# > 0 )); do
    case "$1" in
      --help)
        help "" "" "list"
        return 0
        ;;
      --agent)
        [[ $# -ge 2 ]] || die "'--agent' 옵션에 값이 필요합니다. (antigravity | agy | codex | claude)" "$LINENO" "list"
        agent="$2"
        shift 2
        ;;
      --agent=*)
        agent="${1#--agent=}"
        shift
        ;;
      skill|rule)
        if [[ "$target_set" == "false" ]]; then
          target="$1"
          target_set="true"
          shift
        else
          die "대상(skill|rule)이 중복 지정되었습니다: $1" "$LINENO" "list"
        fi
        ;;
      --category)
        [[ $# -ge 2 ]] || die "'--category' 옵션에 값이 필요합니다." "$LINENO" "list"
        category="$2"
        shift 2
        ;;
      --category=*)
        category="${1#--category=}"
        shift
        ;;
      --name)
        [[ $# -ge 2 ]] || die "'--name' 옵션에 값이 필요합니다." "$LINENO" "list"
        name="$2"
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        shift
        ;;
      --home)
        [[ $# -ge 2 ]] || die "'--home' 옵션에 경로가 필요합니다." "$LINENO" "list"
        cli_home="$2"
        shift 2
        ;;
      --home=*)
        cli_home="${1#--home=}"
        shift
        ;;
      -*)
        die "알 수 없는 옵션입니다: $1 (Long Option만 지원합니다)" "$LINENO" "list"
        ;;
      *)
        die "알 수 없는 인자입니다: $1" "$LINENO" "list"
        ;;
    esac
  done

  if [[ -n "$name" && -z "$category" ]]; then
    die "'--name' 옵션을 사용할 때는 '--category' 옵션을 함께 지정해야 합니다." "$LINENO" "list"
  fi
  if [[ "$target" == "all" && ( -n "$category" || -n "$name" ) ]]; then
    die "'--category' 또는 '--name' 필터를 사용할 때는 조회 대상('skill' 또는 'rule')을 지정해야 합니다." "$LINENO" "list"
  fi

  local -a parsed_cats=()
  if [[ -n "$category" ]]; then
    local cat_norm_mode="skill-cat"
    [[ "$target" == "rule" ]] && cat_norm_mode="rule-cat"

    local c_line
    while IFS= read -r c_line; do
      [[ -n "$c_line" ]] && parsed_cats+=("$c_line")
    done < <(split_csv_unique "$category" "category" "list" "$cat_norm_mode")

    if (( ${#parsed_cats[@]} > 1 )) && [[ -n "$name" ]]; then
      die "'--category'에 여러 카테고리를 지정한 경우 '--name' 옵션을 함께 사용할 수 없습니다." "$LINENO" "list"
    fi
  fi

  local asr_home
  asr_home="$(resolve_asr_home "$cli_home" "list")"

  printf "🏠 AI_AGENT_CUSTOMIZATION_HOME: %s\n" "$asr_home"
  printf "%s\n" "------------------------------------------------------------"

  # 1) '--agent'가 명시적으로 지정된 경우: 해당 에이전트만 조회
  if [[ -n "$agent" ]]; then
    agent="$(normalize_agent_name "$agent" "list")"
    print_list_for_single_agent "$agent" "$asr_home" "$target" "$category" "$name"
    return 0
  fi

  # 2) '--agent'가 생략된 경우: 존재하는 모든 에이전트(antigravity, claude, codex) 조회
  local -a existing_agents=()
  local ag
  for ag in "${SUPPORTED_AGENTS[@]}"; do
    if [[ -d "${asr_home}/${ag}" ]]; then
      existing_agents+=("$ag")
    fi
  done

  if (( ${#existing_agents[@]} == 0 )); then
    printf "(등록된 에이전트 데이터 없음)\n"
    return 0
  fi

  # '--category' 필터가 지정된 경우: 존재하는 에이전트 중 해당 카테고리를 보유한 에이전트에 대해 출력
  if [[ -n "$category" ]]; then
    local matched_any="false"
    local req_cat phys_cat cat_root
    for ag in "${existing_agents[@]}"; do
      local -a ag_matched_cats=()
      for req_cat in "${parsed_cats[@]}"; do
        phys_cat="$(resolve_existing_category_dir_name "${asr_home}/${ag}" "$target" "$req_cat")"
        if [[ "$target" == "skill" ]]; then
          cat_root="${asr_home}/${ag}/skills/${phys_cat}"
        else
          cat_root="${asr_home}/${ag}/rules/${phys_cat}"
        fi
        if [[ -d "$cat_root" ]]; then
          ag_matched_cats+=("$req_cat")
        fi
      done

      if (( ${#ag_matched_cats[@]} > 0 )); then
        matched_any="true"
        local IFS=','
        local ag_cat_csv="${ag_matched_cats[*]}"
        unset IFS
        print_list_for_single_agent "$ag" "$asr_home" "$target" "$ag_cat_csv" "$name"
      fi
    done

    if [[ "$matched_any" == "false" ]]; then
      die "존재하는 모든 에이전트(${existing_agents[*]})에서 요청한 카테고리('${category}')를 찾을 수 없습니다." "$LINENO" "list"
    fi
    return 0
  fi

  for ag in "${existing_agents[@]}"; do
    print_list_for_single_agent "$ag" "$asr_home" "$target" "" ""
  done
}

##
# 시스템에 'vim' 편집기가 설치되어 있는지 확인하고, 미설치 시 OS 패키지 매니저를 통해 자동 설치합니다.
# Linux(apt-get, dnf, yum, zypper, pacman, apk) 및 macOS(brew) 환경을 모두 지원합니다.
#
# @return 0 (설치 확인 또는 설치 완료 시), 실패 시 die 호출
##
ensure_vim_installed() {
  if command -v vim >/dev/null 2>&1; then
    return 0
  fi

  echo "📦 시스템에 'vim' 편집기가 설치되어 있지 않습니다. 자동으로 설치를 진행합니다..."

  if command -v brew >/dev/null 2>&1; then
    brew install vim
  else
    local -a sudo_cmd=()
    if (( EUID != 0 )); then
      if command -v sudo >/dev/null 2>&1; then
        sudo_cmd=("sudo")
      else
        die "'vim'을 설치하려면 root 권한 또는 'sudo'가 필요합니다." "$LINENO" "edit"
      fi
    fi

    if command -v apt-get >/dev/null 2>&1; then
      "${sudo_cmd[@]}" apt-get update -y && "${sudo_cmd[@]}" apt-get install -y vim
    elif command -v dnf >/dev/null 2>&1; then
      "${sudo_cmd[@]}" dnf install -y vim-enhanced || "${sudo_cmd[@]}" dnf install -y vim
    elif command -v yum >/dev/null 2>&1; then
      "${sudo_cmd[@]}" yum install -y vim-enhanced || "${sudo_cmd[@]}" yum install -y vim
    elif command -v zypper >/dev/null 2>&1; then
      "${sudo_cmd[@]}" zypper --non-interactive install vim
    elif command -v pacman >/dev/null 2>&1; then
      "${sudo_cmd[@]}" pacman -Sy --noconfirm vim
    elif command -v apk >/dev/null 2>&1; then
      "${sudo_cmd[@]}" apk add vim
    else
      die "지원하는 패키지 매니저(brew, apt-get, dnf, yum, zypper, pacman, apk)를 찾을 수 없어 'vim'을 자동 설치할 수 없습니다." "$LINENO" "edit"
    fi
  fi

  if ! command -v vim >/dev/null 2>&1; then
    die "'vim' 설치에 실패했습니다. 수동으로 'vim'을 설치한 후 다시 시도해 주세요." "$LINENO" "edit"
  fi

  echo "✅ 'vim' 설치가 완료되었습니다."
}

##
# 대상 파일 경로가 심볼릭 링크인 경우 실제 원본 파일의 절대 경로(Canonical Path)를 반환합니다.
# 심볼릭 링크 편집 시 링크가 해제되거나 깨지는 현상을 방지합니다.
#
# @param $1 {string} 파일 또는 디렉토리 경로
#
# @return 정규화된 실제 원본 파일 경로 출력
##
resolve_canonical_path() {
  local target="$1"
  if [[ -L "$target" ]]; then
    if command -v realpath >/dev/null 2>&1; then
      realpath "$target" 2>/dev/null || readlink -f "$target" 2>/dev/null || printf "%s\n" "$target"
    elif command -v readlink >/dev/null 2>&1; then
      readlink -f "$target" 2>/dev/null || printf "%s\n" "$target"
    else
      printf "%s\n" "$target"
    fi
  else
    printf "%s\n" "$target"
  fi
}

##
# 에이전트 내의 모든 스킬 카테고리를 탐색하여 대상 스킬(폴더명 또는 SKILL.md name 속성)에 해당하는 SKILL.md 경로를 반환합니다.
# 하나의 에이전트 내에서는 스킬 이름이 고유하므로 카테고리 지정 없이 검색이 가능합니다.
#
# @param $1 {string} 에이전트 루트 디렉토리 (agent_home)
# @param $2 {string} 정규화된 에이전트 이름 (agent)
# @param $3 {string} 대상 스킬 식별자 (target_name)
#
# @return 찾은 SKILL.md 파일 경로 출력 (못 찾을 시 1 반환)
##
find_skill_file_in_agent() {
  local agent_home="$1"
  local agent="$2"
  local target_name="$3"

  # 직접 유효한 파일 경로가 전달된 경우
  if [[ -f "$target_name" ]]; then
    printf "%s\n" "$target_name"
    return 0
  fi

  local skills_root="${agent_home}/skills"
  [[ -d "$skills_root" ]] || return 1

  local skills_subpath
  skills_subpath="$(get_skills_subpath "$agent")"

  local cat_dir entry skill_dir skill_md fm_name
  for cat_dir in "${skills_root}"/*; do
    [[ -d "$cat_dir" && -d "${cat_dir}/${skills_subpath}" ]] || continue

    # 1) 스킬 디렉토리명 일치
    skill_dir="${cat_dir}/${skills_subpath}/${target_name}"
    if [[ -d "$skill_dir" || -L "$skill_dir" ]]; then
      if [[ -f "${skill_dir}/SKILL.md" ]]; then
        printf "%s\n" "${skill_dir}/SKILL.md"
        return 0
      elif [[ -f "${skill_dir}/SKILL.MD" ]]; then
        printf "%s\n" "${skill_dir}/SKILL.MD"
        return 0
      fi
    fi

    # 2) SKILL.md 내 name 속성 매칭
    for entry in "${cat_dir}/${skills_subpath}"/*; do
      [[ -d "$entry" || -L "$entry" ]] || continue
      skill_md=""
      if [[ -f "${entry}/SKILL.md" ]]; then
        skill_md="${entry}/SKILL.md"
      elif [[ -f "${entry}/SKILL.MD" ]]; then
        skill_md="${entry}/SKILL.MD"
      fi

      if [[ -n "$skill_md" ]]; then
        fm_name="$(awk '
          NR == 1 && $0 == "---" { in_fm = 1; next }
          in_fm && $0 == "---" { exit }
          in_fm && $0 ~ /^[[:space:]]*name:[[:space:]]*/ {
            sub(/^[[:space:]]*name:[[:space:]]*/, "", $0)
            sub(/[[:space:]]*$/, "", $0)
            gsub(/^["'\''"]|["'\''"]$/, "", $0)
            print $0
            exit
          }
        ' "$skill_md" 2>/dev/null || true)"

        if [[ -n "$fm_name" && "$fm_name" == "$target_name" ]]; then
          printf "%s\n" "$skill_md"
          return 0
        fi
      fi
    done
  done

  return 1
}

##
# 에이전트 내의 모든 규칙 카테고리를 탐색하여 대상 규칙에 해당하는 마크다운 파일 경로를 반환합니다.
#
# @param $1 {string} 에이전트 루트 디렉토리 (agent_home)
# @param $2 {string} 정규화된 에이전트 이름 (agent)
# @param $3 {string} 대상 규칙 식별자 (target_name)
#
# @return 찾은 규칙 파일 경로 출력 (못 찾을 시 1 반환)
##
find_rule_file_in_agent() {
  local agent_home="$1"
  local agent="$2"
  local target_name="$3"

  # 직접 유효한 파일 경로가 전달된 경우
  if [[ -f "$target_name" ]]; then
    printf "%s\n" "$target_name"
    return 0
  fi

  local rule_clean
  rule_clean="$(normalize_rule_name "$target_name")"

  local rules_root="${agent_home}/rules"
  [[ -d "$rules_root" ]] || return 1

  local cat_dir rule_file
  if [[ "$agent" == "codex" ]]; then
    for cat_dir in "${rules_root}"/*; do
      [[ -d "$cat_dir" ]] || continue
      rule_file="${cat_dir}/${rule_clean}/AGENTS.md"
      if [[ -f "$rule_file" ]]; then
        printf "%s\n" "$rule_file"
        return 0
      elif [[ -f "${cat_dir}/${rule_clean}/AGENTS.MD" ]]; then
        printf "%s\n" "${cat_dir}/${rule_clean}/AGENTS.MD"
        return 0
      fi
    done
  else
    local rules_subpath
    rules_subpath="$(get_rules_subpath "$agent")"
    for cat_dir in "${rules_root}"/*; do
      [[ -d "$cat_dir" && -d "${cat_dir}/${rules_subpath}" ]] || continue
      rule_file="${cat_dir}/${rules_subpath}/${rule_clean}.md"
      if [[ -f "$rule_file" ]]; then
        printf "%s\n" "$rule_file"
        return 0
      elif [[ -f "${cat_dir}/${rules_subpath}/${rule_clean}.MD" ]]; then
        printf "%s\n" "${cat_dir}/${rules_subpath}/${rule_clean}.MD"
        return 0
      fi
    done
  fi

  return 1
}

##
# 지정된 카테고리의 스킬(SKILL.md) 또는 규칙(<NAME>.md / AGENTS.md) 파일을 'vim'으로 편집합니다.
# '--file <스킬명|규칙명>' 옵션을 통해 카테고리 지정 없이 대상을 직접 지정할 수 있습니다.
#
# @param $1 {string} 상위에서 전달된 에이전트 이름 (선택, 빈 값이면 기본값 antigravity 적용)
# @param ${@:2} {array} edit 서브커맨드 인자 목록
#
# @return 0 (성공 시)
##
cmd_edit() {
  local agent="${1:-}"
  shift || true

  local target=""
  local file=""
  local category=""
  local name=""
  local cli_home=""

  while (( $# > 0 )); do
    case "$1" in
      --help)
        help "" "" "edit"
        return 0
        ;;
      --agent)
        [[ $# -ge 2 ]] || die "'--agent' 옵션에 값이 필요합니다. (antigravity | agy | codex | claude)" "$LINENO" "edit"
        agent="$2"
        shift 2
        ;;
      --agent=*)
        agent="${1#--agent=}"
        shift
        ;;
      skill|rule)
        if [[ -z "$target" ]]; then
          target="$1"
          shift
        else
          die "대상(skill|rule)이 중복 지정되었습니다: $1" "$LINENO" "edit"
        fi
        ;;
      --file)
        [[ $# -ge 2 ]] || die "'--file' 옵션에 값이 필요합니다." "$LINENO" "edit"
        file="$2"
        shift 2
        ;;
      --file=*)
        file="${1#--file=}"
        shift
        ;;
      --category)
        [[ $# -ge 2 ]] || die "'--category' 옵션에 값이 필요합니다." "$LINENO" "edit"
        category="$2"
        shift 2
        ;;
      --category=*)
        category="${1#--category=}"
        shift
        ;;
      --name)
        [[ $# -ge 2 ]] || die "'--name' 옵션에 값이 필요합니다." "$LINENO" "edit"
        name="$2"
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        shift
        ;;
      --home)
        [[ $# -ge 2 ]] || die "'--home' 옵션에 경로가 필요합니다." "$LINENO" "edit"
        cli_home="$2"
        shift 2
        ;;
      --home=*)
        cli_home="${1#--home=}"
        shift
        ;;
      -*)
        die "알 수 없는 옵션입니다: $1 (Long Option만 지원합니다)" "$LINENO" "edit"
        ;;
      *)
        die "알 수 없는 인자입니다: $1" "$LINENO" "edit"
        ;;
    esac
  done

  agent="$(normalize_agent_name "$agent" "edit")"
  [[ -n "$target" ]] || die "편집할 대상('skill' 또는 'rule')을 지정해야 합니다." "$LINENO" "edit"

  if [[ -n "$file" && ( -n "$category" || -n "$name" ) ]]; then
    die "'edit' 명령어에서는 '--file' 옵션과 '--category'/'--name' 옵션을 함께 사용할 수 없습니다. 둘 중 하나만 지정해 주세요." "$LINENO" "edit"
  fi

  local agent_home
  agent_home="$(resolve_agent_home "$cli_home" "$agent" "edit")"

  local target_file=""

  # 1. '--file' 옵션이 지정된 경우 (카테고리 지정 없이 직접 탐색)
  if [[ -n "$file" ]]; then
    if [[ "$target" == "skill" ]]; then
      target_file="$(find_skill_file_in_agent "$agent_home" "$agent" "$file" || true)"
      [[ -n "$target_file" ]] || die "[${agent}] 스킬 파일(SKILL.md)을 찾을 수 없습니다: '${file}'" "$LINENO" "edit"
    elif [[ "$target" == "rule" ]]; then
      target_file="$(find_rule_file_in_agent "$agent_home" "$agent" "$file" || true)"
      [[ -n "$target_file" ]] || die "[${agent}] 규칙 파일을 찾을 수 없습니다: '${file}'" "$LINENO" "edit"
    fi
  # 2. 기존 방식: '--category'와 '--name'으로 지정된 경우
  elif [[ -n "$category" && -n "$name" ]]; then
    category="$(normalize_category_name "$target" "$category")"
    validate_identifier "$category" "category" "edit"
    validate_identifier "$name" "name" "edit"

    local phys_cat
    phys_cat="$(resolve_existing_category_dir_name "$agent_home" "$target" "$category")"

    if [[ "$target" == "skill" ]]; then
      local skills_subpath
      skills_subpath="$(get_skills_subpath "$agent")"
      local skill_dir="${agent_home}/skills/${phys_cat}/${skills_subpath}/${name}"
      if [[ -f "${skill_dir}/SKILL.md" ]]; then
        target_file="${skill_dir}/SKILL.md"
      elif [[ -f "${skill_dir}/SKILL.MD" ]]; then
        target_file="${skill_dir}/SKILL.MD"
      else
        die "편집할 스킬 파일이 존재하지 않습니다: ${skill_dir}/SKILL.md" "$LINENO" "edit"
      fi
    elif [[ "$target" == "rule" ]]; then
      local rule_name
      rule_name="$(normalize_rule_name "$name")"
      validate_identifier "$rule_name" "name" "edit"

      if [[ "$agent" == "codex" ]]; then
        local rule_dir="${agent_home}/rules/${phys_cat}/${rule_name}"
        if [[ -f "${rule_dir}/AGENTS.md" ]]; then
          target_file="${rule_dir}/AGENTS.md"
        elif [[ -f "${rule_dir}/AGENTS.MD" ]]; then
          target_file="${rule_dir}/AGENTS.MD"
        else
          die "편집할 Codex 규칙 파일이 존재하지 않습니다: ${rule_dir}/AGENTS.md" "$LINENO" "edit"
        fi
      else
        local rules_subpath
        rules_subpath="$(get_rules_subpath "$agent")"
        local rules_dir="${agent_home}/rules/${phys_cat}/${rules_subpath}"
        if [[ -f "${rules_dir}/${rule_name}.md" ]]; then
          target_file="${rules_dir}/${rule_name}.md"
        elif [[ -f "${rules_dir}/${rule_name}.MD" ]]; then
          target_file="${rules_dir}/${rule_name}.MD"
        else
          die "편집할 규칙 파일이 존재하지 않습니다: ${rules_dir}/${rule_name}.md" "$LINENO" "edit"
        fi
      fi
    fi
  else
    die "편집할 대상을 지정해 주세요. ('--file <스킬명|규칙명>' 또는 '--category <카테고리> --name <이름>')" "$LINENO" "edit"
  fi

  target_file="$(resolve_canonical_path "$target_file")"
  ensure_vim_installed
  vim "$target_file"
}

##
# 메인 엔트리포인트 함수
# - 'asr-cli <command> ...'
# - 'asr-cli --agent <agent> <command> ...'
# - 'asr-cli --agent <agent>' (단독 실행 시 특정 에이전트의 skill/rule 목록 조회)
#
# @param $@ {array} 전체 커맨드라인 인자
#
# @return 종료 코드
##
main() {
  if (( $# == 0 )); then
    help "실행할 명령어(create | remove | add | edit | list)를 지정해 주세요." "$LINENO" "" >&2
    exit 1
  fi

  local global_agent=""
  local subcmd=""
  local -a pre_args=()

  while (( $# > 0 )); do
    case "$1" in
      --help)
        help "" "" ""
        return 0
        ;;
      --agent)
        [[ $# -ge 2 ]] || die "'--agent' 옵션에 값이 필요합니다. (antigravity | agy | codex | claude)" "$LINENO" ""
        global_agent="$(normalize_agent_name "$2" "")"
        shift 2
        ;;
      --agent=*)
        global_agent="$(normalize_agent_name "${1#--agent=}" "")"
        shift
        ;;
      --home)
        [[ $# -ge 2 ]] || die "'--home' 옵션에 경로가 필요합니다." "$LINENO" ""
        pre_args+=("--home" "$2")
        shift 2
        ;;
      --home=*)
        pre_args+=("$1")
        shift
        ;;
      create|remove|add|edit|list)
        subcmd="$1"
        shift
        break
        ;;
      -*)
        die "알 수 없는 옵션입니다: $1 (지원 전역 옵션: --agent, --home, --help)" "$LINENO" ""
        ;;
      *)
        die "지원하지 않는 명령어입니다: $1 (지원 명령어: create, remove, add, edit, list)" "$LINENO" ""
        ;;
    esac
  done

  # 'asr-cli --agent <agent>' 형태로 서브커맨드 없이 실행된 경우 해당 에이전트의 list 조회 수행
  if [[ -z "$subcmd" ]]; then
    if [[ -n "$global_agent" ]]; then
      cmd_list "$global_agent" "${pre_args[@]}" "$@"
      return 0
    fi
    help "실행할 명령어(create | remove | add | edit | list)를 지정해 주세요." "$LINENO" "" >&2
    exit 1
  fi

  case "$subcmd" in
    create)
      cmd_create "$global_agent" "${pre_args[@]}" "$@"
      ;;
    remove)
      cmd_remove "$global_agent" "${pre_args[@]}" "$@"
      ;;
    add)
      cmd_add "$global_agent" "${pre_args[@]}" "$@"
      ;;
    edit)
      cmd_edit "$global_agent" "${pre_args[@]}" "$@"
      ;;
    list)
      cmd_list "$global_agent" "${pre_args[@]}" "$@"
      ;;
  esac
}

main "$@"
