##
# 새로운 스킬(Skill) 또는 규칙(Rule)을 생성합니다.
# 실제 생성되는 카테고리 디렉토리명은 'skill-<category>' 또는 'rule-<category>'가 됩니다.
#
# @param $1 {string} 상위에서 전달된 에이전트 이름 (선택, 빈 값이면 기본값 antigravity 적용)
# @param ${@:2} {array} create 서브커맨드 인자 목록
#
# @return 0 (성공 시)
##
cmd_create() {
  local agent="${1:-}"
  shift || true

  local target=""
  local category=""
  local name=""
  local cli_home=""
  local force="false"

  while (( $# > 0 )); do
    case "$1" in
      --help)
        help "" "" "create"
        return 0
        ;;
      --agent)
        [[ $# -ge 2 ]] || die "'--agent' 옵션에 값이 필요합니다. (antigravity | agy | codex | claude)" "$LINENO" "create"
        agent="$2"
        shift 2
        ;;
      --agent=*)
        agent="${1#--agent=}"
        shift
        ;;
      skill|rule)
        if [[ -z "$target" ]]; then
          target="$1"
          shift
        else
          die "대상(skill|rule)이 중복 지정되었습니다: $1" "$LINENO" "create"
        fi
        ;;
      --category)
        [[ $# -ge 2 ]] || die "'--category' 옵션에 값이 필요합니다." "$LINENO" "create"
        category="$2"
        shift 2
        ;;
      --category=*)
        category="${1#--category=}"
        shift
        ;;
      --name)
        [[ $# -ge 2 ]] || die "'--name' 옵션에 값이 필요합니다." "$LINENO" "create"
        name="$2"
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        shift
        ;;
      --home)
        [[ $# -ge 2 ]] || die "'--home' 옵션에 경로가 필요합니다." "$LINENO" "create"
        cli_home="$2"
        shift 2
        ;;
      --home=*)
        cli_home="${1#--home=}"
        shift
        ;;
      --force)
        force="true"
        shift
        ;;
      -*)
        die "알 수 없는 옵션입니다: $1 (Long Option만 지원합니다)" "$LINENO" "create"
        ;;
      *)
        die "알 수 없는 인자입니다: $1" "$LINENO" "create"
        ;;
    esac
  done

  agent="$(normalize_agent_name "$agent" "create")"
  [[ -n "$target" ]] || die "생성할 대상('skill' 또는 'rule')을 지정해야 합니다." "$LINENO" "create"
  category="$(normalize_category_name "$target" "$category")"
  validate_identifier "$category" "category" "create"
  validate_identifier "$name" "name" "create"

  local phys_cat
  phys_cat="$(to_physical_category_dir_name "$target" "$category")"

  local agent_home
  agent_home="$(resolve_agent_home "$cli_home" "$agent" "create")"

  if [[ "$target" == "skill" ]]; then
    validate_skill_name_unique "$agent_home" "$agent" "$name" "$category" "$force"
    create_skill_for_agent "$agent" "$agent_home" "$category" "$phys_cat" "$name"
  elif [[ "$target" == "rule" ]]; then
    local rule_name
    rule_name="$(normalize_rule_name "$name")"
    validate_identifier "$rule_name" "name" "create"
    create_rule_for_agent "$agent" "$agent_home" "$category" "$phys_cat" "$rule_name" "$force"
  fi
}

##
# 기존 스킬(Skill) 또는 규칙(Rule)을 삭제하거나, 카테고리 전체를 삭제합니다.
# - '--category' 및 '--name' 모두 콤마(,)로 구분된 다중 입력을 지원합니다.
# - '--category'에 여러 카테고리가 지정된 경우 '--name'은 허용하지 않으며 복수 카테고리를 삭제합니다.
# - 다중 입력된 대상 정보를 별도 라인으로 출력하고 1회만 [y/n] 확인을 요청합니다.
#
# @param $1 {string} 상위에서 전달된 에이전트 이름 (선택, 빈 값이면 기본값 antigravity 적용)
# @param ${@:2} {array} remove 서브커맨드 인자 목록
#
# @return 0 (성공 시)
##
cmd_remove() {
  local agent="${1:-}"
  shift || true

  local target=""
  local category=""
  local name=""
  local cli_home=""
  local force="false"

  while (( $# > 0 )); do
    case "$1" in
      --help)
        help "" "" "remove"
        return 0
        ;;
      --agent)
        [[ $# -ge 2 ]] || die "'--agent' 옵션에 값이 필요합니다. (antigravity | agy | codex | claude)" "$LINENO" "remove"
        agent="$2"
        shift 2
        ;;
      --agent=*)
        agent="${1#--agent=}"
        shift
        ;;
      skill|rule)
        if [[ -z "$target" ]]; then
          target="$1"
          shift
        else
          die "대상(skill|rule)이 중복 지정되었습니다: $1" "$LINENO" "remove"
        fi
        ;;
      --category)
        [[ $# -ge 2 ]] || die "'--category' 옵션에 값이 필요합니다." "$LINENO" "remove"
        category="$2"
        shift 2
        ;;
      --category=*)
        category="${1#--category=}"
        shift
        ;;
      --name)
        [[ $# -ge 2 ]] || die "'--name' 옵션에 값이 필요합니다." "$LINENO" "remove"
        name="$2"
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        shift
        ;;
      --home)
        [[ $# -ge 2 ]] || die "'--home' 옵션에 경로가 필요합니다." "$LINENO" "remove"
        cli_home="$2"
        shift 2
        ;;
      --home=*)
        cli_home="${1#--home=}"
        shift
        ;;
      --force)
        force="true"
        shift
        ;;
      -*)
        die "알 수 없는 옵션입니다: $1 (Long Option만 지원합니다)" "$LINENO" "remove"
        ;;
      *)
        die "알 수 없는 인자입니다: $1" "$LINENO" "remove"
        ;;
    esac
  done

  agent="$(normalize_agent_name "$agent" "remove")"
  [[ -n "$target" ]] || die "삭제할 대상('skill' 또는 'rule')을 지정해야 합니다." "$LINENO" "remove"
  [[ -n "$category" ]] || die "'--category' 옵션 값이 비어 있습니다." "$LINENO" "remove"

  local cat_norm_mode="skill-cat"
  [[ "$target" == "rule" ]] && cat_norm_mode="rule-cat"

  local -a categories=()
  local item_line
  while IFS= read -r item_line; do
    [[ -n "$item_line" ]] && categories+=("$item_line")
  done < <(split_csv_unique "$category" "category" "remove" "$cat_norm_mode")

  if (( ${#categories[@]} > 1 )) && [[ -n "$name" ]]; then
    die "'--category'에 여러 카테고리를 지정한 경우 '--name' 옵션을 함께 사용할 수 없습니다." "$LINENO" "remove"
  fi

  local agent_home
  agent_home="$(resolve_agent_home "$cli_home" "$agent" "remove")"

  local skills_subpath rules_subpath
  skills_subpath="$(get_skills_subpath "$agent")"
  rules_subpath="$(get_rules_subpath "$agent")"

  local target_label="스킬"
  [[ "$target" == "rule" ]] && target_label="규칙"

  # 1. '--name'이 생략된 경우: 1개 또는 여러 개의 카테고리 자체 삭제
  if [[ -z "$name" ]]; then
    local cat phys_cat cat_dir
    for cat in "${categories[@]}"; do
      phys_cat="$(resolve_existing_category_dir_name "$agent_home" "$target" "$cat")"
      if [[ "$target" == "skill" ]]; then
        cat_dir="${agent_home}/skills/${phys_cat}"
      else
        cat_dir="${agent_home}/rules/${phys_cat}"
      fi
      if [[ ! -d "$cat_dir" && ! -L "$cat_dir" ]]; then
        die "삭제할 카테고리가 존재하지 않습니다: ${cat_dir}" "$LINENO" "remove"
      fi
    done

    if [[ "$force" != "true" ]]; then
      echo "⚠️  [${agent}] 다음 ${target_label} 카테고리(총 ${#categories[@]}개)를 삭제하려고 합니다:"
      local items_dir entry item_bname link_dest
      for cat in "${categories[@]}"; do
        phys_cat="$(resolve_existing_category_dir_name "$agent_home" "$target" "$cat")"
        if [[ "$target" == "skill" ]]; then
          cat_dir="${agent_home}/skills/${phys_cat}"
          items_dir="${cat_dir}/${skills_subpath}"
        else
          cat_dir="${agent_home}/rules/${phys_cat}"
          if [[ -n "$rules_subpath" ]]; then
            items_dir="${cat_dir}/${rules_subpath}"
          else
            items_dir="${cat_dir}"
          fi
        fi

        local -a sub_items=()
        if [[ -d "$items_dir" ]]; then
          for entry in "${items_dir}"/*; do
            [[ -e "$entry" || -L "$entry" ]] || continue
            if [[ "$target" == "rule" ]]; then
              local bname
              bname="$(basename "$entry")"
              if [[ "$agent" == "codex" ]]; then
                [[ -d "$entry" || -L "$entry" ]] || continue
              else
                [[ "$bname" == *.md || "$bname" == *.MD ]] || continue
              fi
            fi
            sub_items+=("$entry")
          done
        fi

        echo "   - 카테고리 : ${cat} (${cat_dir})"
        if (( ${#sub_items[@]} > 0 )); then
          echo "     하위 ${target_label} 목록 (${#sub_items[@]}개):"
          for entry in "${sub_items[@]}"; do
            item_bname="$(basename "$entry")"
            if [[ -L "$entry" ]]; then
              link_dest="$(readlink "$entry" || true)"
              echo "       * ${item_bname} (심볼릭 링크 -> ${link_dest})"
            else
              echo "       * ${item_bname}"
            fi
          done
        else
          echo "     하위 ${target_label} 목록: (없음)"
        fi
      done

      if ! confirm_yes_no "삭제를 진행하시겠습니까? [y/n]: "; then
        echo "🚫 삭제 작업이 취소되었습니다."
        return 0
      fi
    fi

    for cat in "${categories[@]}"; do
      phys_cat="$(resolve_existing_category_dir_name "$agent_home" "$target" "$cat")"
      if [[ "$target" == "skill" ]]; then
        cat_dir="${agent_home}/skills/${phys_cat}"
      else
        cat_dir="${agent_home}/rules/${phys_cat}"
      fi
      rm -rf "$cat_dir"
      echo "🗑️  [REMOVE:CATEGORY] (${agent}) '${cat}' 카테고리가 삭제되었습니다: ${cat_dir}"
    done
    return 0
  fi

  # 2. '--name'이 지정된 경우: 단일 카테고리 내 1개 또는 여러 개의 스킬/규칙 삭제
  local single_cat="${categories[0]}"
  local single_phys_cat
  single_phys_cat="$(resolve_existing_category_dir_name "$agent_home" "$target" "$single_cat")"

  local -a names=()
  local norm_flag=""
  [[ "$target" == "rule" ]] && norm_flag="rule-name"

  while IFS= read -r item_line; do
    [[ -n "$item_line" ]] && names+=("$item_line")
  done < <(split_csv_unique "$name" "name" "remove" "$norm_flag")

  if [[ "$target" == "skill" ]]; then
    local sname skill_dir
    for sname in "${names[@]}"; do
      skill_dir="${agent_home}/skills/${single_phys_cat}/${skills_subpath}/${sname}"
      if [[ ! -e "$skill_dir" && ! -L "$skill_dir" ]]; then
        die "삭제할 스킬이 존재하지 않습니다: ${skill_dir}" "$LINENO" "remove"
      fi
    done

    if [[ "$force" != "true" ]]; then
      echo "⚠️  [${agent}] '${single_cat}' (${single_phys_cat}) 카테고리에서 다음 스킬(총 ${#names[@]}개)을 삭제하려고 합니다:"
      local item_type link_target
      for sname in "${names[@]}"; do
        skill_dir="${agent_home}/skills/${single_phys_cat}/${skills_subpath}/${sname}"
        item_type="일반 디렉토리 (원본 삭제)"
        if [[ -L "$skill_dir" ]]; then
          link_target="$(readlink "$skill_dir" || true)"
          item_type="심볼릭 링크 (원본 보존: ${link_target})"
        fi
        echo "   - ${sname} : ${skill_dir} [${item_type}]"
      done

      if ! confirm_yes_no "삭제를 진행하시겠습니까? [y/n]: "; then
        echo "🚫 삭제 작업이 취소되었습니다."
        return 0
      fi
    fi

    for sname in "${names[@]}"; do
      skill_dir="${agent_home}/skills/${single_phys_cat}/${skills_subpath}/${sname}"
      if [[ -L "$skill_dir" ]]; then
        rm -f "$skill_dir"
      else
        rm -rf "$skill_dir"
      fi
      echo "🗑️  [REMOVE:SKILL] (${agent}) 스킬이 삭제되었습니다: ${skill_dir}"
    done

    local category_dir="${agent_home}/skills/${single_phys_cat}"
    local skills_dir="${category_dir}/${skills_subpath}"
    local remaining_count=0
    local entry
    if [[ -d "$skills_dir" ]]; then
      for entry in "${skills_dir}"/*; do
        [[ -e "$entry" || -L "$entry" ]] || continue
        ((remaining_count++)) || true
      done
    fi
    if (( remaining_count == 0 )) && [[ -d "$category_dir" || -L "$category_dir" ]]; then
      rm -rf "$category_dir"
      echo "🗑️  [REMOVE:CATEGORY] (${agent}) '${single_cat}' 카테고리에 더 이상 스킬이 존재하지 않아 카테고리도 함께 삭제되었습니다: ${category_dir}"
    fi

  elif [[ "$target" == "rule" ]]; then
    if [[ "$agent" == "codex" ]]; then
      local rname rule_dir
      for rname in "${names[@]}"; do
        rule_dir="${agent_home}/rules/${single_phys_cat}/${rname}"
        if [[ ! -e "$rule_dir" && ! -L "$rule_dir" ]]; then
          die "삭제할 규칙 디렉토리가 존재하지 않습니다: ${rule_dir}" "$LINENO" "remove"
        fi
      done

      if [[ "$force" != "true" ]]; then
        echo "⚠️  [${agent}] '${single_cat}' (${single_phys_cat}) 카테고리에서 다음 규칙(총 ${#names[@]}개)을 삭제하려고 합니다:"
        local item_type link_target
        for rname in "${names[@]}"; do
          rule_dir="${agent_home}/rules/${single_phys_cat}/${rname}"
          item_type="일반 디렉토리 (AGENTS.md 및 참조 폴더 원본 삭제)"
          if [[ -L "$rule_dir" ]]; then
            link_target="$(readlink "$rule_dir" || true)"
            item_type="심볼릭 링크 (원본 보존: ${link_target})"
          fi
          echo "   - ${rname} : ${rule_dir} [${item_type}]"
        done

        if ! confirm_yes_no "삭제를 진행하시겠습니까? [y/n]: "; then
          echo "🚫 삭제 작업이 취소되었습니다."
          return 0
        fi
      fi

      for rname in "${names[@]}"; do
        rule_dir="${agent_home}/rules/${single_phys_cat}/${rname}"
        if [[ -L "$rule_dir" ]]; then
          rm -f "$rule_dir"
        else
          rm -rf "$rule_dir"
        fi
        echo "🗑️  [REMOVE:RULE] (${agent}) 규칙 디렉토리가 삭제되었습니다: ${rule_dir}"
      done

      local category_dir="${agent_home}/rules/${single_phys_cat}"
      local remaining_count=0
      local entry
      if [[ -d "$category_dir" ]]; then
        for entry in "${category_dir}"/*; do
          [[ -e "$entry" || -L "$entry" ]] || continue
          ((remaining_count++)) || true
        done
      fi
      if (( remaining_count == 0 )) && [[ -d "$category_dir" || -L "$category_dir" ]]; then
        rm -rf "$category_dir"
        echo "🗑️  [REMOVE:CATEGORY] (${agent}) '${single_cat}' 카테고리에 더 이상 규칙이 존재하지 않아 카테고리도 함께 삭제되었습니다: ${category_dir}"
      fi
    else
      local rname rule_file rule_ref_dir
      for rname in "${names[@]}"; do
        rule_file="${agent_home}/rules/${single_phys_cat}/${rules_subpath}/${rname}.md"
        if [[ ! -e "$rule_file" && ! -L "$rule_file" ]]; then
          die "삭제할 규칙 파일이 존재하지 않습니다: ${rule_file}" "$LINENO" "remove"
        fi
      done

      if [[ "$force" != "true" ]]; then
        echo "⚠️  [${agent}] '${single_cat}' (${single_phys_cat}) 카테고리에서 다음 규칙(총 ${#names[@]}개)을 삭제하려고 합니다:"
        local item_type link_target
        for rname in "${names[@]}"; do
          rule_file="${agent_home}/rules/${single_phys_cat}/${rules_subpath}/${rname}.md"
          rule_ref_dir="${agent_home}/rules/${single_phys_cat}/${rules_subpath}/${rname}"
          item_type="일반 파일 (원본 삭제)"
          if [[ -L "$rule_file" ]]; then
            link_target="$(readlink "$rule_file" || true)"
            item_type="심볼릭 링크 (원본 보존: ${link_target})"
          fi
          echo "   - ${rname}.md : ${rule_file} [${item_type}]"
          if [[ -d "$rule_ref_dir" || -L "$rule_ref_dir" ]]; then
            echo "     (연관 참조 디렉토리 포함: ${rule_ref_dir})"
          fi
        done

        if ! confirm_yes_no "삭제를 진행하시겠습니까? [y/n]: "; then
          echo "🚫 삭제 작업이 취소되었습니다."
          return 0
        fi
      fi

      for rname in "${names[@]}"; do
        rule_file="${agent_home}/rules/${single_phys_cat}/${rules_subpath}/${rname}.md"
        rule_ref_dir="${agent_home}/rules/${single_phys_cat}/${rules_subpath}/${rname}"
        rm -f "$rule_file"
        if [[ -L "$rule_ref_dir" ]]; then
          rm -f "$rule_ref_dir"
        elif [[ -d "$rule_ref_dir" ]]; then
          rm -rf "$rule_ref_dir"
        fi
        echo "🗑️  [REMOVE:RULE] (${agent}) 규칙 및 연관 참조 디렉토리가 삭제되었습니다: ${rule_file}"
      done

      local category_dir="${agent_home}/rules/${single_phys_cat}"
      local rules_dir="${category_dir}/${rules_subpath}"
      local remaining_count=0
      local entry bname
      if [[ -d "$rules_dir" ]]; then
        for entry in "${rules_dir}"/*; do
          [[ -e "$entry" || -L "$entry" ]] || continue
          bname="$(basename "$entry")"
          [[ "$bname" == *.md || "$bname" == *.MD ]] || continue
          ((remaining_count++)) || true
        done
      fi
      if (( remaining_count == 0 )) && [[ -d "$category_dir" || -L "$category_dir" ]]; then
        rm -rf "$category_dir"
        echo "🗑️  [REMOVE:CATEGORY] (${agent}) '${single_cat}' 카테고리에 더 이상 규칙이 존재하지 않아 카테고리도 함께 삭제되었습니다: ${category_dir}"
      fi
    fi
  fi
}

##
# 이미 존재하는 스킬 또는 규칙(--name)을 지정된 카테고리(--category)에 심볼릭 링크로 추가합니다.
# 외부 스킬 디렉토리(--skill-dir) 또는 외부 규칙 파일(--rule-file) / 디렉토리(--rule-dir) 참조도 지원합니다.
#
# @param $1 {string} 상위에서 전달된 에이전트 이름 (선택, 빈 값이면 옵션 파싱 시 필수 검증)
# @param ${@:2} {array} add 서브커맨드 인자 목록
#
# @return 0 (성공 시)
##
cmd_add() {
  local agent="${1:-}"
  shift || true

  local target=""
  local category=""
  local name_arg=""
  local skill_dir_arg=""
  local rule_file_arg=""
  local rule_dir_arg=""
  local cli_home=""
  local force="false"

  while (( $# > 0 )); do
    case "$1" in
      --help)
        help "" "" "add"
        return 0
        ;;
      --agent)
        [[ $# -ge 2 ]] || die "'--agent' 옵션에 값이 필요합니다. (antigravity | agy | codex | claude)" "$LINENO" "add"
        agent="$2"
        shift 2
        ;;
      --agent=*)
        agent="${1#--agent=}"
        shift
        ;;
      skill|rule)
        if [[ -z "$target" ]]; then
          target="$1"
          shift
        else
          die "대상(skill|rule)이 중복 지정되었습니다: $1" "$LINENO" "add"
        fi
        ;;
      --category)
        [[ $# -ge 2 ]] || die "'--category' 옵션에 값이 필요합니다." "$LINENO" "add"
        category="$2"
        shift 2
        ;;
      --category=*)
        category="${1#--category=}"
        shift
        ;;
      --name)
        [[ $# -ge 2 ]] || die "'--name' 옵션에 대상 경로(또는 '{category}/{name}')가 필요합니다." "$LINENO" "add"
        name_arg="$2"
        shift 2
        ;;
      --name=*)
        name_arg="${1#--name=}"
        shift
        ;;
      --skill-dir)
        [[ $# -ge 2 ]] || die "'--skill-dir' 옵션에 외부 스킬 디렉토리 경로가 필요합니다." "$LINENO" "add"
        skill_dir_arg="$2"
        shift 2
        ;;
      --skill-dir=*)
        skill_dir_arg="${1#--skill-dir=}"
        shift
        ;;
      --rule-file)
        [[ $# -ge 2 ]] || die "'--rule-file' 옵션에 외부 규칙 파일 경로가 필요합니다." "$LINENO" "add"
        rule_file_arg="$2"
        shift 2
        ;;
      --rule-file=*)
        rule_file_arg="${1#--rule-file=}"
        shift
        ;;
      --rule-dir)
        [[ $# -ge 2 ]] || die "'--rule-dir' 옵션에 외부 규칙 디렉토리 경로가 필요합니다." "$LINENO" "add"
        rule_dir_arg="$2"
        shift 2
        ;;
      --rule-dir=*)
        rule_dir_arg="${1#--rule-dir=}"
        shift
        ;;
      --home)
        [[ $# -ge 2 ]] || die "'--home' 옵션에 경로가 필요합니다." "$LINENO" "add"
        cli_home="$2"
        shift 2
        ;;
      --home=*)
        cli_home="${1#--home=}"
        shift
        ;;
      --force)
        force="true"
        shift
        ;;
      -*)
        die "알 수 없는 옵션입니다: $1 (Long Option만 지원합니다)" "$LINENO" "add"
        ;;
      *)
        die "알 수 없는 인자입니다: $1" "$LINENO" "add"
        ;;
    esac
  done

  agent="$(normalize_agent_name "$agent" "add")"
  [[ -n "$target" ]] || die "추가할 대상('skill' 또는 'rule')을 지정해야 합니다." "$LINENO" "add"
  category="$(normalize_category_name "$target" "$category")"
  validate_identifier "$category" "category" "add"

  local agent_home
  agent_home="$(resolve_agent_home "$cli_home" "$agent" "add")"

  local skills_subpath rules_subpath
  skills_subpath="$(get_skills_subpath "$agent")"
  rules_subpath="$(get_rules_subpath "$agent")"

  local phys_cat
  phys_cat="$(resolve_existing_category_dir_name "$agent_home" "$target" "$category")"

  if [[ "$target" == "skill" ]]; then
    if [[ -n "$rule_file_arg" || -n "$rule_dir_arg" ]]; then
      die "'add skill' 명령어에서는 '--rule-file' 또는 '--rule-dir' 옵션을 사용할 수 없습니다." "$LINENO" "add"
    fi
    if [[ -n "$name_arg" && -n "$skill_dir_arg" ]]; then
      die "'add skill' 명령어에서는 '--name' 옵션과 '--skill-dir' 옵션을 함께 사용할 수 없습니다. 둘 중 하나만 지정해 주세요." "$LINENO" "add"
    fi
    if [[ -z "$name_arg" && -z "$skill_dir_arg" ]]; then
      die "참조할 스킬 대상('--name <카테고리/이름>' 또는 '--skill-dir <디렉토리경로>')을 지정해야 합니다." "$LINENO" "add"
    fi

    local abs_src_dir=""
    local skill_name=""

    if [[ -n "$skill_dir_arg" ]]; then
      [[ -d "$skill_dir_arg" ]] || die "지정된 외부 스킬 디렉토리가 존재하지 않습니다: ${skill_dir_arg}" "$LINENO" "add"
      if [[ ! -f "${skill_dir_arg}/SKILL.md" && ! -f "${skill_dir_arg}/SKILL.MD" ]]; then
        die "지정된 외부 디렉토리에 'SKILL.md' 파일이 존재하지 않습니다: ${skill_dir_arg}" "$LINENO" "add"
      fi
      abs_src_dir="$(resolve_abs_path "$skill_dir_arg" "resolve")"
      skill_name="$(basename "$abs_src_dir")"
    else
      local resolved_input="$name_arg"
      if [[ ! -d "$resolved_input" && "$resolved_input" == */* && "$resolved_input" != /* ]]; then
        local src_cat_raw="${resolved_input%%/*}"
        local src_cat_phys
        src_cat_phys="$(resolve_existing_category_dir_name "$agent_home" "skill" "$src_cat_raw")"
        local src_skill="${resolved_input#*/}"
        local candidate_dir="${agent_home}/skills/${src_cat_phys}/${skills_subpath}/${src_skill}"
        if [[ -d "$candidate_dir" ]]; then
          resolved_input="$candidate_dir"
        fi
      fi

      [[ -d "$resolved_input" ]] || die "참조할 원본 스킬 디렉토리가 존재하지 않습니다: ${name_arg}" "$LINENO" "add"
      abs_src_dir="$(resolve_abs_path "$resolved_input" "resolve")"
      skill_name="$(basename "$abs_src_dir")"
    fi

    validate_identifier "$skill_name" "name" "add"
    validate_skill_name_unique "$agent_home" "$agent" "$skill_name" "$category" "$force"

    local skills_parent="${agent_home}/skills/${phys_cat}/${skills_subpath}"
    local link_path="${skills_parent}/${skill_name}"

    mkdir -p "$skills_parent"
    local abs_skills_parent
    abs_skills_parent="$(resolve_abs_path "$skills_parent" "resolve")"
    if [[ "${abs_skills_parent}/${skill_name}" == "$abs_src_dir" ]]; then
      die "원본 스킬과 동일한 카테고리('${category}')로 자기 자신을 심볼릭 링크할 수 없습니다: ${abs_src_dir}" "$LINENO" "add"
    fi

    if [[ -e "$link_path" || -L "$link_path" ]]; then
      if [[ "$force" != "true" ]]; then
        die "해당 카테고리에 이미 동일한 이름의 스킬이 존재합니다: ${link_path} (교체하려면 '--force' 옵션을 사용하세요)" "$LINENO" "add"
      fi
      if [[ -L "$link_path" ]]; then
        rm -f "$link_path"
      else
        rm -rf "$link_path"
      fi
    fi

    ln -s "$abs_src_dir" "$link_path"

    echo "🔗 [ADD:SKILL] (${agent}) 스킬 심볼릭 링크가 추가되었습니다."
    echo "   - 에이전트 : ${agent}"
    echo "   - 카테고리 : ${category} (${phys_cat})"
    echo "   - 스킬 이름: ${skill_name}"
    echo "   - 링크 경로: ${link_path}"
    echo "   - 원본 경로: ${abs_src_dir}"

  elif [[ "$target" == "rule" ]]; then
    if [[ -n "$skill_dir_arg" ]]; then
      die "'add rule' 명령어에서는 '--skill-dir' 옵션을 사용할 수 없습니다." "$LINENO" "add"
    fi

    if [[ "$agent" == "codex" ]]; then
      if [[ -n "$rule_file_arg" ]]; then
        die "Codex 에이전트는 규칙이 디렉토리 단위로 관리되므로 '--rule-file' 대신 '--rule-dir <디렉토리경로>' 옵션을 사용해야 합니다." "$LINENO" "add"
      fi
      if [[ -n "$name_arg" && -n "$rule_dir_arg" ]]; then
        die "'add rule' (codex) 명령어에서는 '--name' 옵션과 '--rule-dir' 옵션을 함께 사용할 수 없습니다. 둘 중 하나만 지정해 주세요." "$LINENO" "add"
      fi
      if [[ -z "$name_arg" && -z "$rule_dir_arg" ]]; then
        die "참조할 Codex 규칙 대상('--name <카테고리/이름>' 또는 '--rule-dir <디렉토리경로>')을 지정해야 합니다." "$LINENO" "add"
      fi

      local abs_src_dir=""
      local rule_name=""

      if [[ -n "$rule_dir_arg" ]]; then
        [[ -d "$rule_dir_arg" ]] || die "지정된 외부 Codex 규칙 디렉토리가 존재하지 않습니다: ${rule_dir_arg}" "$LINENO" "add"
        if [[ ! -f "${rule_dir_arg}/AGENTS.md" && ! -f "${rule_dir_arg}/AGENTS.MD" ]]; then
          die "지정된 외부 디렉토리에 'AGENTS.md' 파일이 존재하지 않습니다: ${rule_dir_arg}" "$LINENO" "add"
        fi
        abs_src_dir="$(resolve_abs_path "$rule_dir_arg" "resolve")"
        rule_name="$(basename "$abs_src_dir")"
      else
        local resolved_input="$name_arg"
        if [[ "$resolved_input" == */AGENTS.md || "$resolved_input" == */AGENTS.MD ]]; then
          resolved_input="$(dirname "$resolved_input")"
        fi
        if [[ ! -d "$resolved_input" && "$resolved_input" == */* && "$resolved_input" != /* ]]; then
          local src_cat_raw="${resolved_input%%/*}"
          local src_cat_phys
          src_cat_phys="$(resolve_existing_category_dir_name "$agent_home" "rule" "$src_cat_raw")"
          local src_rule
          src_rule="$(normalize_rule_name "${resolved_input#*/}")"
          local candidate_dir="${agent_home}/rules/${src_cat_phys}/${src_rule}"
          if [[ -d "$candidate_dir" ]]; then
            resolved_input="$candidate_dir"
          fi
        fi

        [[ -d "$resolved_input" ]] || die "참조할 원본 Codex 규칙 디렉토리가 존재하지 않습니다: ${name_arg}" "$LINENO" "add"
        abs_src_dir="$(resolve_abs_path "$resolved_input" "resolve")"
        rule_name="$(basename "$abs_src_dir")"
      fi

      validate_identifier "$rule_name" "name" "add"

      local rules_parent="${agent_home}/rules/${phys_cat}"
      local link_path="${rules_parent}/${rule_name}"

      mkdir -p "$rules_parent"
      local abs_rules_parent
      abs_rules_parent="$(resolve_abs_path "$rules_parent" "resolve")"
      if [[ "${abs_rules_parent}/${rule_name}" == "$abs_src_dir" ]]; then
        die "원본 규칙과 동일한 카테고리('${category}')로 자기 자신을 심볼릭 링크할 수 없습니다: ${abs_src_dir}" "$LINENO" "add"
      fi

      if [[ -e "$link_path" || -L "$link_path" ]]; then
        if [[ "$force" != "true" ]]; then
          die "해당 카테고리에 이미 동일한 이름의 규칙 디렉토리가 존재합니다: ${link_path} (교체하려면 '--force' 옵션을 사용하세요)" "$LINENO" "add"
        fi
        if [[ -L "$link_path" ]]; then
          rm -f "$link_path"
        else
          rm -rf "$link_path"
        fi
      fi

      ln -s "$abs_src_dir" "$link_path"

      echo "🔗 [ADD:RULE] (${agent}) 규칙 심볼릭 링크가 추가되었습니다."
      echo "   - 에이전트 : ${agent}"
      echo "   - 카테고리 : ${category} (${phys_cat})"
      echo "   - 규칙 이름: ${rule_name}"
      echo "   - 링크 경로: ${link_path}"
      echo "   - 원본 경로: ${abs_src_dir}"

    else
      # antigravity / claude
      if [[ -n "$rule_dir_arg" ]]; then
        die "[${agent}] 에이전트는 규칙이 단일 파일 단위로 관리되므로 '--rule-dir' 대신 '--rule-file <마크다운파일>' 옵션을 사용해야 합니다." "$LINENO" "add"
      fi
      if [[ -n "$name_arg" && -n "$rule_file_arg" ]]; then
        die "'add rule' ([${agent}]) 명령어에서는 '--name' 옵션과 '--rule-file' 옵션을 함께 사용할 수 없습니다. 둘 중 하나만 지정해 주세요." "$LINENO" "add"
      fi
      if [[ -z "$name_arg" && -z "$rule_file_arg" ]]; then
        die "참조할 규칙 대상('--name <카테고리/이름>' 또는 '--rule-file <파일경로>')을 지정해야 합니다." "$LINENO" "add"
      fi

      local abs_src_file=""
      local rule_name=""

      if [[ -n "$rule_file_arg" ]]; then
        [[ -f "$rule_file_arg" ]] || die "지정된 외부 규칙 파일이 존재하지 않습니다: ${rule_file_arg}" "$LINENO" "add"
        [[ "$rule_file_arg" == *.md || "$rule_file_arg" == *.MD ]] || die "규칙 파일은 마크다운(.md) 파일이어야 합니다: ${rule_file_arg}" "$LINENO" "add"
        abs_src_file="$(resolve_abs_path "$rule_file_arg" "resolve")"
        rule_name="$(normalize_rule_name "$(basename "$abs_src_file")")"
      else
        local resolved_input="$name_arg"
        if [[ ! -f "$resolved_input" && "$resolved_input" == */* && "$resolved_input" != /* ]]; then
          local src_cat_raw="${resolved_input%%/*}"
          local src_cat_phys
          src_cat_phys="$(resolve_existing_category_dir_name "$agent_home" "rule" "$src_cat_raw")"
          local src_rule
          src_rule="$(normalize_rule_name "${resolved_input#*/}")"
          local candidate_file="${agent_home}/rules/${src_cat_phys}/${rules_subpath}/${src_rule}.md"
          if [[ -f "$candidate_file" ]]; then
            resolved_input="$candidate_file"
          fi
        fi

        [[ -f "$resolved_input" ]] || die "참조할 원본 규칙 파일이 존재하지 않습니다: ${name_arg}" "$LINENO" "add"
        abs_src_file="$(resolve_abs_path "$resolved_input" "resolve")"
        rule_name="$(normalize_rule_name "$(basename "$abs_src_file")")"
      fi

      validate_identifier "$rule_name" "name" "add"

      local rules_parent="${agent_home}/rules/${phys_cat}/${rules_subpath}"
      local link_path="${rules_parent}/${rule_name}.md"

      mkdir -p "$rules_parent"
      local abs_rules_parent
      abs_rules_parent="$(resolve_abs_path "$rules_parent" "resolve")"
      if [[ "${abs_rules_parent}/${rule_name}.md" == "$abs_src_file" ]]; then
        die "원본 규칙과 동일한 카테고리('${category}')로 자기 자신을 심볼릭 링크할 수 없습니다: ${abs_src_file}" "$LINENO" "add"
      fi

      if [[ -e "$link_path" || -L "$link_path" ]]; then
        if [[ "$force" != "true" ]]; then
          die "해당 카테고리에 이미 동일한 이름의 규칙 파일이 존재합니다: ${link_path} (교체하려면 '--force' 옵션을 사용하세요)" "$LINENO" "add"
        fi
        rm -f "$link_path"
      fi

      ln -s "$abs_src_file" "$link_path"

      # 원본 규칙과 동일한 위치에 연관 참조 디렉토리(<rule_name>/)가 존재하면 함께 심볼릭 링크 생성
      local src_parent_dir
      src_parent_dir="$(dirname "$abs_src_file")"
      local src_ref_dir="${src_parent_dir}/${rule_name}"
      local link_ref_dir="${rules_parent}/${rule_name}"
      if [[ -d "$src_ref_dir" ]]; then
        if [[ -e "$link_ref_dir" || -L "$link_ref_dir" ]]; then
          if [[ "$force" == "true" ]]; then
            if [[ -L "$link_ref_dir" ]]; then
              rm -f "$link_ref_dir"
            else
              rm -rf "$link_ref_dir"
            fi
            ln -s "$src_ref_dir" "$link_ref_dir"
          fi
        else
          ln -s "$src_ref_dir" "$link_ref_dir"
        fi
      fi

      echo "🔗 [ADD:RULE] (${agent}) 규칙 심볼릭 링크가 추가되었습니다."
      echo "   - 에이전트 : ${agent}"
      echo "   - 카테고리 : ${category} (${phys_cat})"
      echo "   - 규칙 이름: ${rule_name}"
      echo "   - 링크 경로: ${link_path}"
      echo "   - 원본 경로: ${abs_src_file}"
      if [[ -L "$link_ref_dir" ]]; then
        echo "   - 참조 링크: ${link_ref_dir} -> ${src_ref_dir}"
      fi
    fi
  fi
}

##
# 지정된 디렉토리 하위에(재귀적으로) 실제 파일(또는 파일 심볼릭 링크)이 최소 1개 이상 존재하는지 확인합니다.
# - 하위 파일/폴더가 전혀 없는 빈 디렉토리이거나
# - 비어 있는 하위 디렉토리만 존재하는 경우 1(false)을 반환합니다.
#
# @param $1 {string} 검사할 디렉토리 경로
# @param $2 {number} 재귀 탐색 깊이 (내부 루프 방지용, 기본값: 0)
#
# @return 0 (하위에 파일 존재), 1 (비어 있거나 빈 디렉토리만 존재)
##
dir_has_any_file() {
  local dir_path="$1"
  local depth="${2:-0}"
  (( depth < 16 )) || return 1
  [[ -d "$dir_path" ]] || return 1

  local item bname
  for item in "${dir_path}"/* "${dir_path}"/.[!.]* "${dir_path}"/..?*; do
    [[ -e "$item" || -L "$item" ]] || continue
    bname="$(basename "$item")"
    [[ "$bname" != "." && "$bname" != ".." ]] || continue
    if [[ -d "$item" ]]; then
      if dir_has_any_file "$item" "$((depth + 1))"; then
        return 0
      fi
    else
      return 0
    fi
  done

  return 1
}

##
# 디렉토리 내부의 파일 및 하위 폴더들을 tree 선 기호(├──, └──, │) 스타일로 재귀 출력합니다.
# 단, 비어 있는 디렉토리이거나 빈 디렉토리만 포함하는 하위 디렉토리는 출력에서 제외합니다.
#
# @param $1 {string} 탐색할 디렉토리 경로
# @param $2 {string} 현재 줄 앞에 붙일 들여쓰기 접두사
#
# @return 0
##
render_dir_tree() {
  local dir_path="$1"
  local prefix="${2:-}"

  [[ -d "$dir_path" ]] || return 0

  local -a entries=()
  local item
  for item in "${dir_path}"/*; do
    [[ -e "$item" || -L "$item" ]] || continue
    if [[ -d "$item" ]]; then
      dir_has_any_file "$item" || continue
    fi
    entries+=("$item")
  done

  local count="${#entries[@]}"
  (( count > 0 )) || return 0

  local idx=0
  local branch next_prefix bname link_target
  for item in "${entries[@]}"; do
    ((idx++)) || true
    bname="$(basename "$item")"

    if (( idx == count )); then
      branch="└── "
      next_prefix="${prefix}    "
    else
      branch="├── "
      next_prefix="${prefix}│   "
    fi

    if [[ -L "$item" ]]; then
      link_target="$(readlink "$item" || true)"
      if [[ -d "$item" ]]; then
        printf "%s%s%s/ -> %s\n" "$prefix" "$branch" "$bname" "$link_target"
        render_dir_tree "$item" "$next_prefix"
      else
        printf "%s%s%s -> %s\n" "$prefix" "$branch" "$bname" "$link_target"
      fi
    elif [[ -d "$item" ]]; then
      printf "%s%s%s/\n" "$prefix" "$branch" "$bname"
      render_dir_tree "$item" "$next_prefix"
    else
      printf "%s%s%s\n" "$prefix" "$branch" "$bname"
    fi
  done
}

##
# 에이전트와 대상 종류(skill | rule)에 따른 태그와 들여쓰기 공백을 반환합니다.
#
# @param $1 {string} 정규화된 에이전트 이름 (antigravity | claude | codex)
# @param $2 {string} 대상 종류 (skill | rule)
#
# @return "태그" "들여쓰기공백" (탭으로 구분)
##
get_agent_kind_tag_and_indent() {
  local agent="$1"
  local kind="$2"

  local kind_emoji=""
  if [[ "$kind" == "skill" ]]; then
    kind_emoji="🚀"
  else
    kind_emoji="📜"
  fi

  local tag="[${kind_emoji}] "
  local indent="     " # 5칸 (1 + 2 + 1 + 1 = 5)

  printf "%s\t%s\n" "$tag" "$indent"
}

##
# 단일 스킬 카테고리의 트리 구조를 출력합니다.
#
# @param $1 {string} 에이전트 루트 경로 (agent_home)
# @param $2 {string} 정규화된 에이전트 이름 (antigravity | claude | codex)
# @param $3 {string} 논리 카테고리 이름
# @param $4 {string} 콤마로 구분된 스킬 이름 필터 (선택)
#
# @return 0
##
print_skill_category_tree() {
  local agent_home="$1"
  local agent="$2"
  local logical_cat="$3"
  local filter_names_csv="${4:-}"

  local skills_subpath
  skills_subpath="$(get_skills_subpath "$agent")"

  local phys_cat
  phys_cat="$(resolve_existing_category_dir_name "$agent_home" "skill" "$logical_cat")"
  local cat_root="${agent_home}/skills/${phys_cat}"
  local skills_dir="${cat_root}/${skills_subpath}"

  if [[ ! -d "$cat_root" ]]; then
    die "조회할 스킬 카테고리가 존재하지 않습니다: ${cat_root}" "$LINENO" "list"
  fi

  local -a skill_entries=()
  if [[ -n "$filter_names_csv" ]]; then
    local sname target_skill
    while IFS= read -r sname; do
      [[ -n "$sname" ]] || continue
      target_skill="${skills_dir}/${sname}"
      if [[ ! -e "$target_skill" && ! -L "$target_skill" ]]; then
        die "카테고리 '${logical_cat}' (${phys_cat})에 '${sname}' 스킬이 존재하지 않습니다: ${target_skill}" "$LINENO" "list"
      fi
      if [[ -d "$target_skill" ]]; then
        dir_has_any_file "$target_skill" || continue
      fi
      skill_entries+=("$target_skill")
    done < <(split_csv_unique "$filter_names_csv" "name" "list" "")
  elif [[ -d "$skills_dir" ]]; then
    local entry
    for entry in "${skills_dir}"/*; do
      [[ -e "$entry" || -L "$entry" ]] || continue
      if [[ -d "$entry" ]]; then
        dir_has_any_file "$entry" || continue
      fi
      skill_entries+=("$entry")
    done
  fi

  local count="${#skill_entries[@]}"
  (( count > 0 )) || return 0

  local tag_info tag base_indent
  tag_info="$(get_agent_kind_tag_and_indent "$agent" "skill")"
  tag="${tag_info%%$'\t'*}"
  base_indent="${tag_info#*$'\t'}"

  local rel_path="./${agent}/skills/${phys_cat}"
  printf "%s%s\n" "$tag" "$rel_path"

  local idx=0
  local entry sname branch child_prefix link_target
  for entry in "${skill_entries[@]}"; do
    ((idx++)) || true
    sname="$(basename "$entry")"

    if (( idx == count )); then
      branch="└── "
      child_prefix="    "
    else
      branch="├── "
      child_prefix="│   "
    fi

    if [[ -L "$entry" ]]; then
      link_target="$(readlink "$entry" || true)"
      if [[ -e "$entry" ]]; then
        printf "%s%s%s -> %s\n" "$base_indent" "$branch" "$sname" "$link_target"
        render_dir_tree "$entry" "${base_indent}${child_prefix}"
      else
        printf "%s%s%s -> %s (대상 없음)\n" "$base_indent" "$branch" "$sname" "$link_target"
      fi
    elif [[ -d "$entry" ]]; then
      printf "%s%s%s\n" "$base_indent" "$branch" "$sname"
      render_dir_tree "$entry" "${base_indent}${child_prefix}"
    else
      printf "%s%s%s\n" "$base_indent" "$branch" "$sname"
    fi
  done
}

##
# 단일 규칙 카테고리의 트리 구조를 출력합니다.
# - antigravity / claude: 규칙 파일(<rule-name>.md)과 실제 파일이 존재하는 연관 참조 디렉토리(<rule-name>/)를 함께 출력
# - codex               : 규칙 디렉토리(<rule-name>/AGENTS.md 및 실제 파일이 존재하는 하위 참조 폴더)를 트리 출력
#
# @param $1 {string} 에이전트 루트 경로 (agent_home)
# @param $2 {string} 정규화된 에이전트 이름 (antigravity | claude | codex)
# @param $3 {string} 논리 카테고리 이름
# @param $4 {string} 콤마로 구분된 규칙 이름 필터 (선택)
#
# @return 0
##
print_rule_category_tree() {
  local agent_home="$1"
  local agent="$2"
  local logical_cat="$3"
  local filter_names_csv="${4:-}"

  local rules_subpath
  rules_subpath="$(get_rules_subpath "$agent")"

  local phys_cat
  phys_cat="$(resolve_existing_category_dir_name "$agent_home" "rule" "$logical_cat")"
  local cat_root="${agent_home}/rules/${phys_cat}"
  local rules_dir="$cat_root"
  [[ -n "$rules_subpath" ]] && rules_dir="${cat_root}/${rules_subpath}"

  if [[ ! -d "$cat_root" ]]; then
    die "조회할 규칙 카테고리가 존재하지 않습니다: ${cat_root}" "$LINENO" "list"
  fi

  local -a display_entries=()
  if [[ "$agent" == "codex" ]]; then
    if [[ -n "$filter_names_csv" ]]; then
      local rname target_rule_dir
      while IFS= read -r rname; do
        [[ -n "$rname" ]] || continue
        target_rule_dir="${rules_dir}/${rname}"
        if [[ ! -e "$target_rule_dir" && ! -L "$target_rule_dir" ]]; then
          die "카테고리 '${logical_cat}' (${phys_cat})에 '${rname}' 규칙이 존재하지 않습니다: ${target_rule_dir}" "$LINENO" "list"
        fi
        if [[ -d "$target_rule_dir" ]]; then
          dir_has_any_file "$target_rule_dir" || continue
        fi
        display_entries+=("$target_rule_dir")
      done < <(split_csv_unique "$filter_names_csv" "name" "list" "rule-name")
    elif [[ -d "$rules_dir" ]]; then
      local entry
      for entry in "${rules_dir}"/*; do
        [[ -d "$entry" || -L "$entry" ]] || continue
        if [[ -d "$entry" ]]; then
          dir_has_any_file "$entry" || continue
        fi
        display_entries+=("$entry")
      done
    fi
  else
    if [[ -n "$filter_names_csv" ]]; then
      local rname target_rule target_ref_dir
      while IFS= read -r rname; do
        [[ -n "$rname" ]] || continue
        target_rule="${rules_dir}/${rname}.md"
        target_ref_dir="${rules_dir}/${rname}"
        if [[ ! -e "$target_rule" && ! -L "$target_rule" ]]; then
          die "카테고리 '${logical_cat}' (${phys_cat})에 '${rname}' 규칙이 존재하지 않습니다: ${target_rule}" "$LINENO" "list"
        fi
        display_entries+=("$target_rule")
        if [[ -d "$target_ref_dir" || -L "$target_ref_dir" ]] && dir_has_any_file "$target_ref_dir"; then
          display_entries+=("$target_ref_dir")
        fi
      done < <(split_csv_unique "$filter_names_csv" "name" "list" "rule-name")
    elif [[ -d "$rules_dir" ]]; then
      local entry bname rname target_ref_dir
      for entry in "${rules_dir}"/*; do
        [[ -e "$entry" || -L "$entry" ]] || continue
        bname="$(basename "$entry")"
        [[ "$bname" == *.md || "$bname" == *.MD ]] || continue
        display_entries+=("$entry")
        rname="$(normalize_rule_name "$bname")"
        target_ref_dir="${rules_dir}/${rname}"
        if [[ -d "$target_ref_dir" || -L "$target_ref_dir" ]] && dir_has_any_file "$target_ref_dir"; then
          display_entries+=("$target_ref_dir")
        fi
      done
    fi
  fi

  local count="${#display_entries[@]}"
  (( count > 0 )) || return 0

  local tag_info tag base_indent
  tag_info="$(get_agent_kind_tag_and_indent "$agent" "rule")"
  tag="${tag_info%%$'\t'*}"
  base_indent="${tag_info#*$'\t'}"

  local rel_path="./${agent}/rules/${phys_cat}"
  printf "%s%s\n" "$tag" "$rel_path"

  local idx=0
  local entry rfile branch child_prefix link_target
  for entry in "${display_entries[@]}"; do
    ((idx++)) || true
    rfile="$(basename "$entry")"

    if (( idx == count )); then
      branch="└── "
      child_prefix="    "
    else
      branch="├── "
      child_prefix="│   "
    fi

    if [[ -L "$entry" ]]; then
      link_target="$(readlink "$entry" || true)"
      if [[ -d "$entry" ]]; then
        printf "%s%s%s/ -> %s\n" "$base_indent" "$branch" "$rfile" "$link_target"
        render_dir_tree "$entry" "${base_indent}${child_prefix}"
      elif [[ -e "$entry" ]]; then
        printf "%s%s%s -> %s\n" "$base_indent" "$branch" "$rfile" "$link_target"
      else
        printf "%s%s%s -> %s (대상 없음)\n" "$base_indent" "$branch" "$rfile" "$link_target"
      fi
    elif [[ -d "$entry" ]]; then
      printf "%s%s%s/\n" "$base_indent" "$branch" "$rfile"
      render_dir_tree "$entry" "${base_indent}${child_prefix}"
    else
      printf "%s%s%s\n" "$base_indent" "$branch" "$rfile"
    fi
  done
}

##
# 지정된 종류(skill 또는 rule)의 전체 또는 필터링된 트리 목록을 출력합니다.
# 비어 있는 디렉토리이거나 빈 디렉토리만 존재하는 카테고리는 출력에서 제외합니다.
#
# @param $1 {string} 종류 (skill | rule)
# @param $2 {string} 에이전트 루트 경로 (agent_home)
# @param $3 {string} 정규화된 에이전트 이름 (antigravity | claude | codex)
# @param $4 {string} 카테고리 필터 (콤마 구분 가능, 빈 문자열이면 전체 카테고리)
# @param $5 {string} 이름 필터 (콤마 구분 가능, 빈 문자열이면 전체 항목)
#
# @return 0
##
print_list_by_kind() {
  local kind="$1"
  local agent_home="$2"
  local agent="$3"
  local category_csv="${4:-}"
  local name_csv="${5:-}"

  local cat_norm_mode="skill-cat"
  [[ "$kind" == "rule" ]] && cat_norm_mode="rule-cat"

  if [[ -n "$category_csv" ]]; then
    local -a req_categories=()
    local cat_item
    while IFS= read -r cat_item; do
      [[ -n "$cat_item" ]] && req_categories+=("$cat_item")
    done < <(split_csv_unique "$category_csv" "category" "list" "$cat_norm_mode")

    for cat_item in "${req_categories[@]}"; do
      if [[ "$kind" == "skill" ]]; then
        print_skill_category_tree "$agent_home" "$agent" "$cat_item" "$name_csv"
      else
        print_rule_category_tree "$agent_home" "$agent" "$cat_item" "$name_csv"
      fi
    done
    return 0
  fi

  local kind_root=""
  if [[ "$kind" == "skill" ]]; then
    kind_root="${agent_home}/skills"
  else
    kind_root="${agent_home}/rules"
  fi

  dir_has_any_file "$kind_root" || return 0

  local -a categories=()
  local cat_dir bname
  for cat_dir in "${kind_root}"/*; do
    [[ -d "$cat_dir" ]] || continue
    dir_has_any_file "$cat_dir" || continue
    bname="$(basename "$cat_dir")"
    categories+=("$bname")
  done

  (( ${#categories[@]} > 0 )) || return 0

  local cat
  for cat in "${categories[@]}"; do
    if [[ "$kind" == "skill" ]]; then
      print_skill_category_tree "$agent_home" "$agent" "$cat" ""
    else
      print_rule_category_tree "$agent_home" "$agent" "$cat" ""
    fi
  done
}

##
# 단일 에이전트에 대해 skill / rule 목록을 출력합니다.
#
# @param $1 {string} 정규화된 에이전트 이름 (antigravity | claude | codex)
# @param $2 {string} 최상위 루트 경로 (asr_home)
# @param $3 {string} 대상 (all | skill | rule)
# @param $4 {string} 카테고리 필터 (선택)
# @param $5 {string} 이름 필터 (선택)
#
# @return 0
##
print_list_for_single_agent() {
  local agent="$1"
  local asr_home="$2"
  local target="$3"
  local category="$4"
  local name="$5"

  local agent_home="${asr_home}/${agent}"

  if [[ "$target" == "skill" ]]; then
    print_list_by_kind "skill" "$agent_home" "$agent" "$category" "$name"
  elif [[ "$target" == "rule" ]]; then
