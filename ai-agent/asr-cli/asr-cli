##
# 에이전트별 Rule 템플릿 및 참조 디렉토리를 생성합니다.
#
# @param $1 {string} 정규화된 에이전트 이름 (antigravity | claude | codex)
# @param $2 {string} 에이전트 루트 경로 (agent_home)
# @param $3 {string} 논리 카테고리명 (category)
# @param $4 {string} 물리 카테고리 디렉토리명 (phys_cat)
# @param $5 {string} 정규화된 규칙 이름 (rule_name)
# @param $6 {string} 덮어쓰기 여부 (force: true | false)
#
# @return 0
##
create_rule_for_agent() {
  local agent="$1"
  local agent_home="$2"
  local category="$3"
  local phys_cat="$4"
  local rule_name="$5"
  local force="$6"

  case "$agent" in
    antigravity)
      local rules_dir="${agent_home}/rules/${phys_cat}/.agents/rules"
      local rule_file="${rules_dir}/${rule_name}.md"
      local rule_ref_dir="${rules_dir}/${rule_name}"

      if [[ -e "$rule_file" || -L "$rule_file" ]]; then
        if [[ "$force" != "true" ]]; then
          die "이미 존재하는 규칙 파일입니다: ${rule_file} (덮어쓰려면 '--force' 옵션을 사용하세요)" "$LINENO" "create"
        fi
        rm -f "$rule_file"
      fi
      if [[ -L "$rule_ref_dir" ]]; then
        rm -f "$rule_ref_dir"
      fi

      mkdir -p "${rule_ref_dir}/scripts" "${rule_ref_dir}/templates" "${rule_ref_dir}/references"
      cat <<EOF > "$rule_file"
---
# [권장] 규칙이 에이전트 컨텍스트에 주입되는 방식 제어 (always_on | glob | model_decision)
# - always_on      : 세션 내내 상시 주입 (가장 안정적, 기본 권장)
# - glob           : 아래 globs에 정의된 대상 파일을 작업할 때만 주입
# - model_decision : 모델이 대화 문맥에 따라 로딩 여부 판단
# (주의: Antigravity Rule 파서는 엄격한 스키마를 적용하므로 name, description, always_apply, priority, tags 등 허용되지 않은 속성을 추가하면 파일 로딩이 차단됩니다.)
trigger: always_on

# [선택] 특정 파일 경로/확장자 작업 시에만 규칙을 주입하려면 위 trigger를 'glob'으로 변경하고 아래 주석을 해제하여 작성하십시오.
# globs:
#   - "**/*.java"
---

