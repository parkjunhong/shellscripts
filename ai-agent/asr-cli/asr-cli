##
# 에러 박스와 서브커맨드 도움말을 출력한 뒤 비정상 종료(exit 1)합니다.
#
# @param $1 {string} 오류 원인 메시지
# @param $2 {number} 오류 발생 행 번호
# @param $3 {string} 서브커맨드 이름 (선택)
#
# @return 없음 (exit 1)
##
die() {
  local cause="${1:-알 수 없는 오류가 발생했습니다.}"
  local line="${2:-unknown}"
  local subcmd="${3:-}"
  help "$cause" "$line" "$subcmd" >&2
  exit 1
}

##
# 입력된 '--agent' 값을 검증하고 정규화된 에이전트 디렉토리명(antigravity | claude | codex)을 반환합니다.
# 'agy'는 'antigravity'로 변환됩니다.
# 'create', 'remove', 'add', 'edit' 서브커맨드에서는 '--agent' 옵션이 필수입니다.
# 'list' 서브커맨드에서는 생략 시 빈 문자열을 반환하여 전체 에이전트 조회를 허용합니다.
#
# @param $1 {string} 입력된 에이전트 이름
# @param $2 {string} 서브커맨드 이름 (선택, 에러 출력용)
#
# @return 정규화된 에이전트 식별자 (antigravity | claude | codex)
##
normalize_agent_name() {
  local raw_agent="${1:-}"
  local subcmd="${2:-}"

  if [[ -z "$raw_agent" ]]; then
    if [[ "$subcmd" == "list" ]]; then
      printf "\n"
      return 0
    else
      die "필수 옵션 '--agent'가 누락되었습니다. (antigravity | agy | claude | codex)" "$LINENO" "$subcmd"
    fi
  fi

  case "$raw_agent" in
    antigravity|agy)
      printf "antigravity\n"
      ;;
    claude)
      printf "claude\n"
      ;;
    codex)
      printf "codex\n"
      ;;
    *)
      die "지원하지 않는 AI Agent입니다: '${raw_agent}' (지원 목록: antigravity, agy, codex, claude)" "$LINENO" "$subcmd"
      ;;
  esac
}

##
# 에이전트별 카테고리 내부 스킬 상대 경로를 반환합니다.
#
# @param $1 {string} 정규화된 에이전트 이름 (antigravity | claude | codex)
#
# @return 스킬 하위 경로 문자열 (.agents/skills | .claude/skills)
##
get_skills_subpath() {
  local agent="$1"
  case "$agent" in
    claude)
      printf ".claude/skills\n"
      ;;
    *)
      printf ".agents/skills\n"
      ;;
  esac
}

##
# 에이전트별 카테고리 내부 규칙 상대 경로를 반환합니다.
# (codex의 경우 카테고리 바로 아래에 <rule-name>/AGENTS.md가 위치하므로 빈 문자열 반환)
#
# @param $1 {string} 정규화된 에이전트 이름 (antigravity | claude | codex)
#
# @return 규칙 하위 경로 문자열 (.agents/rules | .claude/rules | "")
##
get_rules_subpath() {
  local agent="$1"
  case "$agent" in
    antigravity)
      printf ".agents/rules\n"
      ;;
    claude)
      printf ".claude/rules\n"
      ;;
    codex)
      printf "\n"
      ;;
  esac
}

##
# 경로를 절대 경로로 변환합니다.
#
# @param $1 {string} 대상 경로
# @param $2 {string} 모드 (resolve: 심볼릭 링크 최종 대상 해석, physical: 부모 디렉토리만 해석)
#
# @return 정규화된 절대 경로 문자열 출력
##
resolve_abs_path() {
  local target_path="$1"
  local mode="${2:-resolve}"

  if [[ "$mode" == "resolve" ]]; then
    if command -v realpath >/dev/null 2>&1; then
      realpath "$target_path"
      return 0
    elif command -v readlink >/dev/null 2>&1; then
      readlink -f "$target_path"
      return 0
    fi
  fi

  local dir_part base_part
  if [[ -d "$target_path" ]]; then
    (cd "$target_path" && pwd -P)
  else
    dir_part="$(dirname "$target_path")"
    base_part="$(basename "$target_path")"
    (cd "$dir_part" && printf "%s/%s\n" "$(pwd -P)" "$base_part")
  fi
}

##
# 카테고리명 또는 항목 이름에 허용되지 않는 문자(/, .. 등)가 포함되어 있는지 검증합니다.
#
# @param $1 {string} 검증할 식별자 문자열
# @param $2 {string} 항목 라벨 (예: category, name)
# @param $3 {string} 서브커맨드 이름
#
# @return 유효하면 0, 유효하지 않으면 die 호출
##
validate_identifier() {
  local value="$1"
  local label="$2"
  local subcmd="$3"

  if [[ -z "$value" ]]; then
    die "'--${label}' 값이 비어 있습니다." "$LINENO" "$subcmd"
  fi
  if [[ "$value" == *"/"* || "$value" == "." || "$value" == ".." ]]; then
    die "'--${label}' 값에는 경로 구분자('/')나 상대 경로('.', '..')를 사용할 수 없습니다: ${value}" "$LINENO" "$subcmd"
  fi
}

##
# 카테고리 이름에서 'skill-' 또는 'rule-' 접두사가 포함되어 있으면 제거하여 논리 카테고리명으로 정규화합니다.
#
# @param $1 {string} 대상 종류 (skill | rule)
# @param $2 {string} 입력된 카테고리 문자열
#
# @return 접두사가 제거된 논리 카테고리명 출력
##
normalize_category_name() {
  local kind="$1"
  local raw_cat="$2"

  if [[ "$kind" == "skill" && "$raw_cat" == skill-* ]]; then
    printf "%s\n" "${raw_cat#skill-}"
  elif [[ "$kind" == "rule" && "$raw_cat" == rule-* ]]; then
    printf "%s\n" "${raw_cat#rule-}"
  else
    printf "%s\n" "$raw_cat"
  fi
}

##
# 논리 카테고리명을 실제 디스크에 생성될 디렉토리명('skill-<category>' 또는 'rule-<category>')으로 변환합니다.
#
# @param $1 {string} 대상 종류 (skill | rule)
# @param $2 {string} 논리 카테고리명
#
# @return 실제 카테고리 디렉토리명 출력
##
to_physical_category_dir_name() {
  local kind="$1"
  local logical_cat
  logical_cat="$(normalize_category_name "$kind" "$2")"

  if [[ "$kind" == "skill" ]]; then
    printf "skill-%s\n" "$logical_cat"
  else
    printf "rule-%s\n" "$logical_cat"
  fi
}

##
# 이미 존재하는 카테고리 디렉토리를 탐색하여 실제 디렉토리명을 반환합니다.
# 'skill-'/'rule-' 접두사가 있는 디렉토리와 접두사가 없는 기존 디렉토리를 모두 지원합니다.
#
# @param $1 {string} 에이전트 루트 경로 (agent_home)
# @param $2 {string} 대상 종류 (skill | rule)
# @param $3 {string} 입력된 카테고리명
#
# @return 실제 카테고리 디렉토리명 (basename) 출력
##
resolve_existing_category_dir_name() {
  local agent_home="$1"
  local kind="$2"
  local raw_cat="$3"

  local base_root="${agent_home}/skills"
  [[ "$kind" == "rule" ]] && base_root="${agent_home}/rules"

  if [[ -d "${base_root}/${raw_cat}" || -L "${base_root}/${raw_cat}" ]]; then
    printf "%s\n" "$raw_cat"
    return 0
  fi

  local logical_cat
  logical_cat="$(normalize_category_name "$kind" "$raw_cat")"
  local prefixed_cat
  prefixed_cat="$(to_physical_category_dir_name "$kind" "$logical_cat")"

  if [[ -d "${base_root}/${prefixed_cat}" || -L "${base_root}/${prefixed_cat}" ]]; then
    printf "%s\n" "$prefixed_cat"
  elif [[ -d "${base_root}/${logical_cat}" || -L "${base_root}/${logical_cat}" ]]; then
    printf "%s\n" "$logical_cat"
  else
    printf "%s\n" "$prefixed_cat"
  fi
}

##
# 규칙(rule) 이름에서 .md 또는 .MD 확장자가 포함되어 있으면 제거하여 정규화합니다.
#
# @param $1 {string} 원본 이름 문자열
#
# @return 확장자가 제거된 이름 출력
##
normalize_rule_name() {
  local raw_name="$1"
  if [[ "$raw_name" == *.md ]]; then
    printf "%s\n" "${raw_name%.md}"
  elif [[ "$raw_name" == *.MD ]]; then
    printf "%s\n" "${raw_name%.MD}"
  else
    printf "%s\n" "$raw_name"
  fi
}

##
# 콤마(,)로 구분된 문자열을 분리하고 검증하여 중복을 제거한 뒤 줄바꿈으로 출력합니다.
#
# @param $1 {string} 콤마로 구분된 입력 문자열
# @param $2 {string} 옵션 라벨 (category | name)
# @param $3 {string} 서브커맨드 이름
# @param $4 {string} 정규화 모드 ('rule-name' | 'skill-cat' | 'rule-cat' | '')
#
# @return 줄바꿈으로 구분된 고유 항목 목록
##
split_csv_unique() {
  local raw="$1"
  local label="$2"
  local subcmd="$3"
  local norm_mode="${4:-}"

  if [[ -z "$raw" ]]; then
    die "'--${label}' 값이 비어 있습니다." "$LINENO" "$subcmd"
  fi
  if [[ "$raw" == ,* || "$raw" == *, || "$raw" == *,,* ]]; then
    die "'--${label}' 값에 잘못된 콤마(,) 구분이 포함되어 있습니다: ${raw}" "$LINENO" "$subcmd"
  fi

  local IFS=','
  local -a parts=()
  read -r -a parts <<< "$raw"

  local -a unique_items=()
  local part item existing found
  for part in "${parts[@]}"; do
    item="$part"
    case "$norm_mode" in
      rule-name)
        item="$(normalize_rule_name "$item")"
        ;;
      skill-cat)
        item="$(normalize_category_name "skill" "$item")"
        ;;
      rule-cat)
        item="$(normalize_category_name "rule" "$item")"
        ;;
    esac
    validate_identifier "$item" "$label" "$subcmd"

    found="false"
    if (( ${#unique_items[@]} > 0 )); then
      for existing in "${unique_items[@]}"; do
        if [[ "$existing" == "$item" ]]; then
          found="true"
          break
        fi
      done
    fi
    if [[ "$found" == "false" ]]; then
      unique_items+=("$item")
    fi
  done

  printf "%s\n" "${unique_items[@]}"
}

##
# AI_AGENT_CUSTOMIZATION_HOME 최상위 루트 디렉토리를 확인하고 반환합니다.
#
# @param $1 {string} CLI '--home' 옵션으로 전달된 경로 (빈 문자열 가능)
# @param $2 {string} 현재 서브커맨드 이름
#
# @return 최상위 루트 디렉토리 경로 출력
##
resolve_asr_home() {
  local cli_home="${1:-}"
  local subcmd="${2:-}"
  local effective_home=""

  if [[ -n "$cli_home" ]]; then
    effective_home="$cli_home"
  elif [[ -n "${AI_AGENT_CUSTOMIZATION_HOME:-}" ]]; then
    effective_home="${AI_AGENT_CUSTOMIZATION_HOME}"
  else
    die "환경변수 'AI_AGENT_CUSTOMIZATION_HOME'이 설정되어 있지 않습니다. 환경변수를 설정하거나 '--home <경로>' 옵션을 지정해 주세요." "$LINENO" "$subcmd"
  fi

  if [[ "$effective_home" != "/" ]]; then
    effective_home="${effective_home%/}"
  fi

  printf "%s\n" "$effective_home"
}

##
# AI_AGENT_CUSTOMIZATION_HOME 루트 디렉토리와 에이전트 이름을 결합하여
# 에이전트 전용 루트 경로(${AI_AGENT_CUSTOMIZATION_HOME}/${agent})를 반환합니다.
#
# @param $1 {string} CLI '--home' 옵션으로 전달된 경로 (빈 문자열 가능)
# @param $2 {string} 정규화된 에이전트 이름 (antigravity | claude | codex)
# @param $3 {string} 현재 서브커맨드 이름
#
# @return 에이전트 전용 루트 디렉토리 경로 출력
##
resolve_agent_home() {
  local cli_home="${1:-}"
  local agent="${2:-}"
  local subcmd="${3:-}"

  [[ -n "$agent" ]] || die "필수 옵션 '--agent'가 누락되었습니다. (antigravity | agy | claude | codex)" "$LINENO" "$subcmd"

  local base_home
  base_home="$(resolve_asr_home "$cli_home" "$subcmd")"

  printf "%s/%s\n" "$base_home" "$agent"
}

##
# 사용자에게 [y/n] 확인 프롬프트를 출력하고 응답을 검증합니다.
# 'y' 또는 'Y'만 진행(0 반환)하며, 'n', 'N' 또는 엔터(빈 값) 입력 시 1을 반환합니다.
#
# @param $1 {string} 프롬프트 메시지 (기본값: "삭제를 진행하시겠습니까? [y/n]: ")
#
# @return 0 (동의), 1 (거부/취소)
##
confirm_yes_no() {
  local prompt_msg="${1:-삭제를 진행하시겠습니까? [y/n]: }"
  local answer=""
  read -r -p "$prompt_msg" answer
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    return 0
  fi
  return 1
}

##
# 해당 에이전트의 전체 스킬 카테고리(skills/*/<skills_subpath>/*)를 탐색하여
# 동일한 스킬 이름(디렉토리명 또는 SKILL.md frontmatter의 name 속성)이 이미 사용 중인지 검증합니다.
#
# @param $1 {string} 에이전트 루트 경로 (agent_home)
# @param $2 {string} 정규화된 에이전트 이름 (antigravity | claude | codex)
# @param $3 {string} 검증할 스킬 이름 (target_name)
# @param $4 {string} 생성하려는 논리 카테고리 이름 (target_category)
# @param $5 {string} 강제 덮어쓰기 여부 (force: true | false)
#
# @return 중복이 없으면 0, 이미 사용 중이면 에러 메시지 출력 후 종료(die)
##
validate_skill_name_unique() {
  local agent_home="$1"
  local agent="$2"
  local target_name="$3"
  local target_category="$4"
  local force="${5:-false}"

  local skills_root="${agent_home}/skills"
  [[ -d "$skills_root" ]] || return 0

  local skills_subpath
  skills_subpath="$(get_skills_subpath "$agent")"

  local cat_dir existing_cat_dir existing_logical_cat entry existing_dir_name skill_md fm_name
  for cat_dir in "${skills_root}"/*; do
    [[ -d "$cat_dir" ]] || continue
    existing_cat_dir="$(basename "$cat_dir")"
    existing_logical_cat="$(normalize_category_name "skill" "$existing_cat_dir")"
    [[ -d "${cat_dir}/${skills_subpath}" ]] || continue

    for entry in "${cat_dir}/${skills_subpath}"/*; do
      [[ -e "$entry" || -L "$entry" ]] || continue
      existing_dir_name="$(basename "$entry")"

      # 1) 스킬 디렉토리(또는 심볼릭 링크) 이름이 동일한 경우
      if [[ "$existing_dir_name" == "$target_name" ]]; then
        if [[ "$existing_logical_cat" == "$target_category" && "$force" == "true" ]]; then
          continue
        fi
        die "[${agent}] 스킬 이름 '${target_name}'은(는) 이미 사용 중입니다. (카테고리: ${existing_logical_cat}, 경로: ${entry})" "$LINENO" "create"
      fi

      # 2) SKILL.md 파일 내 YAML Frontmatter의 'name:' 필드값이 동일한 경우
      skill_md=""
      if [[ -f "${entry}/SKILL.md" ]]; then
        skill_md="${entry}/SKILL.md"
      elif [[ -f "${entry}/SKILL.MD" ]]; then
        skill_md="${entry}/SKILL.MD"
      fi

      if [[ -n "$skill_md" ]]; then
        fm_name="$(awk '
          NR == 1 && $0 == "---" { in_fm = 1; next }
          in_fm && $0 == "---" { exit }
          in_fm && $0 ~ /^[[:space:]]*name:[[:space:]]*/ {
            sub(/^[[:space:]]*name:[[:space:]]*/, "", $0)
            sub(/[[:space:]]*$/, "", $0)
            gsub(/^["'\'']|["'\'']$/, "", $0)
            print $0
            exit
          }
        ' "$skill_md" 2>/dev/null || true)"

        if [[ -n "$fm_name" && "$fm_name" == "$target_name" ]]; then
          if [[ "$existing_logical_cat" == "$target_category" && "$force" == "true" ]]; then
            continue
          fi
          die "[${agent}] 스킬 이름 '${target_name}'은(는) 이미 사용 중입니다. (카테고리: ${existing_logical_cat}, SKILL.md 내 name 속성 일치: ${skill_md})" "$LINENO" "create"
        fi
      fi
    done
  done
}

##
# 에이전트별 Skill 템플릿 및 참조 디렉토리를 생성합니다.
#
# @param $1 {string} 정규화된 에이전트 이름 (antigravity | claude | codex)
# @param $2 {string} 에이전트 루트 경로 (agent_home)
# @param $3 {string} 논리 카테고리명 (category)
# @param $4 {string} 물리 카테고리 디렉토리명 (phys_cat)
# @param $5 {string} 스킬 이름 (name)
#
# @return 0
##
create_skill_for_agent() {
  local agent="$1"
  local agent_home="$2"
  local category="$3"
  local phys_cat="$4"
  local name="$5"

  local skills_subpath
  skills_subpath="$(get_skills_subpath "$agent")"
  local skill_dir="${agent_home}/skills/${phys_cat}/${skills_subpath}/${name}"
  local skill_file="${skill_dir}/SKILL.md"

  if [[ -L "$skill_dir" ]]; then
    rm -f "$skill_dir"
  fi

  case "$agent" in
    antigravity)
      mkdir -p "${skill_dir}/scripts" "${skill_dir}/templates" "${skill_dir}/references"
      cat <<EOF > "$skill_file"
---
# [필수] 스킬 고유 식별자 (1~5단어, 최대 64자, 영문 소문자/숫자/하이픈(-)만 허용, 시작/끝 하이픈 금지, 디렉토리명과 일치 권장)
name: ${name}

# [필수] 스킬의 핵심 트리거 역할 (최대 1024자 이내)
# 스킬의 기능(What)뿐 아니라 어떤 상황/사용자 발화에서 트리거되어야 하는지(When to trigger)를 능동적 키워드로 명시하십시오.
description: >-
  ${name} 스킬의 핵심 기능을 수행합니다. 사용자가 ${name} 관련 작업이나 처리를 요청할 때 이 스킬을 활성화하십시오.

# [선택] 스킬 정의의 변경 내역 및 호환성 관리용 시맨틱 버전 (기본값 없음 - 필요 시 주석 해제 후 작성)
# version: 1.0.0

# [선택] 스킬 작성자 및 관리 주체 정보 (기본값 없음 - 필요 시 주석 해제 후 작성)
# author: youre-mail@your-company.tld (tld: Top Level Domain)

# [선택] 카테고리 분류용 태그 목록 (기본값 없음 - 필요 시 주석 해제 후 작성)
# tags: [${category}]
---

# ${name}

