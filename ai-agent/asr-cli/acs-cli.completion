# =======================================
# @author : parkjunhong77@gmail.com
# @title : asr-cli: AI-Agent Customization System CLI bash completion
# @license : Apache License 2.0
# @since : 2026-10-28
# @desc : support RHEL 8+, Oracle Linux 8+, Ubuntu 20.04+, RockyOS 8+, CentOS 7+
# @installation :
# 1. insert 'source <path>/asr-cli.completion' into ~/.bashrc or ~/.bash_profile for a personal usage.
# 2. copy the completion file to /usr/share/bash-completion/completions/asr-cli (1st) or /etc/bash_completion.d/asr-cli.completion (2nd) for all users.
# =======================================

# =======================================
# [Bash Completion Parameter Description]
# 1. COMP_WORDS: an array containing all individual words in the current command line
#    (현재 커맨드 라인에 입력된 단어들의 배열)
# 2. COMP_CWORD: an index of the word containing the current cursor position
#    (현재 커서가 위치한 단어의 인덱스)
# 3. COMP_LINE: the current command line string
#    (현재까지 커맨드 라인에 입력된 전체 문자열)
# 4. COMPREPLY: an array variable from which Bash reads the possible completions
#    (bash completion이 제안할 단어들의 배열)
#
# Arguments of completion function:
# - $1: name of the command whose arguments are being completed (명령의 이름)
# - $2: word being completed (현재 커서에서 완성하려고 하는 단어)
# - $3: word preceding the word being completed (현재 완성하려는 단어의 바로 이전 단어)
# =======================================

##
# 현재 커맨드 라인에 지정된 '--home' 값 또는 환경변수 AI_AGENT_CUSTOMIZATION_HOME 최상위 경로를 반환합니다.
#
# @return 유효한 최상위 루트 디렉토리 경로 출력 (미설정 시 빈 문자열)
##
_acs_cli_get_base_home() {
  local cli_home=""
  local i tok
  for (( i=1; i < ${#COMP_WORDS[@]}; i++ )); do
    (( i != COMP_CWORD )) || continue
    tok="${COMP_WORDS[i]}"
    if [[ "$tok" == "--home" && $((i + 1)) -lt ${#COMP_WORDS[@]} ]]; then
      cli_home="${COMP_WORDS[i+1]}"
    elif [[ "$tok" == --home=* ]]; then
      cli_home="${tok#--home=}"
    fi
  done

  if [[ -n "$cli_home" ]]; then
    printf "%s\n" "${cli_home%/}"
  elif [[ -n "${AI_AGENT_CUSTOMIZATION_HOME:-}" ]]; then
    printf "%s\n" "${AI_AGENT_CUSTOMIZATION_HOME%/}"
  fi
}

##
# 현재 커맨드 라인에 명시적으로 지정된 '--agent' 값을 확인하여 정규화된 에이전트 이름(antigravity | claude | codex)을 반환합니다.
# '--agent'가 아직 입력되지 않은 경우 빈 문자열을 반환합니다.
#
# @return 정규화된 에이전트 디렉토리명 (antigravity | claude | codex), 미지정 시 빈 문자열, 잘못된 값이면 "INVALID"
##
_acs_cli_get_explicit_agent() {
  local raw_agent=""
  local i tok
  for (( i=1; i < ${#COMP_WORDS[@]}; i++ )); do
    (( i != COMP_CWORD )) || continue
    tok="${COMP_WORDS[i]}"
    if [[ "$tok" == "--agent" && $((i + 1)) -lt ${#COMP_WORDS[@]} ]]; then
      raw_agent="${COMP_WORDS[i+1]}"
    elif [[ "$tok" == --agent=* ]]; then
      raw_agent="${tok#--agent=}"
    fi
  done

  case "$raw_agent" in
    "")
      printf "\n"
      ;;
    antigravity|agy)
      printf "antigravity\n"
      ;;
    claude)
      printf "claude\n"
      ;;
    codex)
      printf "codex\n"
      ;;
    *)
      printf "INVALID\n"
      ;;
  esac
}

##
# 서브커맨드 문맥에 따라 탐색 대상 에이전트 목록을 반환합니다.
# - '--agent'가 명시된 경우: 해당 에이전트만 반환
# - '--agent'가 생략된 경우:
#   * list 명령어: 존재하는 모든 에이전트(antigravity, claude, codex) 반환
#   * create / remove / add 명령어: 기본값 'antigravity' 반환
#
# @param $1 {string} 서브커맨드 이름 (add | create | list | remove)
#
# @return 줄바꿈으로 구분된 에이전트 이름 목록
##
_acs_cli_get_target_agents() {
  local subcmd="${1:-}"
  local explicit_agent
  explicit_agent="$(_acs_cli_get_explicit_agent)"

  if [[ "$explicit_agent" == "INVALID" ]]; then
    return 0
  elif [[ -n "$explicit_agent" ]]; then
    printf "%s\n" "$explicit_agent"
    return 0
  fi

  if [[ "$subcmd" == "list" ]]; then
    local base_home
    base_home="$(_acs_cli_get_base_home)"
    [[ -n "$base_home" && -d "$base_home" ]] || return 0
    local ag
    for ag in antigravity claude codex; do
      if [[ -d "${base_home}/${ag}" ]]; then
        printf "%s\n" "$ag"
      fi
    done
  else
    printf "antigravity\n"
  fi
}

##
# 에이전트별 스킬 하위 상대 경로를 반환합니다.
#
# @param $1 {string} 정규화된 에이전트 이름 (antigravity | claude | codex)
#
# @return .agents/skills | .claude/skills
##
_acs_cli_get_skills_subpath() {
  local agent="$1"
  if [[ "$agent" == "claude" ]]; then
    printf ".claude/skills\n"
  else
    printf ".agents/skills\n"
  fi
}

##
# 에이전트별 규칙 하위 상대 경로를 반환합니다.
#
# @param $1 {string} 정규화된 에이전트 이름 (antigravity | claude | codex)
#
# @return .agents/rules | .claude/rules | "" (codex)
##
_acs_cli_get_rules_subpath() {
  local agent="$1"
  case "$agent" in
    antigravity)
      printf ".agents/rules\n"
      ;;
    claude)
      printf ".claude/rules\n"
      ;;
    codex)
      printf "\n"
      ;;
  esac
}

##
# 지정된 대상(skill | rule)에 존재하는 카테고리 이름 목록을 'skill-', 'rule-' 접두사를 제외하고 조회합니다.
#
# @param $1 {string} 대상 종류 (skill | rule | all)
# @param $2 {string} 서브커맨드 이름 (add | create | list | remove)
#
# @return 줄바꿈으로 구분된 논리 카테고리 이름 목록 (예: my-category)
##
_acs_cli_get_categories() {
  local target="${1:-all}"
  local subcmd="${2:-}"
  local base_home
  base_home="$(_acs_cli_get_base_home)"
  [[ -n "$base_home" && -d "$base_home" ]] || return 0

  local -a cats=()
  local agent agent_home dir bname

  while IFS= read -r agent; do
    [[ -n "$agent" ]] || continue
    agent_home="${base_home}/${agent}"
    [[ -d "$agent_home" ]] || continue

    if [[ "$target" == "skill" || "$target" == "all" ]]; then
      if [[ -d "${agent_home}/skills" ]]; then
        for dir in "${agent_home}/skills"/*; do
          [[ -d "$dir" ]] || continue
          bname="$(basename "$dir")"
          cats+=("${bname#skill-}")
        done
      fi
    fi

    if [[ "$target" == "rule" || "$target" == "all" ]]; then
      if [[ -d "${agent_home}/rules" ]]; then
        for dir in "${agent_home}/rules"/*; do
          [[ -d "$dir" ]] || continue
          bname="$(basename "$dir")"
          cats+=("${bname#rule-}")
        done
      fi
    fi
  done < <(_acs_cli_get_target_agents "$subcmd")

  if (( ${#cats[@]} > 0 )); then
    printf "%s\n" "${cats[@]}" | sort -u
  fi
}

##
# 특정 카테고리 내에 존재하는 스킬 또는 규칙의 이름 목록을 조회합니다. (remove, list 용)
#
# @param $1 {string} 대상 종류 (skill | rule)
# @param $2 {string} 논리 카테고리 이름 (예: my-category)
# @param $3 {string} 서브커맨드 이름 (remove | list)
#
# @return 줄바꿈으로 구분된 스킬/규칙 이름 목록
##
_acs_cli_get_names_in_category() {
  local target="$1"
  local category="$2"
  local subcmd="${3:-}"
  local base_home
  base_home="$(_acs_cli_get_base_home)"
  [[ -n "$base_home" && -d "$base_home" && -n "$category" ]] || return 0

  local -a names=()
  local agent agent_home entry bname

  while IFS= read -r agent; do
    [[ -n "$agent" ]] || continue
    agent_home="${base_home}/${agent}"
    [[ -d "$agent_home" ]] || continue

    if [[ "$target" == "skill" ]]; then
      local skills_subpath
      skills_subpath="$(_acs_cli_get_skills_subpath "$agent")"
      local logical_cat="${category#skill-}"
      local skills_dir="${agent_home}/skills/skill-${logical_cat}/${skills_subpath}"
      if [[ ! -d "$skills_dir" && -d "${agent_home}/skills/${logical_cat}/${skills_subpath}" ]]; then
        skills_dir="${agent_home}/skills/${logical_cat}/${skills_subpath}"
      fi
      if [[ -d "$skills_dir" ]]; then
        for entry in "${skills_dir}"/*; do
          [[ -e "$entry" || -L "$entry" ]] || continue
          names+=("$(basename "$entry")")
        done
      fi
    elif [[ "$target" == "rule" ]]; then
      local logical_cat="${category#rule-}"
      local cat_dir="${agent_home}/rules/rule-${logical_cat}"
      if [[ ! -d "$cat_dir" && -d "${agent_home}/rules/${logical_cat}" ]]; then
        cat_dir="${agent_home}/rules/${logical_cat}"
      fi

      if [[ "$agent" == "codex" ]]; then
        if [[ -d "$cat_dir" ]]; then
          for entry in "${cat_dir}"/*; do
            [[ -d "$entry" || -L "$entry" ]] || continue
            names+=("$(basename "$entry")")
          done
        fi
      else
        local rules_subpath
        rules_subpath="$(_acs_cli_get_rules_subpath "$agent")"
        local rules_dir="${cat_dir}/${rules_subpath}"
        if [[ -d "$rules_dir" ]]; then
          for entry in "${rules_dir}"/*; do
            [[ -e "$entry" || -L "$entry" ]] || continue
            bname="$(basename "$entry")"
            if [[ "$bname" == *.md ]]; then
              names+=("${bname%.md}")
            elif [[ "$bname" == *.MD ]]; then
              names+=("${bname%.MD}")
            fi
          done
        fi
      fi
    fi
  done < <(_acs_cli_get_target_agents "$subcmd")

  if (( ${#names[@]} > 0 )); then
    printf "%s\n" "${names[@]}" | sort -u
  fi
}

##
# 콤마(,)로 구분된 다중 입력('<입력>,<입력>') 자동완성을 수행합니다.
# 이미 앞부분에 입력된 항목은 추천 목록에서 자동으로 제외합니다.
#
# @param $1 {string} 줄바꿈으로 구분된 전체 후보 목록 문자열
# @param $2 {string} 현재 입력 중인 값 ($cur 또는 값 부분)
# @param $3 {string} 접두사 (기본값: '', '--category=*' 등 인라인 완성 시 사용)
#
# @return COMPREPLY 배열 설정
##
_acs_cli_complete_csv() {
  local candidates_str="$1"
  local cur_val="$2"
  local opt_prefix="${3:-}"

  [[ -n "$candidates_str" ]] || return 0

  local candidate
  if [[ "$cur_val" == *,* ]]; then
    local already_prefix="${cur_val%,*}"
    local last_part="${cur_val##*,}"

    local IFS=','
    local -a used_items=()
    read -r -a used_items <<< "$already_prefix"

    local used is_used
    while IFS= read -r candidate; do
      [[ -n "$candidate" ]] || continue
      is_used="false"
      if (( ${#used_items[@]} > 0 )); then
        for used in "${used_items[@]}"; do
          if [[ "$candidate" == "$used" ]]; then
            is_used="true"
            break
          fi
        done
      fi
      [[ "$is_used" == "false" ]] || continue

      if [[ "$candidate" == "$last_part"* ]]; then
        COMPREPLY+=("${opt_prefix}${already_prefix},${candidate}")
      fi
    done <<< "$candidates_str"
  else
    while IFS= read -r candidate; do
      [[ -n "$candidate" ]] && COMPREPLY+=("${opt_prefix}${candidate}")
    done < <(compgen -W "$candidates_str" -- "$cur_val")
  fi
}

##
# 'add' 명령어의 '--name' 자동완성을 처리합니다.
# - 후보 추천은 'skill-', 'rule-' 접두사가 제외된 '{category}/{name}' 형태로 표시합니다. (현재 대상 카테고리는 제외)
# - 후보가 1개로 확정(선택)되면 해당 항목의 **전체 파일/디렉토리 경로**로 COMPREPLY를 설정합니다.
#
# @param $1 {string} 대상 종류 (skill | rule)
# @param $2 {string} 심볼릭 링크가 생성될 대상 카테고리 (자기 자신 제외용)
# @param $3 {string} 현재 입력 중인 단어 ($cur 또는 값 부분)
# @param $4 {string} 접두사 (기본값: '', '--name=*' 형태일 때 '--name=')
#
# @return COMPREPLY 배열 설정
##
_acs_cli_complete_add_name() {
  local target="$1"
  local exclude_cat="$2"
  local cur_val="$3"
  local prefix="${4:-}"

  local base_home
  base_home="$(_acs_cli_get_base_home)"
  local agent
  agent="$(_acs_cli_get_target_agents "add")"
  [[ -n "$base_home" && -n "$agent" ]] || return 0

  local agent_home="${base_home}/${agent}"
  [[ -d "$agent_home" ]] || return 0

  local -a short_keys=()
  local -a full_paths=()
  local cat_dir dir_bname src_logical_cat entry bname rule_name

  if [[ "$target" == "skill" ]]; then
    local skills_subpath
    skills_subpath="$(_acs_cli_get_skills_subpath "$agent")"
    local exclude_logical="${exclude_cat#skill-}"
    local skills_root="${agent_home}/skills"
    if [[ -d "$skills_root" ]]; then
      for cat_dir in "${skills_root}"/*; do
        [[ -d "$cat_dir" ]] || continue
        dir_bname="$(basename "$cat_dir")"
        src_logical_cat="${dir_bname#skill-}"
        [[ "$src_logical_cat" != "$exclude_logical" ]] || continue
        [[ -d "${cat_dir}/${skills_subpath}" ]] || continue

        for entry in "${cat_dir}/${skills_subpath}"/*; do
          [[ -e "$entry" || -L "$entry" ]] || continue
          bname="$(basename "$entry")"
          short_keys+=("${src_logical_cat}/${bname}")
          full_paths+=("${cat_dir}/${skills_subpath}/${bname}")
        done
      done
    fi
  elif [[ "$target" == "rule" ]]; then
    local exclude_logical="${exclude_cat#rule-}"
    local rules_root="${agent_home}/rules"
    if [[ -d "$rules_root" ]]; then
      if [[ "$agent" == "codex" ]]; then
        for cat_dir in "${rules_root}"/*; do
          [[ -d "$cat_dir" ]] || continue
          dir_bname="$(basename "$cat_dir")"
          src_logical_cat="${dir_bname#rule-}"
          [[ "$src_logical_cat" != "$exclude_logical" ]] || continue

          for entry in "${cat_dir}"/*; do
            [[ -d "$entry" || -L "$entry" ]] || continue
            bname="$(basename "$entry")"
            short_keys+=("${src_logical_cat}/${bname}")
            full_paths+=("${cat_dir}/${bname}")
          done
        done
      else
        local rules_subpath
        rules_subpath="$(_acs_cli_get_rules_subpath "$agent")"
        for cat_dir in "${rules_root}"/*; do
          [[ -d "$cat_dir" ]] || continue
          dir_bname="$(basename "$cat_dir")"
          src_logical_cat="${dir_bname#rule-}"
          [[ "$src_logical_cat" != "$exclude_logical" ]] || continue
          [[ -d "${cat_dir}/${rules_subpath}" ]] || continue

          for entry in "${cat_dir}/${rules_subpath}"/*; do
            [[ -e "$entry" || -L "$entry" ]] || continue
            bname="$(basename "$entry")"
            if [[ "$bname" == *.md ]]; then
              rule_name="${bname%.md}"
            elif [[ "$bname" == *.MD ]]; then
              rule_name="${bname%.MD}"
            else
              continue
            fi
            short_keys+=("${src_logical_cat}/${rule_name}")
            full_paths+=("${cat_dir}/${rules_subpath}/${bname}")
          done
        done
      fi
    fi
  fi

  local total="${#short_keys[@]}"
  (( total > 0 )) || return 0

  # 이미 전체 경로('/...')로 치환된 상태에서 다시 <TAB>을 누른 경우 전체 경로 기준으로 매칭 유지
  if [[ "$cur_val" == /* ]]; then
    local idx
    for (( idx=0; idx < total; idx++ )); do
      if [[ "${full_paths[idx]}" == "$cur_val"* ]]; then
        COMPREPLY+=("${prefix}${full_paths[idx]}")
      fi
    done
    return 0
  fi

  # '{category}/{name}' 기준으로 현재 입력값과 매칭되는 후보 탐색
  local -a matched_indices=()
  local idx
  for (( idx=0; idx < total; idx++ )); do
    if [[ "${short_keys[idx]}" == "$cur_val"* ]]; then
      matched_indices+=("$idx")
    fi
  done

  if (( ${#matched_indices[@]} == 1 )); then
    # 단일 후보로 선택(확정)된 경우 전체 파일/디렉토리 경로로 즉시 치환
    local sel_idx="${matched_indices[0]}"
    COMPREPLY=( "${prefix}${full_paths[sel_idx]}" )
  elif (( ${#matched_indices[@]} > 1 )); then
    # 복수 후보가 존재하는 경우 '{category}/{name}' 형태로 추천 목록 제시
    local m_idx
    for m_idx in "${matched_indices[@]}"; do
      COMPREPLY+=("${prefix}${short_keys[m_idx]}")
    done
  fi
}

##
# 디렉토리 경로 자동 완성을 수행합니다. (--home 옵션용)
#
# @param $1 {string} 현재 입력 중인 경로 문자열
# @param $2 {string} 출력 접두사 (기본값: '', '--home=*' 완성 시 '--home=')
#
# @return COMPREPLY 배열 및 compopt 설정
##
_acs_cli_complete_dir() {
  local path_cur="$1"
  local opt_prefix="${2:-}"
  local candidate

  if [[ -z "$opt_prefix" ]]; then
    compopt -o filenames 2>/dev/null || true
    while IFS= read -r candidate; do
      [[ -n "$candidate" ]] && COMPREPLY+=("$candidate")
    done < <(compgen -d -- "$path_cur")
    if (( ${#COMPREPLY[@]} == 1 )) && [[ -d "${COMPREPLY[0]}" ]]; then
      compopt -o nospace 2>/dev/null || true
    fi
  else
    compopt -o nospace 2>/dev/null || true
    while IFS= read -r candidate; do
      [[ -n "$candidate" ]] || continue
      COMPREPLY+=("${opt_prefix}${candidate%/}/")
    done < <(compgen -d -- "$path_cur")
  fi
}

##
# asr-cli 명령어에 대한 단계별(Sequential State Machine) Bash 자동 완성 처리 함수
#
# 추천 순서 (단, '--agent'는 아직 입력되지 않은 경우 모든 단계의 위치에서 함께 제안됨):
#   asr-cli <TAB>
#     [add|create|list|remove] <TAB>
#       [skill|rule] <TAB>
#         --category <TAB>
#           {카테고리 입력} <TAB>
#             --name <TAB>
#               {이름 입력} <TAB>
#                 --force <TAB 지원 끝>
#         --help <TAB 지원 끝>
#
# @param $1 {string} 명령어 이름 (Command name)
# @param $2 {string} 현재 커서에서 완성 중인 단어 (Current word)
# @param $3 {string} 직전 단어 (Previous word)
#
# @return COMPREPLY 배열 설정
##
_acs_cli_completion() {
  local cur prev
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]:-}"
  prev="${COMP_WORDS[COMP_CWORD-1]:-}"

  local -a agents=("agy" "antigravity" "claude" "codex")
  local -a subcommands=("add" "create" "edit" "list" "remove")

  # COMP_CWORD 이전 토큰 전체를 스캔하여 현재까지 입력된 상태 파악
  local subcmd=""
  local active_target=""
  local has_agent="false"
  local agent_val=""
  local has_category="false"
  local category_val=""
  local has_name="false"
  local name_val=""
  local has_home="false"
  local has_force="false"
  local has_help="false"

  local i tok
  for (( i=1; i < COMP_CWORD; i++ )); do
    tok="${COMP_WORDS[i]}"
    case "$tok" in
      add|create|edit|list|remove)
        [[ -z "$subcmd" ]] && subcmd="$tok"
        ;;
      skill|rule)
        [[ -n "$subcmd" && -z "$active_target" ]] && active_target="$tok"
        ;;
      --help)
        has_help="true"
        ;;
      --force)
        has_force="true"
        ;;
      --agent)
        has_agent="true"
        if (( i + 1 < COMP_CWORD )); then
          agent_val="${COMP_WORDS[i+1]}"
          ((i++)) || true
        fi
        ;;
      --agent=*)
        has_agent="true"
        agent_val="${tok#--agent=}"
        ;;
      --home)
        has_home="true"
        ((i++)) || true
        ;;
      --home=*)
        has_home="true"
        ;;
      --category)
        has_category="true"
        if (( i + 1 < COMP_CWORD )); then
          category_val="${COMP_WORDS[i+1]}"
          ((i++)) || true
        fi
        ;;
      --category=*)
        has_category="true"
        category_val="${tok#--category=}"
        ;;
      --name)
        has_name="true"
        if (( i + 1 < COMP_CWORD )); then
          name_val="${COMP_WORDS[i+1]}"
          ((i++)) || true
        fi
        ;;
      --name=*)
        has_name="true"
        name_val="${tok#--name=}"
        ;;
    esac
  done

  # '--help' 또는 '--force'가 이미 입력된 경우: <TAB 지원 끝>
  if [[ "$has_help" == "true" || "$has_force" == "true" ]]; then
    return 0
  fi

  # '--agent'가 이미 입력되었는데 유효하지 않은 에이전트 값인 경우 더 이상 제안하지 않음
  if [[ "$has_agent" == "true" && -n "$agent_val" ]]; then
    case "$agent_val" in
      agy|antigravity|claude|codex)
        ;;
      *)
        return 0
        ;;
    esac
  fi

  # 1. 직전 단어(prev)가 값을 요구하는 옵션(--agent, --home, --category, --name)인 경우 값 완성
  case "$prev" in
    --agent)
      COMPREPLY=( $(compgen -W "${agents[*]}" -- "$cur") )
      return 0
      ;;
    --home)
      _acs_cli_complete_dir "$cur" ""
      return 0
      ;;
    --category)
      [[ -n "$subcmd" && -n "$active_target" ]] || return 0
      local cat_list
      cat_list="$(_acs_cli_get_categories "$active_target" "$subcmd")"
      if [[ "$subcmd" == "remove" || "$subcmd" == "list" ]]; then
        _acs_cli_complete_csv "$cat_list" "$cur" ""
      else
        COMPREPLY=( $(compgen -W "$cat_list" -- "$cur") )
      fi
      return 0
      ;;
    --name)
      [[ -n "$subcmd" && -n "$active_target" && -n "$category_val" ]] || return 0
      if [[ "$subcmd" == "add" ]]; then
        _acs_cli_complete_add_name "$active_target" "$category_val" "$cur" ""
      elif [[ "$subcmd" == "edit" ]]; then
        local name_list
        name_list="$(_acs_cli_get_names_in_category "$active_target" "$category_val" "$subcmd")"
        COMPREPLY=( $(compgen -W "$name_list" -- "$cur") )
      elif [[ "$subcmd" == "remove" || "$subcmd" == "list" ]]; then
        [[ "$category_val" != *,* ]] || return 0
        local name_list
        name_list="$(_acs_cli_get_names_in_category "$active_target" "$category_val" "$subcmd")"
        _acs_cli_complete_csv "$name_list" "$cur" ""
      fi
      return 0
      ;;
  esac

  # 2. '--옵션=값' 형태의 인라인 입력 처리
  case "$cur" in
    --agent=*)
      local agent_part="${cur#--agent=}"
      local a_cand
      while IFS= read -r a_cand; do
        [[ -n "$a_cand" ]] && COMPREPLY+=("--agent=${a_cand}")
      done < <(compgen -W "${agents[*]}" -- "$agent_part")
      return 0
      ;;
    --home=*)
      _acs_cli_complete_dir "${cur#--home=}" "--home="
      return 0
      ;;
    --category=*)
      [[ -n "$subcmd" && -n "$active_target" ]] || return 0
      local cat_part="${cur#--category=}"
      local cat_list
      cat_list="$(_acs_cli_get_categories "$active_target" "$subcmd")"
      if [[ "$subcmd" == "remove" || "$subcmd" == "list" ]]; then
        _acs_cli_complete_csv "$cat_list" "$cat_part" "--category="
      else
        local candidate
        while IFS= read -r candidate; do
          [[ -n "$candidate" ]] && COMPREPLY+=("--category=${candidate}")
        done < <(compgen -W "$cat_list" -- "$cat_part")
      fi
      return 0
      ;;
    --name=*)
      [[ -n "$subcmd" && -n "$active_target" && -n "$category_val" ]] || return 0
      local name_part="${cur#--name=}"
      if [[ "$subcmd" == "add" ]]; then
        _acs_cli_complete_add_name "$active_target" "$category_val" "$name_part" "--name="
      elif [[ "$subcmd" == "edit" ]]; then
        local name_list candidate
        name_list="$(_acs_cli_get_names_in_category "$active_target" "$category_val" "$subcmd")"
        while IFS= read -r candidate; do
          [[ -n "$candidate" ]] && COMPREPLY+=("--name=${candidate}")
        done < <(compgen -W "$name_list" -- "$name_part")
      elif [[ "$subcmd" == "remove" || "$subcmd" == "list" ]]; then
        [[ "$category_val" != *,* ]] || return 0
        local name_list
        name_list="$(_acs_cli_get_names_in_category "$active_target" "$category_val" "$subcmd")"
        _acs_cli_complete_csv "$name_list" "$name_part" "--name="
      fi
      return 0
      ;;
  esac

  # 3. 단계별(Step-by-Step) 위치 판단 및 후보 제안 ('--agent'는 미입력 시 모든 위치에서 함께 제안)
  local -a next_opts=()

  # (단계 A) 아직 서브커맨드(add|create|list|remove)가 입력되지 않은 상태
  if [[ -z "$subcmd" ]]; then
    if [[ "$cur" == -* ]]; then
      [[ "$has_agent" == "false" ]] && next_opts+=("--agent")
      next_opts+=("--help")
    else
      next_opts+=("${subcommands[@]}")
      [[ "$has_agent" == "false" ]] && next_opts+=("--agent")
    fi
    COMPREPLY=( $(compgen -W "${next_opts[*]}" -- "$cur") )
    return 0
  fi

  # (단계 B) 서브커맨드는 입력되었으나 아직 skill|rule이 선택되지 않은 상태
  if [[ -z "$active_target" ]]; then
    next_opts+=("skill" "rule" "--help")
    [[ "$has_agent" == "false" ]] && next_opts+=("--agent")
    COMPREPLY=( $(compgen -W "${next_opts[*]}" -- "$cur") )
    return 0
  fi

  # (단계 C) 아직 --category가 입력되지 않은 상태
  if [[ "$has_category" == "false" ]]; then
    next_opts+=("--category" "--help")
    [[ "$has_agent" == "false" ]] && next_opts+=("--agent")
    if [[ -z "${AI_AGENT_CUSTOMIZATION_HOME:-}" && "$has_home" == "false" ]]; then
      next_opts+=("--home")
    fi
    COMPREPLY=( $(compgen -W "${next_opts[*]}" -- "$cur") )
    return 0
  fi

  # (단계 D) --category 입력 완료 후, 아직 --name이 입력되지 않은 상태
  if [[ "$has_name" == "false" ]]; then
    if [[ "$category_val" == *,* ]]; then
      if [[ "$subcmd" == "remove" ]]; then
        next_opts+=("--force")
      fi
      [[ "$has_agent" == "false" ]] && next_opts+=("--agent")
      if (( ${#next_opts[@]} > 0 )); then
        COMPREPLY=( $(compgen -W "${next_opts[*]}" -- "$cur") )
      fi
      return 0
    fi

    next_opts+=("--name")
    if [[ "$subcmd" == "remove" ]]; then
      next_opts+=("--force")
    fi
    [[ "$has_agent" == "false" ]] && next_opts+=("--agent")
    COMPREPLY=( $(compgen -W "${next_opts[*]}" -- "$cur") )
    return 0
  fi

  # (단계 E) --category와 --name이 모두 입력 완료된 상태
  if [[ "$subcmd" != "edit" ]]; then
    next_opts+=("--force")
  fi
  [[ "$has_agent" == "false" ]] && next_opts+=("--agent")
  if (( ${#next_opts[@]} > 0 )); then
    COMPREPLY=( $(compgen -W "${next_opts[*]}" -- "$cur") )
  fi
  return 0
}

complete -F _acs_cli_completion asr-cli
