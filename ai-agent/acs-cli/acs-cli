##
# 에러 박스와 서브커맨드 도움말을 출력한 뒤 비정상 종료(exit 1)합니다.
#
# @param $1 {string} 오류 원인 메시지
# @param $2 {number} 오류 발생 행 번호
# @param $3 {string} 서브커맨드 이름 (선택)
#
# @return 없음 (exit 1)
##
die() {
  local cause="${1:-알 수 없는 오류가 발생했습니다.}"
  local line="${2:-unknown}"
  local subcmd="${3:-}"
  help "$cause" "$line" "$subcmd" >&2
  exit 1
}

##
# 경로를 절대 경로로 변환합니다. (심볼릭 링크를 풀지 않는 정규화 또는 실제 경로 해석)
#
# @param $1 {string} 대상 경로
# @param $2 {string} 모드 (resolve: 심볼릭 링크 최종 대상 해석, physical: 부모 디렉토리만 해석)
#
# @return 정규화된 절대 경로 문자열 출력
##
resolve_abs_path() {
  local target_path="$1"
  local mode="${2:-resolve}"

  if [[ "$mode" == "resolve" ]]; then
    if command -v realpath >/dev/null 2>&1; then
      realpath "$target_path"
      return 0
    elif command -v readlink >/dev/null 2>&1; then
      readlink -f "$target_path"
      return 0
    fi
  fi

  local dir_part base_part
  if [[ -d "$target_path" ]]; then
    (cd "$target_path" && pwd -P)
  else
    dir_part="$(dirname "$target_path")"
    base_part="$(basename "$target_path")"
    (cd "$dir_part" && printf "%s/%s\n" "$(pwd -P)" "$base_part")
  fi
}

##
# 카테고리명 또는 항목 이름에 허용되지 않는 문자(/, .. 등)가 포함되어 있는지 검증합니다.
#
# @param $1 {string} 검증할 식별자 문자열
# @param $2 {string} 항목 라벨 (예: category, name)
# @param $3 {string} 서브커맨드 이름
#
# @return 유효하면 0, 유효하지 않으면 die 호출
##
validate_identifier() {
  local value="$1"
  local label="$2"
  local subcmd="$3"

  if [[ -z "$value" ]]; then
    die "'--${label}' 값이 비어 있습니다." "$LINENO" "$subcmd"
  fi
  if [[ "$value" == *"/"* || "$value" == "." || "$value" == ".." ]]; then
    die "'--${label}' 값에는 경로 구분자('/')나 상대 경로('.', '..')를 사용할 수 없습니다: ${value}" "$LINENO" "$subcmd"
  fi
}

##
# 규칙(rule) 이름에서 .md 또는 .MD 확장자가 포함되어 있으면 제거하여 정규화합니다.
#
# @param $1 {string} 원본 이름 문자열
#
# @return 확장자가 제거된 이름 출력
##
normalize_rule_name() {
  local raw_name="$1"
  if [[ "$raw_name" == *.md ]]; then
    printf "%s\n" "${raw_name%.md}"
  elif [[ "$raw_name" == *.MD ]]; then
    printf "%s\n" "${raw_name%.MD}"
  else
    printf "%s\n" "$raw_name"
  fi
}

##
# AI_AGENT_CUSTOMIZATION_HOME 루트 디렉토리를 확인하고 반환합니다.
#
# @param $1 {string} CLI '--home' 옵션으로 전달된 경로 (빈 문자열 가능)
# @param $2 {string} 현재 서브커맨드 이름
#
# @return 유효한 루트 디렉토리 절대 경로 출력
##
resolve_acs_home() {
  local cli_home="${1:-}"
  local subcmd="${2:-}"
  local effective_home=""

  if [[ -n "$cli_home" ]]; then
    effective_home="$cli_home"
  elif [[ -n "${AI_AGENT_CUSTOMIZATION_HOME:-}" ]]; then
    effective_home="${AI_AGENT_CUSTOMIZATION_HOME}"
  else
    die "환경변수 'AI_AGENT_CUSTOMIZATION_HOME'이 설정되어 있지 않습니다. 환경변수를 설정하거나 '--home <경로>' 옵션을 지정해 주세요." "$LINENO" "$subcmd"
  fi

  # 끝에 붙은 슬래시 제거 (루트 '/' 제외)
  if [[ "$effective_home" != "/" ]]; then
    effective_home="${effective_home%/}"
  fi

  printf "%s\n" "$effective_home"
}

##
# 새로운 스킬(Skill) 또는 규칙(Rule)을 생성합니다.
#
# @param $@ {array} create 서브커맨드 인자 목록
#
# @return 0 (성공 시)
##
cmd_create() {
  local target=""
  local category=""
  local name=""
  local cli_home=""
  local force="false"

  while (( $# > 0 )); do
    case "$1" in
      --help)
        help "" "" "create"
        return 0
        ;;
      skill|rule)
        if [[ -z "$target" ]]; then
          target="$1"
          shift
        else
          die "대상(skill|rule)이 중복 지정되었습니다: $1" "$LINENO" "create"
        fi
        ;;
      --category)
        [[ $# -ge 2 ]] || die "'--category' 옵션에 값이 필요합니다." "$LINENO" "create"
        category="$2"
        shift 2
        ;;
      --category=*)
        category="${1#--category=}"
        shift
        ;;
      --name)
        [[ $# -ge 2 ]] || die "'--name' 옵션에 값이 필요합니다." "$LINENO" "create"
        name="$2"
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        shift
        ;;
      --home)
        [[ $# -ge 2 ]] || die "'--home' 옵션에 경로가 필요합니다." "$LINENO" "create"
        cli_home="$2"
        shift 2
        ;;
      --home=*)
        cli_home="${1#--home=}"
        shift
        ;;
      --force)
        force="true"
        shift
        ;;
      -*)
        die "알 수 없는 옵션입니다: $1 (Long Option만 지원합니다)" "$LINENO" "create"
        ;;
      *)
        die "알 수 없는 인자입니다: $1" "$LINENO" "create"
        ;;
    esac
  done

  [[ -n "$target" ]] || die "생성할 대상('skill' 또는 'rule')을 지정해야 합니다." "$LINENO" "create"
  validate_identifier "$category" "category" "create"
  validate_identifier "$name" "name" "create"

  local acs_home
  acs_home="$(resolve_acs_home "$cli_home" "create")"

  if [[ "$target" == "skill" ]]; then
    local skill_dir="${acs_home}/skills/${category}/.agents/skills/${name}"
    local skill_file="${skill_dir}/SKILL.md"

    if [[ -e "$skill_dir" || -L "$skill_dir" ]]; then
      if [[ "$force" != "true" ]]; then
        die "이미 존재하는 스킬 경로입니다: ${skill_dir} (덮어쓰려면 '--force' 옵션을 사용하세요)" "$LINENO" "create"
      fi
      if [[ -L "$skill_dir" ]]; then
        rm -f "$skill_dir"
      fi
    fi

    mkdir -p "$skill_dir"
    cat <<EOF > "$skill_file"
---
name: ${name}
description: >-
  Describe what the ${name} skill does and when the agent should activate it.
---

# ${name}

Provide step-by-step instructions and guidelines for the **${name}** skill (Category: \`${category}\`).

## Instructions

1. Describe the workflow steps clearly.
2. Add helper scripts under \`scripts/\` or reference documents under \`references/\` if needed.
EOF

    echo "✅ [CREATE:SKILL] 스킬이 생성되었습니다."
    echo "   - 카테고리 : ${category}"
    echo "   - 스킬 이름: ${name}"
    echo "   - 스킬 폴더: ${skill_dir}"
    echo "   - 스킬 파일: ${skill_file}"

  elif [[ "$target" == "rule" ]]; then
    local rule_name
    rule_name="$(normalize_rule_name "$name")"
    validate_identifier "$rule_name" "name" "create"

    local rules_dir="${acs_home}/rules/${category}/.agents/rules"
    local rule_file="${rules_dir}/${rule_name}.md"

    if [[ -e "$rule_file" || -L "$rule_file" ]]; then
      if [[ "$force" != "true" ]]; then
        die "이미 존재하는 규칙 파일입니다: ${rule_file} (덮어쓰려면 '--force' 옵션을 사용하세요)" "$LINENO" "create"
      fi
      rm -f "$rule_file"
    fi

    mkdir -p "$rules_dir"
    cat <<EOF > "$rule_file"
# ${rule_name} Rule

Define the guidelines, coding standards, and constraints for **${rule_name}** (Category: \`${category}\`).

## Guidelines

- Specify mandatory rules and constraints here.
EOF

    echo "✅ [CREATE:RULE] 규칙이 생성되었습니다."
    echo "   - 카테고리 : ${category}"
    echo "   - 규칙 이름: ${rule_name}"
    echo "   - 규칙 파일: ${rule_file}"
  fi
}

##
