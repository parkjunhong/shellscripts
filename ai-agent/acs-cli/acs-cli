##
# 에러 박스와 서브커맨드 도움말을 출력한 뒤 비정상 종료(exit 1)합니다.
#
# @param $1 {string} 오류 원인 메시지
# @param $2 {number} 오류 발생 행 번호
# @param $3 {string} 서브커맨드 이름 (선택)
#
# @return 없음 (exit 1)
##
die() {
  local cause="${1:-알 수 없는 오류가 발생했습니다.}"
  local line="${2:-unknown}"
  local subcmd="${3:-}"
  help "$cause" "$line" "$subcmd" >&2
  exit 1
}

##
# 경로를 절대 경로로 변환합니다.
#
# @param $1 {string} 대상 경로
# @param $2 {string} 모드 (resolve: 심볼릭 링크 최종 대상 해석, physical: 부모 디렉토리만 해석)
#
# @return 정규화된 절대 경로 문자열 출력
##
resolve_abs_path() {
  local target_path="$1"
  local mode="${2:-resolve}"

  if [[ "$mode" == "resolve" ]]; then
    if command -v realpath >/dev/null 2>&1; then
      realpath "$target_path"
      return 0
    elif command -v readlink >/dev/null 2>&1; then
      readlink -f "$target_path"
      return 0
    fi
  fi

  local dir_part base_part
  if [[ -d "$target_path" ]]; then
    (cd "$target_path" && pwd -P)
  else
    dir_part="$(dirname "$target_path")"
    base_part="$(basename "$target_path")"
    (cd "$dir_part" && printf "%s/%s\n" "$(pwd -P)" "$base_part")
  fi
}

##
# 카테고리명 또는 항목 이름에 허용되지 않는 문자(/, .. 등)가 포함되어 있는지 검증합니다.
#
# @param $1 {string} 검증할 식별자 문자열
# @param $2 {string} 항목 라벨 (예: category, name)
# @param $3 {string} 서브커맨드 이름
#
# @return 유효하면 0, 유효하지 않으면 die 호출
##
validate_identifier() {
  local value="$1"
  local label="$2"
  local subcmd="$3"

  if [[ -z "$value" ]]; then
    die "'--${label}' 값이 비어 있습니다." "$LINENO" "$subcmd"
  fi
  if [[ "$value" == *"/"* || "$value" == "." || "$value" == ".." ]]; then
    die "'--${label}' 값에는 경로 구분자('/')나 상대 경로('.', '..')를 사용할 수 없습니다: ${value}" "$LINENO" "$subcmd"
  fi
}

##
# 카테고리 이름에서 'skill-' 또는 'rule-' 접두사가 포함되어 있으면 제거하여 논리 카테고리명으로 정규화합니다.
#
# @param $1 {string} 대상 종류 (skill | rule)
# @param $2 {string} 입력된 카테고리 문자열
#
# @return 접두사가 제거된 논리 카테고리명 출력
##
normalize_category_name() {
  local kind="$1"
  local raw_cat="$2"

  if [[ "$kind" == "skill" && "$raw_cat" == skill-* ]]; then
    printf "%s\n" "${raw_cat#skill-}"
  elif [[ "$kind" == "rule" && "$raw_cat" == rule-* ]]; then
    printf "%s\n" "${raw_cat#rule-}"
  else
    printf "%s\n" "$raw_cat"
  fi
}

##
# 논리 카테고리명을 실제 디스크에 생성될 디렉토리명('skill-<category>' 또는 'rule-<category>')으로 변환합니다.
#
# @param $1 {string} 대상 종류 (skill | rule)
# @param $2 {string} 논리 카테고리명
#
# @return 실제 카테고리 디렉토리명 출력
##
to_physical_category_dir_name() {
  local kind="$1"
  local logical_cat
  logical_cat="$(normalize_category_name "$kind" "$2")"

  if [[ "$kind" == "skill" ]]; then
    printf "skill-%s\n" "$logical_cat"
  else
    printf "rule-%s\n" "$logical_cat"
  fi
}

##
# 규칙(rule) 이름에서 .md 또는 .MD 확장자가 포함되어 있으면 제거하여 정규화합니다.
#
# @param $1 {string} 원본 이름 문자열
#
# @return 확장자가 제거된 이름 출력
##
normalize_rule_name() {
  local raw_name="$1"
  if [[ "$raw_name" == *.md ]]; then
    printf "%s\n" "${raw_name%.md}"
  elif [[ "$raw_name" == *.MD ]]; then
    printf "%s\n" "${raw_name%.MD}"
  else
    printf "%s\n" "$raw_name"
  fi
}

##
# 콤마(,)로 구분된 문자열을 분리하고 검증하여 중복을 제거한 뒤 줄바꿈으로 출력합니다.
#
# @param $1 {string} 콤마로 구분된 입력 문자열
# @param $2 {string} 옵션 라벨 (category | name)
# @param $3 {string} 서브커맨드 이름
# @param $4 {string} 정규화 모드 ('rule-name' | 'skill-cat' | 'rule-cat' | '')
#
# @return 줄바꿈으로 구분된 고유 항목 목록
##
split_csv_unique() {
  local raw="$1"
  local label="$2"
  local subcmd="$3"
  local norm_mode="${4:-}"

  if [[ -z "$raw" ]]; then
    die "'--${label}' 값이 비어 있습니다." "$LINENO" "$subcmd"
  fi
  if [[ "$raw" == ,* || "$raw" == *, || "$raw" == *,,* ]]; then
    die "'--${label}' 값에 잘못된 콤마(,) 구분이 포함되어 있습니다: ${raw}" "$LINENO" "$subcmd"
  fi

  local IFS=','
  local -a parts=()
  read -r -a parts <<< "$raw"

  local -a unique_items=()
  local part item existing found
  for part in "${parts[@]}"; do
    item="$part"
    case "$norm_mode" in
      rule-name)
        item="$(normalize_rule_name "$item")"
        ;;
      skill-cat)
        item="$(normalize_category_name "skill" "$item")"
        ;;
      rule-cat)
        item="$(normalize_category_name "rule" "$item")"
        ;;
    esac
    validate_identifier "$item" "$label" "$subcmd"

    found="false"
    if (( ${#unique_items[@]} > 0 )); then
      for existing in "${unique_items[@]}"; do
        if [[ "$existing" == "$item" ]]; then
          found="true"
          break
        fi
      done
    fi
    if [[ "$found" == "false" ]]; then
      unique_items+=("$item")
    fi
  done

  printf "%s\n" "${unique_items[@]}"
}

##
# AI_AGENT_CUSTOMIZATION_HOME 루트 디렉토리를 확인하고 반환합니다.
#
# @param $1 {string} CLI '--home' 옵션으로 전달된 경로 (빈 문자열 가능)
# @param $2 {string} 현재 서브커맨드 이름
#
# @return 유효한 루트 디렉토리 경로 출력
##
resolve_acs_home() {
  local cli_home="${1:-}"
  local subcmd="${2:-}"
  local effective_home=""

  if [[ -n "$cli_home" ]]; then
    effective_home="$cli_home"
  elif [[ -n "${AI_AGENT_CUSTOMIZATION_HOME:-}" ]]; then
    effective_home="${AI_AGENT_CUSTOMIZATION_HOME}"
  else
    die "환경변수 'AI_AGENT_CUSTOMIZATION_HOME'이 설정되어 있지 않습니다. 환경변수를 설정하거나 '--home <경로>' 옵션을 지정해 주세요." "$LINENO" "$subcmd"
  fi

  if [[ "$effective_home" != "/" ]]; then
    effective_home="${effective_home%/}"
  fi

  printf "%s\n" "$effective_home"
}

##
# 사용자에게 [y/n] 확인 프롬프트를 출력하고 응답을 검증합니다.
# 'y' 또는 'Y'만 진행(0 반환)하며, 'n', 'N' 또는 엔터(빈 값) 입력 시 1을 반환합니다.
#
# @param $1 {string} 프롬프트 메시지 (기본값: "삭제를 진행하시겠습니까? [y/n]: ")
#
# @return 0 (동의), 1 (거부/취소)
##
confirm_yes_no() {
  local prompt_msg="${1:-삭제를 진행하시겠습니까? [y/n]: }"
  local answer=""
  read -r -p "$prompt_msg" answer
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    return 0
  fi
  return 1
}

##
# 전체 스킬 카테고리(skills/*/.agents/skills/*)를 탐색하여
# 동일한 스킬 이름(디렉토리명 또는 SKILL.md frontmatter의 name 속성)이 이미 사용 중인지 검증합니다.
# Antigravity 2.x에서는 서로 다른 카테고리에 동일 이름의 스킬이 존재하면 단 1개만 로딩되므로 전역 중복을 차단합니다.
#
# @param $1 {string} 루트 경로 (acs_home)
# @param $2 {string} 검증할 스킬 이름 (target_name)
# @param $3 {string} 생성하려는 논리 카테고리 이름 (target_category)
# @param $4 {string} 강제 덮어쓰기 여부 (force: true | false)
#
# @return 중복이 없으면 0, 이미 사용 중이면 에러 메시지 출력 후 종료(die)
##
validate_skill_name_unique() {
  local acs_home="$1"
  local target_name="$2"
  local target_category="$3"
  local force="${4:-false}"

  local skills_root="${acs_home}/skills"
  [[ -d "$skills_root" ]] || return 0

  local cat_dir existing_cat_dir existing_logical_cat entry existing_dir_name skill_md fm_name
  for cat_dir in "${skills_root}"/*; do
    [[ -d "$cat_dir" ]] || continue
    existing_cat_dir="$(basename "$cat_dir")"
    existing_logical_cat="$(normalize_category_name "skill" "$existing_cat_dir")"
    [[ -d "${cat_dir}/.agents/skills" ]] || continue

    for entry in "${cat_dir}/.agents/skills"/*; do
      [[ -e "$entry" || -L "$entry" ]] || continue
      existing_dir_name="$(basename "$entry")"

      # 1) 스킬 디렉토리(또는 심볼릭 링크) 이름이 동일한 경우
      if [[ "$existing_dir_name" == "$target_name" ]]; then
        if [[ "$existing_logical_cat" == "$target_category" && "$force" == "true" ]]; then
          continue
        fi
        die "스킬 이름 '${target_name}'은(는) 이미 사용 중입니다. (카테고리: ${existing_logical_cat}, 경로: ${entry})" "$LINENO" "create"
      fi

      # 2) SKILL.md 파일 내 YAML Frontmatter의 'name:' 필드값이 동일한 경우
      skill_md=""
      if [[ -f "${entry}/SKILL.md" ]]; then
        skill_md="${entry}/SKILL.md"
      elif [[ -f "${entry}/SKILL.MD" ]]; then
        skill_md="${entry}/SKILL.MD"
      fi

      if [[ -n "$skill_md" ]]; then
        fm_name="$(awk '
          NR == 1 && $0 == "---" { in_fm = 1; next }
          in_fm && $0 == "---" { exit }
          in_fm && $0 ~ /^[[:space:]]*name:[[:space:]]*/ {
            sub(/^[[:space:]]*name:[[:space:]]*/, "", $0)
            sub(/[[:space:]]*$/, "", $0)
            gsub(/^["'\'']|["'\'']$/, "", $0)
            print $0
            exit
          }
        ' "$skill_md" 2>/dev/null || true)"

        if [[ -n "$fm_name" && "$fm_name" == "$target_name" ]]; then
          if [[ "$existing_logical_cat" == "$target_category" && "$force" == "true" ]]; then
            continue
          fi
          die "스킬 이름 '${target_name}'은(는) 이미 사용 중입니다. (카테고리: ${existing_logical_cat}, SKILL.md 내 name 속성 일치: ${skill_md})" "$LINENO" "create"
        fi
      fi
    done
  done
}

##
# 새로운 스킬(Skill) 또는 규칙(Rule)을 생성합니다.
# 실제 생성되는 카테고리 디렉토리명은 'skill-<category>' 또는 'rule-<category>'가 됩니다.
#
# @param $@ {array} create 서브커맨드 인자 목록
#
# @return 0 (성공 시)
##
cmd_create() {
  local target=""
  local category=""
  local name=""
  local cli_home=""
  local force="false"

  while (( $# > 0 )); do
    case "$1" in
      --help)
        help "" "" "create"
        return 0
        ;;
      skill|rule)
        if [[ -z "$target" ]]; then
          target="$1"
          shift
        else
          die "대상(skill|rule)이 중복 지정되었습니다: $1" "$LINENO" "create"
        fi
        ;;
      --category)
        [[ $# -ge 2 ]] || die "'--category' 옵션에 값이 필요합니다." "$LINENO" "create"
        category="$2"
        shift 2
        ;;
      --category=*)
        category="${1#--category=}"
        shift
        ;;
      --name)
        [[ $# -ge 2 ]] || die "'--name' 옵션에 값이 필요합니다." "$LINENO" "create"
        name="$2"
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        shift
        ;;
      --home)
        [[ $# -ge 2 ]] || die "'--home' 옵션에 경로가 필요합니다." "$LINENO" "create"
        cli_home="$2"
        shift 2
        ;;
      --home=*)
        cli_home="${1#--home=}"
        shift
        ;;
      --force)
        force="true"
        shift
        ;;
      -*)
        die "알 수 없는 옵션입니다: $1 (Long Option만 지원합니다)" "$LINENO" "create"
        ;;
      *)
        die "알 수 없는 인자입니다: $1" "$LINENO" "create"
        ;;
    esac
  done

  [[ -n "$target" ]] || die "생성할 대상('skill' 또는 'rule')을 지정해야 합니다." "$LINENO" "create"
  category="$(normalize_category_name "$target" "$category")"
  validate_identifier "$category" "category" "create"
  validate_identifier "$name" "name" "create"

  local phys_cat
  phys_cat="$(to_physical_category_dir_name "$target" "$category")"

  local acs_home
  acs_home="$(resolve_acs_home "$cli_home" "create")"

  if [[ "$target" == "skill" ]]; then
    validate_skill_name_unique "$acs_home" "$name" "$category" "$force"

    local skill_dir="${acs_home}/skills/${phys_cat}/.agents/skills/${name}"
    local skill_file="${skill_dir}/SKILL.md"

    if [[ -L "$skill_dir" ]]; then
      rm -f "$skill_dir"
    fi

    mkdir -p "$skill_dir"
    cat <<EOF > "$skill_file"
---
name: ${name}
description: >-
  Describe what the ${name} skill does and when the agent should activate it.
---

# ${name}

Provide step-by-step instructions and guidelines for the **${name}** skill (Category: \`${category}\`).

## Instructions

1. Describe the workflow steps clearly.
2. Add helper scripts under \`scripts/\` or reference documents under \`references/\` if needed.
EOF

    echo "✅ [CREATE:SKILL] 스킬이 생성되었습니다."
    echo "   - 카테고리 : ${category} (${phys_cat})"
    echo "   - 스킬 이름: ${name}"
    echo "   - 스킬 폴더: ${skill_dir}"
    echo "   - 스킬 파일: ${skill_file}"

  elif [[ "$target" == "rule" ]]; then
    local rule_name
    rule_name="$(normalize_rule_name "$name")"
    validate_identifier "$rule_name" "name" "create"

    local rules_dir="${acs_home}/rules/${phys_cat}/.agents/rules"
    local rule_file="${rules_dir}/${rule_name}.md"

    if [[ -e "$rule_file" || -L "$rule_file" ]]; then
      if [[ "$force" != "true" ]]; then
        die "이미 존재하는 규칙 파일입니다: ${rule_file} (덮어쓰려면 '--force' 옵션을 사용하세요)" "$LINENO" "create"
      fi
      rm -f "$rule_file"
    fi

    mkdir -p "$rules_dir"
    cat <<EOF > "$rule_file"
---
trigger: always_on
---

# ${rule_name} Rule

Define the guidelines, coding standards, and constraints for **${rule_name}** (Category: \`${category}\`).

## Guidelines

- Specify mandatory rules and constraints here.
EOF

    echo "✅ [CREATE:RULE] 규칙이 생성되었습니다."
    echo "   - 카테고리 : ${category} (${phys_cat})"
    echo "   - 규칙 이름: ${rule_name}"
    echo "   - 규칙 파일: ${rule_file}"
  fi
}

##
# 기존 스킬(Skill) 또는 규칙(Rule)을 삭제하거나, 카테고리 전체를 삭제합니다.
# - '--category' 및 '--name' 모두 콤마(,)로 구분된 다중 입력을 지원합니다.
# - '--category'에 여러 카테고리가 지정된 경우 '--name'은 허용하지 않으며 복수 카테고리를 삭제합니다.
# - 다중 입력된 대상 정보를 별도 라인으로 출력하고 1회만 [y/n] 확인을 요청합니다.
#
# @param $@ {array} remove 서브커맨드 인자 목록
#
# @return 0 (성공 시)
##
cmd_remove() {
  local target=""
  local category=""
  local name=""
  local cli_home=""
  local force="false"

  while (( $# > 0 )); do
    case "$1" in
      --help)
        help "" "" "remove"
        return 0
        ;;
      skill|rule)
        if [[ -z "$target" ]]; then
          target="$1"
          shift
        else
          die "대상(skill|rule)이 중복 지정되었습니다: $1" "$LINENO" "remove"
        fi
        ;;
      --category)
        [[ $# -ge 2 ]] || die "'--category' 옵션에 값이 필요합니다." "$LINENO" "remove"
        category="$2"
        shift 2
        ;;
      --category=*)
        category="${1#--category=}"
        shift
        ;;
      --name)
        [[ $# -ge 2 ]] || die "'--name' 옵션에 값이 필요합니다." "$LINENO" "remove"
        name="$2"
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        shift
        ;;
      --home)
        [[ $# -ge 2 ]] || die "'--home' 옵션에 경로가 필요합니다." "$LINENO" "remove"
        cli_home="$2"
        shift 2
        ;;
      --home=*)
        cli_home="${1#--home=}"
        shift
        ;;
      --force)
        force="true"
        shift
        ;;
      -*)
        die "알 수 없는 옵션입니다: $1 (Long Option만 지원합니다)" "$LINENO" "remove"
        ;;
      *)
        die "알 수 없는 인자입니다: $1" "$LINENO" "remove"
        ;;
    esac
  done

  [[ -n "$target" ]] || die "삭제할 대상('skill' 또는 'rule')을 지정해야 합니다." "$LINENO" "remove"
  [[ -n "$category" ]] || die "'--category' 옵션 값이 비어 있습니다." "$LINENO" "remove"

  local cat_norm_mode="skill-cat"
  [[ "$target" == "rule" ]] && cat_norm_mode="rule-cat"

  local -a categories=()
  local item_line
  while IFS= read -r item_line; do
    [[ -n "$item_line" ]] && categories+=("$item_line")
  done < <(split_csv_unique "$category" "category" "remove" "$cat_norm_mode")

  if (( ${#categories[@]} > 1 )) && [[ -n "$name" ]]; then
    die "'--category'에 여러 카테고리를 지정한 경우 '--name' 옵션을 함께 사용할 수 없습니다." "$LINENO" "remove"
  fi

  local acs_home
  acs_home="$(resolve_acs_home "$cli_home" "remove")"

  local target_label="스킬"
  [[ "$target" == "rule" ]] && target_label="규칙"

  # 1. '--name'이 생략된 경우: 1개 또는 여러 개의 카테고리 자체 삭제
  if [[ -z "$name" ]]; then
    local cat phys_cat cat_dir
    for cat in "${categories[@]}"; do
      phys_cat="$(to_physical_category_dir_name "$target" "$cat")"
      if [[ "$target" == "skill" ]]; then
        cat_dir="${acs_home}/skills/${phys_cat}"
      else
        cat_dir="${acs_home}/rules/${phys_cat}"
      fi
      if [[ ! -d "$cat_dir" && ! -L "$cat_dir" ]]; then
        die "삭제할 카테고리가 존재하지 않습니다: ${cat_dir}" "$LINENO" "remove"
      fi
    done

    if [[ "$force" != "true" ]]; then
      echo "⚠️  다음 ${target_label} 카테고리(총 ${#categories[@]}개)를 삭제하려고 합니다:"
      local items_dir entry item_bname link_dest
      for cat in "${categories[@]}"; do
        phys_cat="$(to_physical_category_dir_name "$target" "$cat")"
        if [[ "$target" == "skill" ]]; then
          cat_dir="${acs_home}/skills/${phys_cat}"
          items_dir="${cat_dir}/.agents/skills"
        else
          cat_dir="${acs_home}/rules/${phys_cat}"
          items_dir="${cat_dir}/.agents/rules"
        fi

        local -a sub_items=()
        if [[ -d "$items_dir" ]]; then
          for entry in "${items_dir}"/*; do
            [[ -e "$entry" || -L "$entry" ]] || continue
            if [[ "$target" == "rule" ]]; then
              local bname
              bname="$(basename "$entry")"
              [[ "$bname" == *.md || "$bname" == *.MD ]] || continue
            fi
            sub_items+=("$entry")
          done
        fi

        echo "   - 카테고리 : ${cat} (${cat_dir})"
        if (( ${#sub_items[@]} > 0 )); then
          echo "     하위 ${target_label} 목록 (${#sub_items[@]}개):"
          for entry in "${sub_items[@]}"; do
            item_bname="$(basename "$entry")"
            if [[ -L "$entry" ]]; then
              link_dest="$(readlink "$entry" || true)"
              echo "       * ${item_bname} (심볼릭 링크 -> ${link_dest})"
            else
              echo "       * ${item_bname}"
            fi
          done
        else
          echo "     하위 ${target_label} 목록: (없음)"
        fi
      done

      if ! confirm_yes_no "삭제를 진행하시겠습니까? [y/n]: "; then
        echo "🚫 삭제 작업이 취소되었습니다."
        return 0
      fi
    fi

    for cat in "${categories[@]}"; do
      phys_cat="$(to_physical_category_dir_name "$target" "$cat")"
      if [[ "$target" == "skill" ]]; then
        cat_dir="${acs_home}/skills/${phys_cat}"
      else
        cat_dir="${acs_home}/rules/${phys_cat}"
      fi
      rm -rf "$cat_dir"
      echo "🗑️  [REMOVE:CATEGORY] '${cat}' 카테고리가 삭제되었습니다: ${cat_dir}"
    done
    return 0
  fi

  # 2. '--name'이 지정된 경우: 단일 카테고리 내 1개 또는 여러 개의 스킬/규칙 삭제
  local single_cat="${categories[0]}"
  local single_phys_cat
  single_phys_cat="$(to_physical_category_dir_name "$target" "$single_cat")"

  local -a names=()
  local norm_flag=""
  [[ "$target" == "rule" ]] && norm_flag="rule-name"

  while IFS= read -r item_line; do
    [[ -n "$item_line" ]] && names+=("$item_line")
  done < <(split_csv_unique "$name" "name" "remove" "$norm_flag")

  if [[ "$target" == "skill" ]]; then
    local sname skill_dir
    for sname in "${names[@]}"; do
      skill_dir="${acs_home}/skills/${single_phys_cat}/.agents/skills/${sname}"
      if [[ ! -e "$skill_dir" && ! -L "$skill_dir" ]]; then
        die "삭제할 스킬이 존재하지 않습니다: ${skill_dir}" "$LINENO" "remove"
      fi
    done

    if [[ "$force" != "true" ]]; then
      echo "⚠️  '${single_cat}' (${single_phys_cat}) 카테고리에서 다음 스킬(총 ${#names[@]}개)을 삭제하려고 합니다:"
      local item_type link_target
      for sname in "${names[@]}"; do
        skill_dir="${acs_home}/skills/${single_phys_cat}/.agents/skills/${sname}"
        item_type="일반 디렉토리 (원본 삭제)"
        if [[ -L "$skill_dir" ]]; then
          link_target="$(readlink "$skill_dir" || true)"
          item_type="심볼릭 링크 (원본 보존: ${link_target})"
        fi
        echo "   - ${sname} : ${skill_dir} [${item_type}]"
      done

      if ! confirm_yes_no "삭제를 진행하시겠습니까? [y/n]: "; then
        echo "🚫 삭제 작업이 취소되었습니다."
        return 0
      fi
    fi

    for sname in "${names[@]}"; do
      skill_dir="${acs_home}/skills/${single_phys_cat}/.agents/skills/${sname}"
      if [[ -L "$skill_dir" ]]; then
        rm -f "$skill_dir"
      else
        rm -rf "$skill_dir"
      fi
      echo "🗑️  [REMOVE:SKILL] 스킬이 삭제되었습니다: ${skill_dir}"
    done

    local category_dir="${acs_home}/skills/${single_phys_cat}"
    local skills_dir="${category_dir}/.agents/skills"
    local remaining_count=0
    local entry
    if [[ -d "$skills_dir" ]]; then
      for entry in "${skills_dir}"/*; do
        [[ -e "$entry" || -L "$entry" ]] || continue
        ((remaining_count++)) || true
      done
    fi
    if (( remaining_count == 0 )) && [[ -d "$category_dir" || -L "$category_dir" ]]; then
      rm -rf "$category_dir"
      echo "🗑️  [REMOVE:CATEGORY] '${single_cat}' 카테고리에 더 이상 스킬이 존재하지 않아 카테고리도 함께 삭제되었습니다: ${category_dir}"
    fi

  elif [[ "$target" == "rule" ]]; then
    local rname rule_file
    for rname in "${names[@]}"; do
      rule_file="${acs_home}/rules/${single_phys_cat}/.agents/rules/${rname}.md"
      if [[ ! -e "$rule_file" && ! -L "$rule_file" ]]; then
        die "삭제할 규칙 파일이 존재하지 않습니다: ${rule_file}" "$LINENO" "remove"
      fi
    done

    if [[ "$force" != "true" ]]; then
      echo "⚠️  '${single_cat}' (${single_phys_cat}) 카테고리에서 다음 규칙(총 ${#names[@]}개)을 삭제하려고 합니다:"
      local item_type link_target
      for rname in "${names[@]}"; do
        rule_file="${acs_home}/rules/${single_phys_cat}/.agents/rules/${rname}.md"
        item_type="일반 파일 (원본 삭제)"
        if [[ -L "$rule_file" ]]; then
          link_target="$(readlink "$rule_file" || true)"
          item_type="심볼릭 링크 (원본 보존: ${link_target})"
        fi
        echo "   - ${rname}.md : ${rule_file} [${item_type}]"
      done

      if ! confirm_yes_no "삭제를 진행하시겠습니까? [y/n]: "; then
        echo "🚫 삭제 작업이 취소되었습니다."
        return 0
      fi
    fi

    for rname in "${names[@]}"; do
      rule_file="${acs_home}/rules/${single_phys_cat}/.agents/rules/${rname}.md"
      rm -f "$rule_file"
      echo "🗑️  [REMOVE:RULE] 규칙이 삭제되었습니다: ${rule_file}"
    done

    local category_dir="${acs_home}/rules/${single_phys_cat}"
    local rules_dir="${category_dir}/.agents/rules"
    local remaining_count=0
    local entry bname
    if [[ -d "$rules_dir" ]]; then
      for entry in "${rules_dir}"/*; do
        [[ -e "$entry" || -L "$entry" ]] || continue
        bname="$(basename "$entry")"
        [[ "$bname" == *.md || "$bname" == *.MD ]] || continue
        ((remaining_count++)) || true
      done
    fi
    if (( remaining_count == 0 )) && [[ -d "$category_dir" || -L "$category_dir" ]]; then
      rm -rf "$category_dir"
      echo "🗑️  [REMOVE:CATEGORY] '${single_cat}' 카테고리에 더 이상 규칙이 존재하지 않아 카테고리도 함께 삭제되었습니다: ${category_dir}"
    fi
  fi
}

##
# 이미 존재하는 스킬 또는 규칙(--name)을 지정된 카테고리(--category)에 심볼릭 링크로 추가합니다.
# '--name' 값으로는 전체 파일/디렉토리 경로뿐만 아니라 '{src_category}/{name}' 형식도 허용합니다.
#
# @param $@ {array} add 서브커맨드 인자 목록
#
# @return 0 (성공 시)
##
cmd_add() {
  local target=""
  local category=""
  local name_arg=""
  local cli_home=""
  local force="false"

  while (( $# > 0 )); do
    case "$1" in
      --help)
        help "" "" "add"
        return 0
        ;;
      skill|rule)
        if [[ -z "$target" ]]; then
          target="$1"
          shift
        else
          die "대상(skill|rule)이 중복 지정되었습니다: $1" "$LINENO" "add"
        fi
        ;;
      --category)
        [[ $# -ge 2 ]] || die "'--category' 옵션에 값이 필요합니다." "$LINENO" "add"
        category="$2"
        shift 2
        ;;
      --category=*)
        category="${1#--category=}"
        shift
        ;;
      --name)
        [[ $# -ge 2 ]] || die "'--name' 옵션에 대상 경로(또는 '{category}/{name}')가 필요합니다." "$LINENO" "add"
        name_arg="$2"
        shift 2
        ;;
      --name=*)
        name_arg="${1#--name=}"
        shift
        ;;
      --home)
        [[ $# -ge 2 ]] || die "'--home' 옵션에 경로가 필요합니다." "$LINENO" "add"
        cli_home="$2"
        shift 2
        ;;
      --home=*)
        cli_home="${1#--home=}"
        shift
        ;;
      --force)
        force="true"
        shift
        ;;
      -*)
        die "알 수 없는 옵션입니다: $1 (Long Option만 지원합니다)" "$LINENO" "add"
        ;;
      *)
        die "알 수 없는 인자입니다: $1" "$LINENO" "add"
        ;;
    esac
  done

  [[ -n "$target" ]] || die "추가할 대상('skill' 또는 'rule')을 지정해야 합니다." "$LINENO" "add"
  category="$(normalize_category_name "$target" "$category")"
  validate_identifier "$category" "category" "add"
  [[ -n "$name_arg" ]] || die "'--name' 옵션 값이 비어 있습니다." "$LINENO" "add"

  local phys_cat
  phys_cat="$(to_physical_category_dir_name "$target" "$category")"

  local acs_home
  acs_home="$(resolve_acs_home "$cli_home" "add")"

  if [[ "$target" == "skill" ]]; then
    local resolved_input="$name_arg"
    if [[ ! -d "$resolved_input" && "$resolved_input" == */* && "$resolved_input" != /* ]]; then
      local src_cat_raw="${resolved_input%%/*}"
      local src_cat_phys
      src_cat_phys="$(to_physical_category_dir_name "skill" "$src_cat_raw")"
      local src_skill="${resolved_input#*/}"
      local candidate_dir="${acs_home}/skills/${src_cat_phys}/.agents/skills/${src_skill}"
      if [[ -d "$candidate_dir" ]]; then
        resolved_input="$candidate_dir"
      fi
    fi

    [[ -d "$resolved_input" ]] || die "참조할 원본 스킬 디렉토리가 존재하지 않습니다: ${name_arg}" "$LINENO" "add"

    local abs_src_dir
    abs_src_dir="$(resolve_abs_path "$resolved_input" "resolve")"

    local skill_name
    skill_name="$(basename "$abs_src_dir")"
    validate_identifier "$skill_name" "name" "add"

    local skills_parent="${acs_home}/skills/${phys_cat}/.agents/skills"
    local link_path="${skills_parent}/${skill_name}"

    mkdir -p "$skills_parent"
    local abs_skills_parent
    abs_skills_parent="$(resolve_abs_path "$skills_parent" "resolve")"
    if [[ "${abs_skills_parent}/${skill_name}" == "$abs_src_dir" ]]; then
      die "원본 스킬과 동일한 카테고리('${category}')로 자기 자신을 심볼릭 링크할 수 없습니다: ${abs_src_dir}" "$LINENO" "add"
    fi

    if [[ -e "$link_path" || -L "$link_path" ]]; then
      if [[ "$force" != "true" ]]; then
        die "해당 카테고리에 이미 동일한 이름의 스킬이 존재합니다: ${link_path} (교체하려면 '--force' 옵션을 사용하세요)" "$LINENO" "add"
      fi
      if [[ -L "$link_path" ]]; then
        rm -f "$link_path"
      else
        rm -rf "$link_path"
      fi
    fi

    ln -s "$abs_src_dir" "$link_path"

    echo "🔗 [ADD:SKILL] 스킬 심볼릭 링크가 추가되었습니다."
    echo "   - 카테고리 : ${category} (${phys_cat})"
    echo "   - 스킬 이름: ${skill_name}"
    echo "   - 링크 경로: ${link_path}"
    echo "   - 원본 경로: ${abs_src_dir}"

  elif [[ "$target" == "rule" ]]; then
    local resolved_input="$name_arg"
    if [[ ! -f "$resolved_input" && "$resolved_input" == */* && "$resolved_input" != /* ]]; then
      local src_cat_raw="${resolved_input%%/*}"
      local src_cat_phys
      src_cat_phys="$(to_physical_category_dir_name "rule" "$src_cat_raw")"
      local src_rule
      src_rule="$(normalize_rule_name "${resolved_input#*/}")"
      local candidate_file="${acs_home}/rules/${src_cat_phys}/.agents/rules/${src_rule}.md"
      if [[ -f "$candidate_file" ]]; then
        resolved_input="$candidate_file"
      fi
    fi

    [[ -f "$resolved_input" ]] || die "참조할 원본 규칙 파일이 존재하지 않습니다: ${name_arg}" "$LINENO" "add"

    local abs_src_file
    abs_src_file="$(resolve_abs_path "$resolved_input" "resolve")"

    local rule_name
    rule_name="$(normalize_rule_name "$(basename "$abs_src_file")")"
    validate_identifier "$rule_name" "name" "add"

    local rules_parent="${acs_home}/rules/${phys_cat}/.agents/rules"
    local link_path="${rules_parent}/${rule_name}.md"

    mkdir -p "$rules_parent"
    local abs_rules_parent
    abs_rules_parent="$(resolve_abs_path "$rules_parent" "resolve")"
    if [[ "${abs_rules_parent}/${rule_name}.md" == "$abs_src_file" ]]; then
      die "원본 규칙과 동일한 카테고리('${category}')로 자기 자신을 심볼릭 링크할 수 없습니다: ${abs_src_file}" "$LINENO" "add"
    fi

    if [[ -e "$link_path" || -L "$link_path" ]]; then
      if [[ "$force" != "true" ]]; then
        die "해당 카테고리에 이미 동일한 이름의 규칙 파일이 존재합니다: ${link_path} (교체하려면 '--force' 옵션을 사용하세요)" "$LINENO" "add"
      fi
      rm -f "$link_path"
    fi

    ln -s "$abs_src_file" "$link_path"

    echo "🔗 [ADD:RULE] 규칙 심볼릭 링크가 추가되었습니다."
    echo "   - 카테고리 : ${category} (${phys_cat})"
    echo "   - 규칙 이름: ${rule_name}"
    echo "   - 링크 경로: ${link_path}"
    echo "   - 원본 경로: ${abs_src_file}"
  fi
}

##
# 디렉토리 내부의 파일 및 하위 폴더들을 tree 선 기호(├──, └──, │) 스타일로 재귀 출력합니다.
#
# @param $1 {string} 탐색할 디렉토리 경로
# @param $2 {string} 현재 줄 앞에 붙일 들여쓰기 접두사
#
# @return 0
##
render_dir_tree() {
  local dir_path="$1"
  local prefix="${2:-}"

  [[ -d "$dir_path" ]] || return 0

  local -a entries=()
  local item
  for item in "${dir_path}"/*; do
    [[ -e "$item" || -L "$item" ]] || continue
    entries+=("$item")
  done

  local count="${#entries[@]}"
  (( count > 0 )) || return 0

  local idx=0
  local branch next_prefix bname link_target
  for item in "${entries[@]}"; do
    ((idx++)) || true
    bname="$(basename "$item")"

    if (( idx == count )); then
      branch="└── "
      next_prefix="${prefix}    "
    else
      branch="├── "
      next_prefix="${prefix}│   "
    fi

    if [[ -L "$item" ]]; then
      link_target="$(readlink "$item" || true)"
      if [[ -d "$item" ]]; then
        printf "%s%s%s/ -> %s\n" "$prefix" "$branch" "$bname" "$link_target"
      else
        printf "%s%s%s -> %s\n" "$prefix" "$branch" "$bname" "$link_target"
      fi
    elif [[ -d "$item" ]]; then
      printf "%s%s%s/\n" "$prefix" "$branch" "$bname"
      render_dir_tree "$item" "$next_prefix"
    else
      printf "%s%s%s\n" "$prefix" "$branch" "$bname"
    fi
  done
}

##
# 단일 스킬 카테고리의 트리 구조를 출력합니다.
#
# @param $1 {string} 루트 경로 (acs_home)
# @param $2 {string} 논리 카테고리 이름
# @param $3 {string} 콤마로 구분된 스킬 이름 필터 (선택)
#
# @return 0
##
print_skill_category_tree() {
  local acs_home="$1"
  local logical_cat="$2"
  local filter_names_csv="${3:-}"

  local phys_cat
  phys_cat="$(to_physical_category_dir_name "skill" "$logical_cat")"
  local cat_root="${acs_home}/skills/${phys_cat}"
  local skills_dir="${cat_root}/.agents/skills"

  if [[ ! -d "$cat_root" ]]; then
    die "조회할 스킬 카테고리가 존재하지 않습니다: ${cat_root}" "$LINENO" "list"
  fi

  local -a skill_entries=()
  if [[ -n "$filter_names_csv" ]]; then
    local sname target_skill
    while IFS= read -r sname; do
      [[ -n "$sname" ]] || continue
      target_skill="${skills_dir}/${sname}"
      if [[ ! -e "$target_skill" && ! -L "$target_skill" ]]; then
        die "카테고리 '${logical_cat}' (${phys_cat})에 '${sname}' 스킬이 존재하지 않습니다: ${target_skill}" "$LINENO" "list"
      fi
      skill_entries+=("$target_skill")
    done < <(split_csv_unique "$filter_names_csv" "name" "list" "")
  elif [[ -d "$skills_dir" ]]; then
    local entry
    for entry in "${skills_dir}"/*; do
      [[ -e "$entry" || -L "$entry" ]] || continue
      skill_entries+=("$entry")
    done
  fi

  printf "%s\n" "$cat_root"
  local count="${#skill_entries[@]}"
  if (( count == 0 )); then
    printf "└── (등록된 스킬 없음)\n"
    return 0
  fi

  local idx=0
  local entry sname branch child_prefix link_target
  for entry in "${skill_entries[@]}"; do
    ((idx++)) || true
    sname="$(basename "$entry")"

    if (( idx == count )); then
      branch="└── "
      child_prefix="    "
    else
      branch="├── "
      child_prefix="│   "
    fi

    if [[ -L "$entry" ]]; then
      link_target="$(readlink "$entry" || true)"
      if [[ -e "$entry" ]]; then
        printf "%s%s -> %s\n" "$branch" "$sname" "$link_target"
        render_dir_tree "$entry" "$child_prefix"
      else
        printf "%s%s -> %s (대상 없음)\n" "$branch" "$sname" "$link_target"
      fi
    elif [[ -d "$entry" ]]; then
      printf "%s%s\n" "$branch" "$sname"
      render_dir_tree "$entry" "$child_prefix"
    else
      printf "%s%s\n" "$branch" "$sname"
    fi
  done
}

##
# 단일 규칙 카테고리의 트리 구조를 출력합니다. (방식 B: rule-1.md 단일 라인)
#
# @param $1 {string} 루트 경로 (acs_home)
# @param $2 {string} 논리 카테고리 이름
# @param $3 {string} 콤마로 구분된 규칙 이름 필터 (선택)
#
# @return 0
##
print_rule_category_tree() {
  local acs_home="$1"
  local logical_cat="$2"
  local filter_names_csv="${3:-}"

  local phys_cat
  phys_cat="$(to_physical_category_dir_name "rule" "$logical_cat")"
  local cat_root="${acs_home}/rules/${phys_cat}"
  local rules_dir="${cat_root}/.agents/rules"

  if [[ ! -d "$cat_root" ]]; then
    die "조회할 규칙 카테고리가 존재하지 않습니다: ${cat_root}" "$LINENO" "list"
  fi

  local -a rule_entries=()
  if [[ -n "$filter_names_csv" ]]; then
    local rname target_rule
    while IFS= read -r rname; do
      [[ -n "$rname" ]] || continue
      target_rule="${rules_dir}/${rname}.md"
      if [[ ! -e "$target_rule" && ! -L "$target_rule" ]]; then
        die "카테고리 '${logical_cat}' (${phys_cat})에 '${rname}' 규칙이 존재하지 않습니다: ${target_rule}" "$LINENO" "list"
      fi
      rule_entries+=("$target_rule")
    done < <(split_csv_unique "$filter_names_csv" "name" "list" "rule-name")
  elif [[ -d "$rules_dir" ]]; then
    local entry bname
    for entry in "${rules_dir}"/*; do
      [[ -e "$entry" || -L "$entry" ]] || continue
      bname="$(basename "$entry")"
      [[ "$bname" == *.md || "$bname" == *.MD ]] || continue
      rule_entries+=("$entry")
    done
  fi

  printf "%s\n" "$cat_root"
  local count="${#rule_entries[@]}"
  if (( count == 0 )); then
    printf "└── (등록된 규칙 없음)\n"
    return 0
  fi

  local idx=0
  local entry rfile branch link_target
  for entry in "${rule_entries[@]}"; do
    ((idx++)) || true
    rfile="$(basename "$entry")"

    if (( idx == count )); then
      branch="└── "
    else
      branch="├── "
    fi

    if [[ -L "$entry" ]]; then
      link_target="$(readlink "$entry" || true)"
      if [[ -e "$entry" ]]; then
        printf "%s%s -> %s\n" "$branch" "$rfile" "$link_target"
      else
        printf "%s%s -> %s (대상 없음)\n" "$branch" "$rfile" "$link_target"
      fi
    else
      printf "%s%s\n" "$branch" "$rfile"
    fi
  done
}

##
# 지정된 종류(skill 또는 rule)의 전체 또는 필터링된 트리 목록을 출력합니다.
#
# @param $1 {string} 종류 (skill | rule)
# @param $2 {string} 루트 경로 (acs_home)
# @param $3 {string} 카테고리 필터 (콤마 구분 가능, 빈 문자열이면 전체 카테고리)
# @param $4 {string} 이름 필터 (콤마 구분 가능, 빈 문자열이면 전체 항목)
#
# @return 0
##
print_list_by_kind() {
  local kind="$1"
  local acs_home="$2"
  local category_csv="${3:-}"
  local name_csv="${4:-}"

  local cat_norm_mode="skill-cat"
  [[ "$kind" == "rule" ]] && cat_norm_mode="rule-cat"

  if [[ -n "$category_csv" ]]; then
    local -a req_categories=()
    local cat_item
    while IFS= read -r cat_item; do
      [[ -n "$cat_item" ]] && req_categories+=("$cat_item")
    done < <(split_csv_unique "$category_csv" "category" "list" "$cat_norm_mode")

    for cat_item in "${req_categories[@]}"; do
      if [[ "$kind" == "skill" ]]; then
        print_skill_category_tree "$acs_home" "$cat_item" "$name_csv"
      else
        print_rule_category_tree "$acs_home" "$cat_item" "$name_csv"
      fi
    done
    return 0
  fi

  local kind_root=""
  if [[ "$kind" == "skill" ]]; then
    kind_root="${acs_home}/skills"
  else
    kind_root="${acs_home}/rules"
  fi

  if [[ ! -d "$kind_root" ]]; then
    printf "%s (등록된 카테고리 없음)\n" "$kind_root"
    return 0
  fi

  local -a categories=()
  local cat_dir bname
  for cat_dir in "${kind_root}"/*; do
    [[ -d "$cat_dir" ]] || continue
    bname="$(basename "$cat_dir")"
    if [[ "$kind" == "skill" ]]; then
      [[ "$bname" == skill-* ]] || continue
      categories+=("${bname#skill-}")
    else
      [[ "$bname" == rule-* ]] || continue
      categories+=("${bname#rule-}")
    fi
  done

  if (( ${#categories[@]} == 0 )); then
    printf "%s (등록된 카테고리 없음)\n" "$kind_root"
    return 0
  fi

  local cat
  for cat in "${categories[@]}"; do
    if [[ "$kind" == "skill" ]]; then
      print_skill_category_tree "$acs_home" "$cat" ""
    else
      print_rule_category_tree "$acs_home" "$cat" ""
    fi
  done
}

##
# 등록된 스킬(Skill) 및 규칙(Rule) 목록을 tree 스타일로 조회합니다.
#
# @param $@ {array} list 서브커맨드 인자 목록
#
# @return 0 (성공 시)
##
cmd_list() {
  local target="all"
  local target_set="false"
  local category=""
  local name=""
  local cli_home=""

  while (( $# > 0 )); do
    case "$1" in
      --help)
        help "" "" "list"
        return 0
        ;;
      skill|rule)
        if [[ "$target_set" == "false" ]]; then
          target="$1"
          target_set="true"
          shift
        else
          die "대상(skill|rule)이 중복 지정되었습니다: $1" "$LINENO" "list"
        fi
        ;;
      --category)
        [[ $# -ge 2 ]] || die "'--category' 옵션에 값이 필요합니다." "$LINENO" "list"
        category="$2"
        shift 2
        ;;
      --category=*)
        category="${1#--category=}"
        shift
        ;;
      --name)
        [[ $# -ge 2 ]] || die "'--name' 옵션에 값이 필요합니다." "$LINENO" "list"
        name="$2"
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        shift
        ;;
      --home)
        [[ $# -ge 2 ]] || die "'--home' 옵션에 경로가 필요합니다." "$LINENO" "list"
        cli_home="$2"
        shift 2
        ;;
      --home=*)
        cli_home="${1#--home=}"
        shift
        ;;
      -*)
        die "알 수 없는 옵션입니다: $1 (Long Option만 지원합니다)" "$LINENO" "list"
        ;;
      *)
        die "알 수 없는 인자입니다: $1" "$LINENO" "list"
        ;;
    esac
  done

  if [[ -n "$name" && -z "$category" ]]; then
    die "'--name' 옵션을 사용할 때는 '--category' 옵션을 함께 지정해야 합니다." "$LINENO" "list"
  fi
  if [[ "$target" == "all" && ( -n "$category" || -n "$name" ) ]]; then
    die "'--category' 또는 '--name' 필터를 사용할 때는 조회 대상('skill' 또는 'rule')을 지정해야 합니다." "$LINENO" "list"
  fi

  if [[ -n "$category" ]]; then
    local cat_norm_mode="skill-cat"
    [[ "$target" == "rule" ]] && cat_norm_mode="rule-cat"

    local -a parsed_cats=()
    local c_line
    while IFS= read -r c_line; do
      [[ -n "$c_line" ]] && parsed_cats+=("$c_line")
    done < <(split_csv_unique "$category" "category" "list" "$cat_norm_mode")

    if (( ${#parsed_cats[@]} > 1 )) && [[ -n "$name" ]]; then
      die "'--category'에 여러 카테고리를 지정한 경우 '--name' 옵션을 함께 사용할 수 없습니다." "$LINENO" "list"
    fi
  fi

  local acs_home
  acs_home="$(resolve_acs_home "$cli_home" "list")"

  if [[ "$target" == "skill" ]]; then
    print_list_by_kind "skill" "$acs_home" "$category" "$name"
  elif [[ "$target" == "rule" ]]; then
    print_list_by_kind "rule" "$acs_home" "$category" "$name"
  else
    # acs-cli list : skill -> rule 순서로 출력
    print_list_by_kind "skill" "$acs_home" "" ""
    print_list_by_kind "rule" "$acs_home" "" ""
  fi
}

##
# 메인 엔트리포인트 함수
#
# @param $@ {array} 전체 커맨드라인 인자
#
# @return 종료 코드
##
main() {
  if (( $# == 0 )); then
    help "실행할 명령어(create | remove | add | list)를 지정해 주세요." "$LINENO" "" >&2
    exit 1
  fi

  local subcmd="$1"
  shift

  case "$subcmd" in
    --help)
      help "" "" ""
      return 0
      ;;
    create)
      cmd_create "$@"
      ;;
    remove)
      cmd_remove "$@"
      ;;
    add)
      cmd_add "$@"
      ;;
    list)
      cmd_list "$@"
      ;;
    -*)
      die "알 수 없는 옵션입니다: ${subcmd} (명령어를 먼저 지정하거나 '--help'를 사용하세요)" "$LINENO" ""
      ;;
    *)
      die "지원하지 않는 명령어입니다: ${subcmd} (지원 명령어: create, remove, add, list)" "$LINENO" ""
      ;;
  esac
}

main "$@"
