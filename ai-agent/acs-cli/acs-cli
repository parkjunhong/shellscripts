        ;;
      --name)
        [[ $# -ge 2 ]] || die "'--name' 옵션에 값이 필요합니다." "$LINENO" "remove"
        name="$2"
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        shift
        ;;
      --home)
        [[ $# -ge 2 ]] || die "'--home' 옵션에 경로가 필요합니다." "$LINENO" "remove"
        cli_home="$2"
        shift 2
        ;;
      --home=*)
        cli_home="${1#--home=}"
        shift
        ;;
      --force)
        force="true"
        shift
        ;;
      -*)
        die "알 수 없는 옵션입니다: $1 (Long Option만 지원합니다)" "$LINENO" "remove"
        ;;
      *)
        die "알 수 없는 인자입니다: $1" "$LINENO" "remove"
        ;;
    esac
  done

  [[ -n "$target" ]] || die "삭제할 대상('skill' 또는 'rule')을 지정해야 합니다." "$LINENO" "remove"
  validate_identifier "$category" "category" "remove"
  validate_identifier "$name" "name" "remove"

  local acs_home
  acs_home="$(resolve_acs_home "$cli_home" "remove")"

  if [[ "$target" == "skill" ]]; then
    local skill_dir="${acs_home}/skills/${category}/.agents/skills/${name}"

    if [[ ! -e "$skill_dir" && ! -L "$skill_dir" ]]; then
      die "삭제할 스킬이 존재하지 않습니다: ${skill_dir}" "$LINENO" "remove"
    fi

    local item_type="일반 디렉토리 (원본 삭제)"
    if [[ -L "$skill_dir" ]]; then
      local link_target
      link_target="$(readlink "$skill_dir" || true)"
      item_type="심볼릭 링크 (원본 보존: ${link_target})"
    fi

    if [[ "$force" != "true" ]]; then
      echo "⚠️  다음 스킬을 삭제하시겠습니까?"
      echo "   - 카테고리 : ${category}"
      echo "   - 스킬 이름: ${name}"
      echo "   - 대상 경로: ${skill_dir}"
      echo "   - 항목 유형: ${item_type}"
      local answer=""
      read -r -p "삭제를 진행하시겠습니까? [y/N]: " answer
      if [[ ! "$answer" =~ ^[Yy]$ ]]; then
        echo "🚫 삭제 작업이 취소되었습니다."
        return 0
      fi
    fi

    if [[ -L "$skill_dir" ]]; then
      rm -f "$skill_dir"
    else
      rm -rf "$skill_dir"
    fi

    echo "🗑️  [REMOVE:SKILL] 스킬이 삭제되었습니다: ${skill_dir}"

  elif [[ "$target" == "rule" ]]; then
    local rule_name
    rule_name="$(normalize_rule_name "$name")"
    validate_identifier "$rule_name" "name" "remove"

    local rule_file="${acs_home}/rules/${category}/.agents/rules/${rule_name}.md"

    if [[ ! -e "$rule_file" && ! -L "$rule_file" ]]; then
      die "삭제할 규칙 파일이 존재하지 않습니다: ${rule_file}" "$LINENO" "remove"
    fi

    local item_type="일반 파일 (원본 삭제)"
    if [[ -L "$rule_file" ]]; then
      local link_target
      link_target="$(readlink "$rule_file" || true)"
      item_type="심볼릭 링크 (원본 보존: ${link_target})"
    fi

    if [[ "$force" != "true" ]]; then
      echo "⚠️  다음 규칙을 삭제하시겠습니까?"
      echo "   - 카테고리 : ${category}"
      echo "   - 규칙 이름: ${rule_name}"
      echo "   - 대상 경로: ${rule_file}"
      echo "   - 항목 유형: ${item_type}"
      local answer=""
      read -r -p "삭제를 진행하시겠습니까? [y/N]: " answer
      if [[ ! "$answer" =~ ^[Yy]$ ]]; then
        echo "🚫 삭제 작업이 취소되었습니다."
        return 0
      fi
    fi

    rm -f "$rule_file"
    echo "🗑️  [REMOVE:RULE] 규칙이 삭제되었습니다: ${rule_file}"
  fi
}

##
# 외부에 존재하는 스킬 디렉토리(--directory) 또는 규칙 파일(--file)을
# 지정된 카테고리(--category)에 심볼릭 링크로 추가합니다.
#
# @param $@ {array} add 서브커맨드 인자 목록
#
# @return 0 (성공 시)
##
cmd_add() {
  local target=""
  local category=""
  local src_directory=""
  local src_file=""
  local custom_name=""
  local cli_home=""
  local force="false"

  while (( $# > 0 )); do
    case "$1" in
      --help)
        help "" "" "add"
        return 0
        ;;
      skill|rule)
        if [[ -z "$target" ]]; then
          target="$1"
          shift
        else
          die "대상(skill|rule)이 중복 지정되었습니다: $1" "$LINENO" "add"
        fi
        ;;
      --category)
        [[ $# -ge 2 ]] || die "'--category' 옵션에 값이 필요합니다." "$LINENO" "add"
        category="$2"
        shift 2
        ;;
      --category=*)
        category="${1#--category=}"
        shift
        ;;
      --directory)
        [[ $# -ge 2 ]] || die "'--directory' 옵션에 디렉토리 경로가 필요합니다." "$LINENO" "add"
        src_directory="$2"
        shift 2
        ;;
      --directory=*)
        src_directory="${1#--directory=}"
        shift
        ;;
      --file)
        [[ $# -ge 2 ]] || die "'--file' 옵션에 파일 경로가 필요합니다." "$LINENO" "add"
        src_file="$2"
        shift 2
        ;;
      --file=*)
        src_file="${1#--file=}"
        shift
        ;;
      --name)
        [[ $# -ge 2 ]] || die "'--name' 옵션에 값이 필요합니다." "$LINENO" "add"
        custom_name="$2"
        shift 2
        ;;
      --name=*)
        custom_name="${1#--name=}"
        shift
        ;;
      --home)
        [[ $# -ge 2 ]] || die "'--home' 옵션에 경로가 필요합니다." "$LINENO" "add"
        cli_home="$2"
        shift 2
        ;;
      --home=*)
        cli_home="${1#--home=}"
        shift
        ;;
      --force)
        force="true"
        shift
        ;;
      -*)
        die "알 수 없는 옵션입니다: $1 (Long Option만 지원합니다)" "$LINENO" "add"
        ;;
      *)
        die "알 수 없는 인자입니다: $1" "$LINENO" "add"
        ;;
    esac
  done

  [[ -n "$target" ]] || die "추가할 대상('skill' 또는 'rule')을 지정해야 합니다." "$LINENO" "add"
  validate_identifier "$category" "category" "add"

  local acs_home
  acs_home="$(resolve_acs_home "$cli_home" "add")"

  if [[ "$target" == "skill" ]]; then
    [[ -z "$src_file" ]] || die "'add skill' 명령에는 '--file' 대신 '--directory' 옵션을 사용해야 합니다." "$LINENO" "add"
    [[ -n "$src_directory" ]] || die "'add skill' 명령에는 '--directory <경로>' 옵션이 필수입니다." "$LINENO" "add"
    [[ -d "$src_directory" ]] || die "지정한 스킬 디렉토리가 존재하지 않거나 디렉토리가 아닙니다: ${src_directory}" "$LINENO" "add"

    local abs_src_dir
    abs_src_dir="$(resolve_abs_path "$src_directory" "resolve")"

    local skill_name="$custom_name"
    if [[ -z "$skill_name" ]]; then
      skill_name="$(basename "$abs_src_dir")"
    fi
    validate_identifier "$skill_name" "name" "add"

    local skills_parent="${acs_home}/skills/${category}/.agents/skills"
    local link_path="${skills_parent}/${skill_name}"

    if [[ -e "$link_path" || -L "$link_path" ]]; then
      if [[ "$force" != "true" ]]; then
        die "해당 카테고리에 이미 동일한 이름의 스킬이 존재합니다: ${link_path} (교체하려면 '--force' 옵션을 사용하세요)" "$LINENO" "add"
      fi
      if [[ -L "$link_path" ]]; then
        rm -f "$link_path"
      else
        rm -rf "$link_path"
      fi
    fi

    mkdir -p "$skills_parent"
    ln -s "$abs_src_dir" "$link_path"

    echo "🔗 [ADD:SKILL] 스킬 심볼릭 링크가 추가되었습니다."
    echo "   - 카테고리 : ${category}"
    echo "   - 스킬 이름: ${skill_name}"
    echo "   - 링크 경로: ${link_path}"
    echo "   - 원본 경로: ${abs_src_dir}"
    if [[ ! -f "${abs_src_dir}/SKILL.md" && ! -f "${abs_src_dir}/SKILL.MD" ]]; then
      echo "   ⚠️  참고: 원본 디렉토리 내에 'SKILL.md' 파일이 아직 존재하지 않습니다."
    fi

  elif [[ "$target" == "rule" ]]; then
    [[ -z "$src_directory" ]] || die "'add rule' 명령에는 '--directory' 대신 '--file' 옵션을 사용해야 합니다." "$LINENO" "add"
    [[ -n "$src_file" ]] || die "'add rule' 명령에는 '--file <경로>' 옵션이 필수입니다." "$LINENO" "add"
    [[ -f "$src_file" ]] || die "지정한 규칙 파일이 존재하지 않거나 일반 파일이 아닙니다: ${src_file}" "$LINENO" "add"

    local abs_src_file
    abs_src_file="$(resolve_abs_path "$src_file" "resolve")"

    local rule_name="$custom_name"
    if [[ -z "$rule_name" ]]; then
      rule_name="$(basename "$abs_src_file")"
    fi
    rule_name="$(normalize_rule_name "$rule_name")"
    validate_identifier "$rule_name" "name" "add"

    local rules_parent="${acs_home}/rules/${category}/.agents/rules"
    local link_path="${rules_parent}/${rule_name}.md"

    if [[ -e "$link_path" || -L "$link_path" ]]; then
      if [[ "$force" != "true" ]]; then
        die "해당 카테고리에 이미 동일한 이름의 규칙 파일이 존재합니다: ${link_path} (교체하려면 '--force' 옵션을 사용하세요)" "$LINENO" "add"
      fi
      rm -f "$link_path"
    fi

    mkdir -p "$rules_parent"
    ln -s "$abs_src_file" "$link_path"

    echo "🔗 [ADD:RULE] 규칙 심볼릭 링크가 추가되었습니다."
    echo "   - 카테고리 : ${category}"
    echo "   - 규칙 이름: ${rule_name}"
    echo "   - 링크 경로: ${link_path}"
    echo "   - 원본 경로: ${abs_src_file}"
  fi
}

##
# 특정 타입(skill 또는 rule)의 목록을 탐색하고 포맷팅하여 출력합니다.
#
# @param $1 {string} 대상 종류 (skill | rule)
# @param $2 {string} 루트 경로 (acs_home)
# @param $3 {string} 카테고리 필터 (빈 문자열이면 전체)
# @param $4 {string} 이름 필터 (빈 문자열이면 전체)
#
# @return 0
##
print_list_section() {
  local kind="$1"
  local acs_home="$2"
  local filter_category="${3:-}"
  local filter_name="${4:-}"

  local base_root=""
  local sub_rel=""
  local header_title=""

  if [[ "$kind" == "skill" ]]; then
    base_root="${acs_home}/skills"
    sub_rel=".agents/skills"
    header_title="📘 SKILLS (${base_root})"
  else
    base_root="${acs_home}/rules"
    sub_rel=".agents/rules"
    header_title="📙 RULES (${base_root})"
    if [[ -n "$filter_name" ]]; then
      filter_name="$(normalize_rule_name "$filter_name")"
    fi
  fi

  echo "================================================================================"
  echo "${header_title}"
  echo "================================================================================"

  if [[ ! -d "$base_root" ]]; then
    echo "  (디렉토리가 아직 존재하지 않습니다)"
    echo
    return 0
  fi

  local -a categories=()
  if [[ -n "$filter_category" ]]; then
    if [[ -d "${base_root}/${filter_category}" ]]; then
      categories+=("$filter_category")
    else
      echo "  (지정한 카테고리 '${filter_category}'가 존재하지 않습니다)"
      echo
      return 0
    fi
  else
    local cat_dir
    for cat_dir in "${base_root}"/*; do
      [[ -d "$cat_dir" ]] || continue
      categories+=("$(basename "$cat_dir")")
    done
  fi

  if (( ${#categories[@]} == 0 )); then
    echo "  (등록된 카테고리가 없습니다)"
    echo
    return 0
  fi

  local total_matched=0
  local cat items_dir entry item_name display_name status_badge detail_info target_dest

  for cat in "${categories[@]}"; do
    items_dir="${base_root}/${cat}/${sub_rel}"
    [[ -d "$items_dir" ]] || continue

    local -a matched_entries=()
    for entry in "${items_dir}"/*; do
      [[ -e "$entry" || -L "$entry" ]] || continue
      item_name="$(basename "$entry")"

      if [[ "$kind" == "rule" ]]; then
        [[ "$item_name" == *.md || "$item_name" == *.MD ]] || continue
        display_name="$(normalize_rule_name "$item_name")"
      else
        display_name="$item_name"
      fi

      if [[ -n "$filter_name" ]]; then
        # 정확히 일치하거나 부분 문자열/와일드카드 패턴에 부합하는지 확인
        if [[ "$display_name" != *"$filter_name"* ]]; then
          continue
        fi
      fi

      matched_entries+=("$entry")
    done

    if (( ${#matched_entries[@]} == 0 )); then
      if [[ -n "$filter_category" && -z "$filter_name" ]]; then
        printf "  📂 [%s] (등록된 항목 없음)\n" "$cat"
      fi
      continue
    fi

    printf "  📂 [%s]\n" "$cat"
    for entry in "${matched_entries[@]}"; do
      item_name="$(basename "$entry")"
      if [[ "$kind" == "rule" ]]; then
        display_name="$(normalize_rule_name "$item_name")"
      else
        display_name="$item_name"
      fi

      if [[ -L "$entry" ]]; then
        target_dest="$(readlink "$entry" || true)"
        if [[ -e "$entry" ]]; then
          status_badge="[LINK]"
          detail_info="${entry} -> ${target_dest}"
        else
          status_badge="[BROKEN-LINK]"
          detail_info="${entry} -> ${target_dest} (대상 없음)"
        fi
      else
        status_badge="[LOCAL]"
        if [[ "$kind" == "skill" ]]; then
          if [[ -f "${entry}/SKILL.md" ]]; then
            detail_info="${entry}/SKILL.md"
          elif [[ -f "${entry}/SKILL.MD" ]]; then
            detail_info="${entry}/SKILL.MD"
          else
            status_badge="[LOCAL:NO-SKILL.md]"
            detail_info="${entry}"
          fi
        else
          detail_info="${entry}"
        fi
      fi

      printf "     - %-24s %-16s %s\n" "$display_name" "$status_badge" "$detail_info"
      ((total_matched++)) || true
    done
  done

  if (( total_matched == 0 )); then
    echo "  (조건에 일치하는 항목이 없습니다)"
  fi
  echo
}

##
# 등록된 스킬(Skill) 및 규칙(Rule) 목록을 조회합니다.
#
# @param $@ {array} list 서브커맨드 인자 목록
#
# @return 0 (성공 시)
##
cmd_list() {
  local target="all"
  local target_set="false"
  local category=""
  local name=""
  local cli_home=""

  while (( $# > 0 )); do
    case "$1" in
      --help)
        help "" "" "list"
        return 0
        ;;
      skill|rule)
        if [[ "$target_set" == "false" ]]; then
          target="$1"
          target_set="true"
          shift
        else
          die "대상(skill|rule)이 중복 지정되었습니다: $1" "$LINENO" "list"
        fi
        ;;
      --category)
        [[ $# -ge 2 ]] || die "'--category' 옵션에 값이 필요합니다." "$LINENO" "list"
        category="$2"
        shift 2
        ;;
      --category=*)
        category="${1#--category=}"
        shift
        ;;
      --name)
        [[ $# -ge 2 ]] || die "'--name' 옵션에 값이 필요합니다." "$LINENO" "list"
        name="$2"
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        shift
        ;;
      --home)
        [[ $# -ge 2 ]] || die "'--home' 옵션에 경로가 필요합니다." "$LINENO" "list"
        cli_home="$2"
        shift 2
        ;;
      --home=*)
        cli_home="${1#--home=}"
        shift
        ;;
      -*)
        die "알 수 없는 옵션입니다: $1 (Long Option만 지원합니다)" "$LINENO" "list"
        ;;
      *)
        die "알 수 없는 인자입니다: $1" "$LINENO" "list"
        ;;
    esac
  done

  [[ -z "$category" ]] || validate_identifier "$category" "category" "list"
  [[ -z "$name" ]] || validate_identifier "$name" "name" "list"

  local acs_home
  acs_home="$(resolve_acs_home "$cli_home" "list")"

  echo
  echo "🏠 AI_AGENT_CUSTOMIZATION_HOME: ${acs_home}"
  echo

  if [[ "$target" == "all" || "$target" == "skill" ]]; then
    print_list_section "skill" "$acs_home" "$category" "$name"
  fi
  if [[ "$target" == "all" || "$target" == "rule" ]]; then
    print_list_section "rule" "$acs_home" "$category" "$name"
  fi
}

##
# 메인 엔트리포인트 함수
#
# @param $@ {array} 전체 커맨드라인 인자
#
# @return 종료 코드
##
main() {
  if (( $# == 0 )); then
    help "실행할 명령어(create | remove | add | list)를 지정해 주세요." "$LINENO" "" >&2
    exit 1
  fi

  local subcmd="$1"
  shift

  case "$subcmd" in
    --help)
      help "" "" ""
      return 0
      ;;
    create)
      cmd_create "$@"
      ;;
    remove)
      cmd_remove "$@"
      ;;
    add)
      cmd_add "$@"
      ;;
    list)
      cmd_list "$@"
      ;;
    -*)
      die "알 수 없는 옵션입니다: ${subcmd} (명령어를 먼저 지정하거나 '--help'를 사용하세요)" "$LINENO" ""
      ;;
    *)
      die "지원하지 않는 명령어입니다: ${subcmd} (지원 명령어: create, remove, add, list)" "$LINENO" ""
      ;;
  esac
}

main "$@"
