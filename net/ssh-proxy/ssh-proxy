#!/usr/bin/env bash
# =======================================
# @author : parkjunhong77@gmail.com
# @title : ssh-proxy: Connect to SSH servers via Bastion/Jump Proxy or direct connection
# @license : Apache License 2.0
# @since : 2022-10-14
# @desc : support RHEL 7+, Oracle Linux 7+, Ubuntu 18.04+, RockyOS 8+, CentOS 7+, macOS 11+
# @installation :
# 1. insert 'source <path>/ssh-proxy.completion' into ~/.bashrc or ~/.bash_profile for a personal usage.
# 2. copy the completion file to /usr/share/bash-completion/completions/ssh-proxy (1st) or /etc/bash_completion.d/ssh-proxy.completion (2nd) for all users.
# =======================================

set -Eeuo pipefail

readonly FILENAME="$(basename "$0")"
readonly DEST_FILE="${HOME}/ssh-proxy.services"

##
# 오류 원인 및 콜스택 진단 정보를 포맷팅하여 표준 에러(stderr)로 출력합니다.
#
# @param $1 {string} 실패 원인 메시지
# @param $2 {string} 오류 발생 라인 번호
#
# @return 없음
##
print_error_box() {
  local cause="${1:-}"
  local line="${2:-UNKNOWN}"
  local indent=10
  local formatl=" - %-${indent}s: %s\n"
  local formatr=" - %${indent}s: %s\n"
  echo >&2
  echo "================================================================================" >&2
  printf "$formatl" "filename" "$FILENAME" >&2
  printf "$formatl" "line" "$line" >&2
  printf "$formatl" "callstack" "" >&2
  local idx=1
  local func
  for func in "${FUNCNAME[@]:2}"; do
    printf "$formatr" "[$idx]" "$func" >&2
    ((idx++)) || true
  done
  printf "$formatl" "cause" "$cause" >&2
  echo "================================================================================" >&2
}

##
# 도움말 및 사용법을 출력합니다.
#
# @param $1 {string} (선택) 오류 원인 메시지
# @param $2 {string} (선택) 오류 발생 라인 번호
#
# @return 없음
##
help() {
  local cause="${1:-}"
  local line="${2:-}"
  if [[ -n "$cause" ]]; then
    print_error_box "$cause" "$line"
  fi
  cat << EOF

사용법 (Usage):
  # 1. 점프 프록시를 통한 대상 서버 접속 (-J 모드, 기본값)
  $FILENAME [sts-user@]<sts-host>:<sts-port>/<dest-user>@<dest-server> [추가 SSH 옵션...]

  # 2. 점프 없이 프록시/터널링 서버 자체로 직접 접속 (--no-jump 모드)
  $FILENAME [sts-user@]<sts-host>:<sts-port> --no-jump [추가 SSH 옵션...]
  $FILENAME [sts-user@]<sts-host>:<sts-port>/<dest-user>@<dest-server> --no-jump [추가 SSH 옵션...]

  # 3. 대상 서버(dest-server) 관리 기능
  $FILENAME --service-list
  $FILENAME --service-add "<service-name>=<host> [-p <port>]"
  $FILENAME --service-delete <service-name>
  $FILENAME --service-file <service-properties-file>

설명 (Descriptions):
  sts-user     : 프록시(점프/바스천) 서버 사용자명 (생략 시 로컬 사용자)
  sts-host     : 프록시(점프/바스천) 서버 호스트 (IP 또는 도메인)
  sts-port     : 프록시(점프/바스천) 서버 SSH 포트 (1 ~ 65535)
  dest-user    : 최종 목적지 서버 사용자명
  dest-server  : 최종 목적지 서버 이름 (등록된 서비스명 또는 IP/호스트)

옵션 (Options):
  --no-jump            프록시 점프(-J)를 사용하지 않고 프록시 서버 자체로 직접 접속
  --service-list       등록된 목적지 서비스 목록 조회
  --service-add        새로운 목적지 서비스 추가 (<name>=<host> [-p <port>])
  --service-delete     등록된 목적지 서비스 삭제
  --service-file       외부 파일의 서비스 목록으로 전체 갱신/가져오기
  --help               이 도움말 출력 및 종료

참고 (Notes):
  * 대상 서비스 설정 파일: $DEST_FILE
  * dest-server가 등록된 서비스명이 아닐 경우, 입력한 호스트(IP/도메인)로 직접 접속을 시도합니다.
EOF
}

##
# 지정한 포트 번호가 1 ~ 65535 범위 내의 유효한 정수인지 검증합니다.
#
# @param $1 {string} 포트 번호
#
# @return 0 (유효), 1 (무효)
##
is_valid_port() {
  local port="$1"
  [[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 ))
}

##
# 서비스 설정 파일이 존재하지 않는 경우 기본 템플릿과 함께 초기화합니다.
#
# @param $1 {string} (선택) 서비스 파일 경로
#
# @return 없음
##
init_service_file() {
  local file="${1:-$DEST_FILE}"
  if [[ ! -f "$file" ]]; then
    mkdir -p "$(dirname "$file")"
    cat << 'EOF' > "$file"
# SSH Tunneling Destination Services
# Format: <service-name>=<host> [-p <port>]
EOF
  fi
}

##
# 파일에서 목적지 서비스 목록을 읽어 연관 배열(associative array)에 로드합니다.
#
# @param $1 {string} 파일 경로
# @param $2 {string} 결과를 저장할 연관 배열 변수명 (nameref 참조)
#
# @return 없음
##
load_services_to_hash() {
  local file="$1"
  declare -n target_hash="$2"
  [[ -f "$file" ]] || return 0

  local line key value
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    if [[ "$line" =~ ^([^=]+)=(.*)$ ]]; then
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"
      key="$(echo -e "${key}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
      value="$(echo -e "${value}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
      if [[ -n "$key" ]]; then
        target_hash["$key"]="$value"
      fi
    fi
  done < "$file"
}

##
# 연관 배열의 내용을 서비스 파일 형식으로 저장합니다.
#
# @param $1 {string} 연관 배열 변수명 (nameref 참조)
# @param $2 {string} 파일 경로
# @param $3 {string} (선택) 저장 시 제외할 서비스 키 이름
#
# @return 없음
##
save_hash_to_services() {
  declare -n src_hash="$1"
  local file="$2"
  local exclude_key="${3:-}"

  mkdir -p "$(dirname "$file")"
  local tmp_file
  tmp_file="$(mktemp "${file}.tmp.XXXXXX")"

  {
    echo "# SSH Tunneling Destination Services"
    echo "# Format: <service-name>=<host> [-p <port>]"
    for key in "${!src_hash[@]}"; do
      if [[ -n "$exclude_key" && "$key" == "$exclude_key" ]]; then
        continue
      fi
      printf "%s=%s\n" "$key" "${src_hash[$key]}"
    done
  } | sort > "$tmp_file"

  mv "$tmp_file" "$file"
}

##
# 등록된 목적지 서비스 목록을 포맷팅하여 출력합니다.
#
# @return 없음
##
list_services() {
  init_service_file "$DEST_FILE"
  echo
  echo "📋 [SSH 목적지 서비스 목록: $DEST_FILE]"
  echo "--------------------------------------------------"
  local count=0
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    printf "  • %s\n" "$line"
    ((count++)) || true
  done < "$DEST_FILE"
  if (( count == 0 )); then
    echo "  (등록된 서비스가 없습니다. '--service-add <이름>=<호스트> [-p <포트>]' 로 추가하세요.)"
  fi
  echo "--------------------------------------------------"
  echo "총 ${count}건"
  echo
}

##
# 새로운 목적지 서비스를 추가하거나 기존 서비스를 갱신합니다.
#
# @param $1 {string} 서비스 등록 문자열 (<이름>=<호스트> [-p <포트>])
#
# @return 없음
##
add_service() {
  local entry="$1"
  if [[ ! "$entry" =~ ^([^=]+)=(.+)$ ]]; then
    help "잘못된 서비스 형식입니다: '$entry' (예: my-server=192.168.1.100 -p 2222)" "$LINENO"
    exit 1
  fi
  local name="${BASH_REMATCH[1]}"
  local target_val="${BASH_REMATCH[2]}"
  name="$(echo -e "${name}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  target_val="$(echo -e "${target_val}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"

  init_service_file "$DEST_FILE"
  declare -A svc_table=()
  load_services_to_hash "$DEST_FILE" svc_table
  svc_table["$name"]="$target_val"
  save_hash_to_services svc_table "$DEST_FILE"
  echo "✅ 서비스가 성공적으로 추가/갱신되었습니다: $name = $target_val"
}

##
# 등록된 목적지 서비스를 삭제합니다.
#
# @param $1 {string} 삭제할 서비스 이름
#
# @return 없음
##
delete_service() {
  local name="$1"
  if [[ -z "$name" ]]; then
    help "삭제할 서비스 이름을 지정해야 합니다." "$LINENO"
    exit 1
  fi
  init_service_file "$DEST_FILE"
  declare -A svc_table=()
  load_services_to_hash "$DEST_FILE" svc_table
  if [[ -z "${svc_table[$name]:-}" ]]; then
    echo "⚠️  서비스 '$name'이(가) 등록되어 있지 않습니다."
    return 0
  fi
  save_hash_to_services svc_table "$DEST_FILE" "$name"
  echo "🗑️  서비스가 삭제되었습니다: $name"
}

##
# 외부 파일로부터 목적지 서비스 목록을 읽어 전체 갱신합니다.
#
# @param $1 {string} 가져올 서비스 파일 경로
#
# @return 없음
##
update_service_from_file() {
  local src_file="$1"
  if [[ ! -f "$src_file" ]]; then
    help "지정한 서비스 파일을 찾을 수 없습니다: '$src_file'" "$LINENO"
    exit 1
  fi
  declare -A svc_table=()
  load_services_to_hash "$src_file" svc_table
  save_hash_to_services svc_table "$DEST_FILE"
  echo "🔄 서비스 파일('$src_file')로부터 목록을 성공적으로 갱신하였습니다."
}

##
# 메인 진입점: CLI 인자 파싱 및 SSH 연결 실행
##
main() {
  if [[ $# -eq 0 ]]; then
    help "접속할 프록시 및 목적지 정보를 입력해야 합니다." "$LINENO"
    exit 1
  fi

  local no_jump=0
  local raw_endpoint=""
  local -a extra_opts=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --service-add)
        shift
        if [[ $# -eq 0 || -z "${1:-}" ]]; then
          help "추가할 서비스 정보를 '<이름>=<호스트> [-p <포트>]' 형식으로 입력해야 합니다." "$LINENO"
          exit 1
        fi
        add_service "$1"
        list_services
        exit 0
        ;;
      --service-file)
        shift
        if [[ $# -eq 0 || -z "${1:-}" ]]; then
          help "가져올 서비스 파일 경로를 지정해야 합니다." "$LINENO"
          exit 1
        fi
        update_service_from_file "$1"
        list_services
        exit 0
        ;;
      --service-delete)
        shift
        if [[ $# -eq 0 || -z "${1:-}" ]]; then
          help "삭제할 서비스 이름을 지정해야 합니다." "$LINENO"
          exit 1
        fi
        delete_service "$1"
        list_services
        exit 0
        ;;
      --service-list)
        list_services
        exit 0
        ;;
      --no-jump)
        no_jump=1
        shift
        ;;
      --help)
        help "" ""
        exit 0
        ;;
      -*)
        # 추가 SSH 옵션들(-i, -p, -X, -v 등)
        extra_opts+=("$1")
        shift
        ;;
      *)
        if [[ -z "$raw_endpoint" ]]; then
          raw_endpoint="$1"
        else
          extra_opts+=("$1")
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$raw_endpoint" ]]; then
    help "접속 정보(호스트/대상)를 입력해야 합니다." "$LINENO"
    exit 1
  fi

  local proxy_part=""
  local target_part=""

  if [[ "$raw_endpoint" == *"/"* ]]; then
    proxy_part="${raw_endpoint%%/*}"
    target_part="${raw_endpoint#*/}"
  else
    proxy_part="$raw_endpoint"
    target_part=""
  fi

  # 프록시 정보 파싱
  local proxy_user=""
  local proxy_host_port=""
  if [[ "$proxy_part" == *"@"* ]]; then
    proxy_user="${proxy_part%%@*}"
    proxy_host_port="${proxy_part#*@}"
  else
    proxy_host_port="$proxy_part"
  fi

  local proxy_host=""
  local proxy_port=""
  if [[ "$proxy_host_port" == *":"* ]]; then
    proxy_host="${proxy_host_port%%:*}"
    proxy_port="${proxy_host_port#*:}"
  else
    proxy_host="$proxy_host_port"
    proxy_port="22"
  fi

  if [[ -z "$proxy_host" ]]; then
    help "프록시(터널링) 서버 호스트가 지정되지 않았습니다: '$proxy_part'" "$LINENO"
    exit 1
  fi

  if ! is_valid_port "$proxy_port"; then
    help "유효하지 않은 프록시 포트입니다: '$proxy_port' (범위: 1 ~ 65535)" "$LINENO"
    exit 1
  fi

  # No-Jump(-nj) 모드 검증
  if (( no_jump == 1 )); then
    local -a ssh_cmd=("ssh")
    if [[ "$proxy_port" != "22" ]]; then
      ssh_cmd+=("-p" "$proxy_port")
    fi
    if (( ${#extra_opts[@]} > 0 )); then
      ssh_cmd+=("${extra_opts[@]}")
    fi
    if [[ -n "$proxy_user" ]]; then
      ssh_cmd+=("${proxy_user}@${proxy_host}")
    else
      ssh_cmd+=("${proxy_host}")
    fi

    echo
    printf "\033[1;36m[직접 접속 실행 (No Jump)]\033[0m %s\n" "${ssh_cmd[*]}"
    echo
    exec "${ssh_cmd[@]}"
  fi

  # 점프 프록시(-J) 모드: 대상 서버(target_part) 필수
  if [[ -z "$target_part" ]]; then
    help "점프 프록시 모드에서는 대상 서버 정보('/<dest-user>@<dest-server>')가 필요합니다. 직접 접속하려면 -nj 옵션을 사용하세요." "$LINENO"
    exit 1
  fi

  local target_user=""
  local target_name=""
  if [[ "$target_part" == *"@"* ]]; then
    target_user="${target_part%%@*}"
    target_name="${target_part#*@}"
  else
    target_name="$target_part"
  fi

  if [[ -z "$target_name" ]]; then
    help "대상 서버(dest-server) 이름이 비어 있습니다: '$target_part'" "$LINENO"
    exit 1
  fi

  init_service_file "$DEST_FILE"
  declare -A svc_table=()
  load_services_to_hash "$DEST_FILE" svc_table

  local dest_entry=""
  if [[ -n "${svc_table[$target_name]:-}" ]]; then
    dest_entry="${svc_table[$target_name]}"
  else
    # 등록된 서비스가 아니면 입력된 값을 직접 대상 호스트/IP로 간주
    dest_entry="$target_name"
  fi

  local dest_host=""
  local dest_port=""

  # dest_entry 파싱 (예: "192.168.1.10 -p 2222" 또는 "192.168.1.10")
  if [[ "$dest_entry" =~ ^([^[[:space:]]+)[[:space:]]+-p[[:space:]]+([0-9]+)$ ]]; then
    dest_host="${BASH_REMATCH[1]}"
    dest_port="${BASH_REMATCH[2]}"
  elif [[ "$dest_entry" =~ ^([^[[:space:]]+):([0-9]+)$ ]]; then
    dest_host="${BASH_REMATCH[1]}"
    dest_port="${BASH_REMATCH[2]}"
  else
    dest_host="$(echo -e "$dest_entry" | awk '{print $1}')"
    dest_port=""
  fi

  if [[ -n "$dest_port" ]] && ! is_valid_port "$dest_port"; then
    help "대상 서버의 포트 번호가 유효하지 않습니다: '$dest_port'" "$LINENO"
    exit 1
  fi

  # SSH 명령어 구성
  local jump_spec=""
  if [[ -n "$proxy_user" ]]; then
    jump_spec="${proxy_user}@${proxy_host}"
  else
    jump_spec="${proxy_host}"
  fi
  if [[ -n "$proxy_port" && "$proxy_port" != "22" ]]; then
    jump_spec="${jump_spec}:${proxy_port}"
  fi

  local -a ssh_cmd=("ssh" "-J" "$jump_spec")
  if [[ -n "$dest_port" && "$dest_port" != "22" ]]; then
    ssh_cmd+=("-p" "$dest_port")
  fi
  if (( ${#extra_opts[@]} > 0 )); then
    ssh_cmd+=("${extra_opts[@]}")
  fi

  if [[ -n "$target_user" ]]; then
    ssh_cmd+=("${target_user}@${dest_host}")
  else
    ssh_cmd+=("${dest_host}")
  fi

  echo
  printf "\033[1;32m[SSH 프록시 접속 실행]\033[0m %s\n" "${ssh_cmd[*]}"
  echo
  exec "${ssh_cmd[@]}"
}

main "$@"
