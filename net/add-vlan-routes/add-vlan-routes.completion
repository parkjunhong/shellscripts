# =======================================
# @author : parkjunhong77@gmail.com
# @title : add-vlan-routes bash completion.
# @license : Apache License 2.0
# @since : 2026-07-23
# @desc : support macOS 11.2.3+, Ubuntu 18.04+, Debian, RHEL 7+ (Rocky, CentOS, Oracle, AlmaLinux, Fedora), Arch Linux (Manjaro, EndeavourOS), SUSE, Alpine, and universal Linux
# @installation :
# 1. insert 'source <path>/add-vlan-routes.completion' into ~/bin/.bashrc or ~/bin/.bash_profile for a personal usage.
# 2. copy the above file to /etc/bash_completion.d/ or insert 'source <path>/add-vlan-routes.completion' into /etc/bashrc for all users.
# =======================================

# =======================================
# [Bash Completion Parameter Description]
# 1. COMP_WORDS: an array containing all individual words in the current command line
#    (현재 커맨드 라인에 입력된 단어들의 배열)
# 2. COMP_CWORD: an index of the word containing the current cursor position
#    (현재 커서가 위치한 단어의 인덱스)
# 3. COMP_LINE: the current command line string
#    (현재까지 커맨드 라인에 입력된 전체 문자열)
# 4. COMPREPLY: an array variable from which Bash reads the possible completions
#    (bash completion이 제안할 단어들의 배열)
#
# Arguments of completion function:
# - $1: name of the command whose arguments are being completed (명령의 이름)
# - $2: word being completed (현재 커서에서 완성하려고 하는 단어)
# - $3: word preceding the word being completed (현재 완성하려는 단어의 바로 이전 단어)
# =======================================

_add_vlan_routes() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    # 스크립트에서 지원하는 전체 옵션 목록
    local all_opts="-h --help -d --dry-run -a --add-vlan-networks -r --remove-vlan-networks"
    opts=""

    # 이미 입력한 옵션은 다시 제안하지 않도록 필터링 (반복 사용 가능 옵션 없음)
    for opt in $all_opts; do
        local is_used=false
        # 마지막 단어(현재 입력 중인 단어)를 제외하고 이전까지 입력된 단어들 검사
        for (( i=1; i < ${#COMP_WORDS[@]}-1; i++ )); do
            if [[ "${COMP_WORDS[i]}" == "$opt" ]]; then
                is_used=true
                break
            fi
        done
        
        # 사용되지 않은 옵션만 제안 풀(Pool)에 추가
        if [[ "$is_used" == false ]]; then
            opts="$opts $opt"
        fi
    done

    case "${prev}" in
        -a|--add-vlan-networks|-r|--remove-vlan-networks)
            # 대역(CIDR)을 입력해야 하는 위치이므로, 디렉터리 내 파일명이 뜨지 않도록 빈 배열 반환
            COMPREPLY=()
            return 0
            ;;
        *)
            # 사용 가능한 옵션들에 대해 자동 완성 제공
            COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
            return 0
            ;;
    esac
}

# 'add-vlan-routes' 명령어에 _add_vlan_routes 완성 함수를 바인딩
complete -F _add_vlan_routes add-vlan-routes
