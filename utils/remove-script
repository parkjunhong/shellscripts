# @desc : support RHEL 8+, Oracle Linux 8+, Ubuntu 20.04+, RockyOS 8+, CentOS 7+
# @installation : 
# 1. insert 'source <path>/remove-script.completion' into ~/bin/.bashrc or ~/bin/.bash_profile for a personal usage.
# 2. copy the above file to /etc/bash_completion.d/ or insert 'source <path>/remove-script' into '/etc/bashrc' or '/usr/share/bash-completion/completions/' for all users.
# =======================================
# Global Reserved Variables
# 1. COMP_WORDS: an array, contains all arguments
# 2. COMP_CWORD: a index of a cursor
# 3. COMP_LINE: all command string
# 4. COMPREPLY: an array, contains suggested words. words are sorted and unique.
# Arguments of a function
# 1. $1: command
# 2. $2: current
# 3. $3: previous
#
# e.g.: mycmd arg1 arg2 arg3 arg4[tab]
# - $1: mycmd
# - $2: arg4
# - $3: arg3

set -Eeuo pipefail

FILENAME=$(basename "$0")

##
# 도움말 및 오류 콜스택 출력 함수
#
# @param $1 {string} 오류 원인 메시지 (선택 사항)
# @param $2 {number} 오류 발생 행 번호 (선택 사항)
#
# @return 없음 (표준 에러 및 표준 출력으로 도움말 메시지 출력)
##
help(){
  if [ ! -z "${1:-}" ];
  then
    local indent=10
    local formatl=" - %-"$indent"s: %s\n"
    local formatr=" - %"$indent"s: %s\n"
    echo
    echo "================================================================================"
    printf "$formatl" "filename" "$FILENAME"
    printf "$formatl" "line" "${2:-unknown}"
    printf "$formatl" "callstack"
    local idx=1
    for func in ${FUNCNAME[@]:1}
    do 
      printf "$formatr" "["$idx"]" $func
      ((idx++))
    done
    printf "$formatl" "cause" "$1"
    echo "================================================================================"
  fi 
  echo 
  echo "사용법:"
  echo "  $FILENAME --name <스크립트명_또는_경로> [옵션]"
  echo
  echo "설명:"
  echo "  지정된 스크립트 파일과 관련된 bash completion 파일을 탐색하여 안전하게 삭제합니다."
  echo "  단축 옵션(Short Option)은 지원하지 않으며, 오직 전체 옵션명만 사용 가능합니다."
  echo "  본 도구는 'sudo'로 직접 실행할 수 없으며, 권한이 필요한 대상에 한해 동적으로 sudo를 적용합니다."
  echo
  echo "옵션:"
  echo "  --name <NAME>   삭제할 스크립트 파일명 또는 경로 (필수)"
  echo "  --force         사용자 확인 대화창을 건너뛰고 즉시 삭제"
  echo "  --dry-run       실제 삭제를 수행하지 않고 삭제 대상 파일 목록 및 필요 권한만 확인"
  echo "  --help          도움말 출력"
  echo
  echo "예시:"
  echo "  $FILENAME --name deploy.sh"
  echo "  $FILENAME --name /usr/local/bin/custom-tool --dry-run"
  echo "  $FILENAME --name backup.sh --force"
}

##
# 대상 파일 삭제에 sudo 권한이 필요한지 여부 판별
#
# @param $1 {string} 검증할 파일 절대 경로
#
# @return 0 (sudo 필요), 1 (일반 사용자 권한으로 삭제 가능)
##
is_sudo_required() {
  local target_path="$1"
  local parent_dir
  parent_dir=$(dirname "$target_path")

  # 1. 상위 디렉토리에 쓰기 권한이 없는 경우 sudo 필수
  if [[ ! -w "$parent_dir" ]]; then
    return 0
  fi

  # 2. 상위 디렉토리에 Sticky bit(+t)가 설정된 경우 (예: /tmp)
  if [[ -k "$parent_dir" ]]; then
    local current_uid file_uid dir_uid
    current_uid=$(id -u)
    file_uid=$(stat -c '%u' "$target_path" 2>/dev/null || echo "$current_uid")
    dir_uid=$(stat -c '%u' "$parent_dir" 2>/dev/null || echo "$current_uid")
    
    # 현재 사용자가 파일 소유자도 아니고 디렉토리 소유자도 아닌 경우 삭제 불가 -> sudo 필요
    if [[ "$current_uid" != "$file_uid" && "$current_uid" != "$dir_uid" ]]; then
      return 0
    fi
  fi

  return 1
}

##
# 시스템 보호 바이너리 및 패키지 관리 대상 파일 여부 검증
#
# @param $1 {string} 검증할 파일 절대 경로
#
# @return 0 (시스템 보호 파일임 -> 삭제 차단), 1 (보호 대상 아님 -> 삭제 허용)
##
is_protected_system_tool() {
  local target_path="$1"
  local base_name
  base_name=$(basename "$target_path")

  # 1. OS 핵심 유틸리티 블랙리스트 점검
  local protected_tools=(
    "bash" "sh" "dash" "zsh" "ksh" "csh" "tcsh"
    "ls" "rm" "cp" "mv" "cat" "chmod" "chown" "chgrp" "mkdir" "rmdir"
    "touch" "ln" "sed" "awk" "grep" "egrep" "fgrep" "find" "tar"
    "gzip" "gunzip" "bzip2" "xz" "systemctl" "journalctl" "init" "service"
    "mount" "umount" "df" "du" "ps" "top" "kill" "killall" "pkill"
    "sudo" "su" "passwd" "login" "ssh" "sshd" "curl" "wget" "python"
    "python3" "perl" "ruby" "gcc" "make" "apt" "apt-get" "dpkg" "yum"
    "dnf" "rpm" "which" "whereis" "env" "vi" "vim" "nano"
  )

  for tool in "${protected_tools[@]}"; do
    if [[ "$base_name" == "$tool" ]]; then
      return 0
    fi
  done

  # 2. 컴파일된 실행 파일(ELF 바이너리) 여부 점검 (스크립트 파일만 삭제 허용)
  if command -v file >/dev/null 2>&1; then
    local mime_type
    mime_type=$(file -b --mime-type "$target_path" 2>/dev/null || true)
    if [[ "$mime_type" == "application/x-executable" || "$mime_type" == "application/x-pie-executable" || "$mime_type" == "application/x-sharedlib" ]]; then
      return 0
    fi
  fi

  # 3. RPM 패키지 관리자 소속 여부 검사 (RHEL, CentOS, Rocky, Oracle Linux)
  if command -v rpm >/dev/null 2>&1; then
    if rpm -qf "$target_path" >/dev/null 2>&1; then
      return 0
    fi
  fi

  # 4. DPKG 패키지 관리자 소속 여부 검사 (Ubuntu, Debian)
  if command -v dpkg >/dev/null 2>&1; then
    if dpkg -S "$target_path" >/dev/null 2>&1; then
      return 0
    fi
  fi

  # 5. 심볼릭 링크 원본 파일 추적 검사
  if [[ -L "$target_path" ]]; then
    local real_target
    real_target=$(readlink -f "$target_path" 2>/dev/null || true)
    if [[ -n "$real_target" && "$real_target" != "$target_path" ]]; then
      if is_protected_system_tool "$real_target"; then
        return 0
      fi
    fi
  fi

  return 1
}

##
# 스크립트 파일 검색 (중복 경로 자동 제거)
#
# @param $1 {string} 스크립트 명칭 또는 경로
#
# @return 표준 출력을 통한 발견된 파일의 고유 절대 경로 (개행 구분)
##
find_script_files() {
  local input_name="$1"
  local matched_files=()

  # 경로 구분자(/)가 포함된 경우 지정된 경로 직접 확인
  if [[ "$input_name" == *"/"* ]]; then
    if [[ -f "$input_name" || -L "$input_name" ]]; then
      local abs_path
      abs_path=$(cd "$(dirname "$input_name")" && pwd)/$(basename "$input_name")
      matched_files+=("$abs_path")
    fi
  else
    # PATH 환경변수 순회 탐색
    local IFS=':'
    local path_dirs
    read -r -a path_dirs <<< "$PATH"
    for dir in "${path_dirs[@]}"; do
      if [[ -d "$dir" ]]; then
        local candidate="$dir/$input_name"
        if [[ -f "$candidate" || -L "$candidate" ]]; then
          local resolved_path
          resolved_path=$(cd "$dir" && pwd)/$(basename "$candidate")
          matched_files+=("$resolved_path")
        fi
      fi
    done
  fi

  # 중복 제거(Deduplication) 후 출력
  if [ ${#matched_files[@]} -gt 0 ]; then
    printf "%s\n" "${matched_files[@]}" | sort -u
  fi
}

##
# bash completion 파일 검색 (엄격한 1:1 매칭 적용)
#
# @param $1 {string} 스크립트 명칭 또는 경로
#
# @return 표준 출력을 통한 발견된 completion 파일 고유 경로 (개행 구분)
##
find_completion_files() {
  local raw_name="$1"
  local base_name
  base_name=$(basename "$raw_name")

  # 조사 대상 bash completion 디렉토리 목록
  local search_dirs=(
    "/usr/share/bash-completion/completions"
    "/usr/share/bash-completion/completion"
    "/etc/bash_completion.d"
    "/etc/bash-completion.d"
    "${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions"
    "$HOME/.bash_completion.d"
  )

  # 엄격한 매칭 후보 정의 (확장자를 임의 제거하지 않음)
  local candidate_patterns=(
    "${base_name}.completion"
    "${base_name}"
  )

  local found_completions=()
  for dir in "${search_dirs[@]}"; do
    if [[ -d "$dir" ]]; then
      for pattern in "${candidate_patterns[@]}"; do
        local target="$dir/$pattern"
        if [[ -f "$target" || -L "$target" ]]; then
          local resolved_completion
          resolved_completion=$(cd "$dir" && pwd)/$(basename "$target")
          found_completions+=("$resolved_completion")
        fi
      done
    fi
  done

  # 중복 제거(Deduplication) 후 출력
  if [ ${#found_completions[@]} -gt 0 ]; then
    printf "%s\n" "${found_completions[@]}" | sort -u
  fi
}

##
# 메인 제어 함수
#
# @param $@ {array} 스크립트 실행 인자
#
# @return 0 (성공)
##
main() {
  # 0. Sudo/Root 직접 실행 차단 검증
  if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
    help "보안 정책 위반: '$FILENAME' 스크립트 자체를 sudo 또는 root 권한으로 직접 실행할 수 없습니다." "$LINENO"
    exit 1
  fi

  local target_name=""
  local is_force=false
  local is_dry_run=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          help "옵션 '--name' 뒤에 유효한 파일명을 지정해야 합니다." "$LINENO"
          exit 1
        fi
        target_name="$2"
        shift 2
        ;;
      --force)
        is_force=true
        shift
        ;;
      --dry-run)
        is_dry_run=true
        shift
        ;;
      --help)
        help ""
        exit 0
        ;;
      -*)
        help "단축 옵션(Short Option)은 지원하지 않습니다. 알 수 없는 옵션: '$1'" "$LINENO"
        exit 1
        ;;
      *)
        help "알 수 없는 인자입니다: '$1'" "$LINENO"
        exit 1
        ;;
    esac
  done

  # 1. 필수 파라미터 유효성 검사
  if [[ -z "$target_name" ]]; then
    help "'--name' 옵션은 필수입니다." "$LINENO"
    exit 1
  fi

  if [[ "$target_name" == "/" || "$target_name" == "." || "$target_name" == ".." ]]; then
    help "보안 경고: 위험한 파일명 또는 루트 경로는 지정할 수 없습니다: '$target_name'" "$LINENO"
    exit 1
  fi

  echo "[INFO] 삭제 대상 스크립트 및 completion 파일 탐색 시작: '$target_name'"

  # 2. 스크립트 파일 탐색 (중복 제거 완료)
  local script_targets=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && script_targets+=("$line")
  done < <(find_script_files "$target_name")

  # 3. 시스템 바이너리 및 패키지 관리 대상 여부 다계층 검증
  for file in "${script_targets[@]}"; do
    if is_protected_system_tool "$file"; then
      help "안전 위협 감지: '$file' 은(는) OS 핵심 유틸리티이거나 패키지 관리자(RPM/DPKG)에 등록된 바이너리입니다. 시스템 보호를 위해 삭제가 거부되었습니다." "$LINENO"
      exit 1
    fi
  done

  # 4. completion 파일 탐색 (엄격한 1:1 매칭 및 중복 제거 완료)
  local completion_targets=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && completion_targets+=("$line")
  done < <(find_completion_files "$target_name")

  # 5. 탐색 결과 검증
  if [ ${#script_targets[@]} -eq 0 ] && [ ${#completion_targets[@]} -eq 0 ]; then
    echo "[WARN] 삭제 대상 스크립트 및 bash completion 파일을 찾을 수 없습니다."
    exit 0
  fi

  # 6. 대상 파일 목록 및 필요 권한 분석 출력
  echo
  echo "==================== [삭제 대상 파일 목록] ===================="
  if [ ${#script_targets[@]} -gt 0 ]; then
    echo " [스크립트 파일]"
    for item in "${script_targets[@]}"; do
      if is_sudo_required "$item"; then
        echo "  -> $item [sudo 권한 필요]"
      else
        echo "  -> $item [일반 권한]"
      fi
    done
  fi

  if [ ${#completion_targets[@]} -gt 0 ]; then
    echo " [Bash Completion 파일]"
    for item in "${completion_targets[@]}"; do
      if is_sudo_required "$item"; then
        echo "  -> $item [sudo 권한 필요]"
      else
        echo "  -> $item [일반 권한]"
      fi
    done
  fi
  echo "=============================================================="
  echo

  # 7. Dry-run 모드 처리
  if [ "$is_dry_run" = true ]; then
    echo "[DRY-RUN] 시뮬레이션 모드이므로 실제 파일을 삭제하지 않고 안전하게 종료합니다."
    exit 0
  fi

  # 8. Sudo 필요 여부 사전 검증 및 사전 인증(Pre-flight Sudo Check)
  local all_targets=("${script_targets[@]}" "${completion_targets[@]}")
  local need_sudo=false

  for file in "${all_targets[@]}"; do
    if is_sudo_required "$file"; then
      need_sudo=true
      break
    fi
  done

  if [ "$need_sudo" = true ]; then
    if ! command -v sudo >/dev/null 2>&1; then
      help "시스템 오류: 일부 시스템 파일 삭제를 위해 'sudo'가 필요하지만 시스템에 sudo 명령어가 설치되어 있지 않습니다." "$LINENO"
      exit 1
    fi
    echo "[INFO] 시스템 보호 영역 파일 삭제를 위해 sudo 자격 증명을 사전 확인합니다."
    if ! sudo -v; then
      help "인증 오류: sudo 인증에 실패하였거나 권한이 없어 삭제 작업을 전면 중단합니다." "$LINENO"
      exit 1
    fi
  fi

  # 9. 대화형 사용자 확인
  if [ "$is_force" = false ]; then
    local confirm=""
    printf "위 파일들을 영구히 삭제하시겠습니까? (y/N): "
    read -r confirm
    if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
      echo "[ABORT] 사용자에 의해 삭제가 취소되었습니다."
      exit 0
    fi
  fi

  # 10. 파일 삭제 실행 (동적 sudo 적용)
  for file in "${all_targets[@]}"; do
    if is_sudo_required "$file"; then
      sudo rm -f "$file"
      echo "[SUCCESS] 삭제 완료 (sudo 적용) -> $file"
    else
      rm -f "$file"
      echo "[SUCCESS] 삭제 완료 (일반 권한) -> $file"
    fi
  done

  echo
  echo "[완료] 모든 관련 파일이 성공적으로 삭제되었습니다."
}

main "$@"

exit 0
