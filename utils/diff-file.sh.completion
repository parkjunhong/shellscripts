# @author   : parkjunhong77@gmail.com
# @title    : search files.
# @license  : Apache License 2.0
# @since    : 2026-08-12
# @desc     : support RHEL 9+, Oracle Linux 9+, Ubuntu 22.04+, RockyOS 9+, CentOS 9+
# @installation : 
#   1. insert 'source <path>/diff-file.sh.completion" into ~/bin/.bashrc or ~/bin/.bash_profile for a personal usage.
#   2. copy the above file to /etc/bash_completion.d/ or insert 'source <path>/diff-file.sh.completion' into /etc/bashrc for all users.
# =======================================
# Global Reserved Variables
# 1. COMP_WORDS: an array, contains all arguments
# 2. COMP_CWORD: a index of a cursor
# 3. COMP_LINE: all command string
# 4. COMPREPLY: an array, contains suggested words. words are sorted and unique.
#
# Arguments of a function
# 1. $1: command
# 2. $2: current
# 3. $3: previous
#
# e.g.: mycmd arg1 arg2 arg3 arg4[tab]
# - $1: mycmd
# - $2: arg4
# - $3: arg3
# =======================================

##
# diff-file.sh 스크립트의 자동완성(Auto-completion)을 지원하는 함수입니다.
# Auto-completion function for diff-file.sh script.
##
_diff_file_completion() {
  local cur prev opts available_opts opt is_used word
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"

  # 스크립트 지원 기본 옵션들 / Command options list
  opts="-h --help -d --directory -s --source -f --file --copy-content --dry-run"

  # 이전 파라미터에 따른 동적 컨텍스트 분기 / Branching dynamic context based on previous parameter
  case "${prev}" in
    -d|--directory)
      # 디렉토리 전용 추천 (공백 추가 방지 및 ~ 확장 지원)
      # Suggest directories only (delegate to Bash built-in)
      compopt -o dirnames 2>/dev/null || true
      COMPREPLY=()
      return 0
      ;;
    -s|--source)
      # 파일/디렉토리 일반 추천
      # Suggest files and directories natively
      compopt -o default 2>/dev/null || true
      COMPREPLY=()
      return 0
      ;;
    -f|--file)
      # 파일 패턴 입력 구간은 자동완성 차단 / Block auto-completion for raw pattern input
      return 0
      ;;
    *)
      ;;
  esac

  # 이미 입력된 옵션을 필터링하여 중복 추천 방지 / Filter out already entered options to prevent duplicates
  available_opts=""
  for opt in $opts; do
    is_used=0
    for word in "${COMP_WORDS[@]}"; do
      if [[ "$word" == "$opt" ]]; then
        is_used=1
        break
      fi
    done
    if [[ $is_used -eq 0 ]]; then
      available_opts="$available_opts $opt"
    fi
  done

  # 현재 커서 값이 비어있거나 '-'로 시작할 경우 오직 옵션만 제안
  # Suggest ONLY options if the current input is empty or starts with '-'
  if [[ -z "${cur}" || "${cur}" == -* ]]; then
    COMPREPLY=( $(compgen -W "${available_opts}" -- "${cur}") )
    return 0
  fi
  
  # 그 외 일반 탐색 시 기본 파일 탐색 폴백 허용 / Allow default file completion fallback for general inputs
  compopt -o default 2>/dev/null || true
  COMPREPLY=()
}

# 스크립트 파일명과 자동완성 함수 연결 / Bind completion function to the script
complete -F _diff_file_completion diff-file.sh