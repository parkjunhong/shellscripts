#!/usr/bin/env bash
set -euo pipefail

# =======================================
# @author       : parkjunhong77@gmail.com
# @title        : canonical-status: Canonical directory work status visualizer
# @license      : Apache License 2.0
# @since        : 2026-10-29
# @desc         : Check README.md existence in depth 1 and depth 2 subdirectories to visualize canonical work progress.
# @installation :
#   1. Copy this file to ~/bin/canonical-status or /usr/local/bin/canonical-status
#   2. Or install via scriptctl:
#      ../scriptctl/scriptctl install --script ./canonical-status --target local
# =======================================

FILENAME="$(basename "$0")"

# 기본 설정값
TARGET_DIR="$(pwd)"
EXCLUDE_DIRS=("__.snippets")
EXCLUDE_DIR_PATTERNS=()

# =======================================
# User Information & Usage
# =======================================

##
# 스크립트 사용법 및 도움말을 출력합니다.
#
# @return {int} 0
##
help() {
  cat <<EOF
사용법 (Usage):
  ${FILENAME} [options]

설명 (Description):
  지정된 디렉토리(기본값: 현재 디렉토리)의 하위 디렉토리(depth=1, depth=2) 내
  'README.md' 파일 존재 여부를 검사하여 Canonical 작업 진행 상태를 트리 형태로 시각화합니다.

  - depth=1에 'README.md' 존재        : ✅ 작업 완료
  - depth=1에 없고 depth=2에 존재     : 🚧 작업 중
  - depth=1, depth=2 모두 없음        : ❌ 작업 필요

Options:
  --target-dir <dir>
    - 검사할 기준 디렉토리 경로를 지정합니다. (기본값: 현재 작업 디렉토리)

  --exclude-dir <dir1> [dir2 ...] | --exclude-dir <dir1,dir2,...>
    - 탐색에서 제외할 하위 디렉토리 이름을 지정합니다.
    - 공백 구분 다중 인자, 콤마(,) 구분, 또는 옵션 반복 지정을 모두 지원합니다.
    - 숨김 디렉토리(.*)와 '__.snippets'는 기본으로 제외됩니다.

  --exclude-dir-pattern <pat1> [pat2 ...] | --exclude-dir-pattern <pat1,pat2,...>
    - 와일드카드(*) 패턴을 사용하여 탐색에서 제외할 하위 디렉토리를 지정합니다.
      * abc*  : 'abc'로 시작하는 디렉토리 제외
      * *abc  : 'abc'로 끝나는 디렉토리 제외
      * *abc* : 'abc'가 포함된 디렉토리 제외
    - 공백 구분 다중 인자, 콤마(,) 구분, 또는 옵션 반복 지정을 모두 지원합니다.

  --help
    - 이 도움말 메시지를 출력하고 종료합니다.

Examples:
  ${FILENAME}
  ${FILENAME} --target-dir ~/dev/bashshell-projects/github/shellscripts
  ${FILENAME} --target-dir . --exclude-dir temp backup
  ${FILENAME} --exclude-dir-pattern '__*' '*test*' '*bak'
  ${FILENAME} --exclude-dir-pattern '__*,*test*' --exclude-dir zip
EOF
}

# =======================================
# Helper Functions
# =======================================

##
# 콤마(,) 또는 단일 문자열로 전달된 제외 디렉토리 이름을 EXCLUDE_DIRS 배열에 추가합니다.
#
# @param $1 {string} 제외할 디렉토리 이름(콤마 구분 포함 가능)
# @return {int} 0
##
add_exclude_dirs() {
  local raw="$1"
  local item
  local -a parts=()
  IFS=',' read -r -a parts <<< "$raw"
  for item in "${parts[@]}"; do
    item="${item%/}"
    if [[ -n "$item" ]]; then
      EXCLUDE_DIRS+=("$item")
    fi
  done
}

##
# 콤마(,) 또는 단일 문자열로 전달된 제외 디렉토리 와일드카드 패턴을 EXCLUDE_DIR_PATTERNS 배열에 추가합니다.
#
# @param $1 {string} 제외할 디렉토리 와일드카드 패턴(콤마 구분 포함 가능, 예: abc*, *abc, *abc*)
# @return {int} 0
##
add_exclude_dir_patterns() {
  local raw="$1"
  local item
  local -a parts=()
  IFS=',' read -r -a parts <<< "$raw"
  for item in "${parts[@]}"; do
    item="${item%/}"
    if [[ -n "$item" ]]; then
      EXCLUDE_DIR_PATTERNS+=("$item")
    fi
  done
}

##
# 디렉토리 이름이 제외 대상인지 검사합니다.
# 숨김 디렉토리(.*), EXCLUDE_DIRS(정확히 일치), EXCLUDE_DIR_PATTERNS(와일드카드 패턴 일치)를 검사합니다.
#
# @param $1 {string} 검사할 디렉토리명 (basename)
# @return {int} 제외 대상이면 0(true), 아니면 1(false)
##
is_excluded_dir() {
  local dir_name="$1"

  # 1. 숨김 디렉토리(.*) 기본 제외
  if [[ "$dir_name" == .* ]]; then
    return 0
  fi

  # 2. 제외 디렉토리 이름(정확히 일치) 검사
  local ex
  for ex in "${EXCLUDE_DIRS[@]}"; do
    if [[ "$dir_name" == "$ex" ]]; then
      return 0
    fi
  done

  # 3. 제외 디렉토리 와일드카드 패턴(abc*, *abc, *abc*) 검사
  local pat
  for pat in "${EXCLUDE_DIR_PATTERNS[@]}"; do
    # shellcheck disable=SC2053
    if [[ "$dir_name" == $pat ]]; then
      return 0
    fi
  done

  return 1
}

##
# 1단계 하위 디렉토리(subdir_l1)의 Canonical 작업 상태를 판별합니다.
#
# @param $1 {string} subdir_l1 경로
# @return {stdout} 상태 문자열 ("✅ 작업 완료" | "🚧 작업 중" | "❌ 작업 필요")
##
check_dir_status() {
  local subdir_l1="$1"

  # 1. subdir_l1에 README.md가 있으면 '작업 완료'
  if [[ -f "${subdir_l1}/README.md" ]]; then
    printf "%s" "✅ 작업 완료"
    return 0
  fi

  # 2. subdir_l1에 README.md가 없으면 하위 depth=1(subdir_l2) 검사
  local subdir_l2
  local has_l2_readme="false"

  for subdir_l2 in "${subdir_l1}"/*/; do
    [[ -d "$subdir_l2" ]] || continue
    subdir_l2="${subdir_l2%/}"
    local l2_name
    l2_name="$(basename "$subdir_l2")"

    # 숨김 디렉토리는 건너뜀
    [[ "$l2_name" == .* ]] && continue

    if [[ -f "${subdir_l2}/README.md" ]]; then
      has_l2_readme="true"
      break
    fi
  done

  if [[ "$has_l2_readme" == "true" ]]; then
    printf "%s" "🚧 작업 중"
  else
    printf "%s" "❌ 작업 필요"
  fi
}

# =======================================
# CLI Argument Parsing (Long Options Only)
# =======================================

##
# 명령행 인자를 파싱합니다.
#
# @param $@ {array} 명령행 인자 목록
# @return {int} 0
##
parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target-dir)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "❌ 오류: '--target-dir' 옵션에 디렉토리 경로를 지정해야 합니다." >&2
          help >&2
          exit 1
        fi
        TARGET_DIR="$2"
        shift 2
        ;;
      --target-dir=*)
        local target_val="${1#*=}"
        if [[ -z "$target_val" ]]; then
          echo "❌ 오류: '--target-dir' 옵션에 디렉토리 경로를 지정해야 합니다." >&2
          help >&2
          exit 1
        fi
        TARGET_DIR="$target_val"
        shift
        ;;
      --exclude-dir)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "❌ 오류: '--exclude-dir' 옵션에 제외할 디렉토리 이름을 최소 1개 이상 지정해야 합니다." >&2
          help >&2
          exit 1
        fi
        shift
        while [[ $# -gt 0 && "$1" != --* ]]; do
          add_exclude_dirs "$1"
          shift
        done
        ;;
      --exclude-dir=*)
        local ex_val="${1#*=}"
        if [[ -z "$ex_val" ]]; then
          echo "❌ 오류: '--exclude-dir' 옵션에 제외할 디렉토리 이름을 최소 1개 이상 지정해야 합니다." >&2
          help >&2
          exit 1
        fi
        add_exclude_dirs "$ex_val"
        shift
        ;;
      --exclude-dir-pattern)
        if [[ $# -lt 2 || -z "${2:-}" || "${2:-}" == --* ]]; then
          echo "❌ 오류: '--exclude-dir-pattern' 옵션에 제외할 와일드카드 패턴을 최소 1개 이상 지정해야 합니다." >&2
          help >&2
          exit 1
        fi
        shift
        while [[ $# -gt 0 && "$1" != --* ]]; do
          add_exclude_dir_patterns "$1"
          shift
        done
        ;;
      --exclude-dir-pattern=*)
        local pat_val="${1#*=}"
        if [[ -z "$pat_val" ]]; then
          echo "❌ 오류: '--exclude-dir-pattern' 옵션에 제외할 와일드카드 패턴을 최소 1개 이상 지정해야 합니다." >&2
          help >&2
          exit 1
        fi
        add_exclude_dir_patterns "$pat_val"
        shift
        ;;
      --help)
        help
        exit 0
        ;;
      *)
        echo "❌ 오류: 알 수 없는 옵션입니다: $1" >&2
        help >&2
        exit 1
        ;;
    esac
  done
}

# =======================================
# Main Logic
# =======================================

main() {
  parse_args "$@"

  if [[ ! -d "$TARGET_DIR" ]]; then
    echo "❌ 오류: 대상 디렉토리가 존재하지 않습니다: ${TARGET_DIR}" >&2
    exit 1
  fi

  # 절대 경로 변환 및 표시용 경로(~) 포맷팅
  local abs_target_dir
  abs_target_dir="$(cd "$TARGET_DIR" && pwd)"
  local display_dir="$abs_target_dir"
  if [[ -n "${HOME:-}" && "$display_dir" == "${HOME}"* ]]; then
    display_dir="~${display_dir#"$HOME"}"
  fi

  shopt -s nullglob

  # 탐색 대상 1단계 하위 디렉토리 수집 및 최대 이름 길이 계산
  local target_subdirs=()
  local max_len=0
  local d dir_name name_len

  for d in "${abs_target_dir}"/*/; do
    [[ -d "$d" ]] || continue
    d="${d%/}"
    dir_name="$(basename "$d")"

    if is_excluded_dir "$dir_name"; then
      continue
    fi

    target_subdirs+=("$d")
    name_len="${#dir_name}"
    if (( name_len > max_len )); then
      max_len="$name_len"
    fi
  done

  # 헤더 출력
  printf "[directory] %s\n" "$display_dir"

  local total="${#target_subdirs[@]}"
  if (( total == 0 )); then
    printf "└── (하위 디렉토리 없음)\n"
    return 0
  fi

  # 트리 형태 시각화 출력
  local idx=0
  local subdir status_str branch_prefix
  for subdir in "${target_subdirs[@]}"; do
    idx=$((idx + 1))
    dir_name="$(basename "$subdir")"
    status_str="$(check_dir_status "$subdir")"

    if (( idx == total )); then
      branch_prefix="└──"
    else
      branch_prefix="├──"
    fi

    printf "%s %-${max_len}s : %s\n" "$branch_prefix" "$dir_name" "$status_str"
  done
}

main "$@"
