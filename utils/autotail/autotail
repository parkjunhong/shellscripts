#!/usr/bin/env bash

# ==============================================================================
# @author       : parkjunhong77@gmail.com
# @title        : wait for a target file to be created and follow tail
# @description  : 대상 파일이 생성될 때까지 대기한 후 생성 즉시 tail -f 실행
# @license      : Apache License 2.0
# @since        : 2020-02-19
# @installation : scriptctl install --script autotail
# ==============================================================================

FILE=""
N=10

while [ ! -z "$1" ];
do
  case "$1" in
    -h|--help)
      echo "Usage: autotail -f <filename> [-n <init line count>]"
      exit 0
      ;;
    -f|--file)
      shift

      if [ -z "$1" ];
      then
        echo "Wrong file name. filename=$1"
        exit 1
      fi
      FILE="$1"
      ;;
    -n|--lines)
      shift

      if [[ ! $1 =~ ^[0-9]+$ ]];
      then
        echo "Wrong line numbers. linenumber=$1"
        exit 1
      fi
      N=$1
      ;;
    *)
      ;;
  esac
  shift
done


if [ -z "${FILE}" ];
  then
    echo "Wrong file name. filename=${FILE}"
    exit 1
fi


count=0
while [ 1 ];
do
  if [ -f ${FILE} ];
  then
    break
  else
    ((count++))
    printf "\r\033[K[%'10d] No exists... file: %s" ${count} ${FILE}
    sleep 0.1
  fi
done

printf "\n"
tail -n ${N} -f ${FILE}

exit 0
