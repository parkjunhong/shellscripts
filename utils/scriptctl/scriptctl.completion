# =======================================
# @author : parkjunhong77@gmail.com
# @title : scriptctl bash completion.
# @license : Apache License 2.0
# @since : 2026-10-26
# @desc : support RHEL 8+, Oracle Linux 8+, Ubuntu 20.04+, RockyOS 8+, CentOS 7+
# @installation :
# 1. insert 'source <path>/scriptctl.completion' into ~/.bashrc or ~/.bash_profile for a personal usage.
# 2. copy the completion file to /usr/share/bash-completion/completions/scriptctl (1st) or /etc/bash_completion.d/scriptctl.completion (2nd) for all users.
# =======================================

# =======================================
# [Bash Completion Parameter Description]
# 1. COMP_WORDS: an array containing all individual words in the current command line
#    (현재 커맨드 라인에 입력된 단어들의 배열)
# 2. COMP_CWORD: an index of the word containing the current cursor position
#    (현재 커서가 위치한 단어의 인덱스)
# 3. COMP_LINE: the current command line string
#    (현재까지 커맨드 라인에 입력된 전체 문자열)
# 4. COMPREPLY: an array variable from which Bash reads the possible completions
#    (bash completion이 제안할 단어들의 배열)
#
# Arguments of completion function:
# - $1: name of the command whose arguments are being completed (명령의 이름)
# - $2: word being completed (현재 커서에서 완성하려고 하는 단어)
# - $3: word preceding the word being completed (현재 완성하려는 단어의 바로 이전 단어)
# =======================================

##
# 개인 실행 공간($HOME/bin, $HOME/.local/bin) 및 전역 실행 공간(/usr/local/bin)에
# 설치된 커스텀 스크립트 이름 목록을 조회합니다.
# - 현재 커맨드 라인의 '--target' 값(local | global | all)에 맞춰 조회 디렉토리를 동적으로 필터링합니다.
# - OS 핵심 유틸리티 블랙리스트는 후보에서 자동 제외합니다.
#
# @param $1 {string} 탐색 범위 (local | global | all)
#
# @return 줄바꿈으로 구분된 설치된 스크립트 파일명(basename) 목록 출력
##
_scriptctl_get_installed_script_names() {
  local scope="${1:-all}"
  local -a search_dirs=()

  case "$scope" in
    local)
      search_dirs=("${HOME}/bin" "${HOME}/.local/bin")
      ;;
    global)
      search_dirs=("/usr/local/bin")
      ;;
    all|*)
      search_dirs=("${HOME}/bin" "${HOME}/.local/bin" "/usr/local/bin")
      ;;
  esac

  local -a protected_tools=(
    "bash" "sh" "dash" "zsh" "ksh" "csh" "tcsh"
    "ls" "rm" "cp" "mv" "cat" "chmod" "chown" "chgrp" "mkdir" "rmdir"
    "touch" "ln" "sed" "awk" "grep" "egrep" "fgrep" "find" "tar"
    "gzip" "gunzip" "bzip2" "xz" "systemctl" "journalctl" "init" "service"
    "mount" "umount" "df" "du" "ps" "top" "kill" "killall" "pkill"
    "sudo" "su" "passwd" "login" "ssh" "sshd" "curl" "wget" "python"
    "python3" "perl" "ruby" "gcc" "make" "apt" "apt-get" "dpkg" "yum"
    "dnf" "rpm" "which" "whereis" "env" "vi" "vim" "nano"
  )

  local -a names=()
  local dir entry bname ptool is_protected
  for dir in "${search_dirs[@]}"; do
    [[ -d "$dir" ]] || continue
    for entry in "$dir"/*; do
      [[ -f "$entry" || -L "$entry" ]] || continue
      [[ ! -d "$entry" ]] || continue
      bname="$(basename "$entry")"

      is_protected=false
      for ptool in "${protected_tools[@]}"; do
        if [[ "$bname" == "$ptool" ]]; then
          is_protected=true
          break
        fi
      done
      [[ "$is_protected" == false ]] || continue

      names+=("$bname")
    done
  done

  if (( ${#names[@]} > 0 )); then
    printf "%s\n" "${names[@]}" | sort -u
  fi
}

##
# 파일 및 디렉토리 경로 자동 완성을 수행합니다.
# 디렉토리 매칭 시 끝에 불필요한 공백(' ')이 붙지 않고 'utils/' 형태로 완성되어
# 백스페이스 없이 하위 경로를 연속으로 탐색할 수 있도록 compopt -o filenames/nospace를 제어합니다.
#
# @param $1 {string} 현재 입력 중인 경로 문자열
# @param $2 {string} 출력 접두사 (기본값: '', '--script=*' 완성 시 '--script=')
#
# @return COMPREPLY 배열 및 compopt 설정
##
_scriptctl_complete_path() {
  local path_cur="$1"
  local opt_prefix="${2:-}"
  local candidate

  if [[ -z "$opt_prefix" ]]; then
    compopt -o filenames 2>/dev/null || true
    while IFS= read -r candidate; do
      [[ -n "$candidate" ]] && COMPREPLY+=("$candidate")
    done < <(compgen -f -- "$path_cur")
    if (( ${#COMPREPLY[@]} == 1 )) && [[ -d "${COMPREPLY[0]}" ]]; then
      compopt -o nospace 2>/dev/null || true
    fi
  else
    compopt -o nospace 2>/dev/null || true
    while IFS= read -r candidate; do
      [[ -n "$candidate" ]] || continue
      if [[ -d "$candidate" ]]; then
        COMPREPLY+=("${opt_prefix}${candidate%/}/")
      else
        COMPREPLY+=("${opt_prefix}${candidate}")
      fi
    done < <(compgen -f -- "$path_cur")
  fi
}

##
# scriptctl 명령어에 대한 Bash 자동 완성 처리 함수
#
# @param $1 {string} 명령어 이름 (Command name)
# @param $2 {string} 현재 커서에서 완성 중인 단어 (Current word)
# @param $3 {string} 직전 단어 (Previous word)
#
# @return COMPREPLY 배열 설정
##
_scriptctl_completion() {
  local cur prev
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]:-}"
  prev="${COMP_WORDS[COMP_CWORD-1]:-}"

  local -a subcommands=("install" "remove" "list" "--help")

  # 1. 첫 번째 인자(서브커맨드 위치) 자동 완성
  if (( COMP_CWORD == 1 )); then
    COMPREPLY=( $(compgen -W "${subcommands[*]}" -- "$cur") )
    return 0
  fi

  local subcmd="${COMP_WORDS[1]:-}"

  # 현재 커맨드 라인에서 이미 지정된 --target 값 감지 (기본값: all)
  local active_target="all"
  local i tok
  for (( i=2; i < ${#COMP_WORDS[@]}; i++ )); do
    (( i != COMP_CWORD )) || continue
    tok="${COMP_WORDS[i]}"
    if [[ "$tok" == "--target" && $((i + 1)) -lt ${#COMP_WORDS[@]} ]]; then
      active_target="${COMP_WORDS[i+1]}"
    elif [[ "$tok" == --target=* ]]; then
      active_target="${tok#--target=}"
    fi
  done

  # 2. 서브커맨드별 자동 완성 분기
  case "$subcmd" in
    install)
      local -a install_opts=("--script" "--target" "--force" "--dry-run" "--help")

      case "$cur" in
        --script=*)
          _scriptctl_complete_path "${cur#--script=}" "--script="
          return 0
          ;;
        --target=*)
          local target_part="${cur#--target=}"
          local candidate
          while IFS= read -r candidate; do
            [[ -n "$candidate" ]] && COMPREPLY+=("--target=${candidate}")
          done < <(compgen -W "local global" -- "$target_part")
          return 0
          ;;
      esac

      case "$prev" in
        --script)
          _scriptctl_complete_path "$cur" ""
          return 0
          ;;
        --target)
          COMPREPLY=( $(compgen -W "local global" -- "$cur") )
          return 0
          ;;
      esac

      local -a avail_opts=()
      local opt used_token already_used
      for opt in "${install_opts[@]}"; do
        already_used=false
        for (( i=2; i < ${#COMP_WORDS[@]}; i++ )); do
          (( i != COMP_CWORD )) || continue
          used_token="${COMP_WORDS[i]%%=*}"
          if [[ "$used_token" == "$opt" ]]; then
            already_used=true
            break
          fi
        done
        [[ "$already_used" == false ]] && avail_opts+=("$opt")
      done

      COMPREPLY=( $(compgen -W "${avail_opts[*]}" -- "$cur") )
      return 0
      ;;

    remove)
      local -a remove_opts=("--name" "--target" "--force" "--dry-run" "--help")

      case "$cur" in
        --name=*)
          local name_part="${cur#--name=}"
          local candidate
          if [[ "$name_part" == *"/"* ]]; then
            _scriptctl_complete_path "$name_part" "--name="
          else
            local installed_list
            installed_list="$(_scriptctl_get_installed_script_names "$active_target")"
            while IFS= read -r candidate; do
              [[ -n "$candidate" ]] && COMPREPLY+=("--name=${candidate}")
            done < <(compgen -W "$installed_list" -- "$name_part")
          fi
          return 0
          ;;
        --target=*)
          local target_part="${cur#--target=}"
          local candidate
          while IFS= read -r candidate; do
            [[ -n "$candidate" ]] && COMPREPLY+=("--target=${candidate}")
          done < <(compgen -W "local global all" -- "$target_part")
          return 0
          ;;
      esac

      case "$prev" in
        --name)
          # 사용자가 '/'가 포함된 경로를 직접 입력 중이면 파일 경로 완성,
          # 그렇지 않으면 개인 실행 공간($HOME/bin, $HOME/.local/bin) 및 전역(/usr/local/bin)의 설치된 스크립트 목록 완성
          if [[ "$cur" == *"/"* ]]; then
            _scriptctl_complete_path "$cur" ""
          else
            local installed_list
            installed_list="$(_scriptctl_get_installed_script_names "$active_target")"
            COMPREPLY=( $(compgen -W "$installed_list" -- "$cur") )
          fi
          return 0
          ;;
        --target)
          COMPREPLY=( $(compgen -W "local global all" -- "$cur") )
          return 0
          ;;
      esac

      local -a avail_opts=()
      local opt used_token already_used
      for opt in "${remove_opts[@]}"; do
        already_used=false
        for (( i=2; i < ${#COMP_WORDS[@]}; i++ )); do
          (( i != COMP_CWORD )) || continue
          used_token="${COMP_WORDS[i]%%=*}"
          if [[ "$used_token" == "$opt" ]]; then
            already_used=true
            break
          fi
        done
        [[ "$already_used" == false ]] && avail_opts+=("$opt")
      done

      COMPREPLY=( $(compgen -W "${avail_opts[*]}" -- "$cur") )
      return 0
      ;;

    list)
      local -a list_opts=("--target" "--help")

      case "$cur" in
        --target=*)
          local target_part="${cur#--target=}"
          local candidate
          while IFS= read -r candidate; do
            [[ -n "$candidate" ]] && COMPREPLY+=("--target=${candidate}")
          done < <(compgen -W "local global all" -- "$target_part")
          return 0
          ;;
      esac

      case "$prev" in
        --target)
          COMPREPLY=( $(compgen -W "local global all" -- "$cur") )
          return 0
          ;;
      esac

      local -a avail_opts=()
      local opt used_token already_used
      for opt in "${list_opts[@]}"; do
        already_used=false
        for (( i=2; i < ${#COMP_WORDS[@]}; i++ )); do
          (( i != COMP_CWORD )) || continue
          used_token="${COMP_WORDS[i]%%=*}"
          if [[ "$used_token" == "$opt" ]]; then
            already_used=true
            break
          fi
        done
        [[ "$already_used" == false ]] && avail_opts+=("$opt")
      done

      COMPREPLY=( $(compgen -W "${avail_opts[*]}" -- "$cur") )
      return 0
      ;;
  esac
}

complete -F _scriptctl_completion scriptctl ./scriptctl
