def split_tokens(raw_values: List[str], uppercase: bool = False) -> List[str]:
    """공백, 콤마(,), 파이프(|)로 구분된 인자를 중복 없이 순서대로 분리합니다."""
    result: List[str] = []
    for raw in raw_values:
        for token in re.split(r"[,|\s]+", raw.strip()):
            token = token.strip()
            if not token:
                continue
            if uppercase:
                token = token.upper()
            if token not in result:
                result.append(token)
    return result


def parse_args(argv: List[str]) -> AuditConfig:
    """Long Option 전용 CLI 인자를 파싱합니다."""
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--package", nargs="+", action="append", default=[])
    parser.add_argument("--oss-number", nargs="+", action="append", default=[])
    parser.add_argument("--show-changelog", action="store_true")
    parser.add_argument("--output", default="")
    parser.add_argument("--offline", action="store_true")
    parser.add_argument("--verbose", action="store_true")
    parser.add_argument("--help", action="store_true")

    if not argv:
        print_help()
        sys.exit(1)

    # 알 수 없는 옵션 또는 단일 하이픈(-) Short Option 차단
    for arg in argv:
        if arg.startswith("-") and not arg.startswith("--"):
            print(f"\033[1;31m[ERROR]\033[0m 알 수 없는 옵션입니다 (Long Option만 지원): {arg}", file=sys.stderr)
            sys.exit(1)

    args, unknown = parser.parse_known_args(argv)
    if unknown:
        print(f"\033[1;31m[ERROR]\033[0m 알 수 없는 옵션입니다: {' '.join(unknown)}", file=sys.stderr)
        sys.exit(1)

    if args.help:
        print_help()
        sys.exit(0)

    flat_pkgs = [item for sublist in args.package for item in sublist]
    flat_oss = [item for sublist in args.oss_number for item in sublist]

    cfg = AuditConfig(
        target_packages=split_tokens(flat_pkgs, uppercase=False),
        oss_numbers=split_tokens(flat_oss, uppercase=True),
        show_changelog=args.show_changelog,
        online_mode=not args.offline,
        verbose=args.verbose,
        output_file=args.output.strip(),
    )

    if not cfg.target_packages and not cfg.oss_numbers:
        print_help()
        sys.exit(1)

    if cfg.show_changelog and not cfg.target_packages:
        print(
            "\033[1;31m[ERROR]\033[0m --show-changelog 옵션은 --package <패키지명> 옵션과 함께 사용해야 합니다.",
            file=sys.stderr,
        )
        sys.exit(1)

    return cfg


def run_cmd(
    cmd: List[str], timeout: int = 15, env_extra: Optional[Dict[str, str]] = None
) -> subprocess.CompletedProcess:
    """외부 명령어를 shell=False로 안전하게 실행합니다."""
    env = os.environ.copy()
    if env_extra:
        env.update(env_extra)
    try:
        return subprocess.run(
            cmd,
            shell=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            errors="replace",
            timeout=timeout,
            env=env,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(cmd, 124, "", "timeout")
    except FileNotFoundError:
        return subprocess.CompletedProcess(cmd, 127, "", "not found")


def detect_environment() -> OSInfo:
    """현재 OS 및 패키지 매니저 환경을 감지합니다."""
    sys_name = platform.system()
    os_type = "unknown"
    pkg_mgr = "unknown"
    os_desc = sys_name
    codename = ""

    if sys_name == "Darwin":
        os_type = "darwin"
        res = run_cmd(["sw_vers", "-productVersion"], timeout=5)
        ver = res.stdout.strip() if res.returncode == 0 else ""
        os_desc = f"macOS {ver}".strip()
        if shutil.which("brew"):
            pkg_mgr = "brew"
        elif shutil.which("port"):
            pkg_mgr = "port"
    elif Path("/etc/os-release").is_file():
        os_rel: Dict[str, str] = {}
        try:
            for line in Path("/etc/os-release").read_text(encoding="utf-8", errors="replace").splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    os_rel[k.strip()] = v.strip().strip('"')
        except OSError:
            pass
        os_id = os_rel.get("ID", "")
        id_like = os_rel.get("ID_LIKE", "")
        os_desc = os_rel.get("PRETTY_NAME") or os_id or sys_name
        codename = os_rel.get("VERSION_CODENAME", "")

        if os_id in ("ubuntu", "debian", "linuxmint", "pop") or re.search(r"(debian|ubuntu)", id_like):
            os_type = "debian"
            if shutil.which("dpkg-query"):
                pkg_mgr = "dpkg"
        elif os_id in ("rhel", "rocky", "almalinux", "centos", "fedora", "ol") or re.search(
            r"(rhel|fedora|centos)", id_like
        ):
            os_type = "rhel"
            if shutil.which("rpm"):
                pkg_mgr = "rpm"
        elif os_id == "sles" or os_id.startswith("opensuse") or "suse" in id_like:
            os_type = "suse"
            if shutil.which("zypper") or shutil.which("rpm"):
                pkg_mgr = "zypper"
        elif os_id in ("arch", "manjaro", "endeavouros") or "arch" in id_like:
            os_type = "arch"
            if shutil.which("pacman"):
                pkg_mgr = "pacman"
        elif os_id == "alpine":
            os_type = "alpine"
            if shutil.which("apk"):
                pkg_mgr = "apk"

    if pkg_mgr == "unknown":
        if shutil.which("dpkg-query"):
            os_type, pkg_mgr = "debian", "dpkg"
        elif shutil.which("rpm"):
            os_type, pkg_mgr = "rhel", "rpm"
        elif shutil.which("pacman"):
            os_type, pkg_mgr = "arch", "pacman"
        elif shutil.which("apk"):
            os_type, pkg_mgr = "alpine", "apk"
        elif shutil.which("brew"):
            os_type, pkg_mgr = "darwin", "brew"

    return OSInfo(os_type=os_type, pkg_mgr=pkg_mgr, os_desc=os_desc, codename=codename)


def get_package_info(pkg: str, pkg_mgr: str) -> Tuple[bool, str]:
    """패키지 설치 여부 및 버전 정보 포맷 문자열을 반환합니다."""
    if pkg_mgr == "dpkg":
        res = run_cmd(
            ["dpkg-query", "-W", "-f=${Package}\t${Version}\t${Architecture}\t${Status}\n", pkg],
            timeout=5,
        )
        out = res.stdout.strip()
        if out and re.search(r"install\s+ok\s+installed", out):
            parts = out.split("\t")
            p_name = parts[0] if len(parts) > 0 else pkg
            p_ver = parts[1] if len(parts) > 1 else ""
            p_arch = parts[2] if len(parts) > 2 else ""
            return True, f"  📦 {p_name:<20} : 버전 {p_ver:<20} ({p_arch:<6}) | \033[1;32m[설치됨]\033[0m"
    elif pkg_mgr in ("rpm", "zypper"):
        res = run_cmd(
            ["rpm", "-q", "--queryformat", "%{NAME}\t%{VERSION}-%{RELEASE}\t%{ARCH}\n", pkg],
            timeout=5,
        )
        out = res.stdout.strip()
        if res.returncode == 0 and out and "is not installed" not in out:
            parts = out.split("\t")
            p_name = parts[0] if len(parts) > 0 else pkg
            p_ver = parts[1] if len(parts) > 1 else ""
            p_arch = parts[2] if len(parts) > 2 else ""
            return True, f"  📦 {p_name:<20} : 버전 {p_ver:<20} ({p_arch:<6}) | \033[1;32m[설치됨]\033[0m"
    elif pkg_mgr == "pacman":
        res = run_cmd(["pacman", "-Q", pkg], timeout=5)
        out = res.stdout.strip()
        if res.returncode == 0 and out:
            parts = out.split()
            p_name = parts[0]
            p_ver = parts[1] if len(parts) > 1 else ""
            return True, f"  📦 {p_name:<20} : 버전 {p_ver:<20} | \033[1;32m[설치됨]\033[0m"
    elif pkg_mgr == "apk":
        res = run_cmd(["apk", "info", "-v", pkg], timeout=5)
        out = res.stdout.strip()
        if res.returncode == 0 and out:
            return True, f"  📦 {pkg:<20} : {out:<20} | \033[1;32m[설치됨]\033[0m"
    elif pkg_mgr == "brew":
        res = run_cmd(["brew", "list", "--versions", pkg], timeout=10)
        out = res.stdout.strip()
        if res.returncode == 0 and out:
            return True, f"  📦 {pkg:<20} : {out:<20} | \033[1;32m[설치됨]\033[0m"

    return False, f"  📦 {pkg:<20} : \033[1;33m[미설치 (Not Installed)]\033[0m"


def truncate_title(title: str, max_len: int = 120) -> str:
    """콘솔 가독성을 위해 과도하게 긴 제목을 축약합니다."""
    if len(title) > max_len:
        return title[: max_len - 3] + "..."
    return title


def fetch_json_url(url: str, timeout: int = 8, retries: int = 1) -> Tuple[int, Optional[dict]]:
    """urllib.request를 사용하여 JSON API를 재시도와 함께 안전하게 호출합니다."""
    req = urllib.request.Request(
        url,
        headers={"User-Agent": f"patch-info/{SCRIPT_FILE_VERSION}"},
    )
    last_code = 0
    for attempt in range(retries + 1):
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                data = json.loads(resp.read().decode("utf-8", errors="replace"))
                return resp.status, data
        except urllib.error.HTTPError as e:
            last_code = e.code
            if e.code == 404:
                return 404, None
        except Exception:
            last_code = 0
        if attempt < retries:
            time.sleep(0.5)
    return last_code, None


def is_dpkg_installed(pkg: str) -> Optional[str]:
    """dpkg 패키지 설치 시 버전을 반환하고, 미설치 시 None을 반환합니다."""
    res = run_cmd(["dpkg-query", "-W", "-f=${Status}\t${Version}", pkg], timeout=5)
    if res.returncode != 0:
        return None
    out = res.stdout.strip()
    if "\t" in out:
        status, ver = out.split("\t", 1)
        if re.search(r"install\s+ok\s+installed", status):
            return ver.strip()
    return None


def dpkg_compare_ge(ver1: str, ver2: str) -> bool:
    """dpkg --compare-versions ge 비교를 수행합니다."""
    if not ver1 or not ver2:
        return False
    res = run_cmd(["dpkg", "--compare-versions", ver1, "ge", ver2], timeout=5)
    return res.returncode == 0


def run_dnf_updateinfo(sub_args: List[str], online_mode: bool, log: Logger) -> str:
    """DNF updateinfo 명령을 안전하게 실행합니다 (오프라인/캐시 폴백 지원)."""
    env_extra = {"LC_ALL": "C"}
    if not online_mode:
        res = run_cmd(
            ["dnf", "-C", "--setopt=skip_if_unavailable=True", "updateinfo"] + sub_args,
            timeout=20,
            env_extra=env_extra,
        )
        if res.returncode == 124:
            log.warn("DNF 로컬 캐시 조회 시간 초과(20초)")
        return res.stdout

    res = run_cmd(
        [
            "dnf",
            "--setopt=timeout=5",
            "--setopt=retries=1",
            "--setopt=skip_if_unavailable=True",
            "updateinfo",
        ]
        + sub_args,
        timeout=20,
        env_extra=env_extra,
    )
    out = res.stdout
    if res.returncode == 124 or res.returncode != 0 or not re.search(r"Update ID:|Title:|===+", out):
        if res.returncode == 124:
            log.warn("DNF 온라인 조회 시간 초과(20초) - 로컬 캐시(-C)로 폴백 조회합니다.")
        elif res.returncode != 0:
            log.debug(f"DNF 온라인 조회 실패(rc={res.returncode}) - 로컬 캐시(-C)로 폴백 조회합니다.")
        cache_res = run_cmd(
            ["dnf", "-C", "--setopt=skip_if_unavailable=True", "updateinfo"] + sub_args,
            timeout=20,
            env_extra=env_extra,
        )
        if cache_res.stdout and re.search(r"Update ID:|Title:|===+", cache_res.stdout):
            out = cache_res.stdout
    return out


def parse_dnf_updateinfo_result(dnf_out: str, target_id: str, res_obj: AdvisoryResult) -> bool:
    """DNF updateinfo 출력 결과에서 제목, 상태, 영향 패키지를 추출합니다."""
    if target_id not in dnf_out:
        return False

    update_id = ""
    title_field = ""
    banner_title = ""
    lines = dnf_out.splitlines()
    for i, line in enumerate(lines):
        if not update_id:
            m = re.match(r"^\s*Update ID\s*:\s*(.+)$", line)
            if m:
                update_id = m.group(1).strip()
        if not title_field:
            m = re.match(r"^\s*Title\s*:\s*(.+)$", line)
            if m:
                title_field = m.group(1).strip()
        if not banner_title and re.match(r"^===+$", line.strip()) and i + 1 < len(lines):
            nxt = lines[i + 1].strip()
            if nxt and not re.match(r"^===+$", nxt):
                banner_title = nxt

    resolved_title = title_field or banner_title
    if resolved_title and update_id:
        res_obj.title_short = f"{resolved_title} ({update_id})"
        res_obj.title_full = res_obj.title_short
    elif resolved_title:
        res_obj.title_short = resolved_title
        res_obj.title_full = resolved_title

    if re.search(r"^\s*Installed\s*:\s*false", dnf_out, re.MULTILINE | re.IGNORECASE):
        res_obj.status = "업데이트 가능 (Available - 패치 미적용)"
    elif re.search(r"^\s*Installed\s*:\s*true", dnf_out, re.MULTILINE | re.IGNORECASE):
        res_obj.status = "해결됨 (Resolved - 이미 패치 적용됨)"
    else:
        res_obj.status = "업데이트 가능 (Available - 패치 미적용)"

    pkg_match = re.search(r"^\s*Packages\s*:.*\n(?:\s+([a-zA-Z0-9][^\s]*))", dnf_out, re.MULTILINE)
    if pkg_match:
        res_obj.pkg = pkg_match.group(1).strip()
    elif banner_title:
        bm = re.match(r"^[A-Za-z]+:\s*([a-zA-Z0-9._+-]+)\s+security", banner_title)
        if bm:
            res_obj.pkg = bm.group(1)
    return True


def resolve_advisory_info(
    advisory: str, os_info: OSInfo, online_mode: bool, log: Logger
) -> AdvisoryResult:
    """OS 보안 권고번호 또는 CVE 번호를 분석하여 AdvisoryResult를 반환합니다."""
    res = AdvisoryResult(
        advisory=advisory,
        title_short=f"Security Advisory: {advisory}",
        title_full=f"Security Advisory: {advisory}",
    )

    # 1) 입력값이 CVE 형식인 경우
    if re.match(r"^CVE-[0-9]{4}-[0-9]+$", advisory):
        res.title_short = f"CVE 단독 취약점 ({advisory})"
        res.title_full = res.title_short
        res.status = "체인지로그 점검 필요"
        res.cves = [advisory]
        resolved = False

        # [Ubuntu/Debian 1순위]: Canonical 보안 REST API
        if os_info.os_type == "debian" and online_mode:
            log.debug(f"Canonical 공식 보안 REST API를 통해 '{advisory}' 조회...")
            code, data = fetch_json_url(
                f"https://ubuntu.com/security/cves/{advisory}.json", timeout=8, retries=1
            )
            if code == 200 and isinstance(data, dict):
                notices = data.get("notices_ids", []) or []
                desc = (data.get("description") or "").strip().split("\n")[0]
                rel_p_names: List[str] = []
                other_p_names: List[str] = []
                codename_pkgs: List[Tuple[str, str, str]] = []

                for p in data.get("packages", []):
                    p_name = p.get("name", "")
                    has_rel = False
                    for st in p.get("statuses", []):
                        if st.get("release_codename") == os_info.codename:
                            has_rel = True
                            codename_pkgs.append(
                                (p_name, st.get("status", ""), st.get("description", ""))
                            )
                    if p_name:
                        if has_rel and p_name not in rel_p_names:
                            rel_p_names.append(p_name)
                        elif not has_rel and p_name not in rel_p_names and p_name not in other_p_names:
                            other_p_names.append(p_name)

                p_names = rel_p_names + [n for n in other_p_names if n not in rel_p_names]
                if p_names:
                    title_full = ", ".join(p_names) + " vulnerability"
                    if len(p_names) > 3:
                        title_short = (
                            ", ".join(p_names[:3]) + f" 외 {len(p_names) - 3}개 패키지 vulnerability"
                        )
                    else:
                        title_short = title_full
                elif desc:
                    title_full = desc[:60]
                    title_short = title_full
                else:
                    title_full = "CVE 보안 취약점"
                    title_short = title_full

                if notices:
                    title_full += " (" + ", ".join(notices) + ")"
                    if len(notices) > 3:
                        title_short += " (" + ", ".join(notices[:3]) + f" 외 {len(notices) - 3}건)"
                    else:
                        title_short += " (" + ", ".join(notices) + ")"

                res.title_short = title_short
                res.title_full = title_full

                if codename_pkgs:
                    has_installed = False
                    for s_pkg, s_status, s_fix_ver in codename_pkgs:
                        inst_ver = is_dpkg_installed(s_pkg)
                        if inst_ver is not None:
                            has_installed = True
                            res.pkg = s_pkg
                            if s_status == "released":
                                if s_fix_ver and dpkg_compare_ge(inst_ver, s_fix_ver):
                                    res.status = "해결됨 (Resolved - 이미 패치 적용됨)"
                                else:
                                    res.status = "업데이트 가능 (Available - 패치 미적용)"
                            elif s_status in ("not-affected", "DNE", "ignored"):
                                res.status = "해당 없음 (Not Affected)"
                            elif s_status in ("needed", "pending", "deferred"):
                                res.status = "업데이트 대기중 (Pending/Needed - 패치 미배포)"
                            break
                    if not has_installed:
                        res.pkg = codename_pkgs[0][0]
                        first_status = codename_pkgs[0][1]
                        if first_status in ("not-affected", "DNE", "ignored"):
                            res.status = "해당 없음 (Not Affected - 본 릴리즈 미영향)"
                        else:
                            res.status = "해당 없음 (Not Affected - 패키지 미설치)"
                else:
                    res.status = "해당 없음 (Not Affected - 본 릴리즈 미영향)"

                resolved = True
                res.sources.append("Canonical 보안 API")
            else:
                res.sources.append("Canonical 보안 API (실패)")

        # [Ubuntu 2순위 폴백]: Ubuntu Pro CLI
        if not resolved and os_info.os_type == "debian" and online_mode and shutil.which("pro"):
            log.debug(f"Ubuntu Pro 도구를 통해 '{advisory}' 분석 (pro fix --dry-run)...")
            pro_res = run_cmd(["pro", "fix", "--dry-run", advisory], timeout=15)
            pro_out = pro_res.stdout + "\n" + pro_res.stderr

            m_title = re.search(rf"^{re.escape(advisory)}:\s*(.+)$", pro_out, re.MULTILINE)
            if m_title:
                parsed_t = m_title.group(1).strip()
                res.title_short = parsed_t
                res.title_full = parsed_t

            if "is resolved" in pro_out:
                res.status = "해결됨 (Resolved - 이미 패치 적용됨)"
                res.sources.append("Ubuntu Pro CLI 폴백")
            elif "A fix is available" in pro_out:
                res.status = "업데이트 가능 (Available - 패치 미적용)"
                res.sources.append("Ubuntu Pro CLI 폴백")
            elif "is not affected" in pro_out:
                res.status = "해당 없음 (Not Affected)"
                res.sources.append("Ubuntu Pro CLI 폴백")
            else:
                res.status = "확인 필요 (API 조회 실패)"
                res.sources.append("Ubuntu Pro CLI 폴백 (실패)")

            m_pkg = re.search(
                r"affected source package is installed:.*?\n(?:\([0-9]+/[0-9]+\)\s+([^\s:]+))",
                pro_out,
                re.DOTALL,
            )
            if m_pkg:
                res.pkg = m_pkg.group(1).strip()
            resolved = True

        if not resolved and os_info.os_type == "debian" and online_mode:
            res.status = "확인 필요 (API 조회 실패)"

        if not online_mode and os_info.os_type in ("debian", "arch"):
            res.sources.append("오프라인 모드 (원격 조회 생략, 로컬 체인지로그 점검)")

        # [RHEL/Rocky]: DNF updateinfo
        if not resolved and os_info.os_type == "rhel" and shutil.which("dnf"):
            log.debug(f"DNF updateinfo를 통해 '{advisory}' 분석...")
            dnf_out = run_dnf_updateinfo(["info", "--all", "--cve", advisory], online_mode, log)
            if parse_dnf_updateinfo_result(dnf_out, advisory, res):
                resolved = True
            else:
                res.status = "해당 없음 (Not Affected - 관련 권고 없음)"
            res.sources.append("DNF 로컬 캐시 (-C)" if not online_mode else "DNF updateinfo")

        # [Arch Linux]: Arch Security Tracker API & arch-audit
        if not resolved and os_info.os_type == "arch":
            if online_mode:
                log.debug(f"Arch Security Tracker REST API를 통해 '{advisory}' 조회...")
                code, data = fetch_json_url(
                    f"https://security.archlinux.org/{advisory}.json", timeout=8, retries=1
                )
                if code == 404:
                    res.status = "해당 없음 (Not Affected - Arch 트래커 미등록)"
                    resolved = True
                    res.sources.append("Arch Security Tracker")
                elif code == 200 and isinstance(data, dict):
                    pkgs = data.get("packages", []) or []
                    advisories = data.get("advisories", []) or []
                    groups = data.get("groups", []) or []
                    vtype = (data.get("type") or "").strip()
                    sev = (data.get("severity") or "").strip()

                    full_parts: List[str] = []
                    short_parts: List[str] = []
                    if pkgs:
                        full_parts.append(", ".join(pkgs))
                        if len(pkgs) > 3:
                            short_parts.append(", ".join(pkgs[:3]) + f" 외 {len(pkgs) - 3}개 패키지")
                        else:
                            short_parts.append(", ".join(pkgs))
                    if vtype:
                        full_parts.append(vtype)
                        short_parts.append(vtype)
                    elif data.get("description"):
                        d = data["description"].strip().split("\n")[0][:50]
                        full_parts.append(d)
                        short_parts.append(d)

                    title_full = " - ".join(full_parts) if full_parts else "Arch Security Issue"
                    title_short = " - ".join(short_parts) if short_parts else "Arch Security Issue"
                    if sev:
                        title_full = f"[{sev}] {title_full}"
                        title_short = f"[{sev}] {title_short}"
                    if advisories:
                        title_full += " (" + ", ".join(advisories) + ")"
                        if len(advisories) > 3:
                            title_short += " (" + ", ".join(advisories[:3]) + f" 외 {len(advisories) - 3}건)"
                        else:
                            title_short += " (" + ", ".join(advisories) + ")"

                    res.title_short = title_short
                    res.title_full = title_full

                    avg_status = ""
                    fixed_ver = ""
                    if groups:
                        g_code, g_data = fetch_json_url(
                            f"https://security.archlinux.org/{groups[0]}.json", timeout=5, retries=0
                        )
                        if g_code == 200 and isinstance(g_data, dict):
                            avg_status = g_data.get("status") or ""
                            fixed_ver = g_data.get("fixed") or ""

                    if pkgs:
                        has_installed = False
                        for s_pkg in pkgs:
                            pq = run_cmd(["pacman", "-Q", s_pkg], timeout=5)
                            if pq.returncode == 0 and pq.stdout.strip():
                                has_installed = True
                                res.pkg = s_pkg
                                inst_ver = pq.stdout.strip().split()[1]
                                if avg_status == "Not affected":
                                    res.status = "해당 없음 (Not Affected)"
                                elif avg_status == "Fixed" and fixed_ver:
                                    if shutil.which("vercmp"):
                                        vc = run_cmd(["vercmp", inst_ver, fixed_ver], timeout=5)
                                        try:
                                            cmp_val = int(vc.stdout.strip())
                                        except ValueError:
                                            cmp_val = -1
                                        if cmp_val >= 0:
                                            res.status = "해결됨 (Resolved - 이미 패치 적용됨)"
                                        else:
                                            res.status = "업데이트 가능 (Available - 패치 미적용)"
                                    else:
                                        res.status = f"확인 필요 (설치됨: {inst_ver}, 패치: {fixed_ver})"
                                elif avg_status in ("Vulnerable", "Testing", "Unknown") or not fixed_ver:
                                    res.status = "업데이트 대기중 (Vulnerable - 패치 미배포)"
                                break
                        if not has_installed:
                            res.pkg = pkgs[0]
                            res.status = "해당 없음 (Not Affected - 패키지 미설치)"
                    else:
                        res.status = "해당 없음 (Not Affected - 영향 패키지 없음)"

                    resolved = True
                    res.sources.append("Arch Security Tracker")
                else:
                    res.sources.append("Arch Security Tracker (실패)")

            if not resolved and online_mode and shutil.which("arch-audit"):
                log.debug(f"arch-audit를 통해 '{advisory}' 조회...")
                aa = run_cmd(["arch-audit", "-f", "%n|%c|%t"], timeout=15)
                matched_line = next(
                    (ln for ln in aa.stdout.splitlines() if advisory.lower() in ln.lower()), ""
                )
                if matched_line:
                    res.pkg = matched_line.split("|")[0]
                    res.status = "업데이트 가능 (Available - 패치 미적용)"
                    resolved = True
                    res.sources.append("arch-audit")
                else:
                    res.sources.append("arch-audit (미매칭)")
                if not resolved:
                    res.status = "확인 필요 (API 조회 실패)"

        return res

    # 2) Ubuntu USN- 형식인 경우
    if re.match(r"^USN-[0-9]+-[0-9]+$", advisory):
        resolved = False
        if online_mode:
            log.debug(f"Canonical 공식 보안 REST API를 통해 '{advisory}' 조회...")
            code, data = fetch_json_url(
                f"https://ubuntu.com/security/notices/{advisory}.json", timeout=8, retries=1
            )
            if code == 200 and isinstance(data, dict):
                p_title = (data.get("title") or "").strip()
                if p_title:
                    res.title_short = p_title
                    res.title_full = p_title
                res.cves = [c for c in (data.get("cves_ids") or []) if c]
                rp = (data.get("release_packages") or {}).get(os_info.codename, [])
                src_pkgs = [
                    (p.get("name", ""), p.get("version", ""))
                    for p in rp
                    if p.get("is_source") and p.get("name")
                ]
                if src_pkgs:
                    has_installed = False
                    for s_pkg, s_fix_ver in src_pkgs:
                        inst_ver = is_dpkg_installed(s_pkg)
                        if inst_ver is not None:
                            has_installed = True
                            res.pkg = s_pkg
                            if dpkg_compare_ge(inst_ver, s_fix_ver):
                                res.status = "해결됨 (Resolved - 이미 패치 적용됨)"
                            else:
                                res.status = "업데이트 가능 (Available - 패치 미적용)"
                            break
                    if not has_installed:
                        res.pkg = src_pkgs[0][0]
                        res.status = "해당 없음 (Not Affected - 패키지 미설치)"
                else:
                    res.status = "해당 없음 (Not Affected - 본 릴리즈 미영향)"

                resolved = True
                res.sources.append("Canonical 보안 API")
            else:
                res.sources.append("Canonical 보안 API (실패)")

        if not resolved and online_mode and shutil.which("pro"):
            log.debug(f"Ubuntu Pro 도구를 통해 '{advisory}' 분석 (pro fix --dry-run)...")
            pro_res = run_cmd(["pro", "fix", "--dry-run", advisory], timeout=15)
            pro_out = pro_res.stdout + "\n" + pro_res.stderr

            m_title = re.search(rf"^{re.escape(advisory)}:\s*(.+)$", pro_out, re.MULTILINE)
            if m_title:
                parsed_t = m_title.group(1).strip()
                res.title_short = parsed_t
                res.title_full = parsed_t

            if "is resolved" in pro_out:
                res.status = "해결됨 (Resolved - 이미 패치 적용됨)"
                res.sources.append("Ubuntu Pro CLI 폴백")
            elif "A fix is available" in pro_out:
                res.status = "업데이트 가능 (Available - 패치 미적용)"
                res.sources.append("Ubuntu Pro CLI 폴백")
            elif "is not affected" in pro_out:
                res.status = "해당 없음 (Not Affected)"
                res.sources.append("Ubuntu Pro CLI 폴백")
            else:
                res.sources.append("Ubuntu Pro CLI 폴백 (실패)")

            m_pkg = re.search(
                r"affected source package is installed:.*?\n(?:\([0-9]+/[0-9]+\)\s+([^\s:]+))",
                pro_out,
                re.DOTALL,
            )
            if m_pkg:
                res.pkg = m_pkg.group(1).strip()
            res.cves = sorted(set(CVE_REGEX.findall(pro_out)))

        if not online_mode:
            res.sources.append("오프라인 모드 (원격 조회 생략, 로컬 체인지로그 점검)")
        return res

    # 3) RHEL/Rocky RHSA/RLSA/ALSA/FEDORA
    if re.match(r"^(RHSA|RLSA|ALSA|FEDORA)-[0-9]{4}:?[0-9]+$", advisory):
        if shutil.which("dnf"):
            log.debug(f"DNF updateinfo를 통해 '{advisory}' 분석...")
            dnf_out = run_dnf_updateinfo(["info", "--all", "--advisory", advisory], online_mode, log)
            parse_dnf_updateinfo_result(dnf_out, advisory, res)
            cve_block = re.search(r"^\s*CVEs?\s*:.*(?:\n.*){0,20}", dnf_out, re.MULTILINE)
            if cve_block:
                res.cves = sorted(set(CVE_REGEX.findall(cve_block.group(0))))
            res.sources.append("DNF 로컬 캐시 (-C)" if not online_mode else "DNF updateinfo")
        return res

    # 4) openSUSE / SLES
    if "SUSE-SU" in advisory or "openSUSE-SU" in advisory:
        if shutil.which("zypper"):
            log.debug(f"Zypper patch-info를 통해 '{advisory}' 분석...")
            cmd = ["zypper"]
            if not online_mode:
                cmd.append("--no-refresh")
            cmd.extend(["patch-info", advisory])
            zyp = run_cmd(cmd, timeout=20, env_extra={"LC_ALL": "C"})
            res.cves = sorted(set(CVE_REGEX.findall(zyp.stdout)))
            res.sources.append("Zypper 로컬 캐시 (--no-refresh)" if not online_mode else "Zypper patch-info")
        return res

    return res


def fetch_changelog(pkg: str, pkg_mgr: str, online_mode: bool, log: Logger) -> str:
    """패키지의 체인지로그 텍스트를 추출합니다."""
    if pkg_mgr == "dpkg":
        candidates: List[Path] = [
            Path(f"/usr/share/doc/{pkg}/changelog.Debian.gz"),
            Path(f"/usr/share/doc/{pkg}/changelog.gz"),
            Path(f"/usr/share/doc/{pkg}/changelog.Debian"),
            Path(f"/usr/share/doc/{pkg}/changelog"),
        ]
        doc_dir = Path("/usr/share/doc")
        if doc_dir.is_dir():
            for p_dir in sorted(doc_dir.glob(f"{pkg}*")):
                if p_dir.is_dir():
                    for fname in ("changelog.Debian.gz", "changelog.gz"):
                        f_path = p_dir / fname
                        if f_path.is_file() and f_path not in candidates:
                            candidates.append(f_path)

        for target in candidates:
            if target.is_file():
                log.debug(f"로컬 체인지로그 파일 발견: {target}")
                try:
                    if target.suffix == ".gz":
                        with gzip.open(target, "rt", encoding="utf-8", errors="replace") as gz:
                            content = gz.read()
                    else:
                        content = target.read_text(encoding="utf-8", errors="replace")
                    if content:
                        return content
                except OSError:
                    continue

        if online_mode and shutil.which("apt-get"):
            log.debug(f"'{pkg}' 온라인 체인지로그 조회 시도 (apt-get changelog)...")
            res = run_cmd(
                ["apt-get", "changelog", pkg], timeout=20, env_extra={"PAGER": "cat"}
            )
            if res.stdout:
                return res.stdout

    elif pkg_mgr in ("rpm", "zypper"):
        log.debug(f"'{pkg}' RPM 체인지로그 조회...")
        res = run_cmd(["rpm", "-q", "--changelog", pkg], timeout=10)
        if res.returncode == 0 and res.stdout:
            return res.stdout

    elif pkg_mgr == "pacman":
        res = run_cmd(["pacman", "-Qc", pkg], timeout=10)
        if res.returncode == 0 and res.stdout:
            return res.stdout

    elif pkg_mgr == "apk":
        res = run_cmd(["apk", "info", "-a", pkg], timeout=10)
        if res.returncode == 0 and res.stdout:
            return res.stdout

    elif pkg_mgr == "brew":
        res = run_cmd(["brew", "info", pkg], timeout=10)
        if res.returncode == 0 and res.stdout:
            return res.stdout

    return ""


def extract_changelog_blocks(changelog_text: str, cve_list: List[str], pkg_mgr: str) -> str:
    """체인지로그에서 대상 CVE 목록에 일치하는 완전한 블록 전체를 추출합니다."""
    if not changelog_text or not cve_list:
        return ""
    pattern = re.compile("|".join(re.escape(c) for c in cve_list), re.IGNORECASE)
    is_rpm = pkg_mgr in ("rpm", "zypper")

    blocks: List[str] = []
    in_block = False
    block_header = ""
    cur_lines: List[str] = []
    cur_item = ""
    matched_items: List[str] = []

    def flush_rpm_item() -> None:
        nonlocal cur_item
        if cur_item and pattern.search(cur_item):
            matched_items.append(cur_item)
        cur_item = ""

    def flush_block() -> None:
        nonlocal in_block, block_header, cur_lines, matched_items
        if not in_block:
            return
        if is_rpm:
            flush_rpm_item()
            if matched_items:
                hdr = re.sub(r"^\s*\*\s*", "  🔒 ", block_header)
                blocks.append(hdr + "\n" + "\n".join(matched_items) + "\n")
        else:
            full_block = "\n".join(cur_lines)
            if pattern.search(full_block):
                hdr = re.sub(r"^\s*\*\s*", "  🔒 ", cur_lines[0])
                body = "\n".join(cur_lines[1:])
                blocks.append((hdr + "\n" + body if body else hdr) + "\n")
        in_block = False
        block_header = ""
        cur_lines = []
        matched_items = []

    for line in changelog_text.splitlines():
        if re.match(r"^\s*\*\s", line):
            flush_block()
            in_block = True
            block_header = line
            cur_lines = [line]
        elif in_block:
            if is_rpm:
                if re.match(r"^\s*-\s", line):
                    flush_rpm_item()
                    cur_item = line
                elif re.match(r"^\s*$", line):
                    flush_block()
                elif cur_item:
                    cur_item += "\n" + line
            else:
                if re.match(r"^\s*--\s+", line):
                    flush_block()
                else:
                    cur_lines.append(line)

    flush_block()
    return "\n".join(blocks)


def main() -> int:
    cfg = parse_args(sys.argv[1:])
    log = Logger(verbose=cfg.verbose)
    spinner = StepSpinner(enabled=not cfg.verbose)

    def handle_interrupt(signum: int, _frame: object) -> None:
        spinner.clear_all()
        print("\n\033[1;33m[중단]\033[0m 사용자에 의해 작업이 취소되었습니다 (Ctrl+C).", file=sys.stderr)
        sys.exit(130)

    signal.signal(signal.SIGINT, handle_interrupt)
    signal.signal(signal.SIGTERM, handle_interrupt)

    os_info = detect_environment()
    if os_info.os_type == "debian" and not cfg.online_mode and not cfg.target_packages and cfg.oss_numbers:
        log.warn(
            "오프라인(Ubuntu/Debian) 모드에서는 --package 옵션을 함께 지정해야 로컬 체인지로그 기반 패치 여부 확인이 가능합니다."
        )

    log.debug(f"OS 환경: {os_info.os_desc} (OS 유형: {os_info.os_type})")
    log.debug(f"패키지 매니저: {os_info.pkg_mgr}")
    log.debug(f"온라인 모드: {cfg.online_mode}")

    # --show-changelog 단독 실행 모드
    if cfg.show_changelog:
        for pkg in cfg.target_packages:
            print("================================================================================")
            print(f" 📄 패키지 전체 체인지로그: {pkg}")
            print("================================================================================")
            cl = fetch_changelog(pkg, os_info.pkg_mgr, cfg.online_mode, log)
            print(cl if cl else "(체인지로그를 찾을 수 없습니다)")
            print()
        return 0

    mode_str = (
        "온라인 (공식 보안 API 및 원격 저장소 우선)"
        if cfg.online_mode
        else "오프라인 (로컬 전용)"
    )
    uname_info = f"{platform.system()} {platform.release()} {platform.machine()}"

    sec_header_lines = [
        "================================================================================",
        " 🛡️  시스템 패키지 및 OS 보안 권고 감사 보고서",
        f"    - 시스템: {os_info.os_desc} (패키지 백엔드: {os_info.pkg_mgr})",
        f"    - 커널  : {uname_info}",
    ]
    if cfg.target_packages:
        sec_header_lines.append(f"    - 대상 패키지: {' '.join(cfg.target_packages)}")
    if cfg.oss_numbers:
        sec_header_lines.append(f"    - OS 보안 권고사항(OSS): {' '.join(cfg.oss_numbers)}")
    sec_header_lines.extend(
        [
            f"    - 조회 모드: {mode_str}",
            "================================================================================",
            "",
        ]
    )
    sec_header = "\n".join(sec_header_lines) + "\n"
    sys.stdout.write(sec_header)
    sys.stdout.flush()

    sec_step1 = ""
    installed_pkgs: List[str] = []
    not_installed_pkgs: List[str] = []

    # [1단계] 시스템 패키지 설치 상태 검사
    if cfg.target_packages:
        step1_buf = [
            "--------------------------------------------------------------------------------",
            " [1단계] 시스템 패키지 설치 상태 검사",
            "--------------------------------------------------------------------------------",
        ]
        for pkg in cfg.target_packages:
            ok, line = get_package_info(pkg, os_info.pkg_mgr)
            step1_buf.append(line)
            if ok:
                installed_pkgs.append(pkg)
            else:
                not_installed_pkgs.append(pkg)
        step1_buf.append(
            f"  * 검사 결과: 총 {len(cfg.target_packages)}개 요청 패키지 중 "
            f"{len(installed_pkgs)}개 설치됨, {len(not_installed_pkgs)}개 미설치\n"
        )
        sec_step1 = "\n".join(step1_buf) + "\n"
        sys.stdout.write(sec_step1)
        sys.stdout.flush()

    # [2단계] OS 보안 권고사항 분석 및 연관 CVE 추출 (다건 시 병렬 조회 + 실시간 스피너)
    sec_step2 = ""
    all_resolved_cves: List[str] = []
    suggested_pkgs: List[str] = []
    summary_entries: List[AdvisoryResult] = []

    if cfg.oss_numbers:
        step2_hdr = (
            "--------------------------------------------------------------------------------\n"
            " [2단계] OS 보안 권고사항(OSS Number) 분석 및 연관 CVE 자동 추출\n"
            "--------------------------------------------------------------------------------\n"
        )
        sys.stdout.write(step2_hdr)
        sys.stdout.flush()
        sec_step2 += step2_hdr

        total_oss = len(cfg.oss_numbers)
        results_by_idx: Dict[int, AdvisoryResult] = {}

        if cfg.online_mode and total_oss > 1:
            spinner.start(f"보안 권고 {total_oss}건 병렬 분석 중 (0/{total_oss} 완료)")
            done_cnt = 0
            cnt_lock = threading.Lock()
            with concurrent.futures.ThreadPoolExecutor(max_workers=min(4, total_oss)) as executor:
                future_map = {
                    executor.submit(resolve_advisory_info, oss, os_info, cfg.online_mode, log): idx
                    for idx, oss in enumerate(cfg.oss_numbers)
                }
                for fut in concurrent.futures.as_completed(future_map):
                    idx = future_map[fut]
                    results_by_idx[idx] = fut.result()
                    with cnt_lock:
                        done_cnt += 1
                        spinner.update_label(
                            f"보안 권고 {total_oss}건 병렬 분석 중 ({done_cnt}/{total_oss} 완료)"
                        )
            spinner.stop("완료", ok=True)
            spinner.clear_all()
        else:
            for idx, oss in enumerate(cfg.oss_numbers):
                if cfg.online_mode:
                    spinner.start(f"[{idx + 1}/{total_oss}] {oss} 보안 권고 조회 중")
                results_by_idx[idx] = resolve_advisory_info(oss, os_info, cfg.online_mode, log)
                if cfg.online_mode:
                    spinner.stop("완료", ok=True)
                    spinner.clear_all()

        for idx in range(total_oss):
            adv = results_by_idx[idx]
            summary_entries.append(adv)
            if adv.pkg:
                suggested_pkgs.append(adv.pkg)

            display_title = truncate_title(adv.title_short, 120)
            full_title = adv.title_full or adv.title_short

            if "해결됨" in adv.status:
                status_line = f"    - 시스템 상태: \033[1;32m{adv.status}\033[0m"
            elif "업데이트 가능" in adv.status:
                status_line = f"    - 시스템 상태: \033[1;31m{adv.status}\033[0m"
            else:
                status_line = f"    - 시스템 상태: {adv.status}"

            pkg_line = f"    - 영향 패키지: {adv.pkg}" if adv.pkg else ""

            console_lines = [f"  📢 \033[1;36m[{adv.advisory}]\033[0m {display_title}", status_line]
            if pkg_line:
                console_lines.append(pkg_line)

            file_lines = [f"  📢 \033[1;36m[{adv.advisory}]\033[0m {full_title}", status_line]
            if pkg_line:
                file_lines.append(pkg_line)

            if adv.cves:
                is_unrelated = False
                if cfg.target_packages:
                    if adv.pkg:
                        pkg_matched = any(
                            tp == adv.pkg
                            or tp.startswith(f"{adv.pkg}-")
                            or adv.pkg.startswith(f"{tp}-")
                            for tp in cfg.target_packages
                        )
                        if not pkg_matched:
                            is_unrelated = True
                    elif "해당 없음" in adv.status:
                        is_unrelated = True

                if is_unrelated and len(adv.cves) > 5 and not cfg.verbose:
                    console_lines.append(
                        f"    - 연관 CVE 목록: 총 {len(adv.cves)}개 (지정 패키지와 무관하여 축약됨, --verbose 시 전체 출력)"
                    )
                else:
                    console_lines.append(f"    - 연관 CVE 목록 ({len(adv.cves)}개 추출됨):")
                    if len(adv.cves) > 10 and not cfg.verbose:
                        console_lines.append(
                            f"      {' '.join(adv.cves[:10])} ... 외 {len(adv.cves) - 10}개 생략 (총 {len(adv.cves)}개, --verbose 시 전체 출력)"
                        )
                    else:
                        console_lines.append(f"      {' '.join(adv.cves)}")

                if cfg.output_file:
                    file_lines.append(f"    - 연관 CVE 목록 ({len(adv.cves)}개 추출됨):")
                    file_lines.append(f"      {' '.join(adv.cves)}")

                if not is_unrelated or not cfg.target_packages:
                    all_resolved_cves.extend(adv.cves)
            else:
                console_lines.append("    - 연관 CVE: (직접 매핑 정보 없음)")
                if cfg.output_file:
                    file_lines.append("    - 연관 CVE: (직접 매핑 정보 없음)")

            if not adv.sources:
                adv.sources.append(
                    "오프라인 모드 (로컬 캐시/체인지로그)" if not cfg.online_mode else "기본 권고 파서"
                )
            sources_str = ", ".join(adv.sources)
            console_lines.append(f"    - 근거: {sources_str}")
            if cfg.output_file:
                file_lines.append(f"    - 근거: {sources_str}")

            console_block = "\n".join(console_lines) + "\n\n"
            sys.stdout.write(console_block)
            sys.stdout.flush()
            if cfg.output_file:
                sec_step2 += "\n".join(file_lines) + "\n\n"

    # [3단계] 체인지로그 보안 패치 상세 내역
    sec_step3 = ""
    all_cl_matched_text = ""
    unique_cves = sorted(set(all_resolved_cves))

    if unique_cves:
        audit_pkgs = installed_pkgs if installed_pkgs else sorted(set(suggested_pkgs))
        if audit_pkgs:
            step3_hdr = (
                "--------------------------------------------------------------------------------\n"
                " [3단계] 설치된 패키지 체인지로그 보안 패치 적용 내역 (블록 정밀 추출)\n"
                "--------------------------------------------------------------------------------\n"
            )
            sys.stdout.write(step3_hdr)
            sys.stdout.flush()
            sec_step3 += step3_hdr

            cve_hl_re = re.compile("|".join(re.escape(c) for c in unique_cves))
            use_color = sys.stdout.isatty()

            for pkg in audit_pkgs:
                pkg_hdr = f"\n🔍 \033[1;34m[패키지]\033[0m \033[1m{pkg}\033[0m\n"
                sys.stdout.write(f"\n{pkg_hdr}\n")
                sys.stdout.flush()
                sec_step3 += f"\n{pkg_hdr}\n"

                raw_cl = fetch_changelog(pkg, os_info.pkg_mgr, cfg.online_mode, log)
                if not raw_cl:
                    log.warn(f"'{pkg}' 패키지의 체인지로그를 찾을 수 없습니다.")
                    sec_step3 += f"[WARN] '{pkg}' 패키지의 체인지로그를 찾을 수 없습니다.\n"
                    continue

                matched_blocks = extract_changelog_blocks(raw_cl, unique_cves, os_info.pkg_mgr)
                if matched_blocks:
                    all_cl_matched_text += "\n" + matched_blocks
                    ok_hdr = "\033[1;32m[패치 확인됨]\033[0m 현재 설치된 패키지에 관련 CVE 보안 패치가 반영되어 있습니다:"
                    print(ok_hdr)
                    print()
                    if use_color:
                        print(cve_hl_re.sub(lambda m: f"\033[1;31m{m.group(0)}\033[0m", matched_blocks))
                    else:
                        print(matched_blocks)
                    sec_step3 += f"{ok_hdr}\n\n{matched_blocks}\n"
                else:
                    miss_msg = "\033[1;33m[패치 미반영]\033[0m 현재 설치된 버전의 체인지로그에는 해당 CVE 보안 패치 내역이 반영되어 있지 않습니다."
                    print(miss_msg)
                    sec_step3 += f"{miss_msg}\n"

            print()
            sec_step3 += "\n"

    # [4단계] 시스템 취약점 패치 요약 정보
    sec_step4 = ""
    if summary_entries:
        sum_resolved: List[str] = []
        sum_action: List[str] = []
        sum_not_affected: List[str] = []
        sum_check: List[str] = []
        cl_lower = all_cl_matched_text.lower()

        for adv in summary_entries:
            label = f"{adv.advisory}({adv.pkg})" if adv.pkg else adv.advisory
            if "해결됨" in adv.status:
                sum_resolved.append(label)
            elif "업데이트 가능" in adv.status or "업데이트 대기중" in adv.status:
                sum_action.append(label)
            elif "해당 없음" in adv.status:
                if (
                    ("관련 권고 없음" in adv.status or "패키지 미설치" in adv.status)
                    and cl_lower
                    and adv.advisory.lower() in cl_lower
                ):
                    sum_resolved.append(label)
                else:
                    sum_not_affected.append(label)
            else:
                if cl_lower and adv.advisory.lower() in cl_lower:
                    sum_resolved.append(label)
                else:
                    sum_check.append(label)

        step4_lines = [
            "--------------------------------------------------------------------------------",
            f" [4단계] 시스템 취약점 패치 요약 정보 (총 {len(summary_entries)}건)",
            "--------------------------------------------------------------------------------",
            f"  \033[1;32m✅ 조치 완료 (Resolved)\033[0m         : {len(sum_resolved)}건",
        ]
        if sum_resolved:
            step4_lines.append(f"     {' '.join(sum_resolved)}")
        step4_lines.append(f"  \033[1;31m⚠️  조치 필요 (Action Required)\033[0m  : {len(sum_action)}건")
        if sum_action:
            step4_lines.append(f"     {' '.join(sum_action)}")
        step4_lines.append(f"  ➖ 해당 없음 (Not Affected)     : {len(sum_not_affected)}건")
        if sum_not_affected:
            step4_lines.append(f"     {' '.join(sum_not_affected)}")
        if sum_check:
            step4_lines.append(f"  \033[1;33m❓ 확인 필요 (Check Required)\033[0m   : {len(sum_check)}건")
            step4_lines.append(f"     {' '.join(sum_check)}")

        sec_step4 = "\n".join(step4_lines) + "\n\n"
        sys.stdout.write(sec_step4)
        sys.stdout.flush()

    sec_footer = (
        "================================================================================\n"
        " [감사 완료] 모든 점검 및 감사가 안전하게 종료되었습니다.\n"
        "================================================================================\n"
    )
    sys.stdout.write(sec_footer)
    sys.stdout.flush()

    # --output 지정 시 요약 우선 순서(1 -> 4 -> 3 -> 2)로 저장
    if cfg.output_file:
        out_path = Path(cfg.output_file)
        try:
            out_path.parent.mkdir(parents=True, exist_ok=True)
        except OSError as e:
            log.error(f"출력 디렉토리를 생성할 수 없습니다: {out_path.parent} ({e})")
            return 1

        raw_report = (
            sec_header
            + (sec_step1 or "")
            + (sec_step4 or "")
            + (sec_step3 or "")
            + (sec_step2 or "")
            + sec_footer
        )
        clean_report = ANSI_RE.sub("", raw_report)
        clean_report = STEP_PREFIX_RE.sub(" ", clean_report)
        out_path.write_text(clean_report, encoding="utf-8")
        log.info(f"감사 보고서가 파일로 저장되었습니다: {cfg.output_file}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
