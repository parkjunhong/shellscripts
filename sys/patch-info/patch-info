# 도움말 출력 함수

readonly SCRIPT_FILE_VERSION="2026.11.26.2"

help() {
  cat <<'EOF'
[사용법]
  patch-info [옵션]

[설명]
  현재 시스템(Ubuntu, Debian, RHEL, Rocky, openSUSE, Arch, Alpine, macOS 등)에서
  1) 패키지 설치 여부 및 버전 정보를 독립적으로 검사하거나,
  2) OS 보안 권고사항 번호(USN, RHSA, DSA 등)를 입력받아 연관된 CVE 목록을 자동으로 추출하고
     체인지로그 내 보안 패치 적용 여부를 완전한 블록 단위로 정밀 감사합니다.

[옵션]
  --package <이름...>          설치 여부를 확인할 패키지명을 지정합니다. (단독 사용 가능)
                               공백 또는 콤마(,)로 여러 패키지를 연속 지정하거나 옵션을 반복 입력할 수 있습니다.
                               (예: --package nginx nginx-core 또는 --package nginx,nginx-common)

  --oss-number <번호...>       감사할 OS 보안 권고사항 번호(USN, RHSA, DSA 등) 또는 CVE 번호입니다.
                               도구가 각 OS 벤더의 권고 정보를 분석하여 연관된 CVE 목록을 자동 추출합니다.
                               공백 또는 콤마(,)로 여러 번호를 연속 지정하거나 옵션을 반복 입력할 수 있습니다.
                               (예: --oss-number USN-9159-1 또는 --oss-number USN-9159-1,USN-9173-1)

  --show-changelog             패키지의 전체 체인지로그 텍스트를 출력합니다. (--package 필수)

  --output <파일 경로>         감사 보고서를 지정한 파일에 저장합니다. (요약 우선 순서로 저장)

  --offline                    폐쇄망 등 외부 인터넷 단절 환경에서 외부 API 및 원격 저장소 접속을
                               차단하고 로컬 캐시·체인지로그만으로 신속하게 검사합니다.

  --verbose                    상세 디버깅 정보(OS 감지, 실행 명령어, 파싱 통계)를 표준 에러로 출력합니다.

  --help                       도움말 메시지를 출력하고 종료합니다.

[OS별 공식 보안 권고사항(Security Advisory) 명칭 및 식별자 규격]
  * Ubuntu       : USN-xxx-x             (Ubuntu Security Notice, 예: USN-9159-1)
  * Debian       : DSA-xxx-x / DLA-xxx-x (Debian Security / LTS Advisory, 예: DSA-5480-1)
  * RHEL         : RHSA-YYYY:xxxx        (Red Hat Security Advisory, 예: RHSA-2024:1234)
  * Rocky Linux  : RLSA-YYYY:xxxx        (Rocky Linux Security Advisory, 예: RLSA-2024:1234)
  * AlmaLinux    : ALSA-YYYY:xxxx        (AlmaLinux Security Advisory, 예: ALSA-2024:1234)
  * openSUSE/SUSE: openSUSE-SU-YYYY:xxxx / SUSE-SU-YYYY:xxxx (SUSE Security Update)
  * Arch Linux   : ASA-YYYYMM-xx         (Arch Security Advisory, 예: ASA-202403-1)
  * Alpine Linux : CVE-YYYY-xxxx         (Alpine Secfixes 기반 패키지별 CVE 관리)
  * macOS (Apple): HTxxxxxx / CVE-YYYY-xxxx (Apple Security Document ID, 예: HT214106)

[사용 예시]
  # 1) 패키지 설치 여부 및 버전만 독립적으로 검사
  patch-info --package nginx nginx-core nginx-common

  # 2) OS 보안 권고 번호(USN)만 입력하여 연관 CVE 자동 추출 및 감사 수행
  patch-info --oss-number USN-9159-1

  # 3) 콤마(,)로 구분된 복수 OS 보안 권고 번호 감사 (따옴표 불필요)
  patch-info --package nginx --oss-number USN-9159-1,USN-9173-1,USN-9175-1

  # 4) 복수 권고 번호 및 CVE 번호 직접 지정 감사
  patch-info --oss-number USN-9159-1 RHSA-2021:4356 CVE-2026-123633 --verbose

  # 5) 오프라인 모드로 로컬 캐시/파일에서만 검사
  patch-info --package sudo --oss-number USN-4966-1 --offline

  # 6) 특정 패키지의 전체 체인지로그 열람
  patch-info --package nginx --show-changelog

  # 7) 감사 보고서를 요약 우선 순서로 파일에 저장
  patch-info --oss-number CVE-2026-123007,CVE-2026-123633 --output ./audit-report.txt
EOF
}

# 디버그 로깅 함수
log_debug() {
  if [[ "$VERBOSE" == "true" ]]; then
    printf "\033[1;34m[DEBUG]\033[0m %s\n" "$*" >&2
  fi
}

# 에러 로깅 함수
log_error() {
  printf "\033[1;31m[ERROR]\033[0m %s\n" "$*" >&2
}

# 정보 로깅 함수
log_info() {
  printf "\033[1;32m[INFO]\033[0m %s\n" "$*"
}

# 경고 로깅 함수
log_warn() {
  printf "\033[1;33m[WARN]\033[0m %s\n" "$*" >&2
}

# 실시간 진행 상태 표시 제어 변수
PROGRESS_ACTIVE=false
PROGRESS_LINE_COUNT=0
SPINNER_PID=""
SPINNER_LABEL=""
SPINNER_START_TS=0
ADV_PROGRESS_PREFIX=""

##
# 대화형 터미널(stderr TTY)에서 회전 스피너와 경과 시간을 실시간 표시
#
# @param $1 {String} 단계 라벨
##
start_step_spinner() {
  local label="$1"
  if [[ -n "$SPINNER_PID" ]]; then
    kill "$SPINNER_PID" 2>/dev/null || true
    wait "$SPINNER_PID" 2>/dev/null || true
    SPINNER_PID=""
  fi
  SPINNER_LABEL="$label"
  SPINNER_START_TS="$(date +%s)"
  if [[ -t 2 && "$VERBOSE" != "true" ]]; then
    (
      frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
      idx=0
      start_ts="$SPINNER_START_TS"
      while true; do
        now_ts="$(date +%s)"
        elapsed=$(( now_ts - start_ts ))
        printf "\r\033[K  \033[36m%s\033[0m %s: \033[2m진행 중... (%ds)\033[0m" "${frames[$idx]}" "$label" "$elapsed" >&2
        idx=$(( (idx + 1) % ${#frames[@]} ))
        sleep 0.15
      done
    ) &
    SPINNER_PID=$!
    PROGRESS_ACTIVE=true
  fi
}

##
# 진행 중인 스피너를 종료하고 해당 단계의 확정 상태(완료/실패)를 한 줄로 기록
#
# @param $1 {String} 결과 텍스트 (예: 완료, 실패, 미등록)
# @param $2 {String} 성공 여부 ("true" 또는 "false", 기본값: "true")
##
stop_step_spinner() {
  local result_text="${1:-완료}"
  local is_ok="${2:-true}"
  if [[ -n "$SPINNER_PID" ]]; then
    kill "$SPINNER_PID" 2>/dev/null || true
    wait "$SPINNER_PID" 2>/dev/null || true
    SPINNER_PID=""
  fi
  if [[ -t 2 && "$VERBOSE" != "true" && "$PROGRESS_ACTIVE" == "true" ]]; then
    local now_ts elapsed mark color
    now_ts="$(date +%s)"
    elapsed=$(( now_ts - SPINNER_START_TS ))
    if [[ "$is_ok" == "true" ]]; then
      mark="✓"
      color="\033[1;32m"
    else
      mark="✗"
      color="\033[1;33m"
    fi
    printf "\r\033[K  %b%s\033[0m %s: %b%s\033[0m (%ds)\n" "$color" "$mark" "$SPINNER_LABEL" "$color" "$result_text" "$elapsed" >&2
    PROGRESS_LINE_COUNT=$((PROGRESS_LINE_COUNT + 1))
    PROGRESS_ACTIVE=false
  fi
}

##
# 표시 중인 임시 진행 상태 줄들을 모두 깨끗이 지움
##
clear_progress() {
  if [[ -n "$SPINNER_PID" ]]; then
    kill "$SPINNER_PID" 2>/dev/null || true
    wait "$SPINNER_PID" 2>/dev/null || true
    SPINNER_PID=""
  fi
  if [[ -t 2 ]]; then
    if [[ "$PROGRESS_ACTIVE" == "true" ]]; then
      printf "\r\033[K" >&2
      PROGRESS_ACTIVE=false
    fi
    while [[ "$PROGRESS_LINE_COUNT" -gt 0 ]]; do
      printf "\033[1A\033[K" >&2
      PROGRESS_LINE_COUNT=$((PROGRESS_LINE_COUNT - 1))
    done
  fi
}

# 시그널 핸들러 (Ctrl+C 및 강제 종료 시 즉시 안전 종료)
handle_interrupt() {
  trap - INT TERM EXIT
  clear_progress
  printf "\n\033[1;33m[중단]\033[0m 사용자에 의해 작업이 취소되었습니다 (Ctrl+C).\n" >&2
  # 현재 프로세스 그룹의 모든 자식 프로세스 일괄 정리
  kill 0 2>/dev/null || true
  exit 130
}
trap handle_interrupt INT TERM

##
# 배열 내에 특정 문자열이 이미 존재하는지 확인
#
# @param $1 {String} 찾을 문자열
# @param $@ {String...} 대상 배열 원소 목록
# @return 0: 존재함, 1: 존재하지 않음
##
array_contains() {
  local needle="$1"
  shift
  local item
  for item in "$@"; do
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

# 변수 초기화
declare -a TARGET_PACKAGES=()
declare -a OSS_NUMBERS=()
SHOW_CHANGELOG=false
ONLINE_MODE=true
VERBOSE=false
OUTPUT_FILE=""

# CLI 옵션 파싱 루프 (Long Option 전용)
while [[ $# -gt 0 ]]; do
  case "$1" in
    --package)
      shift 1
      while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do
        # 공백, 파이프(|), 콤마(,)를 기준으로 안전하게 개별 토큰 분리
        IFS=',| ' read -r -a raw_pkgs <<< "$1"
        for p in "${raw_pkgs[@]}"; do
          p="$(echo "$p" | xargs)"
          if [[ -n "$p" ]] && ! array_contains "$p" ${TARGET_PACKAGES[@]+"${TARGET_PACKAGES[@]}"}; then
            TARGET_PACKAGES+=("$p")
          fi
        done
        shift 1
      done
      ;;
    --oss-number)
      shift 1
      while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do
        # 공백, 파이프(|), 콤마(,)를 기준으로 안전하게 개별 토큰 분리
        IFS=',| ' read -r -a raw_osss <<< "$1"
        for o in "${raw_osss[@]}"; do
          o="$(echo "$o" | xargs)"
          if [[ -n "$o" ]]; then
            o="$(printf "%s" "$o" | tr '[:lower:]' '[:upper:]')"
            if ! array_contains "$o" ${OSS_NUMBERS[@]+"${OSS_NUMBERS[@]}"}; then
              OSS_NUMBERS+=("$o")
            fi
          fi
        done
        shift 1
      done
      ;;
    --show-changelog)
      SHOW_CHANGELOG=true
      shift 1
      ;;
    --output)
      if [[ -z "${2:-}" || "$2" =~ ^-- ]]; then
        log_error "--output 옵션에는 저장할 파일 경로를 지정해야 합니다."
        exit 1
      fi
      OUTPUT_FILE="$2"
      shift 2
      ;;
    --offline)
      ONLINE_MODE=false
      shift 1
      ;;
    --verbose)
      VERBOSE=true
      shift 1
      ;;
    --help)
      help
      exit 0
      ;;
    *)
      log_error "알 수 없는 옵션입니다: $1"
      echo ""
      help
      exit 1
      ;;
  esac
done

# 인자 유효성 검증
if [[ ${#TARGET_PACKAGES[@]} -eq 0 && ${#OSS_NUMBERS[@]} -eq 0 ]]; then
  log_error "실행할 작업이 지정되지 않았습니다. --package 또는 --oss-number 옵션을 1개 이상 지정하십시오."
  echo ""
  help
  exit 1
fi

if [[ "$SHOW_CHANGELOG" == "true" && ${#TARGET_PACKAGES[@]} -eq 0 ]]; then
  log_error "--show-changelog 옵션은 --package 옵션과 함께 사용해야 합니다."
  exit 1
fi

# 환경 및 패키지 매니저 판별
detect_environment() {
  local os_type="unknown"
  local pkg_mgr="unknown"
  local os_desc="Unknown OS"

  if [[ "$(uname -s)" == "Darwin" ]]; then
    os_type="darwin"
    os_desc="macOS $(sw_vers -productVersion 2>/dev/null || echo '')"
    if command -v brew >/dev/null 2>&1; then
      pkg_mgr="brew"
    elif command -v port >/dev/null 2>&1; then
      pkg_mgr="port"
    fi
  elif [[ -f /etc/os-release ]]; then
    local id="" id_like="" pretty_name=""
    id="$(grep -E '^ID=' /etc/os-release | cut -d'=' -f2 | tr -d '"')"
    id_like="$(grep -E '^ID_LIKE=' /etc/os-release | cut -d'=' -f2 | tr -d '"')"
    pretty_name="$(grep -E '^PRETTY_NAME=' /etc/os-release | cut -d'=' -f2 | tr -d '"')"
    os_desc="${pretty_name:-$id}"

    if [[ "$id" =~ ^(ubuntu|debian|linuxmint|pop)$ || "$id_like" =~ (debian|ubuntu) ]]; then
      os_type="debian"
      if command -v dpkg-query >/dev/null 2>&1; then
        pkg_mgr="dpkg"
      fi
    elif [[ "$id" =~ ^(rhel|rocky|almalinux|centos|fedora|ol)$ || "$id_like" =~ (rhel|fedora|centos) ]]; then
      os_type="rhel"
      if command -v rpm >/dev/null 2>&1; then
        pkg_mgr="rpm"
      fi
    elif [[ "$id" =~ ^(sles|opensuse.*)$ || "$id_like" =~ (suse) ]]; then
      os_type="suse"
      if command -v zypper >/dev/null 2>&1 || command -v rpm >/dev/null 2>&1; then
        pkg_mgr="zypper"
      fi
    elif [[ "$id" =~ ^(arch|manjaro|endeavouros)$ || "$id_like" =~ (arch) ]]; then
      os_type="arch"
      if command -v pacman >/dev/null 2>&1; then
        pkg_mgr="pacman"
      fi
    elif [[ "$id" =~ ^(alpine)$ ]]; then
      os_type="alpine"
      if command -v apk >/dev/null 2>&1; then
        pkg_mgr="apk"
      fi
    fi
  fi

  if [[ "$pkg_mgr" == "unknown" ]]; then
    if command -v dpkg-query >/dev/null 2>&1; then
      os_type="debian"; pkg_mgr="dpkg"
    elif command -v rpm >/dev/null 2>&1; then
      os_type="rhel"; pkg_mgr="rpm"
    elif command -v pacman >/dev/null 2>&1; then
      os_type="arch"; pkg_mgr="pacman"
    elif command -v apk >/dev/null 2>&1; then
      os_type="alpine"; pkg_mgr="apk"
    elif command -v brew >/dev/null 2>&1; then
      os_type="darwin"; pkg_mgr="brew"
    fi
  fi

  echo "${os_type}|${pkg_mgr}|${os_desc}"
}

ENV_INFO="$(detect_environment)"
OS_TYPE="$(echo "$ENV_INFO" | cut -d'|' -f1)"
PKG_MGR="$(echo "$ENV_INFO" | cut -d'|' -f2)"
OS_DESC="$(echo "$ENV_INFO" | cut -d'|' -f3)"

if [[ "$OS_TYPE" == "debian" && "$ONLINE_MODE" == "false" && ${#TARGET_PACKAGES[@]} -eq 0 && ${#OSS_NUMBERS[@]} -gt 0 ]]; then
  log_warn "오프라인(Ubuntu/Debian) 모드에서는 --package 옵션을 함께 지정해야 로컬 체인지로그 기반 패치 여부 확인이 가능합니다."
fi

log_debug "OS 환경: ${OS_DESC} (OS 유형: ${OS_TYPE})"
log_debug "패키지 매니저: ${PKG_MGR}"
log_debug "온라인 모드: ${ONLINE_MODE}"

##
# 패키지 설치 여부 및 기본 버전 정보 조회
#
# @param $1 {String} 패키지명
# @return 0: 설치됨, 1: 미설치
##
get_package_info() {
  local pkg="$1"
  local info_out=""

  case "$PKG_MGR" in
    dpkg)
      info_out="$(dpkg-query -W -f='${Package}\t${Version}\t${Architecture}\t${Status}\n' "$pkg" 2>/dev/null || true)"
      if [[ -n "$info_out" && "$info_out" =~ install[[:space:]]+ok[[:space:]]+installed ]]; then
        local p_name p_ver p_arch
        p_name="$(echo "$info_out" | awk '{print $1}')"
        p_ver="$(echo "$info_out" | awk '{print $2}')"
        p_arch="$(echo "$info_out" | awk '{print $3}')"
        printf "  📦 %-20s : 버전 %-20s (%-6s) | \033[1;32m[설치됨]\033[0m\n" "$p_name" "$p_ver" "$p_arch"
        return 0
      fi
      ;;
    rpm|zypper)
      info_out="$(rpm -q --queryformat '%{NAME}\t%{VERSION}-%{RELEASE}\t%{ARCH}\n' "$pkg" 2>/dev/null || true)"
      if [[ -n "$info_out" && ! "$info_out" =~ "is not installed" ]]; then
        local p_name p_ver p_arch
        p_name="$(echo "$info_out" | awk '{print $1}')"
        p_ver="$(echo "$info_out" | awk '{print $2}')"
        p_arch="$(echo "$info_out" | awk '{print $3}')"
        printf "  📦 %-20s : 버전 %-20s (%-6s) | \033[1;32m[설치됨]\033[0m\n" "$p_name" "$p_ver" "$p_arch"
        return 0
      fi
      ;;
    pacman)
      info_out="$(pacman -Q "$pkg" 2>/dev/null || true)"
      if [[ -n "$info_out" ]]; then
        local p_name p_ver
        p_name="$(echo "$info_out" | awk '{print $1}')"
        p_ver="$(echo "$info_out" | awk '{print $2}')"
        printf "  📦 %-20s : 버전 %-20s | \033[1;32m[설치됨]\033[0m\n" "$p_name" "$p_ver"
        return 0
      fi
      ;;
    apk)
      info_out="$(apk info -v "$pkg" 2>/dev/null || true)"
      if [[ -n "$info_out" ]]; then
        printf "  📦 %-20s : %-20s | \033[1;32m[설치됨]\033[0m\n" "$pkg" "$info_out"
        return 0
      fi
      ;;
    brew)
      info_out="$(brew list --versions "$pkg" 2>/dev/null || true)"
      if [[ -n "$info_out" ]]; then
        printf "  📦 %-20s : %-20s | \033[1;32m[설치됨]\033[0m\n" "$pkg" "$info_out"
        return 0
      fi
      ;;
  esac

  printf "  📦 %-20s : \033[1;33m[미설치 (Not Installed)]\033[0m\n" "$pkg"
  return 1
}

##
# 패키지의 체인지로그 내용 추출
#
# @param $1 {String} 패키지명
# @return 0: 성공, 1: 실패
##
fetch_changelog() {
  local pkg="$1"
  local content=""
  local fetched=false

  case "$PKG_MGR" in
    dpkg)
      # 1순위: 현재 로컬 시스템에 설치된 실제 패키지의 체인지로그 검사
      local candidates=(
        "/usr/share/doc/${pkg}/changelog.Debian.gz"
        "/usr/share/doc/${pkg}/changelog.gz"
        "/usr/share/doc/${pkg}/changelog.Debian"
        "/usr/share/doc/${pkg}/changelog"
      )

      while IFS= read -r f; do
        [[ -n "$f" ]] && candidates+=("$f")
      done < <(find /usr/share/doc -maxdepth 2 -type f \( -name "changelog.Debian.gz" -o -name "changelog.gz" \) -path "/usr/share/doc/${pkg}*/*" 2>/dev/null || true)

      for target_file in "${candidates[@]}"; do
        if [[ -f "$target_file" ]]; then
          log_debug "로컬 체인지로그 파일 발견: $target_file"
          if [[ "$target_file" =~ \.gz$ ]]; then
            content="$(gzip -dc "$target_file" 2>/dev/null || true)"
          else
            content="$(cat "$target_file" 2>/dev/null || true)"
          fi
          if [[ -n "$content" ]]; then
            printf "%s\n" "$content"
            return 0
          fi
        fi
      done

      # 2순위 (폴백): 로컬 파일이 없고 온라인 모드인 경우 원격 저장소에서 조회
      if [[ "$ONLINE_MODE" == "true" ]] && command -v apt-get >/dev/null 2>&1; then
        log_debug "'$pkg' 온라인 체인지로그 조회 시도 (PAGER=cat timeout 20 apt-get changelog)..."
        content="$(PAGER=cat timeout 20 apt-get changelog "$pkg" 2>/dev/null || true)"
        if [[ -n "$content" ]]; then
          printf "%s\n" "$content"
          return 0
        fi
      fi
      ;;

    rpm|zypper)
      log_debug "'$pkg' RPM 체인지로그 조회..."
      local latest_rpm=""
      latest_rpm="$(LC_ALL=C rpm -q "$pkg" 2>/dev/null | sort -V | tail -n 1 || true)"
      if [[ -n "$latest_rpm" ]]; then
        content="$(LC_ALL=C rpm -q --changelog "$latest_rpm" 2>/dev/null || true)"
      else
        content="$(LC_ALL=C rpm -q --changelog "$pkg" 2>/dev/null || true)"
      fi
      if [[ -n "$content" ]]; then
        printf "%s\n" "$content"
        fetched=true
      fi
      ;;

    pacman)
      content="$(pacman -Qc "$pkg" 2>/dev/null || true)"
      if [[ -n "$content" ]]; then
        printf "%s\n" "$content"
        fetched=true
      fi
      ;;

    apk)
      content="$(apk info -w "$pkg" 2>/dev/null || true)"
      if [[ -n "$content" ]]; then
        printf "%s\n" "$content"
        fetched=true
      fi
      ;;

    brew)
      content="$(brew log "$pkg" -n 50 2>/dev/null || true)"
      if [[ -n "$content" ]]; then
        printf "%s\n" "$content"
        fetched=true
      fi
      ;;
  esac

  [[ "$fetched" == "true" ]] && return 0
  return 1
}

# 권고 분석 결과 변수군 (구분자 충돌 방지를 위한 전역 변수 전달)
ADV_TITLE=""
ADV_TITLE_FULL=""
ADV_STATUS=""
ADV_PKG=""
declare -a ADV_CVES=()
declare -a ADV_SOURCES=()

##
# 콘솔 가독성을 위해 과도하게 긴 제목을 지정된 최대 길이로 축약
#
# @param $1 {String} 원본 제목 문자열
# @param $2 {Number} 최대 허용 길이 (기본값: 120)
##
truncate_title() {
  local title="$1"
  local max_len="${2:-120}"
  if [[ ${#title} -gt "$max_len" ]]; then
    printf "%s..." "${title:0:$((max_len - 3))}"
  else
    printf "%s" "$title"
  fi
}

##
# DNF updateinfo 명령을 안전하게 실행 (타임아웃, 영문 로케일, 캐시 폴백 지원)
#
# @param $@ {String...} dnf updateinfo 서브인자 (예: info --all --cve CVE-...)
# @return 0: 실행 완료
##
run_dnf_updateinfo() {
  local out=""
  local rc=0

  if [[ "$ONLINE_MODE" == "false" ]]; then
    out="$(LC_ALL=C timeout 20 dnf -C --setopt=skip_if_unavailable=True updateinfo "$@" < /dev/null 2>/dev/null)" || rc=$?
    [[ "$rc" -eq 124 ]] && log_warn "DNF 로컬 캐시 조회 시간 초과(20초)"
    printf "%s\n" "$out"
    return 0
  fi

  out="$(LC_ALL=C timeout 20 dnf --setopt=timeout=5 --setopt=retries=1 --setopt=skip_if_unavailable=True updateinfo "$@" < /dev/null 2>/dev/null)" || rc=$?
  if [[ "$rc" -eq 124 || "$rc" -ne 0 ]] || ! echo "$out" | grep -qE "Update ID:|Title:|===+"; then
    if [[ "$rc" -eq 124 ]]; then
      log_warn "DNF 온라인 조회 시간 초과(20초) - 로컬 캐시(-C)로 폴백 조회합니다."
    elif [[ "$rc" -ne 0 ]]; then
      log_debug "DNF 온라인 조회 실패(rc=$rc) - 로컬 캐시(-C)로 폴백 조회합니다."
    fi
    local cache_out=""
    local cache_rc=0
    cache_out="$(LC_ALL=C timeout 20 dnf -C --setopt=skip_if_unavailable=True updateinfo "$@" < /dev/null 2>/dev/null)" || cache_rc=$?
    if [[ -n "$cache_out" ]] && echo "$cache_out" | grep -qE "Update ID:|Title:|===+"; then
      out="$cache_out"
    fi
  fi

  printf "%s\n" "$out"
  return 0
}

##
# DNF updateinfo info 출력 결과에서 제목, 패치 상태, 영향 패키지 추출
#
# @param $1 {String} dnf updateinfo info 출력 원문
# @param $2 {String} 대상 권고 ID 또는 CVE 번호
# @return 0: 매칭 성공, 1: 매칭 실패
##
parse_dnf_updateinfo_result() {
  local dnf_out="$1"
  local target_id="$2"

  if ! echo "$dnf_out" | grep -q "$target_id"; then
    return 1
  fi

  local update_id banner_title title_field resolved_title
  update_id="$(echo "$dnf_out" | grep -E "^[[:space:]]*Update ID[[:space:]]*:" | head -n 1 | sed -e 's/^[[:space:]]*Update ID[[:space:]]*:[[:space:]]*//')"
  banner_title="$(echo "$dnf_out" | awk '/^===+$/{getline; if ($0 !~ /^===+$/) {gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0); print; exit}}')"
  title_field="$(echo "$dnf_out" | grep -E "^[[:space:]]*Title[[:space:]]*:" | head -n 1 | sed -e 's/^[[:space:]]*Title[[:space:]]*:[[:space:]]*//')"
  resolved_title="${title_field:-$banner_title}"

  if [[ -n "$resolved_title" && -n "$update_id" ]]; then
    ADV_TITLE="${resolved_title} (${update_id})"
  elif [[ -n "$resolved_title" ]]; then
    ADV_TITLE="$resolved_title"
  fi

  if echo "$dnf_out" | grep -qiE "^[[:space:]]*Installed[[:space:]]*:[[:space:]]*false"; then
    ADV_STATUS="업데이트 가능 (Available - 패치 미적용)"
  elif echo "$dnf_out" | grep -qiE "^[[:space:]]*Installed[[:space:]]*:[[:space:]]*true"; then
    ADV_STATUS="해결됨 (Resolved - 이미 패치 적용됨)"
  else
    ADV_STATUS="업데이트 가능 (Available - 패치 미적용)"
  fi

  ADV_PKG="$(echo "$dnf_out" | grep -E "^[[:space:]]*Packages[[:space:]]*:" -A 5 | grep -E "^[[:space:]]+[a-zA-Z0-9]" | head -n 1 | awk '{print $1}')"
  if [[ -z "$ADV_PKG" && -n "$banner_title" ]]; then
    ADV_PKG="$(echo "$banner_title" | sed -nE 's/^[A-Za-z]+:[[:space:]]*([a-zA-Z0-9._+-]+)[[:space:]]+security.*/\1/p' | head -n 1)"
  fi

  return 0
}

##
# OS 보안 권고사항 번호로부터 연관 CVE 목록 및 권고 요약 정보 추출
#
# @param $1 {String} 권고 번호 (USN, RHSA, DSA 등 또는 CVE)
##
resolve_advisory_info() {
  local advisory="$1"
  ADV_TITLE="Security Advisory: $advisory"
  ADV_TITLE_FULL="$ADV_TITLE"
  ADV_STATUS="확인 필요"
  ADV_PKG=""
  ADV_CVES=()
  ADV_SOURCES=()

  # 1) 입력값이 이미 CVE 형식인 경우
  if [[ "$advisory" =~ ^CVE-[0-9]{4}-[0-9]+$ ]]; then
    ADV_TITLE="CVE 단독 취약점 ($advisory)"
    ADV_TITLE_FULL="$ADV_TITLE"
    ADV_STATUS="체인지로그 점검 필요"
    ADV_PKG=""
    ADV_CVES=("$advisory")

    local resolved=false

    # [Ubuntu 환경 1순위 고속 조회]: Canonical 공식 보안 REST API 직접 조회 (0.3초 내 초고속 파싱)
    if [[ "$OS_TYPE" == "debian" && "$ONLINE_MODE" == "true" ]] && command -v curl >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
      log_debug "Canonical 공식 보안 REST API를 통해 '$advisory' 초고속 조회..."
      start_step_spinner "${ADV_PROGRESS_PREFIX}${advisory} - Canonical 보안 API"
      local codename=""
      codename="$(grep -E '^VERSION_CODENAME=' /etc/os-release 2>/dev/null | cut -d'=' -f2 | tr -d '"' || true)"

      local api_output
      api_output="$(curl -s --connect-timeout 5 --max-time 10 --retry 2 --retry-delay 1 "https://ubuntu.com/security/cves/${advisory}.json" 2>/dev/null | python3 -c '
import json, sys

try:
    data = json.load(sys.stdin)
    cve_id = data.get("id", "")
    notices = data.get("notices_ids", [])
    desc = data.get("description", "").strip().split("\n")[0]
    codename = sys.argv[1] if len(sys.argv) > 1 else ""
    pkgs = []
    rel_p_names = []
    other_p_names = []
    for p in data.get("packages", []):
        p_name = p.get("name", "")
        has_rel = False
        for st in p.get("statuses", []):
            if st.get("release_codename") == codename:
                has_rel = True
                pkgs.append(p_name + ":::" + st.get("status", "") + ":::" + st.get("description", ""))
        if p_name:
            if has_rel and p_name not in rel_p_names:
                rel_p_names.append(p_name)
            elif not has_rel and p_name not in rel_p_names and p_name not in other_p_names:
                other_p_names.append(p_name)

    p_names = rel_p_names + [n for n in other_p_names if n not in rel_p_names]

    if p_names:
        title_full = ", ".join(p_names) + " vulnerability"
        if len(p_names) > 3:
            title_short = ", ".join(p_names[:3]) + f" 외 {len(p_names) - 3}개 패키지 vulnerability"
        else:
            title_short = title_full
    elif desc:
        title_full = desc[:60]
        title_short = title_full
    else:
        title_full = "CVE 보안 취약점"
        title_short = title_full

    if notices:
        title_full += " (" + ", ".join(notices) + ")"
        if len(notices) > 3:
            title_short += " (" + ", ".join(notices[:3]) + f" 외 {len(notices) - 3}건)"
        else:
            title_short += " (" + ", ".join(notices) + ")"

    print("TITLE_SHORT=" + title_short)
    print("TITLE_FULL=" + title_full)
    print("PKGS=" + "\t".join(pkgs))
except Exception:
    sys.exit(1)
' "$codename" 2>/dev/null || true)"

      if [[ -n "$api_output" ]]; then
        local p_title_short="" p_title_full="" p_pkgs=""
        p_title_short="$(echo "$api_output" | grep -E '^TITLE_SHORT=' | sed 's/^TITLE_SHORT=//')"
        p_title_full="$(echo "$api_output" | grep -E '^TITLE_FULL=' | sed 's/^TITLE_FULL=//')"
        p_pkgs="$(echo "$api_output" | grep -E '^PKGS=' | sed 's/^PKGS=//')"

        [[ -n "$p_title_short" ]] && ADV_TITLE="$p_title_short"
        [[ -n "$p_title_full" ]] && ADV_TITLE_FULL="$p_title_full" || ADV_TITLE_FULL="$ADV_TITLE"

        if [[ -n "$p_pkgs" ]]; then
          local has_installed=false
          IFS=$'\t' read -r -a pkg_items <<< "$p_pkgs"
          for item in "${pkg_items[@]}"; do
            [[ -z "$item" ]] && continue
            local s_pkg="${item%%:::*}"
            local rest="${item#*:::}"
            local s_status="${rest%%:::*}"
            local s_fix_ver="${rest#*:::}"

            local inst_status
            inst_status="$(dpkg-query -W -f='${Status}' "$s_pkg" 2>/dev/null || true)"
            if [[ "$inst_status" =~ install[[:space:]]+ok[[:space:]]+installed ]]; then
              has_installed=true
              ADV_PKG="$s_pkg"
              local inst_ver
              inst_ver="$(dpkg-query -W -f='${Version}' "$s_pkg" 2>/dev/null || true)"

              if [[ "$s_status" == "released" ]]; then
                if [[ -n "$s_fix_ver" ]] && dpkg --compare-versions "$inst_ver" ge "$s_fix_ver" 2>/dev/null; then
                  ADV_STATUS="해결됨 (Resolved - 이미 패치 적용됨)"
                else
                  ADV_STATUS="업데이트 가능 (Available - 패치 미적용)"
                fi
              elif [[ "$s_status" =~ ^(not-affected|DNE|ignored)$ ]]; then
                ADV_STATUS="해당 없음 (Not Affected)"
              elif [[ "$s_status" =~ (needed|pending|deferred) ]]; then
                ADV_STATUS="업데이트 대기중 (Pending/Needed - 패치 미배포)"
              fi
              break
            fi
          done

          if [[ "$has_installed" == "false" && ${#pkg_items[@]} -gt 0 ]]; then
            local first_item="${pkg_items[0]}"
            ADV_PKG="${first_item%%:::*}"
            local first_rest="${first_item#*:::}"
            local first_status="${first_rest%%:::*}"
            if [[ "$first_status" =~ ^(not-affected|DNE|ignored)$ ]]; then
              ADV_STATUS="해당 없음 (Not Affected - 본 릴리즈 미영향)"
            else
              ADV_STATUS="해당 없음 (Not Affected - 패키지 미설치)"
            fi
          fi
        else
          ADV_STATUS="해당 없음 (Not Affected - 본 릴리즈 미영향)"
        fi

        resolved=true
        stop_step_spinner "완료" "true"
        ADV_SOURCES+=("Canonical 보안 API")
      else
        stop_step_spinner "실패" "false"
        ADV_SOURCES+=("Canonical 보안 API (실패)")
      fi
    fi

    # [Ubuntu 환경 2순위 폴백]: Ubuntu Pro CLI 활용 (온라인 모드 전용 - 폐쇄망 타임아웃 방지)
    if [[ "$resolved" == "false" && "$OS_TYPE" == "debian" && "$ONLINE_MODE" == "true" ]] && command -v pro >/dev/null 2>&1; then
      log_debug "Ubuntu Pro 도구를 통해 '$advisory' 분석 (pro fix --dry-run)..."
      start_step_spinner "${ADV_PROGRESS_PREFIX}${advisory} - Ubuntu Pro CLI 폴백"
      local pro_out
      pro_out="$(timeout 15 pro fix --dry-run "$advisory" 2>&1 || true)"

      local parsed_title
      parsed_title="$(echo "$pro_out" | grep -E "^${advisory}:" | head -n 1 | sed "s/^${advisory}:[[:space:]]*//")"
      if [[ -n "$parsed_title" ]]; then
        ADV_TITLE="$parsed_title"
        ADV_TITLE_FULL="$parsed_title"
      fi

      if echo "$pro_out" | grep -q "is resolved"; then
        ADV_STATUS="해결됨 (Resolved - 이미 패치 적용됨)"
        stop_step_spinner "완료" "true"
        ADV_SOURCES+=("Ubuntu Pro CLI 폴백")
      elif echo "$pro_out" | grep -q "A fix is available"; then
        ADV_STATUS="업데이트 가능 (Available - 패치 미적용)"
        stop_step_spinner "완료" "true"
        ADV_SOURCES+=("Ubuntu Pro CLI 폴백")
      elif echo "$pro_out" | grep -q "is not affected"; then
        ADV_STATUS="해당 없음 (Not Affected)"
        stop_step_spinner "완료" "true"
        ADV_SOURCES+=("Ubuntu Pro CLI 폴백")
      else
        ADV_STATUS="확인 필요 (API 조회 실패)"
        stop_step_spinner "실패" "false"
        ADV_SOURCES+=("Ubuntu Pro CLI 폴백 (실패)")
      fi

      ADV_PKG="$(echo "$pro_out" | grep -A 2 "affected source package is installed:" | grep -E "^\([0-9]+/[0-9]+\)" | awk '{print $2}' | tr -d ":" | head -n 1)"
      resolved=true
    fi

    if [[ "$resolved" == "false" && "$OS_TYPE" == "debian" && "$ONLINE_MODE" == "true" ]]; then
      ADV_STATUS="확인 필요 (API 조회 실패)"
    fi

    if [[ "$ONLINE_MODE" == "false" && ( "$OS_TYPE" == "debian" || "$OS_TYPE" == "arch" ) ]]; then
      ADV_SOURCES+=("오프라인 모드 (원격 조회 생략, 로컬 체인지로그 점검)")
    fi

    # [RHEL/Rocky 환경]: DNF updateinfo 연동
    if [[ "$resolved" == "false" && "$OS_TYPE" == "rhel" ]] && command -v dnf >/dev/null 2>&1; then
      log_debug "DNF updateinfo를 통해 '$advisory' 분석..."
      if [[ "$ONLINE_MODE" == "false" ]]; then
        start_step_spinner "${ADV_PROGRESS_PREFIX}${advisory} - DNF 로컬 캐시 (-C)"
      else
        start_step_spinner "${ADV_PROGRESS_PREFIX}${advisory} - DNF updateinfo"
      fi
      local dnf_out
      dnf_out="$(run_dnf_updateinfo info --all --cve "$advisory")"
      if parse_dnf_updateinfo_result "$dnf_out" "$advisory"; then
        ADV_TITLE_FULL="$ADV_TITLE"
        resolved=true
        stop_step_spinner "완료" "true"
      else
        ADV_STATUS="해당 없음 (Not Affected - 관련 권고 없음)"
        stop_step_spinner "완료" "true"
      fi
      if [[ "$ONLINE_MODE" == "false" ]]; then
        ADV_SOURCES+=("DNF 로컬 캐시 (-C)")
      else
        ADV_SOURCES+=("DNF updateinfo")
      fi
    fi

    # [Arch Linux 환경]: Arch Security Tracker REST API 및 arch-audit 연동
    if [[ "$resolved" == "false" && "$OS_TYPE" == "arch" ]]; then
      if [[ "$ONLINE_MODE" == "true" ]] && command -v curl >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
        log_debug "Arch Security Tracker REST API를 통해 '$advisory' 조회..."
        start_step_spinner "${ADV_PROGRESS_PREFIX}${advisory} - Arch Security Tracker"
        local arch_resp http_code arch_json
        arch_resp="$(curl -s -w "\nHTTP_CODE:%{http_code}" --connect-timeout 3 --max-time 8 --retry 2 --retry-delay 1 "https://security.archlinux.org/${advisory}.json" 2>/dev/null || true)"
        http_code="$(echo "$arch_resp" | grep -E '^HTTP_CODE:' | tail -n 1 | cut -d':' -f2)"
        arch_json="$(echo "$arch_resp" | sed '/^HTTP_CODE:/d')"

        if [[ "$http_code" == "404" ]]; then
          ADV_STATUS="해당 없음 (Not Affected - Arch 트래커 미등록)"
          resolved=true
          stop_step_spinner "완료" "true"
          ADV_SOURCES+=("Arch Security Tracker")
        elif [[ "$http_code" == "200" && -n "$arch_json" ]]; then
          local arch_parsed=""
          arch_parsed="$(printf "%s" "$arch_json" | python3 -c '
import json, sys, urllib.request

try:
    data = json.load(sys.stdin)
    pkgs = data.get("packages", [])
    advisories = data.get("advisories", [])
    groups = data.get("groups", [])
    vtype = data.get("type", "").strip()
    sev = data.get("severity", "").strip()

    full_parts = []
    short_parts = []
    if pkgs:
        full_parts.append(", ".join(pkgs))
        if len(pkgs) > 3:
            short_parts.append(", ".join(pkgs[:3]) + f" 외 {len(pkgs) - 3}개 패키지")
        else:
            short_parts.append(", ".join(pkgs))
    if vtype:
        full_parts.append(vtype)
        short_parts.append(vtype)
    elif data.get("description"):
        d = data.get("description", "").strip().split("\n")[0][:50]
        full_parts.append(d)
        short_parts.append(d)

    title_full = " - ".join(full_parts) if full_parts else "Arch Security Issue"
    title_short = " - ".join(short_parts) if short_parts else "Arch Security Issue"
    if sev:
        title_full = f"[{sev}] {title_full}"
        title_short = f"[{sev}] {title_short}"
    if advisories:
        title_full += " (" + ", ".join(advisories) + ")"
        if len(advisories) > 3:
            title_short += " (" + ", ".join(advisories[:3]) + f" 외 {len(advisories) - 3}건)"
        else:
            title_short += " (" + ", ".join(advisories) + ")"

    avg_status = ""
    fixed_ver = ""
    if groups:
        try:
            req = urllib.request.Request(f"https://security.archlinux.org/{groups[0]}.json")
            with urllib.request.urlopen(req, timeout=5) as resp:
                avg_data = json.loads(resp.read().decode("utf-8"))
                avg_status = avg_data.get("status", "") or ""
                fixed_ver = avg_data.get("fixed", "") or ""
        except Exception:
            pass

    print("TITLE_SHORT=" + title_short)
    print("TITLE_FULL=" + title_full)
    print("STATUS=" + avg_status)
    print("FIXED=" + fixed_ver)
    print("PKGS=" + " ".join(pkgs))
except Exception:
    sys.exit(1)
' 2>/dev/null || true)"

          if [[ -n "$arch_parsed" ]]; then
            local a_title_short="" a_title_full="" a_status="" a_fixed="" a_pkgs=""
            a_title_short="$(echo "$arch_parsed" | grep -E '^TITLE_SHORT=' | sed 's/^TITLE_SHORT=//')"
            a_title_full="$(echo "$arch_parsed" | grep -E '^TITLE_FULL=' | sed 's/^TITLE_FULL=//')"
            a_status="$(echo "$arch_parsed" | grep -E '^STATUS=' | sed 's/^STATUS=//')"
            a_fixed="$(echo "$arch_parsed" | grep -E '^FIXED=' | sed 's/^FIXED=//')"
            a_pkgs="$(echo "$arch_parsed" | grep -E '^PKGS=' | sed 's/^PKGS=//')"

            [[ -n "$a_title_short" ]] && ADV_TITLE="$a_title_short"
            [[ -n "$a_title_full" ]] && ADV_TITLE_FULL="$a_title_full" || ADV_TITLE_FULL="$ADV_TITLE"

            if [[ -n "$a_pkgs" ]]; then
              local has_installed=false
              for s_pkg in $a_pkgs; do
                local inst_ver=""
                inst_ver="$(pacman -Q "$s_pkg" 2>/dev/null | awk '{print $2}' || true)"
                if [[ -n "$inst_ver" ]]; then
                  has_installed=true
                  ADV_PKG="$s_pkg"
                  if [[ "$a_status" == "Not affected" ]]; then
                    ADV_STATUS="해당 없음 (Not Affected)"
                  elif [[ "$a_status" == "Fixed" && -n "$a_fixed" ]]; then
                    if command -v vercmp >/dev/null 2>&1; then
                      local cmp_res
                      cmp_res="$(vercmp "$inst_ver" "$a_fixed" 2>/dev/null || echo -1)"
                      if [[ "$cmp_res" -ge 0 ]]; then
                        ADV_STATUS="해결됨 (Resolved - 이미 패치 적용됨)"
                      else
                        ADV_STATUS="업데이트 가능 (Available - 패치 미적용)"
                      fi
                    else
                      ADV_STATUS="확인 필요 (설치됨: $inst_ver, 패치: $a_fixed)"
                    fi
                  elif [[ "$a_status" =~ ^(Vulnerable|Testing|Unknown)$ || -z "$a_fixed" ]]; then
                    ADV_STATUS="업데이트 대기중 (Vulnerable - 패치 미배포)"
                  fi
                  break
                fi
              done

              if [[ "$has_installed" == "false" ]]; then
                ADV_PKG="$(echo "$a_pkgs" | awk '{print $1}')"
                ADV_STATUS="해당 없음 (Not Affected - 패키지 미설치)"
              fi
            else
              ADV_STATUS="해당 없음 (Not Affected - 영향 패키지 없음)"
            fi
            resolved=true
            stop_step_spinner "완료" "true"
            ADV_SOURCES+=("Arch Security Tracker")
          else
            stop_step_spinner "실패" "false"
            ADV_SOURCES+=("Arch Security Tracker (실패)")
          fi
        else
          stop_step_spinner "실패" "false"
          ADV_SOURCES+=("Arch Security Tracker (실패)")
        fi
      fi

      if [[ "$resolved" == "false" && "$ONLINE_MODE" == "true" ]] && command -v arch-audit >/dev/null 2>&1; then
        log_debug "arch-audit를 통해 '$advisory' 조회..."
        start_step_spinner "${ADV_PROGRESS_PREFIX}${advisory} - arch-audit"
        local aa_out=""
        aa_out="$(timeout 15 arch-audit -f "%n|%c|%t" 2>/dev/null | grep -i "$advisory" | head -n 1 || true)"
        if [[ -n "$aa_out" ]]; then
          ADV_PKG="$(echo "$aa_out" | cut -d'|' -f1)"
          ADV_STATUS="업데이트 가능 (Available - 패치 미적용)"
          resolved=true
          stop_step_spinner "완료" "true"
          ADV_SOURCES+=("arch-audit")
        else
          stop_step_spinner "실패" "false"
          ADV_SOURCES+=("arch-audit (미매칭)")
        fi
        if [[ "$resolved" == "false" && "$ONLINE_MODE" == "true" ]]; then
          ADV_STATUS="확인 필요 (API 조회 실패)"
        fi
      fi
    fi

    return 0
  fi

  # 2) Ubuntu 환경에서 USN- 형식인 경우
  if [[ "$advisory" =~ ^USN-[0-9]+-[0-9]+$ ]]; then
    local resolved=false

    # [1순위 고속 조회]: Canonical 공식 보안 REST API 직접 조회 (0.3초 내 초고속 파싱)
    if [[ "$ONLINE_MODE" == "true" ]] && command -v curl >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
      log_debug "Canonical 공식 보안 REST API를 통해 '$advisory' 초고속 조회..."
      start_step_spinner "${ADV_PROGRESS_PREFIX}${advisory} - Canonical 보안 API"
      local codename=""
      codename="$(grep -E '^VERSION_CODENAME=' /etc/os-release 2>/dev/null | cut -d'=' -f2 | tr -d '"' || true)"

      local api_output
      api_output="$(curl -s --connect-timeout 3 --max-time 8 --retry 2 --retry-delay 1 "https://ubuntu.com/security/notices/${advisory}.json" 2>/dev/null | python3 -c '
import json, sys

try:
    data = json.load(sys.stdin)
    title = data.get("title", "").strip()
    cves = " ".join(data.get("cves_ids", []))
    codename = sys.argv[1] if len(sys.argv) > 1 else ""
    rp = data.get("release_packages", {}).get(codename, [])
    pkgs = []
    for p in rp:
        if p.get("is_source"):
            pkgs.append(p.get("name", "") + ":" + p.get("version", ""))
    print("TITLE=" + title)
    print("CVES=" + cves)
    print("PKGS=" + " ".join(pkgs))
except Exception:
    sys.exit(1)
' "$codename" 2>/dev/null || true)"

      if [[ -n "$api_output" ]]; then
        local p_title="" p_cves="" p_pkgs=""
        p_title="$(echo "$api_output" | grep -E '^TITLE=' | sed 's/^TITLE=//')"
        p_cves="$(echo "$api_output" | grep -E '^CVES=' | sed 's/^CVES=//')"
        p_pkgs="$(echo "$api_output" | grep -E '^PKGS=' | sed 's/^PKGS=//')"

        if [[ -n "$p_title" ]]; then
          ADV_TITLE="$p_title"
          ADV_TITLE_FULL="$p_title"
        fi

        if [[ -n "$p_cves" ]]; then
          IFS=' ' read -r -a ADV_CVES <<< "$p_cves"
        fi

        # 시스템 상태 판정: 설치된 패키지와 API 픽스 버전 정밀 비교
        if [[ -n "$p_pkgs" ]]; then
          local has_installed=false
          for item in $p_pkgs; do
            local s_pkg="${item%%:*}"
            local s_fix_ver="${item#*:}"
            local inst_status
            inst_status="$(dpkg-query -W -f='${Status}' "$s_pkg" 2>/dev/null || true)"
            if [[ "$inst_status" =~ install[[:space:]]+ok[[:space:]]+installed ]]; then
              has_installed=true
              ADV_PKG="$s_pkg"
              local inst_ver
              inst_ver="$(dpkg-query -W -f='${Version}' "$s_pkg" 2>/dev/null || true)"
              if dpkg --compare-versions "$inst_ver" ge "$s_fix_ver" 2>/dev/null; then
                ADV_STATUS="해결됨 (Resolved - 이미 패치 적용됨)"
              else
                ADV_STATUS="업데이트 가능 (Available - 패치 미적용)"
              fi
              break
            fi
          done

          if [[ "$has_installed" == "false" ]]; then
            ADV_PKG="$(echo "$p_pkgs" | awk '{print $1}' | cut -d':' -f1)"
            ADV_STATUS="해당 없음 (Not Affected - 패키지 미설치)"
          fi
        else
          ADV_STATUS="해당 없음 (Not Affected - 본 릴리즈 미영향)"
        fi

        resolved=true
        stop_step_spinner "완료" "true"
        ADV_SOURCES+=("Canonical 보안 API")
      else
        stop_step_spinner "실패" "false"
        ADV_SOURCES+=("Canonical 보안 API (실패)")
      fi
    fi

    # [2순위 폴백]: REST API 접근 불가 시 Ubuntu Pro CLI 활용 (온라인 모드 전용 - 폐쇄망 타임아웃 방지)
    if [[ "$resolved" == "false" && "$ONLINE_MODE" == "true" ]] && command -v pro >/dev/null 2>&1; then
      log_debug "Ubuntu Pro 도구를 통해 '$advisory' 분석 (pro fix --dry-run)..."
      start_step_spinner "${ADV_PROGRESS_PREFIX}${advisory} - Ubuntu Pro CLI 폴백"
      # [안전 가드레일]: 시스템 설치를 방지하기 위해 --dry-run을 반드시 고정 실행
      local pro_out
      pro_out="$(timeout 15 pro fix --dry-run "$advisory" 2>&1 || true)"

      # 제목 파싱
      local parsed_title
      parsed_title="$(echo "$pro_out" | grep -E "^${advisory}:" | head -n 1 | sed "s/^${advisory}:[[:space:]]*//")"
      if [[ -n "$parsed_title" ]]; then
        ADV_TITLE="$parsed_title"
        ADV_TITLE_FULL="$parsed_title"
      fi

      # 해결 상태 파싱
      if echo "$pro_out" | grep -q "is resolved"; then
        ADV_STATUS="해결됨 (Resolved - 이미 패치 적용됨)"
        stop_step_spinner "완료" "true"
        ADV_SOURCES+=("Ubuntu Pro CLI 폴백")
      elif echo "$pro_out" | grep -q "A fix is available"; then
        ADV_STATUS="업데이트 가능 (Available - 패치 미적용)"
        stop_step_spinner "완료" "true"
        ADV_SOURCES+=("Ubuntu Pro CLI 폴백")
      elif echo "$pro_out" | grep -q "is not affected"; then
        ADV_STATUS="해당 없음 (Not Affected)"
        stop_step_spinner "완료" "true"
        ADV_SOURCES+=("Ubuntu Pro CLI 폴백")
      else
        stop_step_spinner "실패" "false"
        ADV_SOURCES+=("Ubuntu Pro CLI 폴백 (실패)")
      fi

      # 영향받는 패키지 파싱
      ADV_PKG="$(echo "$pro_out" | grep -A 2 "affected source package is installed:" | grep -E "^\([0-9]+/[0-9]+\)" | awk '{print $2}' | tr -d ":" | head -n 1)"

      # 연관 CVE 목록 파싱
      while IFS= read -r cve; do
        [[ -n "$cve" ]] && ADV_CVES+=("$cve")
      done < <(echo "$pro_out" | grep -o -E "CVE-[0-9]{4}-[0-9]+" | sort -u || true)
    fi

    if [[ "$ONLINE_MODE" == "false" ]]; then
      ADV_SOURCES+=("오프라인 모드 (원격 조회 생략, 로컬 체인지로그 점검)")
    fi
    return 0
  fi

  # 3) RHEL/Rocky 환경에서 RHSA/RLSA/ALSA 형식인 경우
  if [[ "$advisory" =~ ^(RHSA|RLSA|ALSA|FEDORA)-[0-9]{4}:?[0-9]+$ ]]; then
    if command -v dnf >/dev/null 2>&1; then
      log_debug "DNF updateinfo를 통해 '$advisory' 분석..."
      if [[ "$ONLINE_MODE" == "false" ]]; then
        start_step_spinner "${ADV_PROGRESS_PREFIX}${advisory} - DNF 로컬 캐시 (-C)"
      else
        start_step_spinner "${ADV_PROGRESS_PREFIX}${advisory} - DNF updateinfo"
      fi
      local dnf_out
      dnf_out="$(run_dnf_updateinfo info --all --advisory "$advisory")"
      if parse_dnf_updateinfo_result "$dnf_out" "$advisory"; then
        stop_step_spinner "완료" "true"
      else
        stop_step_spinner "완료" "true"
      fi
      ADV_TITLE_FULL="$ADV_TITLE"
      while IFS= read -r cve; do
        [[ -n "$cve" ]] && ADV_CVES+=("$cve")
      done < <(echo "$dnf_out" | grep -E "^[[:space:]]*CVEs?[[:space:]]*:" -A 20 | grep -o -E "CVE-[0-9]{4}-[0-9]+" | sort -u || true)
      if [[ "$ONLINE_MODE" == "false" ]]; then
        ADV_SOURCES+=("DNF 로컬 캐시 (-C)")
      else
        ADV_SOURCES+=("DNF updateinfo")
      fi
    fi
    return 0
  fi

  # 4) openSUSE / SLES 환경
  if [[ "$advisory" =~ (SUSE-SU|openSUSE-SU) ]]; then
    if command -v zypper >/dev/null 2>&1; then
      log_debug "Zypper patch-info를 통해 '$advisory' 분석..."
      local zyp_out=""
      if [[ "$ONLINE_MODE" == "false" ]]; then
        start_step_spinner "${ADV_PROGRESS_PREFIX}${advisory} - Zypper 로컬 캐시"
        zyp_out="$(LC_ALL=C timeout 20 zypper --no-refresh patch-info "$advisory" < /dev/null 2>/dev/null || true)"
        stop_step_spinner "완료" "true"
        ADV_SOURCES+=("Zypper 로컬 캐시 (--no-refresh)")
      else
        start_step_spinner "${ADV_PROGRESS_PREFIX}${advisory} - Zypper patch-info"
        zyp_out="$(LC_ALL=C timeout 20 zypper patch-info "$advisory" < /dev/null 2>/dev/null || true)"
        stop_step_spinner "완료" "true"
        ADV_SOURCES+=("Zypper patch-info")
      fi
      while IFS= read -r cve; do
        [[ -n "$cve" ]] && ADV_CVES+=("$cve")
      done < <(echo "$zyp_out" | grep -o -E "CVE-[0-9]{4}-[0-9]+" | sort -u || true)
    fi
    return 0
  fi

  return 0
}

##
# 체인지로그에서 특정 CVE 정규식에 일치하는 완전한 블록 전체 추출 (블록 파서)
#
# @param $1 {String} 체인지로그 원문 텍스트
# @param $2 {String} CVE 정규식 패턴 (예: "CVE-2026-123633|CVE-2026-113425")
##
extract_changelog_blocks() {
  local changelog_text="$1"
  local cve_regex="$2"

  echo "$changelog_text" | awk -v pattern="$cve_regex" -v pkg_mgr="${PKG_MGR:-}" '
    BEGIN {
      IGNORECASE = 1
      in_block = 0
      is_rpm_block = 0
      block_header = ""
      cur_block = ""
      cur_item = ""
      matched_items = ""
    }
    function flush_rpm_item() {
      if (cur_item != "" && cur_item ~ pattern) {
        if (matched_items == "") {
          matched_items = cur_item
        } else {
          matched_items = matched_items "\n" cur_item
        }
      }
      cur_item = ""
    }
    function flush_block() {
      if (!in_block) return
      if (is_rpm_block) {
        flush_rpm_item()
        if (matched_items != "") {
          sub(/^[[:space:]]*\*[[:space:]]*/, "  🔒 ", block_header)
          print block_header
          print matched_items
          print ""
        }
      } else {
        if (cur_block ~ pattern) {
          sub(/^[[:space:]]*\*[[:space:]]*/, "  🔒 ", cur_block)
          print cur_block
          print ""
        }
      }
      in_block = 0
      is_rpm_block = 0
      block_header = ""
      cur_block = ""
      cur_item = ""
      matched_items = ""
    }
    # 새 항목 시작 (* 헤더)
    /^[[:space:]]*\*[[:space:]]/ {
      flush_block()
      in_block = 1
      if (pkg_mgr == "rpm" || pkg_mgr == "zypper" || $0 ~ /^[[:space:]]*\*[[:space:]]+(Mon|Tue|Wed|Thu|Fri|Sat|Sun)[[:space:]]/) {
        is_rpm_block = 1
        block_header = $0
      } else {
        is_rpm_block = 0
        cur_block = $0
      }
      next
    }
    # 패키지 헤더 또는 서명 라인 도달 시 현재 블록 종결
    /^[a-zA-Z0-9]/ || /^[[:space:]]*--[[:space:]]/ {
      flush_block()
      next
    }
    # 블록 내부 행 누적
    {
      if (in_block) {
        if (is_rpm_block) {
          if ($0 ~ /^[[:space:]]*-[[:space:]]/) {
            flush_rpm_item()
            cur_item = $0
          } else if (cur_item != "") {
            cur_item = cur_item "\n" $0
          }
        } else {
          cur_block = cur_block "\n" $0
        }
      }
    }
    END {
      flush_block()
    }
  '
}

