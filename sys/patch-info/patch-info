#!/usr/bin/env bash

# ==============================================================================
# @author       : parkjunhong77@gmail.com
# @title        : 패키지 정보 및 보안 패치(CVE/USN/RHSA) 체인지로그 검색 도구
# @description  : 다양한 Linux 배포판 및 macOS에서 설치된 패키지 정보 조회 및 체인지로그 내 보안 패치(CVE, USN 등) 검색
# @license      : Apache License 2.0
# @since        : 2026-11-20
# @desc         : support macOS 11.2.3, Ubuntu 18.04 or higher, RockyOS 8 or higher, Arch Linux, Alpine Linux
# @installation : scriptctl install --script patch-info
# ==============================================================================

# 도움말 출력 함수
help() {
  cat <<'EOF'
[사용법]
  patch-info --package <패키지명...> [옵션]

[설명]
  현재 시스템(Ubuntu, Debian, RHEL, Rocky, openSUSE, Arch, Alpine, macOS 등)에
  설치된 패키지의 버전 정보를 확인하고, 로컬 및 온라인 체인지로그(Changelog)에서
  보안 패치 내역(CVE, USN, RHSA, ALSA 등)을 정규식 기반으로 검색합니다.

[옵션]
  --package <이름...>       조회할 패키지명을 지정합니다.
                            공백으로 여러 패키지를 연속 지정하거나, 옵션을 반복 사용할 수 있습니다.
                            (예: --package nginx nginx-core 또는 --package nginx --package bash)

  --search <패턴>           체인지로그에서 검색할 보안 식별자 또는 POSIX 확장 정규식(ERE) 패턴입니다.
                            대소문자를 구분하지 않고 검색합니다.
                            (예: "CVE-2021-23017", "USN-4966-1", "CVE-2023-[0-9]+", "buffer overflow")
                            여러 취약점을 동시에 검색할 경우 파이프(|)로 연결합니다.
                            (예: "CVE-2021-23017|CVE-2021-3618|USN-4966-1")

  --show-changelog          검색 패턴 필터링 없이 패키지의 전체 체인지로그를 출력합니다.

  --offline                 기본으로 활성화되는 원격/온라인 조회를 차단하고,
                            로컬 파일시스템 및 로컬 패키지 데이터베이스에 저장된 내역만 검색합니다.

  --verbose                 OS 감지 결과, 탐색 파일 경로, 온라인 쿼리 상태 등
                            상세 디버깅 정보를 표준 에러로 출력합니다.

  --help                    도움말 메시지를 출력하고 종료합니다.

[사용 예시]
  # 1) 단일 패키지 버전 및 특정 CVE 보안 패치 여부 확인
  patch-info --package nginx --search "CVE-2021-23017"

  # 2) 여러 패키지를 공백으로 나열하고 복수 CVE/USN 동시 검색
  patch-info --package nginx nginx-core nginx-common --search "USN-4966-1|CVE-2021-23017"

  # 3) 패키지 옵션 반복 지정 및 상세 디버그 로그 활성화
  patch-info --package openssl --package bash --search "CVE-2023-[0-9]+" --verbose

  # 4) 오프라인 모드로 로컬 체인지로그에서만 패치 내역 검색
  patch-info --package linux-image-generic --search "privilege escalation" --offline

  # 5) 패키지의 전체 체인지로그 열람
  patch-info --package sudo --show-changelog
EOF
}

# 디버그 로깅 함수
log_debug() {
  if [[ "$VERBOSE" == "true" ]]; then
    printf "\033[1;34m[DEBUG]\033[0m %s\n" "$*" >&2
  fi
}

# 에러 로깅 함수
log_error() {
  printf "\033[1;31m[ERROR]\033[0m %s\n" "$*" >&2
}

# 정보 로깅 함수
log_info() {
  printf "\033[1;32m[INFO]\033[0m %s\n" "$*"
}

# 경고 로깅 함수
log_warn() {
  printf "\033[1;33m[WARN]\033[0m %s\n" "$*" >&2
}

# 변수 초기화
declare -a TARGET_PACKAGES=()
SEARCH_PATTERN=""
SHOW_CHANGELOG=false
ONLINE_MODE=true
VERBOSE=false

# CLI 옵션 파싱 루프 (Long Option 전용)
while [[ $# -gt 0 ]]; do
  case "$1" in
    --package)
      shift 1
      # 다음 옵션(--)이 나오기 전까지의 모든 인자를 패키지명으로 수집
      while [[ $# -gt 0 && ! "$1" =~ ^-- ]]; do
        TARGET_PACKAGES+=("$1")
        shift 1
      done
      ;;
    --search)
      if [[ -z "$2" || "$2" =~ ^-- ]]; then
        log_error "--search 옵션에 검색 패턴 문자열이 필요합니다."
        help
        exit 1
      fi
      SEARCH_PATTERN="$2"
      shift 2
      ;;
    --show-changelog)
      SHOW_CHANGELOG=true
      shift 1
      ;;
    --offline)
      ONLINE_MODE=false
      shift 1
      ;;
    --verbose)
      VERBOSE=true
      shift 1
      ;;
    --help)
      help
      exit 0
      ;;
    *)
      log_error "알 수 없는 옵션입니다: $1"
      help
      exit 1
      ;;
  esac
done

# 필수 인자 검증
if [[ ${#TARGET_PACKAGES[@]} -eq 0 ]]; then
  log_error "조회할 패키지가 지정되지 않았습니다. --package 옵션으로 1개 이상의 패키지를 지정하십시오."
  echo ""
  help
  exit 1
fi

# 환경 및 패키지 매니저 판별
detect_environment() {
  local os_type="unknown"
  local pkg_mgr="unknown"
  local os_desc="Unknown OS"

  if [[ "$(uname -s)" == "Darwin" ]]; then
    os_type="darwin"
    os_desc="macOS $(sw_vers -productVersion 2>/dev/null || echo '')"
    if command -v brew >/dev/null 2>&1; then
      pkg_mgr="brew"
    elif command -v port >/dev/null 2>&1; then
      pkg_mgr="port"
    fi
  elif [[ -f /etc/os-release ]]; then
    # shellcheck disable=SC1091
    local id="" id_like="" pretty_name=""
    id="$(grep -E '^ID=' /etc/os-release | cut -d'=' -f2 | tr -d '"')"
    id_like="$(grep -E '^ID_LIKE=' /etc/os-release | cut -d'=' -f2 | tr -d '"')"
    pretty_name="$(grep -E '^PRETTY_NAME=' /etc/os-release | cut -d'=' -f2 | tr -d '"')"
    os_desc="${pretty_name:-$id}"

    if [[ "$id" =~ ^(ubuntu|debian|linuxmint|pop)$ || "$id_like" =~ (debian|ubuntu) ]]; then
      os_type="debian"
      if command -v dpkg-query >/dev/null 2>&1; then
        pkg_mgr="dpkg"
      fi
    elif [[ "$id" =~ ^(rhel|rocky|almalinux|centos|fedora|ol)$ || "$id_like" =~ (rhel|fedora|centos) ]]; then
      os_type="rhel"
      if command -v rpm >/dev/null 2>&1; then
        pkg_mgr="rpm"
      fi
    elif [[ "$id" =~ ^(sles|opensuse.*)$ || "$id_like" =~ (suse) ]]; then
      os_type="suse"
      if command -v zypper >/dev/null 2>&1 || command -v rpm >/dev/null 2>&1; then
        pkg_mgr="zypper"
      fi
    elif [[ "$id" =~ ^(arch|manjaro|endeavouros)$ || "$id_like" =~ (arch) ]]; then
      os_type="arch"
      if command -v pacman >/dev/null 2>&1; then
        pkg_mgr="pacman"
      fi
    elif [[ "$id" =~ ^(alpine)$ ]]; then
      os_type="alpine"
      if command -v apk >/dev/null 2>&1; then
        pkg_mgr="apk"
      fi
    fi
  fi

  # 폴백: 바이너리 확인
  if [[ "$pkg_mgr" == "unknown" ]]; then
    if command -v dpkg-query >/dev/null 2>&1; then
      os_type="debian"; pkg_mgr="dpkg"
    elif command -v rpm >/dev/null 2>&1; then
      os_type="rhel"; pkg_mgr="rpm"
    elif command -v pacman >/dev/null 2>&1; then
      os_type="arch"; pkg_mgr="pacman"
    elif command -v apk >/dev/null 2>&1; then
      os_type="alpine"; pkg_mgr="apk"
    elif command -v brew >/dev/null 2>&1; then
      os_type="darwin"; pkg_mgr="brew"
    fi
  fi

  echo "${os_type}|${pkg_mgr}|${os_desc}"
}

ENV_INFO="$(detect_environment)"
OS_TYPE="$(echo "$ENV_INFO" | cut -d'|' -f1)"
PKG_MGR="$(echo "$ENV_INFO" | cut -d'|' -f2)"
OS_DESC="$(echo "$ENV_INFO" | cut -d'|' -f3)"

log_debug "OS 환경: ${OS_DESC} (OS 유형: ${OS_TYPE})"
log_debug "패키지 매니저: ${PKG_MGR}"
log_debug "온라인 모드: ${ONLINE_MODE}"
log_debug "검색 대상 패키지 수: ${#TARGET_PACKAGES[@]}개 (${TARGET_PACKAGES[*]})"

if [[ "$PKG_MGR" == "unknown" ]]; then
  log_error "지원되는 패키지 관리 도구(dpkg, rpm, pacman, apk, brew)를 감지할 수 없습니다."
  exit 1
fi

##
# 패키지 설치 여부 및 기본 버전 정보 조회
#
# @param $1 {String} 패키지명
# @return 0: 설치됨, 1: 미설치 또는 오류
##
get_package_info() {
  local pkg="$1"
  local info_out=""

  case "$PKG_MGR" in
    dpkg)
      info_out="$(dpkg-query -W -f='${Package}\t${Version}\t${Architecture}\t${Status}\n' "$pkg" 2>/dev/null || true)"
      if [[ -n "$info_out" && "$info_out" =~ install[[:space:]]+ok[[:space:]]+installed ]]; then
        local p_name p_ver p_arch
        p_name="$(echo "$info_out" | awk '{print $1}')"
        p_ver="$(echo "$info_out" | awk '{print $2}')"
        p_arch="$(echo "$info_out" | awk '{print $3}')"
        printf "패키지: %s | 버전: %s | 아키텍처: %s | 상태: 설치됨\n" "$p_name" "$p_ver" "$p_arch"
        return 0
      fi
      ;;
    rpm|zypper)
      info_out="$(rpm -q --queryformat '%{NAME}\t%{VERSION}-%{RELEASE}\t%{ARCH}\n' "$pkg" 2>/dev/null || true)"
      if [[ -n "$info_out" && ! "$info_out" =~ "is not installed" ]]; then
        local p_name p_ver p_arch
        p_name="$(echo "$info_out" | awk '{print $1}')"
        p_ver="$(echo "$info_out" | awk '{print $2}')"
        p_arch="$(echo "$info_out" | awk '{print $3}')"
        printf "패키지: %s | 버전: %s | 아키텍처: %s | 상태: 설치됨\n" "$p_name" "$p_ver" "$p_arch"
        return 0
      fi
      ;;
    pacman)
      info_out="$(pacman -Q "$pkg" 2>/dev/null || true)"
      if [[ -n "$info_out" ]]; then
        local p_name p_ver
        p_name="$(echo "$info_out" | awk '{print $1}')"
        p_ver="$(echo "$info_out" | awk '{print $2}')"
        printf "패키지: %s | 버전: %s | 상태: 설치됨\n" "$p_name" "$p_ver"
        return 0
      fi
      ;;
    apk)
      info_out="$(apk info -v "$pkg" 2>/dev/null || true)"
      if [[ -n "$info_out" ]]; then
        printf "패키지: %s | 상태: 설치됨\n" "$info_out"
        return 0
      fi
      ;;
    brew)
      info_out="$(brew list --versions "$pkg" 2>/dev/null || true)"
      if [[ -n "$info_out" ]]; then
        printf "Formula: %s | 상태: 설치됨\n" "$info_out"
        return 0
      fi
      ;;
  esac

  printf "패키지: %s | 상태: \033[1;31m미설치(Not Installed)\033[0m\n" "$pkg"
  return 1
}

##
# 패키지의 체인지로그 내용 추출 (온라인 또는 로컬)
#
# @param $1 {String} 패키지명
# @return 0: 추출 성공, 1: 실패
##
fetch_changelog() {
  local pkg="$1"
  local content=""
  local fetched=false

  case "$PKG_MGR" in
    dpkg)
      # 1. 온라인 모드일 경우 apt-get changelog 시도 (PAGER=cat 및 타임아웃 설정으로 블로킹 방지)
      if [[ "$ONLINE_MODE" == "true" ]] && command -v apt-get >/dev/null 2>&1; then
        log_debug "'$pkg' 온라인 체인지로그 조회 시도 (PAGER=cat timeout 10 apt-get changelog)..."
        content="$(PAGER=cat timeout 10 apt-get changelog "$pkg" 2>/dev/null || true)"
        if [[ -n "$content" ]]; then
          log_debug "'$pkg' 온라인 체인지로그 획득 완료"
          printf "%s\n" "$content"
          return 0
        fi
        log_debug "'$pkg' 온라인 조회 실패 또는 타임아웃, 로컬 파일 탐색으로 전환"
      fi

      # 2. 로컬 /usr/share/doc 탐색
      local candidates=(
        "/usr/share/doc/${pkg}/changelog.Debian.gz"
        "/usr/share/doc/${pkg}/changelog.gz"
        "/usr/share/doc/${pkg}/changelog.Debian"
        "/usr/share/doc/${pkg}/changelog"
      )

      # 와일드카드 매칭 후보 추가 (예: nginx-core -> /usr/share/doc/nginx*)
      while IFS= read -r f; do
        [[ -n "$f" ]] && candidates+=("$f")
      done < <(find /usr/share/doc -maxdepth 2 -type f \( -name "changelog.Debian.gz" -o -name "changelog.gz" \) -path "/usr/share/doc/${pkg}*/*" 2>/dev/null || true)

      for target_file in "${candidates[@]}"; do
        if [[ -f "$target_file" ]]; then
          log_debug "로컬 체인지로그 파일 발견: $target_file"
          if [[ "$target_file" =~ \.gz$ ]]; then
            gzip -dc "$target_file" 2>/dev/null && fetched=true && break
          else
            cat "$target_file" 2>/dev/null && fetched=true && break
          fi
        fi
      done
      ;;

    rpm|zypper)
      # 1. RPM 내부 체인지로그 조회
      log_debug "'$pkg' RPM 내장 체인지로그 조회 (rpm -q --changelog)..."
      content="$(rpm -q --changelog "$pkg" 2>/dev/null || true)"
      if [[ -n "$content" ]]; then
        printf "%s\n" "$content"
        fetched=true
      fi

      # 2. 온라인 모드 및 dnf/zypper 지원 시 보안 정보 병합
      if [[ "$ONLINE_MODE" == "true" ]]; then
        if command -v dnf >/dev/null 2>&1; then
          log_debug "'$pkg' DNF updateinfo 조회 시도..."
          local sec_info
          sec_info="$(dnf updateinfo info "$pkg" 2>/dev/null || true)"
          if [[ -n "$sec_info" ]]; then
            printf "\n--- [DNF Updateinfo Advisory Data] ---\n%s\n" "$sec_info"
            fetched=true
          fi
        elif command -v zypper >/dev/null 2>&1; then
          log_debug "'$pkg' Zypper patch-info 조회 시도..."
          local sec_info
          sec_info="$(zypper patch-info "$pkg" 2>/dev/null || true)"
          if [[ -n "$sec_info" ]]; then
            printf "\n--- [Zypper Patch-Info Data] ---\n%s\n" "$sec_info"
            fetched=true
          fi
        fi
      fi
      ;;

    pacman)
      log_debug "'$pkg' Pacman 체인지로그 조회 (pacman -Qc)..."
      content="$(pacman -Qc "$pkg" 2>/dev/null || true)"
      if [[ -n "$content" ]]; then
        printf "%s\n" "$content"
        fetched=true
      fi
      ;;

    apk)
      log_debug "'$pkg' Alpine audit/info 조회..."
      content="$(apk info -w "$pkg" 2>/dev/null || true)"
      if [[ -n "$content" ]]; then
        printf "%s\n" "$content"
        fetched=true
      fi
      ;;

    brew)
      log_debug "'$pkg' Homebrew git 커밋 로그 조회..."
      content="$(brew log "$pkg" -n 50 2>/dev/null || true)"
      if [[ -n "$content" ]]; then
        printf "%s\n" "$content"
        fetched=true
      fi
      ;;
  esac

  if [[ "$fetched" == "true" ]]; then
    return 0
  fi

  return 1
}

# 검색 및 출력 메인 루틴
total_matched_pkgs=0

echo "================================================================================"
printf " 🛡️  보안 패치 및 패키지 체인지로그 감사 보고서\n"
printf "    - 시스템: %s\n" "$OS_DESC"
printf "    - 패키지 매니저: %s\n" "$PKG_MGR"
if [[ -n "$SEARCH_PATTERN" ]]; then
  printf "    - 검색 패턴: '%s' (POSIX 확장 정규식, 대소문자 무시)\n" "$SEARCH_PATTERN"
fi
printf "    - 조회 모드: %s\n" "$([ "$ONLINE_MODE" == "true" ] && echo '온라인 (원격 저장소 우선 및 로컬 폴백)' || echo '오프라인 (로컬 전용)')"
echo "================================================================================"
echo ""

for pkg in "${TARGET_PACKAGES[@]}"; do
  echo "--------------------------------------------------------------------------------"
  printf "[패키지 검사] %s\n" "$pkg"
  echo "--------------------------------------------------------------------------------"

  # 1. 패키지 버전 및 상태 출력
  if ! get_package_info "$pkg"; then
    log_warn "'$pkg' 패키지가 시스템에 설치되어 있지 않아 패치 검색을 건너뜁니다."
    echo ""
    continue
  fi

  # 2. 체인지로그 조회
  raw_changelog="$(fetch_changelog "$pkg")"

  if [[ -z "$raw_changelog" ]]; then
    log_warn "'$pkg'에 대한 체인지로그(패치 내역)를 찾을 수 없습니다."
    echo ""
    continue
  fi

  # 3. 전체 체인지로그 출력 모드
  if [[ "$SHOW_CHANGELOG" == "true" ]]; then
    printf "\n--- [%s 전체 체인지로그] ---\n" "$pkg"
    echo "$raw_changelog"
    echo ""
    continue
  fi

  # 4. 정규식 패턴 검색 모드
  if [[ -n "$SEARCH_PATTERN" ]]; then
    log_debug "'$pkg' 체인지로그에서 패턴 검색 수행: $SEARCH_PATTERN"
    
    # ERE 패턴으로 일치하는 행 및 전후 문맥(Context) 추출
    matched_lines="$(echo "$raw_changelog" | grep -E -i -C 2 "$SEARCH_PATTERN" || true)"

    if [[ -n "$matched_lines" ]]; then
      total_matched_pkgs=$((total_matched_pkgs + 1))
      match_count="$(echo "$raw_changelog" | grep -E -i -c "$SEARCH_PATTERN" || true)"
      printf "\n\033[1;32m[검색 성공]\033[0m 총 %d건의 패치 내역이 검색되었습니다:\n\n" "$match_count"
      
      # 매칭 라인 하이라이트 출력
      if [[ -t 1 ]]; then
        echo "$matched_lines" | grep --color=always -E -i "$SEARCH_PATTERN|$"
      else
        echo "$matched_lines"
      fi
      echo ""
    else
      printf "\n\033[1;33m[검색 결과 없음]\033[0m 체인지로그 내에서 '%s' 패턴과 일치하는 패치 내역이 없습니다.\n\n" "$SEARCH_PATTERN"
    fi
  else
    printf "\n[안내] --search <패턴> 또는 --show-changelog 옵션을 지정하면 상세 패치 내역을 확인할 수 있습니다.\n\n"
  fi
done

echo "================================================================================"
if [[ -n "$SEARCH_PATTERN" ]]; then
  printf " [감사 요약] 검사 완료: %d개 패키지 중 %d개 패키지에서 관련 보안 패치 확인됨\n" "${#TARGET_PACKAGES[@]}" "$total_matched_pkgs"
else
  printf " [감사 요약] 총 %d개 패키지 정보 조회 완료\n" "${#TARGET_PACKAGES[@]}"
fi
echo "================================================================================"

exit 0
