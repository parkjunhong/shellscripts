class Logger:
    """표준 출력 및 표준 에러 로깅 유틸리티."""

    def __init__(self, verbose: bool = False) -> None:
        self.verbose = verbose
        self._lock = threading.Lock()

    def debug(self, msg: str) -> None:
        if self.verbose:
            with self._lock:
                print(f"\033[1;34m[DEBUG]\033[0m {msg}", file=sys.stderr)

    def error(self, msg: str) -> None:
        with self._lock:
            print(f"\033[1;31m[ERROR]\033[0m {msg}", file=sys.stderr)

    def info(self, msg: str) -> None:
        with self._lock:
            print(f"\033[1;32m[INFO]\033[0m {msg}")

    def warn(self, msg: str) -> None:
        with self._lock:
            print(f"\033[1;33m[WARN]\033[0m {msg}", file=sys.stderr)


class StepSpinner:
    """대화형 터미널(stderr TTY)에서 회전 스피너와 경과 시간을 실시간 표시합니다."""

    FRAMES = ("⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏")

    def __init__(self, enabled: bool = True) -> None:
        self.enabled = enabled and sys.stderr.isatty()
        self._lock = threading.Lock()
        self._stop_event = threading.Event()
        self._thread: Optional[threading.Thread] = None
        self._label = ""
        self._start_ts = 0.0
        self._line_count = 0

    def start(self, label: str) -> None:
        self.stop_line(clear_only=True)
        with self._lock:
            self._label = label
            self._start_ts = time.monotonic()
            if not self.enabled:
                return
            self._stop_event.clear()
            self._thread = threading.Thread(target=self._spin, daemon=True)
            self._thread.start()

    def update_label(self, label: str) -> None:
        with self._lock:
            self._label = label

    def _spin(self) -> None:
        idx = 0
        while not self._stop_event.is_set():
            with self._lock:
                elapsed = int(time.monotonic() - self._start_ts)
                label = self._label
            frame = self.FRAMES[idx % len(self.FRAMES)]
            sys.stderr.write(
                f"\r\033[K  \033[36m{frame}\033[0m {label}: \033[2m진행 중... ({elapsed}s)\033[0m"
            )
            sys.stderr.flush()
            idx += 1
            self._stop_event.wait(0.15)

    def stop(self, result_text: str = "완료", ok: bool = True) -> None:
        self.stop_line(clear_only=False, result_text=result_text, ok=ok)

    def stop_line(
        self, clear_only: bool = False, result_text: str = "완료", ok: bool = True
    ) -> None:
        thread: Optional[threading.Thread]
        with self._lock:
            thread = self._thread
            self._thread = None
            if thread is not None:
                self._stop_event.set()
        if thread is not None:
            thread.join(timeout=1.0)
        if not self.enabled:
            return
        with self._lock:
            if clear_only:
                sys.stderr.write("\r\033[K")
                sys.stderr.flush()
                return
            elapsed = int(time.monotonic() - self._start_ts)
            mark, color = ("✓", "\033[1;32m") if ok else ("✗", "\033[1;33m")
            sys.stderr.write(
                f"\r\033[K  {color}{mark}\033[0m {self._label}: {color}{result_text}\033[0m ({elapsed}s)\n"
            )
            sys.stderr.flush()
            self._line_count += 1

    def clear_all(self) -> None:
        self.stop_line(clear_only=True)
        if not self.enabled:
            return
        with self._lock:
            while self._line_count > 0:
                sys.stderr.write("\033[1A\033[K")
                self._line_count -= 1
            sys.stderr.flush()


