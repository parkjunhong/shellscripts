# 섹션별 출력 버퍼 (파일 저장 시 순서 재배치용)
SEC_HEADER=""
SEC_STEP1=""
SEC_STEP2=""
SEC_STEP3=""
SEC_STEP4=""
SEC_FOOTER=""

KERNEL_INFO="$(uname -srm 2>/dev/null || uname -a 2>/dev/null || echo 'Unknown')"

SEC_HEADER="$(
  echo "================================================================================"
  printf " 🛡️  시스템 패키지 및 OS 보안 권고 감사 보고서\n"
  printf "    - 시스템: %s (패키지 백엔드: %s)\n" "$OS_DESC" "$PKG_MGR"
  printf "    - 커널  : %s\n" "$KERNEL_INFO"
  if [[ ${#OSS_NUMBERS[@]} -gt 0 ]]; then
    printf "    - OS 보안 권고사항(OSS): %s\n" "${OSS_NUMBERS[*]}"
  fi
  printf "    - 조회 모드: %s\n" "$([ "$ONLINE_MODE" == "true" ] && echo '온라인 (공식 보안 API 및 원격 저장소 우선)' || echo '오프라인 (로컬 전용)')"
  echo "================================================================================"
  echo ""
)"
printf "%s\n\n" "$SEC_HEADER"
SEC_HEADER+=$'\n\n'

# ------------------------------------------------------------------------------
# [1단계] 패키지 설치 상태 검사
# ------------------------------------------------------------------------------
declare -a INSTALLED_PKGS=()

if [[ ${#TARGET_PACKAGES[@]} -gt 0 ]]; then
  SEC_STEP1+="$(
    echo "--------------------------------------------------------------------------------"
    printf " [1단계] 시스템 패키지 설치 상태 검사\n"
    echo "--------------------------------------------------------------------------------"
  )"$'\n'
  printf "%s" "$SEC_STEP1"

  installed_cnt=0
  for pkg in "${TARGET_PACKAGES[@]}"; do
    pkg_line=""
    if pkg_line="$(get_package_info "$pkg")"; then
      INSTALLED_PKGS+=("$pkg")
      installed_cnt=$((installed_cnt + 1))
    fi
    printf "%s\n" "$pkg_line"
    SEC_STEP1+="${pkg_line}"$'\n'
  done

  step1_summary="$(printf "  * 검사 결과: 총 %d개 요청 패키지 중 %d개 설치됨, %d개 미설치\n" \
    "${#TARGET_PACKAGES[@]}" "$installed_cnt" $(( ${#TARGET_PACKAGES[@]} - installed_cnt )))"
  printf "%s\n\n" "$step1_summary"
  SEC_STEP1+="${step1_summary}"$'\n\n'
fi

# ------------------------------------------------------------------------------
# 전체 체인지로그 출력 모드 처리
# ------------------------------------------------------------------------------
if [[ "$SHOW_CHANGELOG" == "true" ]]; then
  echo "--------------------------------------------------------------------------------"
  printf " [체인지로그 전체 열람]\n"
  echo "--------------------------------------------------------------------------------"
  for pkg in "${INSTALLED_PKGS[@]}"; do
    printf "\n--- [%s 전체 체인지로그] ---\n" "$pkg"
    fetch_changelog "$pkg"
  done
  exit 0
fi

# ------------------------------------------------------------------------------
# [2단계] OS 보안 권고사항 분석 및 연관 CVE 추출
# ------------------------------------------------------------------------------
declare -a ALL_RESOLVED_CVES=()
declare -a SUGGESTED_PKGS=()
declare -a SUMMARY_OSS_ENTRIES=()
ALL_CL_MATCHED_TEXT=""

if [[ ${#OSS_NUMBERS[@]} -gt 0 ]]; then
  SEC_STEP2+="$(
    echo "--------------------------------------------------------------------------------"
    printf " [2단계] OS 보안 권고사항(OSS Number) 분석 및 연관 CVE 자동 추출\n"
    echo "--------------------------------------------------------------------------------"
  )"$'\n'
  printf "%s" "$SEC_STEP2"

  oss_idx=0
  oss_total="${#OSS_NUMBERS[@]}"
  for oss in "${OSS_NUMBERS[@]}"; do
    oss_idx=$((oss_idx + 1))
    ADV_PROGRESS_PREFIX="[${oss_idx}/${oss_total}] "

    # 함수 호출 (ADV_* 변수로 안전하게 수신)
    resolve_advisory_info "$oss"
    clear_progress
    ADV_PROGRESS_PREFIX=""

    display_title="$(truncate_title "$ADV_TITLE" 120)"
    full_title="${ADV_TITLE_FULL:-$ADV_TITLE}"

    status_line=""
    if [[ "$ADV_STATUS" =~ "해결됨" ]]; then
      status_line="$(printf "    - 시스템 상태: \033[1;32m%s\033[0m\n" "$ADV_STATUS")"
    elif [[ "$ADV_STATUS" =~ "업데이트 가능" ]]; then
      status_line="$(printf "    - 시스템 상태: \033[1;31m%s\033[0m\n" "$ADV_STATUS")"
    else
      status_line="$(printf "    - 시스템 상태: %s\n" "$ADV_STATUS")"
    fi

    pkg_line=""
    if [[ -n "$ADV_PKG" ]]; then
      pkg_line="$(printf "    - 영향 패키지: %s\n" "$ADV_PKG")"
      SUGGESTED_PKGS+=("$ADV_PKG")
    fi

    SUMMARY_OSS_ENTRIES+=("${oss}|||${ADV_STATUS}|||${ADV_PKG}")

    item_buf=""
    item_buf+="$(printf "  📢 \033[1;36m[%s]\033[0m %s\n" "$oss" "$display_title")"$'\n'
    item_buf+="${status_line}"$'\n'
    [[ -n "$pkg_line" ]] && item_buf+="${pkg_line}"$'\n'

    file_item_buf=""
    if [[ -n "$OUTPUT_FILE" ]]; then
      file_item_buf+="$(printf "  📢 \033[1;36m[%s]\033[0m %s\n" "$oss" "$full_title")"$'\n'
      file_item_buf+="${status_line}"$'\n'
      [[ -n "$pkg_line" ]] && file_item_buf+="${pkg_line}"$'\n'
    fi

    if [[ ${#ADV_CVES[@]} -gt 0 ]]; then
      # 사용자가 --package를 지정했고, 권고의 영향 패키지(ADV_PKG)가 감사 대상 패키지와 무관한지 검사
      is_unrelated=false
      if [[ ${#TARGET_PACKAGES[@]} -gt 0 ]]; then
        if [[ -n "$ADV_PKG" ]]; then
          pkg_matched=false
          for tp in "${TARGET_PACKAGES[@]}"; do
            if [[ "$tp" == "$ADV_PKG" || "$tp" == "${ADV_PKG}-"* || "$ADV_PKG" == "${tp}-"* ]]; then
              pkg_matched=true
              break
            fi
          done
          [[ "$pkg_matched" == "false" ]] && is_unrelated=true
        elif [[ "$ADV_STATUS" =~ "해당 없음" ]]; then
          is_unrelated=true
        fi
      fi

      if [[ "$is_unrelated" == "true" && ${#ADV_CVES[@]} -gt 5 && "$VERBOSE" != "true" ]]; then
        item_buf+="$(printf "    - 연관 CVE 목록: 총 %d개 (지정 패키지와 무관하여 축약됨, --verbose 시 전체 출력)\n" "${#ADV_CVES[@]}")"$'\n'
      else
        item_buf+="$(printf "    - 연관 CVE 목록 (%d개 추출됨):\n" "${#ADV_CVES[@]}")"$'\n'
        if [[ ${#ADV_CVES[@]} -gt 10 && "$VERBOSE" != "true" ]]; then
          item_buf+="$(printf "      %s ... 외 %d개 생략 (총 %d개, --verbose 시 전체 출력)\n" \
            "${ADV_CVES[*]:0:10}" $(( ${#ADV_CVES[@]} - 10 )) "${#ADV_CVES[@]}")"$'\n'
        else
          item_buf+="$(printf "      %s\n" "${ADV_CVES[*]}")"$'\n'
        fi
      fi

      if [[ -n "$OUTPUT_FILE" ]]; then
        file_item_buf+="$(printf "    - 연관 CVE 목록 (%d개 추출됨):\n" "${#ADV_CVES[@]}")"$'\n'
        file_item_buf+="$(printf "      %s\n" "${ADV_CVES[*]}")"$'\n'
      fi

      # 3단계 감사를 위해 연관 CVE 누적 (단, 지정 패키지와 무관한 권고의 CVE는 3단계 정규식 패턴 폭증 방지를 위해 제외)
      if [[ "$is_unrelated" == "false" || ${#TARGET_PACKAGES[@]} -eq 0 ]]; then
        for c in "${ADV_CVES[@]}"; do
          ALL_RESOLVED_CVES+=("$c")
        done
      fi
    else
      item_buf+="$(printf "    - 연관 CVE: (직접 매핑 정보 없음)\n")"$'\n'
      [[ -n "$OUTPUT_FILE" ]] && file_item_buf+="$(printf "    - 연관 CVE: (직접 매핑 정보 없음)\n")"$'\n'
    fi

    if [[ ${#ADV_SOURCES[@]} -eq 0 ]]; then
      if [[ "$ONLINE_MODE" == "false" ]]; then
        ADV_SOURCES+=("오프라인 모드 (로컬 캐시/체인지로그)")
      else
        ADV_SOURCES+=("기본 권고 파서")
      fi
    fi

    sources_str=""
    for src in "${ADV_SOURCES[@]}"; do
      [[ -n "$sources_str" ]] && sources_str+=", "
      sources_str+="$src"
    done
    item_buf+="$(printf "    - 근거: %s\n" "$sources_str")"$'\n'
    [[ -n "$OUTPUT_FILE" ]] && file_item_buf+="$(printf "    - 근거: %s\n" "$sources_str")"$'\n'

    printf "%s\n" "$item_buf"
    [[ -n "$OUTPUT_FILE" ]] && SEC_STEP2+="${file_item_buf}"$'\n'
  done
fi

# ------------------------------------------------------------------------------
# [3단계] 체인지로그 보안 패치 상세 내역 (완전한 블록 단위 출력)
# ------------------------------------------------------------------------------
if [[ ${#ALL_RESOLVED_CVES[@]} -gt 0 ]]; then
  # 중복 CVE 제거
  declare -a UNIQUE_CVES=()
  while IFS= read -r c; do
    [[ -n "$c" ]] && UNIQUE_CVES+=("$c")
  done < <(printf "%s\n" "${ALL_RESOLVED_CVES[@]}" | sort -u)

  # 정규식 패턴 생성
  cve_regex_pattern="$(IFS="|"; echo "${UNIQUE_CVES[*]}")"

  # 감사 대상 패키지 결정: 사용자가 지정한 설치된 패키지 우선, 없으면 권고에서 추출된 패키지 사용
  declare -a AUDIT_PKGS=()
  if [[ ${#INSTALLED_PKGS[@]} -gt 0 ]]; then
    AUDIT_PKGS=("${INSTALLED_PKGS[@]}")
  elif [[ ${#SUGGESTED_PKGS[@]} -gt 0 ]]; then
    while IFS= read -r p; do
      [[ -n "$p" ]] && AUDIT_PKGS+=("$p")
    done < <(printf "%s\n" "${SUGGESTED_PKGS[@]}" | sort -u)
  fi

  if [[ ${#AUDIT_PKGS[@]} -gt 0 ]]; then
    SEC_STEP3+="$(
      echo "--------------------------------------------------------------------------------"
      printf " [3단계] 설치된 패키지 체인지로그 보안 패치 적용 내역 (블록 정밀 추출)\n"
      echo "--------------------------------------------------------------------------------"
    )"$'\n'
    printf "%s" "$SEC_STEP3"

    for pkg in "${AUDIT_PKGS[@]}"; do
      pkg_hdr="$(printf "\n🔍 \033[1;34m[패키지]\033[0m \033[1m%s\033[0m\n" "$pkg")"
      printf "\n%s\n" "$pkg_hdr"
      SEC_STEP3+=$'\n'"${pkg_hdr}"$'\n'

      raw_cl="$(fetch_changelog "$pkg")"

      if [[ -z "$raw_cl" ]]; then
        log_warn "'$pkg' 패키지의 체인지로그를 찾을 수 없습니다."
        warn_msg="[WARN] '$pkg' 패키지의 체인지로그를 찾을 수 없습니다."
        SEC_STEP3+="${warn_msg}"$'\n'
        continue
      fi

      # 완전한 보안 업데이트 블록만 추출
      matched_blocks="$(extract_changelog_blocks "$raw_cl" "$cve_regex_pattern")"

      if [[ -n "$matched_blocks" ]]; then
        ALL_CL_MATCHED_TEXT+=$'\n'"$matched_blocks"
        ok_hdr="$(printf "\033[1;32m[패치 확인됨]\033[0m 현재 설치된 패키지에 관련 CVE 보안 패치가 반영되어 있습니다:")"
        printf "%s\n\n" "$ok_hdr"
        if [[ -t 1 ]]; then
          echo "$matched_blocks" | grep --color=always -E "$cve_regex_pattern|$"
        else
          echo "$matched_blocks"
        fi
        SEC_STEP3+="${ok_hdr}"$'\n\n'"${matched_blocks}"$'\n'
      else
        miss_msg="$(printf "\033[1;33m[패치 미반영]\033[0m 현재 설치된 버전의 체인지로그에는 해당 CVE 보안 패치 내역이 반영되어 있지 않습니다.")"
        printf "%s\n" "$miss_msg"
        SEC_STEP3+="${miss_msg}"$'\n'
      fi
    done
    printf "\n"
    SEC_STEP3+=$'\n'
  fi
fi

# ------------------------------------------------------------------------------
# [4단계] 시스템 취약점 패치 요약 정보
# ------------------------------------------------------------------------------
if [[ ${#SUMMARY_OSS_ENTRIES[@]} -gt 0 ]]; then
  declare -a SUM_RESOLVED=()
  declare -a SUM_ACTION=()
  declare -a SUM_NOT_AFFECTED=()
  declare -a SUM_CHECK=()

  for entry in "${SUMMARY_OSS_ENTRIES[@]}"; do
    s_oss="${entry%%|||*}"
    s_rest="${entry#*|||}"
    s_status="${s_rest%%|||*}"
    s_pkg="${s_rest#*|||}"

    s_label="$s_oss"
    [[ -n "$s_pkg" ]] && s_label="${s_oss}(${s_pkg})"

    if [[ "$s_status" =~ "해결됨" ]]; then
      SUM_RESOLVED+=("$s_label")
    elif [[ "$s_status" =~ "업데이트 가능" || "$s_status" =~ "업데이트 대기중" ]]; then
      SUM_ACTION+=("$s_label")
    elif [[ "$s_status" =~ "해당 없음" ]]; then
      if [[ ( "$s_status" =~ "관련 권고 없음" || "$s_status" =~ "패키지 미설치" ) && -n "$ALL_CL_MATCHED_TEXT" ]] && echo "$ALL_CL_MATCHED_TEXT" | grep -qiF "$s_oss"; then
        SUM_RESOLVED+=("$s_label")
      else
        SUM_NOT_AFFECTED+=("$s_label")
      fi
    else
      # 2단계에서 미판별되었으나 3단계 체인지로그에서 실제로 매칭된 경우 조치 완료로 분류
      if [[ -n "$ALL_CL_MATCHED_TEXT" ]] && echo "$ALL_CL_MATCHED_TEXT" | grep -qiF "$s_oss"; then
        SUM_RESOLVED+=("$s_label")
      else
        SUM_CHECK+=("$s_label")
      fi
    fi
  done

  SEC_STEP4="$(
    echo "--------------------------------------------------------------------------------"
    printf " [4단계] 시스템 취약점 패치 요약 정보 (총 %d건)\n" "${#SUMMARY_OSS_ENTRIES[@]}"
    echo "--------------------------------------------------------------------------------"
    printf "  \033[1;32m✅ 조치 완료 (Resolved)\033[0m         : %d건\n" "${#SUM_RESOLVED[@]}"
    if [[ ${#SUM_RESOLVED[@]} -gt 0 ]]; then
      printf "     %s\n" "${SUM_RESOLVED[*]}"
    fi

    printf "  \033[1;31m⚠️  조치 필요 (Action Required)\033[0m  : %d건\n" "${#SUM_ACTION[@]}"
    if [[ ${#SUM_ACTION[@]} -gt 0 ]]; then
      printf "     %s\n" "${SUM_ACTION[*]}"
    fi

    printf "  ➖ 해당 없음 (Not Affected)     : %d건\n" "${#SUM_NOT_AFFECTED[@]}"
    if [[ ${#SUM_NOT_AFFECTED[@]} -gt 0 ]]; then
      printf "     %s\n" "${SUM_NOT_AFFECTED[*]}"
    fi

    if [[ ${#SUM_CHECK[@]} -gt 0 ]]; then
      printf "  \033[1;33m❓ 확인 필요 (Check Required)\033[0m   : %d건\n" "${#SUM_CHECK[@]}"
      printf "     %s\n" "${SUM_CHECK[*]}"
    fi
  )"$'\n\n'
  printf "%s" "$SEC_STEP4"
fi

SEC_FOOTER="$(
  echo "================================================================================"
  printf " [감사 완료] 모든 점검 및 감사가 안전하게 종료되었습니다.\n"
  echo "================================================================================"
)"$'\n'
printf "%s" "$SEC_FOOTER"

# --output 지정 시 요약 우선 순서로 파일에 저장 (1 -> 4 -> 3 -> 2)
if [[ -n "$OUTPUT_FILE" ]]; then
  output_dir="$(dirname "$OUTPUT_FILE")"
  if [[ -n "$output_dir" && ! -d "$output_dir" ]]; then
    mkdir -p "$output_dir" || { log_error "출력 디렉토리를 생성할 수 없습니다: $output_dir"; exit 1; }
  fi

  {
    printf "%s" "$SEC_HEADER"
    [[ -n "$SEC_STEP1" ]] && printf "%s" "$SEC_STEP1"
    [[ -n "$SEC_STEP4" ]] && printf "%s" "$SEC_STEP4"
    [[ -n "$SEC_STEP3" ]] && printf "%s" "$SEC_STEP3"
    [[ -n "$SEC_STEP2" ]] && printf "%s" "$SEC_STEP2"
    printf "%s" "$SEC_FOOTER"
  } | sed -E $'s/\x1b\\[[0-9;]*[mK]//g; s/^ \\[[0-9]+단계\\] / /' > "$OUTPUT_FILE"

  log_info "감사 보고서가 파일로 저장되었습니다: $OUTPUT_FILE"
fi

exit 0
