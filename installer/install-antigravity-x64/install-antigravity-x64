#
# @param 없음
#
# @return {string} 설치된 버전 문자열 (미설치 또는 확인 불가 시 빈 문자열)
##
detect_installed_antigravity() {
  if [ "$PLATFORM_OS" = "darwin" ]; then
    local app_dir="/Applications/Antigravity.app"
    [ ! -d "$app_dir" ] && app_dir="$HOME/Applications/Antigravity.app"
    if [ ! -d "$app_dir" ]; then
      return 0
    fi

    python3 - "$app_dir" <<'PY' 2>/dev/null || true
import os
import plistlib
import sys

app_dir = sys.argv[1]
plist_path = os.path.join(app_dir, "Contents", "Info.plist")

if os.path.exists(plist_path):
    try:
        with open(plist_path, "rb") as f:
            pl = plistlib.load(f)
            ver = str(pl.get("CFBundleShortVersionString") or pl.get("CFBundleVersion") or "").strip()
            if ver:
                print(ver)
                sys.exit(0)
    except Exception:
        pass

# Fallback: Contents/Resources/app.asar 헤더 파싱
asar_path = os.path.join(app_dir, "Contents", "Resources", "app.asar")
if os.path.exists(asar_path):
    try:
        import struct, json
        with open(asar_path, "rb") as f:
            header_meta = f.read(16)
            if len(header_meta) == 16:
                u1, header_payload_size, u3, header_json_size = struct.unpack("<IIII", header_meta)
                header_json_bytes = f.read(header_json_size)
                header = json.loads(header_json_bytes.decode("utf-8"))
                base_offset = 8 + header_payload_size
                files = header.get("files", {})
                pkg_info = files.get("package.json", {})
                if "offset" in pkg_info and "size" in pkg_info:
                    offset = int(pkg_info["offset"])
                    size = int(pkg_info["size"])
                    f.seek(base_offset + offset)
                    pkg_data = json.loads(f.read(size).decode("utf-8"))
                    ver = pkg_data.get("version", "").strip()
                    if ver:
                        print(ver)
                        sys.exit(0)
    except Exception:
        pass
PY
    return 0
  fi

  local asar_file="/opt/antigravity/resources/app.asar"
  if [ ! -f "$asar_file" ]; then
